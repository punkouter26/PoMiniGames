{
  "version": 1,
  "conventions": {
    "packageManager": "nuget",
    "languages": ["csharp", "javascript"],
    "test": "pwsh scripts/test-all.ps1",
    "lint": "dotnet format PoMiniGames.slnx --verify-no-changes --verbosity minimal",
    "typecheck": "dotnet build PoMiniGames.slnx",
    "format": "dotnet format PoMiniGames.slnx",
    "build": "dotnet build PoMiniGames.slnx",
    "ci": ".github/workflows/deploy.yml",
    "defaultBranch": "master",
    "ui": {
      "framework": "blazor",
      "styling": "vanilla",
      "iconLibrary": "none",
      "componentLib": "none",
      "tokensPath": "src/PoMiniGames.Client/wwwroot/css/app.css"
    },
    "docs": {
      "stack": "markdown",
      "dir": "docs"
    }
  },
  "preferences": {
    "outputStyle": "normal",
    "autonomy": "gate-all",
    "tdd": "strict",
    "specDir": "docs/plans",
    "boardTracking": "gitignored",
    "families": ["build", "health"],
    "health": {
      "protectedPaths": [
        "**/bin/**",
        "**/obj/**",
        "publish/**",
        "infra/**",
        "**/*.generated.*",
        "src/PoMiniGames.Client/wwwroot/lib/**"
      ],
      "deflakeRuns": 20
    }
  }
}
