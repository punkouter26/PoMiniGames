# ──────────────────────────────────────────────────────────────────────
# PoMiniGames .gitignore
# Authoritative list of files / directories that MUST NOT be committed.
# Organized by category so each rule is grep-able when triaging a new
# "untracked" file. Refactored per NET_CLEAN_10 §8 (workspace hygiene).
# ──────────────────────────────────────────────────────────────────────

# ─── .NET build outputs ─────────────────────────────────────────────
# Standard bin/obj outputs for every project + the .NET CLI folders.
bin/
obj/
*.dll
*.exe
*.pdb
*.user
*.suo
*.cache
*.log
*.nupkg
packages/
project.lock.json
[Dd]ebug/
[Rr]elease/
x64/
x86/

# ─── Runtime / framework caches ─────────────────────────────────────
# Files the host or framework writes at run-time (never commit).
# ASP.NET DataProtection key ring contains XML-wrapped key material that
# would let an attacker forge the BFF's auth cookies.
src/PoMiniGames/PoMiniGames/keys/
src/PoMiniGames/PoMiniGames/keys/**
src/PoMiniGames/PoMiniGames/logs/
src/PoMiniGames/PoMiniGames/logs/**

# ─── IDE / editor state ──────────────────────────────────────────────
.vs/
.vscode/
.vscode/mcp.json
.idea/
*.swp
*.swo
*.lscache
*.sln.docstates
*.rsuser
*.DotSettings.user

# ─── Test results / coverage ─────────────────────────────────────────
TestResults/
coverage/
*.coverage
*.coveragexml
*.trx
*.snap
test-results/
artifacts/

# ─── Playwright state ────────────────────────────────────────────────
.playwright-mcp/
.auth/
playwright-report/
playwright-report/**
blob-report/
blob-report/**

# ─── Adhoc screenshots / debug captures ──────────────────────────────
docs/screenshots/adhoc-*/
docs/screenshots/*.png
docs/screenshots/*.jpg
docs/screenshots/*.jpeg
docs/screenshots/*.webp

# ─── Node / npm (npm-installed Azurite fallback writes here) ────────
node_modules/
npm-debug.log
yarn-error.log

# ─── Local Azurite state ─────────────────────────────────────────────
# The npm-installed Azurite (when Docker isn't running) writes its
# on-disk state here. Container Azurite persists via the named volume
# in docker-compose.yml and never touches the working tree.
.azurite/
.azurite/**

# ─── Deployment artifacts (CI/CD + kudu + local publish) ─────────────
# Never source — generated by `dotnet publish`, `az webapp deploy`, or
# kudu ZIP push. Explicit names below were committed by mistake in
# commits 59dae1d and earlier; never source.
publish/
publish/**
publish-fix/
publish-fix/**
publish-api/
publish-api/**
client-trim-audit/
client-trim-audit/**
app-deploy.zip
app-deploy-fix.zip
api-deploy.zip
appservice-logs.zip
latest.zip
*.zip
!src/**/*.zip

# ─── Copilot / agent configuration ───────────────────────────────────
# Machine-local config that should never be in source control.
agentrc.config.json
agentrc.eval.json
cookbook/
instructions/
skills/
.copilot-session/

# ─── Environment / secrets ───────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production

# ─── Azure CLI / azd local state ─────────────────────────────────────
.azd/
.azure/

# ─── SQLite runtime files (defensive — none today) ───────────────────
*.sqlite3
*.db-shm
LLMDOCS/
*.db-wal

# ─── Generated documentation (Mermaid HTML export) ────────────────────
docs/*.html

# ─── Backup / temp files ─────────────────────────────────────────────
*.orig
*.bak
*.tmp

# ─── OS junk ─────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
.DS_Store
.AppleDouble
.LSOverride
.directory
.directory~
.hidden
.nfs*

# ─── Build tool caches ───────────────────────────────────────────────
.cmake/
CMakeCache.txt