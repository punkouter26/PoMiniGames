{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API + Client (F5)",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/PoMiniGames.API/PoMiniGames.API.csproj",
            "preLaunchTask": "prelaunch",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "launchBrowser": {
                "enabled": true,
                "args": "https://localhost:5001",
                "windows": {
                    "command": "cmd.exe",
                    "args": "/C start microsoft-edge:https://localhost:5001"
                },
                "linux": {
                    "command": "xdg-open",
                    "args": "https://localhost:5001"
                },
                "osx": {
                    "command": "open",
                    "args": "https://localhost:5001"
                }
            }
        }
    ]
}
