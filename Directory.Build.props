<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>$(NoWarn);NU1902;NU1903;ASPDEPR002</NoWarn>
  </PropertyGroup>
  <!-- §1.2 MinVer. The MinVer .targets are pulled in via PackageReference in the host
       project (or any MSBuild-aware project). The properties below document the
       contract; changing them changes the version every assembly is stamped with. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorVersion>1</MinVerMinimumMajorVersion>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerSkipNonTagged>true</MinVerSkipNonTagged>
    <Version>$(MinVerVersion)</Version>
    <AssemblyVersion>$(MinVerVersion)</AssemblyVersion>
    <FileVersion>$(MinVerVersion)</FileVersion>
    <InformationalVersion>$(MinVerVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
