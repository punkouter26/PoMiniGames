flowchart TD
    subgraph Roles["User Roles"]
        Anon["Anonymous User\n(no JWT — no login)"]
        AuthUser["Authenticated User\n(valid Microsoft JWT Bearer)"]
        LobbyHost["Lobby Host\n(first player to join lobby)"]
        DevAdmin["Dev Admin\n(Development environment only)"]
    end

    subgraph PublicGroup["Public — No Auth Required"]
        HealthEP["GET /api/health\nGET /api/health/ping"]
        LeaderboardEP["GET /api/{game}/statistics/leaderboard\nTop 10 WinRate DESC — rate: unrestricted GET"]
        HighScoreGetEP["GET /api/snake/highscores\nGET /api/podropsquare/highscores"]
        GameUI["All game UI routes\n/ · /tictactoe · /connectfive · /pofight\n/posnakegame · /podropsquare · /poraceragdoll · etc."]
        HSPostEP["POST /api/snake/highscores\nPOST /api/podropsquare/highscores\nRate-limited: 10 req/min/IP (fixed window)"]
    end

    subgraph AuthGroup["Authenticated — Bearer JWT Required"]
        AuthMeEP["GET /api/auth/me\nReturns userId · displayName · email"]
        StatsWriteEP["PUT /api/{game}/players/{name}/stats\nUPSERT player statistics — composite PK"]
        MPQueueEP["POST /api/multiplayer/queue\nJoin matchmaking queue"]
        LobbyWSS["WSS /api/hubs/lobby\n?access_token=JWT\nLobbyUpdated · GameStarting events"]
        MPHubWSS["WSS /api/hubs/multiplayer\n?access_token=JWT\nSendRealtimeInput · RealtimeInput events"]
        SpectateEP["JoinSpectatorGroup(matchId)\nRead-only match observer\nReceives all RealtimeInput events"]
    end

    subgraph HostGroup["Host-Only Operations (Lobby Role)"]
        StartGameOp["StartGame(gameKey)\nLobbyHub method — host only\nBroadcasts GameStarting to all lobby members"]
    end

    subgraph DevGroup["Dev Environment Only (disabled in Production)"]
        DevLoginEP["POST /api/auth/dev-login\n{userId, displayName, email}\nIssues PoMiniGames.DevAuth cookie"]
        DevBypassEP["GET /api/auth/dev-bypass?user=Name\nURL-param auth bypass for E2E tests"]
        DiagEP["GET /diag\nMasked config dump (values partially hidden)\nAll keys and connection strings exposed"]
    end

    Anon --> PublicGroup
    Anon --> HSPostEP
    AuthUser --> PublicGroup
    AuthUser --> AuthGroup
    AuthUser --> HSPostEP
    LobbyHost --> StartGameOp
    DevAdmin --> DevGroup

