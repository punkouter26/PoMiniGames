flowchart TD
    Player["Player\n(Browser — Chrome / Safari / Mobile)"]

    subgraph Edge["Edge Delivery (Azure CDN — westus2)"]
        SWA["Static Web App\nBlazor WebAssembly\n.NET 10 Runtime\n8 game routes"]
    end

    subgraph Compute["Compute Tier (App Service Linux B1 — westus2)"]
        API[".NET 10 Minimal API\nSerilog + OpenTelemetry\nSystemAssigned Managed Identity\nMSAL JWT validation"]
        LobbyHub["LobbyHub\nWSS /api/hubs/lobby\nHost mgmt · match formation\nGameStarting broadcast"]
        MPHub["MultiplayerHub\nWSS /api/hubs/multiplayer\nSendRealtimeInput · Broadcast\nSpectator group support"]
    end

    subgraph DataTier["Data Persistence (App Service disk)"]
        SQLite[("SQLite\n/home/data/pominigames.db\nPlayerStats · SnakeHighScores\nPoDropSquareHighScores · MultiplayerMatch")]
    end

    subgraph PoSharedLayer["PoShared (rg-PoShared)"]
        KV["Key Vault (kv-poshared)\nMicrosoftAuth--ClientId\nMicrosoftAuth--ApiClientId\nApplicationInsights--ConnectionString"]
        AppIns["Application Insights\nOpenTelemetry OTLP sink\nTraces · Exceptions · Metrics · Logs"]
    end

    subgraph IdentityLayer["Microsoft Identity Platform"]
        MSID["OAuth2 / OIDC provider\nJWT Bearer tokens (12h TTL)\nPKCE flow via MSAL popup"]
    end

    subgraph CICDLayer["CI/CD (GitHub Actions)"]
        GH["deploy.yml\nTrigger: push to master\nOIDC federation — no stored credentials"]
        BuildJob["Build Job (ubuntu-latest)\ndotnet build Release · dotnet test\nxUnit + Playwright"]
        DeployJob["Deploy Job\nzip-deploy App Service (linux-x64)\nStatic Web App deployment"]
    end

    Player -->|"HTTPS games · leaderboards · auth"| SWA
    Player -->|"WSS SignalR multiplayer"| API
    SWA -->|"REST + WSS handshake"| API
    API -.-> LobbyHub
    API -.-> MPHub
    API --> SQLite
    API -->|"Fetch secrets at startup\n(Managed Identity)"| KV
    API -->|"OTLP push"| AppIns
    API -->|"Validate JWT Bearer"| MSID
    GH --> BuildJob
    BuildJob --> DeployJob
    DeployJob -->|"React bundle"| SWA
    DeployJob -->|"zip-deploy binaries"| API

