flowchart TD
    subgraph Client["PoMiniGames.Client (Blazor WASM - mobile-first)"]
        App[App.razor wrapped in AuthGate]
        Router[Blazor Router + AuthorizeRouteView]
        Layout[MainLayout + NavMenu + LoginScreen]
        Pages[Pages: Index, GameRoute, NotFound]
        subgraph GameModules["Games/ - 11 client-only modules"]
            G1[BabyTouch]
            G2[ConnectFive]
            G3[DropSquare]
            G4[Fight]
            G5[HorseRace]
            G6[PoMarbleRace]
            G7[PoRacer]
            G8[PoRunner]
            G9[SnakeGame]
            G10[TicTacToe]
            G11[VoxelShooter]
        end
        subgraph Services["Services/ - typed HttpClients + state"]
            Svc1[AuthStateProvider]
            Svc2[LeaderboardClient - Polly resilient]
            Svc3[LobbyClient - Polly resilient]
            Svc4[GameStatsService]
        end
    end

    subgraph Host["PoMiniGames (PoMiniGames host - .API + WASM server)"]
        Program[Program.cs - composition root]
        subgraph Composition["Infrastructure (composition + lifecycle only)"]
            AuthExt[AuthExtensions]
            StorageExt[StorageExtensions]
            Telemetry[TelemetryExtensions]
            Endpoints[EndpointRouteExtensions.MapPoMiniGamesEndpoints]
            SecretVal[StartupSecretValidator]
        end
        subgraph Slices["Features/ vertical slices - isolated"]
            AuthSlice[Auth/<br/>Endpoints + AuthExtensions]
            LeaderSlice[Leaderboard/<br/>Storage + Endpoint + DTOs]
            LobbySlice[Lobby/<br/>Hub + Endpoint + DTOs]
            FunQuiz[PoFunQuiz/<br/>Storage + Endpoint + DTOs]
            CoupleQuiz[PoCoupleQuiz/<br/>Endpoint + DTOs]
            Face[PoFace/<br/>Endpoint + DTOs]
            Joker[PoJoker/<br/>Endpoint + DTOs]
            Survive[PoSurvive/<br/>Persistence + Hub + Endpoint + DTOs]
        end
    end

    subgraph Infra["PoMiniGames.Infrastructure (shared platform persistence)"]
        StorageSvc[StorageService - TableServiceClient factory]
        EloCalc[Elo calculator]
        HealthChecks[Storage health checks]
    end

    subgraph Shared["PoShared (.Shared assembly - RESTRICTED)"]
        SharedModels[Game-agnostic POCO models]
        SharedDtos[PoJoker/JokeDtos.cs<br/>PoRacerShared.cs]
        SharedIdentity[Identity helpers]
        SharedDiag[Diagnostics contracts]
    end

    subgraph Domain["PoMiniGames.Domain"]
        DomainModels[Domain models + services]
    end

    subgraph App["PoMiniGames.Application"]
        AppServices[Application services + DTOs]
    end

    Client -. same origin HTTP .-> Host
    Slices --> Endpoints
    Slices --> AuthExt
    Slices --> StorageExt
    Slices --> Telemetry
    Composition --> Program
    Slices -. thin .-> Shared
    Slices -. uses .-> Domain
    Slices -. uses .-> App
    Slices -. uses .-> Infra
    Infra -. only shared persistence .-> Slices
    Shared -. no Slices dependency .-> Host
    Note1[No CORS - same origin only<br/>wwwroot lives only in Client<br/>No separate frontend server] -.note.- Client