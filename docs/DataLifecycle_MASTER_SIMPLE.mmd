flowchart LR
    subgraph In["Ingestion"]
        Move["Game Move"]
        Stats["Stat Event"]
        HS["High Score"]
    end
    
    subgraph Process["Processing"]
        Rate["Rate Limit"]
        Auth["JWT Check"]
        San["Sanitize"]
        DB["UPSERT/INSERT"]
    end
    
    subgraph Store["Persistence"]
        PStats["PlayerStats"]
        HS_T["HighScores"]
        Match["Match"]
    end
    
    subgraph Out["Egress"]
        Board["Leaderboard"]
        HS_Out["High Score List"]
        Realtime["SignalR"]
    end
    
    Move --> Stats --> Rate --> Auth --> San --> DB
    HS --> Rate --> Auth --> San --> DB
    DB --> PStats & HS_T & Match
    PStats --> Board
    HS_T --> HS_Out
    Match --> Realtime
    
