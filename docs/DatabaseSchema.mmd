erDiagram
    %% DatabaseSchema.mmd
    %% Azure Table Storage architecture, partition/row keys, strongly typed
    %% schema layouts, and indexing relation bounds.
    %%
    %% Cardinalities:
    %%   ||--||   one-to-one
    %%   ||--o{   one-to-zero-or-many
    %%   ||--|{   one-to-one-or-many

    %% ─── Platform-wide tables (StorageService) ───────────────────────────
    PLAYERSTATS {
        PartitionKey string PK "= {game-slug} (e.g. tictactoe, connectfive)"
        RowKey       string RK "= {playerName-lowercased}"
        Wins         int
        Losses       int
        Draws        int
        ELO          int
        TotalGames   int
        LastPlayedAtUtc DateTimeOffset "Timestamp"
    }

    MARBLERACEHIGHSCORES {
        PartitionKey string PK "= 'marblerace' (single-partition leaderboards)"
        RowKey       string RK "= {tick-GUID} or '{player}-{tick}'"
        PlayerName   string "= auth-coerced; client value dropped"
        BestTimeMs   int
        Track        string
        AchievedAtUtc DateTimeOffset
    }

    POBRAWLHIGHSCORES {
        PartitionKey string PK "= 'pobrawl'"
        RowKey       string RK "= {tick-GUID}"
        PlayerName   string
        EloAfter     int
        MatchId      string FK "→ MATCHES.RowKey"
        PlayedAtUtc  DateTimeOffset
    }

    POBRAWLLADDER {
        PartitionKey string PK "= 'pobrawlladder'"
        RowKey       string RK "= {playerName-lowercased}"
        Elo          int
        Wins         int
        Losses       int
        Rank         int "computed"
    }

    PORACERHIGHSCORES {
        PartitionKey string PK "= 'poracer'"
        RowKey       string RK "= SHA-256(immutableScore) — dedup"
        PlayerDisplayName string "auth-coerced"
        TotalTimeSeconds  double
        FinalPosition     int "1..8"
        AchievedAtUtc     DateTimeOffset
        IsGuest           bool
    }

    %% ─── Per-slice tables (game-specific repos) ──────────────────────────
    COUPLEQUIZ_GAMES {
        PartitionKey string PK "= '{roomCode}'"
        RowKey       string RK "= '{connectionId}'"
        DisplayName  string
        JoinedAtUtc  DateTimeOffset
        IsGuest      bool
    }

    COUPLEQUIZ_HISTORY {
        PartitionKey string PK "= '{roomCode}'"
        RowKey       string RK "= '{questionId}-{answerId}'"
        QuestionText string
        Answer       string "similarity-scored by PoMiniGames.AI"
        Score        double
    }

    FUNQUIZ_LEADERBOARD {
        PartitionKey string PK "= '{category}' (General, Science, …)"
        RowKey       string RK "= SHA-256(content)"
        PlayerName   string
        Score        int
        AchievedAtUtc DateTimeOffset
    }

    POSURVIVE_SESSIONS {
        PartitionKey string PK "= '{userId-or-anon}'"
        RowKey       string RK "= '{sessionId-GUID}'"
        StartedAt    DateTimeOffset
        EndedAt      DateTimeOffset
        Outcome      string "RedWin|BlueWin|Draw"
        WinningTeam  string "nullable when Draw"
        TotalTurns   int
        TotalFoodConsumed int
        TotalDamageDealt  int
        Config       object "JSON-serialized SimulationConfigSnapshot"
        Agents       object "JSON-serialized AgentFinalSnapshot[]"
    }

    POSURVIVE_AGENTINFER {
        PartitionKey string PK "= '{sessionId-GUID}'"
        RowKey       string RK "= '{agentId}-{tick}'"
        InferenceMs  int
        PredictedAction string
        Confidence   double
    }

    %% ─── Indexing relations (PK-scoped queries; no joins in Table Storage) ─
    PLAYERSTATS  ||--o{ POBRAWLHIGHSCORES   : "shared PlayerName"
    MATCHES {
        PartitionKey string PK "= '{playerA-or-tournament}'"
        RowKey       string RK "= '{matchId-GUID}'"
        Game         string
        StartedAtUtc DateTimeOffset
        EndedAtUtc   DateTimeOffset
    }
    MATCHES      ||--|{ POBRAWLHIGHSCORES   : "MatchId"

    %% Notes
    %% • All PartitionKey values are designed for **point lookups + per-PK scans**:
    %%   a leaderboard page is a single PartitionKey scan ordered by RowKey.
    %% • RowKeys avoid hot partitions; SHA-256-based RowKeys enable idempotent
    %%   retries (the dedup row collapses onto itself).
    %% • Strongly typed schema = POCOs at the persistence boundary; columns
    %%   mirror POCO property names after JSON-serialising composite columns
    %%   (e.g. `Config`, `Agents`) into a single string column.

