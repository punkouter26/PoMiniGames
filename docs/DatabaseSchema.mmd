erDiagram
    title PoMiniGames Database Schema

    PLAYERSTATS {
        PartitionKey string PK "partition = game slug"
        RowKey string "row = player name lowercased"
        Wins int
        Losses int
        Draws int
        ELO int
        TotalGames int
        LastPlayedAtUtc DateTimeOffset
    }

    MARBLERACEHIGHSCORES {
        PartitionKey string PK "single-partition leaderboards"
        RowKey string "tick GUID or player-tick"
        PlayerName string "auth-coerced"
        BestTimeMs int
        Track string
        AchievedAtUtc DateTimeOffset
    }

    POBRAWLHIGHSCORES {
        PartitionKey string PK "pobrawl partition"
        RowKey string "tick GUID"
        PlayerName string
        EloAfter int
        MatchId string FK "FK to matches RowKey"
        PlayedAtUtc DateTimeOffset
    }

    POBRAWLLADDER {
        PartitionKey string PK "pobrawlladder partition"
        RowKey string "player name lowercased"
        Elo int
        Wins int
        Losses int
        Rank int "computed"
    }

    PORACERHIGHSCORES {
        PartitionKey string PK "poracer partition"
        RowKey string "SHA-256 of immutable score (dedup)"
        PlayerDisplayName string "auth-coerced"
        TotalTimeSeconds double
        FinalPosition int "1 to 8"
        AchievedAtUtc DateTimeOffset
        IsGuest bool
    }

    COUPLEQUIZ_GAMES {
        PartitionKey string PK "room code"
        RowKey string "connection id"
        DisplayName string
        JoinedAtUtc DateTimeOffset
        IsGuest bool
    }

    COUPLEQUIZ_HISTORY {
        PartitionKey string PK "room code"
        RowKey string "question id dash answer id"
        QuestionText string
        Answer string "similarity-scored by PoMiniGames.AI"
        Score double
    }

    FUNQUIZ_LEADERBOARD {
        PartitionKey string PK "category"
        RowKey string "SHA-256 of content"
        PlayerName string
        Score int
        AchievedAtUtc DateTimeOffset
    }

    POSURVIVE_SESSIONS {
        PartitionKey string PK "user id or anon"
        RowKey string "session id GUID"
        StartedAt DateTimeOffset
        EndedAt DateTimeOffset
        Outcome string "RedWin or BlueWin or Draw"
        WinningTeam string "nullable when Draw"
        TotalTurns int
        TotalFoodConsumed int
        TotalDamageDealt int
        Config object "JSON SimulationConfigSnapshot"
        Agents object "JSON AgentFinalSnapshot array"
    }

    POSURVIVE_AGENTINFER {
        PartitionKey string PK "session id GUID"
        RowKey string "agent id dash tick"
        InferenceMs int
        PredictedAction string
        Confidence double
    }

    MATCHES {
        PartitionKey string PK "player A or tournament"
        RowKey string "match id GUID"
        Game string
        StartedAtUtc DateTimeOffset
        EndedAtUtc   DateTimeOffset
    }

    PLAYERSTATS ||--o{ POBRAWLHIGHSCORES : "shared PlayerName"
    MATCHES ||--|{ POBRAWLHIGHSCORES : "MatchId FK"

    PLAYERSTATS {
        string gameSlug "PartitionKey value"
    }