flowchart TD
    subgraph AuthErrors["Auth Error Flows"]
        LoginClick["User clicks Sign In"]
        PopupQ{"MSAL popup\nblocked by browser?"}
        PopupRedirect["Redirect fallback\n/auth-redirect.html\npopup-redirect.ts"]
        PopupOK["Popup auth proceeds\nOAuth2 PKCE"]
        TokenExpQ{"JWT token\nexpired? (12h TTL)"}
        SilentRefresh["Silent token refresh\nMSAL in-memory cache"]
        ReLogin["Re-prompt login\nsession expired"]
        AuthDone(["Auth complete\nBearer JWT in memory"])

        LoginClick --> PopupQ
        PopupQ -->|"blocked"| PopupRedirect --> AuthDone
        PopupQ -->|"allowed"| PopupOK --> TokenExpQ
        TokenExpQ -->|"expired"| SilentRefresh
        SilentRefresh -->|"success"| AuthDone
        SilentRefresh -->|"fail"| ReLogin --> LoginClick
        TokenExpQ -->|"valid"| AuthDone
    end

    subgraph OfflineErrors["API Offline / Offline Resilience"]
        GameInit["Load game\n(Blazor WASM served from CDN)"]
        APIReach{"API reachable?\nfetch /api/health/ping"}
        OfflineMode["Offline mode\nGame runs 100% client-side\nAI + physics fully local"]
        OnlineMode["Online mode\nStats sync enabled"]
        LocalSave2["Stats stored in localStorage\nno data lost during outage"]
        DBSave["Stats stored in SQLite\nvia PUT /api/{game}/stats"]
        SyncQ["API recovers:\nOpportunistic sync\nlocalStorage queue to API"]

        GameInit --> APIReach
        APIReach -->|"unreachable"| OfflineMode --> LocalSave2 --> SyncQ
        APIReach -->|"reachable"| OnlineMode --> DBSave
    end

    subgraph MPErrors["Multiplayer Disconnection Flows"]
        LobbyJoin["Player joins lobby\nWSS /api/hubs/lobby\n?access_token=JWT"]
        HostQ{"Host\ndisconnects?"}
        LobbyReset["Lobby reset\nnon-host becomes host\nor lobby closed"]
        GameStart["Game starts normally\nGameStarting broadcast"]
        MidGameQ{"Player disconnects\nmid-game?"}
        MatchAbandoned["Match abandoned\nno stats recorded\npartial games excluded\n(business rule: completed games only)"]
        GameFinish(["Game completes\nstats submitted to API"])

        LobbyJoin --> HostQ
        HostQ -->|"yes — lobby reset"| LobbyReset --> LobbyJoin
        HostQ -->|"no"| GameStart --> MidGameQ
        MidGameQ -->|"yes"| MatchAbandoned
        MidGameQ -->|"no"| GameFinish
    end

    subgraph ValidationErrors["Input Validation + Rate Limiting"]
        Submit["Submit score or stats\nPOST /api/snake/highscores\nor PUT /api/{game}/players/stats"]
        RateQ{"Rate limit exceeded?\n10 req/min/IP\nfixed window"}
        HTTP429["HTTP 429 Too Many Requests\nRetry-After header returned\nclient backs off"]
        InputQ{"SQL injection chars\nin PlayerName or payload?"}
        HTTP400["HTTP 400 Bad Request\nerror details in body\nno DB write attempted"]
        Saved(["HTTP 201 Created\nor 200 OK\nScore persisted to SQLite"])

        Submit --> RateQ
        RateQ -->|"exceeded"| HTTP429
        RateQ -->|"within limit"| InputQ
        InputQ -->|"invalid chars"| HTTP400
        InputQ -->|"clean input"| Saved
    end

    style LoginClick fill:#1a6b8a,stroke:#0d4a66,color:#fff
