flowchart LR
    subgraph AuthPath["Auth Errors"]
        AuthFail["Auth Failure\nPopup blocked or token expired"]
        AuthRecover["Recovery\nRedirect fallback or re-login"]
    end

    subgraph OfflinePath["API Offline"]
        Offline["API Down\nFull offline mode (CDN only)"]
        Resync["Sync on Recovery\nlocalStorage queue to API"]
    end

    subgraph MPPath["Multiplayer Errors"]
        Disconnect["Host or player disconnects"]
        Lobby["Lobby reset or match abandoned\nno partial stats recorded"]
    end

    subgraph ValidPath["Validation Errors"]
        BadInput["Rate limit or bad input"]
        Error["HTTP 429 or HTTP 400\nclient-facing error"]
    end

    AuthFail --> AuthRecover
    Offline --> Resync
    Disconnect --> Lobby
    BadInput --> Error

    style AuthFail fill:#d83b01,stroke:#a52b00,color:#fff
    style AuthRecover fill:#107c10,stroke:#0a5c0a,color:#fff
    style Offline fill:#d83b01,stroke:#a52b00,color:#fff
    style Resync fill:#107c10,stroke:#0a5c0a,color:#fff
    style Disconnect fill:#d83b01,stroke:#a52b00,color:#fff
    style Lobby fill:#7a3b00,stroke:#4f2700,color:#fff
    style BadInput fill:#d83b01,stroke:#a52b00,color:#fff
    style Error fill:#7a3b00,stroke:#4f2700,color:#fff
