flowchart TD
    subgraph Auth["Auth Errors"]
        Login["Sign In"] --> PopupQ{"Popup?"}
        PopupQ -->|"Blocked"| Redirect["Redirect"]
        PopupQ -->|"OK"| TokenQ{"Token Exp?"}
        TokenQ -->|"Yes"| Refresh["Refresh"] & ReLogin["Re-login"]
        Refresh --> Done["Auth Done"]
        ReLogin --> Login
    end
    
    subgraph Offline["Offline Mode"]
        Game["Load Game"] --> Reach{"API?"}
        Reach -->|"No"| Offline["Offline Mode"] --> Buffer["localStorage"]
        Reach -->|"Yes"| Online["Online Mode"] --> DB["Save to DB"]
    end
    
    subgraph Multiplayer["MP Errors"]
        Join["Join Lobby"] --> HostQ{"Host?"}
        HostQ -->|"Leave"| Reset["Reset Lobby"]
        HostQ -->|"Stay"| Start["Start Game"] --> Mid{"Disconnect?"}
        Mid -->|"Yes"| Abandon["Abandon"]
        Mid -->|"No"| Finish["Finish"]
    end
    
    style Login fill:#1a6b8a,stroke:#0d4a66,color:#fff
    style PopupQ fill:#7a3b00,stroke:#4f2700,color:#fff
    style Redirect fill:#1a6b8a,stroke:#0d4a66,color:#fff
    style TokenQ fill:#7a3b00,stroke:#4f2700,color:#fff
    style Refresh fill:#1a6b8a,stroke:#0d4a66,color:#fff
    style ReLogin fill:#d83b01,stroke:#a52b00,color:#fff
    style Done fill:#107c10,stroke:#0a5c0a,color:#fff
    style Game fill:#1a6b8a,stroke:#0d4a66,color:#fff
    style Reach fill:#7a3b00,stroke:#4f2700,color:#fff
    style Offline fill:#d83b01,stroke:#a52b00,color:#fff
    style Buffer fill:#107c10,stroke:#0a5c0a,color:#fff
    style Online fill:#107c10,stroke:#0a5c0a,color:#fff
    style DB fill:#107c10,stroke:#0a5c0a,color:#fff
    style Join fill:#1a6b8a,stroke:#0d4a66,color:#fff
    style HostQ fill:#7a3b00,stroke:#4f2700,color:#fff
    style Reset fill:#d83b01,stroke:#a52b00,color:#fff
    style Start fill:#107c10,stroke:#0a5c0a,color:#fff
    style Mid fill:#7a3b00,stroke:#4f2700,color:#fff
    style Abandon fill:#d83b01,stroke:#a52b00,color:#fff
    style Finish fill:#107c10,stroke:#0a5c0a,color:#fff