    subgraph RouteViews["Route Views (8 games + home)"]
        HomeP["/ Home\nIndex.razor\nGameTile x8 grid + AuthButton"]
        SinglePlayerP["/singleplayer SinglePlayerPage\nGame picker for AI matches"]
        OnlineMultiplayerP["/multiplayer OnlineMultiplayer\n2P lobby + live game"]
        MultiSelectP["/multiplayer/select MultiPlayerSelect\nGame mode picker"]
        AuthCB["/auth-callback AuthCallback\nMSAL OAuth2 redirect handler"]
        DiagP["/diag DiagPage\nFrontend diagnostics view"]
    end

    subgraph SharedComponents["Shared Components (Components/)"]
        GameShell["GameShell\nheader + nav + footer wrapper\nconsistent chrome across all games"]
        LobbyComp["LobbyComponent\nSignalR WSS connection\nhost controls + player list"]
        LeaderBoard["LeaderboardComponent\nGET /api/{game}/statistics/leaderboard\nTop 10 WinRate table"]
        AuthBtn["AuthButton\nMSAL popup trigger\nsign-in / sign-out"]
        ToastNotif["ToastService\nUI notification bus"]
    end

    subgraph GameModules["Game Modules (Games/)"]
        TicTacToe["TicTacToe/\nMinimaxAI (Hard depth 4)\nHeuristicAI (Med/Easy)\n3x3 board logic"]
        ConnectFive["ConnectFive/\nHeuristic win-detect AI\n15x15 grid + gravity logic"]
        SnakeGame["SnakeGame/\nCanvas renderer\n30s battle arena + multiplayer sync"]
        PoRunner["PoRunner/\nSide-scroller state machine\nphysics-driven gameplay"]
    end

    subgraph ClientServices["Client Services (Services/)"]
        ApiSvc["ApiService\nHttpClient calls to backend\n5s timeout · typed JSON"]
        AuthStateSvc["AuthStateService\nMSAL state machine\nconfig fetch → PKCE popup"]
        GameStatsSvc["GameStatsService\nLocal game result aggregation\nAPI sync + localStorage"]
        PlayerNameSvc["PlayerNameService\nPersistent player name\nbrowser localStorage"]
    end

    subgraph StateLayer["State + Persistence"]
        localStorage["localStorage\nstats cache · sync queue\noffline-resilient buffer"]
    end

