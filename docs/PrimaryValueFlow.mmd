flowchart TD
    Visit(["Player visits pominigames.app"])
    Load["CDN delivers Blazor WASM\nLazy-loaded game bundles\ntarget: sub-1s cold start"]
    Home["Home Page\n8 game tiles\nno auth required"]
    SelectGame["Select Game\ne.g. Tic-Tac-Toe"]
    SelectDiff["Select Difficulty\nEasy · Medium · Hard"]
    PlayVsAI["Play vs AI\nMinimax (Hard) or heuristic (Med)\nAll moves computed client-side\nzero API round-trips during play"]
    GameEnd["Game ends\nResult: Win / Loss / Draw\n(forfeit = no stat recorded)"]
    StatsSaved["Stats saved\nlocalStorage (always)\n+ PUT /api/{game}/players/{name}/stats\n(if online + authed: Bearer JWT)"]
    Leaderboard["Fetch Leaderboard\nGET /api/tictactoe/statistics/leaderboard?limit=10\nrate: GET unrestricted"]
    LeaderView["Top 10 WinRate table\nname · winRate · totalGames · totalWins\np95 target: less than 200ms"]
    PlayAgain{"Play again?"}
    SameGame["Same game\ndifferent difficulty"]
    NewGame["Pick another game\nfrom Home"]

    Visit --> Load --> Home --> SelectGame --> SelectDiff --> PlayVsAI --> GameEnd --> StatsSaved --> Leaderboard --> LeaderView --> PlayAgain
    PlayAgain -->|"Yes — same game"| SameGame --> SelectDiff
    PlayAgain -->|"Yes — new game"| NewGame --> SelectGame

