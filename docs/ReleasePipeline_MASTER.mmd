flowchart LR
    subgraph Source["Source Control (GitHub)"]
        FeatBranch["Feature Branch\nlocal development"]
        PR["Pull Request\ncode review + lint"]
        Master["master branch\nprotected · source of truth"]
    end

    subgraph BuildStage["Build Stage (ubuntu-latest)"]
        Checkout["Checkout + Cache\nNuGet packages · npm deps"]
        BuildAPI["dotnet build\n.NET 10 Release\nTreatWarningsAsErrors=true\nNullable=enable"]
        BuildClient["npm run build\nReact 18 + Vite\nVITE_GAME_URL env vars injected"]
        RunTests["Test Gate\nxUnit unit tests\nTestcontainers integration\nPlaywright E2E (Chromium)"]
        ArtifactAPI["Artifact: api-publish\n.NET linux-x64 binaries\n3-day retention"]
        ArtifactClient["Artifact: client-build\nVite dist bundle\n3-day retention"]
    end

    subgraph DeployStage["Deploy Stage (needs: build)"]
        AzLogin["Azure Login\nOIDC federation\nno stored credentials\nclient-id + tenant-id from secrets"]
        ZipDeploy["App Service zip-deploy\nlinux-x64 · asp-poshared-linux\napp-pominigames"]
        SWADeploy["Static Web App deploy\ndeployment token\npomin"]
    end

    subgraph Production["Production (westus2)"]
        AppSvc["App Service B1\n.NET 10 API + SignalR\nhttp://localhost:5000 (local)\napp-pominigames.azurewebsites.net"]
        StaticApp["Static Web App\nReact SPA + CDN\npomin.azurestaticapps.net"]
    end

    FeatBranch -- "PR + review" --> PR
    PR -- "squash merge" --> Master
    Master -- "push trigger" --> Checkout
    Checkout --> BuildAPI
    Checkout --> BuildClient
    BuildAPI --> RunTests
    BuildClient --> RunTests
    RunTests -- "all pass" --> ArtifactAPI
    RunTests -- "all pass" --> ArtifactClient
    ArtifactAPI --> AzLogin
    ArtifactClient --> AzLogin
    AzLogin --> ZipDeploy
    AzLogin --> SWADeploy
    ZipDeploy --> AppSvc
    SWADeploy --> StaticApp

