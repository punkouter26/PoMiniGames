flowchart TD
    subgraph ClientLayer["Client Layer (Browser)"]
        BlazorApp["Blazor WebAssembly\nC# runtime in browser\nRadzen UI components"]
        MSALLib["MSAL Client\nOAuth2 PKCE · in-memory token cache"]
        SignalRLib["Microsoft.AspNetCore.SignalR.Client\nWSS connection lifecycle · auto-reconnect"]
        ApiService["ApiService\nHttpClient wrapper + offline fallback\nerror boundary + retry"]
        LocalStore["localStorage\noffline stats cache · sync queue"]
    end

    subgraph APILayer["API Layer (.NET 10 — App Service B1)"]
        MinAPI["Minimal API Router\nEndpoint routing + middleware stack\nSerilog · OpenTelemetry · Rate limiting"]
        AuthF["Auth Feature\nGET /api/auth/me\nPOST /api/auth/dev-login (dev only)"]
        LeaderF["Leaderboard Feature\nGET /api/{game}/statistics/leaderboard\nPUT /api/{game}/players/{name}/stats"]
        HSF["HighScore Feature\nGET|POST /api/snake/highscores\nGET|POST /api/podropsquare/highscores"]
        MPF["Multiplayer Feature\nPOST /api/multiplayer/queue"]
        LobbyF["Lobby Feature\n/api/lobby endpoints"]
        RaceF["PoRaceRagdoll Feature\n/api/game/* session endpoints"]
        HealthF["Health Feature\nGET /api/health\nGET /api/health/ping\nGET /diag (dev only)"]
        LobbyHubSvc["LobbyHub\nWSS /api/hubs/lobby\nHost election · GameStarting · LobbyUpdated"]
        MPHubSvc["MultiplayerHub\nWSS /api/hubs/multiplayer\nSendRealtimeInput · RealtimeInput broadcast\nJoinSpectatorGroup"]
    end

    subgraph ServiceLayer["Application Services"]
        StorageSvc["StorageService\nSQLite ADO.NET\nUPSERT PlayerStats · INSERT HighScores"]
        MPSvc["MultiplayerService\nIn-memory match state\nqueue management · matchId allocation"]
        LobbySvc["LobbyService\nIn-memory lobby state\nhost election · connection tracking"]
    end

    subgraph ExternalDeps["External Dependencies"]
        SQLiteDB[("SQLite\n/home/data/pominigames.db\nshared App Service disk")]
        KeyVaultExt["Azure Key Vault\nkv-poshared\nManaged Identity — no credentials stored"]
        AppInsExt["Application Insights\nOpenTelemetry OTLP\nTraces · Exceptions · Metrics"]
        MSIDExt["Microsoft Identity\nJWT Bearer validation\nOAuth2 / OIDC token endpoint"]
    end

    BlazorApp --> ApiService
    BlazorApp --> MSALLib
    BlazorApp --> SignalRLib
    MSALLib --> MSIDExt
    ApiService --> LocalStore
    ApiService --> MinAPI
    SignalRLib --> LobbyHubSvc
    SignalRLib --> MPHubSvc
    MinAPI --> AuthF
    MinAPI --> LeaderF
    MinAPI --> HSF
    MinAPI --> MPF
    MinAPI --> LobbyF
    MinAPI --> RaceF
    MinAPI --> HealthF
    AuthF --> MSIDExt
    LeaderF --> StorageSvc
    HSF --> StorageSvc
    MPF --> MPSvc
    LobbyF --> LobbySvc
    LobbyHubSvc --> LobbySvc
    MPHubSvc --> MPSvc
    StorageSvc --> SQLiteDB
    MPSvc --> SQLiteDB
    MinAPI -->|"startup: fetch secrets"| KeyVaultExt
    MinAPI -->|"OTLP traces + metrics"| AppInsExt

