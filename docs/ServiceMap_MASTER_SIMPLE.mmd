flowchart TD
    subgraph Client["Client"]
        Blazor["Blazor WASM"]
        MSAL["MSAL Client"]
        SignalR["SignalR Client"]
        Api["ApiService"]
    end
    
    subgraph API["API Layer"]
        MinAPI[".NET 10 API"]
        Auth["Auth"]
        Leader["Leaderboard"]
        HS["HighScores"]
        MP["Multiplayer"]
        Lobby["Lobby"]
        Health["Health"]
    end
    
    subgraph Services["Services"]
        Storage["StorageService"]
        Multi["MultiplayerService"]
        Loby["LobbyService"]
    end
    
    subgraph Data["Data"]
        SQLite[("SQLite")]
        KV["Key Vault"]
        AppIns["App Insights"]
        MSID["MS Identity"]
    end
    
    Blazor --> Api
    Api --> MinAPI
    Blazor --> SignalR
    SignalR --> Lobby & MP
    MinAPI --> Auth & Leader & HS & MP & Lobby & Health
    Auth --> Storage
    Leader --> Storage
    HS --> Storage
    MP --> Multi
    Lobby --> Loby
    Storage --> SQLite
    Multi --> SQLite
    MinAPI --> KV & AppIns
    
