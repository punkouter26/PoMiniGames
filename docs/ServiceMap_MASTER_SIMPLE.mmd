    style Api fill:#1a6b8a,stroke:#0d4a66,color:#fff
    style MinAPI fill:#0078d4,stroke:#005a9e,color:#fff
    style Storage fill:#107c10,stroke:#0a5c0a,color:#fff
    style SQLite fill:#107c10,stroke:#0a5c0a,color:#fff