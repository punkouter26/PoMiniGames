    %% User_Journey.mmd
    %% Mobile portrait actor cognitive tasks mapped chronologically against
    %% system-level performance impact scores.
    %%
    %% Each task is "Name : Score : Actor" - score is 1..5 where 5 = highest
    %% cognitive load OR highest system impact (we use it as system impact
    %% because the mobile UX is constrained by CPU / network / battery).
    %% Sections group tasks by journey phase; section names do NOT carry
    %% scores (the journey grammar rejects `:` in section names).

    title PoMiniGames - Mobile Player Journey (portrait)

    section Discover
      Land on slash: 3: Player
      First render: 3: Player
      Tap Microsoft or Guest: 4: Player

    section Authenticate
      Wait for handshake: 4: Player

    section Browse
      Tap game tile: 2: Player
      See game shell: 2: Player

    section Play Solo
      Press Start: 4: Player
      Tick AI opponent: 4: Player
      Win or Lose feedback: 3: Player

    section Multiplayer
      Enter lobby: 5: Player
      Toggle Ready: 4: Player
      Wait for host Start: 4: Player
      Race snapshot stream at 20Hz: 5: Player
      Finish: 4: Player

    section Persist
      Submit score: 4: Player
      View leaderboard: 3: Player

    section Return
      Reload page: 4: Player
      Resume session: 3: Player
      Sign out: 3: Player