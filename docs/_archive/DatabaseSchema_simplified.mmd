erDiagram
    PLAYER_STATS ||--o{ HIGH_SCORES : plays
    PLAYER_STATS ||--o{ MATCH_HISTORY : plays
    PLAYER_STATS ||--o{ LOBBY_MEMBERS : joins
    LOBBY_STATE ||--|{ LOBBY_MEMBERS : contains
    HIGH_SCORES ||--|| LEADERBOARD_PROJECTION : ranks
    SURVIVE_RUN ||--o{ SURVIVE_LOOT : drops

    PLAYER_STATS {
        string PartitionKey PK "UserId"
        string RowKey "Stats"
        int EloRating
        int TotalGames
    }

    HIGH_SCORES {
        string PartitionKey PK "GameId"
        string RowKey "UserId"
        int Score
        string GameMode
    }

    LOBBY_STATE {
        string PartitionKey PK "LobbyId"
        string RowKey "Meta"
        string Status
        string HostUserId
    }

    LOBBY_MEMBERS {
        string PartitionKey PK "LobbyId"
        string RowKey "UserId"
        string Role
    }

    MATCH_HISTORY {
        string PartitionKey PK "GameId"
        string RowKey "MatchId"
        string WinnerUserId
        int EloDelta
    }

    LEADERBOARD_PROJECTION {
        string PartitionKey PK "GameId"
        string RowKey "Rank"
        string UserId
        int Score
    }

    SURVIVE_RUN {
        string PartitionKey PK "UserId"
        string RowKey "RunId"
        int Wave
        int Score
    }

    SURVIVE_LOOT {
        string PartitionKey PK "RunId"
        string RowKey "LootId"
        string ItemKey
    }