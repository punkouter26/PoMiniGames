flowchart LR
    subgraph ClientSide[Client Side - mobile]
        Tap([Player taps Find Match])
        ClientQueue[Typed HttpClient<br/>POST /api/lobby/join]
        ClientSubscribe[HubConnection.StartAsync<br/>subscribe to /hubs/lobby]
        ClientAwait[Wait for GameStarting event]
        ClientState[Apply state<br/>opponentId, role, seed, turn=Host]
        ClientLoop[requestAnimationFrame loop<br/>60fps target]
        ClientSend[SendRealtimeInput hub method]
        ClientRender[Apply opponent move to view model]
        ClientOffline[Detect SignalR disconnect<br/>reconnect with backoff]
        ClientClean[Cleanup UI + free SignalR resources]
    end

    subgraph ServerSide[Server Side - ASP.NET host]
        ServerQueue[Slice handler validates + writes LobbyState row]
        ServerWait[Hold request until second unique user joins]
        ServerValidate{Validate lobby state<br/>2 unique users +<br/>host already elected?}
        ServerRefuse[HubContext.Clients.Caller<br/>disconnect with reason]
        ServerBroadcast[Hub broadcast GameStarting<br/>to lobby group]
        HubValidate{Validate move:<br/>player turn +<br/>game phase +<br/>payload schema}
        HubReject[Send error event<br/>to caller only]
        HubEcho[Broadcast move to opponent group<br/>NOT back to caller]
        HubDisconnect[OnDisconnectedAsync<br/>remove from group +<br/>notify opponent]
    end

    Tap --> ClientQueue
    ClientQueue --> ServerQueue
    ServerQueue --> ServerWait
    ServerWait --> ClientSubscribe
    ClientSubscribe --> ClientAwait
    ServerWait --> ServerValidate
    ServerValidate -->|valid| ServerBroadcast
    ServerValidate -->|invalid| ServerRefuse
    ServerBroadcast --> ClientState
    ServerRefuse --> ClientClean
    ClientState --> ClientLoop
    ClientLoop --> ClientSend
    ClientSend --> HubValidate
    HubValidate -->|valid| HubEcho
    HubValidate -->|invalid| HubReject
    HubEcho --> ClientRender
    HubReject --> ClientLoop
    ClientRender --> ClientLoop
    HubEcho -.signal drop.-> ClientOffline
    ClientOffline -->|reconnect| ClientSubscribe
    ClientOffline -->|give up| ClientClean
    HubEcho -.server-side disconnect.-> HubDisconnect
    HubDisconnect --> ClientClean