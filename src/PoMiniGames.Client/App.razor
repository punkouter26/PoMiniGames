@using Microsoft.AspNetCore.Components.Authorization
@* §2.3: AuthGate gates the whole app. AppErrorBoundary wraps everything so an
   unhandled exception in any page surfaces an actionable, environment-aware
   banner instead of the default Blazor error template. *@

<AuthGate>
    <AppErrorBoundary>
    <CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            @* §2.3: AuthorizeRouteView prevents page flashing on routes that opt into
                 [Authorize]. Routes that do not opt in render normally (the default
                 for the public games suite). *@
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <PageTitle>Not authorized</PageTitle>
                    <LayoutView Layout="@typeof(Layout.MainLayout)">
                        <div class="app-fallback">
                            <h1>Sign in required</h1>
                            <p>
                                This page is only available to signed-in players. Use the
                                <strong>Sign in</strong> button in the top bar to continue.
                            </p>
                            <a href="/" class="app-fallback-link">← Back to home</a>
                        </div>
                    </LayoutView>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <p class="app-fallback--plain">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
    </CascadingAuthenticationState>
    </AppErrorBoundary>
</AuthGate>
