@namespace PoMiniGamesClient.Components
@using PoMiniGamesClient.Services
@using Microsoft.AspNetCore.Components.Routing
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

@if (AuthState.IsLoading)
{
    <div class="login-page">
        <span class="login-mesh" aria-hidden="true"></span>
        <div class="login-card">
            <div class="login-spinner" aria-label="Loading"></div>
            <p class="login-sub">Loading…</p>
        </div>
    </div>
}
else if (IsAuthExemptRoute())
{
    @* The OAuth landing routes (/auth/callback, /auth/login/microsoft) MUST
       render while signed out — AuthCallbackPage is what drains the MSAL auth
       code from the URL and completes the session. Gating them would deadlock
       sign-in: no session, so the gate shows the login screen; login redirects
       back here; the page that would have created the session never renders. *@
    @ChildContent
}
else if (!AuthState.IsAuthenticated && !_silentDevLoginInFlight)
{
    @* Demo URLs stay zero-friction for the attraction/kiosk loop: they mint a
       Guest session in the background rather than stopping on the login screen.
       That is still an authenticated session — it just isn't hand-typed. Dev
       only, because the silent path goes through the dev-login endpoint. *@
    if (AuthState.DevLoginEnabled && IsDemoRoute())
    {
        _ = EnsureDemoGuestAsync();
    }
    else
    {
        @* 2026-08-09, by request: the app is gated again. Everyone signs in —
           Guest or Microsoft in dev, Microsoft in production — before any route
           renders.

           This deliberately reverses two earlier decisions, so if you are here
           to "restore" one of them, read this first:
             · "§10 Guest-first" made the app open and offered sign-in on demand.
             · 2026-08-08 audit #15 replaced a hard gate with a banner over the
               real page, because a bare login screen made /leaderboards and
               friends look broken to a first-time visitor.
           Audit #15's concern is real and is now handled inside LoginScreen's
           copy rather than by letting the page through. Deep links still work:
           the requested URL is untouched, so completing sign-in lands the user
           exactly where they were headed. *@
        <LoginScreen />
    }
}
else
{
    @ChildContent
}

@code {
    // §10 The app renders for everyone once the auth handshake settles. We still run
    // InitializeAsync (below) so an existing cookie/MSAL session is restored — a
    // returning signed-in player keeps their identity — but a brand-new visitor is
    // never blocked: they browse and play as a guest until they choose to sign in.
    [Parameter] public RenderFragment ChildContent { get; set; } = default!;

    // §Demo-route silent dev-login: gate flips to true only while we're
    // background-minting a guest session on a demo URL. Prevents the
    // LoginScreen from flashing on top of the spinner during the ~50ms
    // between dev-login kicking off and the cookie landing.
    private bool _silentDevLoginInFlight;
    private bool _demoGuestStarted;

    /// <summary>
    /// Routes that must render without a session. Only the OAuth landing pages
    /// qualify — see the note in the markup for why gating them deadlocks
    /// sign-in. Both of AuthCallbackPage's @@page templates are listed; adding a
    /// third there means adding it here too.
    /// </summary>
    private static readonly string[] AuthExemptPaths =
    [
        "/auth/callback",
        "/auth/login/microsoft",
    ];

    private bool IsAuthExemptRoute()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        if (path.Length == 0) return false;
        foreach (var exempt in AuthExemptPaths)
        {
            if (string.Equals(path, exempt, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        AuthState.StateChanged += OnAuthStateChanged;
        // Both gate decisions (IsAuthExemptRoute, IsDemoRoute) read the current
        // URL, but this component sits ABOVE the Router, so a navigation does not
        // re-render it on its own — without this subscription the gate would keep
        // acting on the URL the app was first loaded with.
        Navigation.LocationChanged += OnLocationChanged;
        var query = new Uri(Navigation.Uri).Query;
        await AuthState.InitializeAsync(query);
    }

    private void OnAuthStateChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Demo URL patterns the app treats as zero-friction: any path ending in
    /// <c>/demo</c> or <c>/1</c> (the canonical demo flag for routes like
    /// <c>/pobrawl/{Demo:int}</c>, <c>/connectfive/{Demo:int}</c>, etc.),
    /// plus the explicit <c>?demo=1</c> query string for routes that don't
    /// use the typed route parameter.
    /// </summary>
    private bool IsDemoRoute()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        if (path.EndsWith("/demo", StringComparison.Ordinal)) return true;
        // /pobrawl/1, /connectfive/1, /tictactoe/1, /funquiz/1 — all the
        // {Demo:int} route templates take a trailing 1 to mean "demo".
        if (path.Length >= 2 && path[^1] == '1' && char.IsDigit(path[^1]))
        {
            var prev = path.Length >= 3 ? path[^2] : '\0';
            if (prev == '/') return true;
        }
        // Fallback query-string form. Inline mini-parser so we don't take a
        // dependency on System.Web.HttpUtility, which isn't part of the
        // Blazor WASM BCL by default.
        var query = new Uri(Navigation.Uri).Query;
        if (QueryStringHasTrueFlag(query, "demo"))
        {
            return true;
        }
        return false;
    }

    private static bool QueryStringHasTrueFlag(string query, string key)
    {
        if (string.IsNullOrEmpty(query)) return false;
        // query is "foo=1&bar=2" or "?foo=1&bar=2" — strip the leading ?.
        var s = query.StartsWith('?') ? query[1..] : query;
        foreach (var pair in s.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0) continue;
            var k = pair[..eq];
            if (!string.Equals(k, key, StringComparison.OrdinalIgnoreCase)) continue;
            var v = pair[(eq + 1)..];
            return v == "1" || string.Equals(v, "true", StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }

    private async Task EnsureDemoGuestAsync()
    {
        // Idempotent: only one in-flight attempt per gate instance. Subsequent
        // OnAuthStateChanged events that arrive while we're authenticating will
        // see the in-flight flag and skip the LoginScreen render entirely.
        if (_demoGuestStarted) return;
        _demoGuestStarted = true;
        _silentDevLoginInFlight = true;
        try
        {
            await AuthState.SignInAsync();
        }
        catch
        {
            // AuthState swallows errors internally; nothing to do here. Worst
            // case the LoginScreen re-appears for one frame on a hard failure.
        }
        finally
        {
            _silentDevLoginInFlight = false;
            // Force a re-render so the gate re-evaluates IsAuthenticated now
            // that the dev-login has settled.
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        AuthState.StateChanged -= OnAuthStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
