@namespace PoMiniGamesClient.Components
@inject NavigationManager NavigationManager

@*
    §9 Bottom-tab-bar for mobile portrait. Anchored to the bottom of the viewport
    with a 3-icon primary navigation: Home / Scores / Me. Hidden on >= 641 px so
    the L-C-R top-bar contract on desktop / landscape stays intact.
    Auth was previously the 5th icon; it's now reachable via the overflow menu
    in the top bar (and remains visible on >= 480 px via the Sign in / Sign out
    button) so the mobile tab strip gets ~25 % more horizontal room per icon.
    The "Demo" tab was removed 2026-07-04: it duplicated the Index.razor Demo
    card and routed users into the kiosk auto-cycle with no exit affordance
    (KioskControlBar was previously removed from the layout).
*@

<nav class="btb" aria-label="Primary navigation">
    <a class="btb-item @(IsActive("/") ? "btb-item--active" : null)" href="/"
       aria-label="Home" aria-current="@(IsActive("/") ? "page" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span class="btb-label">Home</span>
    </a>

    <a class="btb-item @(IsActive("/leaderboards") ? "btb-item--active" : null)" href="/leaderboards"
       aria-label="Leaderboards" aria-current="@(IsActive("/leaderboards") ? "page" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 6 9 6 9z"/>
            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5C17 4 18 9 18 9z"/>
            <path d="M4 22h16"/>
            <path d="M10 22V9h4v13"/>
            <path d="M8 22V8"/>
            <path d="M16 22V8"/>
        </svg>
        <span class="btb-label">Scores</span>
    </a>

    <a class="btb-item @(IsActive("/profile") ? "btb-item--active" : null)" href="/profile"
       aria-label="My profile" aria-current="@(IsActive("/profile") ? "page" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
        </svg>
        <span class="btb-label">Me</span>
    </a>
</nav>

@code {
    private bool IsActive(string path)
    {
        var current = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        // Strip query/fragment so "/?autoGuest=1" still matches Home, then normalise
        // leading/trailing slashes on BOTH sides — ToBaseRelativePath drops the leading
        // slash but the hrefs ("/leaderboards") keep it, so a raw compare never matched.
        var cut = current.IndexOfAny(['?', '#']);
        if (cut >= 0) current = current[..cut];
        current = current.Trim('/');
        var compare = path.Trim('/');
        if (string.IsNullOrEmpty(compare)) return string.IsNullOrEmpty(current);
        return current.Equals(compare, StringComparison.OrdinalIgnoreCase)
            || current.StartsWith(compare + "/", StringComparison.OrdinalIgnoreCase);
    }
}