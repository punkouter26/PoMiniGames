@namespace PoMiniGamesClient.Components
@inject AuthStateService AuthState
@inject NavigationManager NavigationManager

@*
    §9 Bottom-tab-bar for mobile portrait. Anchored to the bottom of the viewport
    with a 5-icon primary navigation: Home / Scores / Demo / Me / Auth. Hidden on
    >= 641 px so the L-C-R top-bar contract on desktop / landscape stays intact.
*@

<nav class="btb" aria-label="Primary navigation">
    <a class="btb-item @(IsActive("/") ? "btb-item--active" : null)" href="/"
       aria-label="Home" aria-current="@(IsActive("/") ? "page" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span class="btb-label">Home</span>
    </a>

    <a class="btb-item @(IsActive("/leaderboards") ? "btb-item--active" : null)" href="/leaderboards"
       aria-label="Leaderboards" aria-current="@(IsActive("/leaderboards") ? "page" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 6 9 6 9z"/>
            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5C17 4 18 9 18 9z"/>
            <path d="M4 22h16"/>
            <path d="M10 22V9h4v13"/>
            <path d="M8 22V8"/>
            <path d="M16 22V8"/>
        </svg>
        <span class="btb-label">Scores</span>
    </a>

    <button type="button"
            class="btb-item @(IsDemoActive ? "btb-item--active" : null)"
            aria-label="@(IsDemoActive ? "Stop demo auto-cycle" : "Watch all demos")"
            aria-pressed="@IsDemoActive"
            @onclick="ToggleDemoAsync">
        @if (IsDemoActive)
        {
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <rect x="6" y="5" width="4" height="14" rx="1"/>
                <rect x="14" y="5" width="4" height="14" rx="1"/>
            </svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <polygon points="6 4 20 12 6 20 6 4"/>
            </svg>
        }
        <span class="btb-label">@(IsDemoActive ? "Stop" : "Demo")</span>
    </button>

    <a class="btb-item @(IsActive("/profile") ? "btb-item--active" : null)" href="/profile"
       aria-label="My profile" aria-current="@(IsActive("/profile") ? "page" : null)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
        </svg>
        <span class="btb-label">Me</span>
    </a>

    <button type="button"
            class="btb-item btb-item--auth"
            aria-label="@(AuthState.IsAuthenticated ? "Sign out" : "Sign in")"
            @onclick="AuthToggleAsync">
        @if (AuthState.IsAuthenticated)
        {
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            <span class="btb-label">Sign out</span>
        }
        else
        {
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                <polyline points="10 17 15 12 10 7"/>
                <line x1="15" y1="12" x2="3" y2="12"/>
            </svg>
            <span class="btb-label">Sign in</span>
        }
    </button>
</nav>

@code {
    [Inject] private KioskCoordinator Kiosk { get; set; } = default!;

    private bool IsDemoActive => Kiosk.IsActive;

    private bool IsActive(string path)
    {
        var current = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        // Strip query/fragment so "/?autoGuest=1" still matches Home, then normalise
        // leading/trailing slashes on BOTH sides — ToBaseRelativePath drops the leading
        // slash but the hrefs ("/leaderboards") keep it, so a raw compare never matched.
        var cut = current.IndexOfAny(['?', '#']);
        if (cut >= 0) current = current[..cut];
        current = current.Trim('/');
        var compare = path.Trim('/');
        if (string.IsNullOrEmpty(compare)) return string.IsNullOrEmpty(current);
        return current.Equals(compare, StringComparison.OrdinalIgnoreCase)
            || current.StartsWith(compare + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleDemoAsync()
    {
        if (Kiosk.IsActive)
        {
            Kiosk.Stop();
            return;
        }

        var demos = GameCatalog.Demo;
        if (demos.Count == 0) return;

        Kiosk.RegisterEntries(demos.Select(d => new DemoEntry(d.Key, d.Url, d.Title, d.Icon)));
        var first = demos[0];
        var sep = first.Url.Contains('?') ? '&' : '?';
        Kiosk.Start(1);
        NavigationManager.NavigateTo($"{first.Url}{sep}kiosk=1");
    }

    private async Task AuthToggleAsync()
    {
        if (AuthState.IsAuthenticated)
        {
            await AuthState.SignOutAsync();
        }
        else
        {
            await AuthState.SignInAsync();
        }
    }
}