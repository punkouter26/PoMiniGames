@implements IDisposable
@inject IJSRuntime JSRuntime
@inject Services.SettingsService Settings

@* Hidden (not unmounted) when the FPS badge is toggled off in ⚙️ settings —
   the sampler keeps running so re-enabling shows a live value instantly.
   2026-07-19: the "— FPS" em-dash placeholder read like a missing field; we
   now keep the chip itself hidden until the sampler has produced its first
   real reading, so the first paint of any game page never shows a stale
   dash that the user can't distinguish from "this game is at zero fps". *@
@if (Settings.ShowFps && _hasReading)
{
    <span class="gl-fps gl-fps--centered" title="Frames per second" data-tier="@_tier">@_label</span>
}

@code {
    private string _label = "— FPS";
    private string _tier = "ok";
    private bool _hasReading;
    private int _frames;
    private double _elapsedMs;
    private DotNetObjectReference<FpsCounter>? _ref;
    private bool _running;
    private Action? _onSettingsChanged;

    protected override void OnInitialized()
    {
        _onSettingsChanged = () => InvokeAsync(StateHasChanged);
        Settings.Changed += _onSettingsChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _running) return;
        _running = true;
        _ref = DotNetObjectReference.Create(this);
        // JS interop can throw during SSR / pre-render — swallow and let the
        // placeholder label stand so the page still renders.
        try { JSRuntime.InvokeVoidAsync("glFps.start", _ref); } catch { }
    }

    [JSInvokable]
    public void OnTick(double deltaMs)
    {
        _frames++;
        _elapsedMs += deltaMs;
        if (_elapsedMs < 500) return;
        var fps = Math.Round(_frames * 1000.0 / _elapsedMs);
        _frames = 0;
        _elapsedMs = 0;
        var next = $"{fps:0} FPS";
        var nextTier = fps >= 55 ? "ok" : fps >= 30 ? "warn" : "bad";
        if (next == _label && nextTier == _tier && _hasReading) return;
        _label = next;
        _tier = nextTier;
        _hasReading = true;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_onSettingsChanged != null) Settings.Changed -= _onSettingsChanged;
        _running = false;
        try { JSRuntime.InvokeVoidAsync("glFps.stop"); } catch { }
        _ref?.Dispose();
    }
}