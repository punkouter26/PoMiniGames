@implements IDisposable
@inject IJSRuntime JSRuntime
@inject Services.SettingsService Settings

@* Hidden (not unmounted) when the FPS badge is toggled off in ⚙️ settings —
   the sampler keeps running so re-enabling shows a live value instantly.
   2026-07-19: the "— FPS" em-dash placeholder read like a missing field; we
   now keep the chip itself hidden until the sampler has produced its first
   real reading, so the first paint of any game page never shows a stale
   dash that the user can't distinguish from "this game is at zero fps". *@
@if (Settings.ShowFps && _hasReading)
{
    <span class="gl-fps gl-fps--centered" title="Frames per second" data-tier="@_tier">@_label</span>
}

@code {
    private string _label = "— FPS";
    private string _tier = "ok";
    private bool _hasReading;
    private int _frames;
    private double _elapsedMs;
    private DotNetObjectReference<FpsCounter>? _ref;
    private bool _running;
    private Action? _onSettingsChanged;

    protected override void OnInitialized()
    {
        // Re-render AND reconcile the sampler: toggling the badge on is what starts
        // it now, so the handler cannot be a bare StateHasChanged any more.
        _onSettingsChanged = () => InvokeAsync(async () =>
        {
            await SyncSamplerAsync();
            StateHasChanged();
        });
        Settings.Changed += _onSettingsChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender ? SyncSamplerAsync() : Task.CompletedTask;

    /// <summary>
    /// Start the sampler when the badge is on, stop it when it is off.
    /// </summary>
    /// <remarks>
    /// It used to start unconditionally on first render and never stop, on the
    /// reasoning that re-enabling the badge should show a value instantly. That
    /// traded a permanent per-frame rAF callback and a JS interop round trip every
    /// tick for one moment of latency — and once the badge became opt-out rather
    /// than opt-in (it now defaults off), it was a cost almost every player paid
    /// for a readout they had not asked for. Starting on demand costs one frame.
    /// </remarks>
    private async Task SyncSamplerAsync()
    {
        try
        {
            if (Settings.ShowFps && !_running)
            {
                _running = true;
                // Imported here, not from a <script> tag: the badge is off by
                // default, so the module should not be on the critical path of
                // every page load.
                await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/gl-fps.js");
                _ref ??= DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("glFps.start", _ref);
            }
            else if (!Settings.ShowFps && _running)
            {
                _running = false;
                _hasReading = false;
                await JSRuntime.InvokeVoidAsync("glFps.stop");
            }
        }
        catch
        {
            // Interop can throw during pre-render, or the module may be blocked.
            // The badge is a diagnostic — never let it break a page.
        }
    }

    [JSInvokable]
    public void OnTick(double deltaMs)
    {
        _frames++;
        _elapsedMs += deltaMs;
        if (_elapsedMs < 500) return;
        var fps = Math.Round(_frames * 1000.0 / _elapsedMs);
        _frames = 0;
        _elapsedMs = 0;
        var next = $"{fps:0} FPS";
        var nextTier = fps >= 55 ? "ok" : fps >= 30 ? "warn" : "bad";
        if (next == _label && nextTier == _tier && _hasReading) return;
        _label = next;
        _tier = nextTier;
        _hasReading = true;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_onSettingsChanged != null) Settings.Changed -= _onSettingsChanged;
        _running = false;
        try { JSRuntime.InvokeVoidAsync("glFps.stop"); } catch { }
        _ref?.Dispose();
    }
}