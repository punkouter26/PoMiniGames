@implements IDisposable
@inject IJSRuntime JSRuntime

@* Live frame-rate badge in the top nav. Always on as of 2026-08-11 (user
   request): it used to be gated on a /settings toggle that defaulted off, and
   that page is gone, so the sampler now starts on first render on every route.

   2026-07-19: the "— FPS" em-dash placeholder read like a missing field; we
   keep the chip itself hidden until the sampler has produced its first real
   reading, so the first paint of any game page never shows a stale dash that
   the user can't distinguish from "this game is at zero fps". *@
@if (_hasReading)
{
    <span class="gl-fps gl-fps--centered" title="Frames per second" data-tier="@_tier">@_label</span>
}

@code {
    private string _label = "— FPS";
    private string _tier = "ok";
    private bool _hasReading;
    private int _frames;
    private double _elapsedMs;
    private DotNetObjectReference<FpsCounter>? _ref;
    private bool _running;

    // Ownership token for the single global sampler: each layout carries its own
    // <FpsCounter />, so on navigation two instances briefly coexist. The token
    // lets this instance's Dispose stop the loop only if it still owns it — see
    // the note atop js/gl-fps.js.
    private static int _nextToken;
    private readonly int _token = System.Threading.Interlocked.Increment(ref _nextToken);

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender ? StartSamplerAsync() : Task.CompletedTask;

    private async Task StartSamplerAsync()
    {
        if (_running) return;
        try
        {
            _running = true;
            await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/gl-fps.js");
            _ref ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("glFps.start", _ref, _token);
        }
        catch
        {
            // Interop can throw during pre-render, or the module may be blocked.
            // The badge is a diagnostic — never let it break a page.
            _running = false;
        }
    }

    [JSInvokable]
    public void OnTick(double deltaMs)
    {
        _frames++;
        _elapsedMs += deltaMs;
        if (_elapsedMs < 500) return;
        var fps = Math.Round(_frames * 1000.0 / _elapsedMs);
        _frames = 0;
        _elapsedMs = 0;
        var next = $"{fps:0} FPS";
        var nextTier = fps >= 55 ? "ok" : fps >= 30 ? "warn" : "bad";
        if (next == _label && nextTier == _tier && _hasReading) return;
        _label = next;
        _tier = nextTier;
        _hasReading = true;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _running = false;
        try { JSRuntime.InvokeVoidAsync("glFps.stop", _token); } catch { }
        _ref?.Dispose();
    }
}
