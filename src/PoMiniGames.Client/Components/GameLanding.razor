@namespace PoMiniGamesClient.Components

@* Shared pre-game landing card: every game's mode-select / config screen uses
   the same skeleton — title, subtitle, game-specific body (pickers, ladders,
   name fields), one primary CTA, and an optional boards section underneath.
   Pages keep full control of the body; the shell keeps the layout identical. *@
<div class="gps-game-card gpl-card">
    <h2 class="gps-phase-h">@Title</h2>
    @if (Subtitle != null)
    {
        <p class="gpl-subtitle">@Subtitle</p>
    }
    @if (ChildContent != null)
    {
        <div class="gpl-body">@ChildContent</div>
    }
    @if (OnStart.HasDelegate)
    {
        <button class="gps-cta gpl-cta" @onclick="OnStart">@CtaText</button>
    }
    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="gps-error">@Error</p>
    }
    @if (Boards != null)
    {
        <div class="gpl-boards">@Boards</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CtaText { get; set; } = "▶ Start";
    [Parameter] public EventCallback OnStart { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public RenderFragment? Boards { get; set; }
}
