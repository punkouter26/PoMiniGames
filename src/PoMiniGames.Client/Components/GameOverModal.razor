@namespace PoMiniGamesClient.Components

@* ─────────────────────────────────────────────────────────────────────────
   The one end-of-game modal for every game in PoMiniGames.

   Centered, blocking, no backdrop-dismiss: the final result (GameSummary), the
   stats grid (Stats), this game's top 3 (fetched from GameKey), and a single OK
   that returns to the main menu.

   Most games get this for free by passing GameOver to <GameShell>, which renders
   this component. It is a standalone component rather than markup inside
   GameShell so games that legitimately can't host GameShell — PoSurvive runs its
   own C64 layout and SurviveStore — still end on the identical dialog instead of
   hand-rolling a lookalike. Styling lives in wwwroot/css/game-shell.css.
   ───────────────────────────────────────────────────────────────────────── *@

<div class="gps-modal-overlay" role="presentation" tabindex="0" @onkeydown="HandleKey">
    <div class="gps-modal" role="dialog" aria-modal="true" aria-label="Game over" data-fx-tilt="5">
        <header class="gps-modal-header">
            <div class="gps-modal-title">@Title</div>
        </header>

        @if (GameSummary != null)
        {
            <div class="gps-game-summary">@GameSummary</div>
        }

        @if (Stats != null && Stats.Any())
        {
            <div class="gps-modal-stats">
                @foreach (var stat in Stats)
                {
                    <div class="gps-stat">
                        <span class="gps-stat-value">@stat.Value</span>
                        <span class="gps-stat-label">@stat.Label</span>
                    </div>
                }
            </div>
        }

        @* Where the player actually stands. Silently absent when they have no row
           on this board yet — an end-of-game modal should never invent a rank. *@
        @if (_myRank is int rank)
        {
            <div class="gps-modal-rank @(_delta > 0 ? "gps-modal-rank--up" : null)">
                <span class="gps-modal-rank-pos">#@rank</span>
                <span class="gps-modal-rank-of">of @BoardSizeLabel</span>
                @if (_delta > 0)
                {
                    <span class="gps-modal-rank-delta" title="@_delta places since your last game">▲@_delta</span>
                }
            </div>
        }

        @* Silently omitted when the game has no board (GameKey null / 404) or the
           API is offline — the modal still works, it just shows no top 3. *@
        @if (_board is not null && _board.Entries.Count > 0)
        {
            <div class="gps-modal-board">
                <div class="gps-modal-board-head">
                    <span class="gps-modal-board-title">🏆 Top 3</span>
                    <span class="gps-modal-board-unit">@_board.Unit</span>
                </div>
                <ol class="gps-modal-board-rows">
                    @foreach (var e in _board.Entries)
                    {
                        <li class="gps-modal-board-row gps-modal-board-row--@e.Rank @(IsMe(e) ? "gps-modal-board-row--me" : null)">
                            <span class="gps-modal-board-rank">@e.Rank</span>
                            <span class="gps-modal-board-name" title="@e.Detail">@e.Name</span>
                            <span class="gps-modal-board-value">@e.DisplayValue</span>
                        </li>
                    }
                </ol>
            </div>
        }

        <footer class="gps-play-again-actions">
            @if (PlayAgain.HasDelegate)
            {
                <button class="gps-play-again-btn gps-play-again-btn--secondary"
                        @onclick="Back">
                    <span>Back</span>
                    <kbd class="gps-kbd">Esc</kbd>
                </button>
                <button class="gps-play-again-btn gps-play-again-btn--primary"
                        @onclick="() => PlayAgain.InvokeAsync()"
                        autofocus>
                    <span>Play again</span>
                    <kbd class="gps-kbd gps-kbd--primary">↵</kbd>
                </button>
            }
            else
            {
                <button class="gps-play-again-btn gps-play-again-btn--primary"
                        @onclick="Back"
                        autofocus>
                    <span>Back to all games</span>
                    <kbd class="gps-kbd gps-kbd--primary">Esc</kbd>
                </button>
            }
        </footer>
    </div>
</div>

@code {
    /// <summary>Modal heading — normally the game's title.</summary>
    [Parameter] public RenderFragment? Title { get; set; }

    /// <summary>The result line(s): who won, the final score.</summary>
    [Parameter] public RenderFragment? GameSummary { get; set; }

    /// <summary>Optional value-over-label stat cells.</summary>
    [Parameter] public List<Models.StatItem>? Stats { get; set; }

    /// <summary>
    /// Catalog key for this game's unified leaderboard (e.g. "connectfive").
    /// Null for modes with no meaningful board (local 2-player, demo).
    /// </summary>
    [Parameter] public string? GameKey { get; set; }

    /// <summary>Player name, used to highlight their own row in the top 3.</summary>
    [Parameter] public string? Player { get; set; }

    /// <summary>Where OK navigates. The main menu unless a game overrides it.</summary>
    [Parameter] public string BackTo { get; set; } = "/";

    /// <summary>
    /// Optional teardown to run when OK is pressed, before navigating. For games
    /// holding end-of-match state outside the page (PoSurvive's SurviveStore keeps
    /// ShowPostMortem set), this is where that state gets cleared — otherwise the
    /// modal would still be up when the player next opens the game.
    /// </summary>
    [Parameter] public EventCallback OnOk { get; set; }

    /// <summary>
    /// 2026-08-10: optional "Play again" handler. When set, the modal shows
    /// a secondary button next to OK that re-runs the page (the page owns the
    /// reset). Leave null (the default) to keep the OK-only flow every other
    /// game uses. Only ever opt in for modes without a server leaderboard at
    /// stake — solo should not show it (the previous run just got submitted),
    /// local 2-player split-screen is the intended user.
    /// </summary>
    [Parameter] public EventCallback PlayAgain { get; set; }

    /// <summary>
    /// How the match ended, so the modal can sound the right cue. Left
    /// <see cref="Models.GameOutcome.Unknown"/> by games that do not report it,
    /// which sounds a neutral round-over rather than guessing — celebrating a
    /// loss is worse than saying nothing.
    /// </summary>
    [Parameter] public Models.GameOutcome Outcome { get; set; } = Models.GameOutcome.Unknown;

    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private Services.ApiService Api { get; set; } = null!;
    [Inject] private Services.UiFeedbackService Feedback { get; set; } = null!;

    private Models.GameLeaderboardDto? _board;

    /// <summary>The player's own rank on this board, when they have a row on it.</summary>
    private int? _myRank;

    /// <summary>How many ranked rows came back, for the "of N" denominator.</summary>
    private int _boardSize;

    /// <summary>
    /// The denominator, marked "100+" when the read filled the server's page.
    /// A full page means there may be more players below it, so printing a bare
    /// "of 100" would state a total we did not actually measure.
    /// </summary>
    private string BoardSizeLabel =>
        _boardSize >= RankSearchDepth ? $"{RankSearchDepth}+" : _boardSize.ToString();

    /// <summary>
    /// Places gained since the last time this player saw this board. Zero when
    /// they lost ground, held station, or have no previous rank recorded — the
    /// modal only ever celebrates an improvement, never rubs in a drop.
    /// </summary>
    private int _delta;

    /// <summary>Mirrors the server's padding sentinel (UnifiedLeaderboardEndpoints.PlaceholderName).</summary>
    private const string PlaceholderName = "XXX";

    /// <summary>
    /// How deep to look for the player's own row. The visible top 3 cannot rank
    /// anyone outside it, and one wider read is cheaper than a second
    /// round-trip. A player ranked below this gets no rank line, which is the
    /// same graceful nothing as being offline.
    /// </summary>
    /// <remarks>
    /// 100 is the server's ceiling, not a preference:
    /// <c>UnifiedLeaderboardEndpoints</c> does <c>Math.Clamp(limit, 1, 100)</c>,
    /// so asking for more is silently truncated and would make this constant a
    /// lie about how deep the search actually goes.
    /// </remarks>
    private const int RankSearchDepth = 100;

    /// <summary>
    /// Last seen rank per game, so the next game can show the delta.
    /// Deliberately local-only: this is a personal "am I climbing?" cue, not a
    /// leaderboard fact, and it must survive being signed out.
    /// </summary>
    private static string RankKey(string gameKey) => $"pomini_lastrank_{gameKey}";

    /// <summary>
    /// Outcome cue names, in the order to try them. Games name winning
    /// differently — "win" in TicTacToe/ConnectFive, "ko" in Brawl, "finish" in
    /// Marble Race, "goal" in Sports, "fanfare" in Joker — so the modal asks for
    /// the family and takes whichever this game defines. The final entry in each
    /// list is the shared "ui" fallback, which every scope resolves.
    /// </summary>
    private static readonly string[] WinCues = ["win", "ko", "finish", "goal", "fanfare", "correct", "confirm"];
    private static readonly string[] LossCues = ["death", "bust", "crash", "wrong", "timeout", "error"];
    private static readonly string[] DrawCues = ["draw", "whistle", "reveal", "confirm"];

    /// <summary>
    /// Sound the end of the match once, on first render.
    /// </summary>
    /// <remarks>
    /// This runs in <c>OnAfterRenderAsync</c> rather than <c>OnInitializedAsync</c>
    /// deliberately: the leaderboard fetch below awaits the network, and a cue
    /// queued behind it would land seconds after the modal appeared — or never,
    /// offline. The result is on screen the moment this fires.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _outcomeCued) return;
        _outcomeCued = true;

        // GameKey is null in unranked modes (local 2-player, demo). "ui" is the
        // shared scope and defines every fallback name above, so the modal still
        // sounds — it just does not carry the game's timbre.
        var scope = string.IsNullOrEmpty(GameKey) ? "ui" : GameKey;

        var cues = Outcome switch
        {
            Models.GameOutcome.Win => WinCues,
            Models.GameOutcome.Loss => LossCues,
            Models.GameOutcome.Draw => DrawCues,
            _ => null,
        };

        if (cues is null)
        {
            await Feedback.CueAsync("ui", "confirm");
            return;
        }

        await Feedback.CueFirstAsync(scope, cues);
    }

    private bool _outcomeCued;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(GameKey)) return;

        // One read serves both the top 3 and the rank lookup.
        var board = await Api.GetGameLeaderboardAsync(GameKey, limit: RankSearchDepth);
        if (board is null) return;

        // Drop the server's "XXX" padding rows — an end-of-game modal should show
        // the real top 3 or nothing, not filler. Padding rows must also not count
        // toward the "of N" denominator, or a near-empty board claims 10 players.
        var ranked = board.Entries.Where(e => e.Name != PlaceholderName).ToList();
        _boardSize = ranked.Count;

        ResolveMyRank(ranked);

        // The board the modal renders is only ever the top 3.
        board.Entries = ranked.Take(3).ToList();
        _board = board;

        // Celebrate a climb with the existing personal-best cue. Fired here
        // rather than on save so it lands with the rank appearing on screen.
        if (_delta > 0) await Feedback.PersonalBestAsync();
    }

    /// <summary>
    /// Find the player's row, then diff against their last recorded rank.
    /// </summary>
    /// <remarks>
    /// Name matching is all that is available here: <c>LeaderboardEntryDto</c>
    /// carries no user id (unlike the raw per-game boards the profile page
    /// reads). That means a player sharing a display name with someone else on
    /// the same board can be shown the wrong row — accepted, because the
    /// alternative is no rank line at all, and the unified DTO would have to
    /// grow a field to do better.
    /// </remarks>
    private void ResolveMyRank(List<Models.LeaderboardEntryDto> ranked)
    {
        if (string.IsNullOrWhiteSpace(Player)) return;

        var mine = ranked.FirstOrDefault(e => e.Name.Equals(Player, StringComparison.OrdinalIgnoreCase));
        if (mine is null) return;

        _myRank = mine.Rank;

        try
        {
            var key = RankKey(GameKey!);
            var previous = Services.LocalStorageService.GetItem<string>(key);
            // A smaller rank number is a better position, so the gain is
            // previous - current.
            if (int.TryParse(previous, out var prev) && prev > mine.Rank)
            {
                _delta = prev - mine.Rank;
            }
            Services.LocalStorageService.SetItem(key, mine.Rank.ToString());
        }
        catch
        {
            // Storage unavailable (private mode) — the rank still shows, just
            // without a delta.
        }
    }

    private bool IsMe(Models.LeaderboardEntryDto e) =>
        !string.IsNullOrEmpty(Player) && string.Equals(e.Name, Player, StringComparison.OrdinalIgnoreCase);

    private async Task Ok()
    {
        if (OnOk.HasDelegate) await OnOk.InvokeAsync();
        Navigation.NavigateTo(BackTo);
    }

    /// <summary>
    /// Browser audit #10 (2026-08-10): a single "Back" action used by both
    /// modal CTAs (Back to all games / Back to X). Fires <see cref="OnOk"/>
    /// first so a game holding end-of-match state outside the page still
    /// gets a clean teardown before the navigation. Renamed from <c>Ok</c>
    /// because the button label is no longer "OK" — calling a method <c>Ok</c>
    /// that navigates was a relic of the old label.
    /// </summary>
    private Task Back() => Ok();

    private async Task HandleKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            if (PlayAgain.HasDelegate)
            {
                await PlayAgain.InvokeAsync();
            }
            else
            {
                await Back();
            }
        }
        else if (e.Key is "Escape")
        {
            await Back();
        }
    }
}
