@namespace PoMiniGamesClient.Components
@* §6 Wrap the whole shell in a SwipeBack so every game gets a leftward
   swipe-back gesture without each game page having to wire it. *@

@* §11 Consolidated header: the game's status + settings are projected into the
   app top bar (see MainLayout's SectionOutlet), removing the separate second
   row. The back-arrow and title are intentionally dropped — the top bar's brand
   already covers navigation back to the home page; the swipe-back gesture below
   still works. *@
<SectionContent SectionName="game-header">
    <div class="gps-header-slot">
        @* Game title — always rendered as the first child of the chrome slot so
           every game page identifies itself in the top bar. Plain text; the
           page's `Title` fragment may compose an icon + name. *@
        @if (Title != null)
        {
            <span class="gps-game-title">@Title</span>
        }

        @if (!string.IsNullOrEmpty(Player))
        {
            <span class="gps-player">@Player</span>
        }

        @if (Status != null)
        {
            <span class="gps-header-status">@Status</span>
        }

        @* Settings gear removed per 2026-07-06 header cleanup. The `ShowSettings`
           parameter was retained briefly while pages migrated; it's gone now.
           Stats still surface in the end-of-game modal; the Controls fragment
           was unused by every page and is removed entirely. *@
    </div>
</SectionContent>

<SwipeBack BackTo="@BackTo" Class="gps-shell-wrap">
<div class="gps-shell">
    <div class="gps-game-area @(Fullscreen ? "gps-game-area--fullscreen" : "")">
        @ChildContent
    </div>

    @* End-of-game modal: a centered, blocking dialog shown for every game the
       moment GameOver flips true. It surfaces the final score/result
       (GameSummary), the persistent stats grid (Stats), and the two exit
       actions. There is intentionally no backdrop-dismiss — the player leaves
       via Play Again or Home. *@
    @if (GameOver)
    {
        <div class="gps-modal-overlay" role="presentation">
            <div class="gps-modal" role="dialog" aria-modal="true" aria-label="Game over">
                <div class="gps-modal-title">@Title</div>
                @if (GameSummary != null)
                {
                    <div class="gps-game-summary">@GameSummary</div>
                }
                @if (Stats != null && Stats.Any())
                {
                    <div class="gps-modal-stats">
                        @foreach (var stat in Stats)
                        {
                            <div class="gps-stat">
                                <span class="gps-stat-value">@stat.Value</span>
                                <span class="gps-stat-label">@stat.Label</span>
                            </div>
                        }
                    </div>
                }
                <div class="gps-play-again-actions">
                    @if (ShowNextMatch && OnNextMatch.HasDelegate)
                    {
                        <button class="gps-play-again-btn gps-play-again-btn--primary" @onclick="OnNextMatch">
                            @NextMatchLabel
                        </button>
                    }
                    @if (ShowPlayAgain && OnPlayAgain.HasDelegate)
                    {
                        <button class="gps-play-again-btn @(ShowNextMatch ? "gps-play-again-btn--secondary" : "gps-play-again-btn--primary")" @onclick="OnPlayAgain">
                            @PlayAgainLabel
                        </button>
                    }
                    <button class="gps-play-again-btn gps-play-again-btn--secondary" @onclick="NavigateBack">
                        🏠 Home
                    </button>
                </div>
            </div>
        </div>
    }
</div>
</SwipeBack>

@code {
    [Parameter] public RenderFragment? Title { get; set; }
    [Parameter] public string? Player { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public List<Models.StatItem>? Stats { get; set; }
    [Parameter] public bool Fullscreen { get; set; }
    // Where the Home button on the end-of-game modal navigates. Default is the
    // home page ("/") — pages only need to override when they sit under a
    // sub-lobby (e.g. PoCoupleQuiz lobby → "/couplequiz"). This makes every
    // game page identical on this dimension by default.
    [Parameter] public string BackTo { get; set; } = "/";
    [Parameter] public bool GameOver { get; set; }
    [Parameter] public EventCallback OnPlayAgain { get; set; }
    [Parameter] public string PlayAgainLabel { get; set; } = "🔄 Play Again";
    // Optional secondary "next round" button. Shown alongside Play Again in
    // modal dialogs so ladder games (PoBrawl 1P) can advance straight to the
    // next opponent. Hidden by default — pages opt in by binding a handler.
    [Parameter] public bool ShowNextMatch { get; set; }
    [Parameter] public EventCallback OnNextMatch { get; set; }
    [Parameter] public string NextMatchLabel { get; set; } = "➡️ NEXT MATCH";
    [Parameter] public bool ShowPlayAgain { get; set; } = true;
    [Parameter] public RenderFragment? GameSummary { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;

    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private void NavigateBack() => Navigation.NavigateTo(BackTo);
}
