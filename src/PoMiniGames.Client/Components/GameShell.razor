@namespace PoMiniGamesClient.Components
@* §6 Wrap the whole shell in a SwipeBack so every game gets a leftward
   swipe-back gesture without each game page having to wire it. *@

@* §11 Consolidated header: the game's status + settings are projected into the
   app top bar (see MainLayout's SectionOutlet), removing the separate second
   row. The back-arrow and title are intentionally dropped — the top bar's brand
   already covers navigation back to the home page; the swipe-back gesture below
   still works. *@
<SectionContent SectionName="game-header">
    <div class="gps-header-slot">
        @* Game title — always rendered as the first child of the chrome slot so
           every game page identifies itself in the top bar. Plain text; the
           page's `Title` fragment may compose an icon + name. *@
        @if (Title != null)
        {
            <span class="gps-game-title">@Title</span>
        }

        @* 2026-07-13 top-bar cleanup (user request): the in-game Player name, the
           live Status pill, and the "?" how-to trigger were removed from the header
           to save horizontal space. The signed-in identity now lives once on the
           right (next to Sign out), the game result surfaces in the end-of-game
           modal, and the how-to popover is no longer exposed from the top bar.
           The Player / Status / HowToPlay parameters remain accepted (pages still
           pass them) but are intentionally not projected here. *@
    </div>
</SectionContent>

<SwipeBack BackTo="@BackTo" Class="gps-shell-wrap">
<div class="gps-shell" @onclick="OnShellClick">
    <div class="gps-game-area @(Fullscreen ? "gps-game-area--fullscreen" : "")">
        @ChildContent
    </div>

    @* End-of-game modal: the one centered, blocking dialog every game ends on.
       It surfaces the final result (GameSummary), the stats grid (Stats), this
       game's top 3 (fetched from GameKey), and a single OK that returns to the
       home menu. There is intentionally no backdrop-dismiss and no Play Again —
       OK is the only exit, so the flow is identical in every game. *@
    @* How-to-play popover: a small inline card toggled by the header "?". Replaces
       the 2026-07-12 full-screen modal — no overlay, no auto-show, no localStorage.
       The popover sits at the top of the game area and is dismissed by clicking
       the "?" again, the Got it button, or anywhere outside the card. *@
    @if (HowToPlayOpen && HowToPlay != null)
    {
        <aside id="gps-howto-popover" class="gps-howto-popover" role="region" aria-label="How to play" @onclick:stopPropagation="true">
            <div class="gps-howto-popover-head">
                <span class="gps-howto-popover-title">@Title</span>
                <button class="gps-howto-close" @onclick="DismissHowTo" aria-label="Close how to play" title="Close">×</button>
            </div>
            <div class="gps-howto-popover-body">@HowToPlay</div>
            <div class="gps-howto-popover-actions">
                <button class="gps-btn gps-btn--secondary" @onclick="DismissHowTo">Got it</button>
            </div>
        </aside>
    }

    @if (GameOver)
    {
        <GameOverModal Title="@Title"
                       GameSummary="@GameSummary"
                       Stats="@Stats"
                       GameKey="@GameKey"
                       Player="@Player"
                       BackTo="@BackTo" />
    }
</div>
</SwipeBack>

@code {
    [Parameter] public RenderFragment? Title { get; set; }
    [Parameter] public string? Player { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public List<Models.StatItem>? Stats { get; set; }
    [Parameter] public bool Fullscreen { get; set; }
    // Where the Home button on the end-of-game modal navigates. Default is the
    // home page ("/") — pages only need to override when they sit under a
    // sub-lobby (e.g. PoCoupleQuiz lobby → "/couplequiz"). This makes every
    // game page identical on this dimension by default.
    [Parameter] public string BackTo { get; set; } = "/";
    [Parameter] public bool GameOver { get; set; }
    // Catalog key for this game's unified leaderboard (e.g. "connectfive").
    // When set, the end-of-game modal fetches and renders that game's top 3.
    // Leave null for modes with no meaningful board (local 2-player, demo).
    [Parameter] public string? GameKey { get; set; }
    [Parameter] public RenderFragment? GameSummary { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;
    // Optional "how to play" content. Surfaces as a compact popover toggled by the
    // header "?" button — no full-screen modal, no auto-show, no persisted
    // dismissal. Pass null (demo pages) to hide the trigger entirely.
    [Parameter] public RenderFragment? HowToPlay { get; set; }
    // Optional initial open state. False by default so first-time visitors land on
    // the playable game without an interstitial. Hosts that want the popover open
    // by default (e.g. kiosk layout previews) can opt in here.
    [Parameter] public bool HowToPlayOpen { get; set; }

    // The top-3 fetch and the OK action live in GameOverModal — this shell just
    // decides when to show it and passes the game's data through.

    private void ToggleHowTo() => HowToPlayOpen = !HowToPlayOpen;

    private void DismissHowTo() => HowToPlayOpen = false;

    // The popover itself stops propagation, so any click that reaches the shell
    // container is "outside the popover" — close it. Host pages that listen on
    // <ChildContent> elements keep their own click handlers (the outer click
    // bubbles here only after them, but the dismissal is idempotent).
    private void OnShellClick()
    {
        if (HowToPlayOpen) HowToPlayOpen = false;
    }

}
