@*
    Floating kiosk control bar.
    Appears whenever a demo is in auto-rotation. Auto-hides after 3s of
    mouse inactivity; reappears on mouse-move or touch.
    2026 standard: kiosk users must have agency even in auto-mode.
*@
@implements IDisposable
@inject KioskCoordinator Kiosk
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (Kiosk.IsActive)
{
    <div class="kiosk-bar @(Visible ? "" : "kiosk-bar--hidden")"
         @onmousemove="Show"
         @ontouchstart="Show"
         role="region"
         aria-label="Demo kiosk controls">
        <div class="kiosk-bar__countdown" aria-live="polite">
            <span class="kiosk-bar__icon">@(string.IsNullOrEmpty(CurrentIcon) ? "▶" : CurrentIcon)</span>
            <span class="kiosk-bar__name">@(Kiosk.CurrentGameName ?? "Auto-cycling demos")</span>
            <span class="kiosk-bar__timer" aria-label="Seconds until next demo">
                @(Kiosk.SecondsUntilAdvance)s
            </span>
        </div>
        <div class="kiosk-bar__actions">
            <button class="kiosk-btn" @onclick="TogglePause" aria-label="@(Kiosk.IsPaused ? "Resume demos" : "Pause demos")" title="@(Kiosk.IsPaused ? "Resume" : "Pause")">
                @(Kiosk.IsPaused ? "▶" : "⏸")
            </button>
            <button class="kiosk-btn" @onclick="Kiosk.SkipNext" aria-label="Skip to next demo" title="Next">
                ⏭
            </button>
            <button class="kiosk-btn kiosk-btn--exit" @onclick="ExitKiosk" aria-label="Exit demo kiosk (ESC)" title="Exit (ESC)">
                ✕
            </button>
        </div>
        <kbd class="kiosk-bar__esc" aria-hidden="true">ESC</kbd>
    </div>
}

@code {
    private bool Visible = true;
    private System.Threading.Timer? _hideTimer;
    private string CurrentIcon = "";

    protected override void OnInitialized()
    {
        Kiosk.Changed += OnKioskChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Wire ESC key → exit kiosk. (app.js dispatches
            // 'pominigames:exit-kiosk' on the document; we forward to
            // the .NET method via DotNetObjectReference.)
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("kioskRegisterEscHandler", _dotNetRef);
        }
    }

    private void OnKioskChanged()
    {
        var entry = Kiosk.Entries.FirstOrDefault(e => e.DisplayName == Kiosk.CurrentGameName);
        CurrentIcon = entry?.Icon ?? "";
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void ExitKioskFromJs()
    {
        if (Kiosk.IsActive) ExitKiosk();
    }

    private DotNetObjectReference<KioskControlBar>? _dotNetRef;

    private void Show()
    {
        Visible = true;
        _hideTimer?.Dispose();
        _hideTimer = new System.Threading.Timer(_ =>
        {
            Visible = false;
            InvokeAsync(StateHasChanged);
        }, null, 3000, Timeout.Infinite);
    }

    private void TogglePause() => Kiosk.TogglePause();

    private void ExitKiosk()
    {
        Kiosk.Stop();
        Nav.NavigateTo("/", forceLoad: false);
    }

    public void Dispose()
    {
        Kiosk.Changed -= OnKioskChanged;
        _hideTimer?.Dispose();
    }
}
