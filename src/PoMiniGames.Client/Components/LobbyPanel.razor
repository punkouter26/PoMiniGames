@namespace PoMiniGamesClient.Components
@using Microsoft.AspNetCore.SignalR.Client
@using PoMiniGames.Shared.Games
@typeparam TPlayer where TPlayer : ILobbyPlayer

@* The one ready/start lobby card. Racer, Sports, Voxel Strike and Brawl each hand-rolled
   this (status pill, "Players · N/M" roster with host/guest/ready pills, Ready / Start /
   Leave) under three different class vocabularies; the Brawl copy borrowed Racer's
   scoped class names and so rendered unstyled. A game supplies its start label, its
   gate, and optionally a picker section and per-player badges — nothing else. *@
<div class="sp-page">
    <div class="sp-card lobby">
        <p class="sp-subtitle lobby__status">
            Status:
            @if (ConnectionState == HubConnectionState.Connected)
            {
                <span class="lobby-pill lobby-pill--ok">connected</span>
            }
            else if (ConnectionState == HubConnectionState.Disconnected && State is null)
            {
                <span class="lobby-pill lobby-pill--muted">connecting…</span>
            }
            else
            {
                <span class="lobby-pill lobby-pill--warn">@ConnectionState.ToString().ToLowerInvariant()</span>
            }
        </p>

        <p class="lobby__hint">@Hint</p>

        <section class="lobby__section">
            <h2 class="gps-phase-h">Players · @(State?.Players.Count ?? 0)/@(State?.MaxPlayers ?? MaxPlayersHint)</h2>
            @if (State is null)
            {
                <div class="app-loading"><span class="app-loading__spinner" aria-hidden="true"></span><span>Loading players…</span></div>
            }
            else if (State.Players.Count == 0)
            {
                <p class="lobby__empty">No one's here yet. Be the first.</p>
            }
            else
            {
                <ol class="lobby__list">
                    @foreach (var p in State.Players)
                    {
                        var isYou = p.ConnectionId == LocalConnectionId;
                        var isHost = p.ConnectionId == State.HostConnectionId;
                        <li class="lobby__player @(isYou ? "is-you" : "") @(isHost ? "is-host" : "")">
                            <span class="lobby__name">
                                @if (PlayerLabel is not null)
                                {
                                    @PlayerLabel(p)
                                }
                                else
                                {
                                    @p.DisplayName
                                }
                                @if (isYou)
                                {
                                    <span class="lobby__you">(you)</span>
                                }
                            </span>
                            @if (isHost)
                            {
                                <span class="lobby-pill lobby-pill--accent">host</span>
                            }
                            @if (p.IsGuest)
                            {
                                <span class="lobby-pill lobby-pill--muted">guest</span>
                            }
                            @if (PlayerBadges is not null)
                            {
                                @PlayerBadges(p)
                            }
                            @if (p.IsReady)
                            {
                                <span class="lobby-pill lobby-pill--ok">ready</span>
                            }
                        </li>
                    }
                </ol>
            }
        </section>

        @if (Picker is not null)
        {
            <section class="lobby__section">
                @if (!string.IsNullOrEmpty(PickerTitle))
                {
                    <h2 class="gps-phase-h">@PickerTitle</h2>
                }
                @Picker
            </section>
        }

        <section class="lobby__actions">
            @if (State is null)
            {
                <p class="lobby__hint">Connecting to the lobby hub…</p>
            }
            else
            {
                @if (IsHost && !EffectiveCanStart)
                {
                    <p class="lobby__hint">@WaitingHint</p>
                }
                @if (!IsHost || HostReadies)
                {
                    <button type="button" class="sp-btn-primary" disabled="@(!CanReady)" @onclick="OnReady">
                        @(MyReady ? "Not Ready" : "Ready!")
                    </button>
                }
                @if (IsHost)
                {
                    <button type="button" class="sp-btn-primary" disabled="@(!EffectiveCanStart)" @onclick="OnStart">@StartLabel</button>
                }
                <button type="button" class="sp-btn-secondary" @onclick="OnLeave">Leave</button>
            }
        </section>

        @if (State is not null)
        {
            <p class="lobby__updated">Last update: @State.LastUpdatedUtc.LocalDateTime.ToString("HH:mm:ss")</p>
        }
    </div>
</div>

@code {
    [Parameter] public LobbyState<TPlayer>? State { get; set; }
    [Parameter] public string LocalConnectionId { get; set; } = "";
    [Parameter] public HubConnectionState ConnectionState { get; set; }

    /// <summary>Copy under the status line. Every lobby is the single shared room, so the default says so.</summary>
    [Parameter] public string Hint { get; set; } = "Single shared room — first to arrive becomes host.";
    /// <summary>Shown as the roster cap until the first state arrives.</summary>
    [Parameter] public int MaxPlayersHint { get; set; } = 2;

    [Parameter, EditorRequired] public string StartLabel { get; set; } = "Start";
    /// <summary>
    /// The host's start gate. Null uses the shared rule (someone is here and every non-host
    /// seat is ready); a game with more to check (a character picked) passes its own.
    /// </summary>
    [Parameter] public bool? CanStart { get; set; }
    [Parameter] public string WaitingHint { get; set; } = "Waiting for everyone to mark Ready…";
    /// <summary>False disables the Ready button (e.g. until the player has picked).</summary>
    [Parameter] public bool CanReady { get; set; } = true;
    /// <summary>True when the host must also ready up (Brawl's 1v1); by default the host only starts.</summary>
    [Parameter] public bool HostReadies { get; set; }

    /// <summary>Replaces the plain display name in the roster (e.g. an emoji + name).</summary>
    [Parameter] public RenderFragment<TPlayer>? PlayerLabel { get; set; }
    /// <summary>Extra pills after host/guest — use <c>lobby-pill lobby-pill--*</c> classes.</summary>
    [Parameter] public RenderFragment<TPlayer>? PlayerBadges { get; set; }
    /// <summary>A picker section between the roster and the buttons — use <c>lobby-pick-grid</c> / <c>lobby-pick-card</c>.</summary>
    [Parameter] public RenderFragment? Picker { get; set; }
    [Parameter] public string? PickerTitle { get; set; }

    [Parameter] public EventCallback OnReady { get; set; }
    [Parameter] public EventCallback OnStart { get; set; }
    [Parameter] public EventCallback OnLeave { get; set; }

    private bool IsHost =>
        State is not null && !string.IsNullOrEmpty(LocalConnectionId) && State.HostConnectionId == LocalConnectionId;

    private bool MyReady =>
        State?.Players.FirstOrDefault(p => p.ConnectionId == LocalConnectionId)?.IsReady ?? false;

    private bool EffectiveCanStart => CanStart ?? (
        State is not null
        && State.Players.Count > 0
        && State.Players.All(p => p.ConnectionId == State.HostConnectionId || p.IsReady));
}
