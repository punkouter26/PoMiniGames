@namespace PoMiniGamesClient.Components
@inject UiFeedbackService Feedback

@* The two quiz rows of the settings sheet, kept in their own component so the sheet itself only
   hosts them. Free is the default for both; the paid choice is a request the server grants only
   to signed-in players (see QuizPreferences). *@

<div class="prefs-row">
    <div class="prefs-label">
        <span class="prefs-name">Quiz questions</span>
        <span class="prefs-hint">Classic is free. Fresh AI writes new ones for signed-in players.</span>
    </div>
    <div class="app-seg" role="radiogroup" aria-label="Quiz questions">
        <button type="button" role="radio" class="app-seg__btn"
                aria-checked="@Aria(!_freshAi)" @onclick="() => SetSource(false)">Classic</button>
        <button type="button" role="radio" class="app-seg__btn"
                aria-checked="@Aria(_freshAi)" @onclick="() => SetSource(true)">Fresh AI</button>
    </div>
</div>

<div class="prefs-row">
    <div class="prefs-label">
        <span class="prefs-name">Answer matching</span>
        <span class="prefs-hint">Smart is free. AI judge settles close calls in Couple Quiz.</span>
    </div>
    <div class="app-seg" role="radiogroup" aria-label="Answer matching">
        <button type="button" role="radio" class="app-seg__btn"
                aria-checked="@Aria(!_aiJudge)" @onclick="() => SetMatching(false)">Smart</button>
        <button type="button" role="radio" class="app-seg__btn"
                aria-checked="@Aria(_aiJudge)" @onclick="() => SetMatching(true)">AI judge</button>
    </div>
</div>

@code {
    private bool _freshAi;
    private bool _aiJudge;

    private static string Aria(bool value) => value ? "true" : "false";

    protected override void OnInitialized()
    {
        _freshAi = QuizPreferences.FreshAi;
        _aiJudge = QuizPreferences.AiJudge;
    }

    private async Task SetSource(bool fresh)
    {
        if (_freshAi == fresh) return;
        _freshAi = fresh;
        QuizPreferences.FreshAi = fresh;
        await Feedback.ClickAsync();
    }

    private async Task SetMatching(bool aiJudge)
    {
        if (_aiJudge == aiJudge) return;
        _aiJudge = aiJudge;
        QuizPreferences.AiJudge = aiJudge;
        await Feedback.ClickAsync();
    }
}
