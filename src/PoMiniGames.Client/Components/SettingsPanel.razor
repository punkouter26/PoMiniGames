@namespace PoMiniGamesClient.Components
@using PoMiniGamesClient.Services
@inject SettingsService Settings
@inject UiFeedbackService Feedback
@implements IDisposable

@* ─────────────────────────────────────────────────────────────────────────
   Preferences: colour scheme, audio, haptics, motion, FPS badge.

   Hosted by Pages/SettingsPage.razor (/settings), reached from the home action
   row. The ⚙️ gear was removed from the top bar on 2026-07-13 by explicit
   request and stays removed — a destination page gives preferences an
   addressable URL without putting chrome back.

   The panel renders no heading of its own: it used to carry an
   `<h2 class="prf-section-title">`, but that class is scoped to
   ProfilePage.razor.css, so the rule's generated `[b-syldjlwxog]` attribute
   was never stamped on this component's markup and the heading rendered
   unstyled wherever it was mounted. The host page owns the title instead.
   ───────────────────────────────────────────────────────────────────────── *@

<section class="prefs" aria-label="Preferences">
    <div class="prefs-grid">

        <!-- ── Appearance ── -->
        <div class="prefs-row">
            <div class="prefs-label">
                <span class="prefs-name">Theme</span>
                <span class="prefs-hint">Auto follows your device setting.</span>
            </div>
            <div class="prefs-seg" role="radiogroup" aria-label="Theme">
                @foreach (var mode in ThemeModes)
                {
                    <button type="button"
                            role="radio"
                            class="prefs-seg-btn @(Settings.Theme == mode ? "prefs-seg-btn--on" : null)"
                            aria-checked="@Aria(Settings.Theme == mode)"
                            @onclick="() => SetTheme(mode)">
                        @ThemeLabel(mode)
                    </button>
                }
            </div>
        </div>

        <!-- ── Audio ── -->
        <div class="prefs-row">
            <div class="prefs-label">
                <span class="prefs-name">Sound</span>
                <span class="prefs-hint">Mutes music, effects and UI cues.</span>
            </div>
            <button type="button"
                    class="prefs-toggle @(Settings.Muted ? null : "prefs-toggle--on")"
                    role="switch"
                    aria-checked="@Aria(!Settings.Muted)"
                    aria-label="Sound"
                    @onclick="ToggleMuted">
                <span class="prefs-toggle-knob"></span>
            </button>
        </div>

        <div class="prefs-row @(Settings.Muted ? "prefs-row--disabled" : null)">
            <div class="prefs-label">
                <span class="prefs-name">Volume</span>
                <span class="prefs-hint">@Settings.Volume%</span>
            </div>
            @* Bound on oninput so the level tracks the drag. audioBus ramps the
               gain node, so a per-pixel update neither clicks nor thrashes. *@
            <input type="range" class="prefs-range"
                   min="0" max="100" step="5"
                   aria-label="Volume"
                   disabled="@Settings.Muted"
                   value="@Settings.Volume"
                   @oninput="OnVolumeInput" />
        </div>

        <div class="prefs-row">
            <div class="prefs-label">
                <span class="prefs-name">Haptics</span>
                <span class="prefs-hint">Vibration cues on supported devices.</span>
            </div>
            <button type="button"
                    class="prefs-toggle @(Settings.Haptics ? "prefs-toggle--on" : null)"
                    role="switch"
                    aria-checked="@Aria(Settings.Haptics)"
                    aria-label="Haptics"
                    @onclick="ToggleHaptics">
                <span class="prefs-toggle-knob"></span>
            </button>
        </div>

        <div class="prefs-row">
            <div class="prefs-label">
                <span class="prefs-name">Game intros</span>
                <span class="prefs-hint">Show the controls card before each 1-player game.</span>
            </div>
            <button type="button"
                    class="prefs-toggle @(Settings.ShowGameIntros ? "prefs-toggle--on" : null)"
                    role="switch"
                    aria-checked="@Aria(Settings.ShowGameIntros)"
                    aria-label="Game intros"
                    @onclick="ToggleGameIntros">
                <span class="prefs-toggle-knob"></span>
            </button>
        </div>

        <!-- ── Motion & chrome ── -->
        <div class="prefs-row">
            <div class="prefs-label">
                <span class="prefs-name">Reduce motion</span>
                <span class="prefs-hint">
                    @if (_osReducedMotion)
                    {
                        @:Your device already asks for reduced motion.
                    }
                    else
                    {
                        @:Trims animations and transitions.
                    }
                </span>
            </div>
            <button type="button"
                    class="prefs-toggle @(Settings.ReducedMotion ? "prefs-toggle--on" : null)"
                    role="switch"
                    aria-checked="@Aria(Settings.ReducedMotion)"
                    aria-label="Reduce motion"
                    @onclick="ToggleReducedMotion">
                <span class="prefs-toggle-knob"></span>
            </button>
        </div>

        <div class="prefs-row">
            <div class="prefs-label">
                <span class="prefs-name">FPS badge</span>
                <span class="prefs-hint">Frame-rate readout in the top bar.</span>
            </div>
            <div class="prefs-control-cluster">
                @* 2026-08-08 audit #16: render a static preview of the FPS chip so a
                   player who toggles the badge on knows what they're enabling. The
                   live chip itself lives in the top bar and is also drawn from
                   .gl-fps--centered, so the preview mirrors the real one visually.
                   The text is mocked ("60 FPS") rather than a live reading — a
                   setting page is not a render benchmark. *@
                <span class="gl-fps gl-fps--centered gl-fps--preview" aria-hidden="true"
                      data-tier="@(Settings.ShowFps ? "ok" : "off")">
                    @(_fpsPreviewLabel)
                </span>
                <button type="button"
                        class="prefs-toggle @(Settings.ShowFps ? "prefs-toggle--on" : null)"
                        role="switch"
                        aria-checked="@Aria(Settings.ShowFps)"
                        aria-label="FPS badge"
                        @onclick="ToggleFps">
                    <span class="prefs-toggle-knob"></span>
                </button>
            </div>
        </div>

    </div>
</section>

@code {
    /// <summary>
    /// Renders a bool as the literal string ARIA requires.
    /// <para>
    /// Binding a <c>bool</c> straight into <c>aria-checked</c> does NOT work:
    /// Blazor treats a bool-valued attribute as an HTML *boolean* attribute, so
    /// `true` emits <c>aria-checked=""</c> and `false` omits it entirely. ARIA
    /// state attributes are enumerated strings, not boolean attributes — an empty
    /// value is invalid and assistive tech reports the control as having no state.
    /// Caught by axe as 16 `aria-required-attr` violations on this panel alone
    /// (2026-08-08 audit #4); every role="switch"/"radio" below routes through
    /// here. Never inline a bare bool into an aria-* attribute.
    /// </para>
    /// </summary>
    private static string Aria(bool value) => value ? "true" : "false";

    private static readonly ThemeMode[] ThemeModes = [ThemeMode.Auto, ThemeMode.Light, ThemeMode.Dark];

    private bool _osReducedMotion;

    // 2026-08-08 audit #16: a faux "60 FPS" or "— FPS" label so the preview chip
    // shows what the player is enabling / disabling. The real chip lives in the
    // top bar and reads a live RAF value; the settings page is a configuration
    // surface, not a benchmark, so a stable label is the more honest preview.
    private string _fpsPreviewLabel => Settings.ShowFps ? "60 FPS" : "— FPS";

    private static string ThemeLabel(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => "Light",
        ThemeMode.Dark => "Dark",
        _ => "Auto",
    };

    protected override void OnInitialized() => Settings.Changed += OnSettingsChanged;

    protected override async Task OnInitializedAsync()
        => _osReducedMotion = await Settings.OsPrefersReducedMotionAsync();

    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Settings.Changed -= OnSettingsChanged;

    private async Task SetTheme(ThemeMode mode)
    {
        if (Settings.Theme == mode) return;
        await Settings.SetThemeAsync(mode);
        await Feedback.ClickAsync();
    }

    // Audio feedback fires only when turning sound ON — playing a confirmation
    // tone as the user mutes would be the one cue they just asked not to hear.
    // (audioBus ramps over ~20 ms, so the cue would still be audible.)
    private async Task ToggleMuted()
    {
        var nowMuted = !Settings.Muted;
        await Settings.SetMutedAsync(nowMuted);
        if (!nowMuted) await Feedback.ClickAsync();
    }

    private async Task OnVolumeInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pct))
        {
            await Settings.SetVolumeAsync(pct);
        }
    }

    // Fire the haptic *after* enabling so the user feels the setting they just
    // turned on; skip it when disabling, for the same reason as mute above.
    private async Task ToggleHaptics()
    {
        var enabled = !Settings.Haptics;
        Settings.SetHaptics(enabled);
        if (enabled) await Feedback.TapAsync();
    }

    private async Task ToggleReducedMotion()
    {
        await Settings.SetReducedMotionAsync(!Settings.ReducedMotion);
        await Feedback.ClickAsync();
    }

    private async Task ToggleFps()
    {
        Settings.SetShowFps(!Settings.ShowFps);
        await Feedback.ClickAsync();
    }

    // The only way back once a player has ticked "Don't show this again" on a
    // game's controls card (browser audit #4).
    private async Task ToggleGameIntros()
    {
        Settings.SetShowGameIntros(!Settings.ShowGameIntros);
        await Feedback.ClickAsync();
    }
}
