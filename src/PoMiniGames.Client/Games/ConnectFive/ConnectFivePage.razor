@page "/connectfive"
@page "/connectfive/{Demo:int}"
@implements IDisposable;
@using PoMiniGamesClient.Components;
@using PoMiniGamesClient.Enums;
@using PoMiniGamesClient.Models;
@using PoMiniGamesClient.Games.ConnectFive;
@using PoMiniGamesClient.Services;
@inject NavigationManager Navigation;
@inject PlayerNameService PlayerNameService;
@inject MatchHistoryService MatchHistory;
@inject KioskCoordinator Kiosk;
@inject UiFeedbackService Feedback;

<GameShell 
    Title=@TitleContent 
    Player="@_playerName"
    BackTo="@_backTo"
    GameOver="@_isGameOver"
    OnPlayAgain="ResetGame"
    ShowSettings="@(PlayMode == "2p")"
    Stats="@(PlayMode == "ai" ? _statItems : null)"
    Status="@StatusContent"
    GameSummary="@GameSummaryContent"
    Controls="@ControlsContent">
    
    <div class="cf-layout">
        @* §3 Hover-ghost: pointerleave on the board clears the column preview so
           the ghost disc never sticks when the cursor exits the grid. *@
        <div class="cf-board" role="grid" aria-label="Connect Five game board"
             @onpointerleave="ClearHover">
            @for (int r = 0; r < ConnectFiveBoard.Rows; r++)
            {
                @for (int c = 0; c < ConnectFiveBoard.Cols; c++)
                {
                    var row = r;
                    var col = c;
                    var piece = _board.Get(r, c);
                    var winIndex = _winCells.FindIndex(wc => wc.Row == r && wc.Col == c);
                    var isWinCell = winIndex >= 0;
                    // Audit #9: once the cascade has played, freeze the visual
                    // in its final state. Re-renders that happen after the
                    // 0.45s animation finishes (e.g. ghost clears after game
                    // over) used to replay the cascade because the same
                    // .win-cell class triggered the keyframe again.
                    var winCellClass = !isWinCell ? ""
                        : _winCascadePlayed ? "win-cell-static"
                        : "win-cell";
                    var ghostKey = GhostRenderKey(col, row, CanPreview);
                    var isGhost = piece == Piece.None && CanPreview && col == _hoverCol && row == _hoverTargetRow && ghostKey >= 0;

                    <div class="cf-cell @GetPieceClass(piece) @(winCellClass) @(_gameResult != GameResult.InProgress ? "disabled" : "")"
                         style="@(isWinCell ? $"--win-i: {winIndex};" : null)"
                         @onclick="() => HandleDrop(col)"
                         @onpointerenter="() => SetHover(col)"
                         role="gridcell"
                         aria-label="@GetPieceAriaLabel(piece)">
                        @* The disc IS the piece: a single glossy CSS disc drops in
                           from above the board. --drop-rows sets how far it falls:
                           from above the board down to its resting row (row index + 1
                           strides). No emoji + cell-fill double-circle. *@
                        @* Audit #2: --drop-rows is no longer per-cell. The .cf-layout
                           defines --cf-drop-rows: 9 (board depth), and every disc
                           drops the full distance from above the board. Each
                           disc therefore travels the same drop length regardless
                           of its landing row, eliminating the "short drop near
                           the top" inconsistency. *@
                        @if (piece == Piece.Red)
                        {
                            <span class="piece red-piece" aria-hidden="true"></span>
                        }
                        else if (piece == Piece.Yellow)
                        {
                            <span class="piece yellow-piece" aria-hidden="true"></span>
                        }
                        else if (isGhost)
                        {
                            @* Column-drop preview — colourless of drop animation; CSS
                               hides it entirely on coarse/touch pointers. *@
                            <span class="piece ghost-piece @GhostColorClass" aria-hidden="true"></span>
                        }
                    </div>
                }
            }
        </div>
    </div>
</GameShell>

@code {
    [Parameter] public int? Demo { get; set; }
    [SupplyParameterFromQuery(Name = "kiosk")] public int KioskNext { get; set; } = -1;
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }

    private ConnectFiveBoard _board = new();
    private ConnectFiveAI _ai = new();
    // 1-player Connect Five always plays the AI at Medium; no in-game difficulty picker.
    private readonly Difficulty _difficulty = Difficulty.Medium;
    private GameResult _gameResult = GameResult.InProgress;
    private bool _isAiTurn;
    // "ai" (vs CPU) or "2p" (local pass-and-play); "demo" is driven by the route param.
    private string _playMode = "ai";
    private string PlayMode => Demo == 1 ? "demo" : _playMode;
    // Audit #6: 2-player turn state is now a Player record instead of a raw
    // Piece. The only valid values are Player.Red / Player.Yellow; the empty
    // player can never appear here, so wrong-state bugs (e.g. styling a "ghost"
    // disc with no current player) fail at construction time, not at render.
    private Player _current2pPlayer = Player.Red; // whose turn in 2-player mode
    private string _player2Name = "Player 2";
    private bool _matchRecorded;
    private string _playerName = "";
    // Player 1's display name resolves asynchronously; fall back to "Player 1" until it does.
    private string P1Name => string.IsNullOrWhiteSpace(_playerName) ? "Player 1" : _playerName;
    private List<(int Row, int Col)> _winCells = new();
    // vs-AI W/L/D/ELO stats surfaced in the end-of-game modal (1-player only).
    private List<StatItem> _statItems = new();
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    private CancellationTokenSource? _demoCts;
    // BUG FIX (#1): _kioskTimer removed; KioskCoordinator owns the timer.

    // §3 Column-preview ghost. _hoverCol is the column under the pointer (-1 = none).
    // The landing row is derived from the live board (never stored), so it stays
    // correct after the AI or the other player fills a slot without a re-hover.
    private int _hoverCol = -1;
    // Audit #8: ghost-row memoization. We track the last *rendered* landing
    // row for the hovered column so any state change that mutates the board
    // (AI drop, opponent drop) forces a single re-render and prevents the
    // "ghost floating mid-air after the column grew shorter" flicker.
    private int _lastGhostRenderKey = -1; // negative = no ghost rendered yet
    private int _hoverTargetRow => _hoverCol >= 0 ? _board.GetTargetRow(_hoverCol) : -1;
    // The ghost only makes sense on a live human turn — not while the AI thinks,
    // not in demo, not after the game ends. CSS additionally hides it on touch.
    private bool CanPreview => _gameResult == GameResult.InProgress && !_isAiTurn && PlayMode != "demo";
    // The ghost wears the colour of whoever is about to move.
    private string GhostColorClass => PlayMode == "2p"
        ? (_current2pPlayer == Player.Red ? "red-piece" : "yellow-piece")
        : "red-piece";

    private void SetHover(int col)
    {
        if (!CanPreview || _hoverCol == col) return;
        _hoverCol = col;
        _lastGhostRenderKey = -1; // invalidate the memo so the new column renders a fresh ghost
        StateHasChanged();
    }

    private void ClearHover()
    {
        if (_hoverCol == -1) return;
        _hoverCol = -1;
        _lastGhostRenderKey = -1;
        StateHasChanged();
    }

    /// <summary>
    /// Audit #8: called from the cell-render loop. If the ghost's target row
    /// changed (because the AI or opponent dropped a piece while the pointer
    /// was still over the column) we memoize the new key so Blazor's diff
    /// emits a clean add/remove of the ghost span instead of leaving a stale
    /// one in the wrong cell. The re-render then paints the ghost in the new
    /// landing row on the same frame.
    /// </summary>
    private int GhostRenderKey(int col, int targetRow, bool canPreview)
    {
        if (!canPreview || targetRow < 0) return -1;
        var key = (col * 17) + targetRow;
        if (_lastGhostRenderKey != key)
        {
            _lastGhostRenderKey = key;
            return key;
        }
        return key;
    }

    private string _backTo => "/";
    private bool _isGameOver => _gameResult != GameResult.InProgress && PlayMode != "demo";

    private RenderFragment TitleContent => @<span>🔴 Connect Five</span>;

    private RenderFragment StatusContent => PlayMode == "demo" ? @<span class="cf-status cf-status--demo">🎮 Demo mode</span>
        : PlayMode == "2p"
            ? (_gameResult == GameResult.InProgress
                ? (_current2pPlayer == Player.Red
                    ? @<span class="cf-status cf-status--player">🔴 @P1Name's turn</span>
                    : @<span class="cf-status cf-status--ai">🟡 @_player2Name's turn</span>)
                : _gameResult == GameResult.Win
                    ? @<span class="cf-status cf-status--win">🎉 @P1Name wins!</span>
                    : _gameResult == GameResult.Loss
                        ? @<span class="cf-status cf-status--win">🎉 @_player2Name wins!</span>
                        : @<span class="cf-status cf-status--draw">🤝 Draw!</span>)
            : _gameResult == GameResult.InProgress
                ? (_isAiTurn
                    ? @<span class="cf-status cf-status--ai">🤖 AI thinking…</span>
                    : @<span class="cf-status cf-status--player">🔴 Your turn</span>)
                : _gameResult == GameResult.Win
                    ? @<span class="cf-status cf-status--win">🎉 You win!</span>
                    : _gameResult == GameResult.Loss
                        ? @<span class="cf-status cf-status--loss">🤖 AI wins</span>
                        : @<span class="cf-status cf-status--draw">🤝 Draw!</span>;

    private RenderFragment? GameSummaryContent => _isGameOver ? (PlayMode == "2p" ? _gameResult switch
    {
        GameResult.Win  => @<div class="cf-result cf-result--win">🔴 @P1Name won! Nice game.</div>,
        GameResult.Loss => @<div class="cf-result cf-result--win">🟡 @_player2Name won! Nice game.</div>,
        GameResult.Draw => @<div class="cf-result cf-result--draw">🤝 It’s a draw!</div>,
        _               => null
    } : _gameResult switch
    {
        GameResult.Win  => @<div class="cf-result cf-result--win">🎉 You won! Great game, @_playerName!</div>,
        GameResult.Loss => @<div class="cf-result cf-result--loss">🤖 AI wins this round — try again!</div>,
        GameResult.Draw => @<div class="cf-result cf-result--draw">🤝 It’s a draw!</div>,
        _               => null
    }) : null;

    // 1-player is fixed to Medium and needs no settings, so the drawer keeps only
    // New Game. 2-player still exposes the opponent's name; demo restarts the loop.
    private RenderFragment ControlsContent => @<div class="gps-controls">
        <button @onclick="ResetGame">
            🔄 @(PlayMode == "demo" ? "Restart Demo" : "New Game")
        </button>
        @if (PlayMode == "2p")
        {
            <input class="gps-name-input" value="@_player2Name" @onchange="OnPlayer2NameChange"
                   maxlength="24" placeholder="Player 2 name" aria-label="Player 2 name" />
        }
    </div>;

    protected override void OnInitialized()
    {
        _playerName = PlayerNameService.GetPlayerName();
        if (Demo != 1 && string.Equals(ModeQuery, "2p", StringComparison.OrdinalIgnoreCase))
            _playMode = "2p";
        ResetGame();
        if (Demo == 1) Kiosk.SetCurrent("connectfive-demo");
    }

    private void OnPlayer2NameChange(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        _player2Name = string.IsNullOrWhiteSpace(name) ? "Player 2" : name.Trim();
    }

    // Rebuild the W/L/D/ELO tiles from the (in-place mutated) cached stats so the
    // end-of-game modal reflects the result that was just recorded.
    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, _difficulty);
        _statItems = GameStatsPanel.Build(bucket);
    }

    private void ResetGame()
    {
        _demoCts?.Cancel();
        // Bug fix QA #9: cancel any in-flight AI move so the player isn't
        // stuck on "🤖 AI thinking…" after pressing New Game.
        _aiMoveCts?.Cancel();
        _aiMoveCts?.Dispose();
        _aiMoveCts = null;
        _board = new ConnectFiveBoard();
        _gameResult = GameResult.InProgress;
        _winCells = new();
        _isAiTurn = false;
        _current2pPlayer = Player.Red;
        _matchRecorded = false;
        // Audit #9: a fresh game must play the cascade again on its next win.
        _winCascadePlayed = false;
        _stats = _gameStats.GetStats("connectfive", _playerName);
        UpdateStats();

        if (PlayMode == "demo")
        {
            _demoCts = new CancellationTokenSource();
            // Kick off the CPU-vs-CPU auto-play loop. This call was dropped in
            // the KioskCoordinator refactor, which left demo mode showing an
            // empty board — the kiosk timer moved out, but the per-game loop
            // must still start here.
            _ = RunDemoLoop(_demoCts.Token);
        }
        else
        {
            // Save last played game (UX 10)
            _gameStats.SaveLastPlayedGame("connectfive");
        }
    }

    private async Task RunDemoLoop(CancellationToken ct)
    {
        await Task.Delay(700, ct);
        while (!ct.IsCancellationRequested && _gameResult == GameResult.InProgress)
        {
            // Audit #4: 850ms cadence (was 500ms). The drop animation is 0.55s
            // (CSS cf-slide-down), so 850ms gives each piece ~300ms of calm
            // between drops. Combined with #3 (no bounce keyframe), the disc
            // lands cleanly and sits still long enough for the eye to register
            // before the next piece starts falling.
            const int demoStepMs = 850;
            // Red (CPU1) move
            var (rr, rc) = _ai.GetMove(_board, Player.Red, _difficulty);
            _board = _board.Place(rr, rc, Player.Red);
            var redWin = _board.CheckWin(Player.Red);
            if (redWin.Won) { _gameResult = GameResult.Win; _winCells = redWin.Cells; OnWinDetected(); }
            else if (_board.IsFull()) { _gameResult = GameResult.Draw; }
            await InvokeAsync(StateHasChanged);
            if (_gameResult != GameResult.InProgress) break;
            await Task.Delay(demoStepMs, ct);

            // Yellow (CPU2) move
            var (yr, yc) = _ai.GetMove(_board, Player.Yellow, _difficulty);
            _board = _board.Place(yr, yc, Player.Yellow);
            var yellowWin = _board.CheckWin(Player.Yellow);
            if (yellowWin.Won) { _gameResult = GameResult.Loss; _winCells = yellowWin.Cells; OnWinDetected(); }
            else if (_board.IsFull()) { _gameResult = GameResult.Draw; }
            await InvokeAsync(StateHasChanged);
            if (_gameResult != GameResult.InProgress) break;
            await Task.Delay(demoStepMs, ct);
        }
        if (!ct.IsCancellationRequested && _gameResult != GameResult.InProgress)
        {
            // Audit #9: keep the 3-second "view the win" window, but the win
            // cascade is now a one-shot (.cf-cell.win-cell animation runs once
            // and settles via `forwards`). After 3s the page resets and the
            // next demo's `win-cell` cells get a fresh animation run.
            await Task.Delay(3000, ct);
            if (!ct.IsCancellationRequested)
                await InvokeAsync(ResetGame);
        }
    }

    public void Dispose()
    {
        _demoCts?.Cancel();
        _aiMoveCts?.Cancel();
        _aiMoveCts?.Dispose();
        // BUG FIX (#1): _kioskTimer removed; KioskCoordinator owns it.
    }

    private void HandleDrop(int col)
    {
        if (PlayMode == "demo") return;
        if (_gameResult != GameResult.InProgress || _isAiTurn) return;

        var targetRow = _board.GetTargetRow(col);
        if (targetRow < 0) return;

        if (PlayMode == "2p") { HandleTwoPlayerDrop(targetRow, col); return; }

        _board = _board.Place(targetRow, col, Player.Red);
        _ = Feedback.DiscDropAsync(); // §4 disc-landing tock, synced to the settle bounce

        var winCheck = _board.CheckWin(Player.Red);
        if (winCheck.Won)
        {
            _gameResult = GameResult.Win;
            _winCells = winCheck.Cells;
            OnWinDetected();
            _ = Feedback.CompleteAsync(); // §4 victory chord
            _ = _gameStats.RecordResult("connectfive", _playerName, _difficulty, GameResult.Win);
            UpdateStats();
            return;
        }

        if (_board.IsFull())
        {
            _gameResult = GameResult.Draw;
            _ = _gameStats.RecordResult("connectfive", _playerName, _difficulty, GameResult.Draw);
            UpdateStats();
            return;
        }

        // AI turn — Bug fix QA #9: cancel the prior AI think if still in flight,
        // and start a fresh token. The 8 s budget below surfaces a "still
        // thinking…" recovery action if the AI hangs longer than that.
        _isAiTurn = true;
        _aiMoveCts?.Cancel();
        _aiMoveCts?.Dispose();
        _aiMoveCts = new CancellationTokenSource();
        StateHasChanged();

        _ = RunAiTurnAsync(_aiMoveCts.Token);
    }

    // Bug fix QA #9: explicit AI-turn task with a hard 8 s ceiling. If the
    // search exceeds the budget the loop is cancelled, the AI flag clears,
    // and the player gets a toast with a Retry button rather than being
    // stuck on "🤖 AI thinking…".
    private const int AiMoveBudgetMs = 8_000;
    private CancellationTokenSource? _aiMoveCts;

    private async Task RunAiTurnAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(300, ct);
            var (ar, ac) = _ai.GetMove(_board, Player.Yellow, _difficulty);
            _board = _board.Place(ar, ac, Player.Yellow);
            _ = Feedback.DiscDropAsync(); // §4 the AI's disc lands with the same tock
            var aiWin = _board.CheckWin(Player.Yellow);
            if (aiWin.Won)
            {
                _gameResult = GameResult.Loss;
                _winCells = aiWin.Cells;
                _isAiTurn = false;
                OnWinDetected();
                _ = Feedback.ErrorAsync(); // §4 low buzz on defeat
                _ = _gameStats.RecordResult("connectfive", _playerName, _difficulty, GameResult.Loss);
            }
            else if (_board.IsFull())
            {
                _gameResult = GameResult.Draw;
                _isAiTurn = false;
                _ = _gameStats.RecordResult("connectfive", _playerName, _difficulty, GameResult.Draw);
            }
            else
            {
                _isAiTurn = false;
            }
            UpdateStats();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            _isAiTurn = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Local pass-and-play: Red = Player 1 (the local player), Yellow = Player 2.
    private void HandleTwoPlayerDrop(int targetRow, int col)
    {
        var player = _current2pPlayer;
        _board = _board.Place(targetRow, col, player);
        _ = Feedback.DiscDropAsync(); // §4 disc-landing tock

        var winCheck = _board.CheckWin(player);
        if (winCheck.Won)
        {
            _winCells = winCheck.Cells;
            _gameResult = player == Player.Red ? GameResult.Win : GameResult.Loss;
            OnWinDetected();
            _ = Feedback.CompleteAsync(); // §4 victory chord for whoever connected five
            RecordLocalMatch();
            return;
        }

        if (_board.IsFull())
        {
            _gameResult = GameResult.Draw;
            RecordLocalMatch();
            return;
        }

        // Audit #6: Player.Other replaces the manual ? : swap and proves at
        // the type level that we never advance to an empty player.
        _current2pPlayer = player.Other;
    }

    /// <summary>
    /// Audit #9: shared post-win hook. Marks the win so the cascade is a
    /// one-shot. Without this, the .win-cell CSS animation could replay on
    /// any Blazor re-render that preserved the win-cell class (e.g. when the
    /// ghost preview cleared after game-over), causing a visible flicker.
    /// </summary>
    private void OnWinDetected()
    {
        _winCascadePlayed = true;
    }
    private bool _winCascadePlayed;

    // Record the 2-player outcome to the head-to-head history (owner's perspective:
    // Win = Player 1 won, Loss = Player 2 won). Local vs-AI stats are left untouched.
    private void RecordLocalMatch()
    {
        if (_matchRecorded) return;
        _matchRecorded = true;
        var outcome = _gameResult switch
        {
            GameResult.Win => MatchOutcome.Win,
            GameResult.Loss => MatchOutcome.Loss,
            _ => MatchOutcome.Draw
        };
        _ = MatchHistory.RecordAsync("connectfive", MatchMode.Local2P, _player2Name, outcome);
    }

    private string GetPieceClass(Piece piece) => piece switch
    {
        Piece.Red => "red",
        Piece.Yellow => "yellow",
        _ => ""
    };

    private string GetPieceAriaLabel(Piece piece) => piece switch
    {
        Piece.Red => "Red piece",
        Piece.Yellow => "Yellow piece",
        _ => "Empty cell"
    };
}