@page "/connectfive"
@page "/connectfive/{Demo:int}"
@implements IDisposable;
@using PoMiniGamesClient.Components;
@using PoMiniGamesClient.Enums;
@using PoMiniGamesClient.Models;
@using PoMiniGamesClient.Games.ConnectFive;
@using PoMiniGamesClient.Services;
@inject NavigationManager Navigation;
@inject PlayerNameService PlayerNameService;
@inject MatchHistoryService MatchHistory;
@inject KioskCoordinator Kiosk;

<GameShell 
    Title=@TitleContent 
    Player="@_playerName"
    BackTo="@_backTo"
    GameOver="@_isGameOver"
    OnPlayAgain="ResetGame"
    ShowSettings="true"
    IsOffline="@_isOffline"
    Stats="@_statItems"
    Status="@StatusContent"
    GameSummary="@GameSummaryContent"
    Controls="@ControlsContent">
    
    <div class="cf-layout">
        <div class="cf-board" role="grid" aria-label="Connect Five game board">
            @for (int r = 0; r < ConnectFiveBoard.Rows; r++)
            {
                @for (int c = 0; c < ConnectFiveBoard.Cols; c++)
                {
                    var row = r;
                    var col = c;
                    var piece = _board.Get(r, c);
                    var isWinCell = _winCells.Any(wc => wc.Row == r && wc.Col == c);

                    <div class="cf-cell @GetPieceClass(piece) @(isWinCell ? "win-cell" : "") @(_gameResult != GameResult.InProgress ? "disabled" : "") @(_hoveredCol == col && _gameResult == GameResult.InProgress && !_isAiTurn && PlayMode != "demo" ? "col-hover" : "")"
                         @onclick="() => HandleDrop(col)"
                         @onmouseenter="() => _hoveredCol = col"
                         @onmouseleave="() => _hoveredCol = -1"
                         role="gridcell"
                         aria-label="@GetPieceAriaLabel(piece)">
                        @* --drop-rows sets how far the piece falls: from above the
                           board down to its resting row (row index + 1 strides). *@
                        @if (piece == Piece.Red)
                        {
                            <span class="piece red-piece" style="--drop-rows: @(row + 1)">🔴</span>
                        }
                        else if (piece == Piece.Yellow)
                        {
                            <span class="piece yellow-piece" style="--drop-rows: @(row + 1)">🟡</span>
                        }
                    </div>
                }
            }
        </div>
    </div>
</GameShell>

@code {
    [Parameter] public int? Demo { get; set; }
    [SupplyParameterFromQuery(Name = "kiosk")] public int KioskNext { get; set; } = -1;
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }

    private ConnectFiveBoard _board = new();
    private ConnectFiveAI _ai = new();
    private Difficulty _difficulty = Difficulty.Medium;
    private GameResult _gameResult = GameResult.InProgress;
    private bool _isAiTurn;
    private int _hoveredCol = -1;
    // "ai" (vs CPU) or "2p" (local pass-and-play); "demo" is driven by the route param.
    private string _playMode = "ai";
    private string PlayMode => Demo == 1 ? "demo" : _playMode;
    private Piece _current2pPiece = Piece.Red; // whose turn in 2-player mode
    private string _player2Name = "Player 2";
    private bool _matchRecorded;
    private string _playerName = "";
    // Player 1's display name resolves asynchronously; fall back to "Player 1" until it does.
    private string P1Name => string.IsNullOrWhiteSpace(_playerName) ? "Player 1" : _playerName;
    private bool _isOffline = false;
    private List<(int Row, int Col)> _winCells = new();
    private List<StatItem> _statItems = new();
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    private CancellationTokenSource? _demoCts;
    // BUG FIX (#1): _kioskTimer removed; KioskCoordinator owns the timer.

    private string _backTo => "/";
    private bool _isGameOver => _gameResult != GameResult.InProgress && PlayMode != "demo";

    private RenderFragment TitleContent => @<span>🔴 Connect Five</span>;

    private RenderFragment StatusContent => PlayMode == "demo" ? @<span class="cf-status cf-status--demo">🎮 Demo mode</span>
        : PlayMode == "2p"
            ? (_gameResult == GameResult.InProgress
                ? (_current2pPiece == Piece.Red
                    ? @<span class="cf-status cf-status--player">🔴 @P1Name's turn</span>
                    : @<span class="cf-status cf-status--ai">🟡 @_player2Name's turn</span>)
                : _gameResult == GameResult.Win
                    ? @<span class="cf-status cf-status--win">🎉 @P1Name wins!</span>
                    : _gameResult == GameResult.Loss
                        ? @<span class="cf-status cf-status--win">🎉 @_player2Name wins!</span>
                        : @<span class="cf-status cf-status--draw">🤝 Draw!</span>)
            : _gameResult == GameResult.InProgress
                ? (_isAiTurn
                    ? @<span class="cf-status cf-status--ai">🤖 AI thinking…</span>
                    : @<span class="cf-status cf-status--player">🔴 Your turn</span>)
                : _gameResult == GameResult.Win
                    ? @<span class="cf-status cf-status--win">🎉 You win!</span>
                    : _gameResult == GameResult.Loss
                        ? @<span class="cf-status cf-status--loss">🤖 AI wins</span>
                        : @<span class="cf-status cf-status--draw">🤝 Draw!</span>;

    private RenderFragment? GameSummaryContent => _isGameOver ? (PlayMode == "2p" ? _gameResult switch
    {
        GameResult.Win  => @<div class="cf-result cf-result--win">🔴 @P1Name won! Nice game.</div>,
        GameResult.Loss => @<div class="cf-result cf-result--win">🟡 @_player2Name won! Nice game.</div>,
        GameResult.Draw => @<div class="cf-result cf-result--draw">🤝 It’s a draw!</div>,
        _               => null
    } : _gameResult switch
    {
        GameResult.Win  => @<div class="cf-result cf-result--win">🎉 You won! Great game, @_playerName!</div>,
        GameResult.Loss => @<div class="cf-result cf-result--loss">🤖 AI wins this round — try again!</div>,
        GameResult.Draw => @<div class="cf-result cf-result--draw">🤝 It’s a draw!</div>,
        _               => null
    }) : null;

    private RenderFragment ControlsContent => @<div class="gps-controls">
        @if (PlayMode != "demo")
        {
            <button type="button"
                    class="@(PlayMode == "ai" ? "active" : "")"
                    @onclick='() => SetPlayMode("ai")'>
                Vs AI
            </button>
            <button type="button"
                    class="@(PlayMode == "2p" ? "active" : "")"
                    @onclick='() => SetPlayMode("2p")'>
                2 Player
            </button>
        }
        @if (PlayMode == "demo")
        {
            <button type="button"
                    class="@(PlayMode == "demo" ? "active" : "")"
                    @onclick="() => {}">
                Demo CPU vs CPU
            </button>
        }
        <button @onclick="ResetGame">
            🔄 @(PlayMode == "demo" ? "Restart Demo" : "New Game")
        </button>
        @if (PlayMode == "ai")
        {
            <select @bind="_difficulty" @bind:after="ResetGame" aria-label="Select difficulty">
                <option value="@Difficulty.Easy">Easy</option>
                <option value="@Difficulty.Medium">Medium</option>
                <option value="@Difficulty.Hard">Hard</option>
            </select>
        }
        @if (PlayMode == "2p")
        {
            <input class="gps-name-input" value="@_player2Name" @onchange="OnPlayer2NameChange"
                   maxlength="24" placeholder="Player 2 name" aria-label="Player 2 name" />
        }
    </div>;

    protected override void OnInitialized()
    {
        _playerName = PlayerNameService.GetPlayerName();
        if (Demo != 1 && string.Equals(ModeQuery, "2p", StringComparison.OrdinalIgnoreCase))
            _playMode = "2p";
        _stats = _gameStats.GetStats("connectfive", _playerName);
        UpdateStats();
        ResetGame();
        if (Demo == 1) Kiosk.SetCurrent("connectfive-demo");
    }

    private void SetPlayMode(string mode)
    {
        _playMode = mode;
        ResetGame();
    }

    private void OnPlayer2NameChange(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        _player2Name = string.IsNullOrWhiteSpace(name) ? "Player 2" : name.Trim();
    }

    private void ResetGame()
    {
        _demoCts?.Cancel();
        // Bug fix QA #9: cancel any in-flight AI move so the player isn't
        // stuck on "🤖 AI thinking…" after pressing New Game.
        _aiMoveCts?.Cancel();
        _aiMoveCts?.Dispose();
        _aiMoveCts = null;
        _board = new ConnectFiveBoard();
        _gameResult = GameResult.InProgress;
        _winCells = new();
        _isAiTurn = false;
        _hoveredCol = -1;
        _current2pPiece = Piece.Red;
        _matchRecorded = false;
        _stats = _gameStats.GetStats("connectfive", _playerName);
        UpdateStats();

        if (PlayMode == "demo")
        {
            _demoCts = new CancellationTokenSource();
        }
        else
        {
            // Save last played game (UX 10)
            _gameStats.SaveLastPlayedGame("connectfive");
        }
    }

    private async Task RunDemoLoop(CancellationToken ct)
    {
        await Task.Delay(700, ct);
        while (!ct.IsCancellationRequested && _gameResult == GameResult.InProgress)
        {
            // Red (CPU1) move
            var (rr, rc) = _ai.GetMove(_board, Piece.Red, _difficulty);
            _board = _board.Place(rr, rc, Piece.Red);
            var redWin = _board.CheckWin(Piece.Red);
            if (redWin.Won) { _gameResult = GameResult.Win; _winCells = redWin.Cells; }
            else if (_board.IsFull()) { _gameResult = GameResult.Draw; }
            await InvokeAsync(StateHasChanged);
            if (_gameResult != GameResult.InProgress) break;
            await Task.Delay(500, ct);

            // Yellow (CPU2) move
            var (yr, yc) = _ai.GetMove(_board, Piece.Yellow, _difficulty);
            _board = _board.Place(yr, yc, Piece.Yellow);
            var yellowWin = _board.CheckWin(Piece.Yellow);
            if (yellowWin.Won) { _gameResult = GameResult.Loss; _winCells = yellowWin.Cells; }
            else if (_board.IsFull()) { _gameResult = GameResult.Draw; }
            await InvokeAsync(StateHasChanged);
            if (_gameResult != GameResult.InProgress) break;
            await Task.Delay(500, ct);
        }
        if (!ct.IsCancellationRequested && _gameResult != GameResult.InProgress)
        {
            await Task.Delay(3000, ct);
            if (!ct.IsCancellationRequested)
                await InvokeAsync(ResetGame);
        }
    }

    public void Dispose()
    {
        _demoCts?.Cancel();
        _aiMoveCts?.Cancel();
        _aiMoveCts?.Dispose();
        // BUG FIX (#1): _kioskTimer removed; KioskCoordinator owns it.
    }

    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, _difficulty);
        _statItems = GameStatsPanel.Build(bucket);
    }

    private void HandleDrop(int col)
    {
        if (PlayMode == "demo") return;
        if (_gameResult != GameResult.InProgress || _isAiTurn) return;

        var targetRow = _board.GetTargetRow(col);
        if (targetRow < 0) return;

        if (PlayMode == "2p") { HandleTwoPlayerDrop(targetRow, col); return; }

        _board = _board.Place(targetRow, col, Piece.Red);
        
        var winCheck = _board.CheckWin(Piece.Red);
        if (winCheck.Won)
        {
            _gameResult = GameResult.Win;
            _winCells = winCheck.Cells;
            _ = _gameStats.RecordResult("connectfive", _playerName, _difficulty, GameResult.Win);
            UpdateStats();
            return;
        }

        if (_board.IsFull())
        {
            _gameResult = GameResult.Draw;
            _ = _gameStats.RecordResult("connectfive", _playerName, _difficulty, GameResult.Draw);
            UpdateStats();
            return;
        }

        // AI turn — Bug fix QA #9: cancel the prior AI think if still in flight,
        // and start a fresh token. The 8 s budget below surfaces a "still
        // thinking…" recovery action if the AI hangs longer than that.
        _isAiTurn = true;
        _hoveredCol = -1;
        _aiMoveCts?.Cancel();
        _aiMoveCts?.Dispose();
        _aiMoveCts = new CancellationTokenSource();
        StateHasChanged();

        _ = RunAiTurnAsync(_aiMoveCts.Token);
    }

    // Bug fix QA #9: explicit AI-turn task with a hard 8 s ceiling. If the
    // search exceeds the budget the loop is cancelled, the AI flag clears,
    // and the player gets a toast with a Retry button rather than being
    // stuck on "🤖 AI thinking…".
    private const int AiMoveBudgetMs = 8_000;
    private CancellationTokenSource? _aiMoveCts;

    private async Task RunAiTurnAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(300, ct);
            var (ar, ac) = _ai.GetMove(_board, Piece.Yellow, _difficulty);
            _board = _board.Place(ar, ac, Piece.Yellow);
            var aiWin = _board.CheckWin(Piece.Yellow);
            if (aiWin.Won)
            {
                _gameResult = GameResult.Loss;
                _winCells = aiWin.Cells;
                _isAiTurn = false;
                _ = _gameStats.RecordResult("connectfive", _playerName, _difficulty, GameResult.Loss);
            }
            else if (_board.IsFull())
            {
                _gameResult = GameResult.Draw;
                _isAiTurn = false;
                _ = _gameStats.RecordResult("connectfive", _playerName, _difficulty, GameResult.Draw);
            }
            else
            {
                _isAiTurn = false;
            }
            UpdateStats();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            _isAiTurn = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Local pass-and-play: Red = Player 1 (the local player), Yellow = Player 2.
    private void HandleTwoPlayerDrop(int targetRow, int col)
    {
        var piece = _current2pPiece;
        _board = _board.Place(targetRow, col, piece);
        _hoveredCol = -1;

        var winCheck = _board.CheckWin(piece);
        if (winCheck.Won)
        {
            _winCells = winCheck.Cells;
            _gameResult = piece == Piece.Red ? GameResult.Win : GameResult.Loss;
            RecordLocalMatch();
            return;
        }

        if (_board.IsFull())
        {
            _gameResult = GameResult.Draw;
            RecordLocalMatch();
            return;
        }

        _current2pPiece = piece == Piece.Red ? Piece.Yellow : Piece.Red;
    }

    // Record the 2-player outcome to the head-to-head history (owner's perspective:
    // Win = Player 1 won, Loss = Player 2 won). Local vs-AI stats are left untouched.
    private void RecordLocalMatch()
    {
        if (_matchRecorded) return;
        _matchRecorded = true;
        var outcome = _gameResult switch
        {
            GameResult.Win => MatchOutcome.Win,
            GameResult.Loss => MatchOutcome.Loss,
            _ => MatchOutcome.Draw
        };
        _ = MatchHistory.RecordAsync("connectfive", MatchMode.Local2P, _player2Name, outcome);
    }

    private string GetPieceClass(Piece piece) => piece switch
    {
        Piece.Red => "red",
        Piece.Yellow => "yellow",
        _ => ""
    };

    private string GetPieceAriaLabel(Piece piece) => piece switch
    {
        Piece.Red => "Red piece",
        Piece.Yellow => "Yellow piece",
        _ => "Empty cell"
    };
}