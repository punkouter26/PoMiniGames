@page "/dropsquare"
@page "/podropsquare"
@using PoMiniGamesClient.Components;
@using PoMiniGamesClient.Enums;
@using PoMiniGamesClient.Models;
@using PoMiniGamesClient.Services;
@inject PlayerNameService PlayerNameService;
@inject NavigationManager Navigation;

<GameShell Title=@TitleContent 
           Player="@_playerName"
           BackTo="/"
           GameOver="@_isGameOver"
           OnPlayAgain="ResetGame"
           ShowSettings="true"
           Stats="@_statItems"
           Status="@StatusContent"
           GameSummary="@GameSummaryContent"
           Controls="@ControlsContent">
    <div class="drop-square-wrapper" tabindex="0" @onkeydown="HandleKey" @ref="_wrapper">
        <div class="drop-square-board">
            @for (int r = 0; r < _rows; r++)
            {
                @for (int c = 0; c < _cols; c++)
                {
                    var row = r;
                    var col = c;
                    <div class="drop-square-cell @(GetCellClass(row, col))" @onclick="() => DropPiece(col)"></div>
                }
            }
        </div>
        <div class="drop-square-score">
            <span>Score: @_score</span>
            <span>Lines: @_lines</span>
        </div>
    </div>
</GameShell>

@code {
    private const int _rows = 20;
    private const int _cols = 10;
    private string _playerName = "";
    private List<StatItem> _statItems = new();
    private bool _isGameOver;
    private int _score;
    private int _lines;
    private int _currentPiece;
    private int _currentRotation;
    private int _currentX;
    private int _currentY;
    private readonly int[][] _board = new int[_rows][];
    private System.Threading.Timer? _timer;
    private ElementReference _wrapper;
    private readonly int[][][] _pieces = new[]
    {
        new[] { new[] { 1, 1, 1, 1 } }, // I
        new[] { new[] { 1, 1 }, new[] { 1, 1 } }, // O
        new[] { new[] { 0, 1, 0 }, new[] { 1, 1, 1 } }, // T
        new[] { new[] { 1, 0, 0 }, new[] { 1, 1, 1 } }, // L
        new[] { new[] { 0, 0, 1 }, new[] { 1, 1, 1 } }, // J
        new[] { new[] { 0, 1, 1 }, new[] { 1, 1, 0 } }, // S
        new[] { new[] { 1, 1, 0 }, new[] { 0, 1, 1 } }, // Z
    };
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();

    private RenderFragment ControlsContent => @<div class="gps-controls">
        <button @onclick="StartGame" disabled="@(_timer != null)">▶ Start</button>
        <button @onclick="ResetGame">🔄 Reset</button>
        <button @onclick="() => MovePiece(-1)">◀</button>
        <button @onclick="Rotate">⟳</button>
        <button @onclick="() => MovePiece(1)">▶</button>
        <button @onclick="SoftDrop">⬇</button>
        <button @onclick="() => DropPiece()">⤓ Drop</button>
    </div>;

    private RenderFragment TitleContent => @<span>🟦 Drop Square</span>;

    private RenderFragment StatusContent => @<span class="gps-status-badge turn">Score @_score · Lines @_lines</span>;
    private RenderFragment? GameSummaryContent => _isGameOver
        ? @<span class="cf-result cf-result--loss">💀 Game over — @_score pts</span>
        : null;

    protected override void OnInitialized()
    {
        _playerName = PlayerNameService.GetPlayerName();
        for (int r = 0; r < _rows; r++) _board[r] = new int[_cols];
        _stats = _gameStats.GetStats("podropsquare", _playerName);
        UpdateStats();
    }

    private void StartGame()
    {
        for (int r = 0; r < _rows; r++)
            for (int c = 0; c < _cols; c++)
                _board[r][c] = 0;
        _isGameOver = false;
        _score = 0;
        _lines = 0;
        NewPiece();
        _timer = new System.Threading.Timer(_ => InvokeAsync(Tick), null, 500, 500);

        // Focus the board so keyboard controls (arrows / space) work immediately.
        _ = _wrapper.FocusAsync();

        // Save last played game (UX 10)
        _gameStats.SaveLastPlayedGame("podropsquare");
    }

    private void Tick()
    {
        MovePiece(0);
        InvokeAsync(StateHasChanged);
    }

    private void NewPiece()
    {
        _currentPiece = Random.Shared.Next(_pieces.Length);
        _currentRotation = 0;
        _currentX = _cols / 2;
        _currentY = 0;
    }

    private void MovePiece(int dx)
    {
        if (_isGameOver || _timer == null) return;
        if (dx != 0)
        {
            // Horizontal move: succeeds when the piece fits at the same height.
            var newX = _currentX + dx;
            if (CanPlace(_currentPiece, _currentRotation, newX, _currentY))
                _currentX = newX;
            return;
        }
        // Gravity step: drop one row, or lock when it can't fall further.
        if (CanPlace(_currentPiece, _currentRotation, _currentX, _currentY + 1))
            _currentY++;
        else
            LockPiece();
    }

    // Soft drop (one row down on demand); locks if it can't fall.
    private void SoftDrop() => MovePiece(0);

    private void Rotate()
    {
        if (_isGameOver || _timer == null) return;
        var next = (_currentRotation + 1) % 4;
        if (CanPlace(_currentPiece, next, _currentX, _currentY))
            _currentRotation = next;
        else if (CanPlace(_currentPiece, next, _currentX - 1, _currentY)) { _currentX--; _currentRotation = next; }
        else if (CanPlace(_currentPiece, next, _currentX + 1, _currentY)) { _currentX++; _currentRotation = next; }
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (_isGameOver || _timer == null) return;
        switch (e.Key)
        {
            case "ArrowLeft": MovePiece(-1); break;
            case "ArrowRight": MovePiece(1); break;
            case "ArrowDown": SoftDrop(); break;
            case "ArrowUp": Rotate(); break;
            case " ": DropPiece(); break;
        }
    }

    // Returns the piece's cells rotated clockwise `rotation` quarter-turns.
    private int[][] GetShape(int piece, int rotation)
    {
        var shape = _pieces[piece];
        var turns = ((rotation % 4) + 4) % 4;
        for (int i = 0; i < turns; i++)
            shape = RotateCw(shape);
        return shape;
    }

    private static int[][] RotateCw(int[][] shape)
    {
        int rows = shape.Length, cols = shape[0].Length;
        var res = new int[cols][];
        for (int c = 0; c < cols; c++)
        {
            res[c] = new int[rows];
            for (int r = 0; r < rows; r++)
                res[c][rows - 1 - r] = shape[r][c];
        }
        return res;
    }

    public void DropPiece(int col = -1)
    {
        if (_isGameOver) return;
        // Move the piece to the tapped column, but only if it still fits there.
        if (col >= 0 && CanPlace(_currentPiece, _currentRotation, col, _currentY))
        {
            _currentX = col;
        }
        // Drop to bottom
        while (CanPlace(_currentPiece, _currentRotation, _currentX, _currentY + 1))
        {
            _currentY++;
        }
        LockPiece();
    }

    private bool CanPlace(int piece, int rotation, int x, int y)
    {
        var shape = GetShape(piece, rotation);
        for (int r = 0; r < shape.Length; r++)
        {
            for (int c = 0; c < shape[r].Length; c++)
            {
                if (shape[r][c] == 0) continue;
                var px = x + c;
                var py = y + r;
                if (px < 0 || px >= _cols || py >= _rows) return false;
                if (py >= 0 && _board[py][px] != 0) return false;
            }
        }
        return true;
    }

    private void LockPiece()
    {
        // Merge the current piece into the board.
        var shape = GetShape(_currentPiece, _currentRotation);
        for (int r = 0; r < shape.Length; r++)
        {
            for (int c = 0; c < shape[r].Length; c++)
            {
                if (shape[r][c] == 0) continue;
                var px = _currentX + c;
                var py = _currentY + r;
                if (py >= 0 && py < _rows && px >= 0 && px < _cols)
                    _board[py][px] = _currentPiece + 1;
            }
        }

        ClearLines();

        // Spawn the next piece; if it cannot be placed at the top, the stack is full.
        NewPiece();
        if (!CanPlace(_currentPiece, _currentRotation, _currentX, _currentY))
        {
            EndGame();
            return;
        }
        UpdateStats();
    }

    private void ClearLines()
    {
        int cleared = 0;
        for (int r = _rows - 1; r >= 0; r--)
        {
            bool full = true;
            for (int c = 0; c < _cols; c++)
            {
                if (_board[r][c] == 0) { full = false; break; }
            }
            if (!full) continue;

            // Shift every row above down by one, then clear the top row.
            for (int rr = r; rr > 0; rr--)
                for (int c = 0; c < _cols; c++)
                    _board[rr][c] = _board[rr - 1][c];
            for (int c = 0; c < _cols; c++) _board[0][c] = 0;

            cleared++;
            r++; // Re-check this row index, which now holds the shifted-down contents.
        }

        if (cleared > 0)
        {
            _lines += cleared;
            _score += cleared switch
            {
                1 => 100,
                2 => 300,
                3 => 500,
                _ => 800
            };
        }
    }

    private void EndGame()
    {
        _isGameOver = true;
        _timer?.Dispose();
        _timer = null;

        // Record result
        _ = _gameStats.RecordResult("podropsquare", _playerName, Difficulty.Easy, GameResult.Loss);
        UpdateStats();
    }

    private string GetCellClass(int row, int col)
    {
        if (_board[row][col] != 0) return "occupied";
        if (_timer != null && !_isGameOver && row >= _currentY && row < _currentY + 4 && col >= _currentX && col < _currentX + 4)
        {
            var shape = GetShape(_currentPiece, _currentRotation);
            var localR = row - _currentY;
            var localC = col - _currentX;
            if (localR < shape.Length && localC < shape[localR].Length && shape[localR][localC] != 0)
                return "current";
        }
        return "";
    }

    private void ResetGame()
    {
        _timer?.Dispose();
        _timer = null;
        _isGameOver = false;
        _score = 0;
        _lines = 0;
        for (int r = 0; r < _rows; r++)
            for (int c = 0; c < _cols; c++)
                _board[r][c] = 0;
    }

    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, Difficulty.Easy);
        _statItems = GameStatsPanel.Build(bucket, includeDraws: true,
            ("Score", _score.ToString()),
            ("Lines", _lines.ToString()));
    }
}