@page "/fight"
@page "/pofight"
@page "/pofight/{Demo:int}"
@using PoMiniGamesClient.Components;
@using PoMiniGamesClient.Enums;
@using PoMiniGamesClient.Models;
@using PoMiniGamesClient.Services;
@implements IDisposable
@inject PlayerNameService PlayerNameService;
@inject NavigationManager Navigation;
@inject KioskCoordinator Kiosk;

<GameShell Title=@TitleContent
           Player="@_playerName"
           BackTo="@_backTo"
           GameOver="@(_playerHp <= 0 || _enemyHp <= 0)"
           OnPlayAgain="ResetGame"
           ShowSettings="true"
           IsOffline="@_isOffline"
           Stats="@_statItems"
           Controls="@ControlsContent">
    <div class="fight-wrapper">
        @if (Demo == 1)
        {
            <div class="fight-demo-badge">🎮 Demo — CPU vs CPU</div>
        }
        <div class="fight-arena">
            <div class="fighter player @(_playerHit ? "hit" : "")">
                <div class="fighter-avatar" aria-hidden="true">🥷</div>
                <div class="fighter-name">@(Demo == 1 ? "CPU Red" : "Player")</div>
                <div class="fighter-hp-bar"><div class="hp-fill @(_playerHp < 30 ? "low" : "")" style="width: @(_playerHp)%"></div></div>
                <div class="fighter-hp">@_playerHp HP</div>
                @if (_lastEnemyDmg > 0)
                {
                    <div class="damage-num" key="@_dmgKey">-@_lastEnemyDmg</div>
                }
            </div>
            <div class="vs" aria-hidden="true">VS</div>
            <div class="fighter enemy @(_enemyHit ? "hit" : "")">
                <div class="fighter-avatar" aria-hidden="true">🤖</div>
                <div class="fighter-name">@(Demo == 1 ? "CPU Blue" : "Enemy")</div>
                <div class="fighter-hp-bar"><div class="hp-fill enemy @(_enemyHp < 30 ? "low" : "")" style="width: @(_enemyHp)%"></div></div>
                <div class="fighter-hp">@_enemyHp HP</div>
                @if (_lastPlayerDmg > 0)
                {
                    <div class="damage-num enemy" key="@_dmgKey">-@_lastPlayerDmg</div>
                }
            </div>
        </div>
        @if (_playerHp <= 0 || _enemyHp <= 0)
        {
            <div class="fight-ko" aria-live="polite">@(_playerHp <= 0 ? "BLUE WINS!" : "RED WINS!")</div>
        }
        <div class="fight-log" aria-live="polite" aria-label="Combat log">
            @foreach (var log in _combatLog.TakeLast(5))
            {
                var cls = log.Contains("wins", StringComparison.OrdinalIgnoreCase)
                    ? (_playerHp <= 0 ? "lose" : "win")
                    : "";
                <div class="log-entry @cls">@log</div>
            }
        </div>
    </div>
</GameShell>

@code {
    [Parameter] public int? Demo { get; set; }
    [SupplyParameterFromQuery(Name = "kiosk")] public int KioskNext { get; set; } = -1;

    private string _playerName = "";
    private List<StatItem> _statItems = new();
    private int _playerHp = 100;
    private int _enemyHp = 100;
    private readonly List<string> _combatLog = new();
    private bool _isOffline = false;
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    private System.Threading.Timer? _demoTimer;

    // BUG FIX (#6): damage-number + hit-flash transient state. 2026 polish.
    private int _lastPlayerDmg;
    private int _lastEnemyDmg;
    private bool _playerHit;
    private bool _enemyHit;
    private int _dmgKey;

    private string _backTo => Demo == 1 ? "/single-player?mode=demo" : "/single-player";

    private RenderFragment ControlsContent => @<div class="gps-controls">
        @if (Demo != 1)
        {
            <button @onclick="() => Attack(15, 25)">⚔️ Attack</button>
            <button @onclick="() => Defend()">🛡️ Defend</button>
            <button @onclick="() => Heal()">💚 Heal</button>
        }
        <button @onclick="ResetGame">🔄 @(Demo == 1 ? "Restart Demo" : "Reset")</button>
    </div>;

    private RenderFragment TitleContent => @<span>⚔️ PoFight</span>;

    protected override void OnInitialized()
    {
        _playerName = PlayerNameService.GetPlayerName();
        _stats = _gameStats.GetStats("pofight", _playerName);
        UpdateStats();
        if (Demo == 1)
        {
            StartDemoLoop();
            // BUG FIX (#1, #4): Tell the shared coordinator we're the
            // current demo. It owns the 20s advance timer, which it
            // disposes on any LocationChanged — fixing the infinite-
            // pofight-loop and the "stale timer hijacks navigation" bug.
            Kiosk.SetCurrent("pofight-demo");
        }
    }

    private void StartDemoLoop()
    {
        _demoTimer?.Dispose();
        // Alternate CPU turns every 1.2s
        _demoTimer = new System.Threading.Timer(_ => InvokeAsync(DemoTick), null, 1200, 1200);
    }

    private async Task DemoTick()
    {
        if (_playerHp <= 0 || _enemyHp <= 0)
        {
            // Game over — restart after a short pause.  No local kiosk
            // timer; the coordinator owns the 20s advance to the next demo.
            _demoTimer?.Dispose();
            _demoTimer = new System.Threading.Timer(_ => InvokeAsync(ResetDemo), null, 2000, Timeout.Infinite);
            return;
        }

        // CPU Red attacks
        var dmg1 = Random.Shared.Next(8, 22);
        _enemyHp = Math.Max(0, _enemyHp - dmg1);
        _lastPlayerDmg = dmg1;
        _enemyHit = true;
        _combatLog.Add($"CPU Red deals {dmg1} damage!");
        _dmgKey++;
        await Task.Delay(120);
        _enemyHit = false;

        if (_enemyHp > 0)
        {
            await Task.Delay(900);
            // CPU Blue retaliates
            var dmg2 = Random.Shared.Next(8, 22);
            _playerHp = Math.Max(0, _playerHp - dmg2);
            _lastEnemyDmg = dmg2;
            _playerHit = true;
            _combatLog.Add($"CPU Blue deals {dmg2} damage!");
            _dmgKey++;
            await Task.Delay(120);
            _playerHit = false;
        }

        if (_playerHp <= 0) _combatLog.Add("CPU Blue wins!");
        else if (_enemyHp <= 0) _combatLog.Add("CPU Red wins!");

        StateHasChanged();
    }

    private void ResetDemo()
    {
        _playerHp = 100;
        _enemyHp = 100;
        _lastPlayerDmg = 0;
        _lastEnemyDmg = 0;
        _combatLog.Clear();
        StartDemoLoop();
        StateHasChanged();
    }

    private void Attack(int minDmg, int maxDmg)
    {
        if (Demo == 1) return;
        var dmg = Random.Shared.Next(minDmg, maxDmg + 1);
        _enemyHp = Math.Max(0, _enemyHp - dmg);
        _lastPlayerDmg = dmg;
        _dmgKey++;
        _enemyHit = true;
        _combatLog.Add($"You dealt {dmg} damage!");

        if (_enemyHp <= 0)
        {
            _combatLog.Add("You won!");
            _ = _gameStats.RecordResult("pofight", _playerName, Difficulty.Medium, GameResult.Win);
            _gameStats.SaveLastPlayedGame("pofight");
            UpdateStats();
        }
        else
        {
            EnemyTurn();
        }
        StateHasChanged();
        _ = Task.Delay(240).ContinueWith(_ => InvokeAsync(() => { _enemyHit = false; StateHasChanged(); }));
    }

    private void Defend()
    {
        if (Demo == 1) return;
        _combatLog.Add("You defended!");
        EnemyTurn(true);
        StateHasChanged();
    }

    private void Heal()
    {
        if (Demo == 1) return;
        var heal = Random.Shared.Next(10, 20);
        _playerHp = Math.Min(100, _playerHp + heal);
        _combatLog.Add($"You healed {heal} HP!");
        EnemyTurn();
        StateHasChanged();
    }

    private void EnemyTurn(bool defending = false)
    {
        var dmg = Random.Shared.Next(8, 18);
        if (defending) dmg /= 2;
        _playerHp = Math.Max(0, _playerHp - dmg);
        _lastEnemyDmg = dmg;
        _dmgKey++;
        _playerHit = true;
        _combatLog.Add($"Enemy dealt {dmg} damage!");

        if (_playerHp <= 0)
        {
            _combatLog.Add("You lost!");
            _ = _gameStats.RecordResult("pofight", _playerName, Difficulty.Medium, GameResult.Loss);
            _gameStats.SaveLastPlayedGame("pofight");
            UpdateStats();
        }
        _ = Task.Delay(240).ContinueWith(_ => InvokeAsync(() => { _playerHit = false; StateHasChanged(); }));
    }

    private void ResetGame()
    {
        _playerHp = 100;
        _enemyHp = 100;
        _lastPlayerDmg = 0;
        _lastEnemyDmg = 0;
        _combatLog.Clear();
        if (Demo == 1) StartDemoLoop();
    }

    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, Difficulty.Medium);
        _statItems = GameStatsPanel.Build(bucket);
    }

    public void Dispose()
    {
        _demoTimer?.Dispose();
        // BUG FIX (#1): No more local _kioskTimer. The KioskCoordinator
        // owns the advance timer and disposes it on LocationChanged.
    }
}