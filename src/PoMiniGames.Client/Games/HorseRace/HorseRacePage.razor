@page "/horserace"
@page "/pohorserace"
@using PoMiniGamesClient.Components;
@using PoMiniGamesClient.Enums;
@using PoMiniGamesClient.Models;
@using PoMiniGamesClient.Services;
@implements IDisposable
@inject PlayerNameService PlayerNameService;
@inject NavigationManager Navigation;

<GameShell Title=@TitleContent 
           Player="@_playerName"
           BackTo="/single-player"
           GameOver="@_finished"
           OnPlayAgain="ResetGame"
           ShowSettings="true"
           IsOffline="@_isOffline"
           Stats="@_statItems"
           Controls="@ControlsContent">
    <div class="horse-race-wrapper">
        <div class="race-track">
            @for (int i = 0; i < 4; i++)
            {
                var horse = i;
                <div class="horse-lane">
                    <span class="horse-icon">@GetHorseEmoji(horse)</span>
                    <div class="track">
                        <div class="horse @(horse == _selectedHorse ? "selected" : "")" 
                             style="left: @(_horsePositions[horse])%"
                             @onclick="() => SelectHorse(horse)"></div>
                        <div class="finish-line"></div>
                    </div>
                    <span class="horse-name">Horse @(horse + 1)</span>
                </div>
            }
        </div>
        <div class="race-result">
            @if (_finished)
            {
                <span>@_result</span>
            }
        </div>
    </div>
</GameShell>

@code {
    private string _playerName = "";
    private List<StatItem> _statItems = new();
    private double[] _horsePositions = { 0, 0, 0, 0 };
    private bool _finished;
    private string _result = "";
    private int _selectedHorse;
    private System.Threading.Timer? _timer;
    private bool _isOffline = false;
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    private System.Threading.Timer? _kioskTimer;

    [SupplyParameterFromQuery(Name = "demo")] public int DemoMode { get; set; } = 0;
    [SupplyParameterFromQuery(Name = "kiosk")] public int KioskNext { get; set; } = -1;

    private RenderFragment ControlsContent => @<div class="gps-controls">
        <button @onclick="StartRace" disabled="@(_timer != null)">🏁 Start Race</button>
        <button @onclick="ResetGame">🔄 Reset</button>
        <span>Selected: Horse @(_selectedHorse + 1)</span>
    </div>;

    private RenderFragment TitleContent => @<span>🐎 Horse Race</span>;

    protected override void OnInitialized()
    {
        _playerName = PlayerNameService.GetPlayerName();
        _stats = _gameStats.GetStats("pohorserace", _playerName);
        UpdateStats();
        if (DemoMode == 1)
        {
            _selectedHorse = Random.Shared.Next(4);
            StartRace();
            if (KioskNext >= 0)
            {
                _kioskTimer = new System.Threading.Timer(_ =>
                {
                    _timer?.Dispose();
                    InvokeAsync(() => Navigation.NavigateTo($"/single-player?mode=demo&kiosk={KioskNext}"));
                }, null, 60_000, Timeout.Infinite);
            }
        }
    }

    private void SelectHorse(int horse)
    {
        if (_timer != null) return;
        _selectedHorse = horse;
    }

    private void StartRace()
    {
        if (_timer != null) return;
        _finished = false;
        _result = "";
        _horsePositions = new double[] { 0, 0, 0, 0 };
        
        _timer = new System.Threading.Timer(_ => InvokeAsync(Tick), null, 100, 100);
        
        // Save last played game (UX 10)
        _gameStats.SaveLastPlayedGame("pohorserace");
    }

    private void Tick()
    {
        for (int i = 0; i < 4; i++)
        {
            _horsePositions[i] += Random.Shared.NextDouble() * 3;
            if (_horsePositions[i] >= 100)
            {
                _horsePositions[i] = 100;
            }
        }

        // Check for winner
        for (int i = 0; i < 4; i++)
        {
            if (_horsePositions[i] >= 100)
            {
                _timer?.Dispose();
                _timer = null;
                _finished = true;
                _result = i == _selectedHorse ? "You won!" : $"Horse {i + 1} won!";
                
                // Record result
                var result = i == _selectedHorse ? GameResult.Win : GameResult.Loss;
                _ = _gameStats.RecordResult("pohorserace", _playerName, Difficulty.Easy, result);
                UpdateStats();

                // In demo mode: auto-restart after 2s
                if (DemoMode == 1)
                {
                    _ = Task.Delay(2000).ContinueWith(_ => InvokeAsync(() =>
                    {
                        if (_kioskTimer == null) // not navigating away
                        {
                            _selectedHorse = Random.Shared.Next(4);
                            ResetGame();
                            StartRace();
                        }
                    }));
                }
                break;
            }
        }
        InvokeAsync(StateHasChanged);
    }

    private string GetHorseEmoji(int horse)
    {
        return horse switch
        {
            0 => "🐴",
            1 => "🦄",
            2 => "🐎",
            _ => "🦄"
        };
    }

    private void ResetGame()
    {
        _timer?.Dispose();
        _timer = null;
        _finished = false;
        _result = "";
        _horsePositions = new double[] { 0, 0, 0, 0 };
        _selectedHorse = 0;
    }

    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, Difficulty.Easy);
        _statItems = new List<StatItem>
        {
            new() { Value = bucket.Wins.ToString(), Label = "W" },
            new() { Value = bucket.Losses.ToString(), Label = "L" },
            new() { Value = bucket.Draws.ToString(), Label = "D" },
            new() { Value = bucket.WinStreak.ToString(), Label = "Str" },
            new() { Value = $"{bucket.WinRate * 100:F0}%", Label = "Rate" },
            new() { Value = bucket.EloRating.ToString(), Label = "ELO" }
        };
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _kioskTimer?.Dispose();
    }
}