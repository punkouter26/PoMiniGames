@page "/horserace"
@page "/pohorserace"
@using PoMiniGamesClient.Components;
@using PoMiniGamesClient.Enums;
@using PoMiniGamesClient.Models;
@using PoMiniGamesClient.Services;
@implements IDisposable
@inject PlayerNameService PlayerNameService;
@inject NavigationManager Navigation;
@inject KioskCoordinator Kiosk;

<GameShell Title=@TitleContent 
           Player="@_playerName"
           BackTo="/"
           GameOver="@_finished"
           OnPlayAgain="ResetGame"
           ShowSettings="true"
           Stats="@_statItems"
           Status="@StatusContent"
           GameSummary="@GameSummaryContent"
           Controls="@ControlsContent">
    <div class="horse-race-wrapper">
        <div class="race-track">
            @for (int i = 0; i < 4; i++)
            {
                var horse = i;
                <div class="horse-lane">
                    <span class="horse-icon">@GetHorseEmoji(horse)</span>
                    <div class="track">
                        <div class="horse @(horse == _selectedHorse ? "selected" : "")" 
                             style="left: @(_horsePositions[horse])%"
                             @onclick="() => SelectHorse(horse)"></div>
                        <div class="finish-line"></div>
                    </div>
                    <span class="horse-name">Horse @(horse + 1)</span>
                </div>
            }
        </div>
        @if (_timer != null)
        {
            <div class="race-boost" style="text-align:center;margin:0.6rem 0;">
                <button class="cq-btn cq-btn-primary" style="font-size:1.1rem;padding:0.5rem 1.4rem;cursor:pointer;"
                        @onclick="Boost" disabled="@(_boostsLeft <= 0)">
                    ⚡ Boost Horse @(_selectedHorse + 1)
                </button>
                <span style="margin-left:0.6rem;">Boosts left: <strong>@_boostsLeft</strong></span>
            </div>
        }
        <div class="race-result">
            @* Race outcome now flows through GameSummary (GPS play-again bar);
               the inline banner is kept as an empty placeholder for visual
               rhythm but no longer carries the result text. *@
        </div>
    </div>
</GameShell>

@code {
    private string _playerName = "";
    private List<StatItem> _statItems = new();
    private double[] _horsePositions = { 0, 0, 0, 0 };
    private double[] _horseSpeeds = { 1, 1, 1, 1 };
    private bool _finished;
    private string _result = "";
    private int _selectedHorse;
    private int _boostsLeft;
    private System.Threading.Timer? _timer;
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    // BUG FIX (#1): _kioskTimer removed; KioskCoordinator owns the timer.

    [SupplyParameterFromQuery(Name = "demo")] public int DemoMode { get; set; } = 0;
    [SupplyParameterFromQuery(Name = "kiosk")] public int KioskNext { get; set; } = -1;

    private RenderFragment ControlsContent => @<div class="gps-controls">
        <button @onclick="StartRace" disabled="@(_timer != null)">🏁 Start Race</button>
        <button @onclick="ResetGame">🔄 Reset</button>
        <button @onclick="Boost" disabled="@(_timer == null || _boostsLeft <= 0)">⚡ Boost</button>
        <span>Selected: Horse @(_selectedHorse + 1)</span>
    </div>;

    private RenderFragment TitleContent => @<span>🐎 Horse Race</span>;

    private RenderFragment StatusContent => @<span class="gps-status-badge turn">Picked: Horse @(_selectedHorse + 1)</span>;
    private RenderFragment? GameSummaryContent => _finished
        ? @<span class="cf-result @(_result.StartsWith("You won") ? "cf-result--win" : "cf-result--loss")">@_result</span>
        : null;

    protected override void OnInitialized()
    {
        _playerName = PlayerNameService.GetPlayerName();
        _stats = _gameStats.GetStats("pohorserace", _playerName);
        UpdateStats();
        if (DemoMode == 1)
        {
            _selectedHorse = Random.Shared.Next(4);
            StartRace();
            Kiosk.SetCurrent("pohorserace-demo");
        }
    }

    private void SelectHorse(int horse)
    {
        if (_timer != null) return;
        _selectedHorse = horse;
    }

    // Active gameplay: spend a boost to nudge your chosen horse forward.
    private void Boost()
    {
        if (_timer == null || _finished || _boostsLeft <= 0) return;
        _boostsLeft--;
        _horsePositions[_selectedHorse] = Math.Min(100, _horsePositions[_selectedHorse] + 2.5);
    }

    private void StartRace()
    {
        if (_timer != null) return;
        _finished = false;
        _result = "";
        _horsePositions = new double[] { 0, 0, 0, 0 };
        _boostsLeft = 12;
        // Give each horse a distinct pace for this race so the lead actually
        // changes hands and a pick feels less predetermined.
        _horseSpeeds = new double[4];
        for (int i = 0; i < 4; i++) _horseSpeeds[i] = 0.7 + Random.Shared.NextDouble() * 0.7;

        _timer = new System.Threading.Timer(_ => InvokeAsync(Tick), null, 100, 100);
        
        // Save last played game (UX 10)
        _gameStats.SaveLastPlayedGame("pohorserace");
    }

    private void Tick()
    {
        for (int i = 0; i < 4; i++)
        {
            _horsePositions[i] += Random.Shared.NextDouble() * 3 * _horseSpeeds[i];
            if (_horsePositions[i] >= 100)
            {
                _horsePositions[i] = 100;
            }
        }

        // Check for winner
        for (int i = 0; i < 4; i++)
        {
            if (_horsePositions[i] >= 100)
            {
                _timer?.Dispose();
                _timer = null;
                _finished = true;
                _result = i == _selectedHorse ? "You won!" : $"Horse {i + 1} won!";

                // Record result
                var result = i == _selectedHorse ? GameResult.Win : GameResult.Loss;
                _ = _gameStats.RecordResult("pohorserace", _playerName, Difficulty.Easy, result);
                UpdateStats();

                // In demo mode: auto-restart after 2s
                if (DemoMode == 1)
                {
                    // BUG FIX (#1): Use a coordinator-owned gate to detect
                    // "still here" instead of the deleted _kioskTimer field.
                    var entryStillCurrent = Kiosk.CurrentGameName == "PoHorseRace Demo";
                    _ = Task.Delay(2000).ContinueWith(_ => InvokeAsync(() =>
                    {
                        if (entryStillCurrent)
                        {
                            _selectedHorse = Random.Shared.Next(4);
                            ResetGame();
                            StartRace();
                        }
                    }));
                }
                break;
            }
        }
        InvokeAsync(StateHasChanged);
    }

    private string GetHorseEmoji(int horse)
    {
        return horse switch
        {
            0 => "🐴",
            1 => "🦄",
            2 => "🐎",
            _ => "🦄"
        };
    }

    private void ResetGame()
    {
        _timer?.Dispose();
        _timer = null;
        _finished = false;
        _result = "";
        _horsePositions = new double[] { 0, 0, 0, 0 };
        _selectedHorse = 0;
    }

    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, Difficulty.Easy);
        _statItems = GameStatsPanel.Build(bucket);
    }

    public void Dispose()
    {
        _timer?.Dispose();
        // BUG FIX (#1): _kioskTimer removed; KioskCoordinator owns it.
    }
}