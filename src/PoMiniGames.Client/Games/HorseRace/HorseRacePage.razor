@page "/horserace"
@page "/pohorserace"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Enums
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@inject PlayerNameService PlayerNameService

<GameShell Title=@TitleContent Player="@_playerName" BackTo="/single-player" GameOver="@_finished" OnPlayAgain="ResetGame" ShowSettings="true" Stats="@_statItems" Controls="@ControlsContent">
    <div class="horse-race-wrapper">
        <div class="race-track">
            @for (int i = 0; i < 4; i++)
            {
                var horse = i;
                <div class="horse-lane">
                    <span class="horse-icon">@GetHorseEmoji(horse)</span>
                    <div class="track">
                        <div class="horse @(horse == _selectedHorse ? "selected" : "")" 
                             style="left: @(_horsePositions[horse])%"
                             @onclick="() => SelectHorse(horse)"></div>
                        <div class="finish-line"></div>
                    </div>
                    <span class="horse-name">Horse @(horse + 1)</span>
                </div>
            }
        </div>
        <div class="race-result">
            @if (_finished)
            {
                <span>@_result</span>
            }
        </div>
    </div>
</GameShell>

@code {
    private string _playerName = "";
    private List<StatItem> _statItems = new();
    private double[] _horsePositions = { 0, 0, 0, 0 };
    private bool _finished;
    private string _result = "";
    private int _selectedHorse;
    private System.Threading.Timer? _timer;

    private RenderFragment ControlsContent => @<div class="gps-controls">
        <button @onclick="StartRace" disabled="@(_timer != null)">🏁 Start Race</button>
        <button @onclick="ResetGame">🔄 Reset</button>
        <span>Selected: Horse @(_selectedHorse + 1)</span>
    </div>;

    private RenderFragment TitleContent => @<span>🐎 Horse Race</span>;

    protected override void OnInitialized()
    {
        _playerName = PlayerNameService.GetPlayerName();
    }

    private void SelectHorse(int horse)
    {
        if (_timer != null) return;
        _selectedHorse = horse;
    }

    private void StartRace()
    {
        if (_timer != null) return;
        _finished = false;
        _result = "";
        _horsePositions = new double[] { 0, 0, 0, 0 };
        
        _timer = new System.Threading.Timer(_ => InvokeAsync(Tick), null, 100, 100);
    }

    private void Tick()
    {
        for (int i = 0; i < 4; i++)
        {
            _horsePositions[i] += Random.Shared.NextDouble() * 3;
            if (_horsePositions[i] >= 100)
            {
                _horsePositions[i] = 100;
            }
        }

        // Check for winner
        for (int i = 0; i < 4; i++)
        {
            if (_horsePositions[i] >= 100)
            {
                _timer?.Dispose();
                _timer = null;
                _finished = true;
                _result = i == _selectedHorse ? "You won!" : $"Horse {i + 1} won!";
                break;
            }
        }
        StateHasChanged();
    }

    private string GetHorseEmoji(int horse)
    {
        return horse switch
        {
            0 => "🐴",
            1 => "🦄",
            2 => "🐎",
            _ => "🦄"
        };
    }

    private void ResetGame()
    {
        _timer?.Dispose();
        _timer = null;
        _finished = false;
        _result = "";
        _horsePositions = new double[] { 0, 0, 0, 0 };
        _selectedHorse = 0;
    }
}
