@page "/pobrawl/online"
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using PoMiniGames.Shared.Games
@using PoMiniGamesClient.Components
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject ApiService Api
@inject ApiEndpoints Endpoints
@inject ToastService ToastService
@implements IAsyncDisposable

<PageTitle>Brawl · Online · PoMiniGames</PageTitle>

<GameShell Title="@TitleContent" BackTo="/">
<div class="sp-page">
    <div class="sp-card pobrawl-online">
        @* Review #7: the hand-rolled "Status: <pill>" paragraph here used classes
           (po-pill) that were defined nowhere, so it rendered as bare text. The
           shared strip speaks the same vocabulary as every lobby. *@
        <ConnectionStateStrip State="@_hub?.State" Pending="@(_hub is null)"
                              Detail="@((_match is null && !_noMatch) ? "waiting for a fight…" : null)" />

        @* Review #4: the header and ring render the SERVER's view of a real fight.
           With no snapshot yet they used to draw a placeholder bout — "Player 1/2",
           100/100 bars, a clock at 0.0s — with the honest empty state arriving only
           further down the card. Placeholder data is not a state; gate the chrome
           on a match and say nothing until there is one to show. *@
        @if (_match is not null)
        {
            <header class="pobrawl-online__header">
                <div class="pobrawl-online__player">
                    <span class="pobrawl-online__name">@LocalName</span>
                    <span class="po-pill po-pill--muted">you</span>
                    <span class="pobrawl-online__hp" style="--hp: @LocalHpPercent%"></span>
                    <span class="pobrawl-online__hp-label">@LocalHp / 100</span>
                </div>
                <div class="pobrawl-online__vs">
                    <span class="pobrawl-online__time">@($"{_elapsed:F1}s")</span>
                    @if (_match is { Finished: true })
                    {
                        <span class="conn-pill @OutcomePillClass">@OutcomeLabel</span>
                    }
                </div>
                <div class="pobrawl-online__player">
                    <span class="pobrawl-online__name">@OpponentName</span>
                    <span class="po-pill po-pill--muted">opponent</span>
                    <span class="pobrawl-online__hp" style="--hp: @OpponentHpPercent%"></span>
                    <span class="pobrawl-online__hp-label">@OpponentHp / 100</span>
                </div>
            </header>

            @* The ring, as the server sees it (2026-09-23). Spacing decides whether a swing
               lands now, so the player has to be able to see it: two markers on a rail, the
               gap in metres, and which attacks reach from here. Numbers come from the shared
               PoBrawlOnlineRules, the same constants the server resolves with. *@
            <section class="pobrawl-online__ring" aria-label="Ring: @Gap.ToString("0.0") metres apart, @RangeLabel">
                <div class="pobrawl-online__rail">
                    <span class="pobrawl-online__reach" style="--from: @ReachFromPct%; --to: @ReachToPct%"></span>
                    <span class="pobrawl-online__marker pobrawl-online__marker--p1 @(LocalSide == PoBrawlSide.Player1 ? "pobrawl-online__marker--you" : "")"
                          style="--x: @XPct(P1X)%" title="@_player1Name"></span>
                    <span class="pobrawl-online__marker pobrawl-online__marker--p2 @(LocalSide == PoBrawlSide.Player2 ? "pobrawl-online__marker--you" : "")"
                          style="--x: @XPct(P2X)%" title="@_player2Name"></span>
                </div>
                <p class="pobrawl-online__gap">
                    <span>@Gap.ToString("0.0") m apart</span>
                    <span class="conn-pill @(InKickRange ? "conn-pill--ok" : "conn-pill--muted")">@RangeLabel</span>
                </p>
            </section>
        }
        else if (!_noMatch)
        {
            <p class="pobrawl-online__waiting" role="status">Waiting for a fight to start…</p>
        }

        @if (_noMatch)
        {
            @* JoinMatch answered null: the fight this page was sent to has already ended, or
               nobody started one (a stale tab, a refresh after the bell). *@
            <section class="pobrawl-online__result">
                <h2>No fight running</h2>
                <p>This match has already ended. Head back to the lobby to start a new one.</p>
                <div class="pobrawl-online__actions">
                    <button class="sp-btn-primary" @onclick="RematchAsync">Back to the lobby</button>
                </div>
            </section>
        }
        else if (_match is { Finished: true })
        {
            <section class="pobrawl-online__result">
                <h2>@OutcomeHeadline</h2>
                <p>@OutcomeDetail</p>
                <div class="pobrawl-online__actions">
                    @* A rematch is a fresh lobby round: the match is gone the moment it ends
                       (PoBrawlMatchPump clears it), and both seats have to ready up again. *@
                    <button class="sp-btn-primary" @onclick="RematchAsync">Rematch</button>
                    <button class="sp-btn-secondary" @onclick="LeaveAsync">Leave</button>
                </div>
                <p class="pobrawl-online__hint">Rematch takes you both back to the lobby to ready up.</p>
            </section>
        }
        else if (_lastEvent is not "")
        {
            <p class="pobrawl-online__event">@EventLabel</p>
        }

        @if (_match is not null)
        {
            <section class="pobrawl-online__controls">
                <p class="poracer-hint">
                    <kbd>A</kbd>/<kbd>D</kbd> walk (hold) · <kbd>S</kbd> block (hold) ·
                    <kbd>F</kbd> punch · <kbd>G</kbd> kick · <kbd>H</kbd> special (full energy)
                </p>
                <p class="pobrawl-online__energy">Energy: @LocalEnergy / 100 · punches land inside @PoBrawlOnlineRules.PunchReach.ToString("0.0") m, kicks inside @PoBrawlOnlineRules.KickReach.ToString("0.00") m</p>
            </section>
        }
    </div>

    @* Review #4: online was the one PoBrawl surface with no touch controls — the
       fight was unreachable on a phone. These ride the SAME two input kinds the
       hub takes and the same .NET entry points the key bridge calls
       (OnOnlineHeldAsync resolves screen direction from the local side; attacks
       are buffered presses), so the keyboard and the pad cannot drift apart.
       Hidden on pointer devices by the same query the engine's virtual pad uses. *@
    @if (_match is { Finished: false })
    {
        <div class="pobrawl-online__touch" role="group" aria-label="Fight controls">
            <div class="pobrawl-online__touch-cluster">
                <button type="button" class="pobrawl-online__touch-btn" aria-label="Back away"
                        @onpointerdown='@(() => HoldAsync("left"))'
                        @onpointerup="ReleaseAsync" @onpointerleave="ReleaseAsync" @onpointercancel="ReleaseAsync">↩</button>
                <button type="button" class="pobrawl-online__touch-btn" aria-label="Step in"
                        @onpointerdown='@(() => HoldAsync("right"))'
                        @onpointerup="ReleaseAsync" @onpointerleave="ReleaseAsync" @onpointercancel="ReleaseAsync">↪</button>
                <button type="button" class="pobrawl-online__touch-btn" aria-label="Guard"
                        @onpointerdown='@(() => HoldAsync("block"))'
                        @onpointerup="ReleaseAsync" @onpointerleave="ReleaseAsync" @onpointercancel="ReleaseAsync">🛡</button>
            </div>
            <div class="pobrawl-online__touch-cluster">
                <button type="button" class="pobrawl-online__touch-btn" aria-label="Punch"
                        @onclick='@(() => AttackAsync("f"))'>👊</button>
                <button type="button" class="pobrawl-online__touch-btn" aria-label="Kick"
                        @onclick='@(() => AttackAsync("g"))'>🦵</button>
                <button type="button" class="pobrawl-online__touch-btn" aria-label="Special (needs full energy)"
                        @onclick='@(() => AttackAsync("h"))'>⚡</button>
            </div>
        </div>
    }
</div>
</GameShell>

@code {
    private HubConnection? _hub;
    private IDisposable? _stateSub;
    private IDisposable? _finishedSub;
    private PoBrawlMatchSnapshot? _snapshot;
    private PoBrawlMatchState? _match;
    private PoBrawlMatchResult? _result;
    private string _player1Name = "Player 1";
    private string _player2Name = "Player 2";
    private double _elapsed;
    private string _lastEvent = "";
    private long _sequence;
    private bool _noMatch;

    private DotNetObjectReference<PoBrawlOnlinePage>? _selfRef;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private RenderFragment TitleContent => @<span><span aria-hidden="true">🥊</span> Brawl · Online</span>;

    // The match hub pins each connection to a side at JoinMatch. LocalName/OpponentName
    // resolve from the snapshot so the UI never has to know the lobby roster order.
    private PoBrawlSide LocalSide => _snapshot?.LocalSide ?? PoBrawlSide.Player1;
    private string LocalName => LocalSide == PoBrawlSide.Player1 ? _player1Name : _player2Name;
    private string OpponentName => LocalSide == PoBrawlSide.Player1 ? _player2Name : _player1Name;

    private int LocalHp => LocalSide == PoBrawlSide.Player1 ? (_match?.Player1Hp ?? 100) : (_match?.Player2Hp ?? 100);
    private int OpponentHp => LocalSide == PoBrawlSide.Player1 ? (_match?.Player2Hp ?? 100) : (_match?.Player1Hp ?? 100);
    private int LocalEnergy => LocalSide == PoBrawlSide.Player1 ? (_match?.Player1Energy ?? 0) : (_match?.Player2Energy ?? 0);
    private int LocalHpPercent => Math.Clamp(LocalHp, 0, 100);

    // ── Ring geometry (server-authoritative; see PoBrawlMatchService) ──
    private double P1X => _match?.Player1X ?? -1.6;
    private double P2X => _match?.Player2X ?? 1.6;
    private double Gap => Math.Max(0, P2X - P1X);
    private bool InKickRange => Gap <= PoBrawlOnlineRules.KickReach;
    private string RangeLabel => Gap <= PoBrawlOnlineRules.PunchReach ? "punch & kick range"
        : Gap <= PoBrawlOnlineRules.KickReach ? "kick range"
        : "out of range";
    // Invariant on purpose: these land in a CSS custom property, and WASM formats doubles in
    // the BROWSER's culture — a German browser would write "34,62%" and the marker would vanish.
    private static string XPct(double x) =>
        (Math.Clamp((x + PoBrawlOnlineRules.RingHalf) / (2 * PoBrawlOnlineRules.RingHalf), 0, 1) * 100)
            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    // The local fighter's kick reach, drawn as a band on the rail toward the opponent.
    private string ReachFromPct => LocalSide == PoBrawlSide.Player1 ? XPct(P1X) : XPct(P2X - PoBrawlOnlineRules.KickReach);
    private string ReachToPct => LocalSide == PoBrawlSide.Player1 ? XPct(P1X + PoBrawlOnlineRules.KickReach) : XPct(P2X);
    private int OpponentHpPercent => Math.Clamp(OpponentHp, 0, 100);

    private string OutcomeLabel => _result?.Outcome switch
    {
        PoBrawlOutcome.Win => "Win",
        PoBrawlOutcome.Loss => "Loss",
        _ => "Draw",
    };
    private string OutcomePillClass => _result?.Outcome switch
    {
        PoBrawlOutcome.Win => "conn-pill--ok",
        PoBrawlOutcome.Loss => "conn-pill--warn",
        _ => "conn-pill--muted",
    };
    private string OutcomeHeadline => _result?.Outcome switch
    {
        PoBrawlOutcome.Win => "You won!",
        PoBrawlOutcome.Loss => "You lost.",
        _ => "Time's up — draw.",
    };
    private string OutcomeDetail
    {
        get
        {
            if (_result is null) return "";
            return _result.Outcome == PoBrawlOutcome.Draw
                ? $"Both fighters survived to the buzzer. {_result.Player1Hp}-{_result.Player2Hp} on HP."
                : $"{LocalName} finished {_result.Player1Hp}-{_result.Player2Hp} on HP.";
        }
    }
    private string EventLabel => _lastEvent switch
    {
        "p1-hit" or "p2-hit" => "Hit!",
        "p1-blocked" or "p2-blocked" => "Blocked!",
        "p1-whiff" or "p2-whiff" => "Swing and a miss — too far away.",
        "p1-special" or "p2-special" => "Special landed!",
        "ko" => "Knockout!",
        "time-up" => "Time's up.",
        "time-up-draw" => "Draw — time ran out.",
        _ => "",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Window-level key bridge — the canonical PoFunQuiz pattern. Razor can't
        // subscribe to global keyboard events directly, so we register a tiny
        // JS module that calls OnOnlineInputAsync on every relevant press.
        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeAsync<IJSObjectReference>("import", "./js/pobrawlOnlineInput.js");
        await JS.InvokeVoidAsync("pobrawlOnlineInput.register", _selfRef);

        _hub = HubConnectionFactory.Create(Endpoints.Hub("pobrawl/match-hub"));

        _stateSub = _hub.On<PoBrawlMatchState>("matchState", s =>
        {
            _match = s;
            _elapsed = s.ElapsedSeconds;
            _lastEvent = s.LastEvent;
            Console.WriteLine($"[PoBrawlOnline] matchState p1hp={s.Player1Hp} p2hp={s.Player2Hp} elapsed={s.ElapsedSeconds:F1}");
            InvokeAsync(StateHasChanged);
        });

        _finishedSub = _hub.On<PoBrawlMatchResult>("matchFinished", async r =>
        {
            _result = r;
            _match = new PoBrawlMatchState
            {
                MatchId = r.MatchId,
                ElapsedSeconds = r.DurationSeconds,
                Player1Hp = r.Player1Hp,
                Player2Hp = r.Player2Hp,
                // The result carries no positions; keep the last snapshot's so the ring
                // strip does not snap both corners back to their marks at the bell.
                Player1X = _match?.Player1X ?? -1.6,
                Player2X = _match?.Player2X ?? 1.6,
                Finished = true,
                Winner = r.Outcome switch
                {
                    PoBrawlOutcome.Win => r.LocalSide,
                    PoBrawlOutcome.Loss => r.LocalSide == PoBrawlSide.Player1 ? PoBrawlSide.Player2 : PoBrawlSide.Player1,
                    _ => null,
                },
            };
            await SubmitResultAsync(r);
            await InvokeAsync(StateHasChanged);
        });

        await _hub.StartAsync();
        _snapshot = await _hub.InvokeAsync<PoBrawlMatchSnapshot?>("JoinMatch", "BRAWL");
        _noMatch = _snapshot is null;
        if (_noMatch) StateHasChanged();
        if (_snapshot is not null)
        {
            _player1Name = _snapshot.Player1.DisplayName;
            _player2Name = _snapshot.Player2.DisplayName;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Invoked from <c>pobrawlOnlineInput.js</c> on every attack key-down (F / G / H). Attacks
    /// are presses: the server buffers one and fires it when this corner's cooldown allows.
    /// Walking and guarding are held states and arrive through <see cref="OnOnlineHeldAsync"/>
    /// on key-down AND key-up — the server keeps the held state until it is told otherwise.
    /// </summary>
    [JSInvokable]
    public async Task OnOnlineInputAsync(string key)
    {
        // Presses only — walking and guarding arrive through OnOnlineHeldAsync.
        var action = key switch
        {
            "f" => PoBrawlMatchAction.Punch,
            "g" => PoBrawlMatchAction.Kick,
            "h" => PoBrawlMatchAction.Special,
            _ => (PoBrawlMatchAction?)null,
        };
        if (action is null) return;
        await SendInputAsync(action.Value);
    }

    /// <summary>
    /// Invoked from <c>pobrawlOnlineInput.js</c> on every key-down and key-up of the HELD keys
    /// (walk / guard) with the resulting state. Screen-relative: 'right' walks the left corner
    /// in and the right corner out, so the keys match what the ring strip shows.
    /// </summary>
    [JSInvokable]
    public async Task OnOnlineHeldAsync(string state)
    {
        var towardRight = LocalSide == PoBrawlSide.Player1;
        var action = state switch
        {
            "block" => PoBrawlMatchAction.Block,
            "right" => towardRight ? PoBrawlMatchAction.MoveForward : PoBrawlMatchAction.MoveBack,
            "left" => towardRight ? PoBrawlMatchAction.MoveBack : PoBrawlMatchAction.MoveForward,
            _ => PoBrawlMatchAction.Idle,
        };
        await SendInputAsync(action);
    }

    private async Task SendInputAsync(PoBrawlMatchAction action)
    {
        if (_hub is null || _match is { Finished: true }) return;
        _sequence++;
        try
        {
            await _hub.InvokeAsync("SubmitInput", new PoBrawlMatchInput
            {
                ActorSide = LocalSide,
                Action = action,
                Sequence = _sequence,
            });
        }
        catch
        {
            // Hub dropped mid-fight — leave the result handler to report loss.
        }
    }

    // ── Touch controls (review #4) ─────────────────────────────────────
    // Deliberately thin wrappers over the key bridge's entry points: one input
    // vocabulary, two transports. HoldAsync/ReleaseAsync carry the HELD states
    // (walk / guard); AttackAsync carries the buffered presses.
    private Task HoldAsync(string state) => OnOnlineHeldAsync(state);

    private Task ReleaseAsync() => SendInputAsync(PoBrawlMatchAction.Idle);

    private Task AttackAsync(string key) => OnOnlineInputAsync(key);

    private static PoMiniGames.Domain.Primitives.PoBrawlFighter Fighter(PoBrawlMatchPlayerInfo? info)
    {
        var bob = PoMiniGames.Domain.Primitives.PoBrawlRoster.Bob;
        var id = info?.FighterId;
        return string.IsNullOrWhiteSpace(id) || string.Equals(id, bob.Id, StringComparison.OrdinalIgnoreCase)
            ? bob
            : new(id, PoMiniGames.Domain.Primitives.PoBrawlRoster.DisplayName(id));
    }

    private async Task SubmitResultAsync(PoBrawlMatchResult r)
    {
        var dto = new PoBrawlMatchResultDto
        {
            MatchId = r.MatchId,
            OwnerId = AuthState.User?.UserId ?? "",
            OwnerDisplayName = AuthState.User?.DisplayName ?? "Player",
            OpponentId = r.OpponentId,
            OpponentDisplayName = r.OpponentDisplayName,
            // The picks, from the join snapshot. These were sent empty, which the ingest
            // rejects — invisible until 2026-09-23, because matchFinished never arrived.
            OwnerFighter = Fighter(r.LocalSide == PoBrawlSide.Player1 ? _snapshot?.Player1 : _snapshot?.Player2),
            OpponentFighter = Fighter(r.LocalSide == PoBrawlSide.Player1 ? _snapshot?.Player2 : _snapshot?.Player1),
            Outcome = r.Outcome,
            DurationSeconds = r.DurationSeconds,
        };
        var board = await Api.SubmitPoBrawlOnlineMatchAsync(dto);
        if (board is null)
        {
            ToastService.Show("Couldn't record the match — Elo didn't update.", ToastType.Warning);
        }
    }

    private async Task RematchAsync()
    {
        if (_hub is not null)
        {
            try { await _hub.InvokeAsync("LeaveMatch"); } catch { }
        }
        Nav.NavigateTo("/pobrawl/multi");
    }

    private async Task LeaveAsync()
    {
        if (_hub is not null)
        {
            try { await _hub.InvokeAsync("LeaveMatch"); } catch { }
        }
        Nav.NavigateTo("/");
    }

    public async ValueTask DisposeAsync()
    {
        _stateSub?.Dispose();
        _finishedSub?.Dispose();
        if (_hub is not null)
        {
            try { await _hub.DisposeAsync(); } catch { }
        }
        try { await JS.InvokeVoidAsync("pobrawlOnlineInput.unregister"); } catch { }
        _selfRef?.Dispose();
    }
}
