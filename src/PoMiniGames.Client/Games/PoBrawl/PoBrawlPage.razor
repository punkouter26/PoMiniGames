@page "/pobrawl"
@page "/pobrawl/{Mode}"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Enums
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@* Aliases, not namespace imports: PoMiniGamesClient.Models mirrors several Domain types by
   name (PlayerStats, GameOutcome), so importing either namespace wholesale makes them all
   ambiguous. Same convention as ApiService.cs. *@
@using PoBrawlFighter = PoMiniGames.Domain.Primitives.PoBrawlFighter
@using PoBrawlRoster = PoMiniGames.Domain.Primitives.PoBrawlRoster
@using PoBrawlFighterRating = PoMiniGames.Domain.Models.PoBrawlFighterRating
@implements IAsyncDisposable
@inject PlayerNameService PlayerNameService
@inject ApiService ApiService
@inject GameResultService GameResults
@inject IJSRuntime JSRuntime
@inject KioskCoordinator Kiosk
@inject SettingsService Settings
@inject AuthStateService Auth

<PageTitle>Brawl · PoMiniGames</PageTitle>

<GameShell Title=@TitleContent
           Player="@_playerName"
           Elo="@(_mode == "1p" ? _rating.Elo : (int?)null)"
           BackTo="/"
           Stats="@_statItems"
           GameOver="@(_phase == "result" && !_demo)"
           GameKey="@(_mode == "1p" ? "pobrawl" : null)"
           Outcome="@OutcomeForCue"
           RequiresWebGl="true"
           GameSummary="@GameSummaryContent">
    @if (!_introDone)
    {
        <GameIntro CueScope="pobrawl"
                   Title="@TitleContent"
                   Objective="@IntroObjective"
                   Controls="@HowToPlayContent"
                   Mode="@_introMode"
                   Options="@IntroOptions"
                   StartEnabled="@(_mode != "2p" || _twoPlayerReady)"
                   StartLabel="@(_mode == "2p" ? "FIGHT" : "OK")"
                   StartHint="@(_mode == "2p" ? "Both players lock in to fight" : null)"
                   CaptureKeys="@(_mode == "2p")"
                   OnKey="OnIntroKey"
                   OnStart="OnIntroStartAsync" />
    }
    <div class="pb-wrap">
        @* Labelled host — see the note on PoSports (browser audit #6): the engine
           appends its <canvas> here, so this is the only node this component can
           attach an accessible name to. *@
        <div id="pobrawl-container" class="pb-canvas-host"
             role="img" aria-label="Brawl arena — the fight renders here"></div>

        @* HP bar HUD, fed by the JS engine's OnHud callback *@
        @if (_phase == "fighting" || _demo)
        {
            <div class="pb-hud">
                <div class="pb-hp-side">
                    <span class="pb-hp-name">@CharName(_p1Char)</span>
                    <div class="pb-hp-track"><div class="pb-hp-fill pb-hp-p1" style="--hp: @(_p1Hp)%;"></div></div>
                    <div class="pb-en-track" title="Energy — attack power"><div class="pb-en-fill @(_p1Energy > 50 ? "pb-en-hot" : "")" style="--en: @(_p1Energy)%;"></div></div>
                    @SuperBar(_p1Super, _p1SuperReady, "E", 1)
                </div>
                @BodyDiagram(_p1Regions)
                <div class="pb-centre">
                    <div class="pb-clock">@_elapsed.ToString("0")</div>
                    @* Best-of-three scoreboard. 2-player only: the 1P ladder is a
                       single-elimination gauntlet and demo never replays a pairing. *@
                    @if (_mode == "2p")
                    {
                        <div class="pb-rounds" role="img"
                             aria-label="Round @_round of @MaxRounds. Rounds won: player 1 @_p1Rounds, player 2 @_p2Rounds.">
                            <span class="pb-rounds-pips">@RoundPips(_p1Rounds)</span>
                            <span class="pb-rounds-label">R@_round</span>
                            <span class="pb-rounds-pips">@RoundPips(_p2Rounds)</span>
                        </div>
                    }
                </div>
                @BodyDiagram(_p2Regions)
                <div class="pb-hp-side pb-hp-right">
                    <span class="pb-hp-name">@CharName(_p2Char)</span>
                    <div class="pb-hp-track"><div class="pb-hp-fill pb-hp-p2" style="--hp: @(_p2Hp)%;"></div></div>
                    <div class="pb-en-track" title="Energy — attack power"><div class="pb-en-fill @(_p2Energy > 50 ? "pb-en-hot" : "")" style="--en: @(_p2Energy)%;"></div></div>
                    @SuperBar(_p2Super, _p2SuperReady, "O", 2)
                </div>
            </div>

            @* 1-player ladder rail. The rung is persisted in localStorage and was
               otherwise invisible until the end-of-run modal, so a player mid-gauntlet
               had no way to see how far through the fifteen presidents they were —
               the pre-fight ladder card that used to carry it was removed in 2026-07.
               Rendered outside .pb-hud so it can sit under the bars without competing
               with them for the same flex row. *@
            @if (_mode == "1p")
            {
                <div class="pb-ladder" role="img"
                     aria-label="Ladder progress: @_ladder of @Roster.Length presidents beaten. Now fighting @CharName(_p2Char).">
                    <span class="pb-ladder-count">@_ladder/@Roster.Length</span>
                    <span class="pb-ladder-rail">
                        @for (var i = 0; i < Roster.Length; i++)
                        {
                            <span class="pb-rung @(i < _ladder ? "pb-rung--done" : i == _ladder ? "pb-rung--now" : "")"
                                  title="@Roster[i].Name"></span>
                        }
                    </span>
                    <span class="pb-ladder-now">@CharName(_p2Char)</span>
                </div>
            }
        }

        @if (_demo)
        {
            <div class="pb-demo-badge">🎮 Demo — CPU vs CPU</div>
        }
        @* 2026-07-16: the pre-fight overlay (presidential ladder card in 1P,
           fighter picker in 2P, both gated behind a "FIGHT" button) was removed.
           It sat between the home page and the game and configured what the page
           can decide itself: 1P always fights the player's current ladder rung,
           and 2P now gets two random fighters the way demo mode already did.
           The "Fastest KO" / "Ladder Legends" boards it hosted are superseded by
           the top 3 in the shared end-of-game modal. *@
    </div>

    @* Fighter Elo board. Demo mode is the only thing that feeds it, so it lives here
       rather than in the end-of-game modal (which demo never shows). Ratings are
       head-to-head between presidents — both CPUs fight at the same difficulty, so this
       measures roster balance, not anyone's skill.

       Deliberately a SIBLING of .pb-wrap, not a child. .pb-wrap is the positioning
       context for .pb-demo-badge (`position: absolute; bottom: 10px`), so a board nested
       inside it grows the wrap and drops the badge on top of the table — which is exactly
       what happened the first time. Keeping the board outside leaves the arena as the
       badge's anchor. *@
    @if (_demo)
    {
        @* @-prefixed: Player1Id/Player2Id are string parameters, and Razor passes a quoted
           value to a string parameter as a literal — "_p1Char" would reach the board as
           that text and the "fighting now" highlight would silently never match. *@
        <PoBrawlEloBoard Ratings="@_fighterRatings" Player1Id="@_p1Char" Player2Id="@_p2Char" />
    }
</GameShell>

@code {
    /// <summary>Route mode segment. Parsed by <see cref="GameModes.Parse"/>, which
    /// owns every accepted spelling and legacy form — see GameMode.cs.</summary>
    [Parameter] public string? Mode { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "demo")] public int DemoQuery { get; set; }

    // 1-player ladder: PoBrawlRoster.Fighters in ladder order — most recent president first,
    // marching back in time to FDR. Rung index doubles as the CPU difficulty level (index + 1
    // → 1-15, the full range ai.js LEVELS/MAX_RUNG defines); the ladder walks every fighter.
    //
    // Projected from the Domain roster rather than restated here. The same fifteen names used
    // to live in this file AND in PoBrawlRoster, so a rename could leave the HUD and the Elo
    // board labelling the same fighter two different ways on one screen. fighters.js
    // CHARACTERS is now the only copy left to keep in step by hand.
    private static readonly PoBrawlFighter[] Roster = [.. PoBrawlRoster.Fighters];

    private static readonly PoBrawlFighter Bob = PoBrawlRoster.Bob;

    // 2-player select can pick anyone, BOB included — he is deliberately not on the rateable
    // roster (see PoBrawlRoster), which is why he is prepended rather than sorted in.
    private static readonly PoBrawlFighter[] PickableRoster = [Bob, .. Roster];

    // Fixed rating per ladder rung for the ELO math: rung 1 (Trump) is a
    // pushover at 800; rung 15 (FDR) tops out near 2660. Beating an easy rung
    // when your rating is high earns almost nothing; losing to it costs a lot.
    private static int PresidentElo(int rung) => 800 + rung * 133;

    private string _playerName = "";
    private bool _demo;
    private string _mode = "1p";

    // Outcome for the end-of-game cue. _winner is 1 for the local player and 2
    // for the opponent; only the 1P ladder has a "you" to win, so 2-player and
    // demo stay Unknown (see GameOverModal.Outcome).
    private GameOutcome OutcomeForCue => _mode != "1p"
        ? GameOutcome.Unknown
        : _winner == 1 ? GameOutcome.Win
        : _winner == 2 ? GameOutcome.Loss
        : GameOutcome.Unknown;


    // ── Intro/welcome gate ──
    // The fight does not start until the intro card is dismissed: OK in 1P, a 2s
    // flash in demo, and in 2P once both players lock in their fighter with their
    // own keyboard halves (P1: A/D + F, P2: ←/→ + K — mirroring the in-game keys).
    private bool _introDone;
    private int _p1Sel;       // cursor into PickableRoster for player 1
    private int _p2Sel = 1;   // player 2 starts one down so they don't overlap P1
    private bool _p1Locked;
    private bool _p2Locked;
    private bool _twoPlayerReady => _p1Locked && _p2Locked;
    private GameIntro.IntroMode _introMode => _demo
        ? GameIntro.IntroMode.Demo
        : _mode == "2p" ? GameIntro.IntroMode.TwoPlayer : GameIntro.IntroMode.OnePlayer;
    private string IntroObjective => _mode == "2p"
        ? "Two fighters enter — knock out your opponent. Each player picks below."
        : "Knock out your opponent before they knock out you. Charge attacks, block on their wind-up.";
    // "fighting" | "result". There is no longer a "select" phase — every route
    // drops straight into the fight (see OnInitialized).
    private string _phase = "fighting";
    private string _p1Char = "trump";
    private string _p2Char = "biden";
    private int _p1Hp = 100;
    private int _p2Hp = 100;
    // Energy meters (0-100) fed by the JS engine — starts at the 1/3 bank
    // (game.js ENERGY_DEFAULT); only winding up or attacking moves it.
    private int _p1Energy = 33;
    private int _p2Energy = 33;
    // Super meters + armed flags, fed by the same OnHud pump. The engine has
    // always sent these; nothing rendered them until now, and because the engine
    // was reading a dead field they were always zero anyway — see the
    // superMeterFull note in game.js.
    //
    // Seeded to -1 ("this fighter has no super"), not 0, so no bar is drawn in
    // the window between the HUD appearing and the engine's first pump. 0 would
    // flash an empty meter for BOB, who never gets one.
    private int _p1Super = -1;
    private int _p2Super = -1;
    private bool _p1SuperReady;
    private bool _p2SuperReady;
    private double _elapsed;
    private int _winner;
    private double _lastKo;
    private double _bestKo;
    private bool _newRecord;
    private bool _muted;

    // Per-region damage (0-100) fed by the JS engine: [head, torso, arms, legs].
    private int[] _p1Regions = new int[4];
    private int[] _p2Regions = new int[4];
    private List<StatItem> _statItems = new();
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    private DotNetObjectReference<PoBrawlPage>? _ref;

    // ── 1P presidents ladder + adaptive ELO (same system as ConnectFive) ──
    private int _ladder;                 // 0-based rung; Roster[_ladder] is the opponent
    private bool _champion;              // set for one select-screen after clearing rung 10
    private AdaptiveRating _rating = new();
    private int _lastEloDelta;
    private string LadderKey => $"pobrawl_ladder_{_playerName}";

    // ── 2-player best-of-three ────────────────────────────────────────────
    // The marquee local-multiplayer mode used to end on a single KO, which makes
    // a fighter's whole personality (comeback supers, HP-gated triggers) a coin
    // flip nobody sees twice. Rounds are driven entirely from here: the engine
    // just replays a match via PoBrawl.next, the same call the 1P ladder uses.
    private const int RoundsToWin = 2;
    private const int MaxRounds = 3;
    private int _round = 1;
    private int _p1Rounds;
    private int _p2Rounds;

    // ── Fight recap ───────────────────────────────────────────────────────
    // Accumulated across every round of the match (a 2P best-of-three) and every
    // rung of a 1P run, because the modal is only shown once at the end of both.
    // Null until the first OnMatchEnd carries a payload.
    private PoBrawlMatchRecap? _recap;

    /// <summary>
    /// Per-round scorecard reported by the engine alongside the result.
    /// </summary>
    /// <remarks>
    /// Bound from the JS object literal in <c>game.js _reportResult</c> — Blazor's interop
    /// serializer is camelCase, so <c>p1Hits</c> lands on <see cref="P1Hits"/>. Passing this
    /// as an object rather than eight more positional arguments is deliberate: interop fails
    /// silently on an arity mismatch (see the remarks on <see cref="OnHud"/>), whereas an
    /// unknown JSON property is simply ignored.
    /// </remarks>
    public sealed record PoBrawlMatchRecap(
        int P1Hits, int P2Hits,
        int P1Blocks, int P2Blocks,
        int P1BestCombo, int P2BestCombo,
        int P1BiggestHit, int P2BiggestHit);

    // Totals for counts, best-of for peaks — a "biggest hit" summed across rounds
    // would be a number that never happened.
    private static PoBrawlMatchRecap Accumulate(PoBrawlMatchRecap? a, PoBrawlMatchRecap b) =>
        a is null ? b : new PoBrawlMatchRecap(
            a.P1Hits + b.P1Hits, a.P2Hits + b.P2Hits,
            a.P1Blocks + b.P1Blocks, a.P2Blocks + b.P2Blocks,
            Math.Max(a.P1BestCombo, b.P1BestCombo), Math.Max(a.P2BestCombo, b.P2BestCombo),
            Math.Max(a.P1BiggestHit, b.P1BiggestHit), Math.Max(a.P2BiggestHit, b.P2BiggestHit));

    // ── Fighter Elo board ─────────────────────────────────────────────────
    // Demo mode is still the only thing that FEEDS this board (CPU-vs-CPU matches are
    // the only fair sample of roster balance), but every mode now READS it: demo shows
    // it live under the arena, 1P and 2P show it in the end-of-game modal. It was
    // demo-only before, which meant the head-to-head data was invisible to the players
    // choosing fighters — the one audience it is useful to.
    //
    // Null until the first fetch resolves, so the board can tell "still loading" from
    // "genuinely empty" — the two look identical if you seed with an empty array. Replaced
    // wholesale on every refresh, never mutated: PoBrawlEloBoard.ShouldRender compares by
    // reference, so an in-place edit would not repaint.
    private PoBrawlFighterRating[]? _fighterRatings;

    private RenderFragment TitleContent => @<span><span aria-hidden="true">🥊</span> Brawl</span>;

    private RenderFragment HowToPlayContent => @<div>
        <p>Knock out your opponent — charge attacks and block at the right moment.</p>
        <ul>
            <li><kbd>A</kbd>/<kbd>D</kbd> move · <kbd>W</kbd> step in · tap <kbd>S</kbd> sidestep</li>
            <li><b>Hold</b> <kbd>S</kbd> to block — blocked hits charge your ⚡ energy</li>
            <li><kbd>F</kbd> punch · <kbd>G</kbd> kick — <b>hold</b> to charge, release to strike</li>
            <li>Energy is your power: spend it all on one big hit (watch the bar under your health)</li>
            @* The super key was undocumented for the whole life of the feature — and
               unreachable besides (see input.js). Both are fixed; this is the line that
               tells the player the mechanic exists at all.

               Only shown where it is TRUE. Signature supers belong to the presidents;
               BOB is the generic avatar and has none by design, so 1P names the key
               nowhere and draws you no super bar. What the president across the ring
               can do to you is covered instead by the scouting card (ScoutingContent),
               which is the 1P player's side of this mechanic. *@
            @if (_mode == "2p")
            {
                <li><kbd>E</kbd> <b>SUPER</b> — the purple bar fills as you <em>take</em> damage.
                    Full means your president's signature move is armed. (BOB has none.)</li>
            }
            <li>Watch for the coil wind-up — that's your cue to block!</li>
        </ul>
        @if (_mode == "2p")
        {
            <p>Player 2: <kbd>←</kbd>/<kbd>→</kbd> move · <kbd>↑</kbd> step in · <kbd>↓</kbd> block ·
                <kbd>K</kbd> punch · <kbd>L</kbd> kick · <kbd>O</kbd> super. Best of @MaxRounds.</p>
        }
    </div>;

    // ── Super meter bar ───────────────────────────────────────────────────
    // Third bar under health and energy. The fill is not the interesting part —
    // the armed prompt is: the meter fills by TAKING damage, so a player who is
    // losing needs to be told, at the moment it happens, that they now hold a
    // comeback move. The prompt is suppressed for CPU-driven sides (both fighters
    // in demo, P2 in 1P) because naming a key nobody can press there is a lie.
    //
    // A NEGATIVE value means the fighter has no signature super at all — see the
    // -1 contract in game.js _pushHud, which is distinct from an empty meter.
    //
    // Only the presidents have one. BOB is the generic avatar they are
    // characterised against and has no signature move BY DESIGN, so in 1P no
    // bar is drawn on the left at all and the E key is named nowhere. That is
    // the intended end state, not a placeholder: an always-empty meter beside a
    // documented key that does nothing is the same class of mistake this
    // feature exists to undo.
    @* The wrapper carries width:100% deliberately: .pb-hp-right sets
       align-items:flex-end, which shrink-wraps any child that does not claim a
       width — the track inside would then be 100% of nothing. *@
    private RenderFragment SuperBar(int value, bool ready, string key, int side) => @<div class="pb-su">
        @if (value >= 0)
        {
            <div class="pb-su-track" title="Super — fills as you take damage">
                <div class="pb-su-fill @(ready ? "pb-su-fill--ready" : "")" style="--su: @(value)%;"></div>
            </div>
            @if (ready && IsHumanSide(side))
            {
                <span class="pb-su-prompt" role="status">⚡ PRESS <kbd>@key</kbd></span>
            }
        }
    </div>;

    /// <summary>True when <paramref name="side"/> (1 or 2) is driven by a person at this keyboard.</summary>
    private bool IsHumanSide(int side) => _mode switch
    {
        "2p" => true,
        "1p" => side == 1,
        _ => false,   // demo is CPU vs CPU
    };

    // Filled pip per round won, hollow for the rest. Rendered as text rather than
    // elements so it stays on one line inside the narrow centre column.
    private static string RoundPips(int won) => new string('●', won) + new string('○', Math.Max(0, RoundsToWin - won));

    // 2P gets the character select; 1P gets the scouting report on the president it
    // is about to fight. Demo gets neither — nobody is reading it.
    private RenderFragment? IntroOptions => _mode switch
    {
        "2p" => SelectContent,
        "1p" => ScoutingContent,
        _ => null,
    };

    // ── "Know your opponent" scouting card ────────────────────────────────
    // personalities.js is 18 KB of per-president behaviour that the player could
    // previously only learn by dying to it. This surfaces the two things that
    // actually change how you play the rung: what their super does, and the tell.
    // Copy comes from PoBrawlDossier — see the note there on why it is prose and
    // not a mirror of the engine's numbers.
    private RenderFragment ScoutingContent => @<div class="pb-scout">
        <div class="pb-scout-head">
            <span class="pb-scout-rung">Rung @(_ladder + 1) of @Roster.Length</span>
            <span class="pb-scout-name">@CharName(_p2Char)</span>
        </div>
        @if (PoBrawlDossier.For(_p2Char) is { } dossier)
        {
            <dl class="pb-scout-list">
                <dt><span aria-hidden="true">⚡</span> Signature</dt>
                <dd><b>@dossier.SuperName</b> — @dossier.SuperEffect</dd>
                <dt><span aria-hidden="true">👁</span> Watch for</dt>
                <dd>@dossier.Tell</dd>
            </dl>
        }
    </div>;

    // The legacy in-canvas Controls fragment was unreachable (the Settings
    // drawer was removed 2026-07-06) and is intentionally gone. Mute toggle +
    // character select are reachable via Play Again ("REMATCH") / Next Match
    // on the unified end-of-game modal; mute is a JS `keydown` on `M`.

    // Two-player fighter select shown in the intro's Options slot. Each player
    // drives their own column with their in-game keys (see OnIntroKey); locking
    // in both sides enables (and auto-fires) the fight.
    private RenderFragment SelectContent => @<div class="gps-intro-versus">
        <div>
            <div class="gps-intro-side-title">Player 1</div>
            <div class="gps-intro-side-keys">A / D move · F lock in</div>
            <ul class="gps-intro-roster">
                @for (int i = 0; i < PickableRoster.Length; i++)
                {
                    var idx = i;
                    <li class="gps-intro-roster-item @(idx == _p1Sel ? "gps-intro-roster-item--cursor" : "") @(_p1Locked && idx == _p1Sel ? "gps-intro-roster-item--locked" : "")">
                        @PickableRoster[idx].Name
                    </li>
                }
            </ul>
            <div class="gps-intro-ready">@(_p1Locked ? "✓ Ready" : "")</div>
        </div>
        <div class="gps-intro-vs-divider">VS</div>
        <div>
            <div class="gps-intro-side-title">Player 2</div>
            <div class="gps-intro-side-keys">← / → move · K lock in</div>
            <ul class="gps-intro-roster">
                @for (int i = 0; i < PickableRoster.Length; i++)
                {
                    var idx = i;
                    <li class="gps-intro-roster-item @(idx == _p2Sel ? "gps-intro-roster-item--cursor" : "") @(_p2Locked && idx == _p2Sel ? "gps-intro-roster-item--locked" : "")">
                        @PickableRoster[idx].Name
                    </li>
                }
            </ul>
            <div class="gps-intro-ready">@(_p2Locked ? "✓ Ready" : "")</div>
        </div>
    </div>;

    private RenderFragment GameSummaryContent => @<div>
        <div>@ResultLine()</div>
        @if (_winner != 0 && _mode == "1p" && _winner == 1)
        {
            <div>KO in @_lastKo.ToString("0.00")s@(_newRecord ? " — 🏆 New record!" : "")</div>
        }
        @if (_mode == "1p")
        {
            <div>ELO @_rating.Elo (@(_lastEloDelta >= 0 ? "+" : "")@_lastEloDelta) vs @CharName(_p2Char) @PresidentElo(LadderRungOf(_p2Char))</div>
            @if (_champion)
            {
                <div>🏆 Ladder complete — every president is down! Starting over at @Roster[0].Name.</div>
            }
            else
            {
                <div>Next: BOB vs @Roster[_ladder].Name (match @(_ladder + 1) of @Roster.Length)</div>
            }
        }

        @* Fight recap. The engine already counted every one of these at the hit
           site; the numbers just had nowhere to go. Turns the body-damage diagram
           the player watched all fight into a readable account of what happened. *@
        @if (_recap is { } r)
        {
            <table class="pb-recap">
                <caption>Fight recap@(_mode == "2p" ? $" — best of {MaxRounds}" : "")</caption>
                <thead>
                    <tr>
                        <th scope="col" class="pb-recap-stat">Stat</th>
                        <th scope="col">@CharName(_p1Char)</th>
                        @* In 1P the run walks several presidents, so the right-hand
                           column is every opponent it faced, not the last one. *@
                        <th scope="col">@(_mode == "1p" ? "Presidents" : CharName(_p2Char))</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><th scope="row">Hits landed</th><td>@r.P1Hits</td><td>@r.P2Hits</td></tr>
                    <tr><th scope="row">Blocks</th><td>@r.P1Blocks</td><td>@r.P2Blocks</td></tr>
                    <tr><th scope="row">Best combo</th><td>@r.P1BestCombo</td><td>@r.P2BestCombo</td></tr>
                    <tr><th scope="row">Biggest hit</th><td>@r.P1BiggestHit</td><td>@r.P2BiggestHit</td></tr>
                </tbody>
            </table>
        }

        @* Roster tier list. Fed only by demo matches, but shown to everyone — this
           is the answer to "who is actually good?", which is a question only the
           players picking fighters ever ask. *@
        <PoBrawlEloBoard Ratings="@_fighterRatings" Player1Id="@_p1Char" Player2Id="@_p2Char" />
    </div>;

    protected override void OnInitialized()
    {
        var routeMode = GameModes.Parse(Mode, ModeQuery, DemoQuery);
        _demo = routeMode == GameMode.Demo;
        _mode = _demo ? "demo"
              : routeMode == GameMode.TwoPlayer ? "2p"
              : "1p";
        _playerName = PlayerNameService.GetPlayerName();
        _stats = _gameStats.GetStats("pobrawl", _playerName);

        if (_mode == "1p")
        {
            _rating = _gameStats.GetAdaptiveRating("pobrawl", _playerName);
            _ladder = LoadLadder();
            _p1Char = Bob.Id;
            _p2Char = Roster[_ladder].Id;
        }
        UpdateStats();

        if (_demo) Kiosk.SetCurrent("pobrawl-demo");
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_demo) return;

        // Show the standing board immediately rather than waiting for the first fight of this
        // session to finish — the kiosk may only dwell here for one match. GET /api/pobrawl/elo
        // is anonymous (§10: leaderboard reads are), so this needs no session and no retry: on
        // a demo route AuthGate renders its children while the background guest sign-in is
        // still in flight, and this page used to carry an auth subscription purely to recover
        // from the 401 that window produced.
        await LoadFighterRatingsAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        // The engine boots only once the intro is dismissed (see OnIntroStartAsync)
        // so the fight never runs behind the welcome card. Just create the interop
        // handle here — InitEngine needs it.
        _ref = DotNetObjectReference.Create(this);
    }

    // Routes the intro's key events to each player's selection column. Physical
    // key codes (KeyA, ArrowLeft…) so the mapping is layout-independent and
    // matches each player's in-game half of the keyboard.
    private void OnIntroKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (_mode != "2p" || _introDone) return;
        var n = PickableRoster.Length;
        switch (e.Code)
        {
            case "KeyA":      if (!_p1Locked) _p1Sel = (_p1Sel - 1 + n) % n; break;
            case "KeyD":      if (!_p1Locked) _p1Sel = (_p1Sel + 1) % n; break;
            case "KeyF":      _p1Locked = !_p1Locked; break;
            case "ArrowLeft":  if (!_p2Locked) _p2Sel = (_p2Sel - 1 + n) % n; break;
            case "ArrowRight": if (!_p2Locked) _p2Sel = (_p2Sel + 1) % n; break;
            case "KeyK":      _p2Locked = !_p2Locked; break;
            default: return;
        }
        // Both locked → straight into the fight (no reaching for the mouse).
        if (_twoPlayerReady) { _ = OnIntroStartAsync(); return; }
        StateHasChanged();
    }

    // Dismisses the intro and boots the engine. Idempotent: the FIGHT button and
    // the both-players-locked path can both fire, but the fight starts once.
    private async Task OnIntroStartAsync()
    {
        if (_introDone) return;
        _introDone = true;

        if (_demo)
        {
            // Attract mode: two random fighters, CPU vs CPU.
            var picks = Roster.OrderBy(_ => Guid.NewGuid()).Take(2).ToArray();
            _p1Char = picks[0].Id;
            _p2Char = picks[1].Id;
        }
        else if (_mode == "2p")
        {
            _p1Char = PickableRoster[_p1Sel].Id;
            _p2Char = PickableRoster[_p2Sel].Id;
        }
        // 1P keeps the ladder matchup chosen in OnInitialized (BOB vs the rung).

        StateHasChanged();
        await InitEngine();
    }

    /// <summary>
    /// Returns every HUD readout to its round-start value.
    /// </summary>
    /// <remarks>
    /// Shared by engine boot, the 1P ladder's roll-into-the-next-president path and the 2P
    /// best-of-three rematch. It was duplicated across the first two before the third
    /// existed, and the copies had already drifted — the super meters would have been
    /// missed by one of them. One list, three callers.
    /// </remarks>
    private void ResetRoundHud()
    {
        _p1Hp = 100;
        _p2Hp = 100;
        _p1Energy = 33;
        _p2Energy = 33;
        _p1Super = -1;
        _p2Super = -1;
        _p1SuperReady = false;
        _p2SuperReady = false;
        _elapsed = 0;
        _p1Regions = new int[4];
        _p2Regions = new int[4];
    }

    private async Task InitEngine()
    {
        ResetRoundHud();
        // 1P difficulty is the ladder rung (1 = pushover Trump … 15 = brutal
        // FDR); demo keeps the balanced mid-tier CPU-vs-CPU fight.
        object difficulty = _mode == "1p" ? _ladder + 1 : "medium";
        try
        {
            // Route-gated engine load (see wwwroot/js/engineLoader.js). The engine is
            // no longer in index.html, so it has to be pulled in before the first
            // interop call. Cheap and idempotent after the first await.
            if (!await JSRuntime.InvokeAsync<bool>("loadEngine", "pobrawl"))
            {
                Console.Error.WriteLine("[pobrawl] engine failed to load");
                return;
            }

            await JSRuntime.InvokeVoidAsync("PoBrawl.init", "pobrawl-container", _ref,
                new { mode = _mode, p1Character = _p1Char, p2Character = _p2Char, difficulty });
            // Honour the global ⚙️ master-mute setting on every engine boot.
            if (Settings.Muted || _muted)
            {
                await JSRuntime.InvokeVoidAsync("PoBrawl.setMuted", true);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[PoBrawl] JS init failed: {ex.Message}");
        }
    }

    // StartMatch / BackToSelect / NextMatch were removed with the pre-fight
    // overlay and the modal's Play Again / Next Match buttons (2026-07-16). The
    // ladder still advances in OnMatchEnd and is persisted by SaveLadder, so
    // re-entering /pobrawl resumes at the next president.

    private async Task ToggleMute()
    {
        _muted = !_muted;
        try { await JSRuntime.InvokeVoidAsync("PoBrawl.setMuted", _muted); } catch { }
    }

    /// <summary>
    /// HUD pump from the JS engine (<c>game.js _pushHud</c>, ~4×/sec).
    /// </summary>
    /// <remarks>
    /// <para>
    /// <b>The parameter list is an exact arity contract with the engine — keep them in
    /// step.</b> <c>invokeMethodAsync</c> fails outright when the argument count does not
    /// match, and the engine's call is wrapped in <c>.catch(() =&gt; {})</c>, so a mismatch
    /// is silent: no console error, no exception, just a HUD that never updates.
    /// </para>
    /// <para>
    /// That is exactly what happened. The engine grew four super-meter arguments (2026-08)
    /// and this method was never widened past seven, so EVERY OnHud call had been failing —
    /// the HP bars, the clock and the energy bars had all been frozen at their C# field
    /// initializers (100/100, 0, 33/33) for the whole life of the regression. The "energy
    /// bars never move" report was this, not the energy model.
    /// </para>
    /// <para>
    /// The four super values are now rendered (the super bar under each energy bar). They
    /// were accepted and discarded for the whole life of the regression above, which is why
    /// nobody noticed that the engine was sourcing them from a dead field as well — see the
    /// <c>superMeterFull</c> note in game.js.
    /// </para>
    /// </remarks>
    [JSInvokable]
    public void OnHud(int p1Hp, int p2Hp, double elapsed, int[]? p1Regions, int[]? p2Regions,
        int p1Energy, int p2Energy,
        int p1Super, int p2Super, int p1SuperReady, int p2SuperReady)
    {
        _p1Hp = p1Hp;
        _p2Hp = p2Hp;
        _p1Energy = p1Energy;
        _p2Energy = p2Energy;
        _p1Super = p1Super;
        _p2Super = p2Super;
        _p1SuperReady = p1SuperReady != 0;
        _p2SuperReady = p2SuperReady != 0;
        _elapsed = elapsed;
        if (p1Regions is { Length: 4 }) _p1Regions = p1Regions;
        if (p2Regions is { Length: 4 }) _p2Regions = p2Regions;
        InvokeAsync(StateHasChanged);
    }

    // Fired by the JS engine whenever a match (re)spawns its fighters. In demo
    // mode resetMatch reshuffles the roster on the JS side, so without this the
    // HUD names (and body-diagram avatars) drift off the actual on-screen
    // fighters. Syncing the resolved character ids keeps the left/right names
    // matched to the fighters underneath them.
    [JSInvokable]
    public void OnMatchStart(string p1Char, string p2Char)
    {
        if (!string.IsNullOrEmpty(p1Char)) _p1Char = p1Char;
        if (!string.IsNullOrEmpty(p2Char)) _p2Char = p2Char;
        InvokeAsync(StateHasChanged);
    }

    // ── Region-damage body diagram ────────────────────────────────────────
    // Mirrors the JS engine's per-region damage model (combat.js regionEffect):
    // head ≥70 → extra hitstun taken, arms ≥70 → weaker attacks, legs ≥70 →
    // slower movement (milder steps at 30/40). The diagram turns those hidden
    // numbers into a target-selection tool: hunt the zones that are already red.
    private RenderFragment BodyDiagram(int[] regions) =>
        @<svg class="pb-body" viewBox="0 0 40 64"
              aria-label="Body damage — head @(regions[0]), torso @(regions[1]), arms @(regions[2]), legs @(regions[3])">
            <title>Head @(regions[0]) · Torso @(regions[1]) · Arms @(regions[2]) · Legs @(regions[3])</title>
            <circle cx="20" cy="8" r="7" class="@RegionClass(regions[0])" style="fill:@RegionColor(regions[0])" />
            <rect x="12" y="17" width="16" height="20" rx="3" class="@RegionClass(regions[1])" style="fill:@RegionColor(regions[1])" />
            <rect x="4"  y="17" width="6"  height="18" rx="3" class="@RegionClass(regions[2])" style="fill:@RegionColor(regions[2])" />
            <rect x="30" y="17" width="6"  height="18" rx="3" class="@RegionClass(regions[2])" style="fill:@RegionColor(regions[2])" />
            <rect x="13" y="39" width="6"  height="22" rx="3" class="@RegionClass(regions[3])" style="fill:@RegionColor(regions[3])" />
            <rect x="21" y="39" width="6"  height="22" rx="3" class="@RegionClass(regions[3])" style="fill:@RegionColor(regions[3])" />
        </svg>;

    // Healthy teal → bruised amber → crippled red, matching the 30/70 thresholds
    // the gameplay effects use.
    private static string RegionColor(int dmg)
    {
        var t = Math.Clamp(dmg, 0, 100) / 100.0;
        (int r, int g, int b) from, to;
        double f;
        if (t < 0.5) { from = (74, 222, 178); to = (250, 176, 5); f = t / 0.5; }
        else { from = (250, 176, 5); to = (224, 49, 49); f = (t - 0.5) / 0.5; }
        int L(int a, int b2) => (int)(a + (b2 - a) * f);
        return $"rgb({L(from.r, to.r)},{L(from.g, to.g)},{L(from.b, to.b)})";
    }

    private static string RegionClass(int dmg) => dmg >= 70 ? "pb-reg-crit" : "";

    /// <param name="winner">1 = left fighter, 2 = right fighter, 0 = draw.</param>
    /// <param name="elapsedSeconds">Round clock at the finish.</param>
    /// <param name="recap">
    /// This round's scorecard. Optional so a stale cached engine cannot break the call:
    /// unlike the positional arguments, a missing object binds to null instead of failing
    /// the whole invocation and silently swallowing the match result.
    /// </param>
    [JSInvokable]
    public async Task OnMatchEnd(int winner, double elapsedSeconds, PoBrawlMatchRecap? recap = null)
    {
        _winner = winner;
        _lastKo = elapsedSeconds;
        if (recap is not null) _recap = Accumulate(_recap, recap);

        if (_demo)
        {
            _phase = "result";
            // Demo is CPU vs CPU, so the result rates the two fighters against each other
            // rather than any player. 2P is excluded: those fighters are human-picked and
            // human-driven, which measures the players, not the roster.
            await RecordDemoFighterEloAsync(winner);
            await InvokeAsync(StateHasChanged);
            return;
        }

        // ── 2-player: best of three ───────────────────────────────────────
        if (_mode == "2p")
        {
            if (winner == 1) _p1Rounds++;
            else if (winner == 2) _p2Rounds++;

            // A round is spent either way. The MaxRounds guard is what makes that
            // safe: the engine's time-out path always names a winner, so a draw is
            // very nearly unreachable, but without the cap a run of them would loop
            // rounds forever waiting for a second win that never lands.
            if (_p1Rounds < RoundsToWin && _p2Rounds < RoundsToWin && _round < MaxRounds)
            {
                _round++;
                ResetRoundHud();
                await InvokeAsync(StateHasChanged);
                try
                {
                    // Null fighter/difficulty keeps both players' picks — only the
                    // splash heading changes, so the players can see which round
                    // is starting rather than a generic "NEXT ROUND".
                    await JSRuntime.InvokeVoidAsync("PoBrawl.next", null, null, $"ROUND {_round}");
                }
                catch (Exception ex) { Console.Error.WriteLine($"[PoBrawl] next-round failed: {ex.Message}"); }
                return;
            }

            _phase = "result";
            await InvokeAsync(StateHasChanged);
            await LoadFighterRatingsAsync();
            return;
        }

        _gameStats.SaveLastPlayedGame("pobrawl");

        // A new fastest KO is submitted to the global board (session-debounced by _bestKo).
        PoBrawlHighScore? best = null;
        _newRecord = false;
        var won = winner == 1;
        if (won && elapsedSeconds > 0 && (_bestKo == 0 || elapsedSeconds < _bestKo))
        {
            _bestKo = elapsedSeconds;
            _newRecord = true;
            best = new PoBrawlHighScore
            {
                // One identity across boards: full display name, not initials.
                PlayerInitials = _playerName,
                KoTimeSeconds = Math.Round(elapsedSeconds, 2),
                Character = _p1Char,
            };
        }

        var result = winner == 0 ? GameResult.Draw : (won ? GameResult.Win : GameResult.Loss);

        // Adaptive ELO (same system as ConnectFive): scored against the
        // beaten/losing president's fixed ladder rating, so early rungs are
        // worth little and Nixon is worth a lot.
        var before = _rating.Elo;
        _rating = _gameStats.RecordAdaptiveResult("pobrawl", _playerName, PresidentElo(_ladder), result);
        _lastEloDelta = _rating.Elo - before;

        // Ladder: a win with presidents still in line rolls straight into the
        // next fight — no modal. The shared end-of-game modal is reserved for
        // the run's *end*: a loss/draw (gauntlet over) or the full-ladder clear.
        var advanceToNext = false;
        if (won)
        {
            if (_ladder >= Roster.Length - 1)
            {
                _champion = true;   // cleared the last rung → triumphant end, show the modal
                _ladder = 0;
            }
            else
            {
                _ladder++;
                advanceToNext = true;   // another CPU is queued → skip the modal
            }
            SaveLadder();

            // Global ladder board: presidents beaten this run (Roster.Length on a
            // full clear — _ladder has already wrapped to 0 by then). The server
            // keeps each player's best, so this is safe to fire every win, and its
            // rung ceiling is the same roster, so no rung can be rejected as
            // out of range.
            _ = await ApiService.SubmitPoBrawlLadderAsync(new PoBrawlLadderEntry
            {
                PlayerName = _playerName,
                PresidentsBeaten = _champion ? Roster.Length : _ladder,
                Elo = _rating.Elo,
            });
        }

        _stats = await GameResults.RecordAndSubmitPoBrawlAsync(_playerName, result, best);
        UpdateStats();

        if (advanceToNext)
        {
            // Stay in the fight: reset the HUD to the fresh match and tell the
            // engine to roll into the next president (NEXT ROUND splash →
            // countdown). GameOver stays false, so no modal is shown.
            _p2Char = Roster[_ladder].Id;
            _phase = "fighting";
            ResetRoundHud();
            await InvokeAsync(StateHasChanged);
            try { await JSRuntime.InvokeVoidAsync("PoBrawl.next", _p2Char, _ladder + 1, null); }
            catch (Exception ex) { Console.Error.WriteLine($"[PoBrawl] next-match failed: {ex.Message}"); }
            return;
        }

        _phase = "result";
        await InvokeAsync(StateHasChanged);
        // Fetched AFTER the modal is on screen, not before: the board is the last
        // thing in the summary and it renders its own "Loading ratings…" line, so
        // waiting on a network round-trip here would only delay the result the
        // player is actually waiting for.
        await LoadFighterRatingsAsync();
    }

    /// <summary>
    /// Reports one finished demo match to the fighter-Elo board and refreshes it.
    /// </summary>
    /// <param name="winner">1 = the left fighter, 2 = the right fighter, 0 = a draw.</param>
    private async Task RecordDemoFighterEloAsync(int winner)
    {
        // Every game-data write requires auth. AuthGate signs the visitor in before this
        // page renders (minting a guest on demo routes where dev-login is enabled), so
        // this is normally true — but if it isn't, watch silently rather than firing a
        // 401 after every match for as long as the kiosk is left running.
        if (!Auth.IsAuthenticated) return;

        // The engine reshuffles its own roster on restart and reports the pairing through
        // OnMatchStart. A degenerate self-pairing would be rejected server-side, so skip it
        // here instead of spending the request.
        if (string.IsNullOrEmpty(_p1Char) || string.IsNullOrEmpty(_p2Char) || _p1Char == _p2Char) return;

        // Only the left fighter takes the winner slot unless the right one actually won. On a
        // draw the order is arbitrary — IsDraw is what scores the match.
        var leftWon = winner != 2;
        var request = new PoBrawlDemoResultRequest(
            WinnerFighterId: leftWon ? _p1Char : _p2Char,
            LoserFighterId: leftWon ? _p2Char : _p1Char,
            IsDraw: winner == 0);

        // The POST answers with the re-ranked board, so the ranking change this match caused
        // arrives with it — no follow-up fetch.
        await ApplyRatingsAsync(await ApiService.SubmitPoBrawlDemoResultAsync(request));
    }

    private async Task LoadFighterRatingsAsync() =>
        await ApplyRatingsAsync(await ApiService.GetPoBrawlFighterRatingsAsync(10));

    private async Task ApplyRatingsAsync(PoBrawlFighterRating[]? ratings)
    {
        // A failed fetch leaves the previous board on screen (or the loading line on the
        // very first attempt) instead of blanking it — an unattended screen should degrade
        // to stale, not to empty.
        if (ratings is null) return;
        _fighterRatings = ratings;
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, Difficulty.Medium);
        _statItems = _mode == "1p"
            ? GameStatsPanel.Build(bucket, includeDraws: false, includeElo: false,
                ("ELO", _rating.Elo.ToString()),
                ("Best KO", _bestKo > 0 ? $"{_bestKo:0.00}s" : "0s"))
            : GameStatsPanel.Build(bucket, includeDraws: false, includeElo: true,
                ("Best KO", _bestKo > 0 ? $"{_bestKo:0.00}s" : "0s"));
    }

    private string ResultLine()
    {
        // 2P reports the MATCH, not the last round — a player who lost the final
        // round 2-1 still won, and naming the round winner would read as a loss.
        if (_mode == "2p")
        {
            var champ = _p1Rounds > _p2Rounds ? 1 : _p2Rounds > _p1Rounds ? 2 : 0;
            var hi = Math.Max(_p1Rounds, _p2Rounds);
            var lo = Math.Min(_p1Rounds, _p2Rounds);
            if (champ == 0) return $"🤝 Match drawn {hi}–{lo}";
            return $"🏆 {CharName(champ == 1 ? _p1Char : _p2Char)} takes the match {hi}–{lo} — Player {champ}!";
        }

        if (_winner == 0) return "🤝 Draw!";
        return _winner == 1
            ? $"🏆 BOB knocked out {CharName(_p2Char)}!"
            : $"💀 {CharName(_p2Char)} beat BOB — rematch!";
    }

    private static string CharName(string id) =>
        PickableRoster.FirstOrDefault(r => r.Id == id)?.Name ?? id;

    private static int LadderRungOf(string presidentId)
    {
        var idx = Array.FindIndex(Roster, r => r.Id == presidentId);
        return idx < 0 ? 0 : idx;
    }

    private int LoadLadder()
    {
        var raw = LocalStorageService.GetItem<string>(LadderKey);
        return int.TryParse(raw, out var i) ? Math.Clamp(i, 0, Roster.Length - 1) : 0;
    }

    private void SaveLadder() => LocalStorageService.SetItem(LadderKey, _ladder.ToString());

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "PO";
        var letters = new string(name.Where(char.IsLetterOrDigit).ToArray());
        if (letters.Length == 0) return "PO";
        return letters[..Math.Min(3, letters.Length)].ToUpperInvariant();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("PoBrawl.destroy"); } catch { }
        _ref?.Dispose();
    }
}
