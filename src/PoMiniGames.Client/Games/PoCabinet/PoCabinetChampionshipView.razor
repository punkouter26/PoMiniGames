@*
    PoCabinetChampionshipView — visualises the 3-stage career (Capitol → Mar-a-Lago
    → Press Briefing) as a horizontal stages strip (Concept 9). Each stage
    shows its completion state and best lap; the trophy + gold livery are
    locked until the final-race win.

    State source: PoCabinetCareerState (localStorage + optional server sync
    via /api/pocabinet/career — wired in T4).
*@

@using PoMiniGames.Shared.Games
@inject PoCabinetCareerState Career

<div class="pocabinet-championship" aria-label="Championship progress">
    <h3 class="pocabinet-championship__title">THE CAMPAIGN</h3>
    <ol class="pocabinet-championship__stages">
        @for (var i = 0; i < PoCabinetCatalog.Tracks.Count; i++)
        {
            var stageIndex = i;
            var track = PoCabinetCatalog.Tracks[i];
            var isDone = Career.Current.CompletedStages.Contains(stageIndex);
            var isActive = stageIndex == Career.Current.CurrentStageIndex;
            var status = isDone ? "Done" : isActive ? "Active" : "Locked";
            <li class="pocabinet-stage @(isDone ? "pocabinet-stage--done" : null) @(isActive ? "pocabinet-stage--active" : null)" aria-label="@track.Name — @status">
                <span class="pocabinet-stage__name">@track.Name</span>
                <span class="pocabinet-stage__status">@status</span>
            </li>
        }
    </ol>

    <div class="pocabinet-championship__rewards">
        <span class="@(Career.Current.TrophyUnlocked ? "pocabinet-reward pocabinet-reward--unlocked" : "pocabinet-reward")">
            🏆 Trophy: @(Career.Current.TrophyUnlocked ? "Unlocked" : "Win Press Briefing 500 to unlock")
        </span>
        <span class="@(Career.Current.GoldLiveryUnlocked ? "pocabinet-reward pocabinet-reward--unlocked" : "pocabinet-reward")">
            🎨 Gold Livery: @(Career.Current.GoldLiveryUnlocked ? "Unlocked" : "Locked")
        </span>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Career.LoadAsync();
        Career.Current = Career.Current; // trigger re-render
    }
}