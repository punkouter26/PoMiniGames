@*
    PoCabinetDrawer — the one place Cabinet's settings live: a side sheet on desktop, a
    bottom sheet on phones. The start card, the pause card and the lobby all open this same
    drawer (they used to carry two fold-out panels, a "compact" copy with its own fold-out,
    and nothing at all). The lobby also gets the paint shop here: paint is picked before the
    race, and the lobby is the last stop before it.

    A native <dialog> opened through PoDialogInterop.showModalAlone, which puts the layer
    under it away (the pause dialog, the intro card) and brings it back on close. Esc closes
    it natively; input.js ignores Esc inside any dialog but the pause one, so it never also
    resumes the race. A click on the backdrop closes it too.
*@

@inject IJSRuntime JS

<dialog @ref="_dialog" class="pocabinet-drawer" aria-labelledby="pocabinet-drawer-title"
        @onclose="OnClosedAsync" @onclick="CloseAsync">
    <div class="pocabinet-drawer__panel" @onclick:stopPropagation="true">
        <header class="pocabinet-drawer__head">
            <h2 id="pocabinet-drawer-title">@(ShowPaint ? "Car & settings" : "Settings")</h2>
            <button type="button" class="app-btn app-btn--ghost pocabinet-drawer__close" aria-label="Close settings" @onclick="CloseAsync">✕</button>
        </header>
        <div class="pocabinet-drawer__body">
            @if (_open)
            {
                @if (ShowPaint)
                {
                    <section class="pocabinet-drawer__section" aria-label="Paint job">
                        <h3>Paint job <span class="pocabinet-muted">@Livery · @Color</span></h3>
                        <PoCabinetPaintShop SelectedLivery="@Livery" SelectedColor="@Color" SelectionChanged="PaintChanged" />
                    </section>
                }
                <PoCabinetSettingsPanel Value="Settings" ValueChanged="SettingsChanged" />
            }
        </div>
    </div>
</dialog>

@code {
    [Parameter] public PoCabinetUiSettings Settings { get; set; } = new();
    [Parameter] public EventCallback<PoCabinetUiSettings> SettingsChanged { get; set; }
    /// <summary>The lobby: the paint shop above the settings.</summary>
    [Parameter] public bool ShowPaint { get; set; }
    [Parameter] public string? Livery { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public EventCallback<(string Livery, string Color)> PaintChanged { get; set; }

    private ElementReference _dialog;
    private bool _open;

    public async Task OpenAsync()
    {
        _open = true;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("PoDialogInterop.showModalAlone", _dialog); }
        catch { _open = false; }
    }

    private async Task CloseAsync()
    {
        try { await JS.InvokeVoidAsync("PoDialogInterop.close", _dialog); }
        catch { /* torn down */ }
    }

    // Esc, the ✕ and the backdrop all end here, through the dialog's own close event.
    private Task OnClosedAsync()
    {
        _open = false;
        return Task.CompletedTask;
    }
}
