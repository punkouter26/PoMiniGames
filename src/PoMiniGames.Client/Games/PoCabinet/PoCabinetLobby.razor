@*
    PoCabinetLobby — host creates a lobby and shares the 8-char join code, or
    guests paste a code to join. Layout is the Concept 8 "Among Us" style: a
    banner with the code, an 8-seat grid, a track picker, and Start when all
    players are ready.

    Real SignalR /pocabinet/lobby-hub wiring lands in the racing service (T7
    service code). For v1 the lobby is a thin UI that captures the host's
    intent and hands the join code to the racing service.
*@

@using PoMiniGames.Shared.Games
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PlayerNameService PlayerNameSvc
@inject PoCabinetSession Session

<div class="pocabinet-lobby" aria-label="Multiplayer lobby">
    <header class="pocabinet-lobby__header">
        <h2>Lobby</h2>
        @if (!string.IsNullOrEmpty(_joinCode))
        {
            <div class="pocabinet-lobby__code" aria-live="polite">
                <span>Code: <strong id="lobby-code">@_joinCode</strong></span>
                <button type="button" @onclick="CopyCodeAsync">Copy</button>
            </div>
        }
    </header>

    <section class="pocabinet-lobby__seats" aria-label="Lobby seats">
        @for (var i = 0; i < PoCabinetCatalog.CarCount; i++)
        {
            var seatIndex = i;
            <div class="pocabinet-seat @(IsSeatFilled(seatIndex) ? "pocabinet-seat--filled" : "pocabinet-seat--empty")">
                @if (seatIndex < _players.Count)
                {
                    var p = _players[seatIndex];
                    <strong>@p.DisplayName</strong>
                    @if (p.IsHost) { <span class="pocabinet-seat__badge">Host</span> }
                }
                else
                {
                    <span aria-label="Empty seat">—</span>
                }
            </div>
        }
    </section>

    <section class="pocabinet-lobby__controls">
        <PoCabinetTrackSelector SelectedTrackId="@_trackId" SelectedTrackIdChanged="OnTrackChanged" />
        @if (_isHost)
        {
            <button class="pocabinet-lobby__start" disabled="@(!CanStart)" @onclick="StartAsync">
                @(_players.Count < 2 ? "Waiting for players…" : "Start")
            </button>
        }
        @if (!_isHost)
        {
            <button class="pocabinet-lobby__ready" @onclick="ToggleReadyAsync">
                @(_isReady ? "Ready ✓" : "Ready up")
            </button>
        }
    </section>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="pocabinet-lobby__error" role="alert">@_error</p>
    }
</div>

@code {
    [Parameter] public string? Mode { get; set; }
    [Parameter] public string? InitialJoinCode { get; set; }

    private sealed class PlayerRow
    {
        public string DisplayName { get; init; } = "";
        public bool IsHost { get; init; }
        public bool IsReady { get; set; }
    }

    private string _joinCode = "";
    private string _trackId = PoCabinetCatalog.DefaultTrackId;
    private bool _isHost;
    private bool _isReady = false;
    private string? _error = null;
    private readonly List<PlayerRow> _players = new();
    private string? _previousRaceStartingTrackId = null;

    private bool CanStart => _players.Count >= 2 && _players.All(p => p.IsReady);

    protected override async Task OnInitializedAsync()
    {
        _isHost = string.IsNullOrWhiteSpace(InitialJoinCode);
        var playerName = PlayerNameSvc.GetOrReadInitialName();
        var isGuest = true;
        try
        {
            if (_isHost)
            {
                // Host auto-readies and gets a code from the server.
                _joinCode = await Session.OpenLobbyAsync(playerName, isGuest, _trackId);
                _players.Add(new PlayerRow { DisplayName = playerName, IsHost = true, IsReady = true });
                _joinCode = Session.JoinCode ?? _joinCode;
            }
            else
            {
                _joinCode = InitialJoinCode!;
                var ok = await Session.JoinLobbyAsync(_joinCode, playerName, isGuest);
                if (!ok)
                {
                    _error = "That lobby is full or has already started.";
                    return;
                }
                _players.Add(new PlayerRow { DisplayName = playerName, IsHost = false });
            }
            Session.RaceStarting += OnRaceStartingAsync;
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the lobby: {ex.Message}";
        }
    }

    private bool IsSeatFilled(int seatIndex) => seatIndex < _players.Count;

    private Task OnTrackChanged(string trackId)
    {
        _trackId = trackId;
        return Task.CompletedTask;
    }

    private async Task ToggleReadyAsync()
    {
        try { await Session.ToggleReadyAsync(_joinCode); } catch { /* ignore */ }
    }

    private async Task StartAsync()
    {
        try
        {
            await Session.TryStartAsync(_joinCode);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnRaceStartingAsync(string trackId)
    {
        _previousRaceStartingTrackId = trackId;
        await InvokeAsync(StateHasChanged);
        // Carry the join code in the query string so the race page can join
        // the race hub. The lobby is short-lived — it disposes on this nav —
        // so we cannot rely on the session's JoinCode from the race page side
        // (the PoCabinetSession scope is per-circuit).
        var code = Session.JoinCode ?? _joinCode;
        Nav.NavigateTo($"/pocabinet/multi?code={Uri.EscapeDataString(code)}");
    }

    private async Task CopyCodeAsync()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _joinCode); } catch { /* ignore */ }
    }

    public ValueTask DisposeAsync()
    {
        if (Session is not null)
        {
            Session.RaceStarting -= OnRaceStartingAsync;
        }
        return ValueTask.CompletedTask;
    }

    private string GeneratePlaceholderCode()
    {
        // Stub used only when the lobby service is unreachable — the screen
        // still renders a CAB-XXXXXXXX placeholder so the player can fall
        // back to solo racing from the lobby.
        return "CAB-" + Guid.NewGuid().ToString("N")[..8].ToUpperInvariant();
    }
}