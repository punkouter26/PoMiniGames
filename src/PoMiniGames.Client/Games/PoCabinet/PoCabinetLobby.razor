@*
    PoCabinetLobby — host opens a lobby (or a guest joins one by code) and the seat grid
    mirrors the server's LobbyState broadcasts: humans, the AI officials filling free seats,
    ready flags, host badge. The host picks the track, how many officials race, whether the
    lobby is listed publicly, and starts; the RaceStarting broadcast hands everyone to the
    race through OnRaceStarting. After a race the same lobby reopens — coming back here with
    the same code is the rematch.
*@

@using PoMiniGames.Shared.Games
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject PlayerNameService PlayerNameSvc
@inject PoCabinetSession Session

<div class="pocabinet-lobby" aria-label="Multiplayer lobby">
    <header class="pocabinet-lobby__header">
        <h2>Lobby</h2>
        @if (!string.IsNullOrEmpty(_code))
        {
            <div class="pocabinet-lobby__code" aria-live="polite">
                <span>Code: <strong id="lobby-code">@_code</strong></span>
                <button type="button" @onclick="CopyCodeAsync">Copy code</button>
                <button type="button" @onclick="CopyLinkAsync">Copy invite link</button>
            </div>
        }
    </header>

    @if (_view is { } view)
    {
        <section class="pocabinet-lobby__seats" aria-label="Grid">
            @foreach (var seat in view.Players)
            {
                <div class="pocabinet-seat pocabinet-seat--filled @(seat.SeatId == Session.MySeatId ? "pocabinet-seat--me" : "")">
                    <strong>@seat.DisplayName@(seat.SeatId == Session.MySeatId ? " (you)" : "")</strong>
                    @if (seat.IsHost) { <span class="pocabinet-seat__badge">Host</span> }
                    <span class="pocabinet-seat__state">@(seat.IsReady ? "Ready ✓" : "Not ready")</span>
                </div>
            }
            @foreach (var bot in BotSeats(view))
            {
                <div class="pocabinet-seat pocabinet-seat--bot">
                    <strong>@bot</strong>
                    <span class="pocabinet-seat__badge">AI</span>
                </div>
            }
            @for (var i = view.Players.Count + BotSeats(view).Count; i < PoCabinetCatalog.CarCount; i++)
            {
                <div class="pocabinet-seat pocabinet-seat--empty"><span aria-label="Empty seat">—</span></div>
            }
        </section>

        <section class="pocabinet-lobby__controls">
            @if (IsHost)
            {
                <PoCabinetTrackSelector SelectedTrackId="@view.TrackId" SelectedTrackIdChanged="SetTrackAsync" />
                <div class="pocabinet-lobby__row">
                    <span id="pocabinet-bots-label">AI officials</span>
                    <div class="pocabinet-stepper" role="group" aria-labelledby="pocabinet-bots-label">
                        <button type="button" aria-label="Fewer AI officials" disabled="@(view.BotCount <= 0)" @onclick="() => SetBotsAsync(view.BotCount - 1)">−</button>
                        <output aria-live="polite">@view.BotCount</output>
                        <button type="button" aria-label="More AI officials" disabled="@(view.BotCount >= 4)" @onclick="() => SetBotsAsync(view.BotCount + 1)">+</button>
                    </div>
                </div>
                <label class="pocabinet-lobby__row">
                    <span>List in public lobbies</span>
                    <input type="checkbox" checked="@view.IsPublic" @onchange="SetPublicAsync" />
                </label>
                <button class="pocabinet-lobby__start pocabinet-primary" disabled="@(!CanStart(view) || _busy)" @onclick="StartAsync">
                    @StartLabel(view)
                </button>
            }
            else
            {
                <p class="pocabinet-lobby__track">Track: <strong>@PoCabinetCatalog.GetTrack(view.TrackId).Name</strong> · @view.BotCount AI official@(view.BotCount == 1 ? "" : "s")</p>
                <button class="pocabinet-lobby__ready pocabinet-primary" disabled="@(view.InRace || _busy)" @onclick="ToggleReadyAsync">
                    @(MySeat(view)?.IsReady == true ? "Ready ✓ — tap to cancel" : "Ready up")
                </button>
            }
            @if (view.InRace)
            {
                <p class="pocabinet-lobby__note" role="status">A race is running for this lobby. It reopens here when it ends.</p>
            }
            <button type="button" class="pocabinet-secondary" @onclick="LeaveAsync">Leave lobby</button>
        </section>
    }
    else if (string.IsNullOrEmpty(_error))
    {
        <p class="pocabinet-lobby__note" role="status">Connecting to the lobby…</p>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="pocabinet-lobby__error" role="alert">@_error</p>
        <button type="button" class="pocabinet-secondary" @onclick="LeaveAsync">Back</button>
    }
</div>

@code {
    /// <summary>Code to join; empty = open a new lobby as host.</summary>
    [Parameter] public string? InitialJoinCode { get; set; }
    [Parameter] public string? InitialTrackId { get; set; }
    /// <summary>Paint hex this player races in.</summary>
    [Parameter] public string? Color { get; set; }
    [Parameter] public EventCallback<(string Code, string TrackId)> OnRaceStarting { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }

    private static readonly string[] OfficialNames = ["Sean S.", "Steve B.", "Bill B.", "Mike P."];

    private PoCabinetLobbyView? _view;
    private string _code = "";
    private string? _error;
    private bool _busy;

    private bool IsHost => _view?.Players.FirstOrDefault(p => p.IsHost)?.SeatId == Session.MySeatId;

    protected override async Task OnInitializedAsync()
    {
        Session.LobbyChanged += OnLobbyChangedAsync;
        Session.RaceStarting += OnRaceStartingAsync;
        var name = PlayerNameSvc.GetOrReadInitialName();
        try
        {
            if (string.IsNullOrWhiteSpace(InitialJoinCode))
            {
                _view = await Session.OpenLobbyAsync(name, InitialTrackId, isPublic: true, Color);
            }
            else
            {
                _view = await Session.JoinLobbyAsync(InitialJoinCode.Trim().ToUpperInvariant(), name, Color);
                if (_view is null) _error = "That lobby is full, has closed, or its race is already running.";
            }
            _code = _view?.Code ?? "";
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the lobby: {ex.Message}";
        }
    }

    private Task OnLobbyChangedAsync(PoCabinetLobbyView view)
    {
        _view = view;
        return InvokeAsync(StateHasChanged);
    }

    private Task OnRaceStartingAsync(string code, string trackId) =>
        InvokeAsync(() => OnRaceStarting.InvokeAsync((code, trackId)));

    private static PoCabinetLobbySeat? MySeatIn(PoCabinetLobbyView view, string? seatId) =>
        view.Players.FirstOrDefault(p => p.SeatId == seatId);

    private PoCabinetLobbySeat? MySeat(PoCabinetLobbyView view) => MySeatIn(view, Session.MySeatId);

    private static List<string> BotSeats(PoCabinetLobbyView view) =>
        OfficialNames.Take(Math.Min(view.BotCount, Math.Max(0, PoCabinetCatalog.CarCount - view.Players.Count))).ToList();

    /// <summary>Mirrors PoCabinetLobbyService.CanStart: everyone ready, and two cars counting the AI.</summary>
    private static bool CanStart(PoCabinetLobbyView view) =>
        !view.InRace
        && view.Players.Count + BotSeats(view).Count >= 2
        && view.Players.All(p => p.IsReady);

    private static string StartLabel(PoCabinetLobbyView view) =>
        view.InRace ? "Race running…"
        : view.Players.Count + BotSeats(view).Count < 2 ? "Add an AI official or wait for a friend"
        : view.Players.All(p => p.IsReady) ? "Start race"
        : "Waiting for everyone to ready up…";

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try { await action(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task SetTrackAsync(string trackId) => RunAsync(() => Session.SetTrackAsync(trackId));

    private Task SetBotsAsync(int count) => RunAsync(() => Session.SetBotsAsync(Math.Clamp(count, 0, 4)));

    private Task SetPublicAsync(ChangeEventArgs e) => RunAsync(() => Session.SetPublicAsync(e.Value is bool b && b));

    private Task ToggleReadyAsync() => RunAsync(() => Session.ToggleReadyAsync());

    private Task StartAsync() => RunAsync(async () =>
    {
        if (!await Session.TryStartAsync()) _error = "Could not start — someone may have just un-readied.";
    });

    private async Task LeaveAsync()
    {
        await Session.LeaveLobbyAsync();
        await OnExit.InvokeAsync();
    }

    private async Task CopyCodeAsync()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _code); } catch { /* ignore */ }
    }

    private async Task CopyLinkAsync()
    {
        var link = Nav.ToAbsoluteUri($"/pocabinet/multi?lobby={Uri.EscapeDataString(_code)}").ToString();
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", link); } catch { /* ignore */ }
    }

    public ValueTask DisposeAsync()
    {
        Session.LobbyChanged -= OnLobbyChangedAsync;
        Session.RaceStarting -= OnRaceStartingAsync;
        return ValueTask.CompletedTask;
    }
}
