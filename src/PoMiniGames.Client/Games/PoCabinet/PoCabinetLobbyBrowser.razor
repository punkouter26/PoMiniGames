@*
    PoCabinetLobbyBrowser — quick match. Lists public lobbies with a free seat (Join) and
    public races in progress (Watch = spectate), refreshed every few seconds, plus a
    join-by-code box for private lobbies. Rendered on the multiplayer start screen.
*@

@using PoMiniGames.Shared.Games
@implements IDisposable
@inject PoCabinetSession Session

<section class="pocabinet-browser" aria-label="Open lobbies">
    <h2 class="pocabinet-browser__title">Open lobbies</h2>
    @if (_lobbies is null)
    {
        <p class="pocabinet-browser__empty" role="status">@(_error ?? "Looking for lobbies…")</p>
    }
    else if (_lobbies.Count == 0)
    {
        <p class="pocabinet-browser__empty">No public lobbies right now — start one and share the code.</p>
    }
    else
    {
        <ul class="pocabinet-browser__list">
            @foreach (var l in _lobbies)
            {
                <li class="pocabinet-browser__row">
                    <span class="pocabinet-browser__host">@l.HostName</span>
                    <span class="pocabinet-browser__meta">@PoCabinetCatalog.GetTrack(l.TrackId).Name · @l.Humans player@(l.Humans == 1 ? "" : "s")@(l.Bots > 0 ? $" + {l.Bots} AI" : "")</span>
                    @if (l.InRace)
                    {
                        <button type="button" class="pocabinet-secondary" @onclick="() => OnWatch.InvokeAsync(l.Code)"
                                aria-label="Watch @l.HostName's race">Watch</button>
                    }
                    else
                    {
                        <button type="button" class="pocabinet-primary" @onclick="() => OnJoin.InvokeAsync(l.Code)"
                                aria-label="Join @l.HostName's lobby">Join</button>
                    }
                </li>
            }
        </ul>
    }
    <form class="pocabinet-browser__code" @onsubmit="JoinByCodeAsync" @onsubmit:preventDefault>
        <label for="pocabinet-joincode">Have a code?</label>
        <input id="pocabinet-joincode" placeholder="CAB-XXXXXXXX" maxlength="12" autocomplete="off"
               value="@_codeInput" @oninput="e => _codeInput = e.Value?.ToString() ?? string.Empty" />
        <button type="submit" class="pocabinet-secondary" disabled="@(string.IsNullOrWhiteSpace(_codeInput))">Join</button>
    </form>
</section>

@code {
    [Parameter] public EventCallback<string> OnJoin { get; set; }
    [Parameter] public EventCallback<string> OnWatch { get; set; }

    private IReadOnlyList<PoCabinetLobbySummary>? _lobbies;
    private string? _error;
    private string _codeInput = "";
    private Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new Timer(_ => _ = InvokeAsync(RefreshAsync), null, TimeSpan.Zero, TimeSpan.FromSeconds(4));
    }

    private async Task RefreshAsync()
    {
        try
        {
            _lobbies = await Session.ListOpenAsync();
            _error = null;
        }
        catch
        {
            _error = "Couldn't reach the lobby server — you can still join with a code.";
        }
        StateHasChanged();
    }

    private Task JoinByCodeAsync()
    {
        var code = _codeInput.Trim().ToUpperInvariant();
        if (code.Length == 8 && !code.StartsWith("CAB-", StringComparison.Ordinal)) code = "CAB-" + code;
        return string.IsNullOrEmpty(code) ? Task.CompletedTask : OnJoin.InvokeAsync(code);
    }

    public void Dispose() => _timer?.Dispose();
}
