@page "/pocabinet/{ModeSegment}"
@page "/pocabinet"

@using PoMiniGames.Shared.Games
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject GameResultService GameResults
@inject PlayerNameService PlayerNameSvc
@inject PoCabinetSession Session
@inject PoCabinetCareerState Career
@inherits PoCabinetPageBase

<PageTitle>Cabinet · PoMiniGames</PageTitle>

<GameShell Title="@TitleContent" Player="@_playerName" BackTo="/" Fullscreen="true"
           GameKey="pocabinet">
    <div class="pocabinet-root">
        @if (_phase == Phase.Start)
        {
            <section class="pocabinet-start" aria-label="Cabinet start">
                <div class="pocabinet-card">
                    <h1>Cabinet</h1>
                    <p class="pocabinet-card__lede">@(Mode == GameMode.Demo ? "Watch a 3-lap showcase. The cockpit controls read WASD / arrow keys; a single click is enough — the AI fills the rest." : "Pick a track, pick your paint, and take on the officials.") 3 laps per race.</p>
                    <PoCabinetTrackSelector SelectedTrackId="@_trackId" SelectedTrackIdChanged="OnTrackChanged" />
                    <details class="pocabinet-customize">
                        <summary>Customize paint job</summary>
                        <PoCabinetPaintShop SelectedLivery="@_livery" SelectedColor="@_color" SelectionChanged="OnPaintChanged" />
                    </details>
                    <details class="pocabinet-customize">
                        <summary>Settings</summary>
                        <PoCabinetSettingsPanel Value="Settings" ValueChanged="OnSettingsChangedAsync" />
                    </details>
                    <p class="pocabinet-hint" aria-hidden="true">Selected: <strong>@(_livery)</strong> · <strong>@(_color)</strong></p>
                    <div class="pocabinet-actions">
                        <button class="pocabinet-primary" @onclick="StartRaceAsync">@(Mode == GameMode.Demo ? "Watch demo" : "Start race")</button>
                        @if (Mode != GameMode.Multiplayer)
                        {
                            <a href="/pocabinet/multi">Multiplayer</a>
                        }
                        <a href="/leaderboards?game=pocabinet">Leaderboard</a>
                    </div>
                    @if (Mode == GameMode.OnePlayer)
                    {
                        <PoCabinetChampionshipView />
                        @if (HasAnyCareerProgress)
                        {
                            <button class="pocabinet-secondary" @onclick="ResetCareerAsync" aria-label="Reset career progression">
                                Reset career
                            </button>
                        }
                    }
                </div>
            </section>
        }
        else if (_phase == Phase.Lobby)
        {
            <PoCabinetLobby Mode="@Mode.ToString()" InitialJoinCode="@_joinCode" />
        }
        else if (_phase == Phase.Racing || _phase == Phase.Loading)
        {
            <section class="pocabinet-race @(Settings.ReducedMotion ? "pocabinet-reduced" : "")"
                     style="--pocabinet-hud:@Settings.HudScaleCss"
                     aria-label="Race in progress">
                <canvas id="pocabinetCanvas"
                        @ref="_canvas"
                        class="pocabinet-canvas"
                        role="img"
                        tabindex="0"
                        aria-label="Cabinet cockpit view. Drive with W A S D or arrow keys.">
                </canvas>
                <canvas id="pocabinetMinimap" @ref="_minimapCanvas" class="pocabinet-minimap" aria-hidden="true"></canvas>
                <div id="pocabinetDialogueLayer" class="pocabinet-dialogue-layer" aria-hidden="true"></div>
                @if (_countdownDisplay > 0)
                {
                    <div class="pocabinet-countdown" role="status">@_countdownDisplay</div>
                }
                else if (_showGo)
                {
                    <div class="pocabinet-countdown pocabinet-countdown--go" role="status">GO!</div>
                }
                @if (IsMultiplayerMode && _phase == Phase.Racing && _pingMs is not null)
                {
                    <span class="pocabinet-ping @PingClass" title="Round-trip latency to the race server">@_pingMs ms</span>
                }
                <div class="pocabinet-hud" aria-live="polite">
                    <span>Lap <strong>@_lap</strong>/@_totalLaps</span>
                    <span>Pos <strong>@_position</strong>/@_totalCars</span>
                    <span>Speed <strong>@($"{_speedKmh:0}")</strong> km/h</span>
                    <span>Time <strong>@FormatLapTime(_lapSeconds)</strong></span>
                    <span>Last <strong>@FormatLapTime(_lastLapSeconds)</strong></span>
                    <span>Best <strong>@FormatLapTime(_bestLapSession > 0 ? _bestLapSession : _storedBestLap)</strong></span>
                    <span class="pocabinet-sectors" aria-label="Sector splits">
                        @for (var i = 0; i < 3; i++)
                        {
                            var idx = i;
                            <span class="pocabinet-sector @SectorClass(idx)">
                                <span class="pocabinet-sector__label">S@(idx + 1)</span>
                                @if (_sectorTimes[idx] is { } done)
                                {
                                    @FormatLapTime(done)
                                }
                                else if (idx == _sectorIndex && _lastSnapshot is { } ls && ls.Started && !ls.Finished)
                                {
                                    @FormatLapTime(Math.Max(0, ls.ElapsedRaceTime - _sectorStart))
                                }
                                else
                                {
                                    @("—")
                                }
                            </span>
                        }
                    </span>
                    @if (Pausable)
                    {
                        <button type="button" class="pocabinet-pausebtn" @onclick="TogglePauseAsync"
                                aria-label="@(_paused ? "Resume race" : "Pause race")">
                            @(_paused ? "▶" : "⏸")
                        </button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_announcement))
                {
                    <p class="pocabinet-announcement" role="status">@_announcement</p>
                }
                @if (IsMultiplayerMode && _phase == Phase.Racing && !string.IsNullOrEmpty(_status))
                {
                    <div class="pocabinet-reconnect" role="alert">
                        <span class="pocabinet-reconnect__spinner" aria-hidden="true"></span>
                        <span>@_status</span>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_status))
                {
                    <p class="pocabinet-status" role="alert">@_status</p>
                }
            </section>
            @if (_paused)
            {
                <div class="pocabinet-overlay" role="dialog" aria-modal="true" aria-label="Race paused">
                    <div class="pocabinet-overlay__card">
                        <h2>Paused</h2>
                        <PoCabinetSettingsPanel Value="Settings" ValueChanged="OnSettingsChangedAsync" />
                        <div class="pocabinet-actions">
                            <button class="pocabinet-primary" @onclick="ResumeRaceAsync">Resume</button>
                            <button class="pocabinet-secondary" @onclick="QuitToMenuAsync">Quit to menu</button>
                        </div>
                    </div>
                </div>
            }
        }
        else if (_phase == Phase.Finished)
        {
            <section class="pocabinet-finished" aria-label="Race finished">
                @if (_position <= 3 && !Settings.ReducedMotion)
                {
                    <div class="pocabinet-confetti" aria-hidden="true">
                        @for (var i = 0; i < 24; i++)
                        {
                            var n = i;
                            // Values computed in code-behind helpers — the Razor
                            // expression parser mis-compiles the modulo character
                            // inside markup code blocks, so this file stays free of it.
                            <span style="--cx:@ConfettiX(n);--cd:@ConfettiDelay(n);--cc:@ConfettiColor(n)"></span>
                        }
                    </div>
                }
                <h2>Race finished</h2>
                @if (_isPersonalBest)
                {
                    <p class="pocabinet-pb" role="status">★ New personal best!</p>
                }
                else if (_previousBest > 0)
                {
                    <p class="pocabinet-pbdelta">Personal best: @FormatLapTime(_previousBest)</p>
                }
                <p>Position: <strong>P@_position</strong>/@_totalCars</p>
                @if (_finalStandings is { } standings && standings.Count > 0)
                {
                    <div class="pocabinet-podium" aria-label="Podium">
                        @foreach (var (entry, idx) in standings.Take(3).Select((c, i) => (c, i)))
                        {
                            <div class="pocabinet-podium__step @(entry.IsPlayer ? "pocabinet-podium__step--player" : "")">
                                <span class="pocabinet-podium__medal" aria-hidden="true">@(idx == 0 ? "🥇" : idx == 1 ? "🥈" : "🥉")</span>
                                <strong>@entry.Name</strong>
                                <span class="pocabinet-podium__official">@entry.OfficialId</span>
                            </div>
                        }
                    </div>
                    @if (standings.Count > 3)
                    {
                        <ol class="pocabinet-standings">
                            @foreach (var entry in standings.Skip(3))
                            {
                                <li>@entry.Name — position @entry.Position</li>
                            }
                        </ol>
                    }
                }
                @if (_lastLapSectorTimes.Any(s => s is not null))
                {
                    <div class="pocabinet-laps">
                        <h3>Last lap sectors</h3>
                        <div class="pocabinet-laps__row">
                            @for (var i = 0; i < 3; i++)
                            {
                                var idx = i;
                                <span class="pocabinet-sector @SectorClassFor(_lastLapSectorTimes[idx], idx)">
                                    S@(idx + 1) @(_lastLapSectorTimes[idx] is { } t ? FormatLapTime(t) : "—")
                                </span>
                            }
                        </div>
                        @if (_lapTimes.Count > 0)
                        {
                            <p class="pocabinet-laps__all">
                                Laps:
                                @foreach (var (t, idx) in _lapTimes.Select((t, i) => (t, i)))
                                {
                                    <span>@(idx + 1): @FormatLapTime(t)&nbsp;</span>
                                }
                            </p>
                        }
                    </div>
                }
                <div class="pocabinet-actions">
                    <button class="pocabinet-primary" @onclick="() => _phase = Phase.Start">Back to start</button>
                    <button class="pocabinet-secondary" @onclick="ShareResultAsync">Share result</button>
                    @if (IsMultiplayerMode)
                    {
                        <a class="pocabinet-secondary" href="/pocabinet/multi">Rematch — new lobby</a>
                    }
                </div>
            </section>
        }
    </div>
</GameShell>
