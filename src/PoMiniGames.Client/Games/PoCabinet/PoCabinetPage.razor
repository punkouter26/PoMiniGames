@page "/pocabinet/{ModeSegment}"
@page "/pocabinet"

@using PoMiniGames.Shared.Games
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject GameResultService GameResults
@inject PlayerNameService PlayerNameSvc
@inject PoCabinetSession Session
@inject PoCabinetCareerState Career
@inherits PoCabinetPageBase

<PageTitle>Cabinet · PoMiniGames</PageTitle>

@* The race ends on the shared end-of-game modal: the results are its summary,
   and its one button goes back to the hub. A demo has nobody to press it, so it loops instead.
   No GameKey: the unified leaderboard has no Cabinet board, and the summary carries the podium. *@
<GameShell Title="@TitleContent" Player="@_playerName" BackTo="/" Fullscreen="true"
           GameOver="@(_phase == Phase.Finished && Mode != GameMode.Demo)"
           GameSummary="@ResultsContent">
    <div class="pocabinet-root">
        @if (_phase == Phase.Start)
        {
            @* The shared opening card, like every other game. Not until the stored
               settings are read, so the setup shows the player's own choices from the
               first frame. .pocabinet-intro is display:contents, there so this page's
               scoped CSS can widen the shared card. *@
            @if (_loaded)
            {
                <div class="pocabinet-intro">
                    <GameIntro CueScope="pocabinet"
                               Title="@TitleContent"
                               Objective="@Lede"
                               Controls="@ControlsContent"
                               Options="@(Mode == GameMode.Demo ? null : SetupContent)"
                               Mode="@(Mode == GameMode.Demo ? GameIntro.IntroMode.Demo : GameIntro.IntroMode.OnePlayer)"
                               StartLabel="@(Mode == GameMode.Demo ? null : IsMultiplayerMode ? "Join lobby" : "Start race")"
                               OnStart="StartRaceAsync" />
                </div>
            }
        }
        else if (_phase == Phase.Lobby)
        {
            <PoCabinetLobby InitialTrackId="@_trackId" Color="@PlayerColorHex"
                            OnRaceStarting="OnLobbyRaceStartingAsync" OnExit="LeaveLobbyAsync"
                            OnOpenSettings="OpenDrawerAsync" />
        }
        else
        {
            @* Immersive: games.css hides the app's top bar while this class is on the page, and
               every readout sits on the race view (the lap strip used to be a white band under it). *@
            @* @key: every race gets fresh canvases. Teardown destroys the WebGL context, and a
               restart on the same <canvas> could not get a working one back. *@
            <section @key="_raceSerial" class="pocabinet-race pocabinet-race--immersive @(Mode == GameMode.Demo ? "pocabinet-race--demo" : null)"
                     style="--pocabinet-hud:@Settings.HudScaleCss"
                     aria-label="@(_phase == Phase.Replay ? "Race replay" : "Race in progress")">
                <canvas id="pocabinetCanvas"
                        @ref="_canvas"
                        class="pocabinet-canvas"
                        role="img"
                        tabindex="0"
                        aria-label="Cabinet race view. Drive with W A S D, the arrow keys, a gamepad or the on-screen controls.">
                </canvas>
                <canvas id="pocabinetMinimap" @ref="_minimapCanvas" class="pocabinet-minimap" aria-hidden="true"></canvas>
                @if (Mode == GameMode.Demo && _phase is Phase.Racing or Phase.Finished)
                {
                    @* The demo is covered like a TV race (broadcast.js): a timing tower, a callout, a
                       caption for the car on screen and the frame round the picture-in-picture. Every
                       data-bc text node is rendered EMPTY on purpose and written by JS a few times a second,
                       like the gauge. aria-hidden: an attract loop; the announcer covers the finish. *@
                    <div id="pocabinetBroadcast" class="pocabinet-bc" aria-hidden="true">
                        <div class="pocabinet-bc__tower">
                            <div class="pocabinet-bc__head"><span class="pocabinet-bc__live">Live</span><span class="pocabinet-bc__lap" data-bc="lap"></span></div>
                            @* Blazor's own text (broadcast.js never touches it): where the race is. *@
                            <div class="pocabinet-bc__venue">@PoCabinetCatalog.GetTrack(_trackId).Name</div>
                            <ol class="pocabinet-bc__rows">
                                @for (var i = 0; i < BroadcastRows; i++)
                                {
                                    <li class="pocabinet-bc__row" data-bc-row data-state="off">
                                        <span class="pocabinet-bc__rpos" data-bc="rpos"></span>
                                        <span class="pocabinet-bc__rchip" data-bc="rchip"></span>
                                        <span class="pocabinet-bc__rcode" data-bc="rcode"></span>
                                        <span class="pocabinet-bc__rgap" data-bc="rgap"></span>
                                    </li>
                                }
                            </ol>
                        </div>
                        <div class="pocabinet-bc__callout" data-bc="callout" data-show="off">
                            <b class="pocabinet-bc__ck" data-bc="ck"></b><span class="pocabinet-bc__ct" data-bc="ct"></span>
                        </div>
                        <div class="pocabinet-bc__lower" data-bc="lower" data-show="off">
                            <span class="pocabinet-bc__shot" data-bc="shot"></span>
                            <span class="pocabinet-bc__who">
                                <span class="pocabinet-bc__pos" data-bc="pos"></span>
                                <span class="pocabinet-bc__chip" data-bc="chip"></span>
                                <span class="pocabinet-bc__name" data-bc="name"></span>
                                <span class="pocabinet-bc__style" data-bc="style"></span>
                            </span>
                            <span class="pocabinet-bc__meta" data-bc="meta"></span>
                        </div>
                        <div class="pocabinet-bc__pip" data-bc="pip" data-show="off">
                            <span class="pocabinet-bc__piplabel" data-bc="piplabel"></span>
                        </div>
                    </div>
                }
                @if (_phase == Phase.Racing && !IsSpectating && Mode != GameMode.Demo)
                {
                    @* The driver's cluster: speedometer and damage panel side by side (on a phone,
                       just above the steer pad). race.js writes speed, gear and --rpm (slipstream.js:
                       --tow) into the gauge every frame, straight to the DOM. The speed and gear spans
                       are rendered EMPTY on purpose: Blazor must own no text node inside them, or JS
                       replacing it breaks the renderer's diff ("reading 'Symbol()'"). aria-hidden:
                       the live announcer below covers what matters. *@
                    <div class="pocabinet-cluster" aria-hidden="true">
                        <div id="pocabinetGauge" class="pocabinet-gauge">
                            <span class="pocabinet-gauge__track"></span>
                            <span class="pocabinet-gauge__ring"></span>
                            <span class="pocabinet-gauge__tow"></span>
                            <span class="pocabinet-gauge__speed" data-gauge="speed"></span>
                            <span class="pocabinet-gauge__unit">km/h</span>
                            <span class="pocabinet-gauge__gear" data-gauge="gear"></span>
                        </div>
                        @* Damage panel: race.js writes the --dmg-* zones (0..1) and data-state
                           (ok | hurt | critical | wrecked) straight to the DOM, like the gauge; the
                           words are CSS content, so Blazor owns no text that JS changes. *@
                        <div id="pocabinetDamage" class="pocabinet-damage" data-state="ok">
                            <span class="pocabinet-damage__car">
                                <span class="pocabinet-damage__zone pocabinet-damage__zone--front"></span>
                                <span class="pocabinet-damage__zone pocabinet-damage__zone--rear"></span>
                                <span class="pocabinet-damage__zone pocabinet-damage__zone--left"></span>
                                <span class="pocabinet-damage__zone pocabinet-damage__zone--right"></span>
                                <span class="pocabinet-damage__engine"></span>
                            </span>
                            <span class="pocabinet-damage__bar pocabinet-damage__bar--engine"></span>
                            <span class="pocabinet-damage__bar pocabinet-damage__bar--body"></span>
                        </div>
                    </div>
                    <div class="pocabinet-wreckbanner" aria-hidden="true">Wrecked</div>
                    @if (_lapInvalid)
                    {
                        @* Track limits: all four wheels past the edge this lap. The announcer says it too. *@
                        <div class="pocabinet-limits" aria-hidden="true"><b>Track limits</b> this lap won't count</div>
                    }
                    @* @key re-creates the badge on every place change, so its swoosh replays. Prefixed:
                       the countdown sibling keys on its number, and a bare 3 here collided with it. *@
                    <div @key="PosBadgeKey" class="pocabinet-posbadge @PosBadgeClass" aria-hidden="true">
                        <span class="pocabinet-posbadge__p">P</span>@_position<span class="pocabinet-posbadge__of">/@_totalCars</span>
                    </div>
                }
                <div id="pocabinetDialogueLayer" class="pocabinet-dialogue-layer" aria-hidden="true"></div>

                @* Touch controls: always in the DOM so input.js can bind once; input.js shows
                   them (data-active) on touch screens or when the setting forces them on. *@
                <div id="pocabinetTouch" class="pocabinet-touch" aria-hidden="true">
                    <div class="pocabinet-touch__steer" data-ctl="steer"><span class="pocabinet-touch__knob"></span></div>
                    <button type="button" class="pocabinet-touch__tilt" data-ctl="tilt-enable" tabindex="-1">Enable tilt</button>
                    <div class="pocabinet-touch__pedals">
                        <div class="pocabinet-touch__pedal pocabinet-touch__pedal--brake" data-ctl="brake">Brake</div>
                        <div class="pocabinet-touch__pedal pocabinet-touch__pedal--gas" data-ctl="gas">Gas</div>
                    </div>
                </div>

                @if (_countdownDisplay > 0)
                {
                    @* @key re-creates the element per number, so its entry animation replays each second. *@
                    <div @key="_countdownDisplay" class="pocabinet-countdown" aria-hidden="true">@_countdownDisplay</div>
                }
                else if (_showGo)
                {
                    <div class="pocabinet-countdown pocabinet-countdown--go" aria-hidden="true">GO!</div>
                }
                @if (IsMultiplayerMode && _phase == Phase.Racing && _pingMs is not null)
                {
                    <span class="pocabinet-ping @PingClass" title="Round-trip latency to the race server">@_pingMs ms</span>
                }
                @if (IsSpectating && _phase == Phase.Racing)
                {
                    <span class="pocabinet-spectating" role="status">Spectating — following the leader</span>
                }

                @if (_phase == Phase.Replay)
                {
                    <div class="pocabinet-replaybar" role="group" aria-label="Replay controls">
                        <button type="button" class="app-btn app-btn--primary" @onclick="ToggleReplayAsync" disabled="@_recordingClip"
                                aria-label="@(_replayPlaying ? "Pause replay" : "Play replay")">@(_replayPlaying ? "⏸" : "▶")</button>
                        <input type="range" min="0" max="1000" step="1" aria-label="Replay position"
                               value="@ReplayPermille" @oninput="SeekReplayAsync" disabled="@_recordingClip" />
                        <span class="pocabinet-replaybar__time">@FormatLapTime(_replayT) / @FormatLapTime(_replayDuration)</span>
                        <select aria-label="Replay speed" value="@ReplaySpeedValue" @onchange="SetReplaySpeedAsync" disabled="@_recordingClip">
                            <option value="0.5">½×</option>
                            <option value="1">1×</option>
                            <option value="2">2×</option>
                        </select>
                        <select aria-label="Replay camera" value="@_replayCamera" @onchange="SetReplayCameraAsync" disabled="@_recordingClip">
                            <option value="chase">Chase</option>
                            <option value="tv">TV</option>
                            <option value="far">Far chase</option>
                        </select>
                        <button type="button" class="app-btn app-btn--secondary" @onclick="RecordClipAsync" disabled="@_recordingClip">
                            @(_recordingClip ? "Recording lap…" : "Save best-lap clip")
                        </button>
                        <button type="button" class="app-btn app-btn--secondary" @onclick="ExitReplayAsync" disabled="@_recordingClip">Back to results</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_replayStatus))
                    {
                        <p class="pocabinet-status" role="status">@_replayStatus</p>
                    }
                }
                else
                {
                    @if (Mode != GameMode.Demo)
                    {
                        @* Lap, time, last, best and the sectors, on the race view under the top edge.
                           Speed and place live on the gauge and badge. Not a live region: it
                           re-renders ~15 times a second; the announcer below speaks laps, places
                           and the finish instead. *@
                        <div class="pocabinet-hud">
                            <span class="pocabinet-hud__stats">
                                <span>Lap <strong>@Math.Min(_lap, _totalLaps)</strong>/@_totalLaps</span>
                                <span>Time <strong>@FormatLapTime(_lapSeconds)</strong></span>
                                <span>Last <strong class="@(_lastLapInvalid ? "pocabinet-lap--deleted" : null)" title="@(_lastLapInvalid ? "Deleted: track limits" : null)">@FormatLapTime(_lastLapSeconds)</strong></span>
                                <span>Best <strong>@FormatLapTime(BestLapShown)</strong></span>
                            </span>
                            @SectorChips
                        </div>
                    }
                    <span class="pocabinet-hudbar">
                        <button type="button" class="pocabinet-iconbtn" @onclick="CycleCameraAsync"
                                aria-label="@(Mode == GameMode.Demo ? "Cut to the next shot (C)" : "Change camera (C)")"
                                title="@(Mode == GameMode.Demo ? "The director follows the closest fights · cut to the next shot" : "Change camera (C)")">🎥</button>
                        @if (Pausable)
                        {
                            <button type="button" class="pocabinet-iconbtn" @onclick="TogglePauseAsync"
                                    aria-label="@(_paused ? "Resume race" : "Pause race")">
                                @(_paused ? "▶" : "⏸")
                            </button>
                        }
                    </span>
                }
                @* Screen-reader channel: laps, places, officials' radio lines, the finish. *@
                <p class="pocabinet-sr" role="status" aria-live="polite">@_liveAnnouncement</p>
                @if (IsMultiplayerMode && _phase == Phase.Racing && !string.IsNullOrEmpty(_status))
                {
                    <div class="pocabinet-reconnect" role="alert">
                        <span class="pocabinet-reconnect__spinner" aria-hidden="true"></span>
                        <span>@_status</span>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_status) && _phase == Phase.Racing)
                {
                    <p class="pocabinet-status" role="alert">@_status</p>
                }

            </section>
            @if (_paused)
            {
                @* Modal: showModal() (after render, PoCabinet.showModal) traps focus and makes the
                   page behind inert. Esc is input.js's pause toggle, so the dialog's own Esc-close
                   is cancelled in JS to keep the two from fighting. The card is the race so far
                   and what to do next; the settings are one button away in the drawer. *@
                <dialog id="pocabinetPause" class="pocabinet-overlay" aria-labelledby="pocabinet-pause-title">
                    <div class="pocabinet-overlay__card">
                        <header class="pocabinet-pause__head">
                            <h2 id="pocabinet-pause-title">Paused</h2>
                            <span class="pocabinet-muted">@PoCabinetCatalog.GetTrack(_trackId).Name</span>
                        </header>
                        <dl class="pocabinet-pause__stats">
                            <div><dt>Place</dt><dd>P@(_position)<small>/@_totalCars</small></dd></div>
                            <div><dt>Lap</dt><dd>@Math.Min(_lap, _totalLaps)<small>/@_totalLaps</small></dd></div>
                            <div><dt>Time</dt><dd>@FormatLapTime(_lapSeconds)</dd></div>
                            <div><dt>Best lap</dt><dd>@FormatLapTime(BestLapShown)</dd></div>
                        </dl>
                        @SectorChips
                        <div class="pocabinet-pause__actions">
                            <button class="app-btn app-btn--primary" @onclick="ResumeRaceAsync">Resume</button>
                            <button class="app-btn app-btn--secondary" @onclick="RestartRaceAsync">Restart</button>
                            <button class="app-btn app-btn--secondary" @onclick="OpenDrawerAsync">Settings</button>
                            <button class="app-btn app-btn--ghost" @onclick="QuitToMenuAsync">Quit to menu</button>
                        </div>
                    </div>
                </dialog>
            }
        }
        <PoCabinetDrawer @ref="_drawer" Settings="Settings" SettingsChanged="OnSettingsChangedAsync"
                         ShowPaint="@(_phase == Phase.Lobby)" Livery="@_livery" Color="@_color" PaintChanged="OnPaintChanged" />
    </div>
</GameShell>

@code {
    // One line, for the device in hand (.keys-only / .touch-only, game-shell.css). It used to be
    // two bullets for every device, and the settings panel repeated the keyboard line.
    private RenderFragment ControlsContent => Mode == GameMode.Demo
        ? @<p>Nothing to drive: the camera follows the race</p>
        : @<p class="pocabinet-controls">
            <span class="keys-only"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or arrows drive · <kbd>C</kbd> camera · <kbd>Esc</kbd> pause · a gamepad works too</span>
            <span class="touch-only">On-screen wheel and pedals · 🎥 camera · ⏸ pause</span>
        </p>;

    /// <summary>The sector splits: on the race view and on the pause card.</summary>
    private RenderFragment SectorChips => @<span class="pocabinet-sectors" aria-label="Sector splits">
        @for (var i = 0; i < 3; i++)
        {
            var idx = i;
            <span class="pocabinet-sector @SectorClass(idx)">
                <span class="pocabinet-sector__label">S@(idx + 1)</span>
                @if (_sectorTimes[idx] is { } done)
                {
                    @FormatLapTime(done)
                }
                else if (idx == _sectorIndex && _lastSnapshot is { } ls && ls.Started && !ls.Finished)
                {
                    @FormatLapTime(Math.Max(0, ls.ElapsedRaceTime - _sectorStart))
                }
                else
                {
                    @("—")
                }
            </span>
        }
    </span>;

    // The card's Options slot, the "pit wall": tracks on the left (1P), the garage on the right —
    // your car and its paint, the settings drawer, the last race and who is online. On a phone
    // the two halves are tabs. Online mode has no track list (the lobby host picks it there).
    private RenderFragment SetupContent => @<div class="pocabinet-setup @(IsMultiplayerMode ? "pocabinet-setup--solo-pane" : null) pocabinet-setup--tab-@_setupTab">
        @if (!IsMultiplayerMode)
        {
            <div class="pocabinet-setup__tabs" role="tablist" aria-label="Setup">
                <button type="button" role="tab" aria-selected="@(_setupTab == "tracks" ? "true" : "false")" @onclick="@(() => SetTab("tracks"))">Track</button>
                <button type="button" role="tab" aria-selected="@(_setupTab == "garage" ? "true" : "false")" @onclick="@(() => SetTab("garage"))">Garage</button>
            </div>
            <section class="pocabinet-setup__tracks" aria-label="Tracks">
                <PoCabinetTrackSelector SelectedTrackId="@_trackId" SelectedTrackIdChanged="OnTrackChanged"
                                        Campaign="@(Mode == GameMode.OnePlayer)" BestLaps="@_bestLaps" />
            </section>
        }
        <section class="pocabinet-setup__garage" aria-label="Garage">
            <div class="pocabinet-garage__car">
                <span class="pocabinet-garage__preview" style="--swatch:@PoCabinetPaintShop.PreviewFor(_livery, _color)" aria-hidden="true"></span>
                <span class="pocabinet-garage__name"><strong>Your car</strong><span>@_livery · @_color</span></span>
            </div>
            <PoCabinetPaintShop SelectedLivery="@_livery" SelectedColor="@_color" SelectionChanged="OnPaintChanged" />
            <button type="button" class="pocabinet-garage__settings" @onclick="OpenDrawerAsync">
                <span class="pocabinet-garage__label">Settings &amp; driver aids</span>
                <span class="pocabinet-muted">@SettingsSummary</span>
                <span class="pocabinet-garage__chev" aria-hidden="true">›</span>
            </button>
            <div class="pocabinet-garage__tiles">
                <div class="pocabinet-tile">
                    <span class="pocabinet-tile__label">Last race</span>
                    @if (_lastRace is { } last)
                    {
                        <strong>P@(last.Position)<small>/@last.TotalCars</small></strong>
                        <span class="pocabinet-muted">@PoCabinetCatalog.GetTrack(last.TrackId).Name@(last.BestLapSeconds > 0 ? $" · best {FormatLapTime(last.BestLapSeconds)}" : "")</span>
                    }
                    else
                    {
                        <strong>—</strong>
                        <span class="pocabinet-muted">No race yet</span>
                    }
                </div>
                @if (IsMultiplayerMode)
                {
                    <div class="pocabinet-tile">
                        <span class="pocabinet-tile__label">Lobby now</span>
                        <strong>@OnlineHeadline</strong>
                        <span class="pocabinet-muted">@OnlineDetail</span>
                    </div>
                }
                else
                {
                    <a class="pocabinet-tile pocabinet-tile--link" href="/pocabinet/multi">
                        <span class="pocabinet-tile__label">Online now ›</span>
                        <strong>@OnlineHeadline</strong>
                        <span class="pocabinet-muted">@OnlineDetail</span>
                    </a>
                }
            </div>
            @if (Mode == GameMode.OnePlayer && HasAnyCareerProgress)
            {
                <button class="pocabinet-link" @onclick="ResetCareerAsync" aria-label="Reset career progression">Reset career</button>
            }
        </section>
        @if (!string.IsNullOrEmpty(_status))
        {
            <p class="pocabinet-status" role="alert">@_status</p>
        }
    </div>;

    // The end-of-game modal's summary. A <section>, not a <div>: the modal's own rule for
    // "a div's second and later divs are small print" would shrink the podium. Two columns:
    // the result and the field on the left, the telemetry on the right. The actions carry the
    // ways on (race again, next stage, replay, share); the modal's own button goes to the hub.
    private RenderFragment ResultsContent => @<section class="pocabinet-results__body gps-summary--wide">
        <header class="pocabinet-results__hero">
            @if (!IsSpectating)
            {
                <p class="pocabinet-results__place">P<strong>@_position</strong><small>/@_totalCars</small></p>
            }
            <div class="pocabinet-results__headline">
                <h2>@(_awaitingFinal ? "You're home — waiting for the field…" : "Race finished") <span class="pocabinet-muted">· @PoCabinetCatalog.GetTrack(_trackId).Name</span></h2>
                <p class="pocabinet-results__chips">
                    @if (_isPersonalBest)
                    {
                        <span class="pocabinet-chip pocabinet-chip--pb" role="status">★ New personal best</span>
                    }
                    else if (_previousBest > 0)
                    {
                        <span class="pocabinet-chip">Personal best @FormatLapTime(_previousBest)</span>
                    }
                    @if (CampaignNote is { } note)
                    {
                        <span class="pocabinet-chip @(note.Good ? "pocabinet-chip--good" : null)">@note.Text</span>
                    }
                </p>
            </div>
        </header>
        @if (_debrief is { } debrief)
        {
            <section class="pocabinet-debrief" aria-label="Race engineer">
                <p class="pocabinet-debrief__headline">📰 @debrief.Headline</p>
                <ul class="pocabinet-debrief__tips">
                    @foreach (var tip in debrief.Tips)
                    {
                        <li>@tip</li>
                    }
                </ul>
            </section>
        }
        <div class="pocabinet-results__grid">
            <div class="pocabinet-results__col">
                @if (_finalStandings is { } standings && standings.Count > 0)
                {
                    <ol class="pocabinet-standings" aria-label="Standings">
                        @foreach (var (entry, idx) in standings.Take(3).Select((c, i) => (c, i)))
                        {
                            <li class="pocabinet-standings__podium @(entry.IsLocal ? "pocabinet-standings__me" : null)">
                                <span class="pocabinet-standings__pos" aria-hidden="true">@(idx == 0 ? "🥇" : idx == 1 ? "🥈" : "🥉")</span>
                                <span class="pocabinet-sr">P@(idx + 1)</span>
                                <span class="pocabinet-standings__name">@entry.Name</span>
                                <span class="pocabinet-standings__detail">@entry.Detail</span>
                            </li>
                        }
                        @foreach (var (place, entry) in StandingsBelowPodium(standings))
                        {
                            @if (entry is null)
                            {
                                <li class="pocabinet-standings__gap" aria-hidden="true">⋯</li>
                            }
                            else
                            {
                                @* The place is written out: with gaps in the list the markers (hidden by the reset anyway) would lie. *@
                                <li class="@(entry.IsLocal ? "pocabinet-standings__me" : null)">
                                    <span class="pocabinet-standings__pos">P@(place)</span>
                                    <span class="pocabinet-standings__name">@entry.Name</span>
                                    <span class="pocabinet-standings__detail">@entry.Detail</span>
                                </li>
                            }
                        }
                    </ol>
                }
                @if (LapRows > 0)
                {
                    @* Each lap's sectors and time in one table (it was a "last lap sectors" row and a
                       separate line of lap times). Green: a personal-best sector; violet: this race's best. *@
                    <table class="pocabinet-laps">
                        <caption>Your laps</caption>
                        <thead><tr><th scope="col">Lap</th><th scope="col">S1</th><th scope="col">S2</th><th scope="col">S3</th><th scope="col">Time</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < LapRows; i++)
                            {
                                var row = i;
                                var sectors = row < _lapSectors.Count ? _lapSectors[row] : null;
                                var time = row < _lapTimes.Count ? _lapTimes[row] : 0;
                                var deleted = row < _lapDeleted.Count && _lapDeleted[row];
                                <tr class="@(time > 0 && time == BestValidLap ? "pocabinet-laps__best" : null)">
                                    <th scope="row">@(row + 1)</th>
                                    @for (var s = 0; s < 3; s++)
                                    {
                                        var sec = s;
                                        var t = sectors?[sec];
                                        <td><span class="pocabinet-sector @SectorClassFor(t, sec)">@(t is { } v ? FormatLapTime(v) : "—")</span></td>
                                    }
                                    <td class="@(deleted ? "pocabinet-lap--deleted" : null)" title="@(deleted ? "Deleted: track limits" : null)">@(time > 0 ? FormatLapTime(time) : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            @if (!IsSpectating)
            {
                <div class="pocabinet-telemetry">
                    <h3>Telemetry — best lap@(_hasReferenceLap ? " vs your personal best" : "")</h3>
                    <canvas id="pocabinetTelemetry" class="pocabinet-telemetry__chart" role="img"
                            aria-label="@(_telemetrySummary ?? "Speed, time delta and pedal trace for your best lap")"></canvas>
                    @if (!string.IsNullOrEmpty(_telemetrySummary))
                    {
                        <p class="pocabinet-telemetry__summary">@_telemetrySummary</p>
                    }
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(_status))
        {
            <p class="pocabinet-status" role="status">@_status</p>
        }
        <div class="pocabinet-actions pocabinet-results__more">
            @if (IsMultiplayerMode)
            {
                <button class="app-btn app-btn--primary" @onclick="BackToLobbyAsync">Back to lobby</button>
            }
            else
            {
                @* The modal's own "Play again" reloads to the start card (another track); this
                   one re-grids this track at once. *@
                <button class="app-btn app-btn--primary" @onclick="RestartRaceAsync">Same track again</button>
                @if (NextStageTrackId is { } next)
                {
                    <button class="app-btn app-btn--primary" @onclick="() => RaceTrackAsync(next)">Next stage: @PoCabinetCatalog.GetTrack(next).Name</button>
                }
            }
            <button class="app-btn app-btn--secondary" @onclick="StartReplayAsync">Watch replay</button>
            @if (!IsSpectating)
            {
                @* One menu for Cabinet's own keepsakes: the result card and the best-lap clip
                   used to be two buttons in two places. Not "Share": the modal has its own. *@
                <details class="pocabinet-share">
                    <summary class="app-btn app-btn--secondary">Card or clip</summary>
                    <div class="pocabinet-share__menu">
                        <button type="button" class="app-btn app-btn--secondary" @onclick="ShareResultAsync">Result card (image)</button>
                        <button type="button" class="app-btn app-btn--secondary" @onclick="ShareClipAsync">Best-lap clip (video)</button>
                    </div>
                </details>
            }
        </div>
    </section>;
}
