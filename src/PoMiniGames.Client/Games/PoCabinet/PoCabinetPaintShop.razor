@*
    PoCabinetPaintShop — 4 liveries × 4 colors = 16 swatches. The page reads the stored
    choice (PoCabinetPitWall.PaintKey) before the first render and passes it in; this
    component saves each pick through Blazored.LocalStorage (the framework's preference per
    Program.cs) and raises it. It used to load the stored choice itself without telling the
    page, so a race started in the default paint until a swatch was clicked.
*@

@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage

<div class="pocabinet-paintshop" role="radiogroup" aria-label="Pick a paint job">
    @foreach (var (name, _) in COLORS)
    {
        @foreach (var livery in LIVERIES)
        {
            var isSelected = livery == SelectedLivery && name == SelectedColor;
            var previewBg = PreviewFor(livery, name);
            <button type="button"
                    class="pocabinet-swatch @(isSelected ? "pocabinet-swatch--selected" : null)"
                    role="radio"
                    aria-checked="@(isSelected ? "true" : "false")"
                    aria-label="@livery @name"
                    title="@livery · @name"
                    style="--swatch: @previewBg;"
                    @onclick="() => Select(livery, name)">
            </button>
        }
    }
</div>

@code {
    private static readonly string[] LIVERIES = { "Stripe", "Block", "Split", "Solid" };

    private static readonly (string Name, string Hex)[] COLORS =
    {
        ("Indigo",   "#3470d8"),
        ("Crimson",  "#c0392b"),
        ("Forest",   "#2e7d4f"),
        ("Gold",     "#d4af37"),
    };

    /// <summary>Hex for a paint name — what the car mesh, minimap and the server grid use.</summary>
    public static string HexFor(string? name)
    {
        foreach (var (n, hex) in COLORS)
        {
            if (string.Equals(n, name, StringComparison.OrdinalIgnoreCase)) return hex;
        }
        return COLORS[0].Hex;
    }

    /// <summary>The CSS background that previews a paint job (swatches and the garage's car chip).</summary>
    public static string PreviewFor(string? livery, string? color)
    {
        var hex = HexFor(color);
        // Stripe livery lays the colour over a contrasting base so the
        // pattern reads as a paint job, not a flat swatch.
        var stripeColor = string.Equals(color, "Gold", StringComparison.OrdinalIgnoreCase) ? "#fff" : "#fff8";
        return livery switch
        {
            "Solid" => hex,
            "Block" => $"linear-gradient(135deg, {hex} 0 50%, #ffffff22 50% 100%)",
            "Split" => $"linear-gradient(90deg, {hex} 0 50%, #ffffff22 50% 100%)",
            _ => $"repeating-linear-gradient(45deg, {hex} 0 6px, {stripeColor} 6px 12px)",
        };
    }

    [Parameter] public string? SelectedLivery { get; set; }
    [Parameter] public string? SelectedColor { get; set; }
    [Parameter] public EventCallback<(string Livery, string Color)> SelectionChanged { get; set; }

    private async Task Select(string livery, string color)
    {
        try
        {
            await LocalStorage.SetItemAsStringAsync(PoCabinetPitWall.PaintKey, $"{livery}|{color}");
        }
        catch
        {
            // ignore — the page keeps the choice for the rest of the session
        }
        await SelectionChanged.InvokeAsync((livery, color));
    }
}
