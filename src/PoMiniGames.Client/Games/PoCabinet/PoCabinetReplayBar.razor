@*
    PoCabinetReplayBar — the replay's controls, floating on the bottom of the race view: play,
    scrub, speed, camera, save the best-lap clip, back to the results. race.js plays the
    recording and reports its state through the page (OnReplayStateAsync → SetState).
*@

@using PoMiniGames.Shared.Games
@inject IJSRuntime JS

<div class="pocabinet-replaybar" role="group" aria-label="Replay controls">
    <button type="button" class="app-btn app-btn--primary" @onclick="ToggleAsync" disabled="@_recording"
            aria-label="@(_playing ? "Pause replay" : "Play replay")">@(_playing ? "⏸" : "▶")</button>
    <input type="range" min="0" max="1000" step="1" aria-label="Replay position"
           value="@Permille" @oninput="SeekAsync" disabled="@_recording" />
    <span class="pocabinet-replaybar__time">@PoCabinetCatalog.FormatLap(_t) / @PoCabinetCatalog.FormatLap(_duration)</span>
    <select aria-label="Replay speed" value="@SpeedValue" @onchange="SpeedAsync" disabled="@_recording">
        <option value="0.5">½×</option>
        <option value="1">1×</option>
        <option value="2">2×</option>
    </select>
    <select aria-label="Replay camera" value="@_camera" @onchange="CameraAsync" disabled="@_recording">
        <option value="chase">Chase</option>
        <option value="tv">TV</option>
        <option value="far">Far chase</option>
    </select>
    @if (HasLap)
    {
        @* No clip without a lap that counted: there is nothing to call the best. *@
        <button type="button" class="app-btn app-btn--secondary" @onclick="RecordClipAsync" disabled="@_recording">
            @(_recording ? "Recording lap…" : "Save best-lap clip")
        </button>
    }
    <button type="button" class="app-btn app-btn--secondary" @onclick="OnExit" disabled="@_recording">Back to results</button>
</div>
@if (!string.IsNullOrEmpty(_status))
{
    <p class="pocabinet-status" role="status">@_status</p>
}

@code {
    /// <summary>Back to the results (the page stops the replay).</summary>
    [Parameter] public EventCallback OnExit { get; set; }
    /// <summary>The race has a lap that counted, so there is a best-lap clip to save.</summary>
    [Parameter] public bool HasLap { get; set; }

    private double _t;
    private double _duration;
    private bool _playing = true;
    private string _camera = "chase";
    private double _speed = 1;
    private bool _recording;
    private string? _status;

    private int Permille => _duration > 0 ? (int)Math.Round(_t / _duration * 1000) : 0;
    private string SpeedValue => _speed.ToString(System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>race.js's replay state, a few times a second.</summary>
    public Task SetState(double t, double duration, bool playing, string camera, double speed)
    {
        (_t, _duration, _playing, _camera, _speed) = (t, duration, playing, camera, speed);
        return InvokeAsync(StateHasChanged);
    }

    private Task ToggleAsync() => CommandAsync("toggle", null);

    private Task SeekAsync(ChangeEventArgs e) => CommandAsync("seek", Parse(e.Value?.ToString()) / 1000.0);

    private Task SpeedAsync(ChangeEventArgs e) => CommandAsync("speed", Parse(e.Value?.ToString()));

    private Task CameraAsync(ChangeEventArgs e) => CommandAsync("camera", e.Value?.ToString() ?? "chase");

    private async Task CommandAsync(string command, object? value)
    {
        try { await JS.InvokeVoidAsync("PoCabinet.replayCommand", command, value); }
        catch { /* the replay was torn down */ }
    }

    /// <summary>Record the best lap from the replay (chase cam) and share or download it.</summary>
    private async Task RecordClipAsync()
    {
        _recording = true;
        _status = null;
        StateHasChanged();
        try
        {
            _status = await JS.InvokeAsync<string>("PoCabinet.recordClip") switch
            {
                "shared" => "Clip shared.",
                "downloaded" => "Clip saved to your downloads.",
                "nolap" => "No lap counted, so there is no best lap to save.",
                "cancelled" => null,
                _ => "This browser can't record video clips.",
            };
        }
        catch (Exception ex)
        {
            _status = $"Could not record the clip: {ex.Message}";
        }
        _recording = false;
        StateHasChanged();
    }

    private static double Parse(string? raw) =>
        double.TryParse(raw, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0;
}
