@*
    PoCabinetSetup — the opening card's Options slot, the "pit wall": tracks on the left (1P), the
    garage on the right — your car and its paint, the settings drawer, the last race and who is
    online. On a phone the two halves are tabs. Online mode has no track list (the lobby host
    picks it there). It reads this browser's storage itself (PoCabinetPitWall) each time the
    card opens, so coming back from a race shows what the race just changed.
*@

@using PoMiniGames.Shared.Games
@implements IDisposable
@inject IJSRuntime JS
@inject PoMiniGamesClient.Services.Http.ApiService Api
@inject PoCabinetCareerState Career

<div class="pocabinet-setup @(IsMultiplayer ? "pocabinet-setup--solo-pane" : null) pocabinet-setup--tab-@_tab">
    @if (!IsMultiplayer)
    {
        <div class="pocabinet-setup__tabs" role="tablist" aria-label="Setup">
            <button type="button" role="tab" aria-selected="@(_tab == "tracks" ? "true" : "false")" @onclick="@(() => _tab = "tracks")">Track</button>
            <button type="button" role="tab" aria-selected="@(_tab == "garage" ? "true" : "false")" @onclick="@(() => _tab = "garage")">Garage</button>
        </div>
        <section class="pocabinet-setup__tracks" aria-label="Tracks">
            <PoCabinetTrackSelector SelectedTrackId="@TrackId" SelectedTrackIdChanged="TrackIdChanged"
                                    Campaign="@Campaign" BestLaps="@_bestLaps" />
        </section>
    }
    <section class="pocabinet-setup__garage" aria-label="Garage">
        <div class="pocabinet-garage__car">
            <span class="pocabinet-garage__preview" style="--swatch:@PoCabinetPaintShop.PreviewFor(Livery, Color)" aria-hidden="true"></span>
            <span class="pocabinet-garage__name"><strong>Your car</strong><span>@Livery · @Color</span></span>
        </div>
        <PoCabinetPaintShop SelectedLivery="@Livery" SelectedColor="@Color" SelectionChanged="PaintChanged" />
        <button type="button" class="pocabinet-garage__settings" @onclick="OnOpenSettings">
            <span class="pocabinet-garage__label">Settings &amp; driver aids</span>
            <span class="pocabinet-muted">@SettingsSummary</span>
            <span class="pocabinet-garage__chev" aria-hidden="true">›</span>
        </button>
        <div class="pocabinet-garage__tiles">
            <div class="pocabinet-tile">
                <span class="pocabinet-tile__label">Last race</span>
                @if (_lastRace is { } last)
                {
                    <strong>P@(last.Position)<small>/@last.TotalCars</small></strong>
                    <span class="pocabinet-muted">@PoCabinetCatalog.GetTrack(last.TrackId).Name@(last.BestLapSeconds > 0 ? $" · best {PoCabinetCatalog.FormatLap(last.BestLapSeconds)}" : "")</span>
                }
                else
                {
                    <strong>—</strong>
                    <span class="pocabinet-muted">No race yet</span>
                }
            </div>
            @if (IsMultiplayer)
            {
                <div class="pocabinet-tile">
                    <span class="pocabinet-tile__label">Lobby now</span>
                    <strong>@OnlineHeadline</strong>
                    <span class="pocabinet-muted">@OnlineDetail</span>
                </div>
            }
            else
            {
                <a class="pocabinet-tile pocabinet-tile--link" href="/pocabinet/multi">
                    <span class="pocabinet-tile__label">Online now ›</span>
                    <strong>@OnlineHeadline</strong>
                    <span class="pocabinet-muted">@OnlineDetail</span>
                </a>
            }
        </div>
        @if (Campaign && HasCareerProgress)
        {
            <button class="pocabinet-link" @onclick="Career.ResetAsync" aria-label="Reset career progression">Reset career</button>
        }
    </section>
    @if (!string.IsNullOrEmpty(Status))
    {
        <p class="pocabinet-status" role="alert">@Status</p>
    }
</div>

@code {
    [Parameter] public bool IsMultiplayer { get; set; }
    /// <summary>1P: the campaign bar, stage tags and the career reset.</summary>
    [Parameter] public bool Campaign { get; set; }
    [Parameter] public string? TrackId { get; set; }
    [Parameter] public EventCallback<string> TrackIdChanged { get; set; }
    [Parameter] public string? Livery { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public EventCallback<(string Livery, string Color)> PaintChanged { get; set; }
    [Parameter, EditorRequired] public PoCabinetUiSettings Settings { get; set; } = new();
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    /// <summary>Why the last start failed, if it did.</summary>
    [Parameter] public string? Status { get; set; }

    /// <summary>Phones: which half shows ("tracks" | "garage"); desktop shows both.</summary>
    private string _tab = "tracks";
    private Dictionary<string, double> _bestLaps = new(StringComparer.OrdinalIgnoreCase);
    private PoCabinetLastRace? _lastRace;
    private PoCabinetLobbySummary? _lobbySummary;

    private bool HasCareerProgress => Career.Current.CompletedStages.Count > 0 || Career.Current.TrophyUnlocked;

    private string SettingsSummary =>
        $"Assist {Settings.SteeringAssist} · {(Settings.AutoBrake ? "auto-brake" : "no auto-brake")} · {Settings.Weather}";

    private string OnlineHeadline => _lobbySummary is not { } s ? "—"
        : s.Players == 1 ? "1 driver" : $"{s.Players} drivers";

    private string OnlineDetail => _lobbySummary switch
    {
        null => "Lobby status unavailable",
        { InRace: true } => "Racing now — you'll join the next one",
        { Players: 0 } => "Nobody yet — open it and host",
        var s => $"Waiting on {PoCabinetCatalog.GetTrack(s.TrackId).Name}",
    };

    protected override async Task OnInitializedAsync()
    {
        Career.Changed += OnCareerChanged;
        // The "Online now" tile: one anonymous GET, never awaited by the first render.
        _ = RefreshLobbySummaryAsync();
        try
        {
            _bestLaps = PoCabinetPitWall.ParseBestLaps(await JS.InvokeAsync<string?>("localStorage.getItem", PoCabinetPitWall.RecordsKey));
            _lastRace = PoCabinetPitWall.ParseLastRace(await JS.InvokeAsync<string?>("localStorage.getItem", PoCabinetPitWall.LastRaceKey));
        }
        catch { /* storage unavailable — the tiles say so */ }
    }

    private async Task RefreshLobbySummaryAsync()
    {
        _lobbySummary = await Api.GetPoCabinetLobbySummaryAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnCareerChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Career.Changed -= OnCareerChanged;
}
