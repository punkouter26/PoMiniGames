@* BPM configuration card for PoClick - adapted from PoClick *@

@{
    const int FixedBpm = 100;
    var bpmInterval = 60.0 / FixedBpm;
}

<div class="cyber-card mb-4 mt-2" style="--bpm-interval: @(bpmInterval)s;">
    <div class="bpm-ambient-bg"></div>
    <div class="bpm-ambient-content">
        <h1 class="display-5 mb-3 font-heading glow-title">
            Timing Trainer
        </h1>
        <p class="text-secondary mb-4">
            Test your internal metronome. Listen to the steady beat and tap the <strong>SPACEBAR</strong> precisely on the click.
            Maintain a steady rhythm for @_duration seconds to get your stability profile and score.
        </p>

        <!-- BPM display (fixed at 100) -->
        <div class="mb-4 text-start">
            <label class="form-label text-muted text-uppercase font-monospace label-sm mb-2">
                Tempo: <span class="text-white font-weight-bold font-heading bpm-display-value">@FixedBpm BPM</span>
            </label>
        </div>

        <!-- Duration selector -->
        <div class="d-flex gap-2 mb-2 mt-2">
            @foreach (var d in new int[] { 10, 20 })
            {
                var dur = d;
                <button type="button" class="btn flex-fill font-monospace btn-duration @(_duration == dur ? "active" : "")"
                        @onclick="() => SetDurationAsync(dur)">
                    @dur<span class="bpm-unit">s</span>
                </button>
            }
        </div>
        <div class="d-flex gap-2 mt-1">
            <button class="cyber-btn flex-fill py-3" @onclick="OnStartCountdown">
                Start @(_duration)s Trainer
            </button>
            <button class="preview-toggle @(IsPreviewPlaying ? "active" : "")" @onclick="OnPreviewToggle" title="Preview tempo at selected BPM">
                @(IsPreviewPlaying ? "⏹" : "▶") Preview
            </button>
        </div>
    </div><!-- /bpm-ambient-content -->
</div>

@code {
    [Parameter] public int Bpm { get; set; }
    [Parameter] public EventCallback<int> BpmChanged { get; set; }
    [Parameter] public int Duration { get; set; } = 10;
    [Parameter] public EventCallback<int> DurationChanged { get; set; }
    [Parameter] public bool IsPreviewPlaying { get; set; }
    [Parameter] public EventCallback OnStartCountdown { get; set; }
    [Parameter] public EventCallback OnPreviewToggle { get; set; }

    private int _bpm;
    private int _duration;

    protected override void OnParametersSet()
    {
        _bpm = Bpm;
        _duration = Duration;
    }

    private async Task OnSliderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newBpm))
        {
            _bpm = newBpm;
            await BpmChanged.InvokeAsync(_bpm);
        }
    }

    private async Task SetBpmAsync(int bpm)
    {
        _bpm = bpm;
        await BpmChanged.InvokeAsync(bpm);
    }

    private async Task SetDurationAsync(int d)
    {
        _duration = d;
        await DurationChanged.InvokeAsync(d);
    }
}