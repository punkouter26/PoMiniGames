@* Game play HUD for PoClick - adapted from PoClick *@

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="cyber-card">
            <!-- HUD Top Bar -->
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
                <div>
                    <span class="text-muted text-uppercase font-monospace label-sm">Tempo</span>
                    <h4 class="mb-0 font-heading text-cyan">@Bpm BPM</h4>
                </div>
                <div class="text-center">
                    <span class="text-muted text-uppercase font-monospace label-sm">Time Remaining</span>
                    <h2 class="mb-0 font-monospace text-danger font-heading hud-time">
                        @TimeLeft<span class="hud-time-unit">s</span>
                    </h2>
                </div>
                <div class="text-end">
                    <button class="btn btn-outline-danger btn-sm" @onclick="OnAbort">Abort</button>
                </div>
            </div>

            <!-- Beat Visualizer Space -->
            <div class="visualizer-container @(MissFlash ? "miss-flash" : "")" @onclick="OnTap" style="cursor: pointer; touch-action: manipulation;">
                <div class="tempo-line"></div>

                <!-- Pulse expanding ring -->
                <div class="beat-pulse-ring @(IsFlashing ? "active" : "")"></div>

                <!-- Pulsing beat center -->
                <div class="beat-center @(IsFlashing ? "flash" : "")">
                    <i class="rzi beat-icon @(IsFlashing ? "flash" : "")" style="font-size: 3rem;">music_note</i>
                </div>

                <!-- Feedback splash text -->
                <div class="feedback-banner @(ShowFeedback ? "show" : "") @(FeedbackClass)">
                    @FeedbackText
                    @if (LastOffsetMs != 0 && FeedbackText != "MISS")
                    {
                        <div class="feedback-offset">
                            @(LastOffsetMs > 0 ? "+" : "")@($"{LastOffsetMs:0}")ms
                        </div>
                    }
                </div>
            </div>

            <!-- HUD Dashboard bottom -->
            <div class="hud-grid mt-4">
                <div class="hud-item @(StreakGlow ? "updated" : "")">
                    <div class="hud-label">Streak</div>
                    <div class="hud-value" style="color: var(--accent-yellow);">@CurrentStreak</div>
                </div>
                <div class="hud-item @(ScoreGlow ? "updated" : "")">
                    <div class="hud-label">Points</div>
                    <div class="hud-value" style="color: var(--accent-cyan);">@RunningScore</div>
                </div>
                <div class="hud-item @(PerfectsGlow ? "updated" : "")">
                    <div class="hud-label">Perfects</div>
                    <div class="hud-value" style="color: var(--accent-green);">@PerfectCount</div>
                </div>
                <div class="hud-item @(MissesGlow ? "updated" : "")">
                    <div class="hud-label">Misses</div>
                    <div class="hud-value" style="color: var(--accent-red);">@MissCount</div>
                </div>
            </div>

            <div class="tap-instruction">
                Tap SPACEBAR or tap the circle on the beat!
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Bpm { get; set; }
    [Parameter] public int TimeLeft { get; set; }
    [Parameter] public int CurrentStreak { get; set; }
    [Parameter] public int RunningScore { get; set; }
    [Parameter] public int PerfectCount { get; set; }
    [Parameter] public int MissCount { get; set; }
    [Parameter] public bool IsFlashing { get; set; }
    [Parameter] public bool ShowFeedback { get; set; }
    [Parameter] public string FeedbackText { get; set; } = "";
    [Parameter] public string FeedbackClass { get; set; } = "";
    [Parameter] public double LastOffsetMs { get; set; }
    [Parameter] public bool StreakGlow { get; set; }
    [Parameter] public bool ScoreGlow { get; set; }
    [Parameter] public bool PerfectsGlow { get; set; }
    [Parameter] public bool MissesGlow { get; set; }
    [Parameter] public bool MissFlash { get; set; }
    [Parameter] public EventCallback OnAbort { get; set; }
    [Parameter] public EventCallback OnTap { get; set; }
}