@page "/couplequiz/game"
@using PoMiniGamesClient.Games.PoCoupleQuiz.Services
@using PoMiniGamesClient.Components
@inject CoupleQuizHubService Hub
@inject PlayerNameService PlayerNameService
@inject MatchHistoryService MatchHistory
@inject NavigationManager Navigation
@implements IAsyncDisposable

@* 2026-07-16: this page wrapped GameShell but never passed GameOver, so the
   multiplayer finale rendered as an inline block *below the still-live question
   input* instead of the shared end-of-game modal every other game uses. It now
   ends on the same modal, with the match's final scores as the summary and the
   game's all-time top 3 underneath. BackTo is "/" so OK lands on the main menu
   like everywhere else. *@
<GameShell Title=@TitleContent Player="@_playerName" BackTo="/"
           GameOver="@(_phase == "GameOver")"
           GameKey="pocouplequiz"
           GameSummary="@GameSummaryContent">
    @if (_gameStarted is null)
    {
        // NetRun10 audit #8: if the player landed on /game without ever joining
        // a lobby (deep-link, refresh mid-game, or wrong navigation), the page
        // used to spin forever on "Waiting for the round to start…". After a
        // short grace period, route them back to the lobby with a one-shot
        // banner so they understand what happened.
        @if (_showLobbyHint)
        {
            <div class="cq-gameover">
                <h2 class="gps-phase-h">You haven't joined a game yet</h2>
                <p>This page is only useful mid-round. Pick or create a lobby and the host will start a game for you.</p>
                <a class="gps-btn gps-btn--primary" href="/couplequiz">Go to lobby →</a>
            </div>
        }
        else
        {
            <p>Waiting for the round to start…</p>
        }
    }
    else
    {
        <div class="cq-game">
            <h2 class="gps-phase-h">Round @(_gameStarted.RoundIndex + 1) of @_gameStarted.MaxRounds</h2>
            @if (_isKing)
            {
                <p class="cq-king">👑 You are the King. Type your secret answer below — the others will try to match.</p>
            }
            <p class="cq-question">@_currentQuestion</p>
            <input @bind="_myAnswer" placeholder="@(_isKing ? "Your secret answer (1-2 words)" : "Your guess")" maxlength="60" />
            <div class="cq-actions">
                <button class="gps-btn gps-btn gps-btn--primary" @onclick="Submit" disabled="@string.IsNullOrWhiteSpace(_myAnswer)">Submit</button>
            </div>

            @if (_phase == "Results")
            {
                <div class="cq-results">
                    <h3>Round result</h3>
                    <p>King's answer: <strong>@(_lastKingAnswer ?? "?")</strong></p>
                    @if (_lastResult is not null)
                    {
                        <p>Matched: @string.Join(", ", _lastResult.MatchedPlayers)</p>
                        <h4>Scores</h4>
                        <ul>
                            @foreach (var kv in _lastResult.Scores.OrderByDescending(x => x.Value))
                            {
                                <li>@kv.Key — @kv.Value</li>
                            }
                        </ul>
                    }
                </div>
                @if (_isHost)
                {
                    <button class="gps-btn gps-btn gps-btn--primary" @onclick="NextRound">Next round</button>
                }
                else
                {
                    <p>Waiting for the host to start the next round…</p>
                }
            }

            @* The game-over block that used to render here now goes through the
               shared modal — see GameSummaryContent below. *@
        </div>
    }
</GameShell>

@code {
    private RenderFragment TitleContent => @<span>💕 Couple Quiz · Game</span>;

    // This match's final scores, highest first. The all-time top 3 is rendered
    // separately by GameShell from GameKey.
    private RenderFragment GameSummaryContent => @<div>
        <div>Final scores</div>
        @foreach (var kv in (_gameOver?.FinalScores ?? new Dictionary<string, int>()).OrderByDescending(x => x.Value))
        {
            <div>@kv.Key — <strong>@kv.Value</strong></div>
        }
    </div>;

    private string _playerName = string.Empty;
    private string _myAnswer = string.Empty;
    private bool _isKing;
    private bool _isHost;
    private string _phase = "Answering"; // Answering | Results | GameOver
    private string _currentQuestion = string.Empty;
    private string? _lastKingAnswer;
    private CoupleQuizGameStartedPayload? _gameStarted;
    private CoupleQuizRoundResultPayload? _lastResult;
    private CoupleQuizGameOverPayload? _gameOver;
    // NetRun10 audit #8: if no game starts within 4s of landing here, show
    // the lobby redirect hint instead of an infinite spinner.
    private bool _showLobbyHint;
    private CancellationTokenSource? _lobbyHintCts;

    protected override async Task OnInitializedAsync()
    {
        _playerName = PlayerNameService.GetPlayerName();
        Hub.OnGameStarted += HandleGameStarted;
        Hub.OnRoundStarted += HandleRoundStarted;
        Hub.OnAnswerRecorded += HandleAnswerRecorded;
        Hub.OnRoundResult += HandleRoundResult;
        Hub.OnGameOver += HandleGameOver;
        Hub.OnGameError += msg => Console.Error.WriteLine($"[PoCoupleQuiz] {msg}");
        try
        {
            await Hub.ConnectAsync();
        }
        catch
        {
            // If the hub isn't connected we just sit at "waiting for round to start".
        }

        // GameStarted fired while the lobby was still mounted (it drove the navigation
        // here), so we won't see it as a live event. Hydrate from the buffered payload.
        if (Hub.LastGameStarted is not null)
        {
            HandleGameStarted(Hub.LastGameStarted);
        }

        // NetRun10 audit #8: kick off the dead-end watchdog. If no GameStarted
        // payload arrives in 4s, surface the "go to lobby" hint.
        _lobbyHintCts = new CancellationTokenSource();
        _ = WatchForLobbyHintAsync(_lobbyHintCts.Token);
    }

    private async Task WatchForLobbyHintAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), ct);
            if (_gameStarted is null && !ct.IsCancellationRequested)
            {
                _showLobbyHint = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { /* expected when game starts */ }
    }

    // SignalR `.On` callbacks run outside Blazor's render loop, so each handler marshals
    // a StateHasChanged onto the renderer's context to repaint. (HandleGameStarted is also
    // invoked synchronously from OnInitializedAsync for the buffered payload — harmless there.)
    private void HandleGameStarted(CoupleQuizGameStartedPayload p)
    {
        _gameStarted = p;
        _currentQuestion = p.QuestionText;
        _isKing = _playerName == p.KingPlayerName;
        _isHost = _playerName == p.Players[0].Name; // first to join = host per the server's design
        _phase = "Answering";
        _myAnswer = string.Empty;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleRoundStarted(CoupleQuizRoundStartedPayload p)
    {
        _currentQuestion = p.QuestionText;
        _isKing = _playerName == p.KingPlayerName;
        _phase = "Answering";
        _myAnswer = string.Empty;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleAnswerRecorded(CoupleQuizAnswerRecordedPayload p)
    {
        // No-op; the round result arrives separately. The page can show a "waiting" hint
        // when all-but-the-current-player have answered — left as a future enhancement.
    }

    private void HandleRoundResult(CoupleQuizRoundResultPayload p)
    {
        _lastResult = p;
        _lastKingAnswer = p.KingAnswer;
        _phase = "Results";
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleGameOver(CoupleQuizGameOverPayload p)
    {
        _gameOver = p;
        _phase = "GameOver";
        _ = InvokeAsync(StateHasChanged);
        _ = RecordOutcomesAsync(p);
    }

    // Record a head-to-head result against every other player, scored by final points.
    private async Task RecordOutcomesAsync(CoupleQuizGameOverPayload p)
    {
        if (!p.FinalScores.TryGetValue(_playerName, out var myScore)) return;
        foreach (var (name, score) in p.FinalScores)
        {
            if (name == _playerName) continue;
        _lobbyHintCts?.Cancel();
        _lobbyHintCts?.Dispose();
            var outcome = myScore > score ? MatchOutcome.Win
                        : myScore < score ? MatchOutcome.Loss
                        : MatchOutcome.Draw;
            await MatchHistory.RecordAsync("pocouplequiz", MatchMode.Multiplayer, name, outcome);
        }
    }

    private async Task Submit()
    {
        if (_gameStarted is null || string.IsNullOrWhiteSpace(_myAnswer) || string.IsNullOrEmpty(_gameStarted.GameCode)) return;
        await Hub.SubmitAnswerAsync(_gameStarted.GameCode, _myAnswer.Trim(), _gameStarted.RoundIndex);
    }

    private async Task NextRound()
    {
        if (_gameStarted is null) return;
        await Hub.RequestNextRoundAsync(_gameStarted.GameCode);
    }

    // Detach handlers only — the scoped hub service (shared with the lobby) owns the
    // SignalR connection; disposing it here would kill it for any later navigation.
    public ValueTask DisposeAsync()
    {
        Hub.OnGameStarted -= HandleGameStarted;
        Hub.OnRoundStarted -= HandleRoundStarted;
        Hub.OnAnswerRecorded -= HandleAnswerRecorded;
        Hub.OnRoundResult -= HandleRoundResult;
        Hub.OnGameOver -= HandleGameOver;
        return ValueTask.CompletedTask;
    }
}
