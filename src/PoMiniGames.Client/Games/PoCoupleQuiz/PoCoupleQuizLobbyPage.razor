@* The ONE Couple Quiz lobby page.

   Until 2026-08-10 there were two, both hand-maintained and drifted apart:
   PoCoupleQuizPage (/couplequiz, /couplequiz/{Mode}) and this one
   (/couplequiz/multi, /couplequiz/lobby). Only this one had busy-state guards on
   the join buttons, a retry path when the hub was wedged, and a ready tick in the
   player list; only the other one connected to the hub before the player had
   dismissed the intro. Everything now lands here, so those routes are all bound to
   this single component.

   Couple Quiz is multiplayer-only (user decision, 2026-08-10). The solo "vs AI
   partner" mode was a 16-question hardcoded bank whose "partner" was a fixed
   answer index — a coin flip with no AI in it and no relation to the real game —
   and the kiosk demo mode was unreachable dead code, since this game was never in
   GameCatalog.Demo's reel. Both are gone. *@
@page "/couplequiz"
@page "/couplequiz/multi"
@page "/couplequiz/lobby"
@using PoMiniGamesClient.Games.PoCoupleQuiz.Services
@using PoMiniGamesClient.Components
@inject CoupleQuizHubService Hub
@inject PlayerNameService PlayerNameService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Couple Quiz · PoMiniGames</PageTitle>

<GameShell Title=@TitleContent Player="@_playerName" BackTo="/">
    @* OnePlayer is the "one person is reading this screen" intro mode. There is
       no Multiplayer member; TwoPlayer means a shared-device ready-up, which
       this isn't.
       This comment must stay OUTSIDE the <GameIntro /> attribute list — Razor
       otherwise parses the entire Razor-comment block as an attribute name,
       and the runtime throws InvalidCharacterError from setAttribute (taking
       the whole page render with it). See Index.razor for the same warning. *@
    @if (!_introDone)
    {
        <GameIntro CueScope="quiz"
                   Title="@TitleContent"
                   Objective="Match your partner's answers. Each round one of you is the King and types a secret answer; everyone else tries to match it."
                   Controls="@HowToPlayContent"
                   Mode="GameIntro.IntroMode.OnePlayer"
                   OnStart="OnIntroStartAsync" />
    }
    else if (!_isConnected)
    {
        <p>Connecting…</p>
    }
    else if (_lobby is null)
    {
        <div class="gps-game-card">
            <h2 class="gps-phase-h">Multiplayer · Couple Quiz</h2>
            <h3 class="gps-game-h">💕 Join the lobby</h3>
            <p>
                Two or more players answer questions about each other. Each round one player is
                the King and types the secret answer; everyone else tries to match it — scored
                by AI. The King seat moves round the table every round.
            </p>
            @* There is exactly one lobby, so there is nothing to name and nothing to look up.
               The game-code box and its "Join by code" button are gone (user decision,
               2026-08-10) — the old "Find or create a lobby" button already auto-joined the
               first waiting lobby, so the code was almost always a slower path to the same
               place, with "the code may be invalid" as its own failure mode. *@
            <label>Your name: <input @bind="_playerName" maxlength="24" disabled="@_busy" /></label>
            <div class="gps-row">
                @* Bug fix QA #6: aria-busy + disabled state while the SignalR handshake
                   is in flight, so the primary button cannot fire twice on touch. *@
                <button class="gps-cta"
                        aria-busy="@_busy"
                        disabled="@_busy"
                        @onclick="OnJoin">
                    @(_busy ? "Joining…" : "Join the lobby")
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="gps-error">
                    @_error
                    <button class="gps-btn gps-btn--secondary" @onclick="RetryConnect">Retry</button>
                </p>
            }
        </div>
    }
    else
    {
        <div class="gps-game-card">
            <h2 class="gps-phase-h">Lobby</h2>
            <h3 class="gps-game-h">💕 Waiting for players</h3>
            <p>Host: <strong>@_lobby.HostName</strong></p>

            @* Rounds is host-only. It used to be a "Difficulty" select every player saw,
               which mapped to nothing but the round count — and belonged to whoever created
               the lobby, so a joiner picked "Hard", had it silently discarded, and got no
               hint why. Non-hosts now read the value instead of setting it. *@
            @if (_lobby.IsHost)
            {
                <label>
                    Rounds:
                    <select value="@_lobby.MaxRounds" @onchange="OnRoundsChanged">
                        @foreach (var n in RoundChoices)
                        {
                            <option value="@n">@n rounds</option>
                        }
                    </select>
                </label>
            }
            else
            {
                <p>Rounds: <strong>@_lobby.MaxRounds</strong></p>
            }

            <h3>Players (@_lobby.Players.Count)</h3>
            <ul>
                @foreach (var p in _lobby.Players)
                {
                    var isReady = _lobby.ReadyPlayers.Contains(p);
                    <li>@p @(p == _lobby.HostName ? "👑" : "") @(isReady ? "✅" : "")</li>
                }
            </ul>

            @* One start path. The host's "Start game" button used to sit beside the
               ready-up flow and race it — the server auto-started the moment everyone was
               ready anyway, so the button could only ever start a match early or do nothing. *@
            <div class="cq-actions">
                <button class="gps-btn gps-btn--primary" disabled="@_ready" @onclick="OnReady">
                    @(_ready ? "Ready ✓" : "I'm ready")
                </button>
            </div>
            <p class="cq-hint">
                @(_lobby.Players.Count < 2
                    ? "Waiting for another player to join…"
                    : "The match starts as soon as everyone is ready.")
            </p>
        </div>
    }
</GameShell>

@code {
    private static readonly int[] RoundChoices = [3, 5, 7];

    private RenderFragment TitleContent => @<span><span aria-hidden="true">💕</span> Couple Quiz</span>;

    // Intro/welcome gate — the controls card shows first; only on OK do we connect
    // to the lobby hub (so the player doesn't appear to others until they're ready).
    private bool _introDone;
    private RenderFragment HowToPlayContent => @<div>
        <p>Answer questions about each other. Each round one player is the King and locks a secret answer; everyone else tries to match it — matches score points.</p>
        <ul>
            <li>Type your answer and submit — the round scores itself once everyone is in</li>
            <li>The King seat rotates every round, so you both get asked about</li>
            <li>Rounds are timed; whatever you've typed when the clock runs out is what counts</li>
        </ul>
    </div>;

    private string _playerName = string.Empty;
    private string? _error;
    private bool _isConnected;
    private bool _busy;
    private bool _ready;
    private CoupleQuizLobbyEventPayload? _lobby;

    protected override void OnInitialized()
    {
        // Only wire the hub handlers here — the connection itself waits for the
        // intro's OK (see OnIntroStartAsync) so the player joins the lobby only
        // after seeing the controls.
        _playerName = PlayerNameService.GetPlayerName();
        Hub.OnLobbyJoined += HandleLobbyJoined;
        Hub.OnLobbyUpdated += HandleLobbyUpdated;
        Hub.OnPlayerDisconnected += HandleLobbyUpdated;
        Hub.OnLobbyError += HandleError;
        Hub.OnGameStarted += HandleGameStarted;
    }

    private async Task OnIntroStartAsync()
    {
        _introDone = true;
        StateHasChanged();
        try
        {
            await Hub.ConnectAsync();
            _isConnected = true;
        }
        catch (Exception ex)
        {
            _error = $"Could not connect: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task OnJoin()
    {
        if (_busy || _lobby is not null) return;
        if (string.IsNullOrWhiteSpace(_playerName)) { _error = "Enter a name."; return; }
        PlayerNameService.SetPlayerName(_playerName);
        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            await Hub.JoinAsync(_playerName);
        }
        catch (Exception ex)
        {
            _error = $"Could not join the lobby: {ex.Message}";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task RetryConnect()
    {
        _error = null;
        try
        {
            await Hub.ConnectAsync();
            _isConnected = true;
        }
        catch (Exception ex)
        {
            _error = $"Retry failed: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task OnReady()
    {
        if (_lobby is null || _ready) return;
        _ready = true;
        await Hub.SetReadyAsync();
    }

    private async Task OnRoundsChanged(ChangeEventArgs e)
    {
        if (_lobby is null || !int.TryParse(e.Value?.ToString(), out var rounds)) return;
        await Hub.SetRoundsAsync(rounds);
    }

    // NB: SignalR `.On` callbacks run outside Blazor's render loop, so each handler
    // must marshal a StateHasChanged onto the renderer's context — otherwise the UI
    // only repaints when some *other* UI event happens to fire (a latent race that
    // left the lobby stuck on the join card even after the server created it).
    private void HandleLobbyJoined(CoupleQuizLobbyEventPayload p)
    {
        // A malformed payload used to overwrite _lobby with null and trigger a
        // NullReferenceException render loop (audit #5).
        if (p is null)
        {
            _error = "The server returned an empty lobby. Please try again.";
            _ = InvokeAsync(StateHasChanged);
            return;
        }
        _lobby = p;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleLobbyUpdated(CoupleQuizLobbyUpdatedPayload p)
    {
        if (p is null || _lobby is null) return;
        _lobby = _lobby with
        {
            Players = p.Players,
            ReadyPlayers = p.ReadyPlayers,
            HostName = p.HostName,
            MaxRounds = p.MaxRounds,
            // The host can leave, and whoever is promoted needs the rounds control.
            IsHost = string.Equals(p.HostName, _lobby.PlayerName, StringComparison.Ordinal),
        };
        // The server clears ready flags when a match ends and the lobby reopens.
        _ready = p.ReadyPlayers.Contains(_lobby.PlayerName);
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleError(string? message)
    {
        // Null/empty guard — the UI renders @_error directly and crashes on
        // null string interpolation otherwise.
        _error = string.IsNullOrEmpty(message)
            ? "An unknown error occurred. Please try again."
            : message;
        _ = InvokeAsync(StateHasChanged);
    }

    // The match auto-starts once everyone readies up, which broadcasts GameStarted to the
    // whole lobby. Move every player to the board; the hub service buffers the payload so
    // the game page hydrates from it on mount.
    private void HandleGameStarted(CoupleQuizGameStartedPayload _) =>
        Navigation.NavigateTo("/couplequiz/game");

    // NOTE: do NOT dispose the hub here. CoupleQuizHubService is a scoped (app-lifetime)
    // singleton shared with the game page — disposing it on navigation would tear down
    // the live SignalR connection the game page depends on. We only detach our handlers;
    // the DI container owns the connection's lifetime.
    public ValueTask DisposeAsync()
    {
        Hub.OnLobbyJoined -= HandleLobbyJoined;
        Hub.OnLobbyUpdated -= HandleLobbyUpdated;
        Hub.OnPlayerDisconnected -= HandleLobbyUpdated;
        Hub.OnLobbyError -= HandleError;
        Hub.OnGameStarted -= HandleGameStarted;
        return ValueTask.CompletedTask;
    }
}
