@page "/couplequiz/multi"
@page "/couplequiz/lobby"
@using PoMiniGamesClient.Games.PoCoupleQuiz.Services
@using PoMiniGamesClient.Components
@inject CoupleQuizHubService Hub
@inject PlayerNameService PlayerNameService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<GameShell Title=@TitleContent Player="@_playerName" BackTo="/couplequiz">
    @if (!_introDone)
    {
        <GameIntro Title="@TitleContent"
                   Objective="Play Couple Quiz online — match your partner's answers to score. Join a lobby, then the host starts."
                   Controls="@HowToPlayContent"
                   Mode="GameIntro.IntroMode.OnePlayer"
                   OnStart="OnIntroStartAsync" />
    }
    else if (!_isConnected)
    {
        <p>Connecting…</p>
    }
    else if (_lobby is null)
    {
        <div class="gps-game-card">
            <h2 class="gps-phase-h">Multiplayer · Couple Quiz</h2>
            <h3 class="gps-game-h">💕 Join a lobby</h3>
            <p>Two or more players answer questions about each other. The "King" types the secret answer; the rest try to match — scored by AI.</p>
            <label>Your name: <input @bind="_playerName" maxlength="24" disabled="@_busy" /></label>
            <label>Difficulty:
                <select @bind="_difficulty" disabled="@_busy">
                    <option value="Easy">Easy (3 rounds)</option>
                    <option value="Medium" selected>Medium (5 rounds)</option>
                    <option value="Hard">Hard (7 rounds)</option>
                </select>
            </label>
            <label>Game code (optional):
                <input @bind="_joinCode" maxlength="6" disabled="@_busy" />
            </label>
            <div class="gps-row">
                @* Bug fix QA #6: aria-busy + disabled state while the SignalR handshake
                   is in flight, so the primary button cannot fire twice on touch. *@
                <button class="gps-cta"
                        aria-busy="@_busy"
                        disabled="@_busy"
                        @onclick="OnJoinOrCreate">
                    @(_busy ? "Connecting…" : "Find or create a lobby")
                </button>
                <button class="gps-btn gps-btn--secondary"
                        aria-busy="@_busyJoin"
                        disabled="@(_busyJoin || string.IsNullOrWhiteSpace(_joinCode))"
                        @onclick="OnJoinByCode">
                    @(_busyJoin ? "Joining…" : "Join by code")
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="gps-error">
                    @_error
                    <button class="gps-btn gps-btn--secondary" @onclick="RetryConnect">Retry</button>
                </p>
            }
        </div>
    }
    else
    {
        <div class="gps-game-card">
            <h2 class="gps-phase-h">Lobby · @_lobby.GameCode</h2>
            <h3 class="gps-game-h">💕 Waiting for players</h3>
            <p>Difficulty: <strong>@_lobby.Difficulty</strong> · AI mode: <strong>@_lobby.AiMode</strong></p>
            <p>Host: <strong>@_lobby.HostName</strong></p>
            <h3>Players (@_lobby.Players.Count)</h3>
            <ul>
                @foreach (var p in _lobby.Players)
                {
                    var isReady = _lobby.ReadyPlayers.Contains(p);
                    <li>@p @(p == _lobby.HostName ? "👑" : "") @(isReady ? "✅" : "")</li>
                }
            </ul>
            <div class="cq-actions">
                <button class="gps-btn gps-btn gps-btn--primary" @onclick="OnReady">I'm ready</button>
            </div>
            @if (_lobby.IsHost && _lobby.Players.Count >= 2)
            {
                <div class="cq-actions">
                    <button class="gps-btn gps-btn gps-btn--secondary" @onclick="OnStart">Start game</button>
                </div>
            }
        </div>
    }
</GameShell>

@code {
    private RenderFragment TitleContent => @<span>💕 Couple Quiz · Lobby</span>;

    // Intro/welcome gate — the controls card shows first; only on OK do we connect
    // to the lobby hub (so the player doesn't appear to others until they're ready).
    private bool _introDone;
    private RenderFragment HowToPlayContent => @<div>
        <p>Answer questions about each other. The "King" locks a secret answer; everyone else tries to match it — matches score points.</p>
        <ul>
            <li>Tap the option you think matches your partner</li>
            <li>Wait for another player to join, ready up, then the host starts</li>
        </ul>
    </div>;

    private string _playerName = string.Empty;
    private string _difficulty = "Medium";
    private string? _joinCode;
    private string? _error;
    private bool _isConnected;
    private bool _busy;
    private bool _busyJoin;
    private CoupleQuizLobbyEventPayload? _lobby;

    protected override void OnInitialized()
    {
        // Only wire the hub handlers here — the connection itself waits for the
        // intro's OK (see OnIntroStartAsync) so the player joins the lobby only
        // after seeing the controls.
        _playerName = PlayerNameService.GetPlayerName();
        Hub.OnLobbyCreated += HandleLobbyCreated;
        Hub.OnLobbyJoined += HandleLobbyJoined;
        Hub.OnLobbyUpdated += HandleLobbyUpdated;
        Hub.OnLobbyError += HandleError;
        Hub.OnGameStarted += HandleGameStarted;
    }

    private async Task OnIntroStartAsync()
    {
        _introDone = true;
        StateHasChanged();
        try
        {
            await Hub.ConnectAsync();
            _isConnected = true;
        }
        catch (Exception ex)
        {
            _error = $"Could not connect: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task OnJoinOrCreate()
    {
        if (_busy || _lobby is not null) return;
        if (string.IsNullOrWhiteSpace(_playerName)) { _error = "Enter a name."; return; }
        PlayerNameService.SetPlayerName(_playerName);
        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            // Cap the wait at 5 s; if the hub is silently wedged, surface a retry path
            // rather than leaving the user staring at "Connecting…" forever.
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            await Hub.JoinOrCreateAsync(_playerName, _difficulty);
        }
        catch (Exception ex)
        {
            _error = $"Could not join lobby: {ex.Message}";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task OnJoinByCode()
    {
        if (_busyJoin || _lobby is not null) return;
        if (string.IsNullOrWhiteSpace(_joinCode)) { _error = "Enter a code."; return; }
        PlayerNameService.SetPlayerName(_playerName);
        _busyJoin = true;
        _error = null;
        StateHasChanged();
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            await Hub.JoinLobbyAsync(_joinCode.Trim().ToUpperInvariant(), _playerName);
        }
        catch (Exception ex)
        {
            _error = $"Could not join by code: {ex.Message}";
        }
        finally
        {
            _busyJoin = false;
            StateHasChanged();
        }
    }

    private async Task RetryConnect()
    {
        _error = null;
        try
        {
            await Hub.ConnectAsync();
            _isConnected = true;
        }
        catch (Exception ex)
        {
            _error = $"Retry failed: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task OnReady()
    {
        if (_lobby is null) return;
        await Hub.SetReadyAsync(_lobby.GameCode);
    }

    private async Task OnStart()
    {
        if (_lobby is null) return;
        await Hub.StartGameAsync(_lobby.GameCode);
    }

    // NB: SignalR `.On` callbacks run outside Blazor's render loop, so each handler
    // must marshal a StateHasChanged onto the renderer's context — otherwise the UI
    // only repaints when some *other* UI event happens to fire (a latent race that
    // left the lobby stuck on the join card even after the server created it).
    private void HandleLobbyCreated(CoupleQuizLobbyEventPayload p)
    {
        _lobby = p;
        _ = InvokeAsync(StateHasChanged);
    }
    private void HandleLobbyJoined(CoupleQuizLobbyEventPayload p)
    {
        _lobby = p;
        _ = InvokeAsync(StateHasChanged);
    }
    private void HandleLobbyUpdated(CoupleQuizLobbyUpdatedPayload p)
    {
        if (_lobby is not null && _lobby.GameCode == p.GameCode)
        {
            _lobby = _lobby with
            {
                Players = p.Players,
                ReadyPlayers = p.ReadyPlayers,
                HostName = p.HostName,
                Difficulty = p.Difficulty ?? _lobby.Difficulty,
                AiMode = p.AiMode ?? _lobby.AiMode
            };
            _ = InvokeAsync(StateHasChanged);
        }
    }
    private void HandleError(string message)
    {
        _error = message;
        _ = InvokeAsync(StateHasChanged);
    }

    // The game auto-starts once everyone readies up (or the host hits "Start game"),
    // which broadcasts GameStarted to the whole group. Move every player to the board;
    // the hub service buffers the payload so the game page hydrates from it on mount.
    private void HandleGameStarted(CoupleQuizGameStartedPayload _) =>
        Navigation.NavigateTo("/couplequiz/game");

    // NOTE: do NOT dispose the hub here. CoupleQuizHubService is a scoped (app-lifetime)
    // singleton shared with the game page — disposing it on navigation would tear down
    // the live SignalR connection the game page depends on. We only detach our handlers;
    // the DI container owns the connection's lifetime.
    public ValueTask DisposeAsync()
    {
        Hub.OnLobbyCreated -= HandleLobbyCreated;
        Hub.OnLobbyJoined -= HandleLobbyJoined;
        Hub.OnLobbyUpdated -= HandleLobbyUpdated;
        Hub.OnLobbyError -= HandleError;
        Hub.OnGameStarted -= HandleGameStarted;
        return ValueTask.CompletedTask;
    }
}
