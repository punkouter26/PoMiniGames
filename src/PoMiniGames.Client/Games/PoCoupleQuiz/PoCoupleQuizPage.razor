@page "/couplequiz"
@using PoMiniGamesClient.Games.PoCoupleQuiz.Services
@using PoMiniGamesClient.Components
@inject CoupleQuizHubService Hub
@inject PlayerNameService PlayerNameService
@inject NavigationManager Navigation
@inject KioskCoordinator Kiosk
@implements IAsyncDisposable

<GameShell Title=@TitleContent Player="@_playerName" BackTo="/"
           GameOver="@(_solo && _soloFinished && !_isDemo)"
           OnPlayAgain="StartSolo"
           GameSummary="@GameSummaryContent">
    @if (_solo)
    {
        @if (_isDemo)
        {
            @* Demo renders the multiplayer shell so the kiosk viewer sees a
               "live multiplayer game" — same .cq-game/.cq-results/.cq-gameover
               markup + same .gps-btn classes that the real /couplequiz/game page uses. *@
            <div class="cq-game">
                <h2 class="gps-phase-h">@(_demoPhase == DemoPhase.GameOver ? "Game over" : $"Round {_soloRound + 1} of {_soloQuestions.Count}")</h2>
                @if (_demoIsKing && _demoPhase == DemoPhase.Answering)
                {
                    <p class="cq-king">👑 You are the King. Type your secret answer below — the others will try to match.</p>
                }
                <p class="cq-question">@CurrentSoloQuestion.Text</p>
                <input @bind="_demoAnswer"
                       placeholder="@(_demoIsKing ? "Your secret answer (1-2 words)" : "Your guess")"
                       maxlength="60"
                       readonly />
                <div class="cq-actions">
                    <button class="gps-btn gps-btn gps-btn--primary" disabled>
                        @(_demoPhase == DemoPhase.Results ? "Submitted ✓" : (_demoIsKing ? "Lock secret" : "Submit"))
                    </button>
                </div>

                @if (_demoPhase == DemoPhase.Results)
                {
                    <div class="cq-results">
                        <h3>Round result</h3>
                        <p>King's answer: <strong>@_demoKingAnswer</strong></p>
                        @if (_demoMatchedPlayers.Count > 0)
                        {
                            <p>Matched: @string.Join(", ", _demoMatchedPlayers)</p>
                        }
                        <h4>Scores</h4>
                        <ul>
                            @foreach (var kv in _demoRoundScores.OrderByDescending(x => x.Value))
                            {
                                <li>@kv.Key — @kv.Value</li>
                            }
                        </ul>
                    </div>
                }

                @if (_demoPhase == DemoPhase.GameOver)
                {
                    <div class="cq-gameover">
                        <h3>Final scores</h3>
                        <ol>
                            @foreach (var kv in _demoFinalScores.OrderByDescending(x => x.Value))
                            {
                                <li>@kv.Key — @kv.Value</li>
                            }
                        </ol>
                        <a class="gps-btn gps-btn gps-btn--primary" href="/couplequiz/leaderboard">View leaderboard</a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="cq-solo">
                @if (!_soloFinished)
                {
                    <h2 class="gps-phase-h">Solo · Round @(_soloRound + 1) of @_soloQuestions.Count</h2>
                    <p>Score: <strong>@_soloScore</strong></p>
                    <p class="cq-solo-question"><strong>@CurrentSoloQuestion.Text</strong></p>
                    @if (!_soloRevealed)
                    {
                        <div class="cq-actions cq-actions--wrap">
                            @for (int i = 0; i < CurrentSoloQuestion.Options.Length; i++)
                            {
                                var idx = i;
                                <button class="gps-btn gps-btn gps-btn--secondary" @onclick="() => SoloPick(idx)">@CurrentSoloQuestion.Options[idx]</button>
                            }
                        </div>
                    }
                    else
                    {
                        <p>Your partner picked: <strong>@CurrentSoloQuestion.Options[CurrentSoloQuestion.PartnerIndex]</strong></p>
                        <p>@(_soloLastMatch ? $"💞 Match! +{_soloLastPoints}" : "💔 No match")</p>
                        @if (_soloStreak > 1)
                        {
                            <p>🔥 Streak: <strong>@_soloStreak</strong></p>
                        }
                        <button class="gps-btn gps-btn gps-btn--primary" @onclick="SoloNext">@(_soloRound + 1 < _soloQuestions.Count ? "Next" : "See results")</button>
                    }
                }
                @* Solo results are shown in the shared end-of-game modal (GameSummaryContent). *@
            </div>
        }
    }
    else if (!_isConnected)
    {
        <div class="cq-connecting">
            <p>Connecting to the game server…</p>
        </div>
    }
    else if (_lobby is null)
    {
        <div class="cq-join">
            <h2 class="gps-phase-h">Lobby</h2>
            <p>Two or more players answer questions about each other. The "King" types the secret answer; the rest try to match — scored by AI.</p>
            <label>
                Your name:
                <input type="text" @bind="_playerName" maxlength="24" />
            </label>
            <label>
                Difficulty:
                <select @bind="_difficulty">
                    <option value="Easy">Easy (3 rounds)</option>
                    <option value="Medium" selected>Medium (5 rounds)</option>
                    <option value="Hard">Hard (7 rounds)</option>
                </select>
            </label>
            <label>
                Game code (optional — leave blank to auto-join a shared lobby):
                <input type="text" @bind="_joinCode" maxlength="6" />
            </label>
            <div class="cq-actions">
                <button class="gps-btn gps-btn gps-btn--primary" @onclick="OnJoinOrCreate">Find or create a lobby</button>
                <button class="gps-btn gps-btn gps-btn--secondary" @onclick="OnJoinByCode" disabled="@string.IsNullOrWhiteSpace(_joinCode)">Join by code</button>
            </div>
            <p class="cq-solo-hint">No second player? <strong>Play solo</strong> against an AI partner — guess what they'd pick.</p>
            <div class="cq-actions">
                <button class="gps-btn gps-btn gps-btn--secondary" @onclick="StartSolo">Play solo (vs AI partner)</button>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="cq-error">@_error</p>
            }
        </div>
    }
    else
    {
        <div class="cq-lobby">
            <h2>Lobby <code>@_lobby.GameCode</code></h2>
            <p>Difficulty: <strong>@_lobby.Difficulty</strong> · AI mode: <strong>@_lobby.AiMode</strong></p>
            <p>Host: <strong>@_lobby.HostName</strong></p>
            <h3>Players</h3>
            <ul>
                @foreach (var p in _lobby.Players)
                {
                    <li>@p @(p == _lobby.HostName ? "👑" : "")</li>
                }
            </ul>
            <h3>Ready</h3>
            <ul>
                @foreach (var p in _lobby.ReadyPlayers)
                {
                    <li>✓ @p</li>
                }
            </ul>
            <div class="cq-actions">
                <button class="gps-btn gps-btn gps-btn--primary" @onclick="OnReady">I'm ready</button>
            </div>
            @if (_lobby.IsHost && _lobby.Players.Count >= 2)
            {
                <div class="cq-actions">
                    <button class="gps-btn gps-btn gps-btn--secondary" @onclick="OnStart">Start game</button>
                </div>
            }
        </div>
    }
</GameShell>

@code {
    [SupplyParameterFromQuery(Name = "demo")] public int DemoQuery { get; set; } = 0;
    [SupplyParameterFromQuery(Name = "kiosk")] public int KioskNext { get; set; } = -1;

    private RenderFragment TitleContent => @<span>💕 PoCoupleQuiz</span>;

    private RenderFragment GameSummaryContent => @<div>
        <div>You matched your partner <strong>@_soloMatches</strong> / @_soloQuestions.Count times.</div>
        <div>Score: <strong>@_soloScore</strong></div>
    </div>;

    private string _playerName = string.Empty;
    private string _difficulty = "Medium";
    private string? _joinCode;
    private string? _error;
    private bool _isConnected;
    private CoupleQuizLobbyEventPayload? _lobby;

    // ── Solo mode (offline, no hub, no AI service) ───────────────────────────
    private bool _solo;
    private int _soloRound;
    private int _soloScore;
    private int _soloMatches;
    private int _soloStreak;
    private int _soloLastPoints;
    private bool _soloRevealed;
    private bool _soloLastMatch;
    private bool _soloFinished;
    private List<SoloQ> _soloQuestions = new();

    // ── Demo mode (kiosk auto-cycle, mirrors BabyTouchPage demo pattern) ─────
    private bool _isDemo;
    private System.Threading.Timer? _demoTimer;
    private System.Threading.Timer? _demoTypeTimer;
    // Demo runs as a simulated multiplayer game: two players ("You" and
    // "Partner"), a King/Guesser role that flips per round, and the same
    // .cq-game / .cq-results / .cq-gameover markup the multiplayer shell
    // uses. State below tracks the per-round "live" UI.
    private const string DemoYouName = "You";
    private const string DemoPartnerName = "Partner";
    private enum DemoPhase { Answering, Results, GameOver }
    private DemoPhase _demoPhase;
    private bool _demoIsKing;
    private string _demoAnswer = string.Empty;
    private string _demoKingAnswer = string.Empty;
    private List<string> _demoMatchedPlayers = new();
    private Dictionary<string, int> _demoRoundScores = new();
    private Dictionary<string, int> _demoFinalScores = new();
    private int _demoTypeIndex;
    private string _demoTypeTarget = string.Empty;

    private SoloQ CurrentSoloQuestion => _soloQuestions[_soloRound];

    private static readonly SoloQ[] SoloBank =
    {
        new("Your ideal first date?", new[] { "Dinner & a movie", "Hiking adventure", "Cozy night in", "Theme park" }, 2),
        new("Favourite way to relax together?", new[] { "Binge a series", "Cook a meal", "Go for a walk", "Play games" }, 1),
        new("Dream vacation?", new[] { "Beach resort", "City exploring", "Mountain cabin", "Road trip" }, 0),
        new("Pet you'd adopt together?", new[] { "Dog", "Cat", "Something exotic", "No pets" }, 0),
        new("Saturday morning vibe?", new[] { "Sleep in", "Farmers market", "Gym session", "Big breakfast" }, 3),
        new("Go-to date snack?", new[] { "Popcorn", "Ice cream", "Chocolate", "Chips" }, 1),
        new("Music for a road trip?", new[] { "Pop hits", "Classic rock", "Lo-fi chill", "Throwback 90s" }, 2),
        new("Best gift to receive?", new[] { "Handwritten note", "Tech gadget", "Experience day", "Something cosy" }, 0),
        new("How do you settle a disagreement?", new[] { "Rock paper scissors", "Talk it out", "Coin flip", "Compromise" }, 3),
        new("The perfect evening ends with?", new[] { "Stargazing", "Late-night snack", "A good movie", "Dancing" }, 0),
        new("Favourite season for a date?", new[] { "Spring", "Summer", "Autumn", "Winter" }, 2),
        new("Coffee order of choice?", new[] { "Black coffee", "Latte", "Tea instead", "Hot chocolate" }, 1),
        new("Dream night out?", new[] { "Concert", "Comedy club", "Fancy dinner", "Game night" }, 0),
        new("Most-used emoji?", new[] { "😂", "❤️", "👍", "🔥" }, 1),
        new("Ideal weekend trip?", new[] { "Camping", "Spa retreat", "City break", "Stay home" }, 2),
        new("Who picks the movie?", new[] { "You", "Them", "Take turns", "Flip for it" }, 2),
    };

    protected override async Task OnInitializedAsync()
    {
        _playerName = PlayerNameService.GetPlayerName();
        Hub.OnLobbyCreated += HandleLobbyCreated;
        Hub.OnLobbyJoined += HandleLobbyJoined;
        Hub.OnLobbyUpdated += HandleLobbyUpdated;
        Hub.OnLobbyError += HandleError;
        Hub.OnGameStarted += HandleGameStarted;
        Hub.OnGameError += HandleError;

        try
        {
            await Hub.ConnectAsync();
            _isConnected = true;
        }
        catch (Exception ex)
        {
            _error = $"Could not connect to the game server: {ex.Message}";
        }

        if (DemoQuery == 1)
        {
            _isDemo = true;
            // Demo bypasses the lobby (which needs a second player) and runs
            // solo on a timer. Hand off the cross-demo rotate to the shared
            // KioskCoordinator so the 20s advance is owned in one place.
            Kiosk.SetCurrent("couplequiz-demo");
            StartSolo();
            if (_soloQuestions.Count > 0)
            {
                StartDemoRound();
            }
        }
    }

    // ── Demo round driver ───────────────────────────────────────────────────
    // Single-shot timers drive a round through three beats:
    //   1. typing animation fills the bound input character-by-character
    //   2. submit → phase flips to Results, results panel renders
    //   3. either advance to next round OR show GameOver
    // Total ≈ 7s per round × 5 rounds ≈ 35s — fits the kiosk dwell nicely
    // before the KioskCoordinator rotates away.
    private void StartDemoRound()
    {
        _demoTypeTimer?.Dispose();
        _demoTimer?.Dispose();

        // Reset per-round UI.
        _demoPhase = DemoPhase.Answering;
        _demoAnswer = string.Empty;
        _demoMatchedPlayers = new();
        _demoRoundScores = new();
        _demoIsKing = (_soloRound % 2) == 0; // alternate role per round

        // Choose what to "type":
        //  - You-as-King:    type a short secret answer (King's only input).
        //  - You-as-Guesser: type the partner's option to guarantee a match.
        //  - Partner-as-King: free — the King input is shown empty while we
        //                      reveal the partner's picked option below.
        if (_demoIsKing)
        {
            _demoTypeTarget = PickShortAnswer();
        }
        else
        {
            // Guesser: type the partner's option to guarantee a match.
            _demoTypeTarget = CurrentSoloQuestion.Options[CurrentSoloQuestion.PartnerIndex];
        }
        _demoTypeIndex = 0;

        // Compute the King's secret answer for this round:
        //   - if YOU are King: it's whatever you type (we'll reveal it
        //     after submit using _demoTypeTarget).
        //   - if PARTNER is King: it's the partner's option index.
        if (!_demoIsKing)
        {
            _demoKingAnswer = CurrentSoloQuestion.Options[CurrentSoloQuestion.PartnerIndex];
        }

        // Begin the typing animation after a short pause so the viewer can
        // see the empty input + question first.
        _demoTypeTimer = new System.Threading.Timer(_ => InvokeAsync(DemoTypeTick), null, 700, 60);
        InvokeAsync(StateHasChanged);
    }

    // Pick a short, plausible secret answer from the available options where
    // possible (so the King's typed text matches one of the visible buttons
    // — looks plausible), falling back to a hard-coded short word.
    private string PickShortAnswer()
    {
        var opts = CurrentSoloQuestion.Options;
        // Prefer the partner's option (visual symmetry between King & Guesser
        // in this demo simulation) but pick any option if length is short.
        if (opts[CurrentSoloQuestion.PartnerIndex].Length <= 14)
        {
            return opts[CurrentSoloQuestion.PartnerIndex];
        }
        // Otherwise pick the shortest option.
        return opts.OrderBy(o => o.Length).First();
    }

    private void DemoTypeTick()
    {
        if (!_isDemo) return;
        if (_demoPhase != DemoPhase.Answering) return;

        if (_demoTypeIndex >= _demoTypeTarget.Length)
        {
            // Typing done — flip to Results after a short pause.
            _demoTypeTimer?.Dispose();
            _demoTypeTimer = null;
            _demoTimer = new System.Threading.Timer(_ => InvokeAsync(DemoSubmit), null, 600, Timeout.Infinite);
            return;
        }
        _demoAnswer = _demoTypeTarget.Substring(0, _demoTypeIndex + 1);
        _demoTypeIndex++;
        InvokeAsync(StateHasChanged);
    }

    private void DemoSubmit()
    {
        if (!_isDemo) return;

        // Resolve the King's secret answer.
        if (_demoIsKing)
        {
            // The King wrote _demoTypeTarget (the short answer we picked).
            _demoKingAnswer = _demoTypeTarget;
        }

        // Decide who matched. For visual symmetry, the demo always matches:
        //   - You-as-King: Partner is a random Guesser who happens to type
        //     the same option the King typed (we don't show their typing).
        //   - Partner-as-King: Guesser (You) typed the partner's option → match.
        _demoMatchedPlayers = new List<string>();
        bool isRoundWin;
        if (_demoIsKing)
        {
            // King wrote something that we picked from one of the visible
            // options — the partner (demo's invisible Guesser) is treated
            // as having typed the same option exactly, so both "match" the
            // King's secret. Visually: only the partner shows up matched
            // (the King already knows the answer by definition).
            _demoMatchedPlayers.Add(DemoPartnerName);
            isRoundWin = true;
        }
        else
        {
            // You typed the partner's option → match for You.
            _demoMatchedPlayers.Add(DemoYouName);
            isRoundWin = true;
        }

        // Per-round score copy mirroring multiplayer semantics (10 per
        // matched player; loser earns 0).
        _demoRoundScores = new Dictionary<string, int>
        {
            [DemoYouName] = _demoMatchedPlayers.Contains(DemoYouName) ? 10 : 0,
            [DemoPartnerName] = _demoMatchedPlayers.Contains(DemoPartnerName) ? 10 : 0,
        };

        if (!_demoFinalScores.ContainsKey(DemoYouName)) _demoFinalScores[DemoYouName] = 0;
        if (!_demoFinalScores.ContainsKey(DemoPartnerName)) _demoFinalScores[DemoPartnerName] = 0;
        _demoFinalScores[DemoYouName] += _demoRoundScores[DemoYouName];
        _demoFinalScores[DemoPartnerName] += _demoRoundScores[DemoPartnerName];

        // Also keep the legacy solo bookkeeping in sync so the GameOver
        // formula and any future solo-derived state don't drift.
        if (isRoundWin)
        {
            _soloMatches++;
            _soloStreak++;
            _soloLastPoints = 10;
            _soloScore += 10;
        }

        _demoPhase = DemoPhase.Results;
        InvokeAsync(StateHasChanged);

        // After showing the results panel for ~3.5s, advance OR show GameOver.
        var isLast = _soloRound + 1 >= _soloQuestions.Count;
        _demoTimer?.Dispose();
        _demoTimer = new System.Threading.Timer(_ => InvokeAsync(DemoAdvance),
                                                null,
                                                isLast ? 4000 : 3500,
                                                Timeout.Infinite);
    }

    private void DemoAdvance()
    {
        if (!_isDemo) return;
        _demoTimer?.Dispose();
        _demoTimer = null;

        if (_soloRound + 1 >= _soloQuestions.Count)
        {
            _soloFinished = true;
            _demoPhase = DemoPhase.GameOver;
            InvokeAsync(StateHasChanged);
        }
        else
        {
            // Reset reveal flags and move to next round.
            _soloRound++;
            _soloRevealed = false;
            _soloLastMatch = false;
            StartDemoRound();
        }
    }

    private async Task OnJoinOrCreate()
    {
        if (string.IsNullOrWhiteSpace(_playerName))
        {
            _error = "Please enter a name.";
            return;
        }
        PlayerNameService.SetPlayerName(_playerName);
        await Hub.JoinOrCreateAsync(_playerName, _difficulty);
    }

    private async Task OnJoinByCode()
    {
        if (string.IsNullOrWhiteSpace(_playerName) || string.IsNullOrWhiteSpace(_joinCode))
        {
            _error = "Please enter both a name and a game code.";
            return;
        }
        PlayerNameService.SetPlayerName(_playerName);
        await Hub.JoinLobbyAsync(_joinCode.Trim().ToUpperInvariant(), _playerName);
    }

    private async Task OnReady()
    {
        if (_lobby is null) return;
        await Hub.SetReadyAsync(_lobby.GameCode);
    }

    private async Task OnStart()
    {
        if (_lobby is null) return;
        await Hub.StartGameAsync(_lobby.GameCode);
    }

    private void HandleLobbyCreated(CoupleQuizLobbyEventPayload p)
    {
        // BUG FIX (audit #5): a malformed SignalR payload (null / partial
        // shape) used to overwrite _lobby with null and trigger an
        // Arg_NullReferenceException render loop. Guard against null + empty
        // game code so the UI shows a recoverable error instead of crashing.
        if (p is null || string.IsNullOrEmpty(p.GameCode))
        {
            _error = "Server returned an empty lobby. Please try again.";
            _ = InvokeAsync(StateHasChanged);
            return;
        }
        _lobby = p;
        // SignalR `.On` callbacks run outside the render loop — marshal a repaint.
        _ = InvokeAsync(StateHasChanged);
    }
    private void HandleLobbyJoined(CoupleQuizLobbyEventPayload p) => HandleLobbyCreated(p);
    private void HandleLobbyUpdated(CoupleQuizLobbyUpdatedPayload p)
    {
        if (p is null || string.IsNullOrEmpty(p.GameCode)) return;
        if (_lobby is not null && _lobby.GameCode == p.GameCode)
        {
            _lobby = _lobby with
            {
                Players = p.Players,
                ReadyPlayers = p.ReadyPlayers,
                HostName = p.HostName,
                Difficulty = p.Difficulty ?? _lobby.Difficulty,
                AiMode = p.AiMode ?? _lobby.AiMode
            };
            _ = InvokeAsync(StateHasChanged);
        }
    }
    private void HandleError(string? message)
    {
        // Null/empty guard — the UI renders @_error directly and crashes on
        // null string interpolation otherwise.
        _error = string.IsNullOrEmpty(message)
            ? "An unknown error occurred. Please try again."
            : message;
        _ = InvokeAsync(StateHasChanged);
    }

    // ── Solo mode handlers ───────────────────────────────────────────────────
    private void StartSolo()
    {
        var rounds = _difficulty switch { "Easy" => 3, "Hard" => 7, _ => 5 };
        rounds = Math.Min(rounds, SoloBank.Length);
        _soloQuestions = SoloBank.OrderBy(_ => Random.Shared.Next()).Take(rounds).ToList();
        _soloRound = 0;
        _soloScore = 0;
        _soloMatches = 0;
        _soloStreak = 0;
        _soloLastPoints = 0;
        _soloRevealed = false;
        _soloLastMatch = false;
        _soloFinished = false;
        _solo = true;
    }

    private void SoloPick(int idx)
    {
        if (_soloRevealed) return;
        _soloLastMatch = idx == CurrentSoloQuestion.PartnerIndex;
        if (_soloLastMatch)
        {
            _soloStreak++;
            _soloMatches++;
            // 10 per match, plus a growing streak bonus (capped) for consecutive hits.
            _soloLastPoints = 10 + Math.Min((_soloStreak - 1) * 5, 15);
            _soloScore += _soloLastPoints;
        }
        else
        {
            _soloStreak = 0;
            _soloLastPoints = 0;
        }
        _soloRevealed = true;
    }

    private void SoloNext()
    {
        if (_soloRound + 1 >= _soloQuestions.Count) { _soloFinished = true; return; }
        _soloRound++;
        _soloRevealed = false;
    }

    private sealed record SoloQ(string Text, string[] Options, int PartnerIndex);

    private void HandleGameStarted(CoupleQuizGameStartedPayload p)
    {
        // Everyone readied up (or the host pressed Start) — move to the game board.
        // The hub service buffers this payload so the game page hydrates from it.
        Navigation.NavigateTo("/couplequiz/game");
    }

    // NOTE: do NOT dispose the hub here — CoupleQuizHubService is a scoped
    // (app-lifetime) singleton shared with the lobby and game pages. Disposing it on
    // navigation would tear down the live SignalR connection the next page needs. We
    // only detach our handlers; the DI container owns the connection's lifetime.
    public ValueTask DisposeAsync()
    {
        _demoTimer?.Dispose();
        _demoTimer = null;
        _demoTypeTimer?.Dispose();
        _demoTypeTimer = null;
        Hub.OnLobbyCreated -= HandleLobbyCreated;
        Hub.OnLobbyJoined -= HandleLobbyJoined;
        Hub.OnLobbyUpdated -= HandleLobbyUpdated;
        Hub.OnLobbyError -= HandleError;
        Hub.OnGameStarted -= HandleGameStarted;
        Hub.OnGameError -= HandleError;
        return ValueTask.CompletedTask;
    }
}
