@page "/couplequiz"
@using PoMiniGamesClient.Games.PoCoupleQuiz.Services
@using PoMiniGamesClient.Components
@inject CoupleQuizHubService Hub
@inject PlayerNameService PlayerNameService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<GameShell Title=@TitleContent Player="@_playerName" BackTo="/" ShowSettings="false"
           GameOver="@(_solo && _soloFinished)"
           OnPlayAgain="StartSolo"
           GameSummary="@GameSummaryContent">
    @if (_solo)
    {
        <div class="cq-solo">
            @if (!_soloFinished)
            {
                <h2 class="gps-phase-h">Solo · Round @(_soloRound + 1) of @_soloQuestions.Count</h2>
                <p>Score: <strong>@_soloScore</strong></p>
                <p class="cq-solo-question"><strong>@CurrentSoloQuestion.Text</strong></p>
                @if (!_soloRevealed)
                {
                    <div class="cq-actions" style="flex-wrap:wrap;">
                        @for (int i = 0; i < CurrentSoloQuestion.Options.Length; i++)
                        {
                            var idx = i;
                            <button class="cq-btn cq-btn-secondary" @onclick="() => SoloPick(idx)">@CurrentSoloQuestion.Options[idx]</button>
                        }
                    </div>
                }
                else
                {
                    <p>Your partner picked: <strong>@CurrentSoloQuestion.Options[CurrentSoloQuestion.PartnerIndex]</strong></p>
                    <p>@(_soloLastMatch ? $"💞 Match! +{_soloLastPoints}" : "💔 No match")</p>
                    @if (_soloStreak > 1)
                    {
                        <p>🔥 Streak: <strong>@_soloStreak</strong></p>
                    }
                    <button class="cq-btn cq-btn-primary" @onclick="SoloNext">@(_soloRound + 1 < _soloQuestions.Count ? "Next" : "See results")</button>
                }
            }
            @* Solo results are shown in the shared end-of-game modal (GameSummaryContent). *@
        </div>
    }
    else if (!_isConnected)
    {
        <div class="cq-connecting">
            <p>Connecting to the game server…</p>
        </div>
    }
    else if (_lobby is null)
    {
        <div class="cq-join">
            <h2 class="gps-phase-h">Lobby</h2>
            <p>Two or more players answer questions about each other. The "King" types the secret answer; the rest try to match — scored by AI.</p>
            <label>
                Your name:
                <input type="text" @bind="_playerName" maxlength="24" />
            </label>
            <label>
                Difficulty:
                <select @bind="_difficulty">
                    <option value="Easy">Easy (3 rounds)</option>
                    <option value="Medium" selected>Medium (5 rounds)</option>
                    <option value="Hard">Hard (7 rounds)</option>
                </select>
            </label>
            <label>
                Game code (optional — leave blank to auto-join a shared lobby):
                <input type="text" @bind="_joinCode" maxlength="6" />
            </label>
            <div class="cq-actions">
                <button class="cq-btn cq-btn-primary" @onclick="OnJoinOrCreate">Find or create a lobby</button>
                <button class="cq-btn cq-btn-secondary" @onclick="OnJoinByCode" disabled="@string.IsNullOrWhiteSpace(_joinCode)">Join by code</button>
            </div>
            <p class="cq-solo-hint">No second player? <strong>Play solo</strong> against an AI partner — guess what they'd pick.</p>
            <div class="cq-actions">
                <button class="cq-btn cq-btn-secondary" @onclick="StartSolo">Play solo (vs AI partner)</button>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="cq-error">@_error</p>
            }
        </div>
    }
    else
    {
        <div class="cq-lobby">
            <h2>Lobby <code>@_lobby.GameCode</code></h2>
            <p>Difficulty: <strong>@_lobby.Difficulty</strong> · AI mode: <strong>@_lobby.AiMode</strong></p>
            <p>Host: <strong>@_lobby.HostName</strong></p>
            <h3>Players</h3>
            <ul>
                @foreach (var p in _lobby.Players)
                {
                    <li>@p @(p == _lobby.HostName ? "👑" : "")</li>
                }
            </ul>
            <h3>Ready</h3>
            <ul>
                @foreach (var p in _lobby.ReadyPlayers)
                {
                    <li>✓ @p</li>
                }
            </ul>
            <div class="cq-actions">
                <button class="cq-btn cq-btn-primary" @onclick="OnReady">I'm ready</button>
            </div>
            @if (_lobby.IsHost && _lobby.Players.Count >= 2)
            {
                <div class="cq-actions">
                    <button class="cq-btn cq-btn-secondary" @onclick="OnStart">Start game</button>
                </div>
            }
        </div>
    }
</GameShell>

@code {
    private RenderFragment TitleContent => @<span>💕 PoCoupleQuiz</span>;

    private RenderFragment GameSummaryContent => @<div>
        <div>You matched your partner <strong>@_soloMatches</strong> / @_soloQuestions.Count times.</div>
        <div>Score: <strong>@_soloScore</strong></div>
    </div>;

    private string _playerName = string.Empty;
    private string _difficulty = "Medium";
    private string? _joinCode;
    private string? _error;
    private bool _isConnected;
    private CoupleQuizLobbyEventPayload? _lobby;

    // ── Solo mode (offline, no hub, no AI service) ───────────────────────────
    private bool _solo;
    private int _soloRound;
    private int _soloScore;
    private int _soloMatches;
    private int _soloStreak;
    private int _soloLastPoints;
    private bool _soloRevealed;
    private bool _soloLastMatch;
    private bool _soloFinished;
    private List<SoloQ> _soloQuestions = new();

    private SoloQ CurrentSoloQuestion => _soloQuestions[_soloRound];

    private static readonly SoloQ[] SoloBank =
    {
        new("Your ideal first date?", new[] { "Dinner & a movie", "Hiking adventure", "Cozy night in", "Theme park" }, 2),
        new("Favourite way to relax together?", new[] { "Binge a series", "Cook a meal", "Go for a walk", "Play games" }, 1),
        new("Dream vacation?", new[] { "Beach resort", "City exploring", "Mountain cabin", "Road trip" }, 0),
        new("Pet you'd adopt together?", new[] { "Dog", "Cat", "Something exotic", "No pets" }, 0),
        new("Saturday morning vibe?", new[] { "Sleep in", "Farmers market", "Gym session", "Big breakfast" }, 3),
        new("Go-to date snack?", new[] { "Popcorn", "Ice cream", "Chocolate", "Chips" }, 1),
        new("Music for a road trip?", new[] { "Pop hits", "Classic rock", "Lo-fi chill", "Throwback 90s" }, 2),
        new("Best gift to receive?", new[] { "Handwritten note", "Tech gadget", "Experience day", "Something cosy" }, 0),
        new("How do you settle a disagreement?", new[] { "Rock paper scissors", "Talk it out", "Coin flip", "Compromise" }, 3),
        new("The perfect evening ends with?", new[] { "Stargazing", "Late-night snack", "A good movie", "Dancing" }, 0),
        new("Favourite season for a date?", new[] { "Spring", "Summer", "Autumn", "Winter" }, 2),
        new("Coffee order of choice?", new[] { "Black coffee", "Latte", "Tea instead", "Hot chocolate" }, 1),
        new("Dream night out?", new[] { "Concert", "Comedy club", "Fancy dinner", "Game night" }, 0),
        new("Most-used emoji?", new[] { "😂", "❤️", "👍", "🔥" }, 1),
        new("Ideal weekend trip?", new[] { "Camping", "Spa retreat", "City break", "Stay home" }, 2),
        new("Who picks the movie?", new[] { "You", "Them", "Take turns", "Flip for it" }, 2),
    };

    protected override async Task OnInitializedAsync()
    {
        _playerName = PlayerNameService.GetPlayerName();
        Hub.OnLobbyCreated += HandleLobbyCreated;
        Hub.OnLobbyJoined += HandleLobbyJoined;
        Hub.OnLobbyUpdated += HandleLobbyUpdated;
        Hub.OnLobbyError += HandleError;
        Hub.OnGameStarted += HandleGameStarted;
        Hub.OnGameError += HandleError;

        try
        {
            await Hub.ConnectAsync();
            _isConnected = true;
        }
        catch (Exception ex)
        {
            _error = $"Could not connect to the game server: {ex.Message}";
        }
    }

    private async Task OnJoinOrCreate()
    {
        if (string.IsNullOrWhiteSpace(_playerName))
        {
            _error = "Please enter a name.";
            return;
        }
        PlayerNameService.SetPlayerName(_playerName);
        await Hub.JoinOrCreateAsync(_playerName, _difficulty);
    }

    private async Task OnJoinByCode()
    {
        if (string.IsNullOrWhiteSpace(_playerName) || string.IsNullOrWhiteSpace(_joinCode))
        {
            _error = "Please enter both a name and a game code.";
            return;
        }
        PlayerNameService.SetPlayerName(_playerName);
        await Hub.JoinLobbyAsync(_joinCode.Trim().ToUpperInvariant(), _playerName);
    }

    private async Task OnReady()
    {
        if (_lobby is null) return;
        await Hub.SetReadyAsync(_lobby.GameCode);
    }

    private async Task OnStart()
    {
        if (_lobby is null) return;
        await Hub.StartGameAsync(_lobby.GameCode);
    }

    private void HandleLobbyCreated(CoupleQuizLobbyEventPayload p)
    {
        // BUG FIX (audit #5): a malformed SignalR payload (null / partial
        // shape) used to overwrite _lobby with null and trigger an
        // Arg_NullReferenceException render loop. Guard against null + empty
        // game code so the UI shows a recoverable error instead of crashing.
        if (p is null || string.IsNullOrEmpty(p.GameCode))
        {
            _error = "Server returned an empty lobby. Please try again.";
            return;
        }
        _lobby = p;
    }
    private void HandleLobbyJoined(CoupleQuizLobbyEventPayload p) => HandleLobbyCreated(p);
    private void HandleLobbyUpdated(CoupleQuizLobbyUpdatedPayload p)
    {
        if (p is null || string.IsNullOrEmpty(p.GameCode)) return;
        if (_lobby is not null && _lobby.GameCode == p.GameCode)
        {
            _lobby = _lobby with
            {
                Players = p.Players,
                ReadyPlayers = p.ReadyPlayers,
                HostName = p.HostName,
                Difficulty = p.Difficulty ?? _lobby.Difficulty,
                AiMode = p.AiMode ?? _lobby.AiMode
            };
        }
    }
    private void HandleError(string? message)
    {
        // Null/empty guard — the UI renders @_error directly and crashes on
        // null string interpolation otherwise.
        _error = string.IsNullOrEmpty(message)
            ? "An unknown error occurred. Please try again."
            : message;
    }

    // ── Solo mode handlers ───────────────────────────────────────────────────
    private void StartSolo()
    {
        var rounds = _difficulty switch { "Easy" => 3, "Hard" => 7, _ => 5 };
        rounds = Math.Min(rounds, SoloBank.Length);
        _soloQuestions = SoloBank.OrderBy(_ => Random.Shared.Next()).Take(rounds).ToList();
        _soloRound = 0;
        _soloScore = 0;
        _soloMatches = 0;
        _soloStreak = 0;
        _soloLastPoints = 0;
        _soloRevealed = false;
        _soloLastMatch = false;
        _soloFinished = false;
        _solo = true;
    }

    private void SoloPick(int idx)
    {
        if (_soloRevealed) return;
        _soloLastMatch = idx == CurrentSoloQuestion.PartnerIndex;
        if (_soloLastMatch)
        {
            _soloStreak++;
            _soloMatches++;
            // 10 per match, plus a growing streak bonus (capped) for consecutive hits.
            _soloLastPoints = 10 + Math.Min((_soloStreak - 1) * 5, 15);
            _soloScore += _soloLastPoints;
        }
        else
        {
            _soloStreak = 0;
            _soloLastPoints = 0;
        }
        _soloRevealed = true;
    }

    private void SoloNext()
    {
        if (_soloRound + 1 >= _soloQuestions.Count) { _soloFinished = true; return; }
        _soloRound++;
        _soloRevealed = false;
    }

    private sealed record SoloQ(string Text, string[] Options, int PartnerIndex);

    private void HandleGameStarted(CoupleQuizGameStartedPayload p)
    {
        // The full game UI is a follow-up. For now, show the in-flight question.
        _lobby = null;
        _error = $"Game started! Round {p.RoundIndex + 1} of {p.MaxRounds}. Question: {p.QuestionText}";
    }

    public async ValueTask DisposeAsync()
    {
        Hub.OnLobbyCreated -= HandleLobbyCreated;
        Hub.OnLobbyJoined -= HandleLobbyJoined;
        Hub.OnLobbyUpdated -= HandleLobbyUpdated;
        Hub.OnLobbyError -= HandleError;
        Hub.OnGameStarted -= HandleGameStarted;
        Hub.OnGameError -= HandleError;
        await Hub.DisposeAsync();
    }
}
