@* Tab overlay: the full population chart, the world log and settings. Releases pointer
   lock while open (the engine does that), and Esc closes it. *@
<div class="poeco-overlay" role="dialog" aria-modal="true" aria-label="Dashboard" @onkeydown="OnKeyDown" tabindex="-1" @ref="_root">
    <div class="poeco-overlay-card">
        <header class="poeco-overlay-head">
            <h2>Year @(Stats?.Year ?? 0) · Day @(Stats?.Day ?? 1)</h2>
            <span class="poeco-badge">@(Stats?.Alive ?? 0) alive</span>
            <span class="poeco-badge">@(Stats?.Huts ?? 0) huts</span>
            <span class="poeco-spacer"></span>
            <button type="button" class="poeco-pill" @onclick="OnClose" aria-label="Close the dashboard">Close <kbd>Esc</kbd></button>
        </header>

        <div class="poeco-overlay-grid">
            <section class="poeco-panel poeco-panel--chart">
                <h3>Population over time</h3>
                <svg viewBox="0 0 320 160" preserveAspectRatio="none" class="poeco-chart" role="img" aria-label="@ChartSummary">
                    <line x1="0" y1="159" x2="320" y2="159" class="poeco-chart-axis" />
                    @for (var s = 0; s < EcoSpeciesInfo.Count; s++)
                    {
                        var pts = Series[s];
                        if (pts.Length > 0)
                        {
                            <polyline class="poeco-chart-line" style="stroke: @EcoSpeciesInfo.ColourOf(s)" points="@pts" />
                        }
                    }
                </svg>
                <div class="poeco-tiles">
                    @for (var s = 0; s < EcoSpeciesInfo.Count; s++)
                    {
                        <div class="poeco-tile" style="border-top-color: @EcoSpeciesInfo.ColourOf(s)">
                            <span>@EcoSpeciesInfo.PluralOf(s)</span>
                            <strong>@Count(s)</strong>
                        </div>
                    }
                </div>
                <p class="gps-sr-only" aria-live="polite">@ChartSummary</p>
            </section>

            <section class="poeco-panel poeco-panel--log">
                <h3>World log</h3>
                <ol class="poeco-log">
                    @foreach (var ev in Events.AsEnumerable().Reverse().Take(60))
                    {
                        <li><span class="poeco-log-tick">@($"Y{Year(ev)}")</span> @ev.Text</li>
                    }
                </ol>
            </section>

            <section class="poeco-panel poeco-panel--settings">
                <h3>AI thoughts</h3>
                @if (!WebGpu)
                {
                    <p class="poeco-note">This browser has no WebGPU, so creature thoughts come from instinct templates. Chrome or Edge on a desktop can run the model.</p>
                }
                else
                {
                    <label class="poeco-switch">
                        <input type="checkbox" checked="@LlmOn" @onchange="ToggleLlm" />
                        <span>Let creatures think (@ModelLabel)</span>
                    </label>
                    <label class="poeco-field">
                        <span>Model</span>
                        <select value="@SelectedModel" @onchange="ChangeModel">
                            @foreach (var m in Models)
                            {
                                <option value="@m.Id">@m.Label — @(m.VramMb) MB</option>
                            }
                        </select>
                    </label>
                    @if (Llm is not null && Llm.State == "loading")
                    {
                        <div class="poeco-progress"><span style="width: @($"{Llm.Progress * 100:0}%")"></span></div>
                        <p class="poeco-note">@Llm.Message</p>
                    }
                    else if (Llm is not null && !string.IsNullOrWhiteSpace(Llm.Message))
                    {
                        <p class="poeco-note">@Llm.Message</p>
                    }
                    @if (Stats?.Llm is { } counters)
                    {
                        <p class="poeco-note">@counters.Applied thoughts applied, @counters.Rejected rejected.</p>
                    }
                }

                <h3>World</h3>
                <label class="poeco-field">
                    <span>Seed</span>
                    <input type="text" value="@Seed" @oninput="e => SeedChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" />
                </label>
                <button type="button" class="poeco-btn poeco-btn--primary" @onclick="() => OnNewWorld.InvokeAsync(Seed)">New world</button>

                <h3>Speed</h3>
                <div class="poeco-speed">
                    @foreach (var s in new[] { 0, 1, 2, 4 })
                    {
                        <button type="button" class="poeco-pill @(Stats?.Speed == s ? "poeco-pill--on" : "")" @onclick="() => OnSpeed.InvokeAsync(s)">@(s == 0 ? "⏸" : $"{s}×")</button>
                    }
                </div>

                <h3>Keys</h3>
                <p class="poeco-note"><kbd>WASD</kbd> move · <kbd>Shift</kbd> run · <kbd>Space</kbd> jump · <kbd>F</kbd> fly · <kbd>E</kbd> inspect · <kbd>T</kbd> follow · <kbd>Tab</kbd> dashboard · <kbd>0-3</kbd> speed</p>
            </section>
        </div>
    </div>
</div>

@code {
    private ElementReference _root;

    [Parameter] public EcoStats? Stats { get; set; }
    [Parameter] public IReadOnlyList<EcoEvent> Events { get; set; } = [];
    [Parameter] public EcoLlmState? Llm { get; set; }
    [Parameter] public IReadOnlyList<EcoModel> Models { get; set; } = [];
    [Parameter] public bool WebGpu { get; set; }
    [Parameter] public string Seed { get; set; } = "";
    [Parameter] public EventCallback<string> SeedChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnSpeed { get; set; }
    [Parameter] public EventCallback<(bool Enabled, string? ModelId)> OnLlmToggle { get; set; }
    [Parameter] public EventCallback<string?> OnNewWorld { get; set; }

    private bool LlmOn => Llm is not null && Llm.State is "loading" or "ready";
    private string SelectedModel => Llm?.ModelId ?? Models.FirstOrDefault()?.Id ?? "";
    private string ModelLabel => Models.FirstOrDefault(m => m.Id == SelectedModel)?.Label ?? "in-browser model";

    private int Count(int species) => Stats?.Counts is { Length: EcoSpeciesInfo.Count } c ? c[species] : 0;

    private string[] Series => PopulationSeries.AllSeries(Stats?.PopHistory, 320, 156);

    private string ChartSummary => PopulationSeries.Summary(Stats);

    // The log carries the tick; the year it fell in is derived from the sim's own clock
    // constants rather than a hardcoded ticks-per-year in the markup.
    private int Year(EcoEvent ev) => Stats is null || Stats.Tick <= 0 ? 0 : ev.Tick * Stats.Year / Math.Max(1, Stats.Tick);

    private Task ToggleLlm(ChangeEventArgs e) => OnLlmToggle.InvokeAsync((e.Value is true, SelectedModel));
    private Task ChangeModel(ChangeEventArgs e) => OnLlmToggle.InvokeAsync((true, e.Value?.ToString()));

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { try { await _root.FocusAsync(); } catch { /* the overlay may already be gone */ } }
    }
}
