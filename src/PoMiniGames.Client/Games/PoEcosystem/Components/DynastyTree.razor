@using System.Linq
@using PoMiniGames.Shared.Games.PoEcosystem
@using PoMiniGamesClient.Games.PoEcosystem.Models
@using PoMiniGamesClient.Services.Ui
@inject UiFeedbackService Feedback

<div class="poeco-dynasty-wrap" role="region" aria-label="Dynasty Tree & Phenotype Lab">
    <!-- View Switcher -->
    <div class="poeco-dynasty-toolbar">
        <div class="poeco-dynasty-tabs" role="tablist">
            <button type="button" class="poeco-pill @(_tab == "tree" ? "poeco-pill--on" : "")" @onclick="SetTreeTab">
                🌳 Dynasty Tree
            </button>
            <button type="button" class="poeco-pill @(_tab == "phenotype" ? "poeco-pill--on" : "")" @onclick="SetPhenotypeTab">
                🧬 Phenotype & Alleles
            </button>
        </div>

        @if (_tab == "tree")
        {
            <div class="poeco-dynasty-zoom">
                <button type="button" class="poeco-icon-btn poeco-icon-btn--sm" @onclick="ZoomIn" title="Zoom In">+</button>
                <button type="button" class="poeco-icon-btn poeco-icon-btn--sm" @onclick="ZoomOut" title="Zoom Out">−</button>
                <button type="button" class="poeco-icon-btn poeco-icon-btn--sm" @onclick="ResetZoom" title="Reset View">⟲</button>
            </div>
        }
    </div>

    @if (_tab == "tree")
    {
        <div class="poeco-dynasty-canvas-container">
            <svg viewBox="@ViewBoxString" class="poeco-dynasty-svg" preserveAspectRatio="xMidYMid meet">
                <defs>
                    <filter id="dynastyGlow">
                        <feGaussianBlur stdDeviation="3" result="blur" />
                        <feMerge>
                            <feMergeNode in="blur" />
                            <feMergeNode in="SourceGraphic" />
                        </feMerge>
                    </filter>
                </defs>

                <!-- Generation Tier Guides -->
                <line x1="20" y1="65" x2="680" y2="65" stroke="rgba(255,255,255,0.08)" stroke-dasharray="4,4" />
                @SvgText(25, 60, "Grandparents", fill: "rgba(255,255,255,0.3)", fontSize: 10, anchor: "start")

                <line x1="20" y1="165" x2="680" y2="165" stroke="rgba(255,255,255,0.08)" stroke-dasharray="4,4" />
                @SvgText(25, 160, "Parents", fill: "rgba(255,255,255,0.3)", fontSize: 10, anchor: "start")

                <line x1="20" y1="265" x2="680" y2="265" stroke="rgba(255,255,255,0.12)" stroke-dasharray="2,2" />
                @SvgText(25, 260, $"Generation {Tree.Generation} (Self)", fill: "rgba(255,255,255,0.5)", fontSize: 10, anchor: "start")

                <line x1="20" y1="365" x2="680" y2="365" stroke="rgba(255,255,255,0.08)" stroke-dasharray="4,4" />
                @SvgText(25, 360, "Offspring / Descendants", fill: "rgba(255,255,255,0.3)", fontSize: 10, anchor: "start")

                <!-- 1. Grandparents Tier (Y = 80) -->
                @for (var k = 0; k < 4; k++)
                {
                    var g = Tree.Grandparents.Length > k ? Tree.Grandparents[k] : null;
                    var gx = 100 + k * 160;
                    var role = k switch { 0 => "M. Mother", 1 => "M. Father", 2 => "F. Mother", _ => "F. Father" };

                    <g class="poeco-dynasty-node" transform="translate(@gx, 80)"
                       @onclick="() => ClickKin(g)" style="@(g != null && g.Alive ? "cursor: pointer;" : "")">
                        <rect x="-55" y="-25" width="110" height="50" rx="8"
                              fill="@(g?.Alive == true ? "#1a2433" : "#121720")"
                              stroke="@(g?.Alive == true ? EcoSpeciesInfo.ColourOf(g.Species) : "#4a5568")"
                              stroke-width="1.2" />
                        @if (g is null)
                        {
                            @SvgText(0, 2, "Unknown", fill: "#666", fontSize: 10)
                            @SvgText(0, 15, role, fill: "#444", fontSize: 8)
                        }
                        else
                        {
                            @SvgText(0, -8, $"{FormatName(g.Name)} {(g.Sex == 1 ? "♀" : "♂")}", fill: (g.Alive ? "#fff" : "#888"), fontSize: 10, fontWeight: "bold")
                            @SvgText(0, 6, (g.Alive ? "● Living" : "† " + g.Cause.Replace('_', ' ')), fill: (g.Alive ? "#2ecc71" : "#e74c3c"), fontSize: 8.5)
                            @SvgText(0, 18, role, fill: "#aaa", fontSize: 8)
                        }
                    </g>
                }

                <!-- Connectors Grandparents -> Parents -->
                <path d="M 100 105 L 100 125 L 180 125 L 180 155" stroke="rgba(255,255,255,0.2)" fill="none" />
                <path d="M 260 105 L 260 125 L 180 125" stroke="rgba(255,255,255,0.2)" fill="none" />
                <path d="M 420 105 L 420 125 L 500 125 L 500 155" stroke="rgba(255,255,255,0.2)" fill="none" />
                <path d="M 580 105 L 580 125 L 500 125" stroke="rgba(255,255,255,0.2)" fill="none" />

                <!-- 2. Parents Tier (Y = 180) -->
                <!-- Mother (180, 180) -->
                <g class="poeco-dynasty-node" transform="translate(180, 180)"
                   @onclick="() => ClickKin(Tree.Mother)" style="@(Tree.Mother?.Alive == true ? "cursor: pointer;" : "")">
                    <rect x="-55" y="-25" width="110" height="50" rx="8"
                          fill="@(Tree.Mother?.Alive == true ? "#1a2433" : "#121720")"
                          stroke="@(Tree.Mother?.Alive == true ? EcoSpeciesInfo.ColourOf(Tree.Mother.Species) : "#4a5568")"
                          stroke-width="1.2" />
                    @if (Tree.Mother is null)
                    {
                        @SvgText(0, 2, "Unknown", fill: "#666", fontSize: 10)
                        @SvgText(0, 15, "Mother", fill: "#444", fontSize: 8)
                    }
                    else
                    {
                        @SvgText(0, -8, $"{FormatName(Tree.Mother.Name)} ♀", fill: (Tree.Mother.Alive ? "#fff" : "#888"), fontSize: 10, fontWeight: "bold")
                        @SvgText(0, 6, (Tree.Mother.Alive ? "● Living" : "† " + Tree.Mother.Cause.Replace('_', ' ')), fill: (Tree.Mother.Alive ? "#2ecc71" : "#e74c3c"), fontSize: 8.5)
                        @SvgText(0, 18, "Mother", fill: "#aaa", fontSize: 8)
                    }
                </g>

                <!-- Father (500, 180) -->
                <g class="poeco-dynasty-node" transform="translate(500, 180)"
                   @onclick="() => ClickKin(Tree.Father)" style="@(Tree.Father?.Alive == true ? "cursor: pointer;" : "")">
                    <rect x="-55" y="-25" width="110" height="50" rx="8"
                          fill="@(Tree.Father?.Alive == true ? "#1a2433" : "#121720")"
                          stroke="@(Tree.Father?.Alive == true ? EcoSpeciesInfo.ColourOf(Tree.Father.Species) : "#4a5568")"
                          stroke-width="1.2" />
                    @if (Tree.Father is null)
                    {
                        @SvgText(0, 2, "Unknown", fill: "#666", fontSize: 10)
                        @SvgText(0, 15, "Father", fill: "#444", fontSize: 8)
                    }
                    else
                    {
                        @SvgText(0, -8, $"{FormatName(Tree.Father.Name)} ♂", fill: (Tree.Father.Alive ? "#fff" : "#888"), fontSize: 10, fontWeight: "bold")
                        @SvgText(0, 6, (Tree.Father.Alive ? "● Living" : "† " + Tree.Father.Cause.Replace('_', ' ')), fill: (Tree.Father.Alive ? "#2ecc71" : "#e74c3c"), fontSize: 8.5)
                        @SvgText(0, 18, "Father", fill: "#aaa", fontSize: 8)
                    }
                </g>

                <!-- Connectors Parents -> Self -->
                <path d="M 180 205 L 180 230 L 340 230 L 340 255" stroke="rgba(255,255,255,0.35)" fill="none" stroke-width="1.5" />
                <path d="M 500 205 L 500 230 L 340 230" stroke="rgba(255,255,255,0.35)" fill="none" stroke-width="1.5" />

                <!-- 3. Self Node (340, 280) -->
                <g class="poeco-dynasty-node poeco-dynasty-node--self" transform="translate(340, 280)">
                    <rect x="-60" y="-28" width="120" height="56" rx="8"
                          fill="#1f3b5c"
                          stroke="#ffd700"
                          stroke-width="2.5"
                          filter="url(#dynastyGlow)" />
                    @SvgText(0, -9, $"{FormatName(Tree.Self.Name)} {(Tree.Self.Sex == 1 ? "♀" : "♂")}", fill: "#fff", fontSize: 11, fontWeight: "bold")
                    @SvgText(0, 7, (Tree.Self.Alive ? "● Subject (Living)" : "† " + Tree.Self.Cause.Replace('_', ' ')), fill: (Tree.Self.Alive ? "#2ecc71" : "#e74c3c"), fontSize: 9)
                    @SvgText(0, 21, "Subject", fill: "#ffd700", fontSize: 8.5, fontWeight: "bold")
                </g>

                <!-- Connector Self -> Children -->
                @if (Tree.Children.Length > 0)
                {
                    <path d="M 340 308 L 340 335" stroke="rgba(255,255,255,0.35)" fill="none" stroke-width="1.5" />
                }

                <!-- 4. Children Tier (Y = 380) -->
                @for (var cIdx = 0; cIdx < ChildCount; cIdx++)
                {
                    var child = Tree.Children[cIdx];
                    var cx = ChildStartX + cIdx * 120;
                    <path d="M 340 335 L @(cx) 335 L @(cx) 355" stroke="rgba(255,255,255,0.25)" fill="none" />
                    <g class="poeco-dynasty-node" transform="translate(@cx, 380)"
                       @onclick="() => ClickKin(child)" style="@(child.Alive ? "cursor: pointer;" : "")">
                        <rect x="-55" y="-25" width="110" height="50" rx="8"
                              fill="@(child.Alive ? "#1a2433" : "#121720")"
                              stroke="@(child.Alive ? EcoSpeciesInfo.ColourOf(child.Species) : "#4a5568")"
                              stroke-width="1.2" />
                        @SvgText(0, -8, $"{FormatName(child.Name)} {(child.Sex == 1 ? "♀" : "♂")}", fill: (child.Alive ? "#fff" : "#888"), fontSize: 10, fontWeight: "bold")
                        @SvgText(0, 6, (child.Alive ? "● Living" : "† " + child.Cause.Replace('_', ' ')), fill: (child.Alive ? "#2ecc71" : "#e74c3c"), fontSize: 8.5)
                        @SvgText(0, 18, (child.Sex == 1 ? "Daughter" : "Son"), fill: "#aaa", fontSize: 8)
                    </g>
                }
                @if (Tree.Children.Length > 6)
                {
                    @SvgText(640, 395, $"+{Tree.Children.Length - 6} more", fill: "#aaa", fontSize: 11, anchor: "start")
                }
            </svg>
        </div>
    }
    else
    {
        <!-- Phenotype & Alleles Tab -->
        <div class="poeco-phenotype-lab">
            <div class="poeco-phenotype-summary">
                <h4>Genotype & Expressed Traits</h4>
                <p>Dynasty generation: <strong>@Tree.Generation</strong> · Total living kin: <strong>@Tree.Descendants</strong></p>
            </div>

            <div class="poeco-phenotype-grid">
                @foreach (var (name, desc, val) in TraitsList)
                {
                    var pct = (int)(val * 100);
                    <div class="poeco-trait-card">
                        <div class="poeco-trait-card-head">
                            <strong>@name</strong>
                            <span>@pct%</span>
                        </div>
                        <div class="poeco-trait-bar-track">
                            <div class="poeco-trait-bar-fill" style="width: @pct%;"></div>
                        </div>
                        <small class="poeco-trait-desc">@desc</small>
                    </div>
                }
            </div>

            <div class="poeco-dynasty-stats-box">
                <div class="poeco-dynasty-stat">
                    <span>Ancestral Line</span>
                    <strong>@AncestralCount elders recorded</strong>
                </div>
                <div class="poeco-dynasty-stat">
                    <span>Siblings</span>
                    <strong>@Tree.Siblings</strong>
                </div>
                <div class="poeco-dynasty-stat">
                    <span>Direct Offspring</span>
                    <strong>@Tree.Children.Length</strong>
                </div>
                <div class="poeco-dynasty-stat">
                    <span>Survival Rate</span>
                    <strong>@SurvivalRateText</strong>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public EcoLineage Tree { get; set; } = default!;
    [Parameter] public EventCallback<int> OnSelect { get; set; }

    private string _tab = "tree";
    private int _zoom = 100;

    private string ViewBoxString =>
        $"{((100 - _zoom) * 3.5).ToString(System.Globalization.CultureInfo.InvariantCulture)} {((100 - _zoom) * 2.2).ToString(System.Globalization.CultureInfo.InvariantCulture)} {(700 * 100 / _zoom).ToString(System.Globalization.CultureInfo.InvariantCulture)} {(450 * 100 / _zoom).ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private int ChildCount => Math.Min(6, Tree.Children.Length);
    private int ChildStartX => 340 - ((ChildCount - 1) * 60);

    private int AncestralCount =>
        (Tree.Grandparents?.Count(g => g != null) ?? 0) + (Tree.Mother != null ? 1 : 0) + (Tree.Father != null ? 1 : 0);

    private string SurvivalRateText =>
        Tree.Children.Length == 0 ? "—" : $"{Tree.Children.Count(c => c.Alive) * 100 / Math.Max(1, Tree.Children.Length)}% living";

    private static readonly (string Name, string Desc, double Val)[] TraitsList =
    [
        ("Boldness", "Propensity to explore and confront threats", 0.72),
        ("Sociability", "Pack cohesion, sharing and empathy", 0.85),
        ("Curiosity", "Tool crafting speed and forage range", 0.64),
        ("Greed", "Resource stockpiling and hoarding tendency", 0.40),
        ("Diligence", "Building construction rate and persistence", 0.90),
    ];

    private async Task SetTreeTab()
    {
        _tab = "tree";
        await Feedback.FluidRippleAsync();
    }

    private async Task SetPhenotypeTab()
    {
        _tab = "phenotype";
        await Feedback.CrystalPingAsync();
    }

    private void ZoomIn() => _zoom = Math.Min(160, _zoom + 15);
    private void ZoomOut() => _zoom = Math.Max(60, _zoom - 15);
    private void ResetZoom() => _zoom = 100;

    private static string FormatName(string name) =>
        string.IsNullOrEmpty(name) ? "Unknown" : (name.Length > 12 ? name.Substring(0, 11) + "…" : name);

    private async Task ClickKin(EcoKin? kin)
    {
        if (kin is null) return;
        if (kin.Alive)
        {
            var freq = kin.Species switch
            {
                0 => 293.66,
                1 => 329.63,
                2 => 392.00,
                3 => 440.00,
                _ => 523.25
            };
            await Feedback.PluckAsync(freq);
            await OnSelect.InvokeAsync(kin.Handle);
        }
        else
        {
            await Feedback.CueAsync("dynasty", "ancestorPass");
        }
    }

    private static MarkupString SvgText(double x, double y, string content, string fill = "#fff", double fontSize = 10, string anchor = "middle", string fontWeight = "normal") =>
        new($"<text x=\"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" y=\"{y.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" fill=\"{fill}\" font-size=\"{fontSize.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" text-anchor=\"{anchor}\" font-weight=\"{fontWeight}\">{System.Net.WebUtility.HtmlEncode(content)}</text>");
}
