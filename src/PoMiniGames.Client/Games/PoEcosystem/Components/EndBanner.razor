@* Lower-third banner: "Last species standing" or "The island is silent". The world keeps
   running underneath — Restart is an offer, not a stop. *@
<div class="poeco-banner" role="status">
    <div>
        <span class="poeco-banner-eyebrow">The island</span>
        <strong>@Text</strong>
    </div>
    <button type="button" class="poeco-btn poeco-btn--primary" @onclick="OnRestart">New world</button>
</div>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public EventCallback OnRestart { get; set; }
}
