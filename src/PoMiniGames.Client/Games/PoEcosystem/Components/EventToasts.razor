@using PoMiniGamesClient.Games.PoEcosystem.Models

@* The last few world events, fading out (bottom-right). The full log is in the dashboard. *@
<div class="poeco-toasts" role="status" aria-live="polite" aria-label="World events">
    @foreach (var (ev, i) in Events.Select((e, i) => (e, i)))
    {
        <div class="poeco-toast" style="--fade: @Fade(i)">
            <i class="poeco-dot" style="background: @Colour(ev)" aria-hidden="true"></i>
            <span>@ev.Text</span>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<EcoEvent> Events { get; set; } = [];

    private static string Fade(int index) => (1 - index * 0.3).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private static string Colour(EcoEvent ev) => ev.Kind switch
    {
        "birth" => "var(--accent-success)",
        "death" => "var(--accent-danger)",
        "extinction" => "var(--accent-danger)",
        "hut" or "chop" => "var(--accent)",
        "lightning" or "rockslide" or "eruption" or "full" => "var(--accent-warning)",
        _ => "var(--color-text-secondary)",
    };
}
