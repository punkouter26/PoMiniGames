
@* Clock and the dashboard button — top-left of the HUD (layout concept C). Speed lives in
   the dashboard (and on keys 0–3); the sound pill toggles the procedural ambience. *@
<div class="poeco-hudbar">
    <span class="poeco-clock" aria-live="off">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        Year @(Stats?.Year ?? 0) · Day @(Stats?.Day ?? 1)
    </span>

    <span class="poeco-badge" title="Creatures alive">@(Stats?.Alive ?? 0) alive</span>

    <button type="button" class="poeco-pill poeco-sound-btn" aria-pressed="@(Sound ? "true" : "false")"
            aria-label="@(Sound ? "Mute ambience" : "Unmute ambience")"
            title="@(Sound ? "Mute ambience" : "Unmute ambience")"
            @onclick="() => OnSound.InvokeAsync(!Sound)">@(Sound ? "🔊" : "🔇")</button>

    <button type="button" class="poeco-pill poeco-dashboard-btn" @onclick="OnDashboard" aria-label="Open the dashboard">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8" /></svg>
        Dashboard <kbd>Tab</kbd>
    </button>
</div>

@code {
    [Parameter] public EcoStats? Stats { get; set; }
    [Parameter] public bool Sound { get; set; } = true;
    [Parameter] public EventCallback<bool> OnSound { get; set; }
    [Parameter] public EventCallback OnDashboard { get; set; }
}
