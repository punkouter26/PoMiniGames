@* Top-left of the HUD. One status chip carries everything the clock block used to spread
   over four badges (date, season, alive, tribe tier) — clicking it opens the dashboard,
   which owns the detail. The sound / cinematic / pop-out pills are icon-only: labels and
   shortcut keys live in the title tooltips and the key legend, not on the bar. Speed
   stays on keys 0–3 inside the dashboard. *@
<div class="poeco-hudbar">
    <button type="button" class="poeco-chip" title="Island status — click for the full dashboard"
            aria-label="Island status: year @(Stats?.Year ?? 0), day @(Stats?.Day ?? 1), @(Stats?.Alive ?? 0) creatures alive@(Stats?.Tech is { } t ? $", {t.Tribe} tribe at {t.Name}" : "")"
            @onclick="OnDashboard">
        @{
            var seasonIcon = (Stats?.Season ?? 0) switch
            {
                0 => "🌸", 1 => "☀️", 2 => "🍂", _ => "❄️",
            };
        }
        <span class="poeco-chip-date">@seasonIcon Y@(Stats?.Year ?? 0)·D@(Stats?.Day ?? 1)</span>
        @if (Stats?.Weather is { Kind: > 0 } w && w.Intensity > 0.1)
        {
            <span class="poeco-chip-sep" aria-hidden="true">·</span>
            <span class="poeco-chip-weather" title="Weather: @w.Name">@WeatherIcon(w.Kind) @w.Name</span>
        }
        <span class="poeco-chip-sep" aria-hidden="true">·</span>
        <span>@(Stats?.Alive ?? 0) alive</span>
        @if (Stats?.Tech is { } tech)
        {
            <span class="poeco-chip-sep" aria-hidden="true">·</span>
            <span class="poeco-chip-tech" title="The tribe's ladder: Camp → Fire → Palisade → Farming → Watchtower">@tech.Name</span>
        }
    </button>

    <button type="button" class="poeco-pill poeco-sound-btn" aria-pressed="@(Sound ? "true" : "false")"
            aria-label="@(Sound ? "Mute ambience" : "Unmute ambience")"
            title="@(Sound ? "Mute ambience" : "Unmute ambience")"
            @onclick="() => OnSound.InvokeAsync(!Sound)">@(Sound ? "🔊" : "🔇")</button>

    <button type="button" class="poeco-pill @(Director ? "poeco-pill--on" : "")" aria-pressed="@(Director ? "true" : "false")"
            title="Cinematic camera — let the director find the drama (C)"
            @onclick="OnDirector">🎬</button>

    <button type="button" class="poeco-pill @(Pip ? "poeco-pill--on" : "")" aria-pressed="@(Pip ? "true" : "false")"
            title="Pop the island out into a small always-on-top window (P)"
            @onclick="OnPip">⧉</button>

    <button type="button" class="poeco-pill poeco-reel-btn" title="Island reel — replays of the big moments, photos and miniatures"
            aria-label="Open the island reel" @onclick="OnReel">🎞</button>

    <button type="button" class="poeco-pill poeco-dashboard-btn" @onclick="OnDashboard"
            title="Dashboard — populations, tribe, chronicle, cloud saves (Tab)"
            aria-label="Open the dashboard">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8" /></svg>
    </button>
</div>

@code {
    [Parameter] public EcoStats? Stats { get; set; }
    [Parameter] public bool Sound { get; set; } = true;
    [Parameter] public bool Director { get; set; }
    [Parameter] public bool Pip { get; set; }
    [Parameter] public EventCallback<bool> OnSound { get; set; }
    [Parameter] public EventCallback OnDashboard { get; set; }
    [Parameter] public EventCallback OnDirector { get; set; }
    [Parameter] public EventCallback OnPip { get; set; }
    [Parameter] public EventCallback OnReel { get; set; }

    private static string WeatherIcon(int kind) => kind switch { 1 => "🌧️", 2 => "⛈️", 3 => "🌵", 4 => "🌨️", _ => "" };
}
