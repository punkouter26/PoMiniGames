@* A creature's family (feature: lineage). Two generations up, its children, and the headline
   counts. Every named relative is a button: clicking one inspects it and walks the tree there,
   so a dynasty can be followed back to its founder or forward to the living. Dead relatives
   stay listed, greyed, with what killed them. *@
<aside class="poeco-lineage" role="dialog" aria-label="Family of @Tree.Self.Name">
    <header class="poeco-inspector-head">
        <i class="poeco-species-chip" style="background: @EcoSpeciesInfo.ColourOf(Tree.Self.Species)" aria-hidden="true"></i>
        <div>
            <h2>The line of @Tree.Self.Name</h2>
            <p>Generation @Tree.Generation · @Tree.Siblings siblings · @Tree.Children.Length young · @Tree.Descendants descendants</p>
        </div>
        <button type="button" class="poeco-pill poeco-pill--sm" @onclick="() => _showInteractive = !_showInteractive" style="margin-left:auto; margin-right: 8px;">
            @(_showInteractive ? "📋 Cards" : "🌳 Dynasty Lab")
        </button>
        <button type="button" class="poeco-icon-btn" @onclick="OnClose" aria-label="Close">✕</button>
    </header>

    @if (_showInteractive)
    {
        <DynastyTree Tree="@Tree" OnSelect="@OnSelect" />
    }
    else
    {
        <div class="poeco-tree">
        <div class="poeco-tree-row poeco-tree-row--grand">
            @for (var k = 0; k < 4; k++)
            {
                var g = Tree.Grandparents.Length > k ? Tree.Grandparents[k] : null;
                @Kin(g, k switch { 0 => "mother's mother", 1 => "mother's father", 2 => "father's mother", _ => "father's father" })
            }
        </div>
        <div class="poeco-tree-row">
            @Kin(Tree.Mother, "mother")
            @Kin(Tree.Father, "father")
        </div>
        <div class="poeco-tree-row poeco-tree-row--self">
            @Kin(Tree.Self, "this creature", true)
        </div>
        <div class="poeco-tree-row poeco-tree-row--kids">
            @if (Tree.Children.Length == 0)
            {
                <span class="poeco-note">No young yet.</span>
            }
            else
            {
                @foreach (var c in Tree.Children.Take(12))
                {
                    @Kin(c, c.Sex == 1 ? "daughter" : "son")
                }
                @if (Tree.Children.Length > 12)
                {
                    <span class="poeco-note">+@(Tree.Children.Length - 12) more</span>
                }
            }
        </div>
    </div>
    }
</aside>

@code {
    private bool _showInteractive = true;

    [Parameter, EditorRequired] public EcoLineage Tree { get; set; } = default!;
    [Parameter] public EventCallback<int> OnSelect { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private RenderFragment Kin(EcoKin? kin, string role, bool self = false) => @<div class="poeco-kin @(kin is null ? "poeco-kin--unknown" : "") @(kin is { Alive: false } ? "poeco-kin--dead" : "") @(self ? "poeco-kin--self" : "")">
        @if (kin is null)
        {
            <span class="poeco-kin-name">unknown</span>
        }
        else
        {
            <button type="button" class="poeco-kin-name" disabled="@(self || !kin.Alive)" title="@(kin.Alive ? $"Inspect {kin.Name}" : $"{kin.Name} died: {kin.Cause}")" @onclick="() => OnSelect.InvokeAsync(kin.Handle)">
                <i class="poeco-species-chip" style="background: @EcoSpeciesInfo.ColourOf(kin.Species)" aria-hidden="true"></i>
                @kin.Name @(kin.Sex == 1 ? "♀" : "♂")
            </button>
            @if (!kin.Alive)
            {
                <span class="poeco-kin-fate">† @kin.Cause.Replace('_', ' ')</span>
            }
        }
        <span class="poeco-kin-role">@role</span>
    </div>;
}
