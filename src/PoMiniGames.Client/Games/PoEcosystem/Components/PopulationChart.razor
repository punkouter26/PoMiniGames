@using PoMiniGames.Shared.Games.PoEcosystem
@using PoMiniGamesClient.Games.PoEcosystem.Models

<div class="poeco-pop-chart-container">
    <div class="poeco-chart-header">
        <h4 class="poeco-chart-title">Island Ecosystem & Tribal Demographics</h4>
        <span class="poeco-badge poeco-badge--live">Live · Year @(Stats?.Year ?? 0)</span>
    </div>

    <div class="poeco-svg-chart-wrap">
        <svg viewBox="0 0 @Width @Height" preserveAspectRatio="none" class="poeco-chart" role="img" aria-label="Population over time">
            <line x1="0" y1="@(Height - 1)" x2="@Width" y2="@(Height - 1)" class="poeco-chart-axis" />
            
            @* Species series lines *@
            @for (var s = 0; s < EcoSpeciesInfo.Count; s++)
            {
                var pts = GetSeries(s);
                if (!string.IsNullOrEmpty(pts))
                {
                    <polyline class="poeco-chart-line" style="stroke: @EcoSpeciesInfo.ColourOf(s); stroke-width: 2.2;" points="@pts" />
                }
            }
        </svg>
    </div>

    <div class="poeco-chart-legend">
        @for (var s = 0; s < EcoSpeciesInfo.Count; s++)
        {
            var count = Stats?.Counts is { Length: EcoSpeciesInfo.Count } c ? c[s] : 0;
            <div class="poeco-legend-item" style="border-left: 3px solid @EcoSpeciesInfo.ColourOf(s);">
                <span class="poeco-legend-label">@EcoSpeciesInfo.PluralOf(s)</span>
                <strong class="poeco-legend-count">@count</strong>
            </div>
        }
    </div>

    @if (Tribes is not null && Tribes.Count > 0)
    {
        <div class="poeco-tribe-bars-wrap">
            <h5 class="poeco-tribe-bars-title">Civilization Shares</h5>
            <div class="poeco-tribe-stacked-bar">
                @{
                    var totalTribalPop = Math.Max(1, Tribes.Sum(t => t.Population));
                }
                @foreach (var tribe in Tribes)
                {
                    var pct = (tribe.Population / (double)totalTribalPop) * 100.0;
                    <div class="poeco-tribe-bar-seg" style="width: @pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background-color: @tribe.BannerColor;"
                         title="@tribe.Name: @tribe.Population humans (@pct.ToString("F0")%)">
                        @if (pct > 15)
                        {
                            <span class="poeco-tribe-bar-text">@tribe.Name</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public EcoStats? Stats { get; set; }
    [Parameter] public IReadOnlyList<TribeStateDto>? Tribes { get; set; }
    [Parameter] public int Width { get; set; } = 480;
    [Parameter] public int Height { get; set; } = 180;

    private string GetSeries(int speciesIndex)
    {
        if (Stats?.PopHistory is null || Stats.PopHistory.Length < 4) return string.Empty;
        var all = PopulationSeries.AllSeries(Stats.PopHistory, Width, Height - 8);
        return speciesIndex < all.Length ? all[speciesIndex] : string.Empty;
    }
}
