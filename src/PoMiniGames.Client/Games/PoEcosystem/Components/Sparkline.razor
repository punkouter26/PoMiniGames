@using PoMiniGamesClient.Games.PoEcosystem.Models
@using PoMiniGamesClient.Games.PoSurvive.Features.Charts

@* The always-on population sparkline (bottom-left). The full chart lives in the dashboard;
   this is the same data at a glance, with a text summary for screen readers. *@
<figure class="poeco-spark">
    <svg viewBox="0 0 320 70" preserveAspectRatio="none" class="poeco-spark-svg" role="img" aria-label="@Summary">
        @for (var s = 0; s < SpeciesCount; s++)
        {
            var points = Points(s);
            if (points is not null)
            {
                <polyline class="poeco-spark-line" style="stroke: @Colour(s)" points="@points" />
            }
        }
    </svg>
    <figcaption class="poeco-spark-legend">
        @for (var s = 0; s < SpeciesCount; s++)
        {
            <span><i style="background: @Colour(s)" aria-hidden="true"></i>@Names[s] @Count(s)</span>
        }
    </figcaption>
    <p class="poeco-sr-only" aria-live="polite">@Summary</p>
</figure>

@code {
    private const int SpeciesCount = 4;
    private const double Width = 320, Height = 70;
    private static readonly string[] Names = ["Rabbits", "Deer", "Wolves", "Humans"];
    private static readonly string[] Colours = ["var(--accent-warning)", "var(--accent-success)", "var(--accent-danger)", "var(--accent)"];

    [Parameter] public EcoStats? Stats { get; set; }

    private static string Colour(int species) => Colours[species];
    private int Count(int species) => Stats?.Counts is { Length: SpeciesCount } c ? c[species] : 0;

    private string Summary => Stats is null
        ? "Population chart, no data yet"
        : $"Year {Stats.Year}: " + string.Join(", ", Enumerable.Range(0, SpeciesCount).Select(s => $"{Count(s)} {Names[s].ToLowerInvariant()}"));

    /// <summary>Polyline for one species over the sampled history (flat [tick*4+species]).</summary>
    private string? Points(int species)
    {
        var h = Stats?.PopHistory;
        if (h is null || h.Length < SpeciesCount * 2) return null;
        var samples = h.Length / SpeciesCount;
        var max = 1;
        for (var i = 0; i < h.Length; i++) if (h[i] > max) max = h[i];
        var sb = new System.Text.StringBuilder(samples * 12);
        for (var k = 0; k < samples; k++)
        {
            var x = samples == 1 ? 0 : Width * k / (samples - 1);
            var y = Height - Height * h[k * SpeciesCount + species] / max;
            if (k > 0) sb.Append(' ');
            sb.Append(ChartGeometry.N(x)).Append(',').Append(ChartGeometry.N(y));
        }
        return sb.ToString();
    }
}
