@* The always-on population sparkline (bottom-left). The full chart lives in the dashboard;
   this is the same data at a glance, with a text summary for screen readers. *@
<figure class="poeco-spark">
    <svg viewBox="0 0 320 70" preserveAspectRatio="none" class="poeco-spark-svg" role="img" aria-label="@Summary">
        @for (var s = 0; s < EcoSpeciesInfo.Count; s++)
        {
            var points = Series[s];
            if (points.Length > 0)
            {
                <polyline class="poeco-spark-line" style="stroke: @EcoSpeciesInfo.ColourOf(s)" points="@points" />
            }
        }
    </svg>
    <figcaption class="poeco-spark-legend">
        @for (var s = 0; s < EcoSpeciesInfo.Count; s++)
        {
            <span><i style="background: @EcoSpeciesInfo.ColourOf(s)" aria-hidden="true"></i>@EcoSpeciesInfo.PluralOf(s) @Count(s)</span>
        }
    </figcaption>
    <p class="gps-sr-only" aria-live="polite">@Summary</p>
</figure>

@code {
    private const double Width = 320, Height = 70;

    [Parameter] public EcoStats? Stats { get; set; }

    private string[] Series => PopulationSeries.AllSeries(Stats?.PopHistory, Width, Height);

    private int Count(int species) => Stats?.Counts is { Length: EcoSpeciesInfo.Count } c ? c[species] : 0;
    private string Summary => PopulationSeries.Summary(Stats);
}
