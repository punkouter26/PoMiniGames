@using PoMiniGames.Shared.Games.PoEcosystem
@inject UiFeedbackService Feedback
@* The tribe's ladder and the island's chronicle. The ladder is read straight from the sim
   (sim/behavior/tech.js); the chronicle is a server-side model call, so it is written on
   request — one saga per decade at most, and the button says so. *@
<div class="poeco-tribe">
    <h3>The @(Stats?.Tech?.Tribe ?? "island") tribe</h3>
    <ol class="poeco-ladder" aria-label="The tribe's ladder">
        @for (var k = 0; k < Tiers.Length; k++)
        {
            var level = Stats?.Tech?.Level ?? 0;
            <li class="@(k <= level ? "poeco-ladder--done" : "") @(k == level + 1 ? "poeco-ladder--next" : "")">
                <span class="poeco-ladder-name">@Tiers[k].Name</span>
                <span class="poeco-ladder-what">@Tiers[k].What</span>
            </li>
        }
    </ol>
    @if (Stats?.Tech is { } tech)
    {
        <p class="poeco-note">
            @(tech.Campfire ? "The fire is lit. " : "")@(tech.Fields > 0 ? $"{tech.Fields} field plots. " : "")@(tech.Tower ? "The tower stands." : "")
        </p>
    }

    @if (Stats?.Tribes is not null && Stats.Tribes.Length >= 2)
    {
        <DiplomacyWeb Tribes="@Stats.Tribes" Caravans="@Stats.Caravans" OnFocusTribe="@OnFocusTribe" />
    }

    <h3>Council pacts</h3>
    @if (Stats?.Treaties is { Length: > 0 } pacts)
    {
        <ul class="poeco-pacts">
            @foreach (var t in pacts.Reverse().Take(8))
            {
                <li>
                    <strong>@t.Title</strong> <span class="poeco-badge">@ActionLabel(t.Action)</span>
                    <span class="poeco-note">@TribeName(t.TribeA) · @TribeName(t.TribeB)@(t.Paid > 0 ? $" · {t.Paid} {t.Resource} paid" : "")</span>
                    @if (!string.IsNullOrWhiteSpace(t.Narrative)) { <p>@t.Narrative</p> }
                </li>
            }
        </ul>
    }
    else
    {
        <p class="poeco-note">When clans make peace or go to war, the Chieftain Council (a server model) decides what the pact says: tribute, armistice, or a war that goes on. It needs sign-in, and it is the clans' decision, not yours.</p>
    }

    @if (Legends.Count > 0)
    {
        <h3>Legends</h3>
        <ul class="poeco-legends">
            @foreach (var l in Legends)
            {
                <li><strong>@l.Epithet</strong> <span class="poeco-note">year @l.Year</span><p>@l.Legend</p></li>
            }
        </ul>
    }

    <h3>Chronicle</h3>
    <div class="poeco-chronicle-actions">
        <button type="button" class="poeco-btn poeco-btn--primary" disabled="@(Busy || Stats is null || Stats.Year <= FromYear)" @onclick="HandleWriteAsync">
            @(Busy ? "The chronicler is writing…" : Stats is null || Stats.Year <= FromYear ? "Nothing new to chronicle yet" : $"Write the chronicle of years {FromYear}–{Stats.Year}")
        </button>
        <p class="poeco-note">A short saga of the island's recent history, written by a model from the world log. Spends a little of your daily AI allowance.</p>
    </div>
    @if (Chronicles.Count == 0)
    {
        <p class="poeco-note">No sagas yet.</p>
    }
    else
    {
        @foreach (var c in Chronicles)
        {
            <article class="poeco-saga" @onclick="async () => await Feedback.CrystalPingAsync()">
                <h4>@c.Title @if (c.Mock) { <span class="poeco-badge">mock</span> }</h4>
                <p>@c.Saga</p>
                @if (!string.IsNullOrWhiteSpace(c.Epigraph))
                {
                    <p class="poeco-saga-epigraph">— @c.Epigraph</p>
                }
            </article>
        }
    }
</div>

@code {
    private static readonly (string Name, string What)[] Tiers =
    [
        ("Camp", "huts and hunting"),
        ("Fire", "a hearth that scares wolves and warms the tribe at night"),
        ("Palisade", "a fence with gates that keeps predators out of the village"),
        ("Farming", "berry fields that ripen three times faster"),
        ("Watchtower", "the tribe sees further and throws further"),
    ];

    [Parameter] public EcoStats? Stats { get; set; }
    [Parameter] public IReadOnlyList<EcoChronicle> Chronicles { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public int FromYear { get; set; }
    [Parameter] public EventCallback OnWrite { get; set; }
    [Parameter] public EventCallback<int> OnFocusTribe { get; set; }
    [Parameter] public IReadOnlyList<(int Year, string Epithet, string Legend)> Legends { get; set; } = [];

    private string TribeName(int id) => Stats?.Tribes?.FirstOrDefault(t => t.Id == id)?.Name ?? $"Clan {id + 1}";

    private static string ActionLabel(string action) => action switch
    {
        "PeaceTreaty" => "peace", "Armistice" => "armistice", "DemandTribute" => "tribute", "WarDeclaration" => "war", _ => action,
    };

    private async Task HandleWriteAsync()
    {
        await Feedback.GongAsync(110);
        await OnWrite.InvokeAsync();
    }
}
