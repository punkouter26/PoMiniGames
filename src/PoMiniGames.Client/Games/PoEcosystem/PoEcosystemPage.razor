@page "/poecosystem"
@page "/poecosystem/{Mode}"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Models
@inject PlayerNameService PlayerNameService

<PageTitle>PoEcosystem · A living island</PageTitle>

<GameShell Title=@TitleContent
           Player="@_playerName"
           BackTo="/"
           GameKey="poecosystem"
           RequiresWebGl="true"
           Fullscreen="true">

    @if (!_introDismissed)
    {
        <GameIntro CueScope="poecosystem"
                   Title=@TitleContent
                   Objective="A living island that runs without you — creatures born, hungry and ageing while you watch."
                   Controls=@HowToPlayContent
                   Mode="@(IsDemo ? GameIntro.IntroMode.Demo : GameIntro.IntroMode.OnePlayer)"
                   OnStart="@(() => _introDismissed = true)" />
    }
    else
    {
        <PoEcosystemViewer IsDemo="IsDemo" />
    }
</GameShell>

@code {
    [Parameter] public string? Mode { get; set; }

    private string _playerName = "";
    private bool _introDismissed;

    private bool IsDemo => GameModes.Parse(Mode) == GameMode.Demo;

    private RenderFragment TitleContent => @<span><span aria-hidden="true">🌿</span> PoEcosystem · A living island</span>;

    private RenderFragment HowToPlayContent => @<div>
        @* 2026-09-11: word budget — the intro card is capped at 100 words. The
           dashboard's full inventory (telemetry export, almanac, model picker)
           is discoverable in situ; the card teaches movement + inspection only. *@
        <p><strong>You are an invisible god floating over the island.</strong></p>
        <ul>
            <li><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> fly · <kbd>Space</kbd>/<kbd>Ctrl</kbd> rise and sink · <kbd>Shift</kbd> speed · <kbd>F</kbd> walk the ground</li>
            <li><kbd>E</kbd> or click: inspect the creature under the crosshair — name, age, drives, last thought. <kbd>T</kbd> follows it.</li>
            <li><kbd>Tab</kbd>: dashboard — population chart, world log, almanac, settings</li>
            <li><kbd>0</kbd>–<kbd>3</kbd>: pause, 1×, 2×, 4× speed</li>
            <li>Storms, rockslides and the volcano happen on their own</li>
        </ul>
    </div>;

    protected override void OnInitialized() => _playerName = PlayerNameService.GetPlayerName();
}
