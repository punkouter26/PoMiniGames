@using PoMiniGamesClient.Games.PoEcosystem.Components
@using PoMiniGamesClient.Games.PoEcosystem.Models
@implements IAsyncDisposable

<div class="poeco-root @(_narrow ? "poeco-narrow" : "")">

    @* The three.js canvas is created by the engine inside this host. *@
    <div id="poeco-world" class="poeco-world" role="img" aria-label="First-person view of the living island" @onclick="TriggerShockwaveAsync"></div>

    @if (_resumePrompt is not null)
    {
        <div class="poeco-resume" role="dialog" aria-label="Resume or start a new world">
            <h2>An island is waiting</h2>
            <p>Year @_resumePrompt.Year, @Counts(_resumePrompt.Counts) — saved @Ago(_resumePrompt.SavedAt).</p>
            <div class="poeco-resume-actions">
                <button class="poeco-btn poeco-btn--primary" @onclick="() => BootAsync(resume: true)">Resume</button>
                <button class="poeco-btn" @onclick="() => BootAsync(resume: false)">New world</button>
            </div>
        </div>
    }

    @if (_booted)
    {
        <div class="poeco-hud" data-glass aria-hidden="@(_dashboardOpen ? "true" : "false")">
            <div class="poeco-crosshair" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="20" height="20"><circle cx="10" cy="10" r="1.5" fill="currentColor"></circle><path d="M10 2v4M10 14v4M2 10h4M14 10h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            </div>

            <div class="poeco-hud-top">
                <HudBar Stats="_stats" Sound="_sound" OnSound="ToggleSoundAsync" OnDashboard="ToggleDashboard"
                        Director="_directorOn" OnDirector="ToggleDirectorAsync" Pip="_pipOn" OnPip="TogglePipAsync" />

                <div class="poeco-camera-dock" role="toolbar" aria-label="Camera presets">
                    <button type="button" class="poeco-btn poeco-btn--sm" @onclick="() => SetCameraPresetAsync(CameraPreset.IslandOverview)" title="Overhead island overview">🏝️ Overview</button>
                    <button type="button" class="poeco-btn poeco-btn--sm" @onclick="() => SetCameraPresetAsync(CameraPreset.AmberClan)" title="Focus Amber Clan">🟡 Amber</button>
                    <button type="button" class="poeco-btn poeco-btn--sm" @onclick="() => SetCameraPresetAsync(CameraPreset.CobaltClan)" title="Focus Cobalt Clan">🔵 Cobalt</button>
                    <button type="button" class="poeco-btn poeco-btn--sm" @onclick="() => SetCameraPresetAsync(CameraPreset.VerdantClan)" title="Focus Verdant Clan">🟢 Verdant</button>
                </div>
            </div>

            @if (_directorOn)
            {
                <p class="poeco-director" role="status">
                    <span aria-hidden="true">🎬</span> Auto-director
                    @if (!string.IsNullOrWhiteSpace(_directorCaption))
                    {
                        <span> · @_directorCaption</span>
                    }
                    <span class="poeco-director-hint">move to take the camera back</span>
                </p>
            }

            @if (_visiting)
            {
                <p class="poeco-visiting" role="status">Visiting a shared island — nothing here is saved over your own.</p>
            }

            <div class="poeco-minimap-wrap">
                <canvas id="poeco-minimap" class="poeco-minimap" width="200" height="200" aria-label="Map of the island"></canvas>
            </div>

            <Sparkline Stats="_stats" />

            @if (_showKeys)
            {
                <div class="poeco-keys" aria-hidden="true">
                    @foreach (var (key, what) in KeyLegend)
                    {
                        <span><kbd>@key</kbd> @what</span>
                    }
                </div>
            }

            @if (!_pointerLocked && !_narrow && !_directorOn)
            {
                <p class="poeco-lock-hint">Click to look around</p>
            }

            <div class="poeco-decree-dock" role="form" aria-label="Divine Decree Console">
                <span class="poeco-decree-icon" aria-hidden="true">⚡</span>
                <input type="text" class="poeco-decree-input" @bind="_decreeInput" @bind:event="oninput" @onkeydown="HandleDecreeKeyDownAsync"
                       placeholder="Issue Divine Decree (e.g. 'Bless Amber with food', 'Summon rain')..."
                       disabled="@_decreeBusy" />
                <button type="button" class="poeco-btn poeco-btn--sm poeco-btn--primary" @onclick="SendDecreeAsync" disabled="@(_decreeBusy || string.IsNullOrWhiteSpace(_decreeInput))">
                    @(_decreeBusy ? "..." : "Decree")
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_decreeFeedback))
            {
                <div class="poeco-decree-feedback" role="status">
                    <span>✨ @_decreeFeedback</span>
                </div>
            }

            @if (_narrow)
            {
                <div class="poeco-touch">
                    <div class="poeco-pad" @ontouchstart="TouchStart" @ontouchmove="TouchMove" @ontouchend="TouchEnd" aria-label="Move"></div>
                    <div class="poeco-touch-buttons">
                        <button class="poeco-btn poeco-btn--round" @onclick="() => Interop.ToggleFlyAsync()" aria-label="Toggle flying">F</button>
                        <button class="poeco-btn poeco-btn--round" @onclick="InspectAsync" aria-label="Inspect what is ahead">E</button>
                    </div>
                </div>
            }
        </div>

        @if (_detail is not null && !_dashboardOpen)
        {
            <InspectorPopover Detail="_detail"
                              OnFollow="FollowAsync"
                              OnClose="ClearSelectionAsync"
                              OnWatch="ToggleWatchAsync"
                              OnRename="RenameAsync"
                              OnFamily="() => OpenLineageAsync(_detail.Handle)" />
        }

        @if (_lineageOpen && _lineage is not null && !_dashboardOpen)
        {
            <LineagePanel Tree="_lineage" OnSelect="SelectKinAsync" OnClose="CloseLineage" />
        }

        @if (_banner is not null)
        {
            <EndBanner Text="@_banner" OnRestart="() => NewWorldAsync(null)" />
        }

        @if (_dashboardOpen)
        {
            <DashboardOverlay Stats="_stats"
                              Events="_log"
                              Thoughts="_thoughts"
                              Chronicles="_chronicles"
                              Worlds="_worlds"
                              Gallery="_gallery"
                              Llm="_llm"
                              Models="_models"
                              WebGpu="_webGpu"
                              CloudThoughts="_cloudThoughts"
                              CloudThoughtsLeft="@(CloudThoughtsPerSession - _cloudThoughtsSpent)"
                              SignedIn="@Auth.IsAuthenticated"
                              CloudBusy="_cloudBusy"
                              CloudMessage="@_cloudMessage"
                              ChronicleBusy="_chronicleBusy"
                              ChronicleFromYear="_chronicledToYear"
                              Tint="_tint"
                              Seed="@_seedInput"
                              SeedChanged="v => _seedInput = v"
                              OnClose="ToggleDashboard"
                              OnFocusTribe="FocusTribeByIdAsync"
                              OnSpeed="SetSpeedAsync"
                              OnLlmToggle="SetLlmAsync"
                              OnNewWorld="NewWorldAsync"
                              OnExportTelemetry="ExportTelemetryAsync"
                              OnSelectThought="SelectThoughtAsync"
                              OnSelectKin="SelectKinAsync"
                              OnUnwatch="UnwatchAsync"
                              OnTint="SetTintAsync"
                              OnWriteChronicle="WriteChronicleAsync"
                              OnCloudRefresh="() => RefreshCloudAsync()"
                              OnCloudSave="SaveToCloudAsync"
                              OnCloudLoad="LoadFromCloudAsync"
                              OnCloudDelete="DeleteFromCloudAsync"
                              OnCloudShare="t => ShareAsync(t.Slot, t.Public)"
                              OnVisit="VisitAsync" />
        }
    }

    @if (_error is not null)
    {
        <p class="poeco-error" role="alert">@_error</p>
    }
</div>
