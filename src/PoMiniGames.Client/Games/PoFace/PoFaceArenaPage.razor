@page "/face/arena"
@page "/face/demo"
@using PoMiniGamesClient.Components
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject KioskCoordinator Kiosk

<GameShell Title=@TitleContent BackTo="@_backTo"
           GameOver="@(_phase == "GameOver" && !_isDemo)"
           OnPlayAgain="PlayAgainFace"
           GameSummary="@GameSummaryContent">
    @if (_phase == "Init")
    {
        <p>Initializing camera…</p>
    }
    else if (_phase == "PermissionDenied")
    {
        <div class="pf-perm">
            <h2>Camera permission denied</h2>
            <p>The PoFace game needs access to your webcam to score facial expressions. Please allow camera access in your browser settings and reload.</p>
            <button class="gps-btn gps-btn gps-btn--secondary" @onclick="ActivateStubMode">Continue without camera (stub mode)</button>
        </div>
    }
    else if (_phase == "NoCamera")
    {
        <div class="pf-perm">
            <h2>No camera detected</h2>
            <p>We couldn't find a webcam on this device. You can continue in stub mode (no real scoring).</p>
            <button class="gps-btn gps-btn gps-btn--secondary" @onclick="ActivateStubMode">Continue in stub mode</button>
        </div>
    }
    else if (_phase == "Ready")
    {
        @if (_stub)
        {
            <div class="pf-ready">
                <h2 class="gps-phase-h">Round @(_currentRound + 1) of 5</h2>
                <p class="pf-prompt">Tap the face that shows: <strong>@_currentEmotion</strong></p>
                <div class="pf-choice-grid pf-choice-grid--wrap">
                    @foreach (var emo in _choices)
                    {
                        var choice = emo;
                        <button class="gps-btn pf-face-choice pf-face-choice--large" @onclick="() => PickEmotion(choice)">@EmojiFor(choice)</button>
                    }
                </div>
                <p class="pf-score-line">Score: <strong>@_localTotal</strong></p>
            </div>
        }
        else
        {
            <div class="pf-ready">
                <h2 class="gps-phase-h">Round @(_currentRound + 1) of 5</h2>
                <p class="pf-prompt">Make this face: <strong>@_currentEmotion</strong></p>
                <video id="pf-webcam-preview" autoplay playsinline muted class="pf-webcam-preview"></video>
                <div id="pf-frozen-overlay" class="pf-frozen-overlay"></div>
                <div class="pf-actions">
                    <button class="gps-btn gps-btn gps-btn--primary" @onclick="CaptureAndScore">📸 Capture</button>
                </div>
            </div>
        }
    }
    else if (_phase == "Scoring")
    {
        <p>Analyzing your expression…</p>
    }
    else if (_phase == "Reveal")
    {
        @if (_stub)
        {
            <div class="pf-reveal">
                <h2 class="gps-phase-h">Round @(_currentRound + 1) result</h2>
                <p>Target: <strong>@_currentEmotion @EmojiFor(_currentEmotion)</strong></p>
                <p>You picked: <strong class="pf-picked-emoji">@EmojiFor(_picked)</strong></p>
                <p>@(_lastCorrect ? $"✅ Correct! +{_lastPoints} (speed bonus)" : "❌ Not quite")</p>
                @if (_streak > 1)
                {
                    <p>🔥 Streak: <strong>@_streak</strong></p>
                }
                <p>Total: <strong>@_localTotal</strong></p>
                <button class="gps-btn gps-btn gps-btn--primary" @onclick="NextRound">@(_currentRound + 1 < 5 ? "Next round" : "See results")</button>
            </div>
        }
        else
        {
            <div class="pf-reveal">
                <h2 class="gps-phase-h">Round @(_currentRound + 1) result</h2>
                <p>Target: <strong>@_currentEmotion</strong></p>
                <p>Confidence: @((_lastScore?.Confidence * 100)?.ToString("F0"))%</p>
                <p>Head pose valid: @(_lastScore?.HeadPoseValid == true ? "✅" : "❌")</p>
                <p>Score: <strong>@_lastScore?.Score</strong></p>
                <p>Total: <strong>@_lastScore?.TotalScore</strong></p>
                <button class="gps-btn gps-btn gps-btn--primary" @onclick="NextRound">@(_currentRound + 1 < 5 ? "Next round" : "See results")</button>
            </div>
        }
    }
    else if (_phase == "DemoReady" || _phase == "DemoReveal" || _phase == "DemoFinal")
    {
        @* ─── PoFace demo kiosk view ──────────────────────────────────────────
           Shown when ?demo=1 is on the URL. Synthetic inline SVG face morphs
           to the round's target emotion (Happiness/Surprise/Anger/Sadness/Fear)
           so the kiosk viewer sees a face actually change; the choice chips
           underneath show all 5 emotions for context. We always auto-pick the
           correct chip in `DemoTick`, so the "score" ticks up to 50 every
           single time — this is a showcase, not a representation of accuracy. *@
        <div class="pf-demo">
            <h2 class="gps-phase-h">@(_phase == "DemoFinal" ? "Demo final" : $"Round {_currentRound + 1} of 5")</h2>

            <svg viewBox="0 0 200 200"
                 class="pf-demo-face"
                 role="img"
                 aria-label="Synthetic face showing @_currentEmotion">
                <defs>
                    <radialGradient id="pfDemoFaceBg" cx="50%" cy="40%" r="60%">
                        <stop offset="0%" stop-color="#ffd29a" />
                        <stop offset="100%" stop-color="#f6a85b" />
                    </radialGradient>
                </defs>
                <!-- Face background -->
                <circle cx="100" cy="100" r="92" fill="url(#pfDemoFaceBg)" stroke="#b06a2c" stroke-width="3" />
                @FaceSvgFor(_currentEmotion)
            </svg>

            @* NetRun10 follow-up: the demo's synthetic face doubles as a
               "fake image" fed through webcam.js' capture pipeline so the
               real scoring API (/api/face/sessions/.../rounds/.../score)
               is exercised end-to-end. The hidden SVG below mirrors the
               visible one and is what webcamInterop.setDemoSvgMarkup
               pulls markup from during the auto-pick tick. *@
            <svg id="pf-demo-face-source"
                 viewBox="0 0 200 200"
                 class="pf-demo-face-source"
                 aria-hidden="true">
                <defs>
                    <radialGradient id="pfDemoFaceBgSource" cx="50%" cy="40%" r="60%">
                        <stop offset="0%" stop-color="#ffd29a" />
                        <stop offset="100%" stop-color="#f6a85b" />
                    </radialGradient>
                </defs>
                <circle cx="100" cy="100" r="92" fill="url(#pfDemoFaceBgSource)" stroke="#b06a2c" stroke-width="3" />
                @FaceSvgFor(_currentEmotion)
            </svg>

            @if (_phase == "DemoFinal")
            {
                <p class="pf-prompt">Round 1 of 5 — looping…</p>
            }
            else
            {
                <p class="pf-prompt">Make this face: <strong>@_currentEmotion</strong> @_emotionEmoji</p>
            }

            <div class="pf-choice-grid pf-choice-grid--wrap pf-demo-choices">
                @foreach (var emo in RoundOrder)
                {
                    var choice = emo;
                    var isTarget = choice == _currentEmotion;
                    var isPicked = _phase == "DemoReveal" && _picked == choice;
                    var cssClass = $"pf-face-choice pf-face-choice--large pf-demo-chip" +
                                   (isTarget ? " pf-demo-chip--target" : "") +
                                   (isPicked ? " pf-demo-chip--picked" : "");
                    <button type="button"
                            class="@cssClass"
                            disabled
                            aria-disabled="true"
                            title="@choice">
                        <span class="pf-demo-chip-emoji">@EmojiFor(choice)</span>
                        <span class="pf-demo-chip-label">@choice</span>
                    </button>
                }
            </div>

            @if (_phase == "DemoReady")
            {
                <p class="pf-score-line">Score: <strong>@_localTotal</strong> / 50</p>
            }
            else if (_phase == "DemoReveal")
            {
                <p class="pf-reveal-line">
                    <span class="pf-picked-emoji">@EmojiFor(_picked)</span>
                    ✅ Correct! +@_lastPoints
                    @if (_streak > 1)
                    {
                        <span> · 🔥 Streak @_streak</span>
                    }
                </p>
                <p class="pf-score-line">Total: <strong>@_localTotal</strong> / 50</p>
            }
            else if (_phase == "DemoFinal")
            {
                <p class="pf-reveal-line">🎉 Final score: <strong>@_localTotal</strong> / 50</p>
            }
        </div>
    }
    @* Game-over is shown in the shared end-of-game modal (GameSummaryContent). *@

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="pf-error">@_error</p>
    }
</GameShell>

@code {
    private RenderFragment TitleContent => @<span>🙂 PoFace · Arena</span>;

    private RenderFragment GameSummaryContent => @<div>
        @if (_isDemo)
        {
            <div>🎮 Demo highlight · Total: <strong>@_finalTotal</strong> / 50</div>
            <div class="pf-autorestart">Auto-restarts in 5 s…</div>
        }
        else
        {
            <div>🎉 Total score: <strong>@_finalTotal</strong> / 50</div>
            @if (!_stub && _sessionId is not null)
            {
                <div><a href="@($"/face/recap/{_sessionId}")">View full recap →</a></div>
            }
        }
    </div>;

    // Play Again from the end-of-game modal: stub mode restarts instantly;
    // camera mode re-creates a session and re-initializes the webcam.
    private async Task PlayAgainFace()
    {
        if (_isDemo) { DemoPlayAgain(); return; }
        if (_stub) { ResetStub(); return; }
        _phase = "Init";
        _currentRound = 0;
        _finalTotal = 0;
        _lastScore = null;
        _error = null;
        await OnInitializedAsync();
    }

    private string _phase = "Init";
    private string? _sessionId;
    private int _currentRound;
    private string _currentEmotion = "Happiness";
    private FaceScoreResponse? _lastScore;
    private int _finalTotal;
    private string? _error;

    // Offline ("stub") mode: a real, camera-free emoji-matching mini-game.
    private bool _stub;
    private int _localTotal;
    private bool _lastCorrect;
    private string? _picked;
    private string[] _choices = Array.Empty<string>();
    private DateTime _roundShownAt = DateTime.UtcNow;
    private int _streak;
    private int _lastPoints;

    // Demo mode: synthetic SVG face + auto-pick loop, no camera required.
    [SupplyParameterFromQuery(Name = "demo")] public int DemoQuery { get; set; } = 0;
    [SupplyParameterFromQuery(Name = "kiosk")] public int KioskNext { get; set; } = -1;
    private bool _isDemo;
    private System.Threading.Timer? _demoTimer;
    private int _demoRoundPoints; // per-round fake points added on the demo loop
    // Demo "back" link goes home instead of to the camera home, because
    // demo doesn't need the camera-permission landing screen.
    private string _backTo = "/face";

    private static readonly string[] RoundOrder = { "Happiness", "Surprise", "Anger", "Sadness", "Fear" };

    protected override async Task OnInitializedAsync()
    {
        if (DemoQuery == 1 || _isDemo || (Navigation.Uri?.EndsWith("/face/demo", StringComparison.OrdinalIgnoreCase) ?? false))
        {
            // Demo never touches the network or camera. Hand the cross-demo
            // rotation to the shared KioskCoordinator (same pattern as the
            // other game demos). Back link goes straight home; the demo has
            // no other game mode to "return" to.
            _isDemo = true;
            _backTo = "/";
            Kiosk.SetCurrent("poface-demo");
            StartDemo();
            return;
        }

        // The session POST is only needed for score submission + recap. Camera
        // playback should never be blocked by a transient network hiccup or a
        // navigation-aborted fetch, so we make the session request best-effort
        // and ALWAYS try to open the camera afterwards. If we have a session
        // id, score uploads go to the API; if we don't, scoring silently no-ops
        // (UI stays usable, persistence is the only casualty).
        await TryStartSessionAsync();
        await TryInitCameraAsync();
        _currentEmotion = RoundOrder[0];
    }

    /// <summary>
    /// Best-effort POST to <c>/api/face/sessions</c>. Never throws — failures
    /// (auth, network, navigation-aborted) just leave <see cref="_sessionId"/>
    /// null and the camera/play flow continues without persisted scoring.
    /// </summary>
    private async Task TryStartSessionAsync()
    {
        try
        {
            var resp = await Http.PostAsync("/api/face/sessions", content: null);
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"Session start returned {(int)resp.StatusCode}; scores won't be saved this round.";
                return;
            }
            var session = await resp.Content.ReadFromJsonAsync(ApiJsonContext.Default.FaceSessionDto);
            _sessionId = session?.SessionId;
            if (_sessionId is not null) _error = null;
        }
        catch (Exception ex)
        {
            // Transient (network blip, navigation abort, etc.) — keep going,
            // the camera path is independent.
            _error = ex is HttpRequestException or TaskCanceledException
                ? $"Session start deferred: {ex.Message}"
                : $"Session start error: {ex.Message}";
        }
    }

    /// <summary>
    /// Calls <c>webcamInterop.initCamera</c> and maps the returned status code
    /// to a phase. Retries once if the first attempt fails with a transient
    /// error, then falls through to the appropriate fallback screen.
    /// </summary>
    private async Task TryInitCameraAsync()
    {
        for (var attempt = 1; attempt <= 2; attempt++)
        {
            try
            {
                var status = await JS.InvokeAsync<string>("webcamInterop.initCamera", "pf-webcam-preview");
                _phase = status switch
                {
                    "ok" => "Ready",
                    "permission-denied" => "PermissionDenied",
                    "camera-unavailable" => "NoCamera",
                    _ => "NoCamera",
                };
                if (_phase == "Ready" || _phase == "PermissionDenied") return;
                if (attempt < 2) await Task.Delay(250);
            }
            catch (Exception ex)
            {
                if (attempt < 2 && (ex is JSException || ex is TaskCanceledException))
                {
                    await Task.Delay(250);
                    continue;
                }
                _error = $"Camera init failed: {ex.Message}";
                _phase = "NoCamera";
                return;
            }
        }
    }

    // ── Demo driver ─────────────────────────────────────────────────────────
    // Renders an inline SVG face whose expression is set to the current
    // round's emotion. The SVG is registered with webcam.js so captureFrame()
    // converts it to a real JPEG and feeds it through the SAME scoring
    // pipeline the live camera uses (/api/face/sessions/.../rounds/.../score).
    // Auto-advances every round. Shows a Game-Over modal once after round 5,
    // then restarts the loop. Total runtime ≈ 25 s per cycle.
    private void StartDemo()
    {
        _currentRound = 0;
        _currentEmotion = RoundOrder[0];
        _localTotal = 0;
        _finalTotal = 0;
        BuildChoices();
        _phase = "DemoReady";
        // Begin demo session lazily on first tick (so we don't POST if the
        // user navigates away immediately).
        _ = RegisterDemoSvgAsync();
        ScheduleDemoTick(TimeSpan.FromMilliseconds(1500));   // show round → capture+score
    }

    /// <summary>
    /// Reads the hidden #pf-demo-face-source SVG's outerHTML and pushes it
    /// into webcam.js so captureFrame() routes through the SVG → canvas →
    /// JPEG pipeline instead of the stub 1×1 white pixel.
    /// </summary>
    private async Task RegisterDemoSvgAsync()
    {
        try
        {
            var markup = await JS.InvokeAsync<string>(
                "eval",
                "(document.getElementById('pf-demo-face-source')?.outerHTML) || ''");
            await JS.InvokeVoidAsync("webcamInterop.setDemoSvgMarkup", markup);
        }
        catch
        {
            // Non-fatal — demo will fall back to the stub JPEG.
        }
    }

    /// <summary>
    /// Calls the real /api/face/sessions endpoint so demo captures flow
    /// through persisted scoring like a live game. Returns the session id
    /// or null if the call fails.
    /// </summary>
    private async Task<string?> StartDemoSessionAsync()
    {
        try
        {
            var resp = await Http.PostAsync("/api/face/sessions", content: null);
            if (!resp.IsSuccessStatusCode) return null;
            var session = await resp.Content.ReadFromJsonAsync(ApiJsonContext.Default.FaceSessionDto);
            return session?.SessionId;
        }
        catch
        {
            return null;
        }
    }

    private void ScheduleDemoTick(TimeSpan delay, bool advanceRound = false)
    {
        _demoTimer?.Dispose();
        _demoTimer = new System.Threading.Timer(
            _ => InvokeAsync(() => { DemoTick(advanceRound); StateHasChanged(); }),
            null,
            (int)delay.TotalMilliseconds,
            Timeout.Infinite);
    }

    private void DemoTick(bool advanceRound)
    {
        if (!_isDemo) return;
        _demoTimer?.Dispose();

        if (_phase == "DemoReady")
        {
            // Auto-pick the correct emotion chip and feed the synthetic
            // SVG through webcam.js' real capture pipeline. The scoring API
            // returns whatever the analyzer makes of the SVG (likely a low
            // score for a synthetic face, which is honest and lets the
            // kiosk demo surface what real feedback looks like).
            _picked = _currentEmotion;
            _lastCorrect = true;
            _ = InvokeAsync(async () =>
            {
                await RegisterDemoSvgAsync();
                await CaptureDemoFrameAsync();
            });
            _demoRoundPoints = 10;
            _localTotal += _demoRoundPoints;
            _streak++;
            _lastPoints = _demoRoundPoints;
            _phase = "DemoReveal";
            ScheduleDemoTick(TimeSpan.FromMilliseconds(2200));   // reveal → next round or final
            return;
        }

        if (_phase == "DemoReveal")
        {
            _currentRound++;
            if (_currentRound >= 5)
            {
                _phase = "DemoFinal";
                _finalTotal = _localTotal;
                // Auto-restart after the kiosk has had time to read the final.
                ScheduleDemoTick(TimeSpan.FromSeconds(5), advanceRound: false);
                return;
            }
            _currentEmotion = RoundOrder[_currentRound];
            BuildChoices();
            _phase = "DemoReady";
            _ = RegisterDemoSvgAsync();  // refresh SVG markup for the new emotion
            ScheduleDemoTick(TimeSpan.FromMilliseconds(1300));
            return;
        }

        if (_phase == "DemoFinal")
        {
            // Loop back to round 1 for the next kiosk lap.
            StartDemo();
            return;
        }
    }

    /// <summary>
    /// Runs the same capture → POST pipeline the live camera path uses,
    /// but driven by the registered demo SVG instead of a webcam. Lazily
    /// opens a session on first call. Failures are non-fatal — the demo
    /// just shows the synthetic +10 score without a server round.
    /// </summary>
    private async Task CaptureDemoFrameAsync()
    {
        try
        {
            _sessionId ??= await StartDemoSessionAsync();
            if (_sessionId is null) return;

            var dataUrl = await JS.InvokeAsync<string>("webcamInterop.captureFrame", "pf-webcam-preview");
            if (!dataUrl.StartsWith("data:image/jpeg;base64,", StringComparison.OrdinalIgnoreCase))
            {
                return;
            }
            var base64 = dataUrl.Substring("data:image/jpeg;base64,".Length);
            var bytes = Convert.FromBase64String(base64);

            using var content = new MultipartFormDataContent();
            var imageContent = new ByteArrayContent(bytes);
            imageContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/jpeg");
            content.Add(imageContent, "image", $"demo-round-{_currentRound}.jpg");

            await Http.PostAsync($"/api/face/sessions/{_sessionId}/rounds/{_currentRound}/score", content);
        }
        catch
        {
            // Demo runs even if scoring is offline; visual + synthetic score stays.
        }
    }

    private void DemoPlayAgain()
    {
        _demoTimer?.Dispose();
        StartDemo();
    }

    private async Task ActivateStubMode()
    {
        try { await JS.InvokeVoidAsync("webcamInterop.activateStubMode"); } catch { /* offline mode needs no camera */ }
        ResetStub();
    }

    // Camera-free mini-game: show a target emotion, player taps the matching emoji.
    private void PickEmotion(string choice)
    {
        _picked = choice;
        _lastCorrect = string.Equals(choice, _currentEmotion, StringComparison.Ordinal);
        if (_lastCorrect)
        {
            // Base 6 for a correct answer + up to 4 for speed (answer within ~1s
            // for the full bonus). Caps at 10/round so the total stays out of 50.
            var elapsed = (DateTime.UtcNow - _roundShownAt).TotalSeconds;
            var speedBonus = Math.Clamp(4 - (int)elapsed, 0, 4);
            _lastPoints = 6 + speedBonus;
            _localTotal += _lastPoints;
            _streak++;
        }
        else
        {
            _lastPoints = 0;
            _streak = 0;
        }
        _phase = "Reveal";
    }

    private void BuildChoices()
    {
        _choices = RoundOrder.OrderBy(_ => Random.Shared.Next()).ToArray();
        _roundShownAt = DateTime.UtcNow;
    }

    private void ResetStub()
    {
        _stub = true;
        _localTotal = 0;
        _currentRound = 0;
        _lastScore = null;
        _picked = null;
        _streak = 0;
        _currentEmotion = RoundOrder[0];
        BuildChoices();
        _phase = "Ready";
    }

    private static string EmojiFor(string? emotion) => emotion switch
    {
        "Happiness" => "😄",
        "Surprise" => "😲",
        "Anger" => "😠",
        "Sadness" => "😢",
        "Fear" => "😱",
        _ => "❓"
    };

    private static MarkupString FaceSvgFor(string emotion) => emotion switch
    {
        // Eyes are at (70, 90) and (130, 90). Mouth coordinates vary per emotion.
        "Happiness" => new MarkupString(
            // Eyes - happy squint arcs
            "<path d='M58 92 Q70 78 82 92' stroke='#222' stroke-width='4' fill='none' stroke-linecap='round' />" +
            "<path d='M118 92 Q130 78 142 92' stroke='#222' stroke-width='4' fill='none' stroke-linecap='round' />" +
            // Mouth - big grin
            "<path d='M70 138 Q100 168 130 138' stroke='#222' stroke-width='5' fill='none' stroke-linecap='round' />" +
            // Optional warm cheek accent
            "<circle cx='62' cy='118' r='7' fill='#f48a8a' opacity='0.55' />" +
            "<circle cx='138' cy='118' r='7' fill='#f48a8a' opacity='0.55' />"),
        "Surprise" => new MarkupString(
            // Eyes - wide circles
            "<circle cx='70' cy='90' r='9' fill='#fff' stroke='#222' stroke-width='3' />" +
            "<circle cx='130' cy='90' r='9' fill='#fff' stroke='#222' stroke-width='3' />" +
            "<circle cx='70' cy='90' r='3' fill='#222' />" +
            "<circle cx='130' cy='90' r='3' fill='#222' />" +
            // Mouth - small O
            "<ellipse cx='100' cy='142' rx='10' ry='14' fill='#222' />" +
            // Eyebrows raised (subtle)
            "<line x1='54' y1='70' x2='86' y2='66' stroke='#222' stroke-width='3' stroke-linecap='round' />" +
            "<line x1='114' y1='66' x2='146' y2='70' stroke='#222' stroke-width='3' stroke-linecap='round' />"),
        "Anger" => new MarkupString(
            // Eyes - narrowed slits, angled brows
            "<line x1='58' y1='88' x2='84' y2='92' stroke='#222' stroke-width='4' stroke-linecap='round' />" +
            "<line x1='116' y1='92' x2='142' y2='88' stroke='#222' stroke-width='4' stroke-linecap='round' />" +
            // Angry brows over eyes
            "<line x1='52' y1='74' x2='86' y2='80' stroke='#222' stroke-width='4' stroke-linecap='round' />" +
            "<line x1='114' y1='80' x2='148' y2='74' stroke='#222' stroke-width='4' stroke-linecap='round' />" +
            // Mouth - frown
            "<path d='M70 148 Q100 124 130 148' stroke='#222' stroke-width='5' fill='none' stroke-linecap='round' />"),
        "Sadness" => new MarkupString(
            // Eyes - droopy
            "<circle cx='70' cy='92' r='4' fill='#222' />" +
            "<circle cx='130' cy='92' r='4' fill='#222' />" +
            // Inner eyebrows tilted up at the inner ends
            "<line x1='58' y1='80' x2='86' y2='86' stroke='#222' stroke-width='3' stroke-linecap='round' />" +
            "<line x1='114' y1='86' x2='142' y2='80' stroke='#222' stroke-width='3' stroke-linecap='round' />" +
            // Single tear drop under left eye
            "<path d='M70 102 Q66 112 70 116 Q74 112 70 102 Z' fill='#7ec8f5' />" +
            // Frown
            "<path d='M70 144 Q100 122 130 144' stroke='#222' stroke-width='5' fill='none' stroke-linecap='round' />"),
        "Fear" => new MarkupString(
            // Eyes - wide, raised brows
            "<circle cx='70' cy='90' r='9' fill='#fff' stroke='#222' stroke-width='3' />" +
            "<circle cx='130' cy='90' r='9' fill='#fff' stroke='#222' stroke-width='3' />" +
            "<circle cx='70' cy='90' r='3' fill='#222' />" +
            "<circle cx='130' cy='90' r='3' fill='#222' />" +
            // High, raised brows
            "<line x1='52' y1='62' x2='88' y2='62' stroke='#222' stroke-width='3' stroke-linecap='round' />" +
            "<line x1='112' y1='62' x2='148' y2='62' stroke='#222' stroke-width='3' stroke-linecap='round' />" +
            // Grimace
            "<path d='M68 144 Q100 132 132 144' stroke='#222' stroke-width='5' fill='none' stroke-linecap='round' />" +
            // Sweat drop
            "<path d='M150 70 Q146 80 150 84 Q154 80 150 70 Z' fill='#7ec8f5' />"),
        _ => new MarkupString("<text x='100' y='110' text-anchor='middle' font-size='18' fill='#222'>❓</text>")
    };

    private string _emotionEmoji => EmojiFor(_currentEmotion);

    private async Task CaptureAndScore()
    {
        if (_sessionId is null) return;
        _phase = "Scoring";
        _error = null;
        try
        {
            // Visual feedback: white-flash the overlay.
            await JS.InvokeVoidAsync("webcamInterop.flashShutter", "pf-frozen-overlay");

            var dataUrl = await JS.InvokeAsync<string>("webcamInterop.captureFrame", "pf-webcam-preview");
            if (!dataUrl.StartsWith("data:image/jpeg;base64,", StringComparison.OrdinalIgnoreCase))
            {
                _error = "Camera capture failed.";
                _phase = "Ready";
                return;
            }
            var base64 = dataUrl.Substring("data:image/jpeg;base64,".Length);
            var bytes = Convert.FromBase64String(base64);

            using var content = new MultipartFormDataContent();
            var imageContent = new ByteArrayContent(bytes);
            imageContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/jpeg");
            content.Add(imageContent, "image", $"round-{_currentRound}.jpg");

            var resp = await Http.PostAsync($"/api/face/sessions/{_sessionId}/rounds/{_currentRound}/score", content);
            if (!resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                _error = $"Score endpoint returned {(int)resp.StatusCode}: {body}";
                _phase = "Ready";
                return;
            }
            _lastScore = await resp.Content.ReadFromJsonAsync(ApiJsonContext.Default.FaceScoreResponse);
            _phase = "Reveal";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _phase = "Ready";
        }
    }

    private void NextRound()
    {
        _currentRound++;
        if (_currentRound >= 5)
        {
            _phase = "GameOver";
            _finalTotal = _stub ? _localTotal : (_lastScore?.TotalScore ?? 0);
            return;
        }
        _currentEmotion = RoundOrder[_currentRound];
        if (_stub) BuildChoices();
        _phase = "Ready";
    }

    public async ValueTask DisposeAsync()
    {
        _demoTimer?.Dispose();
        _demoTimer = null;
        try { await JS.InvokeVoidAsync("webcamInterop.releaseCamera"); } catch { /* ignore */ }
        try { await JS.InvokeVoidAsync("webcamInterop.setDemoSvgMarkup", (object?)null); } catch { /* ignore */ }
    }

    // After every render in demo mode, push the fresh SVG markup into
    // webcam.js so captureFrame() picks up the current emotion. This is
    // idempotent and cheap (a couple of <200 byte strings per render).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDemo)
        {
            await RegisterDemoSvgAsync();
        }
    }

}
