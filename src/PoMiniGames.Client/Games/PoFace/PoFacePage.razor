@page "/face"
@using PoMiniGamesClient.Components
@inject HttpClient Http
@inject NavigationManager Navigation

<GameShell Title=@TitleContent BackTo="/">
    <div class="gps-game-card">
        <h2 class="gps-phase-h">PoFace · Home</h2>
        <h3 class="gps-game-h">🙂 Match the expression</h3>
        <p>Five rounds of expression matching. With a webcam + Azure OpenAI you make the face on camera; otherwise play the camera-free emoji-match mode — both score out of 50.</p>

        <a class="gps-cta" href="/face/arena">▶ Play (5 rounds)</a>

        @if (_apiOnline == true)
        {
            <p>Camera scoring API: <strong>@(_isMock ? "Stub (no real AI)" : "Azure OpenAI")</strong></p>
            <button class="gps-btn gps-btn--secondary" @onclick="StartSession">Start new session</button>
            @if (_lastSessionId is not null)
            {
                <p>Last session: <code>@_lastSessionId</code> · total: @_lastTotal</p>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="gps-error">@_error</p>
            }
        }
        else
        {
            <p class="pf-note">Camera scoring API isn't reachable — the arena will run in offline emoji-match mode.</p>
        }
    </div>
</GameShell>

@code {
    private RenderFragment TitleContent => @<span>🙂 PoFace</span>;

    private bool? _apiOnline;
    private bool _isMock;
    private string? _lastSessionId;
    private int _lastTotal;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync("/api/face/status", ApiJsonContext.Default.FaceStatusDto);
            _apiOnline = status is not null;
            _isMock = status?.IsMockFaceApi ?? true;
        }
        catch
        {
            _apiOnline = false;
        }
    }

    private async Task StartSession()
    {
        _error = null;
        try
        {
            var resp = await Http.PostAsync("/api/face/sessions", content: null);
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"Start session returned {(int)resp.StatusCode}. Check that you're signed in.";
                return;
            }
            var session = await resp.Content.ReadFromJsonAsync(ApiJsonContext.Default.FaceSessionDto);
            if (session is null) { _error = "Empty session response."; return; }
            _lastSessionId = session.SessionId;
            _lastTotal = 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

}
