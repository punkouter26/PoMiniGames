@page "/funquiz/leaderboard"
@using PoMiniGamesClient.Components
@inject HttpClient Http
@inject NavigationManager Navigation

<GameShell Title=@TitleContent BackTo="/funquiz">
    <div class="fq-leaderboard">
        <div class="fq-leaderboard-tabs" role="tablist" aria-label="Category">
            @foreach (var cat in _categories)
            {
                <button type="button"
                        class="fq-leaderboard-tab @(cat == _category ? "fq-leaderboard-tab--active" : "")"
                        role="tab"
                        aria-selected="@(cat == _category)"
                        @onclick="() => SelectCategoryAsync(cat)">
                    @DisplayName(cat)
                </button>
            }
        </div>
        <h2 class="gps-phase-h">Top Fun Quiz · @DisplayName(_category)</h2>
        @if (_isLoading)
        {
            <p>Loading…</p>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <p class="fq-error">@_error <button class="gps-btn gps-btn gps-btn--secondary" @onclick="ReloadAsync">Retry</button></p>
        }
        else if (_entries.Count == 0)
        {
            <p>No scores yet for @DisplayName(_category). Be the first!</p>
        }
        else
        {
            <table class="fq-leaderboard-table">
                <thead>
                    <tr><th>#</th><th>Player</th><th>Score</th><th>Best streak</th><th>Played</th></tr>
                </thead>
                <tbody>
                    @{ var rank = 1; }
                    @foreach (var e in _entries)
                    {
                        <tr>
                            <td>@(rank++)</td>
                            <td>@e.PlayerName</td>
                            <td>@e.Score</td>
                            <td>@e.MaxStreak</td>
                            <td>@FormatPlayed(e.DatePlayed)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <div class="fq-leaderboard-actions">
            <a class="gps-btn gps-btn gps-btn--primary" href="/funquiz">Play again</a>
            <a class="gps-btn gps-btn gps-btn--secondary" href="/leaderboards">All leaderboards</a>
        </div>
    </div>
</GameShell>

@code {
    private RenderFragment TitleContent => @<span>🧠 Fun Quiz · Leaderboard</span>;

    private static readonly IReadOnlyList<string> _categories = new[]
    {
        "General", "Science", "History", "Geography",
        "Sports", "Entertainment", "Technology", "ArtCulture",
    };

    private string _category = "General";
    private bool _isLoading = true;
    private string? _error;
    private List<FunQuizLeaderboardRow> _entries = new();

    protected override async Task OnInitializedAsync()
    {
        // Honour ?category=… so the multiplayer page can deep-link here after a win.
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var cat = query["category"];
        if (!string.IsNullOrWhiteSpace(cat) && _categories.Contains(cat, StringComparer.OrdinalIgnoreCase))
        {
            _category = char.ToUpperInvariant(cat[0]) + cat[1..];
        }
        await ReloadAsync();
    }

    private async Task SelectCategoryAsync(string cat)
    {
        if (_category == cat) return;
        _category = cat;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var url = $"/api/funquiz/leaderboard?category={Uri.EscapeDataString(_category)}&top=20";
            var rows = await Http.GetFromJsonAsync(url, ApiJsonContext.Default.ListFunQuizLeaderboardRow);
            _entries = rows ?? new();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _entries = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string DisplayName(string category) => category switch
    {
        "ArtCulture" => "Art & Culture",
        _ => category,
    };

    private static string FormatPlayed(DateTime when)
    {
        var local = when.ToLocalTime();
        var delta = DateTime.Now - local;
        if (delta.TotalMinutes < 1) return "just now";
        if (delta.TotalHours < 1) return $"{(int)delta.TotalMinutes} min ago";
        if (delta.TotalDays < 1) return $"{(int)delta.TotalHours} h ago";
        if (delta.TotalDays < 7) return $"{(int)delta.TotalDays} d ago";
        return local.ToString("yyyy-MM-dd");
    }
}