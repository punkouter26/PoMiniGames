@page "/funquiz/multi"
@page "/funquiz/multiplayer"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Games.PoFunQuiz.Services
@inject FunQuizHubService Hub
@inject PlayerNameService PlayerNameService
@inject MatchHistoryService MatchHistory
@inject NavigationManager Navigation
@implements IAsyncDisposable

<GameShell Title=@TitleContent Player="@_playerName" BackTo="/funquiz">
    @if (!_introDone)
    {
        <GameIntro Title="@TitleContent"
                   Objective="Play Fun Quiz head-to-head online. Create or join a game, then answer faster and smarter than your opponent."
                   Controls="@HowToPlayContent"
                   Mode="GameIntro.IntroMode.OnePlayer"
                   OnStart="OnIntroStartAsync" />
    }
    else
    {
    @if (_reconnecting)
    {
        <div class="fq-reconnecting" role="status" aria-live="polite">
            <span class="fq-reconnecting__pulse" aria-hidden="true"></span>
            Reconnecting to lobby…
        </div>
    }
    @if (!_isConnected)
    {
        <p>Connecting…</p>
    }
    else if (_state is null)
    {
        <div class="fq-join">
            <h2 class="gps-phase-h">Two-player · Fun Quiz</h2>
            <label>Your name: <input @bind="_playerName" maxlength="24" disabled="@(_busy || !_isConnected)" /></label>
            <label>Category:
                <select @bind="_category" disabled="@(_busy || !_isConnected)">
                    <option value="General" selected>General</option>
                    <option value="Science">Science</option>
                    <option value="History">History</option>
                    <option value="Geography">Geography</option>
                    <option value="Sports">Sports</option>
                    <option value="Entertainment">Entertainment</option>
                    <option value="Technology">Technology</option>
                    <option value="ArtCulture">Art &amp; Culture</option>
                </select>
            </label>
            <label>Game code (optional):
                <input @bind="_joinCode" maxlength="6" disabled="@_busy" />
            </label>
            <div class="fq-actions">
                @* Bug fix QA #6: aria-busy + disabled state while the SignalR handshake
                   is in flight, so the primary button cannot fire twice on touch. *@
                <button class="gps-btn gps-btn gps-btn--primary"
                        aria-busy="@_busy"
                        disabled="@_busy"
                        @onclick="OnCreate">
                    @(_busy ? "Creating…" : "Create new game")
                </button>
                <button class="gps-btn gps-btn gps-btn--secondary"
                        aria-busy="@_busyJoin"
                        disabled="@(_busyJoin || string.IsNullOrWhiteSpace(_joinCode))"
                        @onclick="OnJoin">
                    @(_busyJoin ? "Joining…" : "Join by code")
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="fq-error">
                    @_error
                    <button class="gps-btn gps-btn gps-btn--secondary gps-btn-retry" @onclick="RetryConnect">Retry</button>
                </p>
            }
        </div>
    }
    else
    {
        <div class="fq-multi">
            <h2 class="gps-phase-h">Game · @_state.GameId</h2>
            <h3>Players</h3>
            <ul>
                @foreach (var p in _state.Players)
                {
                    <li>@p.Name — @p.Score @(p.Name == _state.HostName ? "👑" : "")</li>
                }
            </ul>
            @if (IsWaiting && _playerName == _state.HostName && _state.Players.Count >= 2)
            {
                <button class="gps-btn gps-btn gps-btn--primary" @onclick="OnStart">Start game</button>
            }
            @if (IsInProgress && _currentQuestion is not null)
            {
                <div class="fq-question">
                    <h3>Question @(_state.CurrentQuestionIndex + 1) of @_state.Questions.Count</h3>
                    <p>@_currentQuestion.Text</p>
                    <div class="fq-options">
                        @for (var i = 0; i < _currentQuestion.Options.Count; i++)
                        {
                            var captured = i;
                            <button class="fq-option @(HasAnswered(captured) ? "fq-option--selected" : "")"
                                    disabled="@_hasAnswered"
                                    @onclick="() => Select(captured)">
                                @_currentQuestion.Options[i]
                            </button>
                        }
                    </div>
                    @if (_hasAnswered)
                    {
                        <p>Answered. Waiting for opponent… (@_finishedThisQuestion / @_state.Players.Count)</p>
                    }
                    else
                    {
                        <p class="fq-2p-scores">@_playerName: <strong>@MyScore</strong> · @OpponentName: <strong>@OpponentScore</strong></p>
                    }
                </div>
            }
            @if (_finished is not null)
            {
                <div class="fq-gameover">
                    <h2>🏁 @(_finished.IsTie ? "It's a tie!" : _finished.Winner?.Name + " wins!")</h2>
                    <ul>
                        @foreach (var kv in _finished.FinalScores.OrderByDescending(x => x.Value))
                        {
                            <li>@kv.Key — @kv.Value</li>
                        }
                    </ul>
                    <a class="gps-btn gps-btn gps-btn--primary" href="/funquiz/leaderboard">View leaderboard</a>
                </div>
            }
        </div>
    }
    }
</GameShell>

@code {
    private RenderFragment TitleContent => @<span>🧠 Fun Quiz · Multiplayer</span>;

    // Intro/welcome gate — controls card first; the hub connect waits for OK so
    // the player joins the lobby only after seeing the controls.
    private bool _introDone;
    private RenderFragment HowToPlayContent => @<div>
        <p>Two players answer the same questions online. Correct answers score points; build a streak for a bonus.</p>
        <ul>
            <li>Tap or click the answer you think is right</li>
            <li>Create a game and share the code, or join with a friend's code</li>
            <li>The host starts once both players are in</li>
        </ul>
    </div>;

    private string _playerName = string.Empty;
    private string _category = "General";
    private string? _joinCode;
    private string? _error;
    private bool _isConnected;
    private bool _reconnecting;
    private bool _busy;
    private bool _busyJoin;
    private FunQuizGameStateDto? _state;
    private FunQuizGameFinishedDto? _finished;
    private FunQuizQuestionDto? _currentQuestion;
    private bool _hasAnswered;
    private int _finishedThisQuestion;

    // The hub serialises the GameState enum with a camelCase policy (see Program.cs
    // AddJsonProtocol), so the wire value is "waiting" / "inProgress" — compare
    // case-insensitively rather than against a PascalCase literal.
    private bool IsWaiting => string.Equals(_state?.State, "Waiting", StringComparison.OrdinalIgnoreCase);
    private bool IsInProgress => string.Equals(_state?.State, "InProgress", StringComparison.OrdinalIgnoreCase);

    private int MyScore => _state?.Players.FirstOrDefault(p => p.Name == _playerName)?.Score ?? 0;
    private int OpponentScore => _state?.Players.FirstOrDefault(p => p.Name != _playerName)?.Score ?? 0;
    private string OpponentName => _state?.Players.FirstOrDefault(p => p.Name != _playerName)?.Name ?? "Opponent";

    protected override void OnInitialized()
    {
        // Only wire hub handlers here — the connection waits for the intro's OK
        // (see OnIntroStartAsync).
        _playerName = PlayerNameService.GetPlayerName();
        Hub.OnGameCreated += HandleState;
        Hub.OnGameJoined += HandleState;
        Hub.OnGameUpdated += HandleState;
        Hub.OnGameStarted += HandleState;
        Hub.OnScoreUpdated += HandleScoreUpdate;
        Hub.OnPlayerFinishedQuestion += HandlePlayerFinishedQuestion;
        Hub.OnGameFinished += HandleFinished;
        Hub.OnLobbyError += HandleError;
        Hub.OnReconnecting += HandleReconnecting;
        Hub.OnReconnected += HandleReconnected;
        Hub.OnClosed += HandleClosed;
    }

    private async Task OnIntroStartAsync()
    {
        _introDone = true;
        StateHasChanged();
        try
        {
            await Hub.ConnectAsync();
            _isConnected = true;
        }
        catch (Exception ex)
        {
            _error = $"Could not connect: {ex.Message}";
        }
        StateHasChanged();
    }

    private void HandleReconnecting(Exception? ex)
    {
        // Show a "Reconnecting…" banner so the player knows the lobby is healing.
        // A common cause on a fresh tab is the browser tearing down the WebSocket
        // when the BFF cookie hasn't finished propagating yet — the
        // WithAutomaticReconnect() schedule above retries 0/1/3/5s.
        _isConnected = false;
        _reconnecting = true;
        InvokeAsync(StateHasChanged);
    }

    private void HandleReconnected(string? connectionId)
    {
        _isConnected = true;
        _reconnecting = false;
        InvokeAsync(StateHasChanged);
    }

    private void HandleClosed(Exception? ex)
    {
        _isConnected = false;
        _reconnecting = false;
        // If we were mid-game (Waiting or InProgress), the server has already
        // torn the session down via OnDisconnectedAsync — so the lobby state
        // we're holding is stale and will never receive another broadcast.
        // Reset to the lobby screen so the player can re-create or re-join
        // instead of staring at a phantom "Start game" button that never works.
        if (_state is not null && _finished is null)
        {
            _error = "Lost connection to the lobby. The game was closed.";
            _state = null;
            _currentQuestion = null;
            _hasAnswered = false;
            _finishedThisQuestion = 0;
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task OnCreate()
    {
        if (_busy || _state is not null) return;
        if (string.IsNullOrWhiteSpace(_playerName)) { _error = "Enter a name."; return; }
        PlayerNameService.SetPlayerName(_playerName);
        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            await Hub.CreateGame(_playerName, _category, 10);
        }
        catch (Exception ex)
        {
            _error = $"Could not create game: {ex.Message}";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task OnJoin()
    {
        if (_busyJoin || _state is not null) return;
        if (string.IsNullOrWhiteSpace(_joinCode)) { _error = "Enter a code."; return; }
        PlayerNameService.SetPlayerName(_playerName);
        _busyJoin = true;
        _error = null;
        StateHasChanged();
        try
        {
            await Hub.JoinGame(_joinCode.Trim().ToUpperInvariant(), _playerName);
        }
        catch (Exception ex)
        {
            _error = $"Could not join by code: {ex.Message}";
        }
        finally
        {
            _busyJoin = false;
            StateHasChanged();
        }
    }

    private async Task RetryConnect()
    {
        _error = null;
        try
        {
            await Hub.ConnectAsync();
            _isConnected = true;
        }
        catch (Exception ex)
        {
            _error = $"Retry failed: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task OnStart()
    {
        if (_state is null) return;
        await Hub.StartGame(_state.GameId);
    }

    private void HandleState(FunQuizGameStateDto s)
    {
        // If the question index advanced (or the game restarted), clear the
        // per-question "answered" flag so the player can submit again.
        if (_state is null || s.CurrentQuestionIndex != _state.CurrentQuestionIndex)
        {
            _hasAnswered = false;
            _finishedThisQuestion = 0;
        }
        _state = s;
        _currentQuestion = s.Questions.Count > s.CurrentQuestionIndex ? s.Questions[s.CurrentQuestionIndex] : null;
        // SignalR `.On` callbacks run outside the render loop — repaint explicitly.
        // Without this the opponent's join, the host's Start, and each question
        // advance would not reach the non-initiating player until another event fired.
        InvokeAsync(StateHasChanged);
    }

    private void HandlePlayerFinishedQuestion(FunQuizPlayerFinishedQuestionDto p)
    {
        _finishedThisQuestion = p.FinishedCount;
        InvokeAsync(StateHasChanged);
    }

    private void HandleScoreUpdate(FunQuizScoreUpdateDto u)
    {
        if (_state is null) return;
        var updated = _state.Players.Select(p => p.Name == u.PlayerName
            ? new FunQuizPlayerStateDto(p.Name, u.TotalScore, u.Streak)
            : p).ToList();
        _state = _state with { Players = updated };
        InvokeAsync(StateHasChanged);
    }

    private void HandleFinished(FunQuizGameFinishedDto f)
    {
        _finished = f;
        InvokeAsync(StateHasChanged);
        _ = RecordOutcomesAsync(f);
    }

    // Record a head-to-head result against every other player, scored by final points.
    private async Task RecordOutcomesAsync(FunQuizGameFinishedDto f)
    {
        if (!f.FinalScores.TryGetValue(_playerName, out var myScore)) return;
        foreach (var (name, score) in f.FinalScores)
        {
            if (name == _playerName) continue;
            var outcome = myScore > score ? MatchOutcome.Win
                        : myScore < score ? MatchOutcome.Loss
                        : MatchOutcome.Draw;
            await MatchHistory.RecordAsync("pofunquiz", MatchMode.Multiplayer, name, outcome);
        }
    }

    private void HandleError(FunQuizLobbyErrorDto e)
    {
        _error = e.Message;
        InvokeAsync(StateHasChanged);
    }

    private bool HasAnswered(int _option) => _hasAnswered;

    private async Task Select(int option)
    {
        if (_state is null || _currentQuestion is null || _hasAnswered) return;
        var isCorrect = option == _currentQuestion.CorrectOptionIndex;
        _hasAnswered = true;
        // For the consolidation MVP we treat every answer as 1.0× speed (no timer running yet).
        await Hub.UpdateScore(_state.GameId, isCorrect, speedMultiplier: 1.0, secondsRemaining: 0);
        // Mark the local player as finished for this question — once both
        // players finish, the server advances to the next question (or ends
        // the game on the last one).
        await Hub.PlayerFinished(_state.GameId);
    }

    public async ValueTask DisposeAsync()
    {
        Hub.OnGameCreated -= HandleState;
        Hub.OnGameJoined -= HandleState;
        Hub.OnGameUpdated -= HandleState;
        Hub.OnGameStarted -= HandleState;
        Hub.OnScoreUpdated -= HandleScoreUpdate;
        Hub.OnPlayerFinishedQuestion -= HandlePlayerFinishedQuestion;
        Hub.OnGameFinished -= HandleFinished;
        Hub.OnLobbyError -= HandleError;
        Hub.OnReconnecting -= HandleReconnecting;
        Hub.OnReconnected -= HandleReconnected;
        Hub.OnClosed -= HandleClosed;
        await Hub.DisposeAsync();
    }
}
