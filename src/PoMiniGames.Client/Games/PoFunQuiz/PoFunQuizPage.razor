@page "/funquiz"
@page "/funquiz/{Demo:int}"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Enums
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@inject ApiService Api
@inject PlayerNameService PlayerNameService
@inject MatchHistoryService MatchHistory
@inject GameStatsService GameStats
@inject UiFeedbackService Feedback
@inject NavigationManager Navigation
@inject HttpClient Http
@implements IAsyncDisposable

<GameShell Title=@TitleContent Player="@_playerName" BackTo="/"
           GameOver="@IsGameOver"
           OnPlayAgain="Reset"
           Stats="@_statItems"
           GameSummary="@GameSummaryContent">
    @if (_questions.Count == 0 && !_isLoading)
    {
        <GameLanding Title="@_landingTitle" CtaText="@_landingCta" OnStart="StartGame" Error="@_error">
            <Subtitle>🧠 10 AI-generated trivia questions — @_landingSubtext</Subtitle>
            <ChildContent>
                <div class="fq-setup">
                    <div class="fq-names">
                        <div class="fq-field">
                            <label for="fq-p1">Player 1 name</label>
                            <input id="fq-p1" type="text" @bind="_playerName" maxlength="24" placeholder="Enter your name" />
                        </div>
                        @if (_playMode == "2p" || _playMode == "2ps")
                        {
                            <div class="fq-field">
                                <label for="fq-p2">Player 2 name</label>
                                <input id="fq-p2" type="text" @bind="_player2Name" maxlength="24" placeholder="Player 2" />
                            </div>
                        }
                    </div>
                    <div class="fq-field">
                        <label for="fq-cat">Category</label>
                        <select id="fq-cat" @bind="_category">
                            <option value="General">General</option>
                            <option value="Science">Science</option>
                            <option value="History">History</option>
                            <option value="Geography">Geography</option>
                            <option value="Sports">Sports</option>
                            <option value="Entertainment">Entertainment</option>
                            <option value="Technology">Technology</option>
                            <option value="ArtCulture">Art &amp; Culture</option>
                        </select>
                    </div>
                </div>
            </ChildContent>
        </GameLanding>
    }
    else if (_isLoading)
    {
        <p>Loading questions…</p>
    }
    else if (_currentIndex < _questions.Count && !_splitScreen)
    {
        var q = _questions[_currentIndex];
        <div class="fq-question">
            <h2 class="gps-phase-h">Question @(_currentIndex + 1) of @_questions.Count@(_playMode == "2p" ? $" · {_currentPlayerLabel}'s turn" : "")</h2>
            <p class="fq-text">@q.Text</p>
            <div class="fq-options">
                @for (var i = 0; i < q.Options.Count; i++)
                {
                    var captured = i;
                    <button class="fq-option @(HasAnswered(captured) ? (captured == _selected[_currentIndex].selected ? "fq-option--selected" : "") : "")"
                            disabled="@HasAnswered(captured)"
                            @onclick="() => SelectAnswer(captured)">
                        @q.Options[i]
                    </button>
                }
            </div>
            @if (_playMode == "2p")
            {
                <p class="fq-2p-scores">@_playerName: <strong>@_score1</strong> · @_player2Name: <strong>@_score2</strong></p>
            }
            else
            {
                <p>Score: <strong>@_score</strong> · Streak: @_streak</p>
            }
        </div>
    }
    else if (_currentIndex < _questions.Count && _splitScreen)
    {
        // §Best-practice: split-screen local 2P — one question, two players
        // answer simultaneously on a shared display. Each side has its own
        // 4 option buttons (1/2/3/4 on left, 6/7/8/9 on right) plus a per-player
        // status badge (locked / waiting). Hotkeys register via JS interop
        // on first render and the same @onclick handlers let mouse players
        // join in. The reveal overlay flashes the correct option after both
        // players lock in, then advances on a short timer.
        var q = _questions[_currentIndex];
        <div class="fq-split">
            <div class="fq-split__header">
                <h2 class="gps-phase-h">Question @(_currentIndex + 1) of @_questions.Count</h2>
                <p class="fq-split__prompt">@q.Text</p>
            </div>
            <div class="fq-split__board">
                <div class="fq-split__player fq-split__player--left" data-player="1">
                    <div class="fq-split__name">@_playerName</div>
                    <div class="fq-split__score">@_score1 <span class="fq-split__streak">streak @_streak1</span></div>
                    <div class="fq-split__keys">Keys: <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd><kbd>4</kbd></div>
                    <div class="fq-split__options">
                        @for (var i = 0; i < q.Options.Count; i++)
                        {
                            var captured = i;
                            var picked = _splitPicks[1] == captured;
                            <button class="fq-split__opt @(picked ? "fq-split__opt--picked" : "")"
                                    disabled="@(_splitPicks[1] >= 0)"
                                    @onclick="() => SelectSplitAnswer(1, captured)">
                                <span class="fq-split__key">@(captured + 1)</span>
                                <span class="fq-split__label">@q.Options[i]</span>
                                @if (picked)
                                {
                                    <span class="fq-split__badge">✓</span>
                                }
                            </button>
                        }
                    </div>
                    <div class="fq-split__status">@(_splitPicks[1] >= 0 ? "Locked ✓" : "Pick 1-4")</div>
                </div>
                <div class="fq-split__vs">VS</div>
                <div class="fq-split__player fq-split__player--right" data-player="2">
                    <div class="fq-split__name">@_player2Name</div>
                    <div class="fq-split__score">@_score2 <span class="fq-split__streak">streak @_streak2</span></div>
                    <div class="fq-split__keys">Keys: <kbd>6</kbd><kbd>7</kbd><kbd>8</kbd><kbd>9</kbd></div>
                    <div class="fq-split__options">
                        @for (var i = 0; i < q.Options.Count; i++)
                        {
                            var captured = i;
                            var picked = _splitPicks[2] == captured;
                            <button class="fq-split__opt @(picked ? "fq-split__opt--picked" : "")"
                                    disabled="@(_splitPicks[2] >= 0)"
                                    @onclick="() => SelectSplitAnswer(2, captured)">
                                <span class="fq-split__key">@(captured + 6)</span>
                                <span class="fq-split__label">@q.Options[i]</span>
                                @if (picked)
                                {
                                    <span class="fq-split__badge">✓</span>
                                }
                            </button>
                        }
                    </div>
                    <div class="fq-split__status">@(_splitPicks[2] >= 0 ? "Locked ✓" : "Pick 6-9")</div>
                </div>
            </div>
            @if (_splitPicks[1] >= 0 && _splitPicks[2] >= 0)
            {
                <div class="fq-split__reveal" role="status">
                    <strong>@_playerName</strong>: @(_splitResults[1] ? "✓ correct" : "✗ wrong") ·
                    <strong>@_player2Name</strong>: @(_splitResults[2] ? "✓ correct" : "✗ wrong")
                    — next question in a moment…
                </div>
            }
        </div>
    }
    @* Quiz completion is shown in the shared end-of-game modal (GameSummaryContent). *@
</GameShell>

@code {
    [Parameter] public int? Demo { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }
    // §Best-practice (2026-07-07): split-screen local 2P. Two players share
    // one keyboard + one display. Left side keys 1/2/3/4, right side keys
    // 6/7/8/9 (the 5 is unused — it's where a USB keyboard's gap sits, so
    // leaving it free avoids accidental cross-side hits). Both players see
    // the same question simultaneously and answer independently; after both
    // lock in, the correct answer reveals and the round advances.
    private bool _splitScreen;

    private RenderFragment TitleContent => @<span>🧠 Fun Quiz</span>;

    private RenderFragment GameSummaryContent => _playMode switch
    {
        "2ps" or "2p" => @<div>
            <div class="fq-2p-finale">
                @if (_score1 == _score2)
                {
                    <strong>It's a tie! 🤝</strong>
                }
                else if (_score1 > _score2)
                {
                    <strong>@_playerName wins! 🏆</strong>
                }
                else
                {
                    <strong>@_player2Name wins! 🏆</strong>
                }
            </div>
            <div>@_playerName: <strong>@_score1</strong> (best streak @_maxStreak1)</div>
            <div>@_player2Name: <strong>@_score2</strong> (best streak @_maxStreak2)</div>
            <div class="fq-leaderboard-cta">
                <a class="gps-btn gps-btn gps-btn--secondary" href="/funquiz?mode=2ps">Play split-screen again</a>
            </div>
        </div>,
        _ => @<div>
            <div>Final score: <strong>@_score</strong></div>
            <div>Max streak: @_maxStreak</div>
            <div class="fq-leaderboard-cta">
                <a class="gps-btn gps-btn gps-btn--secondary" href="/funquiz/leaderboard?category=@Uri.EscapeDataString(_category)">View leaderboard</a>
            </div>
        </div>,
    };

    private string _playerName = string.Empty;
    private string _player2Name = "Player 2";
    private string _category = "General";
    private string? _error;
    private bool _isLoading;
    private List<QuizQuestion> _questions = new();
    private int _currentIndex;
    private int _score;
    private int _streak;
    private int _maxStreak;
    private int _score1;
    private int _score2;
    private int _streak1;
    private int _streak2;
    private int _maxStreak1;
    private int _maxStreak2;
    // Player 1 takes even questions, Player 2 takes odd (0-indexed). Solo ignores this.
    private int _currentPlayer => _playMode == "2p" ? (_currentIndex % 2 == 0 ? 1 : 2) : 1;
    private string _currentPlayerLabel => _currentPlayer == 1 ? _playerName : _player2Name;
    private bool _scoreSubmitted;
    // §Best-practice (2026-07-07): split-screen local 2P state. _splitPicks
    // holds the picked option index (-1 = none) for each player. The reveal
    // overlay fires when both >= 0; a short timer advances to the next
    // question. State is per-question (reset in ResetSplitState()).
    private readonly int[] _splitPicks = { -1, -1, -1 };
    private readonly bool[] _splitResults = { false, false, false };
    private string _playMode = "solo";
    private string _landingTitle => _playMode switch
    {
        "2ps" => "Split-screen · Fun Quiz",
        "2p" => "Two-player · Fun Quiz",
        _ => "Solo · Fun Quiz",
    };
    private string _landingSubtext => _playMode switch
    {
        "2ps" => "Both players see the same question and answer simultaneously on one screen. Left uses 1/2/3/4, right uses 6/7/8/9.",
        "2p"  => "Pass the device between rounds. Same 10 questions, alternating turns; highest total wins.",
        _     => "Answer as many right as you can in a row to chase the streak record.",
    };
    private string _landingCta => _playMode switch
    {
        "2ps" => "Start split-screen",
        "2p" => "Start 2-player",
        _ => "Start solo",
    };
    private readonly Dictionary<int, (int selected, bool correct)> _selected = new();
    private List<StatItem>? _statItems;

    private bool IsGameOver => _questions.Count > 0
        && _currentIndex >= _questions.Count
        && _playMode != "demo"; // demo mode replays forever; never surface GameOver modal

    // §Best-practice (2026-07-07): split-screen simultaneous-answer logic.
    // Each player can lock in their pick independently; once both are locked,
    // score them against the correct answer, flash the reveal overlay, and
    // advance on a short delay. Per-question state lives in _splitPicks /
    // _splitResults so reset is a single line at the top of each round.
    private void SelectSplitAnswer(int player, int optionIndex)
    {
        if (_currentIndex >= _questions.Count) return;
        var q = _questions[_currentIndex];
        if (optionIndex < 0 || optionIndex >= q.Options.Count) return;
        if (_splitPicks[player] >= 0) return; // already locked

        _splitPicks[player] = optionIndex;
        var correct = optionIndex == q.CorrectOptionIndex;
        _splitResults[player] = correct;

        if (correct)
        {
            if (player == 1)
            {
                _score1 += q.BasePoints + StreakBonusFor(_streak1);
                _streak1++;
                if (_streak1 > _maxStreak1) _maxStreak1 = _streak1;
            }
            else
            {
                _score2 += q.BasePoints + StreakBonusFor(_streak2);
                _streak2++;
                if (_streak2 > _maxStreak2) _maxStreak2 = _streak2;
            }
        }
        else
        {
            if (player == 1) _streak1 = 0;
            else _streak2 = 0;
        }

        if (_splitPicks[1] >= 0 && _splitPicks[2] >= 0)
        {
            // Both locked in — advance on a short reveal timer. Detached so
            // the UI can render the reveal overlay before the question flips.
            _ = AdvanceAfterRevealAsync();
        }
    }

    private async Task AdvanceAfterRevealAsync()
    {
        try { await Feedback.CompleteAsync(); } catch { /* best-effort */ }
        await Task.Delay(1500);
        ResetSplitState();
        _currentIndex++;
        if (IsGameOver)
        {
            // Local split-screen result recorded for head-to-head feed.
            _ = RecordLocalTwoPlayerAsync();
            _statItems = new()
            {
                new StatItem { Label = "P1 score", Value = _score1.ToString() },
                new StatItem { Label = "P1 streak", Value = _maxStreak1.ToString() },
                new StatItem { Label = "P2 score", Value = _score2.ToString() },
                new StatItem { Label = "P2 streak", Value = _maxStreak2.ToString() },
            };
        }
        StateHasChanged();
    }

    private void ResetSplitState()
    {
        _splitPicks[1] = -1;
        _splitPicks[2] = -1;
        _splitResults[1] = false;
        _splitResults[2] = false;
    }

    protected override void OnInitialized()
    {
        _playMode = string.Equals(ModeQuery, "2ps", StringComparison.OrdinalIgnoreCase) ? "2ps"
                  : string.Equals(ModeQuery, "2p",  StringComparison.OrdinalIgnoreCase) ? "2p"
                  : "solo";
        _splitScreen = _playMode == "2ps";
        _playerName = PlayerNameService.GetPlayerName();
        // Demo mode runs forever — disable GameOver so the modal never surfaces.
        // The route param overrides whatever ?mode= the user supplied.
        if (Demo == 1)
        {
            _playMode = "demo";
            _splitScreen = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _splitScreen)
        {
            // §Best-practice: register a window-level keydown listener via a tiny
            // JS interop. We can't do this purely in Blazor because Razor can't
            // subscribe to global keyboard events without a DOM hook.
            await JS.InvokeVoidAsync("poFunQuizSplitHotkeys.register", DotNetObjectReference.Create(this));
        }
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>
    /// Invoked from JS (poFunQuizSplitHotkeys.js) when a split-screen hotkey
    /// fires. Side 'L' keys 1/2/3/4, side 'R' keys 6/7/8/9, index 0-3 maps to
    /// options A-D. No-op outside split-screen mode.
    /// </summary>
    [JSInvokable]
    public Task OnSplitHotkeyAsync(string side, int optionIndex)
    {
        if (!_splitScreen) return Task.CompletedTask;
        if (_currentIndex >= _questions.Count) return Task.CompletedTask;
        var q = _questions[_currentIndex];
        if (optionIndex < 0 || optionIndex >= q.Options.Count) return Task.CompletedTask;
        SelectSplitAnswer(side == "L" ? 1 : 2, optionIndex);
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_splitScreen)
        {
            try { await JS.InvokeVoidAsync("poFunQuizSplitHotkeys.unregister"); } catch { /* disposed */ }
        }
    }

    private async Task StartGame()
    {
        if (string.IsNullOrWhiteSpace(_playerName))
        {
            _error = "Please enter a name.";
            return;
        }
        if (_playMode == "2p" && string.IsNullOrWhiteSpace(_player2Name))
        {
            _error = "Player 2 needs a name too.";
            return;
        }
        PlayerNameService.SetPlayerName(_playerName);
        _error = null;
        _isLoading = true;
        try
        {
            var url = $"/api/funquiz/quiz/questions?count=10&category={Uri.EscapeDataString(_category)}";
            var questions = await Http.GetFromJsonAsync(url, ApiJsonContext.Default.ListQuizQuestion);
            if (questions is null || questions.Count == 0)
            {
                _error = "No questions available. Try a different category.";
                _isLoading = false;
                return;
            }
            _questions = questions;
            ResetSplitState();
            _currentIndex = 0;
            _score = 0;
            _streak = 0;
            _maxStreak = 0;
            _score1 = _score2 = 0;
            _streak1 = _streak2 = 0;
            _maxStreak1 = _maxStreak2 = 0;
            _selected.Clear();
            _scoreSubmitted = false;
            _statItems = null;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load questions: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectAnswer(int option)
    {
        if (_currentIndex >= _questions.Count) return;
        var q = _questions[_currentIndex];
        if (_selected.ContainsKey(_currentIndex)) return;
        var correct = option == q.CorrectOptionIndex;
        _selected[_currentIndex] = (option, correct);

        if (_playMode == "2p")
        {
            var bonus = StreakBonusFor(_currentPlayer == 1 ? _streak1 : _streak2);
            if (correct)
            {
                if (_currentPlayer == 1)
                {
                    _score1 += q.BasePoints + bonus;
                    _streak1++;
                    if (_streak1 > _maxStreak1) _maxStreak1 = _streak1;
                }
                else
                {
                    _score2 += q.BasePoints + bonus;
                    _streak2++;
                    if (_streak2 > _maxStreak2) _maxStreak2 = _streak2;
                }
            }
            else
            {
                if (_currentPlayer == 1) _streak1 = 0;
                else _streak2 = 0;
            }
        }
        else
        {
            if (correct)
            {
                _score += q.BasePoints + StreakBonus();
                _streak++;
                if (_streak > _maxStreak) _maxStreak = _streak;
            }
            else
            {
                _streak = 0;
            }
        }

        _currentIndex++;
        if (IsGameOver && _playMode == "solo" && !_scoreSubmitted)
        {
            _scoreSubmitted = true;
            _ = SubmitSoloOutcomeAsync();
        }
        else if (IsGameOver && _playMode == "2p")
        {
            // Record a head-to-head match so the recent-activity feed + /profile
            // reflect the 2P result, even though there's no server leaderboard.
            _ = RecordLocalTwoPlayerAsync();
            _statItems = new()
            {
                new StatItem { Label = "P1 score", Value = _score1.ToString() },
                new StatItem { Label = "P1 streak", Value = _maxStreak1.ToString() },
                new StatItem { Label = "P2 score", Value = _score2.ToString() },
                new StatItem { Label = "P2 streak", Value = _maxStreak2.ToString() },
            };
        }
    }

    private int StreakBonus() => _streak switch
    {
        >= 5 => 3,
        >= 3 => 2,
        >= 2 => 1,
        _ => 0
    };

    private int StreakBonusFor(int streak) => streak switch
    {
        >= 5 => 3,
        >= 3 => 2,
        >= 2 => 1,
        _ => 0
    };

    private bool HasAnswered(int option)
    {
        if (_currentIndex >= _questions.Count) return true;
        return _selected.ContainsKey(_currentIndex);
    }

    private void Reset()
    {
        _questions = new();
        _currentIndex = 0;
        _score = 0;
        _streak = 0;
        _maxStreak = 0;
        _score1 = _score2 = 0;
        _streak1 = _streak2 = 0;
        _maxStreak1 = _maxStreak2 = 0;
        _selected.Clear();
        _error = null;
        _scoreSubmitted = false;
        _statItems = null;
        ResetSplitState();
    }

    // Submit the final solo score to the server leaderboard. Best-effort:
    // never throws to the UI; a failed POST just means the run won't show up
    // on the public board. Local GameStats are written unconditionally.
    private async Task SubmitSoloOutcomeAsync()
    {
        var localStats = await GameStats.RecordResult(
            "pofunquiz", _playerName, Difficulty.Medium,
            _maxStreak > 0 ? GameResult.Win : GameResult.Loss);
        _statItems = new()
        {
            new StatItem { Label = "Score", Value = _score.ToString() },
            new StatItem { Label = "Best streak", Value = _maxStreak.ToString() },
            new StatItem { Label = "Total plays", Value = localStats.TotalGames.ToString() },
        };
        try
        {
            var submitted = await Api.SubmitFunQuizScoreAsync(new FunQuizLeaderboardSubmission
            {
                Category = _category,
                Score = _score,
                MaxStreak = _maxStreak,
            });
            if (submitted) await Feedback.CompleteAsync();
            else await Feedback.TapAsync();
        }
        catch
        {
            // Silent best-effort; the local stat row above is the durable record.
        }
        StateHasChanged();
    }

    private async Task RecordLocalTwoPlayerAsync()
    {
        var winner = _score1 == _score2 ? null : (_score1 > _score2 ? _playerName : _player2Name);
        var outcome = winner is null
            ? MatchOutcome.Draw
            : (winner == _playerName ? MatchOutcome.Win : MatchOutcome.Loss);
        try { await MatchHistory.RecordAsync("pofunquiz", MatchMode.Local2P, _player2Name, outcome); }
        catch { /* best-effort */ }
    }
}
