@namespace PoMiniGamesClient.Games.PoJevArena
@using Blazored.LocalStorage
@using PoMiniGames.Shared.Games.PoJevArena
@inject SettingsService Settings
@inject ILocalStorageService Storage
@inject IJSRuntime JS
@implements IDisposable

@* ─────────────────────────────────────────────────────────────────────────
   The Jev Arena rows of the settings sheet (inside its "Arena AI" fieldset).

   Arena brain: Local (free rules on the server, the default) or Jev (paid, uses the daily
   allowance; the server may still say no). On-device AI: serves the Jev brain in this browser
   with a small WebLLM model instead of the paid server path. It is shown only when the browser
   has WebGPU, and nothing is downloaded until a match actually runs with it on.

   Both live in localStorage (pomini_arena_brain, pomini_local_ai) and are read by the arena page
   before each deploy. State is (re)read when the sheet opens, never on mount: the sheet is in
   every page's layout, and localAi.js is not worth importing on pages that never open it.
   ───────────────────────────────────────────────────────────────────────── *@

<div class="aip-row">
    <div class="aip-label">
        <span class="aip-name">Arena brain</span>
        <span class="aip-hint">Who makes Jev Arena's battle calls. Jev uses your daily allowance.</span>
    </div>
    <div class="app-seg" role="radiogroup" aria-label="Arena brain">
        <button type="button" role="radio" class="app-seg__btn" aria-checked="@Aria(!_jev)" @onclick="() => SetBrainAsync(false)">Local (free)</button>
        <button type="button" role="radio" class="app-seg__btn" aria-checked="@Aria(_jev)" @onclick="() => SetBrainAsync(true)">Jev</button>
    </div>
</div>

@if (_webGpu)
{
    <div class="aip-row">
        <div class="aip-label">
            <span class="aip-name">On-device AI</span>
            <span class="aip-hint">Downloads a ~1 GB model once, then plays the Jev brain in this browser for free.</span>
        </div>
        <div class="app-seg" role="radiogroup" aria-label="On-device AI">
            <button type="button" role="radio" class="app-seg__btn" aria-checked="@Aria(!_localAi)" @onclick="() => SetLocalAiAsync(false)">Off</button>
            <button type="button" role="radio" class="app-seg__btn" aria-checked="@Aria(_localAi)" @onclick="() => SetLocalAiAsync(true)">On</button>
        </div>
    </div>
}

@code {
    private bool _jev;
    private bool _localAi;
    private bool _webGpu;

    private static string Aria(bool value) => value ? "true" : "false";

    protected override void OnInitialized() => Settings.OpenRequested += OnOpenRequested;

    public void Dispose() => Settings.OpenRequested -= OnOpenRequested;

    private void OnOpenRequested() => InvokeAsync(RefreshAsync);

    private async Task RefreshAsync()
    {
        try
        {
            _jev = await Storage.GetItemAsStringAsync(PoJevArenaPage.BrainPrefKey) == ArenaBrains.Jev;
            _localAi = await Storage.GetItemAsStringAsync(PoJevArenaPage.LocalAiPrefKey) == "on";
        }
        catch { /* storage blocked: defaults (Local, Off) */ }

        try
        {
            await using var ai = await JS.InvokeAsync<IJSObjectReference>("import", "./js/localAi.js");
            _webGpu = await ai.InvokeAsync<bool>("hasWebGpu");
        }
        catch (JSException) { _webGpu = false; }
        catch (InvalidOperationException) { _webGpu = false; }
        StateHasChanged();
    }

    private async Task SetBrainAsync(bool jev)
    {
        _jev = jev;
        try { await Storage.SetItemAsStringAsync(PoJevArenaPage.BrainPrefKey, jev ? ArenaBrains.Jev : ArenaBrains.Local); }
        catch { /* not remembered; the arena stays on the local brain */ }
    }

    private async Task SetLocalAiAsync(bool on)
    {
        _localAi = on;
        try { await Storage.SetItemAsStringAsync(PoJevArenaPage.LocalAiPrefKey, on ? "on" : "off"); }
        catch { /* not remembered; stays off */ }
    }
}
