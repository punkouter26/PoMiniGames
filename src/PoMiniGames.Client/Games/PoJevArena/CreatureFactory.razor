@using System.Globalization
@using PoMiniGames.Shared.Games.PoJevArena
@inject PoJevArenaApiClient Api

@* Design (or edit) a creature. Validation is PoJevArenaRules — the same code the server runs — so
   the budget meter and error messages are live, and a save only fails for server-side reasons
   (name moderation, the 25-creature cap, storage). The preview animates the creature as built. *@
<section class="jev-factory" aria-label="Creature factory">
    <header class="jev-factory__head">
        <h2 class="jev-kicker">@(Editing is null ? "New creature" : $"Edit {Editing.Name}")</h2>
        <button type="button" class="jev-link" @onclick="OnClose">Close</button>
    </header>

    <div class="jev-factory__body">
        <div class="jev-factory__preview">
            <CreaturePortrait Creature="Preview" Team="blue" Animated="true" Class="jev-factory__art" />
            <p class="jev-muted jev-small">Live preview: idle, move, strike, ability, defence</p>
        </div>

        <div class="jev-factory__form">
            <label class="jev-field">
                <span>Name</span>
                <input class="jev-input" maxlength="@PoJevArenaRules.MaxNameChars" @bind="_name" @bind:event="oninput" />
            </label>

            <Slider Label="HP" Value="_hp" Min="PoJevArenaRules.MinHp" Max="PoJevArenaRules.MaxHp" Step="10" Unit=""
                    ValueChanged="v => _hp = (int)v" />
            <Slider Label="Speed" Value="_speed" Min="PoJevArenaRules.MinSpeed" Max="PoJevArenaRules.MaxSpeed" Step="0.5" Unit=" m/s"
                    ValueChanged="v => _speed = v" />
            <Slider Label="Mass" Value="_mass" Min="PoJevArenaRules.MinMass" Max="PoJevArenaRules.MaxMass" Step="0.5" Unit=""
                    ValueChanged="v => _mass = v" />

            <div class="jev-factory__grid">
                <label class="jev-field">
                    <span>Offense ability</span>
                    <select class="jev-input" @bind="_offense">
                        <option value="">None (melee only)</option>
                        @foreach (var a in PoJevArenaCatalog.Abilities.Where(a => a.Slot == ArenaAbilitySlot.Offense))
                        {
                            <option value="@a.Id">@a.Label · @a.Cost pts</option>
                        }
                    </select>
                </label>
                <label class="jev-field">
                    <span>Defense ability</span>
                    <select class="jev-input" @bind="_defense">
                        <option value="">None</option>
                        @foreach (var a in PoJevArenaCatalog.Abilities.Where(a => a.Slot == ArenaAbilitySlot.Defense))
                        {
                            <option value="@a.Id">@a.Label · @a.Cost pts</option>
                        }
                    </select>
                </label>
                <CatalogPick Label="Temperament" Entries="PoJevArenaCatalog.Temperaments" @bind-Value="_temperament" />
                <CatalogPick Label="Target bias" Entries="PoJevArenaCatalog.TargetBiases" @bind-Value="_bias" />
                <CatalogPick Label="Panic threshold" Entries="PoJevArenaCatalog.PanicThresholds" @bind-Value="_panic" />
            </div>

            <div class="jev-budget @(Cost > PoJevArenaRules.BuildBudget ? "is-over" : null)">
                <div class="jev-budget__row">
                    <span>Build points</span>
                    <strong>@Cost.ToString("0.0", CultureInfo.InvariantCulture) / @PoJevArenaRules.BuildBudget</strong>
                </div>
                <div class="jev-budget__bar" aria-hidden="true"><span style="--pct: @(Math.Min(100, Cost / PoJevArenaRules.BuildBudget * 100).ToString("0", CultureInfo.InvariantCulture))%"></span></div>
            </div>

            @if (Message is not null)
            {
                <p class="@(Validation.IsValid && _serverError is null ? "jev-muted" : "jev-warn") jev-small" role="status">@Message</p>
            }

            <div class="jev-factory__actions">
                <button type="button" class="jev-btn" disabled="@(!Validation.IsValid || _saving)" @onclick="SaveAsync">
                    @(_saving ? "Saving…" : Editing is null ? "Save to library" : "Save changes")
                </button>
                <span class="jev-muted jev-small">Saved creatures are public: anyone can draft them.</span>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public ArenaCreature? Editing { get; set; }
    [Parameter] public EventCallback<ArenaCreature> OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _name = "";
    private int _hp = 200;
    private double _speed = 5.0;
    private double _mass = 2.5;
    private string _offense = "spit_glob";
    private string _defense = "dodge_dash";
    private string _temperament = "skirmisher";
    private string _bias = "hunt_weakest";
    private string _panic = "panics_under_25_hp";
    private string? _serverError;
    private bool _saving;
    private string? _loadedFor;

    protected override void OnParametersSet()
    {
        var key = Editing?.Id ?? "(new)";
        if (key == _loadedFor) return;
        _loadedFor = key;
        _serverError = null;
        if (Editing is null) return;

        _name = Editing.Name;
        _hp = Editing.MaxHp;
        _speed = Editing.MoveSpeed;
        _mass = Editing.Mass;
        _offense = Editing.Abilities.FirstOrDefault(id => PoJevArenaCatalog.FindAbility(id)?.Slot == ArenaAbilitySlot.Offense) ?? "";
        _defense = Editing.Abilities.FirstOrDefault(id => PoJevArenaCatalog.FindAbility(id)?.Slot == ArenaAbilitySlot.Defense) ?? "";
        _temperament = Editing.Temperament;
        _bias = Editing.TargetBias;
        _panic = Editing.PanicThreshold;
    }

    private string[] Abilities => new[] { _offense, _defense }.Where(a => a.Length > 0).ToArray();

    private ArenaCreatureDraft Draft => new(_name, _hp, _speed, _mass, Abilities, _temperament, _bias, _panic);

    private ArenaValidation Validation => PoJevArenaRules.Validate(Draft);

    private double Cost => PoJevArenaRules.BuildCost(_hp, _speed, _mass, Abilities);

    /// <summary>What the preview draws: the draft as it stands, valid or not (a nameless draft still has a body).</summary>
    private ArenaCreature Preview => new(
        Editing?.Id ?? "draft", string.IsNullOrWhiteSpace(_name) ? "New creature" : _name, _hp, _speed, _mass,
        Abilities, _temperament, _bias, _panic, Cost);

    private string? Message => _serverError is not null ? Explain(_serverError)
        : !Validation.IsValid ? (string.IsNullOrWhiteSpace(_name) ? "Give it a name to save it." : Explain(Validation.Error))
        : "Ready to save.";

    private async Task SaveAsync()
    {
        _saving = true;
        _serverError = null;
        var result = Editing is null ? await Api.CreateAsync(Draft) : await Api.UpdateAsync(Editing.Id, Draft);
        _saving = false;
        if (!result.Ok || result.Creature is null)
        {
            _serverError = result.Error ?? "network";
            return;
        }

        _loadedFor = null;
        await OnSaved.InvokeAsync(result.Creature);
    }

    private static string Explain(string? code) => code switch
    {
        "name" => "That name can't be used in the public library. Pick another.",
        "hp" => $"HP must be {PoJevArenaRules.MinHp}–{PoJevArenaRules.MaxHp}.",
        "speed" => $"Speed must be {PoJevArenaRules.MinSpeed}–{PoJevArenaRules.MaxSpeed} m/s in 0.5 steps.",
        "mass" => $"Mass must be {PoJevArenaRules.MinMass}–{PoJevArenaRules.MaxMass} in 0.5 steps.",
        "budget" => $"Over the {PoJevArenaRules.BuildBudget}-point budget: trade some bulk, pace, weight or an ability.",
        "ability" or "ability-slot" => "One offense and one defense ability at most.",
        "library-limit" => $"You can keep {PoJevArenaRules.MaxCreaturesPerOwner} creatures. Delete one to save another.",
        "library-offline" or "network" => "The library is unreachable right now. Try again in a moment.",
        "not-your-creature" => "Only its creator can edit this creature.",
        _ => "That creature breaks a library rule.",
    };
}
