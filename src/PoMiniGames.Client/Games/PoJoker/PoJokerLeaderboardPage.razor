@page "/pojoker/leaderboard"
@using System.Net.Http
@using System.Net.Http.Json
@using PoMiniGamesClient.Components
@using LeaderboardEntryDto = PoShared.Games.PoJoker.LeaderboardEntryDto
@inject HttpClient Http
@inject UiFeedbackService Feedback

<PageTitle>PoJoker — Hall of Champions</PageTitle>

<GameShell Title="@TitleContent"
           BackTo="/pojoker"
           ShowSettings="false"
           ShowPlayAgain="false">
    <div class="pojoker-root">
        <header class="leaderboard-header">
            <h1>🏆 Hall of Champions</h1>
            <p class="subtitle">The greatest Jesters in the realm</p>
        </header>

        <div class="leaderboard-controls">
            <button type="button" class="pojoker-btn pojoker-btn--primary" @onclick="LoadLeaderboardAsync">
                ↻ Refresh
            </button>
        </div>

        <div class="leaderboard-container">
            @if (_isLoading)
            {
                <div class="loading-state"><p>Consulting the royal records...</p></div>
            }
            else if (_entries.Count == 0)
            {
                <div class="empty-state">
                    <p>🎭 No champions yet!</p>
                    <p class="subtitle">Be the first to claim glory on the stage.</p>
                    <a href="/pojoker" class="pojoker-link">Begin Performance</a>
                </div>
            }
            else
            {
                @*
                    §1: replaced RadzenDataGrid with native <Virtualize>. The previous
                    implementation shipped the entire Radzen JS bundle (~1.2 MB) just
                    to render one paged grid. The native virtualizer only materialises
                    visible rows; with ItemSize=52 the DOM stays at ~12 nodes regardless
                    of dataset size, scroll is buttery, and the Radzen JS dependency
                    stays out of the critical path.
                *@
                <div class="pojoker-vtable-wrap">
                    <table class="pojoker-vtable">
                        <thead>
                            <tr>
                                <th class="pojoker-col-rank">Rank</th>
                                <th>Session</th>
                                <th class="pojoker-col-num">Triumphs</th>
                                <th class="pojoker-col-num">Success %</th>
                                <th class="pojoker-col-num">Score</th>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="_entries" Context="entry" ItemSize="52">
                                <tr class="pojoker-vrow @(entry.Rank <= 3 ? $"pojoker-vrow--top pojoker-vrow--rank{entry.Rank}" : null)">
                                    <td class="pojoker-col-rank">
                                        @if (entry.Rank == 1) { <span class="pojoker-medal pojoker-medal--gold">🥇</span> }
                                        else if (entry.Rank == 2) { <span class="pojoker-medal pojoker-medal--silver">🥈</span> }
                                        else if (entry.Rank == 3) { <span class="pojoker-medal pojoker-medal--bronze">🥉</span> }
                                        else { <span class="pojoker-rank-num">#@entry.Rank</span> }
                                    </td>
                                    <td class="pojoker-col-session" title="@entry.SessionId">@TruncateSession(entry.SessionId)</td>
                                    <td class="pojoker-col-num">@entry.Triumphs</td>
                                    <td class="pojoker-col-num">@entry.TriumphRate.ToString("P1")</td>
                                    <td class="pojoker-col-num">@entry.Score.ToString("F1")</td>
                                </tr>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</GameShell>

@code {
    private List<LeaderboardEntryDto> _entries = [];
    private bool _isLoading = true;

    private readonly RenderFragment TitleContent = builder => builder.AddContent(0, "🏆 PoJoker Leaderboard");

    protected override async Task OnInitializedAsync() => await LoadLeaderboardAsync();

    private async Task LoadLeaderboardAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            _entries = await Http.GetFromJsonAsync("/api/joker/leaderboard?sortBy=Triumph&top=25", ApiJsonContext.Default.ListJokerLeaderboardEntryDto) ?? [];
            await Feedback.ClickAsync();
        }
        catch
        {
            _entries = [];
            await Feedback.ErrorAsync();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static string TruncateSession(string? sessionId)
    {
        if (string.IsNullOrEmpty(sessionId)) return "—";
        return sessionId.Length <= 12 ? sessionId : string.Concat(sessionId.AsSpan(0, 8), "…");
    }
}