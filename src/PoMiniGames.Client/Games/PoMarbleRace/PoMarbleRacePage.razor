@page "/pomarblerace"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Enums
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@implements IAsyncDisposable
@inject PlayerNameService PlayerNameService
@inject ApiService ApiService
@inject GameResultService GameResults
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<GameShell Title=@TitleContent
           Player="@_playerName"
           BackTo="/"
           Stats="@_statItems"
           GameOver="@(_phase == "result" && !_demo)"
           GameKey="pomarblerace"
           GameSummary="@GameSummaryContent"
           HowToPlay="@HowToPlayContent">
    @if (!_introDone)
    {
        <GameIntro Title="@TitleContent"
                   Objective="You control the one RED marble in a pack of 101. Finish in the top 10 to score."
                   Controls="@HowToPlayContent"
                   Mode="@_introMode"
                   OnStart="OnIntroStartAsync" />
    }
    @* 2026-07-12: stack the HUD BELOW the canvas inside a column flex
       container, so the sticky top bar (z-sticky > z-modal) never clips the
       HUD and the HUD never sits on top of the marble track. *@
    <div class="mr-wrap-row">
        <div class="mr-wrap">
            <div id="marble-race-container" class="mr-canvas-host"></div>

            @* Start overlay — a short countdown, not an intro page: the race is already up and
               the clock is running. There's nothing to choose now — you always control the one
               red marble in a pack of 100 blue — so this just tells you which one is yours and
               how to steer before the gun. *@
            @* 2026-07-19 browser audit #2: gate the overlay on
               `_introDone && _phase == "pick"` so it never flashes
               "Starting in 0…" while the intro card is up. The countdown
               is also gated on `_pickCountdown > 0` so the very first
               paint can't render a stale 0 either. *@
            @if (_introDone && _phase == "pick" && !_demo && _pickCountdown > 0)
            {
                <div class="mr-overlay">
                    <div class="mr-pick-card">
                        <h2 class="mr-pick-title">You're the <span class="mr-pick-red">RED</span> marble</h2>
                        <p class="mr-pick-sub">
                            100 blue marbles. One red — yours. Steer with
                            <kbd>←</kbd> <kbd>→</kbd> and finish in the top @ScoreTop to score.
                        </p>
                        <p class="mr-pick-sub">
                            Starting in <strong class="mr-pick-count">@_pickCountdown</strong>…
                        </p>
                    </div>
                </div>
            }

            @* Top-3 podium overlay — appears the moment the 3rd marble crosses the
               line, showing the winner + next two and their gap behind the winner. *@
            @if (_podium.Count > 0)
            {
                <div class="mr-podium" role="status" aria-live="polite">
                    <div class="mr-podium-title">🏁 Podium</div>
                    @foreach (var row in _podium)
                    {
                        <div class="mr-podium-row mr-podium-row--@row.Place">
                            <span class="mr-podium-medal">@Medal(row.Place)</span>
                            <span class="mr-podium-dot" style="background:@row.Color"></span>
                            <span class="mr-podium-name">@row.Name</span>
                            <span class="mr-podium-time">@row.Time.ToString("0.00")s</span>
                            <span class="mr-podium-gap">@(row.Place == 1 ? "WINNER" : $"+{row.Gap.ToString("0.00")}s")</span>
                        </div>
                    }
                </div>
            }

            @* Live race telemetry, pinned to the canvas: clock, your position, and your gap
               to the leader. None of this existed before — the race clock was computed in JS
               and never shown, and the gap only appeared on the podium after the race was
               already decided. *@
            @if (_phase == "racing" && !_demo)
            {
                <div class="mr-telemetry" role="status" aria-live="off">
                    @* The "YOU · <name>" identification row that sat here is gone with the rest of
                       the marker chrome. Your marble is the only red one and the camera is locked
                       to it, so the panel is now purely telemetry: clock, place, gap, edge. *@
                    <div class="mr-tel-clock">@_clock.ToString("0.00")</div>
                    <div class="mr-tel-row">
                        <span class="mr-tel-pos">P@(_myPlace > 0 ? _myPlace.ToString() : "–")<span class="mr-tel-field">/@(_myField > 0 ? _myField.ToString() : "101")</span></span>
                        <span class="mr-tel-gap">@GapText()</span>
                    </div>
                    @* #3 edge gauge: where your marble sits across the channel. The marker slides
                       from left rail to right rail; it flashes red near an edge so you know to
                       steer back before you fall off. *@
                    <div class="mr-tel-edge @(EdgeDanger ? "mr-tel-edge--danger" : "")" aria-label="Track position">
                        <div class="mr-tel-edge-track">
                            <span class="mr-tel-edge-center"></span>
                            <span class="mr-tel-edge-marker" style="--c:@ColorOf(_chosen); left:@EdgePct"></span>
                        </div>
                        <span class="mr-tel-edge-cap">@(EdgeDanger ? "⚠ EDGE" : "TRACK")</span>
                    </div>
                    @if (_streak > 0)
                    {
                        <div class="mr-tel-streak @(_streak >= 3 ? "mr-tel-streak--hot" : "")">🔥 @_streak · @MultiplierText()</div>
                    }
                </div>

                @* #10 FINAL STRETCH klaxon: once the leader hits the Gauntlet run to the line,
                   the stakes are set — shout it so the ending has weight. *@
                @if (_progress >= 0.86)
                {
                    <div class="mr-final" role="status" aria-live="polite">🏁 FINAL STRETCH</div>
                }

                @* #10 hot-streak fire: at a 2× multiplier or better the screen edges catch fire,
                   so a run that's worth real points looks like it. *@
                @if (_streak >= 3)
                {
                    <div class="mr-fire" aria-hidden="true"></div>
                }

                @* The ON AIR badge that used to sit here is gone, along with the in-world YOU /
                   ON AIR pins (marbles.js). The camera is locked to your marble for the whole
                   race, so a badge announcing which marble it was on only ever said "you". *@

                @* Touch/mouse path for steering — the keyboard is the primary input but a
                   verb that only exists on a physical keyboard isn't a verb on a phone. Press
                   and hold to steer; release (or drag off the pad) to stop. *@
                <div class="mr-nudge-pads">
                    <button class="mr-nudge-pad"
                            @onpointerdown="() => Steer(-1, true)"
                            @onpointerup="() => Steer(-1, false)"
                            @onpointerleave="() => Steer(-1, false)"
                            @oncontextmenu:preventDefault="true"
                            aria-label="Steer left">◀</button>
                    <button class="mr-nudge-pad"
                            @onpointerdown="() => Steer(1, true)"
                            @onpointerup="() => Steer(1, false)"
                            @onpointerleave="() => Steer(1, false)"
                            @oncontextmenu:preventDefault="true"
                            aria-label="Steer right">▶</button>
                </div>
            }
        </div>

        @* 2026-07-19: the below-canvas scoreboard/leaderboard HUD was removed per
           user request so the race graphics fill that space (see .mr-wrap height).
           The live essentials survive as canvas overlays (telemetry clock/place/
           gap/edge + ON AIR pin), and RUN/BEST remain in the GameShell stats
           panel — so nothing load-bearing was lost. *@
    </div>
</GameShell>

@code {
    [SupplyParameterFromQuery(Name = "demo")]
    public int Demo { get; set; }

    private const int MarbleCount = 101;   // mirrors MARBLE_COUNT in marbles.js (1 red + 100 blue)
    private const int PlayerIndex = 0;     // the red marble the player controls
    private const int ScoreTop = 10;       // mirrors SCORE_TOP in game.js — finish top 10 to score

    private string _playerName = "";
    private bool _demo;
    private string _phase = "pick";
    private int _score;
    private int _best;
    private int _streak;
    private int _chosen = -1;
    private double _progress;
    private double _myProgress;
    private double _clock;
    private int _myPlace = -1;
    private int _myField = MarbleCount;
    private double _myGap;
    // Signed lateral offset along the track's LOCAL right vector, which renders toward
    // screen-LEFT under the chase camera. So: −1 = screen-RIGHT rail, 0 = centre,
    // +1 = screen-LEFT rail. EdgePct flips it back into screen space for the gauge.
    private double _myLateral;
    private int _camIndex = -1;
    private bool _lastWon;
    private int _lastPlace;
    private int _lastGained;
    private int _submittedBest;

    private List<LbRow> _leaderboard = new();
    private List<PodiumRow> _podium = new();
    private List<StatItem> _statItems = new();
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    private DotNetObjectReference<PoMarbleRacePage>? _ref;
    private bool _engineStarted;

    // Colour + name are a pure function of the marble index (index 0 is the red player, every
    // other index is a blue AI marble), so neither is sent over interop on the per-tick path.
    // Mirrors marbles.js — the index is the contract.
    private const string RedColor = "#ef4444";
    private const string BlueColor = "#3b82f6";

    private static string ColorOf(int index) => index == PlayerIndex ? RedColor : BlueColor;

    private static string RosterName(int index) =>
        index == PlayerIndex ? "You" : $"Marble {index + 1}";

    // Intro/welcome gate: the marble engine (and its race clock) only boots once
    // the intro card is dismissed (OK in 1P, 2s flash in demo). See OnIntroStartAsync.
    private bool _introDone;
    private GameIntro.IntroMode _introMode => _demo
        ? GameIntro.IntroMode.Demo
        : GameIntro.IntroMode.OnePlayer;

    private RenderFragment TitleContent => @<span>🔮 Marble Race</span>;

    private RenderFragment HowToPlayContent => @<div>
        <p>You control the one RED marble in a pack of 101. Finish in the top 10 to score.</p>
        <ul>
            <li><kbd>←</kbd>/<kbd>→</kbd> hold to steer your marble</li>
            <li><kbd>R</kbd> new track · <kbd>M</kbd> mute</li>
            <li>String finishes together for a points multiplier — mind the edges</li>
        </ul>
    </div>;

    private RenderFragment GameSummaryContent => @<div>
        <div>@(_lastWon ? $"🏆 {Ordinal(_lastPlace)} place — +{_lastGained} points" : "💀 Run over")</div>
        <div>
            @(_lastPlace > 0
                ? $"{RosterName(_chosen)} placed {Ordinal(_lastPlace)}"
                : $"{RosterName(_chosen)} didn't finish")
        </div>
        <div>@(_lastWon ? $"Run: {_score} · Streak: {_streak}" : $"Best run: {_best}")</div>
    </div>;

    protected override void OnInitialized()
    {
        _demo = Demo == 1;
        _playerName = PlayerNameService.GetPlayerName();
        _stats = _gameStats.GetStats("pomarblerace", _playerName);
        UpdateStats();
    }

    // The engine no longer boots on first render — the intro card gates it so the
    // race clock never runs behind the welcome. OnIntroStartAsync starts it.
    // 2026-07-19 browser audit #1: the engine now stays paused between
    // start() and the explicit resume() call so OnPhase('pick') and the
    // auto-pick countdown never fire while the intro modal is on screen.
    private async Task OnIntroStartAsync()
    {
        _introDone = true;
        // 2026-07-19 browser audit #2: seed the pick countdown BEFORE we
        // await JS so the overlay never flashes "Starting in 0…" during
        // the round-trip. The JS side will still re-emit OnPhase when
        // resume() flushes the queue, which re-arms the countdown.
        _phase = "pick";
        _pickCountdown = PickSeconds;
        await InvokeAsync(StateHasChanged);

        if (_engineStarted)
        {
            // The engine was already up (e.g. demo re-cycle) — just kick it.
            try { await JSRuntime.InvokeVoidAsync("PoMarbleRace.resume"); }
            catch (Exception ex) { Console.Error.WriteLine($"[PoMarbleRace] resume failed: {ex.Message}"); }
            return;
        }
        _engineStarted = true;
        _ref = DotNetObjectReference.Create(this);
        try
        {
            await JSRuntime.InvokeVoidAsync("PoMarbleRace.start", "marble-race-container", _ref, _demo);
            await JSRuntime.InvokeVoidAsync("PoMarbleRace.resume");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[PoMarbleRace] JS init failed: {ex.Message}");
        }
    }

    // ── Display helpers ──
    private static string Pct(double v) => $"{(int)(Math.Clamp(v, 0, 1) * 100)}%";

    // #3 edge gauge: map lateral (−1..+1) to a 0..100% marker position, and flag the danger
    // band where the marble is close enough to a rail to risk falling off.
    //
    // INVERTED on purpose. myLateral is measured along the track's LOCAL right vector
    // (track.js lateralOf → frameAt.rb), but the chase camera sits behind the marble looking
    // down +Z, and that local right vector renders toward screen-LEFT. So a positive lateral
    // means the marble is drifting to the left of YOUR screen, and the marker has to travel
    // left. The old (l + 1) / 2 sent it right, which put the gauge and the arrow keys in
    // direct contradiction. Same root cause as the steering sign in game.js _applySteer.
    private string EdgePct => $"{(int)(Math.Clamp((1 - _myLateral) / 2, 0, 1) * 100)}%";
    private bool EdgeDanger => Math.Abs(_myLateral) > 0.82;

    // JS caps the gap estimate at GAP_MAX (60s); at the cap the number is meaningless, so
    // show the cap as a cap rather than pretending to a tenth of a second.
    private const double GapMax = 60;

    private static string FormatGap(double gap) => gap >= GapMax ? "+60s+" : $"+{gap:0.0}s";

    private string GapText() => _myPlace == 1 ? "LEAD" : FormatGap(_myGap);

    // Mirrors the streak multiplier in game.js (_resolve): 1 + min(streak-1, 4) * 0.5.
    private string MultiplierText()
    {
        var mult = 1 + Math.Min(Math.Max(_streak - 1, 0), 4) * 0.5;
        return $"{mult:0.#}×";
    }

    // ── Start countdown ──
    // There's nothing to choose anymore — the player always controls the red marble — so this
    // is just a "get ready" beat that frames the start gate, then the race begins with the red
    // marble (PlayerIndex) assigned. JS ignores a second pick once the phase leaves "pick".
    private const int PickSeconds = 3;
    private int _pickCountdown;

    // Cancellation, not a System.Timers.Timer: that fired its Elapsed handler on a threadpool
    // thread, so the countdown mutated component state off the renderer's context and raced
    // Stop/Dispose. The loop below only ever runs on the component's own context.
    private CancellationTokenSource? _pickCts;

    private void StartPickCountdown()
    {
        StopPickCountdown();
        _pickCountdown = PickSeconds;
        var cts = new CancellationTokenSource();
        _pickCts = cts;
        _ = RunPickCountdownAsync(cts.Token);
    }

    private async Task RunPickCountdownAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (_pickCountdown > 0 && await timer.WaitForNextTickAsync(ct))
            {
                _pickCountdown--;
                await Beep(final: _pickCountdown == 0);
                await InvokeAsync(StateHasChanged);
            }

            // Countdown done — start the race controlling the red marble.
            if (!ct.IsCancellationRequested) await Pick(PlayerIndex);
        }
        catch (OperationCanceledException)
        {
            // The player picked, the phase moved on, or they left the page.
        }
    }

    private async Task Beep(bool final)
    {
        try { await JSRuntime.InvokeVoidAsync("PoMarbleRace.beep", final); } catch { }
    }

    private void StopPickCountdown()
    {
        var cts = _pickCts;
        _pickCts = null;
        if (cts is null) return;
        cts.Cancel();
        cts.Dispose();
    }

    private async Task Pick(int index)
    {
        // Covers the player clicking before the countdown expires. JS ignores a second pick once
        // the phase leaves "pick", so a click landing on the same tick as the timeout is harmless.
        StopPickCountdown();
        try { await JSRuntime.InvokeVoidAsync("PoMarbleRace.pick", index); } catch { }
    }

    // Hold-to-steer for the on-screen pads. dir is -1 (left) / +1 (right); active is the
    // pointer-down/up state. The engine applies the lateral force every physics step while a
    // direction is held, mirroring the keyboard's keydown/keyup path.
    private async Task Steer(int dir, bool active)
    {
        try { await JSRuntime.InvokeVoidAsync("PoMarbleRace.setSteer", dir, active); } catch { }
    }

    [JSInvokable]
    public async Task OnPhase(string phase, int chosen, int score, int best, int streak)
    {
        _phase = phase;
        _chosen = chosen;
        _score = score;
        _best = best;
        _streak = streak;
        if (phase == "pick")
        {
            _progress = 0;
            _myProgress = 0;
            _clock = 0;
            _myPlace = -1;
            _myGap = 0;
            _leaderboard.Clear();
            _podium.Clear();   // hide the previous race's podium as the next race sets up

            // Give the player PickSeconds on the grid to claim a marble, then pick for them.
            // Demo mode does its own auto-pick on the JS side (after a short beat
            // framing the start gate), so it never runs this countdown.
            if (!_demo) StartPickCountdown();
        }
        else
        {
            StopPickCountdown();
        }
        await InvokeAsync(StateHasChanged);
    }

    // ── Interop payloads ──
    // These take parallel primitive arrays rather than a JSON string. The string form cost three
    // serialization passes per call (JS JSON.stringify → Blazor serializing that string → a
    // JsonDocument.Parse here) on a path that fires ~10x/second for a whole race. Colours and
    // names aren't transferred at all: they're a pure function of the marble index (0 = the red
    // player, everything else blue).

    /// <param name="indices">Marble indices, in finishing order.</param>
    [JSInvokable]
    public async Task OnPodium(int[] indices, double[] times, double[] gaps)
    {
        var rows = new List<PodiumRow>(indices.Length);
        for (var i = 0; i < indices.Length; i++)
        {
            rows.Add(new PodiumRow
            {
                Place = i + 1,
                Color = ColorOf(indices[i]),
                Name = RosterName(indices[i]),
                Time = At(times, i),
                Gap = At(gaps, i),
            });
        }
        _podium = rows;
        await InvokeAsync(StateHasChanged);
    }

    private static string Medal(int place) => place switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => $"{place}." };

    /// <param name="order">Marble indices in current standings order (place 1 first).</param>
    /// <param name="times">Finish time per entry; only meaningful where <paramref name="finished"/> is true.</param>
    /// <param name="gaps">Seconds behind the leader per entry (estimated from distance while still running).</param>
    /// <param name="progress">Leader progress 0..1.</param>
    /// <param name="myProgress">The player's own progress 0..1.</param>
    /// <param name="order">Top-N marble indices in standings order (the whole 101-marble field
    /// isn't sent — see LB_SHOWN in game.js). The player's own standing arrives separately as
    /// <paramref name="myPlace"/>/<paramref name="myField"/>/<paramref name="myGap"/> so it's
    /// shown even when the player is far down the pack.</param>
    [JSInvokable]
    public async Task OnRaceTick(int[] order, double[] speeds, bool[] finished, double[] times,
                                 double[] gaps, double progress, double myProgress, double clock,
                                 double myLateral, int myPlace, int myField, double myGap,
                                 int streak, int camIndex, string camReason)
    {
        _progress = progress;
        _myProgress = myProgress;
        _clock = clock;
        _myLateral = myLateral;
        _myPlace = myPlace;
        _myField = myField > 0 ? myField : MarbleCount;
        _myGap = myGap;
        _streak = streak;
        // camReason is still sent by game.js (positional interop contract) but nothing renders
        // it now that the ON AIR badge is gone.
        _camIndex = camIndex;

        var rows = new List<LbRow>(order.Length);
        for (var i = 0; i < order.Length; i++)
        {
            var isFinished = i < finished.Length && finished[i];
            var isPlayer = order[i] == _chosen;
            rows.Add(new LbRow
            {
                Place = i + 1,
                Color = ColorOf(order[i]),
                Name = RosterName(order[i]),
                Speed = At(speeds, i),
                Gap = At(gaps, i),
                IsPlayer = isPlayer,
                IsOnCamera = order[i] == camIndex,
                Finished = isFinished,
                Time = isFinished ? At(times, i) : null,
            });
        }
        _leaderboard = rows;
        await InvokeAsync(StateHasChanged);
    }

    private static double At(double[] values, int i) => i < values.Length ? values[i] : 0;

    [JSInvokable]
    public async Task OnRaceResult(bool won, int place, int score, int gained, int streak, int best)
    {
        _lastWon = won;
        _lastPlace = place;
        _lastGained = gained;
        _score = score;
        _streak = streak;
        _best = best;
        _phase = "result";

        if (!_demo)
        {
            _gameStats.SaveLastPlayedGame("pomarblerace");

            // A new personal best is submitted to the global board (debounced by _submittedBest).
            // The submission carries only the score — who the player is, and when they played, are
            // resolved server-side from the auth cookie. `best` is the JS-side high-water mark of
            // a run, which now genuinely resets on a miss, so it means something on the board.
            MarbleRaceHighScoreRequest? request = null;
            if (best > _submittedBest && best > 0)
            {
                _submittedBest = best;
                request = new MarbleRaceHighScoreRequest(best);
            }

            // One intake records local stats and submits the high score together — no desync.
            _stats = await GameResults.RecordAndSubmitMarbleRaceAsync(
                _playerName, won ? GameResult.Win : GameResult.Loss, request);
            UpdateStats();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, Difficulty.Medium);
        // Marble race has no draws and shows Run + Best as leading stats.
        _statItems = GameStatsPanel.Build(bucket, includeDraws: false, includeElo: true,
            ("Run", _score.ToString()),
            ("Best", _best.ToString()));
    }

    private static string Ordinal(int n) => n switch
    {
        1 => "1st", 2 => "2nd", 3 => "3rd",
        _ => $"{n}th"
    };

    public async ValueTask DisposeAsync()
    {
        // Before the JS ref goes away — a pending tick would otherwise try to
        // Pick() through a disposed interop ref if the player leaves mid-countdown.
        StopPickCountdown();
        try { await JSRuntime.InvokeVoidAsync("PoMarbleRace.stop"); } catch { }
        _ref?.Dispose();
    }

    private sealed class LbRow
    {
        public int Place { get; set; }
        public string Color { get; set; } = "#fff";
        public string Name { get; set; } = "";
        public double Speed { get; set; }
        public double Gap { get; set; }
        public bool IsPlayer { get; set; }
        public bool IsOnCamera { get; set; }
        public bool Finished { get; set; }
        public double? Time { get; set; }
    }

    private sealed class PodiumRow
    {
        public int Place { get; set; }
        public string Color { get; set; } = "#fff";
        public string Name { get; set; } = "";
        public double Time { get; set; }
        public double Gap { get; set; }
    }
}
