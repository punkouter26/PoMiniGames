@namespace PoMiniGamesClient.Games.PoMule
@using PoMiniGames.Shared.Games.PoMule

@* The land auction block: what is for sale, the standing bid, and the player's raise. *@
<RadzenCard Variant="Variant.Filled" class="pm-auction">
    <div class="pm-auction-title">Land auction</div>
    @if (State.AuctionPlot >= 0)
    {
        var plot = State.Map.Plots[State.AuctionPlot];
        <div class="pm-auction-line">
            @plot.Terrain@(plot.Terrain == Terrain.Mountain ? $" ({plot.Peaks} peak{(plot.Peaks == 1 ? "" : "s")})" : "")
            at column @(State.AuctionPlot % PoMuleMap.Columns + 1), row @(State.AuctionPlot / PoMuleMap.Columns + 1)
        </div>
        <div class="pm-auction-bid">
            @if (State.HighBidder >= 0)
            {
                <span class="pm-dot" style="background: @PoMuleUi.SeatColors[State.HighBidder]"></span>
                <span>@State.Players[State.HighBidder].Name bids @State.HighBid.ToString("N0") cr</span>
            }
            else
            {
                <span>No bids yet. Opening bid @PoMuleTuning.AuctionOpeningBid cr</span>
            }
        </div>
        @if (CanBid)
        {
            <RadzenButton Text="@($"Bid {NextBid:N0} cr")" ButtonStyle="ButtonStyle.Warning" Click="@(_ => OnBid.InvokeAsync())"
                          Disabled="@(State.HighBidder == 0 || State.Players[0].Cash < NextBid)" />
            <div class="pm-auction-hint">@(State.HighBidder == 0 ? "You hold the high bid." : "Space also bids.")</div>
        }
    }
</RadzenCard>

@code {
    [Parameter, EditorRequired] public MatchState State { get; set; } = null!;

    /// <summary>False in a demo, where nobody at the screen is bidding.</summary>
    [Parameter] public bool CanBid { get; set; }

    [Parameter] public EventCallback OnBid { get; set; }

    private int NextBid => PoMuleLand.NextBid(State);
}
