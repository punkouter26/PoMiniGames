@namespace PoMiniGamesClient.Games.PoMule
@using PoMiniGames.Shared.Games.PoMule

@* The right-hand panel: the clock, the player's own colony (or the Colony Store in a demo)
   and everyone else. On a phone in landscape the panel is hidden and PoMulePage's pills
   stand in for it. *@
<div class="pm-hud">
    <div class="pm-hud-clock">
        <div class="pm-hud-seconds">@(_seconds > 0 ? (State.ClockTicks + 9) / 10 : 0)</div>
        <div class="pm-hud-phase">
            <div class="pm-hud-phase-name">Month @State.Month of @PoMuleTuning.Months · @PoMuleUi.PhaseName(State.Phase)</div>
            <RadzenProgressBar Value="@(_seconds > 0 ? State.ClockTicks / 10.0 : 0)" Max="@Math.Max(1, _seconds)" ShowValue="false"
                               ProgressBarStyle="ProgressBarStyle.Warning" Style="height: 8px" />
        </div>
    </div>

    @if (Human is { } me)
    {
        <RadzenCard Variant="Variant.Filled" class="pm-hud-card">
            <div class="pm-hud-card-title">Your colony · @PoMuleSpecies.Get(me.Species).Name</div>
            <div class="pm-hud-cash">@me.Cash.ToString("N0") cr</div>
            <div class="pm-hud-goods">
                @for (var g = 0; g < 4; g++)
                {
                    var good = g;
                    <div class="pm-hud-good">
                        <div class="pm-hud-good-n">@me.Goods[good]</div>
                        <div class="pm-hud-good-l">@PoMuleUi.GoodNames[good]@(good == 0 ? $", need {PoMuleTuning.FoodNeed(State.Month + (State.Phase > Phase.Development ? 1 : 0))}" : "")</div>
                    </div>
                }
            </div>
            <div class="pm-hud-line">
                In tow: @(me.HasMule ? (me.Outfit >= 0 ? $"{PoMuleUi.GoodNames[me.Outfit]} M.U.L.E." : "bare M.U.L.E. (needs outfitting)") : "nothing")@(me.HoldsAssay ? " · assay kit" : "")
            </div>
            <div class="pm-hud-line">Plots: @State.Owner.Count(o => o == me.Seat) · M.U.L.E.s working: @Enumerable.Range(0, State.Owner.Length).Count(i => State.Owner[i] == me.Seat && State.Installed[i] >= 0)</div>
            @if (me.SpeedPercent == 0 && State.Phase == Phase.Development)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="No Food: sitting this month out" />
            }
            else if (me.InPub && State.Phase == Phase.Development)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="In the pub until the clock stops" />
            }
        </RadzenCard>
    }

    <RadzenCard Variant="Variant.Filled" class="pm-hud-card">
        <div class="pm-hud-card-title">Colony store</div>
        <div class="pm-hud-line">@State.Store.Mules M.U.L.E.s at @State.Store.MulePrice cr</div>
        <div class="pm-hud-goods">
            @for (var g = 0; g < 4; g++)
            {
                var good = g;
                <div class="pm-hud-good">
                    <div class="pm-hud-good-n">@State.Store.Stock[good]</div>
                    <div class="pm-hud-good-l">@PoMuleUi.GoodNames[good] @State.Store.Price[good] cr</div>
                </div>
            }
        </div>
    </RadzenCard>

    <div class="pm-hud-rivals">
        <RadzenDataGrid Data="@Rows" TItem="PoMuleRow" Density="Density.Compact" AllowSorting="false" AllowPaging="false" EmptyText="">
            <Columns>
                <RadzenDataGridColumn TItem="PoMuleRow" Title="#" Width="34px">
                    <Template Context="r">@r.Rank</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PoMuleRow" Title="Colonist">
                    <Template Context="r">
                        <span class="pm-dot" style="background: @r.Color"></span>
                        <span title="@r.SpeciesName">@r.Name</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PoMuleRow" Title="Cash" Width="68px" TextAlign="TextAlign.Right">
                    <Template Context="r">@r.Cash.ToString("N0")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PoMuleRow" Title="F/E/S/C" Width="92px" TextAlign="TextAlign.Right">
                    <Template Context="r">@string.Join("/", r.Goods)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PoMuleRow" Title="Plots" Width="52px" TextAlign="TextAlign.Right">
                    <Template Context="r">@r.Plots</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PoMuleRow" Title="Worth" Width="72px" TextAlign="TextAlign.Right">
                    <Template Context="r">@r.NetWorth.ToString("N0")</Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MatchState State { get; set; } = null!;

    /// <summary>The rows to list: everyone, ranked by Net Worth.</summary>
    [Parameter, EditorRequired] public List<PoMuleRow> Rows { get; set; } = [];

    private int _seconds;

    /// <summary>Seat 0 when a person is playing it; null in a demo.</summary>
    private PlayerState? Human => State.Players[0].Archetype == Archetype.Human ? State.Players[0] : null;

    protected override void OnParametersSet() => _seconds = PoMuleUi.PhaseSeconds(State.Phase);
}
