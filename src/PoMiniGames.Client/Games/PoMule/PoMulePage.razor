@page "/pomule"
@page "/pomule/{Mode}"
@namespace PoMiniGamesClient.Games.PoMule
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Models
@using PoMiniGames.Shared.Games.PoMule

<PageTitle>Mule · PoMiniGames</PageTitle>

<GameShell Title=@TitleContent
           Player="@_playerName"
           BackTo="/"
           Fullscreen="true"
           GameOver="@(_finished && !_demo)"
           GameOverDelayMs="6000"
           Outcome="@_outcome"
           GameKey="@(_demo ? null : "pomule")"
           Stats="@_endStats"
           GameSummary="@EndSummary"
           Announcement="@_announcement">

    <div class="pm-root">
        @if (_stage == Stage.Intro && _radzenReady)
        {
            <GameIntro CueScope="pomule"
                       Title=@LogoContent
                       Objective="Twelve months on planet Irata. Claim land, put M.U.L.E.s to work, trade on the floor. Richest colonist wins, if the colony survives."
                       Controls=@ControlsContent
                       Options="@(_demo ? null : SpeciesPicker)"
                       Mode="@(_demo ? GameIntro.IntroMode.Demo : GameIntro.IntroMode.OnePlayer)"
                       StartLabel="@(_saved is null ? "Start" : "New match")"
                       ForceShow="true"
                       OnStart="StartNewAsync" />
        }
        else if (_stage == Stage.Failed)
        {
            <div class="pm-failed" role="alert">
                <p>The game could not load.</p>
                <RadzenButton Text="Retry" Click="@(_ => RetryAsync())" />
            </div>
        }

        @* The whole game is drawn on this canvas: the planet, the store, the auction floor,
           the title line, the message line and the eight colonists' status columns. *@
        <div id="pomule-canvas" class="pm-canvas-host" role="img"
             aria-label="Planet Irata: plots, towns and colonists, with each colonist's money and goods below"></div>

        @if (_match is { } match && _stage == Stage.Playing && _radzenReady)
        {
            var state = match.State;

            @if (_demo)
            {
                <div class="pm-bar pm-bar--speed">
                    <span class="pm-hint">Speed</span>
                    <RadzenSelectBar TValue="int" Value="@_demoSpeed" Change="@(v => SetDemoSpeedAsync(v))" Size="ButtonSize.Small">
                        <Items>
                            @foreach (var speed in DemoSpeeds)
                            {
                                <RadzenSelectBarItem Text="@(speed + "×")" Value="speed" />
                            }
                        </Items>
                    </RadzenSelectBar>
                </div>
            }
            else if (state.Phase == Phase.Market && state.MarketGood >= 0)
            {
                @* Which side of the auction to stand on. Everything else is done by walking. *@
                <div class="pm-bar">
                    <RadzenButton Text="Sell" Size="ButtonSize.Small" ButtonStyle="@RoleStyle(PoMuleMarket.Seller)" Click="@(_ => SetRole(PoMuleMarket.Seller))" />
                    <RadzenButton Text="Sit out" Size="ButtonSize.Small" ButtonStyle="@RoleStyle(0)" Click="@(_ => SetRole(0))" />
                    <RadzenButton Text="Buy" Size="ButtonSize.Small" ButtonStyle="@RoleStyle(PoMuleMarket.Buyer)" Click="@(_ => SetRole(PoMuleMarket.Buyer))" />
                </div>
            }

            @if (state.Phase is Phase.Standings or Phase.Finished)
            {
                <PoMuleStandings State="state" Rows="_rows" Final="@(state.Phase == Phase.Finished)" CanContinue="@(!_demo)" OnContinue="SkipStandings" />
            }

            <div class="pm-rotate" role="status">Turn your phone sideways to play.</div>
        }
    </div>
</GameShell>

@code {
    private static RenderFragment TitleContent => GameCatalog.TitleFor(GameKeys.PoMule);

    // The start card's heading, after the Atari title screen: the striped logo with three
    // colonists marching under it.
    private RenderFragment LogoContent => @<span class="pm-title">
        <span class="pm-logo" aria-label="M.U.L.E.">M.U.L.E.</span>
        <span class="pm-parade" aria-hidden="true">
            <span class="pm-walker pm-walker--a"></span>
            <span class="pm-walker pm-walker--b"></span>
            <span class="pm-walker pm-walker--c"></span>
        </span>
    </span>;

    private RenderFragment ControlsContent => @<div>
        <p class="keys-only"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or arrows move · <kbd>Space</kbd> is the button (claim, install) · <kbd>Shift</kbd> dashes.</p>
        <p class="touch-only">Stick moves · <strong>Act</strong> is the button (claim, install) · <strong>Dash</strong> sprints.</p>
        <p>Each month: press the button when the highlighter is on the plot you want. Walk into a town, get a M.U.L.E. at the corral, walk it into an outfitting stall, then out to your plot and press the button. Sell what you can spare at the auction, and walk up the floor to bid when land is for sale. Go hungry and your month is cut short. A dash-speed bump makes a towed M.U.L.E. bolt.</p>
    </div>;

    private RenderFragment SpeciesPicker => @<div class="pm-species">
        @if (_saved is { } saved)
        {
            <div class="pm-continue">
                <RadzenButton Text="@($"Continue your match (month {saved.Month})")" ButtonStyle="ButtonStyle.Warning" Click="@(_ => ContinueAsync())" />
            </div>
        }
        <label class="pm-classic">
            <input type="checkbox" @bind="_classic" />
            Classic 1983 rules: no species traits
        </label>
        <div class="pm-species-label">Choose your species</div>
        <RadzenDataList Data="@PoMuleSpecies.All" TItem="SpeciesInfo" AllowPaging="false">
            <Template Context="s">
                <button type="button" class="pm-species-card @(s.Id == _species ? "pm-species-card--on" : "")"
                        aria-pressed="@(s.Id == _species ? "true" : "false")" @onclick="@(() => _species = s.Id)">
                    <span class="pm-species-name">@PoMuleSpecies.Name(s.Id, _classic)</span>
                    <span class="pm-species-cash">@PoMuleSpecies.StartingCash(s.Id, _classic).ToString("N0") cr</span>
                    <span class="pm-species-trait">@(_classic ? "No trait" : s.Trait)</span>
                </button>
            </Template>
        </RadzenDataList>
        <div class="pm-press">Press Start to go on</div>
    </div>;

    private RenderFragment EndSummary => @<p>@_endLine</p>;
}
