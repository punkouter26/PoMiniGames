@page "/poracer/lobby"
@using Microsoft.AspNetCore.SignalR.Client
@using PoShared.Games
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject ApiService Api
@inject ToastService ToastService
@implements IAsyncDisposable

<PageTitle>PoRacer — Lobby</PageTitle>

<div class="sp-page">
    <div class="sp-card">
        <div class="sp-header">
            <button class="sp-back" @onclick='() => Nav.NavigateTo("/")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:0.2rem">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Back
            </button>
            <h1 class="sp-title">PoRacer Lobby</h1>
        </div>

        <p class="sp-subtitle">
            Status:
            @if (_hub is null)
            {
                <span class="po-pill po-pill--muted">disconnected</span>
            }
            else if (_hub.State == HubConnectionState.Connected)
            {
                <span class="po-pill po-pill--ok">connected</span>
            }
            else
            {
                <span class="po-pill po-pill--warn">@_hub.State.ToString().ToLowerInvariant()</span>
            }
        </p>

        <section style="margin-bottom:1rem">
            <h2>Players (@(_state?.Players.Count ?? 0)/8)</h2>
            @if (_state is null)
            {
                <p style="opacity:0.5">Loading...</p>
            }
            else if (_state.Players.Count == 0)
            {
                <p>No one's here yet. Be the first.</p>
            }
            else
            {
                <ol class="poracer-lobby-list">
                    @foreach (var p in _state.Players)
                    {
                        var isYou = p.ConnectionId == _hub?.ConnectionId;
                        <li class="@(isYou ? "is-you" : "") @(p.ConnectionId == _state.HostConnectionId ? "is-host" : "")">
                            <span>@p.DisplayName @(isYou ? "(you)" : "")</span>
                            @if (p.ConnectionId == _state.HostConnectionId)
                            {
                                <span class="po-pill po-pill--accent">host</span>
                            }
                            @if (p.IsGuest)
                            {
                                <span class="po-pill po-pill--muted">guest</span>
                            }
                            @if (p.IsReady)
                            {
                                <span class="po-pill po-pill--ok">ready</span>
                            }
                        </li>
                    }
                </ol>
            }
        </section>

        <section>
            @if (IsHost)
            {
                <button class="sp-btn-primary" @onclick="StartGameAsync" disabled="@(_state is null || _state.Players.Count == 0)">Start Race</button>
            }
            else
            {
                <button class="sp-btn-secondary" @onclick="ToggleReadyAsync">
                    @(_isReady ? "Not Ready" : "Ready!")
                </button>
            }
        </section>

        <p style="color:var(--muted);font-size:12px;margin-top:8px">Last update: @_lastUpdate</p>
    </div>
</div>

<style>
    .poracer-lobby-list {
        list-style: none; padding: 0; margin: 0; display: grid; gap: 8px;
    }
    .poracer-lobby-list li {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        padding: 8px 12px; border: 1px solid rgba(120,200,255,0.18); border-radius: 8px;
        background: rgba(20,30,48,0.5);
    }
    .poracer-lobby-list li.is-you { border-color: rgba(80,180,255,0.6); }
    .poracer-lobby-list li.is-host { box-shadow: 0 0 0 1px rgba(255,184,78,0.35) inset; }
    .po-pill {
        font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase;
        padding: 2px 8px; border-radius: 999px;
        border: 1px solid rgba(120,200,255,0.35); color: var(--muted);
    }
    .po-pill--ok { color: #6bff9c; border-color: rgba(107,255,156,0.45); }
    .po-pill--warn { color: #ffb84e; border-color: rgba(255,184,78,0.45); }
    .po-pill--accent { color: var(--accent); border-color: rgba(78,195,255,0.45); }
    .po-pill--muted { color: var(--muted); }
</style>

@code {
    private HubConnection? _hub;
    private PoRacerLobbyState? _state;
    private string _lastUpdate = "—";
    private bool _isReady;
    private IDisposable? _lobbySub;
    private IDisposable? _gameStartedSub;

    private bool IsHost =>
        _state is not null
        && _hub?.ConnectionId is { } id
        && _state.HostConnectionId == id;

    protected override async Task OnInitializedAsync()
    {
        var isAvailable = await Api.IsAvailableAsync();
        if (!isAvailable)
        {
            ToastService.Show("Server unavailable. Try Single Player mode.", ToastType.Error);
            return;
        }

        var hubUrl = Nav.BaseUri.TrimEnd('/') + "/poracer/lobby-hub";
        _hub = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        _lobbySub = _hub.On<PoRacerLobbyState>("lobbyState", state =>
        {
            _state = state;
            _lastUpdate = state.LastUpdatedUtc.LocalDateTime.ToString("HH:mm:ss");
            InvokeAsync(StateHasChanged);
        });

        _gameStartedSub = _hub.On("gameStarted", () =>
        {
            Nav.NavigateTo("/poracer");
        });

        await _hub.StartAsync();

        var displayName = AuthState.User?.DisplayName ?? "Player";
        var isGuest = !AuthState.IsAuthenticated;
        await _hub.InvokeAsync("Join", displayName, isGuest);
    }

    private async Task ToggleReadyAsync()
    {
        if (_hub is null) return;
        await _hub.InvokeAsync("ToggleReady");
        _isReady = !_isReady;
    }

    private async Task StartGameAsync()
    {
        if (_hub is null) return;
        await _hub.InvokeAsync("StartGame");
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            _lobbySub?.Dispose();
            _gameStartedSub?.Dispose();
            try { await _hub.DisposeAsync(); } catch { }
        }
    }
}
