@using System.Diagnostics
@using PoMiniGamesClient.Games.PoRacer
@using PoMiniGamesClient.Services
@using PoShared.Games
@*
    PoRacer — Top-down arcade racing game (single-file Blazor WebAssembly).
    ---------------------------------------------------------------------
    Inspired by Atari "Indy 500" and NES "R.C. Pro-Am".
    Integrated into PoMiniGames from the standalone PoRacerMiniMaxM3 project.

    Controls: WASD or Arrow keys. Space = handbrake (sharp drift).
*@

@page "/poracer"
@page "/poracer/demo"
@layout PoMiniGamesClient.Layout.EmptyLayout
@inject IJSRuntime JS
@inject PoRacerScoreApiClient Scores
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject GameStatsService GameStats
@inject KioskCoordinator Kiosk
@implements IAsyncDisposable

<PageTitle>PoRacer — Arcade Racing</PageTitle>

<div class="racer-root @(_crtOn ? "crt-enabled" : "") po-page-transition" tabindex="0">
    <div style="width: 100%; height: 100%; position: absolute; inset: 0; pointer-events: none;">
        <canvas id="racerCanvas" class="racer-canvas" style="pointer-events: auto;"></canvas>
    </div>

    <!-- Settings Drawer Toggle Button -->
    <button class="settings-drawer-toggle" @onclick="ToggleSettings" title="Game Settings">⚙️ Settings</button>

    <!-- Settings Drawer -->
    <div class="settings-drawer @(_settingsOpen ? "open" : "")">
        <div class="settings-drawer-header">
            <h3>Game Settings</h3>
            <button class="settings-drawer-close" @onclick="ToggleSettings">×</button>
        </div>
        <div class="settings-group">
            <div class="settings-label">Display Effects</div>
            <button class="po-btn po-btn--secondary settings-control" @onclick="ToggleCrt">
                CRT Screen Shader: @(_crtOn ? "ON" : "OFF")
            </button>
            <button class="po-btn po-btn--secondary settings-control" @onclick="ToggleBloom">
                Bloom Lighting: @(_bloomOn ? "ON" : "OFF")
            </button>
        </div>
        <div class="settings-group">
            <div class="settings-label">Weather Selection</div>
            <select class="po-select" @bind="_weatherConfig">
                <option value="Auto">Auto (Cycle)</option>
                <option value="Clear">Clear</option>
                <option value="Rain">Rainy / Storm</option>
                <option value="Snow">Snowy</option>
            </select>
        </div>
        <div style="margin-top: auto; font-size: 11px; color: var(--muted); text-align: center;">
            PoRacer v1.0.0 · Onion Architecture
        </div>
    </div>

    @if (_crtOn)
    {
        <div class="crt-overlay">
            <div class="crt-roll-bar"></div>
            <div class="crt-flicker-overlay"></div>
            <div class="crt-bezel"></div>
        </div>
    }

    @* #10 — minimap canvas is rendered OUTSIDE the @if blocks so Blazor
       doesn't recreate it on every phase change. JS draws to it via
       PoRacerRender.maybeDrawMinimap(); we just toggle visibility. *@
    <div class="racer-minimap" style="display:@(Phase == GamePhase.Racing ? "block" : "none")">
        <canvas id="minimapCanvas" width="180" height="180"></canvas>
    </div>

    @* -------- Touch controls (coarse-pointer devices only; see CSS) --------
       data-po-input wires straight into the JS input state via event
       delegation in racingInterop.js — no per-render interop needed. *@
    <div class="racer-touch @(Phase == GamePhase.Racing ? "is-active" : "")" aria-hidden="true">
        <div class="touch-cluster">
            <button type="button" class="touch-btn" data-po-input="left">◀</button>
            <button type="button" class="touch-btn" data-po-input="right">▶</button>
        </div>
        <div class="touch-cluster">
            <button type="button" class="touch-btn touch-btn--pill" data-po-input="space">DRIFT</button>
            <button type="button" class="touch-btn" data-po-input="down">▼</button>
            <button type="button" class="touch-btn touch-btn--accel" data-po-input="up">▲</button>
        </div>
    </div>

    @* -------- Start screen -------- *@
    @if (Phase == GamePhase.Start)
    {
        <div class="racer-overlay racer-start">
            <div class="racer-card">
                <div class="racer-title">PoRacer</div>
                <div class="racer-subtitle">Top-Down Arcade Racing</div>
                <div class="racer-controls">
                    <div><kbd>W</kbd> / <kbd>↑</kbd> Accelerate</div>
                    <div><kbd>S</kbd> / <kbd>↓</kbd> Brake / Reverse</div>
                    <div><kbd>A</kbd> <kbd>D</kbd> / <kbd>←</kbd> <kbd>→</kbd> Steer</div>
                    <div><kbd>Space</kbd> Handbrake (drift)</div>
                    <div><kbd>R</kbd> Restart after the race</div>
                </div>
                <div style="display: flex; gap: 12px; justify-content: center; align-items: center; margin: 0 auto 10px;">
                    <button class="racer-btn" @onclick="StartRace">Start Race</button>
                    <button class="racer-btn-secondary" style="padding: 14px 20px; font-size: 15px;" @onclick="ToggleSettings" title="Game Settings">⚙️ Settings</button>
                </div>
                <div class="racer-hint">8 cars · 3 laps · first across the line wins</div>
            </div>
        </div>
    }

    @* -------- In-game HUD -------- *@
    @if (Phase == GamePhase.Racing)
    {
        <!-- Drift progress bar and perfect drift indicator -->
        @if (_driftProgress > 0)
        {
            <div class="hud-drift-container" aria-live="polite">
                <div class="hud-drift-glow"></div>
                <div class="hud-drift-label">DRIFTING</div>
                <div class="hud-drift-bar">
                    <div class="hud-drift-fill" style="width: @((int)_driftProgress)%"></div>
                </div>
            </div>
        }
        @if (_perfectDriftTimer > 0)
        {
            <div class="hud-perfect-toast">
                <span>⚡ PERFECT DRIFT! ⚡</span>
            </div>
        }

        <div class="racer-hud" aria-live="polite" aria-atomic="false">
            <div class="hud-panel hud-left">
                <div class="hud-label">Position</div>
                <div class="hud-value big">@Ordinal(Player.Position) <span class="hud-of">/ @Cars.Count</span></div>

                <div class="hud-label">Lap</div>
                <div class="hud-value">@Player.Lap <span class="hud-of">/ @TotalLaps</span></div>

                <div class="hud-label">Speed</div>
                <div class="hud-value">@((int)Player.SpeedKph) <span class="hud-of">km/h</span></div>
                <div class="hud-speed-bar">
                    <div class="hud-speed-fill" style="width:@(Math.Min(100, Player.SpeedKph / 3.4))%"></div>
                </div>

                <div class="hud-label">Time</div>
                <div class="hud-value">@FormatTime(_elapsedRaceTime)</div>

                <div class="hud-label">FPS</div>
                <div class="hud-value hud-fps" style="color:@FpsColor">@_fpsDisplay</div>
            </div>

            <div class="hud-panel hud-right">
                <div class="hud-label">Standings</div>
                @if (_isDemo)
                {
                    <div class="hud-row" style="color:var(--accent-warm);font-weight:700">🤖 DEMO MODE</div>
                }
                @foreach (var c in Standings.Take(8))
                {
                    <div class="hud-row @(c.IsPlayer ? "is-player" : "")">
                        <span class="hud-dot" style="background:@c.Color"></span>
                        <span class="hud-pos">@Ordinal(c.Position)</span>
                        <span class="hud-name">@c.Name</span>
                        <span class="hud-laps">L@(c.Lap)</span>
                    </div>
                }
            </div>

            <div class="hud-panel hud-right" style="top: 140px;">
                <div class="hud-label">Splits</div>
                @for (int s = 0; s < _sectorTimes.Count; s++)
                {
                    var delta = GetSectorDelta(s);
                    <div class="hud-row" @key="@($"split-{s}")">
                        <span class="hud-pos">S@(s + 1)</span>
                        <span class="hud-name">@FormatTime(_sectorTimes[s])</span>
                        <span class="hud-laps" style="color:@(delta > 0 ? "#ff6b6b" : delta < 0 ? "#6bff6b" : "#9bb1cc")">
                            @(delta > 0 ? "+" : delta < 0 ? "-" : "")@FormatTime(Math.Abs(delta))
                        </span>
                    </div>
                    <div class="sector-sparkline" @key="@($"spark-{s}")">
                        <div class="sparkline-bar" style="height:@(GetSparklineHeight(s))%; background:@(delta > 0 ? "#ff6b6b" : delta < 0 ? "#6bff6b" : "#9bb1cc")"></div>
                    </div>
                }
            </div>
        </div>
        @* #10 — minimap is rendered at the top of the page; JS controls it. *@
    }

    @* -------- Feature 9: Time-of-day indicator -------- *@
    @if (Phase == GamePhase.Racing)
    {
        <div class="hud-tod">
            @if (_timeOfDay > 0.6) { <span>☀️ Day</span> }
            else if (_timeOfDay > 0.4) { <span>🌤️ Dawn/Dusk</span> }
            else { <span>🌙 Night</span> }
        </div>
    }

    @* -------- Feature 9: Lap flash -------- *@
    @if (Phase == GamePhase.Racing && _lapFlashTimer > 0)
    {
        <div class="hud-lap-flash">
            @(Player.Lap > TotalLaps ? "🏁 FINISH!" : $"LAP {Player.Lap}")
        </div>
    }

    @* -------- Leaderboard -------- *@
    @if (Phase == GamePhase.Finished)
    {
        <div class="racer-overlay racer-end">
            <div class="racer-card">
                <div class="racer-title small">Race Complete</div>
                <div class="racer-subtitle">
                    @if (_isDemo)
                    {
                        <span>🤖 CPU Race — @Cars.FirstOrDefault(c => c.Position == 1)?.Name wins!</span>
                    }
                    else if (Player.Position == 1)
                    {
                        <span>🏆 You won!</span>
                    }
                    else
                    {
                        <span>You finished @Ordinal(Player.Position)</span>
                    }
                </div>

                @if (!_isDemo)
                {
                <!-- Achievements Grid -->
                <div class="achievements-grid">
                    @if (_wallHitsCount == 0)
                    {
                        <div class="achievement-badge" title="No wall hits recorded during the race">
                            <span class="achievement-icon">🛡️</span>
                            <span class="achievement-title">Clean Racer</span>
                        </div>
                    }
                    @if (_maxPlayerSpeed >= 200.0)
                    {
                        <div class="achievement-badge" title="Exceeded 200 km/h speed threshold">
                            <span class="achievement-icon">⚡</span>
                            <span class="achievement-title">Speed Demon</span>
                        </div>
                    }
                    @if (_didPerfectDrift)
                    {
                        <div class="achievement-badge" title="Completed at least one perfect drift">
                            <span class="achievement-icon">🌀</span>
                            <span class="achievement-title">Drift King</span>
                        </div>
                    }
                    @if (FinishedCloseCall())
                    {
                        <div class="achievement-badge" title="Finished within 0.75 seconds of another car">
                            <span class="achievement-icon">🏁</span>
                            <span class="achievement-title">Close Call</span>
                        </div>
                    }
                </div>
                }
                <div class="leaderboard" aria-live="polite">
                    @foreach (var c in Standings)
                    {
                        <div class="lb-row @(c.IsPlayer ? "is-player" : "")">
                            <span class="lb-pos">@Ordinal(c.Position)</span>
                            <span class="hud-dot" style="background:@c.Color"></span>
                            <span class="lb-name">@c.Name</span>
                            <span class="lb-time">@(c.FinishTime > 9e8 || c.FinishTime < 0 ? "DNF" : FormatTime(c.FinishTime))</span>
                        </div>
                    }
                </div>
                @if (!_isDemo)
                {
                <div class="lb-status" role="status">
                    @if (_submitState == SubmitState.Submitting)
                    {
                        <span class="lb-status-text">Submitting score...</span>
                    }
                    else if (_submitState == SubmitState.Failed)
                    {
                        <span class="lb-status-text error">@_submitError</span>
                        <button class="racer-btn-secondary" @onclick="SubmitPlayerScoreAsync">Retry</button>
                    }
                    else if (_submitState == SubmitState.Saved)
                    {
                        <span class="lb-status-text ok">✓ Score saved</span>
                    }
                </div>
                }
                <div class="lb-actions">
                    <button class="racer-btn" @onclick="StartRace">@(_isDemo ? "Restart Demo" : "Race Again")</button>
                    @if (!_isDemo)
                    {
                        <button class="racer-btn-secondary" @onclick="GoToLeaderboard">View leaderboard</button>
                    }
                </div>
                @if (_isDemo && _demoRestartAt > 0)
                {
                    <div class="racer-hint" style="margin-top:10px">Auto-restarting in @(Math.Max(0, (int)(_demoRestartAt - Now())))s...</div>
                }
            </div>
        </div>
    }
</div>

<style>
    /* ===========================================================
       PoRacer component-level styles (HUD, overlays, buttons)
       =========================================================== */
    .racer-root {
        position: fixed;
        inset: 0;
        background: #05070d;
        outline: none;
    }
    
    /* CRT Mode styles */
    .racer-root.crt-enabled {
        overflow: hidden;
        border-radius: 32px;
        box-shadow: 0 0 0 10px #151821, 0 20px 50px rgba(0,0,0,0.8);
        transition: border-radius 0.3s ease, box-shadow 0.3s ease;
    }

    .crt-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 9999;
    }

    /* Vignette, phosphor grid scanlines, and RGB shadow mask */
    .crt-overlay::before {
        content: " ";
        display: block;
        position: absolute;
        inset: 0;
        background: 
            radial-gradient(circle at center, rgba(18, 16, 16, 0) 0%, rgba(0, 0, 0, 0.2) 60%, rgba(0, 0, 0, 0.7) 100%),
            repeating-linear-gradient(rgba(18, 16, 16, 0) 0px, rgba(18, 16, 16, 0) 1px, rgba(0, 0, 0, 0.35) 2px, rgba(0, 0, 0, 0.35) 3px),
            repeating-linear-gradient(90deg, rgba(255, 0, 0, 0.04) 0px, rgba(255, 0, 0, 0.04) 1px, rgba(0, 255, 0, 0.02) 2px, rgba(0, 255, 0, 0.02) 3px, rgba(0, 0, 255, 0.04) 4px, rgba(0, 0, 255, 0.04) 5px);
        background-size: 100% 100%, 100% 4px, 6px 100%;
        opacity: 0.85;
    }

    /* Screen glare reflection */
    .crt-overlay::after {
        content: " ";
        display: block;
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 50% 15%, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 60%);
    }

    /* CRT roll bar */
    @@keyframes crt-roll {
        0% { transform: translateY(-100%); }
        100% { transform: translateY(100%); }
    }
    .crt-roll-bar {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 100px;
        background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0.03) 10%, rgba(255,255,255,0.05) 50%, rgba(255,255,255,0.03) 90%, rgba(255,255,255,0));
        animation: crt-roll 15s linear infinite;
        pointer-events: none;
    }

    /* Screen flicker */
    @@keyframes crt-flicker {
        0% { opacity: 0.98; }
        50% { opacity: 0.995; }
        100% { opacity: 0.98; }
    }
    .crt-flicker-overlay {
        position: absolute;
        inset: 0;
        background: rgba(18, 16, 16, 0.015);
        animation: crt-flicker 0.12s infinite;
        pointer-events: none;
    }

    /* Rounded corner bezel shadow */
    .crt-bezel {
        position: absolute;
        inset: 0;
        box-shadow: inset 0 0 60px rgba(0,0,0,0.95), inset 0 0 10px rgba(0,0,0,0.9);
        z-index: 10000;
        pointer-events: none;
        border-radius: 32px;
        border: 2px solid rgba(255,255,255,0.03);
    }
    .racer-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
    }

    .racer-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(ellipse at center, rgba(10,20,40,0.7), rgba(2,4,10,0.95));
        backdrop-filter: blur(6px);
        z-index: 10;
    }
    .racer-card {
        background: linear-gradient(180deg, rgba(20,28,48,0.95), rgba(10,16,28,0.95));
        border: 1px solid rgba(120,200,255,0.25);
        border-radius: 18px;
        padding: 36px 44px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 60px rgba(80,160,255,0.12) inset;
        text-align: center;
        min-width: 380px;
    }
    .racer-title {
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: 64px;
        letter-spacing: 4px;
        background: linear-gradient(180deg, #ffffff 0%, #4ec3ff 60%, #1d6fa5 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-shadow: 0 0 40px rgba(80,180,255,0.4);
    }
    .racer-title.small { font-size: 36px; }
    .racer-subtitle {
        font-family: 'Orbitron', sans-serif;
        color: #9bb1cc;
        font-size: 14px;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 20px;
    }
    .racer-controls {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 18px;
        margin: 18px 0 26px;
        color: #cfe0ff;
        font-size: 14px;
        text-align: left;
    }
    .racer-controls kbd {
        display: inline-block;
        background: rgba(80,140,200,0.18);
        border: 1px solid rgba(120,200,255,0.3);
        border-bottom-width: 2px;
        border-radius: 4px;
        padding: 1px 6px;
        font-family: 'Orbitron', monospace;
        font-size: 11px;
        color: #eaf6ff;
    }
    .racer-btn {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 18px;
        letter-spacing: 3px;
        text-transform: uppercase;
        padding: 14px 38px;
        color: #051018;
        background: linear-gradient(180deg, #7fd4ff 0%, #2a90d8 100%);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        box-shadow: 0 6px 0 #1c5d92, 0 8px 24px rgba(80,180,255,0.4);
        transition: transform 0.08s ease, box-shadow 0.08s ease;
    }
    .racer-btn:hover { transform: translateY(-1px); }
    .racer-btn:active { transform: translateY(3px); box-shadow: 0 3px 0 #1c5d92, 0 4px 12px rgba(80,180,255,0.3); }
    .racer-btn-secondary {
        font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 13px;
        letter-spacing: 2px; text-transform: uppercase;
        padding: 10px 18px; color: var(--text);
        background: transparent; border: 1px solid rgba(120,200,255,0.35);
        border-radius: 10px; cursor: pointer; transition: background 0.15s, transform 0.08s;
    }
    .racer-btn-secondary:hover { background: rgba(80,180,255,0.12); transform: translateY(-1px); }
    .racer-hint { color: #6c87a8; font-size: 12px; margin-top: 14px; letter-spacing: 1px; }

    /* Fix #10: launchpad polish — animated reveal + radial background. */
    @@keyframes poracer-reveal {
        0%   { clip-path: inset(0 100% 0 0); opacity: 0; }
        60%  { opacity: 1; }
        100% { clip-path: inset(0 0 0 0);    opacity: 1; }
    }
    @@keyframes poracer-glow {
        0%, 100% { transform: translate(-50%, -50%) scale(1);   opacity: 0.55; }
        50%      { transform: translate(-50%, -50%) scale(1.08); opacity: 0.75; }
    }
    .racer-start .racer-card { position: relative; overflow: hidden; }
    .racer-start .racer-card::before {
        content: ""; position: absolute; left: 50%; top: 50%;
        width: 520px; height: 520px; border-radius: 50%;
        background: radial-gradient(circle, rgba(80,180,255,0.45), rgba(80,180,255,0) 60%);
        filter: blur(20px); pointer-events: none;
        animation: poracer-glow 6s ease-in-out infinite;
    }
    /* Keep the reveal snappy: at the old 1.2s + staggered delays the card
       looked like a black screen for the first second after navigation.
       Only the title keeps the clip reveal; everything else (including the
       Start Race CTA) does a fast fade so the screen is actionable at once. */
    @@keyframes poracer-fade {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
    .racer-start .racer-title {
        position: relative; animation: poracer-reveal 0.45s cubic-bezier(.2,.8,.2,1) both;
    }
    .racer-start .racer-subtitle,
    .racer-start .racer-controls,
    .racer-start .racer-btn,
    .racer-start .racer-hint {
        position: relative; animation: poracer-fade 0.25s ease-out both;
    }

    /* Fix #2/#4: leaderboard submit status + dual actions. */
    .lb-status { min-height: 24px; margin: 6px 0 4px; display: flex; gap: 12px; justify-content: center; align-items: center; }
    .lb-status-text { font-family: 'Orbitron', sans-serif; font-size: 12px; letter-spacing: 2px; color: var(--muted); }
    .lb-status-text.ok    { color: #6bff9c; }
    .lb-status-text.error { color: #ff6b6b; }
    .lb-actions { display: flex; gap: 12px; justify-content: center; align-items: center; flex-wrap: wrap; margin-top: 8px; }

    /* Fix #10: respect reduced-motion + haptic affordance. */
    @@media (prefers-reduced-motion: reduce) {
        .racer-start .racer-title,
        .racer-start .racer-subtitle,
        .racer-start .racer-controls,
        .racer-start .racer-btn,
        .racer-start .racer-hint { animation: none; }
        .racer-start .racer-card::before { animation: none; }
    }

    /* -------- HUD -------- */
    .racer-hud {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 5;
    }
    .hud-panel {
        position: absolute;
        top: 18px;
        background: var(--hud-bg);
        border: 1px solid var(--hud-border);
        border-radius: 12px;
        padding: 12px 16px;
        backdrop-filter: blur(8px);
        box-shadow: var(--hud-glow);
        color: var(--text);
        min-width: 160px;
    }
    .hud-left  { left: 18px; }
    .hud-right { right: 18px; min-width: 220px; }
    .hud-label {
        font-family: 'Orbitron', sans-serif;
        font-size: 10px;
        letter-spacing: 2px;
        color: var(--muted);
        text-transform: uppercase;
        margin-top: 6px;
    }
    .hud-label:first-child { margin-top: 0; }
    .hud-value {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 20px;
        color: #ffffff;
    }
    .hud-value.big { font-size: 34px; color: var(--accent); text-shadow: 0 0 16px rgba(80,180,255,0.6); }
    .hud-of { color: var(--muted); font-size: 14px; font-weight: 500; }
