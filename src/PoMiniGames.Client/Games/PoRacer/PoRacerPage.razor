@page "/poracer"
@page "/poracer/1player"
@page "/poracer/demo"
@using PoMiniGames.Shared.Games
@inject IJSRuntime JS
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject GameStatsService GameStats
@inject GameResultService GameResults
@inject ScoreSyncService ScoreSync
@inject KioskCoordinator Kiosk
@inject PlayerNameService PlayerNameService
@inject ApiService Api
@inject ApiEndpoints Endpoints
@inject UiFeedbackService Feedback
@implements IAsyncDisposable

<PageTitle>Racer · PoMiniGames</PageTitle>
<GameShell Title="@TitleContent" Player="@_playerName" BackTo="/" Fullscreen="true"
           GameOver="@(_phase == RacePhase.Finished && !_isDemo)" GameKey="poracer"
           GameSummary="@SummaryContent" PlayAgain="RestartRaceAsync">
    <div class="racer-root">
        <canvas id="racerCanvas" class="racer-canvas" role="img" aria-label="Race track"></canvas>
        @if (_phase == RacePhase.Start)
        {
            <section class="racer-start" aria-label="Start a race">
                <div class="racer-card">
                    <h1>@(_isDemo ? "Watch a race" : "Ready to race?")</h1>
                    <p>@PoRacerCatalog.CarCount cars · @PoRacerCatalog.TotalLaps laps · best laps reach the leaderboard</p>
                    @if (!_isDemo && string.IsNullOrWhiteSpace(MatchCode))
                    {
                        <PoRacerTrackSelector SelectedTrackId="@_selectedTrackId" SelectedTrackIdChanged="SelectTrack" />
                        <details><summary>Customize car</summary><PoRacerPaintShop @bind-Customization="_customization" /></details>
                    }
                    <div class="racer-actions">
                        <button class="racer-primary" disabled="@(!_engineReady || _isStarting)" @onclick="StartRaceAsync">
                            @(_isStarting ? "Joining race…" : !_engineReady ? "Loading track…" : _isDemo ? "Watch race" : "Start race")
                        </button>
                        @if (!_isDemo && string.IsNullOrWhiteSpace(MatchCode))
                        {
                            <a href="/poracer/multi">Multiplayer</a>
                        }
                        <a href="/leaderboards">Leaderboard</a>
                    </div>
                    @if (_error is not null)
                    {
                        <p class="racer-error" role="alert">@_error</p>
                    }
                    @if (!_isDemo)
                    {
                        <details>
                            <summary>Controls</summary>
                            <p>W / ↑ accelerate · S / ↓ brake · A D / ← → steer · Space drift.</p>
                            <p>On touch screens, hold the steering and pedal buttons. Drive over orange pads for a boost.</p>
                        </details>
                    }
                </div>
            </section>
        }
        @if (_phase == RacePhase.Racing)
        {
            <PoRacerHud Cars="_cars" PlayerId="_localCarId" TotalLaps="_totalLaps" ElapsedSeconds="_elapsed" IsDemo="_isDemo" />
            <button class="racer-back" @onclick="RestartRaceAsync">Back to start</button>
        }
        @if (_connectionStatus is not null)
        {
            <p class="racer-connection" role="status">@_connectionStatus</p>
        }
        <span class="sr-only" aria-live="polite">@_announcement</span>
    </div>
</GameShell>

@code {
    private RenderFragment TitleContent => @<span>🏎️ Racer</span>;
    private RenderFragment SummaryContent => @<PoRacerResults Result="_result" PlayerId="_localCarId"
        SubmitStatus="@_submitStatus" Retry="SubmitScoreAsync" />;
}
