@using System.Diagnostics
@using Microsoft.AspNetCore.SignalR.Client
@using PoMiniGamesClient.Games.PoRacer
@using PoMiniGamesClient.Enums
@using PoMiniGamesClient.Services
@using PoMiniGamesClient.Components
@using PoShared.Games
@*
    PoRacer — Multiplayer race client (thin renderer).

    The server runs the simulation. This page is responsible for:
      1. Joining a SignalR race hub at /poracer/race-hub and pointing the
         client at the GameCode the lobby handed us.
      2. Streaming keyboard / touch input back to the hub at the input rate.
      3. Receiving PoRacerRaceSnapshot frames (~20 Hz) and rendering them.
      4. Showing a synchronised 3-2-1-GO! countdown before the race actually
         ticks so all players cross the line at the same instant.

    Solo demo mode (/poracer/demo) uses an 8-bot CPU race that the server
    spins up automatically when the lobby is empty — the only difference is
    that the user gets a "🤖 Demo" badge in the header.

    2026-07-10: Rewritten on top of a server-authoritative PoRacerRaceHub.
    The previous client-side physics engine moved server-side (PoRacerSim.cs).
    The rendering pipeline (track bitmap, particles, weather, HUD) is reused
    verbatim from racingInterop.js — we just hand it the snapshot instead of
    ticking C# state.
*@

@page "/poracer"
@page "/poracer/1player"
@page "/poracer/demo"
@inject IJSRuntime JS
@inject PoRacerScoreApiClient Scores
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject GameStatsService GameStats
@inject GameResultService GameResults
@inject KioskCoordinator Kiosk
@inject PlayerNameService PlayerNameService
@inject ApiService Api
@inject ApiEndpoints Endpoints
@inject ToastService ToastService
@implements IAsyncDisposable

<PageTitle>Racer — Arcade Racing</PageTitle>

<GameShell Title="@TitleContent"
           Player="@_playerName"
           BackTo="/"
           Fullscreen="true"
           Status="@StatusContent"
           GameOver="@(Phase == GamePhase.Finished && !_isDemo)"
           GameKey="poracer"
           GameSummary="@RaceSummaryContent"
           HowToPlay="@HowToPlayContent">
@if (!_introDone)
{
    <GameIntro Title="@TitleContent"
               Objective="Beat the pack to the finish line — 3 laps, first across wins."
               Controls="@HowToPlayContent"
               Mode="@_introMode"
               OnStart="OnIntroStartAsync" />
}
<div class="racer-shell-wrap">
<div class="racer-root @(_crtOn ? "crt-enabled" : "") po-page-transition" tabindex="0">
    <div class="racer-canvas-wrap">
        <canvas id="racerCanvas" class="racer-canvas racer-canvas--interactive"></canvas>
    </div>

    @if (_crtOn)
    {
        <div class="crt-overlay">
            <div class="crt-roll-bar"></div>
            <div class="crt-flicker-overlay"></div>
            <div class="crt-bezel"></div>
        </div>
    }

    <div class="racer-touch @(Phase == GamePhase.Racing ? "is-active" : "")" aria-hidden="true">
        <div class="touch-cluster">
            <button type="button" class="touch-btn" data-po-input="left">◀</button>
            <button type="button" class="touch-btn" data-po-input="right">▶</button>
        </div>
        <div class="touch-cluster">
            <button type="button" class="touch-btn touch-btn--pill" data-po-input="space">DRIFT</button>
            <button type="button" class="touch-btn" data-po-input="down">▼</button>
            <button type="button" class="touch-btn touch-btn--accel" data-po-input="up">▲</button>
        </div>
    </div>

    @* -------- Multiplayer toast layer (NET_RUN_10 #10) -------- *@
    @if (_toast is not null)
    {
        <div class="racer-toast" role="status" aria-live="polite">@_toast</div>
    }

    @* -------- Pre-race countdown overlay -------- *@
    @if (Phase == GamePhase.Racing && _countdownMs > 0)
    {
        <div class="racer-countdown">
            @{
                var n = Math.Max(1, (int)Math.Ceiling(_countdownMs / 1000.0));
                <div class="racer-countdown-num">@n</div>
            }
        </div>
    }

    @* -------- Connecting / failed-to-start overlay --------
       2026-07-16: this was a "Start Race" title card that every player had to
       click through. The race now auto-starts on navigation (see
       OnAfterRenderAsync), so this overlay is only ever seen while the lobby
       connection is in flight, or if that connection failed — in which case it
       offers a retry rather than stranding the player on a dead canvas.
       2026-07-26 browser audit #3: also gate this overlay on _introDone so it
       doesn't render behind the GameIntro card on /poracer/1player. *@
    @if (Phase == GamePhase.Start && _introDone)
    {
        <div class="racer-overlay racer-start">
            <div class="racer-card">
                <div class="racer-title">Racer</div>
                @if (string.IsNullOrEmpty(_startError))
                {
                    <div class="racer-subtitle">Joining race…</div>
                    <div class="racer-controls">
                        <div><kbd>W</kbd> / <kbd>↑</kbd> Accelerate</div>
                        <div><kbd>S</kbd> / <kbd>↓</kbd> Brake / Reverse</div>
                        <div><kbd>A</kbd> <kbd>D</kbd> / <kbd>←</kbd> <kbd>→</kbd> Steer</div>
                        <div><kbd>Space</kbd> Handbrake (drift)</div>
                    </div>
                    <div class="racer-hint">@_startHint</div>
                }
                else
                {
                    <div class="racer-subtitle">Couldn't start the race</div>
                    <div class="racer-hint racer-hint--error">@_startError</div>
                    <div class="racer-start-actions">
                        <button class="racer-btn" @onclick="StartRace">Retry</button>
                        <button class="racer-btn-secondary" @onclick="OpenLobby">Multiplayer lobby</button>
                    </div>
                }
            </div>
        </div>
    }

    @* -------- In-game HUD -------- *@
    @if (Phase == GamePhase.Racing && _countdownMs == 0)
    {
        <div class="racer-hud" aria-live="polite" aria-atomic="false">
            <div class="hud-panel hud-left">
                @* §2026-07-16: demo mode is a spectator (no IsPlayer car), so the
                   left panel collapses to a "Spectator" badge + the race clock
                   instead of fabricating a fake player position from a null car. *@
                @if (_isDemo)
                {
                    <div class="hud-label">Mode</div>
                    <div class="hud-value big">🤖 Spectator</div>

                    <div class="hud-label">Grid</div>
                    <div class="hud-value">@Cars.Count <span class="hud-of">CPU drivers</span></div>

                    <div class="hud-label">Time</div>
                    <div class="hud-value">@FormatTime(_elapsedRaceTime)</div>
                }
                else
                {
                    <div class="hud-label">Position</div>
                    <div class="hud-value big">@Ordinal(Player?.Position ?? 0) <span class="hud-of">/ @Cars.Count</span></div>

                    <div class="hud-label">Lap</div>
                    @* Server uses Lap>TotalLaps as the "finished" sentinel; the HUD
                       must never show 4/3 — clamp the display to TotalLaps. *@
                    <div class="hud-value">@(Math.Min(Player?.Lap ?? 1, TotalLaps)) <span class="hud-of">/ @TotalLaps</span></div>

                    <div class="hud-label">Speed</div>
                    <div class="hud-value">@((int)SpeedKph(Player)) <span class="hud-of">km/h</span></div>
                    <div class="hud-speed-bar">
                        <div class="hud-speed-fill" style="width:@(Math.Min(100, SpeedKph(Player) / 3.4))%"></div>
                    </div>

                    <div class="hud-label">Time</div>
                    <div class="hud-value">@FormatTime(_elapsedRaceTime)</div>
                }
                @* FPS row removed — the shared top-bar FpsCounter badge covers it. *@
            </div>

            <div class="hud-panel hud-right">
                <div class="hud-label">Standings</div>
                @foreach (var c in Standings.Take(8))
                {
                    <div class="hud-row @(c.IsPlayer ? "is-player" : "")">
                        <span class="hud-dot" style="background:@c.Color"></span>
                        <span class="hud-pos">@Ordinal(c.Position)</span>
                        <span class="hud-name">@c.Name</span>
                        <span class="hud-laps">@(c.Lap > TotalLaps ? "Fin" : $"L{c.Lap}")</span>
                    </div>
                }
            </div>
        </div>
    }

    @if (Phase == GamePhase.Racing)
    {
        <div class="hud-tod">
            @if (_timeOfDay > 0.6) { <span>☀️ Day</span> }
            else if (_timeOfDay > 0.4) { <span>🌤️ Dawn/Dusk</span> }
            else { <span>🌙 Night</span> }
        </div>
    }

    @* Race-finished content moved into the shared GameShell end-of-game modal
       (RaceSummaryContent) so every game ends with the same dialog. *@
</div>
</div>
</GameShell>

@code {
    // ─────────────────────────────  Phase  ─────────────────────────────
    private enum GamePhase { Start, Racing, Finished }
    private GamePhase Phase = GamePhase.Start;
    private bool _isDemo;
    private bool _disposed;

    // Intro/welcome gate: the race does not start until the player dismisses the
    // intro card (OK in 1P; a 2s auto-flash in demo). See OnIntroStartAsync.
    private bool _introDone;
    private GameIntro.IntroMode _introMode => _isDemo
        ? GameIntro.IntroMode.Demo
        : GameIntro.IntroMode.OnePlayer;

    private RenderFragment TitleContent => @<text>🏎️ Racer</text>;

    private RenderFragment HowToPlayContent => @<div>
        <p>Finish 3 laps ahead of the pack.</p>
        <ul>
            <li><kbd>↑</kbd>/<kbd>W</kbd> accelerate · <kbd>↓</kbd>/<kbd>S</kbd> brake</li>
            <li><kbd>←</kbd>/<kbd>→</kbd> (or <kbd>A</kbd>/<kbd>D</kbd>) steer</li>
            <li>Best race times land on the leaderboard — smooth lines beat raw speed</li>
        </ul>
    </div>;
    private string _playerName = string.Empty;
    private RenderFragment StatusContent => _isDemo
        ? @<span class="gps-status-badge demo">🤖 Demo</span>
        : Phase == GamePhase.Racing
            ? @<span class="gps-status-badge player">Lap @(Math.Min(Player?.Lap ?? 1, TotalLaps)) / @TotalLaps</span>
            : Phase == GamePhase.Finished
                ? @<span class="gps-status-badge draw">🏁 Finished</span>
                : @<span class="gps-status-badge turn">Multiplayer arcade racing</span>;

    // End-of-race content for the shared GameShell modal: result line, final
    // standings, and the score-submit status (with retry). Same contract as
    // every other game — result, score, actions.
    private RenderFragment RaceSummaryContent => @<div class="racer-modal-summary">
        @if (Player?.Position == 1)
        {
            <div class="cf-result cf-result--win">🏆 You won!</div>
        }
        else
        {
            <div class="cf-result cf-result--draw">🏁 You finished @Ordinal(Player?.Position ?? 0)</div>
        }
        @if ((Player?.BestLapSeconds ?? -1) > 0)
        {
            <div class="racer-bestlap">⏱️ Fastest lap: <strong>@FormatTime(Player!.BestLapSeconds)</strong> — your score</div>
        }
        <div class="leaderboard" aria-live="polite">
            @foreach (var c in Standings)
            {
                <div class="lb-row @(c.IsPlayer ? "is-player" : "")">
                    <span class="lb-pos">@Ordinal(c.Position)</span>
                    <span class="hud-dot" style="background:@c.Color"></span>
                    <span class="lb-name">@c.Name</span>
                    <span class="lb-time">@(c.FinishTime > 9e8 || c.FinishTime < 0 ? "DNF" : FormatTime(c.FinishTime))</span>
                </div>
            }
        </div>
        <div class="lb-status" role="status">
            @if (_submitState == SubmitState.Submitting)
            {
                <span class="lb-status-text">Submitting score...</span>
            }
            else if (_submitState == SubmitState.Failed)
            {
                <span class="lb-status-text error">@_submitError</span>
                <button class="racer-btn-secondary" @onclick="SubmitPlayerScoreAsync">Retry</button>
            }
            else if (_submitState == SubmitState.Saved)
            {
                <span class="lb-status-text ok">✓ Score saved</span>
            }
        </div>
    </div>;

    // The global PoRacer lobby is a single shared room — no codes, no joining.

    // ─────────────────────────────  State  ─────────────────────────────
    private HubConnection? _raceHub;
    private string? _gameCode;
    private string _startHint = "8 cars · 3 laps · first across the line wins";
    private string? _startError;
    private string? _toast;
    private System.Timers.Timer? _toastTimer;

    private List<PoRacerCarState> Cars = new();
    private PoRacerCarState? Player => Cars.FirstOrDefault(c => c.IsPlayer);
    private List<Standing> _standings = new();
    private IEnumerable<Standing> Standings => _standings;
    private double _elapsedRaceTime;
    private int _countdownMs;
    private double _timeOfDay = 0.5;

    // Local-input state (read by the JS thin-client bridge; sent to server via SignalR).
    private InputState _input = new();
    private bool _lastSentUp, _lastSentDown, _lastSentLeft, _lastSentRight, _lastSentSpace;
    private System.Timers.Timer? _inputTimer;

    // HUD watchdog — guarantees the HUD ticks even if the rAF callback is
    // throttled (e.g. canvas extending beyond the viewport on iOS Safari).
    private System.Timers.Timer? _watchdog;

    // Race result handling.
    private PoRacerFinalResult? _finalResult;
    private SubmitState _submitState = SubmitState.Idle;
    private string _submitError = "";
    private enum SubmitState { Idle, Submitting, Saved, Failed }
    private bool _playerSubmitted;

    private bool _crtOn;
    private const int TotalLaps = 3;

    protected override Task OnInitializedAsync()
    {
        _isDemo = Nav.Uri.Contains("/poracer/demo", StringComparison.OrdinalIgnoreCase);
        _playerName = PlayerNameService.GetPlayerName();
        try
        {
            var stored = LocalStorageService.GetItem<string>("PoRacer.CrtShader");
            _crtOn = bool.TryParse(stored, out var val) && val;
        }
        catch { _crtOn = false; }
        GameStats.SaveLastPlayedGame("poracer");
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (_isDemo) Kiosk.SetCurrent("poracer-demo");

        _watchdog = new System.Timers.Timer(500) { AutoReset = true };
        _watchdog.Elapsed += async (_, _) =>
        {
            // Force a HUD update every 500 ms even if the rAF loop is throttled.
            // The watchdog only fires StateHasChanged when the HUD *could* have moved
            // (i.e. we're in the racing phase and snapshots are flowing).
            if (Phase == GamePhase.Racing && Cars.Count > 0)
            {
                await InvokeAsync(StateHasChanged);
            }
        };
        _watchdog.Start();

        // JS-side bridge: a thin shim that reads window.__poInput (filled by
        // keyboard + touch) and invokes onInputChange(...) on every change.
        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("PoRacer.start", "racerCanvas", _selfRef);

        // The race no longer auto-starts here — the intro card gates it. Once the
        // player dismisses the intro (OK in 1P, 2s flash in demo), OnIntroStartAsync
        // connects to the race hub (demo = spectator, 1P = player).
    }

    // Fired by the GameIntro card when the player is ready. Demo connects as a
    // spectator (server pads the grid with AI bots); 1P joins the shared lobby.
    private async Task OnIntroStartAsync()
    {
        _introDone = true;
        StateHasChanged();
        if (_isDemo)
        {
            await StartDemoRaceAsync();
        }
        else
        {
            await StartRace();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _watchdog?.Stop(); _watchdog?.Dispose();
        _inputTimer?.Stop(); _inputTimer?.Dispose();
        _toastTimer?.Stop(); _toastTimer?.Dispose();
        try { await JS.InvokeVoidAsync("PoRacer.stop"); } catch { }
        _selfRef?.Dispose();
        if (_raceHub is not null) { try { await _raceHub.DisposeAsync(); } catch { } }
    }

    private DotNetObjectReference<PoRacerPage>? _selfRef;

    // ─────────────────────────────  Race lifecycle  ─────────────────────────────

    private async Task StartRace()
    {
        _startError = null;
        // 2026-07-19 browser audit #9: gate the "Joining race…" placeholder
        // on a timeout. The SignalR WebSocket upgrade through
        // UseResponseCompression takes ~8.5s on this dev box (see memory);
        // without a fallback the user sits on a dead overlay for the entire
        // upgrade window. After 10s we offer an offline option so the
        // player can still steer a CPU-only grid.
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        var available = await Api.IsAvailableAsync();
        if (!available)
        {
            _startError = "Server unavailable. Try Demo mode.";
            StateHasChanged();
            return;
        }
        try
        {
            // 1-player is a private solo race — no lobby. A unique code per
            // session guarantees a fresh 8-car grid (human on pole + 7 AI) that
            // this connection owns, so the arrow keys drive the player's car.
            _gameCode = "solo-" + Guid.NewGuid().ToString("N")[..8];
            // Race ConnectRaceAsync against the 10s budget so a hung
            // negotiate/post/abort transitions to the retry UI instead of
            // stranding the player on the placeholder.
            var connectTask = ConnectRaceAsync(_gameCode, asPlayer: true);
            var winner = await Task.WhenAny(connectTask, Task.Delay(Timeout.Infinite, cts.Token));
            if (winner != connectTask)
            {
                _startError = "Race hub took too long to connect. Try again, or switch to Demo mode for an offline CPU grid.";
                StateHasChanged();
                return;
            }
            await connectTask; // surface any exception to the catch below
            Phase = GamePhase.Racing;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _startError = ex.Message;
            StateHasChanged();
        }
    }

    private async Task ConnectRaceAsync(string code, bool asPlayer)
    {
        // Retry safety: tear down any hub left over from a previous failed
        // attempt (the "Retry" button re-enters here) so we never leak a
        // reconnecting connection or double-join the race.
        if (_raceHub is not null)
        {
            try { await _raceHub.DisposeAsync(); } catch { }
            _raceHub = null;
        }

        _raceHub = HubConnectionFactory.Create(Endpoints.Hub("poracer/race-hub"));
        // §2026-07-18: register the snapshot/finished handlers BEFORE invoking
        // JoinRace. Otherwise snapshots broadcast in the gap between the server
        // wiring its events and our client subscribing are silently dropped,
        // and the HUD stays empty (Cars.Count == 0) even though the race is
        // ticking on the server.
        _raceHub.On<PoRacerRaceSnapshot>("raceSnapshot", snap => OnSnapshot(snap));
        _raceHub.On<PoRacerFinalResult>("raceFinished", result => OnFinished(result));
        // §2026-07-19: was `StartAsync().ContinueWith(_ => InvokeAsync("JoinRace"))
        // .Unwrap()`. ContinueWith runs its continuation even when StartAsync
        // faults (or before the connection reaches Connected), so JoinRace fired
        // on an inactive hub → "InvokeCoreAsync cannot be called if the
        // connection is not active", masking the real negotiate error. Awaiting
        // sequentially guarantees the connection is up before we invoke, and any
        // StartAsync failure surfaces to the caller's try/catch as itself.
        await _raceHub.StartAsync();
        // asPlayer=true (1P) claims the pole car on the server for this connection
        // so arrow-key input drives it; demo passes false to spectate.
        var initialSnap = await _raceHub.InvokeAsync<PoRacerRaceSnapshot?>(
            "JoinRace", code, asPlayer,
            AuthState.User?.DisplayName ?? "Player", !AuthState.IsAuthenticated);
        if (initialSnap?.Static is not null)
        {
            await JS.InvokeVoidAsync("PoRacerRender.setStatic",
                initialSnap.Static.CenterXY, initialSnap.Static.TrackWidth, initialSnap.Static.WallsXY);
        }

        // Stream input at 30 Hz — only meaningful when we're an actual player. In
        // demo/spectator mode there's no car with our ConnectionId, so the server
        // would silently drop every packet anyway. Skip the timer to avoid noise.
        if (!_isDemo)
        {
            _inputTimer = new System.Timers.Timer(33) { AutoReset = true };
            _inputTimer.Elapsed += async (_, _) =>
            {
                if (_raceHub is null || _gameCode is null) return;
                var i = _input;
                if (i.up == _lastSentUp && i.down == _lastSentDown && i.left == _lastSentLeft &&
                    i.right == _lastSentRight && i.space == _lastSentSpace)
                    return;
                _lastSentUp = i.up; _lastSentDown = i.down; _lastSentLeft = i.left;
                _lastSentRight = i.right; _lastSentSpace = i.space;
                try { await _raceHub.InvokeAsync("SendInput", _gameCode, new PoRacerInput
                {
                    Up = i.up, Down = i.down, Left = i.left, Right = i.right, Space = i.space,
                    ClientTs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
                }); } catch { }
            };
            _inputTimer.Start();
        }
    }

    private void ShowToast(string message)
    {
        _toast = message;
        _toastTimer?.Stop();
        _toastTimer = new System.Timers.Timer(3500) { AutoReset = false };
        _toastTimer.Elapsed += (_, _) => { _toast = null; InvokeAsync(StateHasChanged); };
        _toastTimer.Start();
        InvokeAsync(StateHasChanged);
    }

    private void OnSnapshot(PoRacerRaceSnapshot snap)
    {
        if (_disposed) return;
        _countdownMs = snap.CountdownMs;
        Cars = snap.Cars.ToList();
        _elapsedRaceTime = snap.ElapsedRaceTime;
        ComputeStandings();
        // Pump the JS renderer with the latest snapshot.
        try
        {
            _ = JS.InvokeVoidAsync("PoRacerRender.drawSnapshot",
                "racerCanvas", null,
                snap.ElapsedRaceTime, snap.CountdownMs > 0 ? 0 : 1,
                Cars.Select(c => new
                {
                    x = c.X, y = c.Y, h = c.Heading, v = c.Speed,
                    color = c.Color, colorDark = c.ColorDark,
                    isPlayer = c.IsPlayer, name = c.Name, lap = c.Lap,
                    position = c.Position, finished = c.Finished,
                    boost = c.BoostGlow, skid = c.SkidIntensity,
                }).ToArray());
        }
        catch { }
        if (snap.Finished && Phase != GamePhase.Finished)
        {
            Phase = GamePhase.Finished;
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnFinished(PoRacerFinalResult result)
    {
        _finalResult = result;
        Phase = GamePhase.Finished;
        ShowToast("Race finished");
        // Demo is a spectator race — there's no player car to score, so don't
        // push a phantom 0-position entry to the leaderboard, and don't record an
        // outcome the player never played. GameShell hides the end-of-game modal
        // in demo anyway (see GameOver prop).
        if (!_isDemo)
        {
            _ = SubmitPlayerScoreAsync();
            // The race outcome also belongs in the local record, so Racer shows up
            // on the profile alongside every other rated game. Only first place is a
            // win — the field is CPU-filled, so "finished at all" is not an outcome.
            var outcome = Player?.Position == 1 ? GameResult.Win : GameResult.Loss;
            _ = GameResults.RecordAsync("poracer", _playerName, Difficulty.Medium, outcome);
        }
        InvokeAsync(StateHasChanged);
    }

    // ─────────────────────────────  Standings + score submit  ─────────────────────────────

    public class Standing
    {
        public int Position;
        public string Name = "";
        public string Color = "#fff";
        public int Lap;
        public double FinishTime;
        public bool IsPlayer;
    }

    private void ComputeStandings()
    {
        _standings = Cars.OrderBy(c => c.Position).Select(c => new Standing
        {
            Position = c.Position,
            Name = c.Name,
            Color = c.Color,
            Lap = Math.Min(c.Lap, TotalLaps),
            FinishTime = c.FinishTime,
            IsPlayer = c.IsPlayer,
        }).ToList();
    }

    private async Task SubmitPlayerScoreAsync()
    {
        if (_playerSubmitted) return;
        if (Player is null) return;
        if (_finalResult is null) return;
        var myResult = _finalResult.Standings.FirstOrDefault(s => s.Name == Player.Name);
        if (myResult is null) return;
        // 1P is scored on the FASTEST LAP, not total race time. No completed lap
        // (crashed out / DNF before crossing the line once) → nothing to submit.
        if (myResult.BestLapSeconds <= 0)
        {
            _submitState = SubmitState.Idle;
            StateHasChanged();
            return;
        }
        _playerSubmitted = true;
        _submitState = SubmitState.Submitting;
        StateHasChanged();
        try
        {
            await Scores.SubmitAsync(new PoRacerScoreDto
            {
                PlayerDisplayName = AuthState.User?.DisplayName ?? "Player",
                // The leaderboard ranks by this field ascending; feeding it the
                // best lap makes it a fastest-lap board.
                TotalTimeSeconds = myResult.BestLapSeconds,
                FinalPosition = myResult.Position,
                AchievedAtUtc = _finalResult.FinishedAtUtc,
                IsGuest = !AuthState.IsAuthenticated,
                GameCode = _gameCode ?? "",
            });
            _submitState = SubmitState.Saved;
        }
        catch (Exception ex)
        {
            _submitState = SubmitState.Failed;
            _submitError = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    // ─────────────────────────────  Demo / fallback  ─────────────────────────────

    private async Task StartDemoRaceAsync()
    {
        // §2026-07-16 — pure spectator demo. The visitor does NOT join the lobby:
        // we skip the lobby hub / ToggleReady / StartGame entirely and just
        // subscribe to the race hub. The server's PoRacerSim pads an empty
        // player list with 8 AI bots (see Features/PoRacer/PoRacerSim.cs), so the
        // demo race is always a full grid of CPU cars — the visitor watches the
        // action without driving. This also means no lobby-hub negotiate round-trip,
        // which used to be the path that 401'd (fixed by the
        // SignalRCredentialsHttpClientFactory handler chain).
        try
        {
            _gameCode = "LOBBY";
            await ConnectRaceAsync(_gameCode, asPlayer: false);
            Phase = GamePhase.Racing;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _startError = "Demo unavailable: " + ex.Message;
            StateHasChanged();
        }
    }

