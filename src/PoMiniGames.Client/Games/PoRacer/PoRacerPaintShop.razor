@using PoMiniGames.Shared.Games
@inject IJSRuntime JS

<div class="racer-paintshop" role="region" aria-label="Car Customization Paint Shop">
    <div class="paintshop-preview-wrap">
        <svg class="car-preview-svg" viewBox="-24 -16 48 32" width="120" height="80" aria-label="Car Preview">
            <!-- Shadow -->
            <ellipse cx="2" cy="4" rx="18" ry="10" fill="rgba(0,0,0,0.35)" />
            <!-- Car Body -->
            <rect x="-16" y="-9" width="32" height="18" rx="5" fill="@Customization.ColorHex" stroke="rgba(0,0,0,0.5)" stroke-width="1.2" />
            <!-- Livery Pattern -->
            @if (Customization.LiveryPattern == "dual")
            {
                <rect x="-14" y="-4.5" width="28" height="1.8" fill="rgba(255,255,255,0.85)" />
                <rect x="-14" y="2.7" width="28" height="1.8" fill="rgba(255,255,255,0.85)" />
            }
            else if (Customization.LiveryPattern == "carbon")
            {
                <rect x="-14" y="-7" width="10" height="14" fill="rgba(25,25,30,0.7)" />
                <rect x="8" y="-8" width="6" height="16" fill="rgba(25,25,30,0.7)" />
                <rect x="-14" y="-1" width="28" height="2" fill="rgba(255,255,255,0.6)" />
            }
            else if (Customization.LiveryPattern == "neon")
            {
                <rect x="-13" y="-7" width="26" height="14" fill="none" stroke="#00ffff" stroke-width="1.5" />
                <rect x="-14" y="-1.2" width="28" height="2.4" fill="#ff007f" />
            }
            else
            {
                <rect x="-14" y="-1.2" width="28" height="2.4" fill="rgba(255,255,255,0.85)" />
            }
            <!-- Windshield -->
            <rect x="2" y="-7" width="8" height="14" rx="2" fill="rgba(20,30,45,0.85)" />
            <!-- Headlights -->
            <circle cx="14" cy="-5" r="1.8" fill="#fffbe0" />
            <circle cx="14" cy="5" r="1.8" fill="#fffbe0" />
            <!-- Taillights -->
            <circle cx="-15" cy="-5" r="1.6" fill="#ff3030" />
            <circle cx="-15" cy="5" r="1.6" fill="#ff3030" />
        </svg>
    </div>

    <div class="paintshop-controls">
        <div class="control-group">
            <span class="control-label">PAINT COLOR</span>
            <div class="swatch-row" role="radiogroup" aria-label="Car Body Color">
                @foreach (var c in Swatches)
                {
                    var isSelected = string.Equals(Customization.ColorHex, c.Hex, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="swatch-btn @(isSelected ? "is-selected" : "")"
                            style="--swatch-color: @c.Hex"
                            title="@c.Name"
                            role="radio"
                            aria-checked="@isSelected"
                            @onclick="() => SetColor(c.Hex)">
                        <span class="swatch-dot"></span>
                    </button>
                }
            </div>
        </div>

        <div class="control-group">
            <span class="control-label">LIVERY STYLE</span>
            <div class="livery-row" role="radiogroup" aria-label="Livery Pattern">
                @foreach (var l in Liveries)
                {
                    var isSelected = string.Equals(Customization.LiveryPattern, l.Key, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="livery-btn @(isSelected ? "is-selected" : "")"
                            role="radio"
                            aria-checked="@isSelected"
                            @onclick="() => SetLivery(l.Key)">
                        @l.Name
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private const string StorageKey = "PoRacer.Customization";

    [Parameter]
    public PoRacerCarCustomization Customization { get; set; } = PoRacerCarCustomization.Default;

    [Parameter]
    public EventCallback<PoRacerCarCustomization> CustomizationChanged { get; set; }

    [Parameter]
    public EventCallback<PoRacerCarCustomization> OnChanged { get; set; }

    private record Swatch(string Name, string Hex);
    private static readonly IReadOnlyList<Swatch> Swatches = new[]
    {
        new Swatch("Cyan Pulse", "#00f0ff"),
        new Swatch("Electric Pink", "#ff007f"),
        new Swatch("Viper Green", "#00ff66"),
        new Swatch("Solar Flare", "#ffaa00"),
        new Swatch("Crimson Red", "#ff3333"),
        new Swatch("Phantom Purple", "#aa00ff")
    };

    private record LiveryOption(string Key, string Name);
    private static readonly IReadOnlyList<LiveryOption> Liveries = new[]
    {
        new LiveryOption("stripe", "Classic Stripe"),
        new LiveryOption("dual", "Twin GT"),
        new LiveryOption("carbon", "Carbon Aero"),
        new LiveryOption("neon", "Cyber Neon")
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
                if (!string.IsNullOrWhiteSpace(stored))
                {
                    var parts = stored.Split('|');
                    if (parts.Length >= 2)
                    {
                        var loaded = new PoRacerCarCustomization(parts[0], parts[1]);
                        Customization = loaded;
                        await CustomizationChanged.InvokeAsync(loaded);
                        await OnChanged.InvokeAsync(loaded);
                        StateHasChanged();
                    }
                }
            }
            catch { }
        }
    }

    private async Task SetColor(string hex)
    {
        if (Customization.ColorHex == hex) return;
        Customization = Customization with { ColorHex = hex };
        await PersistAndNotifyAsync();
    }

    private async Task SetLivery(string livery)
    {
        if (Customization.LiveryPattern == livery) return;
        Customization = Customization with { LiveryPattern = livery };
        await PersistAndNotifyAsync();
    }

    private async Task PersistAndNotifyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, $"{Customization.ColorHex}|{Customization.LiveryPattern}");
        }
        catch { }
        await CustomizationChanged.InvokeAsync(Customization);
        await OnChanged.InvokeAsync(Customization);
    }
}
