@page "/porunner"
@page "/porunner/{ModeParam}"
@using PoMiniGamesClient.Components;
@using PoMiniGamesClient.Services;
@using PoMiniGamesClient.Games.PoRunner;
@using PoMiniGamesClient.Enums;
@implements IDisposable
@inject PlayerNameService PlayerNameService;
@inject NavigationManager Navigation;
@inject IJSRuntime JSRuntime;
@inject KioskCoordinator Kiosk;

<GameShell Title=@TitleContent 
           Player="@_playerName"
           BackTo="@_backTo"
           GameOver="@(_state.GameStatus == GameStatus.GameOver)"
           OnPlayAgain="ReturnToLobby"
           ShowSettings="true"
           IsOffline="@_isOffline"
           Stats="@_statItems"
           Controls="@ControlsContent">
    <div class="pr-container" tabindex="0" @onkeydown="HandleKeyDown" @ref="_gameContainer">
        <div id="game-container" class="pr-game-container">
            <canvas id="gameCanvas" class="pr-canvas" style="image-rendering: pixelated;"></canvas>
            
            @* Mobile keyboard warning *@
            <div id="mobile-warning" class="pr-mobile-warning hidden">
                ⌨️ PoRunner requires a keyboard — best played on desktop.
            </div>
            
            @* Error Screen *@
            <div id="ui-error" class="pr-screen hidden">
                <div class="pr-glass">
                    <h2>⚠️ Connection Error</h2>
                    <p>@_connectionError</p>
                    <button class="pr-btn primary" @onclick="Reconnect">RECONNECT</button>
                </div>
            </div>
            
            @* Lobby Screen *@
            <div id="ui-lobby" class="pr-screen @(IsLobbyVisible ? "" : "hidden")">
                <div class="pr-glass" style="text-align: center;">
                    <h1 class="pr-glow-text">🍌 PoRunner</h1>
                    
                    <div id="player-badge" class="pr-player-badge @(HasLocalPlayer ? "" : "hidden")">
                        <span id="player-badge-icon"></span>
                        <span id="player-badge-label">@GetPlayerBadgeLabel()</span>
                    </div>
                    
                    <div id="lobby-slots" class="pr-lobby-slots"></div>
                    
                    <div class="pr-spinner" id="lobby-spinner" style="@(_showSpinner ? "" : "display: none;")"></div>
                    <p id="lobby-status-line" class="pr-link">@GetLobbyStatusText()</p>
                    
                    <p id="lobby-connection-warning" class="pr-connection-warning hidden">@_connectionError</p>
                    
                    @if (_mode == PoRunnerGameMode.Multiplayer)
                    {
                        <button id="btn-ready" class="pr-btn primary" @onclick="ToggleReady">
                            @(_opponentJoined ? "READY!" : "RACE SOLO!")
                        </button>
                    }
                    <p id="ready-status-text" class="pr-status-text hidden">✅ Ready! Waiting for opponent&hellip;</p>
                    
                    <div class="pr-leaderboard-preview">
                        <p class="pr-leaderboard-title">🏅 Top Scores</p>
                        <table class="pr-leaderboard-table">
                            <tbody id="lobby-leaderboard-body">
                                @foreach (var score in _topScores.Take(5))
                                {
                                    <tr>
                                        <td>@GetMedal(score.Rank)</td>
                                        <td>@score.Initials</td>
                                        <td>@((score.TimeMs / 1000.0).ToString("0.000"))s</td>
                                    </tr>
                                }
                                @if (!_topScores.Any())
                                {
                                    <tr><td colspan="3" style="opacity: 0.5; padding: 0.5rem 0;">Loading…</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            @* Countdown Screen *@
            <div id="ui-countdown" class="pr-screen @(IsCountdownVisible ? "" : "hidden")">
                <p id="countdown-text" class="pr-huge-text pr-glow-text">@_countdownValue</p>
            </div>
            
            @* Playing HUD *@
            <div id="ui-playing" class="pr-hud @(IsPlayingVisible ? "" : "hidden")">
                <div id="hud-timer" class="pr-timer">@_elapsedTime.ToString("0.000")s</div>
                <div id="controls-hint" class="pr-controls-hint @(ShouldShowHint ? "" : "hidden")">
                    <div class="pr-icon-keyboard">⌨️</div>
                    <p id="combo-display">
                        @if (_mode == PoRunnerGameMode.TwoPlayer)
                        {
                            <span>P1: </span>
                        }
                        Type
                        <span class="pr-combo-key @(GetComboClass(0))">T</span>
                        <span class="pr-combo-key @(GetComboClass(1))">Y</span>
                        <span class="pr-combo-key @(GetComboClass(2))">G</span>
                        <span class="pr-combo-key @(GetComboClass(3))">H</span>
                        to run!
                        @if (_mode == PoRunnerGameMode.TwoPlayer)
                        {
                            <span> | P2: </span>
                            <span class="pr-combo-key @(GetComboClass2(0))">Q</span>
                            <span class="pr-combo-key @(GetComboClass2(1))">W</span>
                            <span class="pr-combo-key @(GetComboClass2(2))">E</span>
                            <span class="pr-combo-key @(GetComboClass2(3))">R</span>
                        }
                    </p>
                </div>
            </div>
            
            @* Game Over Screen *@
            <div id="ui-gameover" class="pr-screen shadow-bg @(IsGameOverVisible ? "" : "hidden")">
                <div class="pr-glass pr-gameover-card" style="text-align: center;">
                    <div id="gameover-icon" class="pr-gameover-icon">@(_isLocalWin ? "🏆" : "😤")</div>
                    <h2 id="winner-text" class="pr-glow-text pr-winner-reveal">@_winnerText</h2>
                    <div id="final-time-text" class="pr-timer">@((_lastRaceTimeMs / 1000.0).ToString("0.000"))s</div>
                    <button class="pr-btn primary pr-sticky-cta" @onclick="ReturnToLobby">RETURN TO LOBBY</button>
                    
                    <div id="gameover-details" class="pr-gameover-details">
                        <div id="player-stats" class="pr-player-stats @(HasStatsData ? "" : "hidden")">
                            <div class="pr-stats-row">
                                <span class="pr-stats-label">Personal Best</span>
                                <span id="stats-pb" class="pr-stats-value">@(_personalBest.HasValue ? (_personalBest.Value / 1000.0).ToString("0.000") + "s" : "—")</span>
                            </div>
                            <div class="pr-stats-row">
                                <span class="pr-stats-label">Wins</span>
                                <span id="stats-wins" class="pr-stats-value accent">@_profile.Wins</span>
                                <span class="pr-stats-sep">│</span>
                                <span class="pr-stats-label">Losses</span>
                                <span id="stats-losses" class="pr-stats-value muted">@_profile.Losses</span>
                            </div>
                            <div class="pr-stats-row">
                                <span class="pr-stats-label">Best Streak</span>
                                <span id="stats-streak" class="pr-stats-value">@_profile.WinStreak</span>
                                <span id="stats-streak-fire" class="@(_profile.WinStreak >= 2 ? "" : "hidden")">🔥</span>
                            </div>
                        </div>
                        
                        <div id="initials-form" class="pr-initials-form @(ShouldShowInitialsForm ? "" : "hidden")">
                            <h3 class="pr-initials-title">🏅 New High Score! Enter Initials</h3>
                            <div class="pr-initials-boxes">
                                <input id="initial-0" class="pr-initial-box" type="text" maxlength="1" 
                                       autocomplete="off" spellcheck="false" @bind="_initials[0]" @oninput="(e) => OnInitialInput(0, e)" />
                                <input id="initial-1" class="pr-initial-box" type="text" maxlength="1" 
                                       autocomplete="off" spellcheck="false" @bind="_initials[1]" @oninput="(e) => OnInitialInput(1, e)" />
                                <input id="initial-2" class="pr-initial-box" type="text" maxlength="1" 
                                       autocomplete="off" spellcheck="false" @bind="_initials[2]" @oninput="(e) => OnInitialInput(2, e)" />
                            </div>
                            <button id="btn-submit-initials" class="pr-btn primary" @onclick="SubmitInitials">SUBMIT</button>
                        </div>
                        
                        <div id="leaderboard" class="pr-leaderboard">
                            <button id="btn-toggle-leaderboard" class="pr-btn-leaderboard-toggle" @onclick="ToggleLeaderboard">
                                🏅 View Top 10 ▸
                            </button>
                            <div id="leaderboard-body-wrap" class="pr-leaderboard-body-wrap @(_leaderboardExpanded ? "" : "hidden")">
                                <table class="pr-leaderboard-table">
                                    <thead>
                                        <tr>
                                            <th>Rank</th>
                                            <th>Name</th>
                                            <th>Time</th>
                                        </tr>
                                    </thead>
                                    <tbody id="leaderboard-body">
                                        @foreach (var score in _topScores)
                                        {
                                            <tr class="@GetLeaderboardRowClass(score)">
                                                <td>@GetMedal(score.Rank)</td>
                                                <td>@score.Initials</td>
                                                <td>@((score.TimeMs / 1000.0).ToString("0.000"))s</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</GameShell>

@code {
    [Parameter] public string? ModeParam { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQueryParam { get; set; }
    [SupplyParameterFromQuery(Name = "kiosk")] public int KioskNext { get; set; } = -1;
    
    private ElementReference _gameContainer;
    
    // Game state
    private string _playerName = string.Empty;
    private PoRunnerGameMode _mode = PoRunnerGameMode.OnePlayer;
    private PoRunnerGameState _state = new();
    private List<DemoBot> _bots = new();
    private List<HighScoreEntry> _topScores = new();
    private PlayerProfile _profile = new();
    private List<StatItem> _statItems = new();
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    
    // UI state
    private bool _showSpinner = false;
    private bool _opponentJoined = false;
    private string _connectionError = "";
    private bool _leaderboardExpanded;
    private string _winnerText = "";
    private bool _isLocalWin;
    private long _lastRaceTimeMs;
    private bool _isPlayerReady;
    private string[] _initials = ["", "", ""];
    private long? _personalBest = null;
    private int _countdownValue = 3;
    private double _elapsedTime;
    private bool _isOffline = false;
    
    // Demo mode
    private long _demoAutoRestartAt;
    // BUG FIX (#1): _kioskTimer removed; KioskCoordinator owns the timer.
    
    // Timer
    private System.Threading.Timer? _gameTimer;
    private long _lastFrameTime;
    
    private string _backTo => "/";
    
    private RenderFragment TitleContent => @<span>🍌 PoRunner</span>;
    
    private RenderFragment ControlsContent => @<div class="gps-controls">
        <button @onclick="StartLocalRace" disabled="@(_state.GameStatus != GameStatus.Waiting && _state.GameStatus != GameStatus.ReadyCheck)">
            🚀 Start Race
        </button>
        <button @onclick="ResetRace" disabled="@(_state.GameStatus == GameStatus.Waiting)">
            🔄 Reset
        </button>
    </div>;
    
    protected override void OnInitialized()
    {
        // Path-based mode (/porunner/multi) takes precedence, then query string (?mode=multi)
        var modeValue = ModeParam ?? ModeQueryParam;
        _mode = modeValue switch
        {
            "1p" => PoRunnerGameMode.OnePlayer,
            "2p" => PoRunnerGameMode.TwoPlayer,
            "demo" => PoRunnerGameMode.Demo,
            "multi" => PoRunnerGameMode.Multiplayer,
            _ => PoRunnerGameMode.OnePlayer
        };
        
        _state.Mode = _mode;
        _state.DemoMode = _mode == PoRunnerGameMode.Demo;
        _state.HintDismissed = _mode == PoRunnerGameMode.Demo;
        
        // Initialize stats
        _playerName = PlayerNameService.GetPlayerName();
        _stats = _gameStats.GetStats("porunner", _playerName);
        _profile = new PlayerProfile
        {
            Wins = _stats.Easy.Wins + _stats.Medium.Wins + _stats.Hard.Wins,
            Losses = _stats.Easy.Losses + _stats.Medium.Losses + _stats.Hard.Losses,
            WinStreak = Math.Max(_stats.Easy.WinStreak, Math.Max(_stats.Medium.WinStreak, _stats.Hard.WinStreak))
        };
        UpdateStats();
        
        // Initialize mock scores
        _topScores = new List<HighScoreEntry>
        {
            new() { Rank = 1, TimeMs = 4231, Initials = "ACE" },
            new() { Rank = 2, TimeMs = 4892, Initials = "PRO" },
            new() { Rank = 3, TimeMs = 5140, Initials = "BNZ" },
            new() { Rank = 4, TimeMs = 5673, Initials = "SWF" },
            new() { Rank = 5, TimeMs = 6021, Initials = "MPX" }
        };
        
        if (_mode == PoRunnerGameMode.Demo)
        {
            StartDemo();
            Kiosk.SetCurrent("porunner-demo");
        }
        else if (_mode == PoRunnerGameMode.OnePlayer || _mode == PoRunnerGameMode.TwoPlayer)
        {
            InitializeLocalPlayers();
        }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100);
            await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('.pr-container')?.focus()");
            
            // Start game loop
            _lastFrameTime = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            _gameTimer = new System.Threading.Timer(_ => InvokeAsync(GameLoop), null, 0, 16);
        }
    }
    
    private async Task GameLoop()
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var dt = (now - _lastFrameTime) / 1000.0;
        _lastFrameTime = now;
        
        // Update game state
        if (_mode == PoRunnerGameMode.Demo)
        {
            UpdateDemo(dt);
        }
        
        // Update animations
        UpdateAnimations(dt);
        
        // Update confetti
        UpdateConfetti(dt);
        
        // Update countdown
        if (_state.GameStatus == GameStatus.Countdown)
        {
            var timeLeft = _state.RaceStartTimeMs - now;
            if (timeLeft > 0)
            {
                _countdownValue = (int)Math.Ceiling(timeLeft / 1000.0);
            }
            else
            {
                _state.GameStatus = GameStatus.Playing;
                _countdownValue = 0;
            }
        }
        
        // Update elapsed time
        if (_state.GameStatus == GameStatus.Playing)
        {
            _elapsedTime = Math.Max(0, (now - _state.RaceStartTimeMs) / 1000.0);
            
            // Check for race timeout
            var raceElapsed = now - _state.RaceStartTimeMs;
            if (raceElapsed >= PoRunnerConstants.MaxRaceDurationMs && string.IsNullOrEmpty(_state.FinishedPlayerId))
            {
                HandleRaceTimeout();
            }
        }
        
        await InvokeAsync(StateHasChanged);
    }
    
    private void InitializeLocalPlayers()
    {
        _state.ConnectionId = "local_p1";
        _state.ServerPlayers["local_p1"] = new ServerPlayer
        {
            Id = "local_p1",
            X = PoRunnerConstants.StartLineX,
            Y = 4,
            Direction = PlayerDirection.East,
            Action = PlayerAction.Idle,
            ColorTint = "yellow",
            IsReady = true
        };
        
        if (_mode == PoRunnerGameMode.TwoPlayer)
        {
            _state.ServerPlayers["local_p2"] = new ServerPlayer
            {
                Id = "local_p2",
                X = PoRunnerConstants.StartLineX,
                Y = 5,
                Direction = PlayerDirection.East,
                Action = PlayerAction.Idle,
                ColorTint = "blue",
                IsReady = true
            };
        }
        
        _state.GameStatus = GameStatus.Waiting;
    }
    
    private void StartDemo()
    {
        _state.DemoMode = true;
        _state.ConnectionId = "demo_0";
        _state.ServerPlayers.Clear();
        
        var colors = new[] { "yellow", "blue", "red", "green", "purple", "orange", "pink", "teal" };
        var random = new Random();
        
        for (int i = 0; i < PoRunnerConstants.DemoBotCount; i++)
        {
            var id = $"demo_{i}";
            var baseSpeed = PoRunnerConstants.DemoSpeedMin + random.NextDouble() * (PoRunnerConstants.DemoSpeedMax - PoRunnerConstants.DemoSpeedMin);
            var startX = PoRunnerConstants.StartLineX - random.NextDouble() * 30;
            
            _bots.Add(new DemoBot
            {
                Id = id,
                BaseSpeed = baseSpeed,
                CurrentSpeed = baseSpeed,
                BurstTimer = random.NextDouble() * PoRunnerConstants.DemoBurstInterval,
                Finished = false
            });
            
            _state.ServerPlayers[id] = new ServerPlayer
            {
                Id = id,
                X = startX,
                Y = i,
                Direction = PlayerDirection.East,
                Action = PlayerAction.Walk,
                ColorTint = colors[i % colors.Length],
                IsReady = true
            };
        }
        
        StartCountdown();
    }
    
    private void StartCountdown()
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        _state.CountdownStartTimeMs = now;
        _state.RaceStartTimeMs = now + PoRunnerConstants.CountdownDurationMs;
        _state.GameStatus = GameStatus.Countdown;
        _countdownValue = 3;
    }
    
    private void StartLocalRace()
    {
        if (_state.GameStatus != GameStatus.Waiting && _state.GameStatus != GameStatus.ReadyCheck)
            return;
        
        // Reset player positions
        if (_state.ServerPlayers.TryGetValue("local_p1", out var p1))
            p1.X = PoRunnerConstants.StartLineX;
        if (_state.ServerPlayers.TryGetValue("local_p2", out var p2))
            p2.X = PoRunnerConstants.StartLineX;
        
        _state.LocalSprite = new LocalSprite();
        _state.LocalSprite2 = new LocalSprite();
        _state.LocalCrossedFinish = false;
        _state.LocalCrossedFinish2 = false;
        _state.FinishedPlayerId = "";
        _state.QualifiesForHighScore = _mode == PoRunnerGameMode.OnePlayer;
        
        StartCountdown();
    }
    
    private void ResetRace()
    {
        _state.GameStatus = GameStatus.Waiting;
        _state.FinishedPlayerId = "";
        _state.LastRaceTimeMs = 0;
        _state.RaceTimedOut = false;
        _state.ConfettiParticles.Clear();
        _state.GameOverAnim = null;
        _state.CountdownGunFired = false;
        _state.CameraX = 0;
        _state.HintDismissed = false;
        _state.LeaderboardExpanded = false;
        
        if (_state.ServerPlayers.TryGetValue("local_p1", out var p1))
            p1.X = PoRunnerConstants.StartLineX;
        if (_state.ServerPlayers.TryGetValue("local_p2", out var p2))
            p2.X = PoRunnerConstants.StartLineX;
    }
    
    private void UpdateDemo(double dt)
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        
        // Auto restart
        if (_state.GameStatus == GameStatus.GameOver && _demoAutoRestartAt > 0 && now >= _demoAutoRestartAt)
        {
            var animDone = _state.GameOverAnim?.Done ?? true;
            if (animDone)
            {
                _bots.Clear();
                _state.ConfettiParticles.Clear();
                _state.GameOverAnim = null;
                StartDemo();
                return;
            }
        }
        
        // Start race
        if (_state.GameStatus == GameStatus.Countdown && now >= _state.RaceStartTimeMs)
        {
            _state.GameStatus = GameStatus.Playing;
        }
        
        if (_state.GameStatus != GameStatus.Playing)
            return;
        
        var raceElapsedMs = now - _state.RaceStartTimeMs;
        
        foreach (var bot in _bots)
        {
            if (bot.Finished) continue;
            
            var player = _state.ServerPlayers[bot.Id];
            
            bot.BurstTimer -= dt;
            if (bot.BurstTimer <= 0)
            {
                bot.BurstTimer = PoRunnerConstants.DemoBurstInterval * (0.5 + new Random().NextDouble());
                var variance = 1 + (new Random().NextDouble() * 2 - 1) * PoRunnerConstants.DemoBurstVariance;
                bot.CurrentSpeed = bot.BaseSpeed * variance;
            }
            
            player.X += bot.CurrentSpeed * dt;
            
            // Animation
            bot.FrameTimer += dt;
            if (bot.FrameTimer >= 1 / 12.0)
            {
                bot.FrameTimer -= 1 / 12.0;
                var maxFrames = player.ColorTint == "blue" ? PoRunnerConstants.TPoseWalkFrames : PoRunnerConstants.BananaWalkFrames;
                bot.WalkFrame = (bot.WalkFrame + 1) % maxFrames;
            }
            player.CurrentFrame = bot.WalkFrame;
            
            // Finish check
            if (player.X >= _state.FinishLineX)
            {
                player.X = _state.FinishLineX;
                player.Action = PlayerAction.Idle;
                bot.Finished = true;
                
                if (string.IsNullOrEmpty(_state.FinishedPlayerId))
                {
                    HandleFinish(bot.Id, raceElapsedMs);
                    _demoAutoRestartAt = now + PoRunnerConstants.DemoAutoRestartDelayMs;
                    return;
                }
            }
        }
        
        // Timeout check
        if (string.IsNullOrEmpty(_state.FinishedPlayerId) && raceElapsedMs >= PoRunnerConstants.MaxRaceDurationMs)
        {
            var leader = _bots.OrderByDescending(b => _state.ServerPlayers[b.Id]?.X ?? 0).FirstOrDefault();
            if (leader != null)
            {
                HandleTimeout(leader.Id);
                _demoAutoRestartAt = now + PoRunnerConstants.DemoAutoRestartDelayMs;
            }
        }
    }
    
    private void UpdateAnimations(double dt)
    {
        // P1 sprite animation
        if (_state.LocalSprite.Action == PlayerAction.Walk)
        {
            _state.LocalSprite.FrameTimer += dt;
            if (_state.LocalSprite.FrameTimer > 1 / PoRunnerConstants.WalkFps)
            {
                _state.LocalSprite.Frame++;
                if (_state.LocalSprite.Frame >= PoRunnerConstants.BananaWalkFrames)
                {
                    _state.LocalSprite.Frame = 0;
                    _state.LocalSprite.Action = PlayerAction.Idle;
                }
                _state.LocalSprite.FrameTimer = 0;
            }
        }
        
        // P2 sprite animation
        if (_state.LocalSprite2.Action == PlayerAction.Walk)
        {
            _state.LocalSprite2.FrameTimer += dt;
            if (_state.LocalSprite2.FrameTimer > 1 / PoRunnerConstants.WalkFps)
            {
                _state.LocalSprite2.Frame++;
                if (_state.LocalSprite2.Frame >= PoRunnerConstants.BananaWalkFrames)
                {
                    _state.LocalSprite2.Frame = 0;
                    _state.LocalSprite2.Action = PlayerAction.Idle;
                }
                _state.LocalSprite2.FrameTimer = 0;
            }
        }
        
        // Camera update
        UpdateCamera();
        
        // Game over animation
        if (_state.GameOverAnim != null && !_state.GameOverAnim.Done)
        {
            _state.GameOverAnim.SpriteX += PoRunnerConstants.GameOverWalkSpeed * dt;
            var targetX = _state.WorldWidth * PoRunnerConstants.WinnerXRatio;
            if (_state.GameOverAnim.SpriteX >= targetX)
            {
                _state.GameOverAnim.SpriteX = targetX;
                _state.GameOverAnim.Done = true;
            }
            
            _state.GameOverAnim.FrameTimer += dt;
            if (_state.GameOverAnim.FrameTimer > 1 / 12.0)
            {
                var maxFrames = _state.GameOverAnim.WinnerIsTPose ? PoRunnerConstants.TPoseWalkFrames : PoRunnerConstants.BananaWalkFrames;
                _state.GameOverAnim.Frame = (_state.GameOverAnim.Frame + 1) % maxFrames;
                _state.GameOverAnim.FrameTimer = 0;
            }
        }
    }
    
    private void UpdateCamera()
    {
        var targetX = 0.0;
        
        if (_state.ServerPlayers.TryGetValue(_state.ConnectionId ?? "", out var localPlayer))
        {
            targetX = Math.Max(0, localPlayer.X - 400); // canvas.width / 3 ~= 400
        }
        
        var maxPanX = Math.Max(0, _state.FinishLineX - 800 + 300); // Estimate canvas width
        targetX = Math.Min(targetX, maxPanX);
        
        if (Math.Abs(targetX - _state.CameraX) > PoRunnerConstants.CameraSnapThreshold)
        {
            _state.CameraX = targetX;
        }
        else
        {
            _state.CameraX += (targetX - _state.CameraX) * PoRunnerConstants.CameraLerp;
        }
    }
    
    private void UpdateConfetti(double dt)
    {
        for (int i = _state.ConfettiParticles.Count - 1; i >= 0; i--)
        {
            var p = _state.ConfettiParticles[i];
            p.X += p.Vx;
            p.Y += p.Vy;
            p.Rotation += p.RotationSpeed;
            p.Vy += 0.05;
            p.Life -= p.Decay;
            
            if (p.Life <= 0)
                _state.ConfettiParticles.RemoveAt(i);
        }
    }
    
    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (_state.DemoMode && (_state.GameStatus == GameStatus.Playing || _state.GameStatus == GameStatus.Countdown))
        {
            // Exit demo on any key
            return;
        }
        
        if (e.Key == "Enter" && (_mode == PoRunnerGameMode.OnePlayer || _mode == PoRunnerGameMode.TwoPlayer))
        {
            if (_state.GameStatus == GameStatus.Waiting || _state.GameStatus == GameStatus.ReadyCheck)
            {
                StartLocalRace();
            }
            return;
        }
        
        if (_state.GameStatus != GameStatus.Playing)
            return;
        
        var key = e.Key.ToLower()[0];
        
        // P2 combo
        if (_mode == PoRunnerGameMode.TwoPlayer)
        {
            if (key == PoRunnerConstants.ComboP2[_state.ComboIndex2])
            {
                _state.ComboIndex2++;
                if (_state.ComboIndex2 >= PoRunnerConstants.ComboP2.Length)
                {
                    _state.ComboIndex2 = 0;
                    MovePlayer("local_p2", _state.LocalSprite2, true);
                }
            }
            else if (char.IsLetter(key) && key != PoRunnerConstants.ComboP1[_state.ComboIndex])
            {
                _state.ComboIndex2 = 0;
            }
        }
        
        // P1 combo
        if (key == PoRunnerConstants.ComboP1[_state.ComboIndex])
        {
            _state.ComboIndex++;
            if (_state.ComboIndex >= PoRunnerConstants.ComboP1.Length)
            {
                _state.ComboIndex = 0;
                MovePlayer(_state.ConnectionId ?? "local_p1", _state.LocalSprite, false);
            }
        }
        else if (char.IsLetter(key))
        {
            _state.ComboIndex = 0;
            // Flash red effect could be added via JS
        }
        
        StateHasChanged();
    }
    
    private void MovePlayer(string playerId, LocalSprite sprite, bool isP2)
    {
        if (!_state.ServerPlayers.TryGetValue(playerId, out var player))
            return;
        
        player.X += PoRunnerConstants.JumpPixels;
        player.Action = PlayerAction.Walk;
        player.CurrentFrame = 0;
        
        sprite.Action = PlayerAction.Walk;
        sprite.Frame = 0;
        sprite.FrameTimer = 0;
        
        _state.HintDismissed = true;
        
        // Finish check
        if (player.X >= _state.FinishLineX)
        {
            player.X = _state.FinishLineX;
            var finishTime = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - _state.RaceStartTimeMs;
            
            if (isP2)
            {
                _state.LocalCrossedFinish2 = true;
                _state.LocalFinishTimeMs2 = finishTime;
            }
            else
            {
                _state.LocalCrossedFinish = true;
                _state.LocalFinishTimeMs = finishTime;
            }
            
            HandleFinish(playerId, finishTime);
        }
    }
    
    private void HandleFinish(string playerId, long raceTimeMs)
    {
        _state.FinishedPlayerId = playerId;
        _state.LastRaceTimeMs = raceTimeMs;
        _state.RaceTimedOut = false;
        _state.GameStatus = GameStatus.GameOver;
        
        SpawnConfetti();
        
        var winner = _state.ServerPlayers[playerId];
        var loser = _state.ServerPlayers.Values.FirstOrDefault(p => p.Id != playerId);
        
        _state.GameOverAnim = new GameOverAnim
        {
            SpriteX = -300,
            Frame = 0,
            WinnerIsTPose = winner.ColorTint == "blue",
            LoserIsTPose = loser?.ColorTint == "blue",
            LoserExists = loser != null
        };
        
        _winnerText = $"{winner.ColorTint.ToUpper()} WINS!";
        _isLocalWin = playerId == _state.ConnectionId;
        _lastRaceTimeMs = raceTimeMs;
        
        // Save last played game (UX 10)
        _gameStats.SaveLastPlayedGame("porunner");
        
        if (_mode == PoRunnerGameMode.OnePlayer)
        {
            _state.QualifiesForHighScore = true;
            
            // Record result for stats
            _ = _gameStats.RecordResult("porunner", PlayerNameService.GetPlayerName(), Difficulty.Medium, GameResult.Win);
            UpdateStats();
        }
    }
    
    private void HandleRaceTimeout()
    {
        var leader = _state.ServerPlayers.Values.OrderByDescending(p => p.X).FirstOrDefault();
        if (leader != null)
        {
            HandleTimeout(leader.Id);
        }
    }
    
    private void HandleTimeout(string playerId)
    {
        _state.FinishedPlayerId = playerId;
        _state.LastRaceTimeMs = PoRunnerConstants.MaxRaceDurationMs;
        _state.RaceTimedOut = true;
        _state.GameStatus = GameStatus.GameOver;
        
        SpawnConfetti();
        
        var winner = _state.ServerPlayers[playerId];
        var loser = _state.ServerPlayers.Values.FirstOrDefault(p => p.Id != playerId);
        
        _state.GameOverAnim = new GameOverAnim
        {
            SpriteX = -300,
            Frame = 0,
            WinnerIsTPose = winner.ColorTint == "blue",
            LoserIsTPose = loser?.ColorTint == "blue",
            LoserExists = loser != null
        };
        
        _winnerText = "TIME'S UP!";
        _isLocalWin = false;
        _lastRaceTimeMs = PoRunnerConstants.MaxRaceDurationMs;
        
        // Record result for stats
        _ = _gameStats.RecordResult("porunner", PlayerNameService.GetPlayerName(), Difficulty.Medium, GameResult.Loss);
        UpdateStats();
    }
    
    private void SpawnConfetti()
    {
        var random = new Random();
        for (int i = 0; i < PoRunnerConstants.ConfettiCount; i++)
        {
            _state.ConfettiParticles.Add(new ConfettiParticle
            {
                X = random.NextDouble() * 800, // Approximate canvas width
                Y = random.NextDouble() * 300,
                Vx = (random.NextDouble() - 0.5) * 5,
                Vy = random.NextDouble() * 3 + 1,
                Color = PoRunnerConstants.ConfettiColors[random.Next(PoRunnerConstants.ConfettiColors.Length)],
                Width = random.NextDouble() * 14 + 4,
                Height = random.NextDouble() * 7 + 3,
                Rotation = random.NextDouble() * Math.PI * 2,
                RotationSpeed = (random.NextDouble() - 0.5) * 0.15,
                Life = 1.0,
                Decay = random.NextDouble() * 0.004 + 0.002
            });
        }
    }
    
