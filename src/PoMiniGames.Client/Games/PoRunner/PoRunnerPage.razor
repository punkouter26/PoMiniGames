    private bool IsLobbyVisible => _state.GameStatus == GameStatus.Waiting || _state.GameStatus == GameStatus.ReadyCheck;
    private bool IsCountdownVisible => _state.GameStatus == GameStatus.Countdown;
    private bool IsPlayingVisible => _state.GameStatus == GameStatus.Playing;
    private bool IsGameOverVisible => _state.GameStatus == GameStatus.GameOver;
    private bool HasLocalPlayer => _state.ServerPlayers.ContainsKey(_state.ConnectionId ?? "");
    private bool ShouldShowHint => !_state.HintDismissed && _mode != PoRunnerGameMode.Demo;
    private bool HasStatsData => _profile.Wins > 0 || _profile.Losses > 0;
    private bool ShouldShowInitialsForm => _state.QualifiesForHighScore && 
        (DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() >= _state.InitialsFormAvailableAtMs);
    
    private string GetPlayerBadgeLabel()
    {
        if (_state.ServerPlayers.TryGetValue(_state.ConnectionId ?? "", out var player))
        {
            return $"YOU ARE: {player.ColorTint.ToUpper()}";
        }
        return "";
    }
    
    private string GetLobbyStatusText()
    {
        return _mode switch
        {
            PoRunnerGameMode.OnePlayer => "Press Enter to race solo!",
            PoRunnerGameMode.TwoPlayer => "P1 (T-Y-G-H) vs P2 (Q-W-E-R) — Press Enter!",
            PoRunnerGameMode.Multiplayer => _opponentJoined ? "Opponent found! Press READY." : "Looking for an opponent…",
            PoRunnerGameMode.Demo => "Demo mode active",
            _ => ""
        };
    }
    
    private string GetComboClass(int index) => index == _state.ComboIndex ? "next" : "";
    private string GetComboClass2(int index) => index == _state.ComboIndex2 ? "next" : "";
    
    private string GetMedal(int rank) => rank switch
    {
        1 => "🥇",
        2 => "🥈",
        3 => "🥉",
        _ => $"#{rank}"
    };
    
    private string GetLeaderboardRowClass(HighScoreEntry score)
    {
        var classes = new List<string>();
        if (score.Rank == 1) classes.Add("pr-gold");
        else if (score.Rank == 2) classes.Add("pr-silver");
        else if (score.Rank == 3) classes.Add("pr-bronze");
        
        if (_isLocalWin && _lastRaceTimeMs > 0 && score.TimeMs == _lastRaceTimeMs)
            classes.Add("pr-new");
        
        return string.Join(" ", classes);
    }
    
