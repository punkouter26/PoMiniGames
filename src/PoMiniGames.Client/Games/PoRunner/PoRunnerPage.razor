            _initials[index] = letter;
            if (!string.IsNullOrEmpty(letter) && index < 2)
            {
                // Focus next input via JS
            }
        }
    }
    
    private void SubmitInitials()
    {
        var initials = string.Join("", _initials).ToUpper();
        if (initials.Length != 3) return;
        
        // Add to leaderboard
        var newEntry = new HighScoreEntry
        {
            Rank = _topScores.Count + 1,
            TimeMs = _lastRaceTimeMs,
            Initials = initials
        };
        _topScores.Add(newEntry);
        _topScores = _topScores.OrderBy(s => s.TimeMs).Take(10).ToList();
        
        // Update ranks
        for (int i = 0; i < _topScores.Count; i++)
            _topScores[i].Rank = i + 1;
        
        _state.QualifiesForHighScore = false;
        _initials = ["", "", ""];
    }
    
