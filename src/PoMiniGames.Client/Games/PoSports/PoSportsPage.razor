@page "/posports"
@page "/posports/{Mode}"
@page "/posports/race/{Code}"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Enums
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@using PoMiniGamesClient.Games.PoSports.Services
@using PoMiniGames.Shared.Games
@* Alias, not a namespace import — PoMiniGamesClient.Models mirrors other Domain types by name. *@
@using PoSportsHighScore = PoMiniGames.Domain.Models.PoSportsHighScore
@implements IAsyncDisposable
@inject PlayerNameService PlayerNameService
@inject GameResultService GameResults
@inject IJSRuntime JSRuntime
@inject KioskCoordinator Kiosk
@inject PoSportsHubService Hub
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject ToastService ToastService

<GameShell Title=@TitleContent
           Player="@_playerName"
           BackTo="/"
           Stats="@_statItems"
           GameOver="@(_phase == "podium" && !_demo)"
           GameKey="@(_mode == "1p" ? "posports" : null)"
           GameSummary="@GameSummaryContent">
    @if (!_introDone)
    {
        <GameIntro Title="@TitleContent"
                   Objective="@IntroObjective"
                   Controls="@HowToPlayContent"
                   Mode="@_introMode"
                   Options="@SelectContent"
                   StartEnabled="@(_demo || _mode != "2p" || (_p1Locked && _p2Locked))"
                   StartLabel="@(_mode == "2p" ? "RACE" : "OK")"
                   StartHint="@(_mode == "2p" ? "Both players lock in to race" : null)"
                   CaptureKeys="@(_mode == "2p")"
                   OnKey="OnIntroKey"
                   OnStart="OnIntroStartAsync" />
    }
    <div class="ps-wrap">
        <div id="posports-container" class="ps-canvas-host"></div>

        @if (_demo)
        {
            <div class="ps-demo-badge">🎮 Demo — CPU family race</div>
        }

        @* Meet HUD: per-human sequence progress + leg clock, fed by game.js OnHud. *@
        @if (_phase == "racing" || _phase == "interstitial" || _phase == "countdown")
        {
            <div class="ps-hud">
                <div class="ps-hud-leg">@(_leg == "hurdles" ? "🚧 110m Hurdles" : "🏃 100m Sprint")</div>
                <div class="ps-hud-clock">@_clock.ToString("0.0")s</div>
                @foreach (var lane in _humanLanes)
                {
                    <div class="ps-hud-player">
                        <span class="ps-hud-name">@lane.Name</span>
                        <span class="ps-seq" aria-label="Key sequence progress">
                            @for (var k = 0; k < 4; k++)
                            {
                                var idx = k;
                                <kbd class="ps-seq-key @(idx < lane.SeqProgress ? "ps-seq-key--hit" : "") @(idx == lane.SeqProgress ? "ps-seq-key--next" : "")">
                                    @lane.Keys[idx]
                                </kbd>
                            }
                            <kbd class="ps-seq-key ps-seq-key--jump">@lane.JumpKey</kbd>
                        </span>
                        <span class="ps-hud-meters">@lane.Position.ToString("0")m</span>
                    </div>
                }
            </div>
        }
    </div>
</GameShell>

@code {
    /// <summary>Route mode segment: "1player" | "2player" | "demo" ("1" is the legacy demo form).</summary>
    [Parameter] public string? Mode { get; set; }
    /// <summary>Race code from the lobby's gameStarted broadcast — presence selects online mode.</summary>
    [Parameter] public string? Code { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }

    /// <summary>Lane setup passed to PoSports.init — lower-case members to match the JS shape.</summary>
    private sealed record PlayerSetup(string character, string name, bool human, int? layout);

    /// <summary>The shared roster — declared once in PoShared, rendered by both PoSports pages.</summary>
    private static IReadOnlyList<PoSportsCharacter> Roster => PoSportsRoster.All;

    private sealed class HudLane
    {
        public string Name = "";
        public IReadOnlyList<string> Keys = PoSportsLayouts.For(1).Sequence;
        public string JumpKey = PoSportsLayouts.For(1).Jump;
        public int SeqProgress;
        public double Position;
    }

    private string _playerName = "";
    private bool _demo;
    private string _mode = "1p";
    private bool _introDone;
    private string _phase = "loading";   // loading | countdown | racing | interstitial | podium
    private string _leg = "sprint";
    private double _clock;
    private List<HudLane> _humanLanes = [];
    /// <summary>Online: the lane index the server bound to this connection (-1 = spectator).</summary>
    private int _myLane = -1;
    /// <summary>Mirrors HUD_THROTTLE_MS in game.js — one HUD cadence for both modes.</summary>
    private const double HudRenderIntervalMs = 250;
    private DateTime _lastHudRender = DateTime.MinValue;
    private List<StatItem> _statItems = [];
    private readonly GameStatsService _gameStats = new();
    private PlayerStats _stats = new();
    private DotNetObjectReference<PoSportsPage>? _ref;

    // Character select state. 1P: click a portrait. 2P: two keyboard cursors —
    // P1 cycles with Q/W and locks with S; P2 cycles with I/O and locks with L
    // (each player's own sequence keys, so the select teaches the controls).
    private int _p1Sel;
    private int _p2Sel = 1;
    private bool _p1Locked;
    private bool _p2Locked;

    // Podium results (from JS OnMeetDone).
    private sealed record MeetResult(int Lane, string Name, string Character, bool Human,
        double SprintSeconds, double HurdlesSeconds, double TotalSeconds, int Placing);
    private List<MeetResult> _results = [];
    private bool _submittedThisMeet;
    private bool _newRecord;
    private double _bestTotal;

    private GameIntro.IntroMode _introMode => _demo
        ? GameIntro.IntroMode.Demo
        : _mode == "2p" ? GameIntro.IntroMode.TwoPlayer : GameIntro.IntroMode.OnePlayer;

    private string IntroObjective => _mode switch
    {
        "2p" => "Two runners, one track: sprint then hurdles, lowest combined time wins. Pick your family member below.",
        _ => "A two-leg family track meet: 100m sprint, then 110m hurdles. Lowest combined time tops the board.",
    };

    private RenderFragment TitleContent => @<span>🏃 Sports</span>;

    @* Key labels come from PoSportsLayouts so rebinding input.js can't leave the tutorial
       teaching keys that no longer do anything. *@
    private RenderFragment HowToPlayContent => @<div>
        <p>Type your four keys <b>in order</b> to sprint — every completed cycle is a burst of speed. A wrong key restarts the cycle!</p>
        <ul>
            @foreach (var l in PoSportsLayouts.All)
            {
                <li>
                    Player @l.Layout:
                    @foreach (var k in l.Sequence)
                    {
                        <kbd>@k</kbd><text> </text>
                    }
                    in order · <kbd>@l.Jump</kbd> jumps
                </li>
            }
            <li>Jump the hurdles on leg 2 — clipping one costs speed and +1.5s</li>
            <li>Typing before the gun is a false start: half-second hold</li>
        </ul>
    </div>;

    private RenderFragment SelectContent => _mode == "2p" ? TwoPlayerSelect : OnePlayerSelect;

    // The 2P roster cursor reuses each player's own sequence keys, so the select screen
    // teaches the controls: first two keys cycle, the last one locks in.
    private static string SelectHint(int layout)
    {
        var l = PoSportsLayouts.For(layout);
        return $"{l.Sequence[0]} / {l.Sequence[1]} cycle · {l.Sequence[3]} lock in";
    }

    /// <summary>KeyboardEvent.code for a layout's Nth sequence key ("Q" → "KeyQ").</summary>
    private static string SelectCode(int layout, int index) => "Key" + PoSportsLayouts.For(layout).Sequence[index];

    private RenderFragment OnePlayerSelect => @<div class="ps-select-grid" role="listbox" aria-label="Choose your runner">
        @for (var i = 0; i < Roster.Count; i++)
        {
            var idx = i;
            <button type="button"
                    class="ps-select-card @(idx == _p1Sel ? "ps-select-card--picked" : "")"
                    @onclick="() => { _p1Sel = idx; }">
                <span class="ps-select-emoji">@Roster[idx].Emoji</span>
                <span>@Roster[idx].Name</span>
            </button>
        }
    </div>;

    private RenderFragment TwoPlayerSelect => @<div class="gps-intro-versus">
        <div>
            <div class="gps-intro-side-title">Player 1</div>
            <div class="gps-intro-side-keys">@SelectHint(1)</div>
            <ul class="gps-intro-roster">
                @for (var i = 0; i < Roster.Count; i++)
                {
                    var idx = i;
                    <li class="gps-intro-roster-item @(idx == _p1Sel ? "gps-intro-roster-item--cursor" : "") @(_p1Locked && idx == _p1Sel ? "gps-intro-roster-item--locked" : "")">
                        @Roster[idx].Emoji @Roster[idx].Name
                    </li>
                }
            </ul>
            <div class="gps-intro-ready">@(_p1Locked ? "✓ Ready" : "")</div>
        </div>
        <div class="gps-intro-vs-divider">VS</div>
        <div>
            <div class="gps-intro-side-title">Player 2</div>
            <div class="gps-intro-side-keys">@SelectHint(2)</div>
            <ul class="gps-intro-roster">
                @for (var i = 0; i < Roster.Count; i++)
                {
                    var idx = i;
                    <li class="gps-intro-roster-item @(idx == _p2Sel ? "gps-intro-roster-item--cursor" : "") @(_p2Locked && idx == _p2Sel ? "gps-intro-roster-item--locked" : "")">
                        @Roster[idx].Emoji @Roster[idx].Name
                    </li>
                }
            </ul>
            <div class="gps-intro-ready">@(_p2Locked ? "✓ Ready" : "")</div>
        </div>
    </div>;

    private RenderFragment GameSummaryContent => @<div>
        @foreach (var r in _results.OrderBy(x => x.Placing))
        {
            <div>
                @(r.Placing switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => $"{r.Placing}th" })
                @r.Name — @r.TotalSeconds.ToString("0.00")s
                <small>(@r.SprintSeconds.ToString("0.0") + @r.HurdlesSeconds.ToString("0.0"))</small>
            </div>
        }
        @if (_newRecord)
        {
            <div>🏆 New personal best!</div>
        }
    </div>;

    protected override void OnInitialized()
    {
        _demo = Mode is "demo" or "1";
        _mode = !string.IsNullOrEmpty(Code) ? "online"
              : _demo ? "demo"
              : (string.Equals(Mode, "2player", StringComparison.OrdinalIgnoreCase) || ModeQuery == "2p") ? "2p"
              : "1p";
        _playerName = PlayerNameService.GetPlayerName();
        _stats = _gameStats.GetStats("posports", _playerName);
        UpdateStats();
        if (_demo) Kiosk.SetCurrent("posports-demo");
        if (_mode == "online") _introDone = true; // characters were picked in the lobby
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        // Online mode skips the intro — characters were picked in the lobby, so the
        // page joins the meet the moment it can talk to JS.
        if (_mode == "online")
        {
            await InitOnlineAsync();
        }
    }

    // ── Online (server-authoritative) mode ────────────────────────────────

    private async Task InitOnlineAsync()
    {
        Hub.SnapshotReceived += OnServerSnapshot;
        Hub.RaceFinished += OnServerFinished;

        var join = await Hub.JoinRaceAsync(Code!, asPlayer: true);
        if (join is null)
        {
            // No joinable meet (none started, or the last one already finished): the lobby is
            // where a new one begins, so don't strand the player on a track that will never run.
            ToastService.Show("That meet has finished — back to the lobby.", ToastType.Info);
            Nav.NavigateTo("/posports/multi");
            return;
        }

        var snap = join.Snapshot;
        // The server tells us which lane we own; identifying ourselves by name matching
        // bound the HUD to whichever runner happened to be in lane 0.
        _myLane = join.Lane;

        // Lanes come from the server; the JS engine renders them as ghosts driven
        // by snapshots. All lanes are human:false locally — no local trackers/AI.
        var players = snap.Lanes
            .Select(l => new PlayerSetup(l.Character, l.Name, false, null))
            .ToList();
        var mine = snap.Lanes.FirstOrDefault(l => l.Lane == _myLane);
        var layout = PoSportsLayouts.For(1);
        _humanLanes =
        [
            new HudLane { Name = mine?.Name ?? _playerName, Keys = layout.Sequence, JumpKey = layout.Jump },
        ];

        try
        {
            // Route-gated engine load (see wwwroot/js/engineLoader.js).
            if (!await JSRuntime.InvokeAsync<bool>("loadEngine", "posports"))
            {
                Console.Error.WriteLine("[PoSports] engine failed to load");
                return;
            }

            await JSRuntime.InvokeVoidAsync("PoSports.init", "posports-container", _ref,
                new { mode = "online", players, layout = 1 });
            await JSRuntime.InvokeVoidAsync("PoSports.applySnapshot", snap);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[PoSports] online JS init failed: {ex.Message}");
        }
    }

    private void OnServerSnapshot(PoSportsSnapshot snap)
    {
        _ = ForwardSnapshotAsync(snap);
        // HUD: the lane the server bound to this connection at join time.
        var mine = snap.Lanes.FirstOrDefault(l => l.Lane == _myLane);
        if (mine is not null && _humanLanes.Count > 0)
        {
            _humanLanes[0].SeqProgress = mine.SeqProgress;
            _humanLanes[0].Position = mine.Position;
        }
        _clock = snap.Clock;
        _leg = snap.Phase == "hurdles" ? "hurdles" : "sprint";
        var phase = snap.Phase is "sprint" or "hurdles" ? "racing" : snap.Phase;
        var phaseChanged = phase != _phase;
        _phase = phase;

        // Snapshots land at 15 Hz but the HUD only shows a 0.1 s clock, whole meters, and
        // four progress dots — re-rendering the page that often just burns phone battery.
        // Match the local engine's 250 ms HUD cadence, and never delay a phase change.
        var now = DateTime.UtcNow;
        if (!phaseChanged && (now - _lastHudRender).TotalMilliseconds < HudRenderIntervalMs) return;
        _lastHudRender = now;
        InvokeAsync(StateHasChanged);
    }

    private async Task ForwardSnapshotAsync(PoSportsSnapshot snap)
    {
        try { await JSRuntime.InvokeVoidAsync("PoSports.applySnapshot", snap); } catch { }
    }

    private void OnServerFinished(PoSportsSnapshot final)
    {
        _results = [.. final.Lanes.Select(l => new MeetResult(
            l.Lane, l.Name, l.Character, !l.IsAi,
            l.SprintSeconds, l.HurdlesSeconds,
            l.SprintSeconds + l.HurdlesSeconds, l.Placing))];
        _phase = "podium";
        // The SERVER persisted online scores — no client submit here.
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Remote-mode key forwarder (game.js sends raw layout ordinals).</summary>
    [JSInvokable]
    public async Task OnRemoteKey(string kind, int step)
    {
        if (_mode != "online" || Code is null) return;
        if (kind == "jump") await Hub.SendJumpAsync(Code);
        else await Hub.SendSequenceKeyAsync(Code, step);
    }

    private void OnIntroKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (_mode != "2p" || _introDone) return;
        var n = Roster.Count;
        var code = e.Code;
        if (code == SelectCode(1, 0)) { if (!_p1Locked) _p1Sel = (_p1Sel - 1 + n) % n; }
        else if (code == SelectCode(1, 1)) { if (!_p1Locked) _p1Sel = (_p1Sel + 1) % n; }
        else if (code == SelectCode(1, 3)) { _p1Locked = !_p1Locked; }
        else if (code == SelectCode(2, 0)) { if (!_p2Locked) _p2Sel = (_p2Sel - 1 + n) % n; }
        else if (code == SelectCode(2, 1)) { if (!_p2Locked) _p2Sel = (_p2Sel + 1) % n; }
        else if (code == SelectCode(2, 3)) { _p2Locked = !_p2Locked; }
        else return;
        if (_p1Locked && _p2Locked) { _ = OnIntroStartAsync(); return; }
        StateHasChanged();
    }

    private async Task OnIntroStartAsync()
    {
        if (_introDone) return;
        // 2P: both players must pick different characters — bump P2 off a clash.
        if (_mode == "2p" && _p1Sel == _p2Sel)
        {
            _p2Sel = (_p2Sel + 1) % Roster.Count;
        }
        _introDone = true;
        StateHasChanged();
        await InitEngine();
    }

    private async Task InitEngine()
    {
        _results = [];
        _submittedThisMeet = false;
        _newRecord = false;

        var players = new List<PlayerSetup>();
        if (_demo)
        {
            // Attract mode: the whole family on the track, all CPU, in a random lane order.
            foreach (var p in Roster.OrderBy(_ => Guid.NewGuid()))
            {
                players.Add(new PlayerSetup(p.Key, p.Name, false, null));
            }
        }
        else if (_mode == "2p")
        {
            players.Add(new PlayerSetup(Roster[_p1Sel].Key, $"{Roster[_p1Sel].Name} (P1)", true, 1));
            players.Add(new PlayerSetup(Roster[_p2Sel].Key, $"{Roster[_p2Sel].Name} (P2)", true, 2));
        }
        else
        {
            players.Add(new PlayerSetup(Roster[_p1Sel].Key, _playerName, true, 1));
            // CPU rivals on every unpicked family member — a full four-lane meet.
            foreach (var p in Roster.Where((_, i) => i != _p1Sel).OrderBy(_ => Guid.NewGuid()))
            {
                players.Add(new PlayerSetup(p.Key, p.Name, false, null));
            }
        }

        _humanLanes = players
            .Where(p => p.human)
            .Select(p =>
            {
                var keys = PoSportsLayouts.For(p.layout);
                return new HudLane { Name = p.name, Keys = keys.Sequence, JumpKey = keys.Jump };
            })
            .ToList();

        try
        {
            // Route-gated engine load (see wwwroot/js/engineLoader.js).
            if (!await JSRuntime.InvokeAsync<bool>("loadEngine", "posports"))
            {
                Console.Error.WriteLine("[PoSports] engine failed to load");
                return;
            }

            await JSRuntime.InvokeVoidAsync("PoSports.init", "posports-container", _ref,
                new { mode = _mode, players, difficulty = "medium" });
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[PoSports] JS init failed: {ex.Message}");
        }
    }

    [JSInvokable]
    public void OnPhase(string phase, string leg)
    {
        _phase = phase;
        _leg = leg;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnHud(System.Text.Json.JsonElement hud)
    {
        _phase = hud.GetProperty("phase").GetString() ?? _phase;
        _leg = hud.GetProperty("leg").GetString() ?? _leg;
        _clock = hud.GetProperty("clock").GetDouble();
        // Human lanes are always FIRST in the players list (see InitEngine), so HUD
        // lane i maps straight onto _humanLanes[i].
        var lanes = hud.GetProperty("lanes");
        for (var i = 0; i < lanes.GetArrayLength() && i < _humanLanes.Count; i++)
        {
            var lane = lanes[i];
            if (!lane.TryGetProperty("seqProgress", out var sp)) continue;
            _humanLanes[i].SeqProgress = sp.GetInt32();
            _humanLanes[i].Position = lane.GetProperty("position").GetDouble();
        }
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnLegDone(string leg, double[] times)
    {
        // Interstitial banner comes from the JS overlay; nothing to do here yet.
    }

    [JSInvokable]
    public async Task OnMeetDone(System.Text.Json.JsonElement results)
    {
        _results = [.. results.EnumerateArray().Select(r => new MeetResult(
            r.GetProperty("lane").GetInt32(),
            r.GetProperty("name").GetString() ?? "",
            r.GetProperty("character").GetString() ?? "",
            r.GetProperty("human").GetBoolean(),
            r.GetProperty("sprintSeconds").GetDouble(),
            r.GetProperty("hurdlesSeconds").GetDouble(),
            r.GetProperty("totalSeconds").GetDouble(),
            r.GetProperty("placing").GetInt32()))];
        _phase = "podium";

        if (_mode == "1p" && !_submittedThisMeet)
        {
            _submittedThisMeet = true;
            var mine = _results.FirstOrDefault(r => r.Human);
            if (mine is not null)
            {
                _gameStats.SaveLastPlayedGame("posports");

                _newRecord = _bestTotal == 0 || mine.TotalSeconds < _bestTotal;
                if (_newRecord) _bestTotal = mine.TotalSeconds;

                // Through the shared record-and-submit flow: the server ratchets per player,
                // so a submit lost to a flaky connection loses the personal best for good
                // unless it is parked and replayed (and the player is told either way).
                _stats = await GameResults.RecordAndSubmitPoSportsAsync(
                    _playerName,
                    mine.Placing == 1 ? GameResult.Win : GameResult.Loss,
                    new PoSportsHighScore
                    {
                        PlayerName = _playerName,
                        SprintSeconds = Math.Round(mine.SprintSeconds, 2),
                        HurdlesSeconds = Math.Round(mine.HurdlesSeconds, 2),
                        TotalTimeSeconds = Math.Round(mine.TotalSeconds, 2),
                        Character = mine.Character,
                    });
                UpdateStats();
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateStats()
    {
        _statItems =
        [
            new StatItem { Label = "Meets", Value = _stats.TotalGames.ToString() },
            new StatItem { Label = "Wins", Value = _stats.TotalWins.ToString() },
            new StatItem { Label = "Win %", Value = _stats.TotalGames > 0 ? $"{(int)(_stats.WinRate * 100)}%" : "—" },
        ];
    }

    public async ValueTask DisposeAsync()
    {
        if (_mode == "online")
        {
            Hub.SnapshotReceived -= OnServerSnapshot;
            Hub.RaceFinished -= OnServerFinished;
            // Unsubscribing alone leaves the socket open and still in the server's race
            // group for the app's lifetime, decoding snapshots nobody listens to.
            try { await Hub.StopRaceAsync(); } catch { }
        }
        try { await JSRuntime.InvokeVoidAsync("PoSports.destroy"); } catch { }
        _ref?.Dispose();
    }
}
