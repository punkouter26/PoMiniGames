@page "/boot"
@layout PoSurvive.Client.Layout.PoSurviveLayout
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IDispatcher         Dispatcher
@inject IState<BootState>   BootState
@inject IInferenceService   InferenceService
@inject IConfiguration      Config
@inject IJSRuntime          JS
@inject NavigationManager   Nav
@inject LocalModelBootstrapService ModelBootstrap

<!-- Mock provider banner -->
@if (BootState.Value.IsMockProvider)
{
    <div class="mock-banner" data-testid="mock-banner">⚠ MOCK DATA — real LLM inference disabled</div>
}

<div class="boot-screen" data-testid="boot-screen" role="main" aria-label="Boot sequence">

    <h1 class="boot-screen__title">POSURVIVE v1.0</h1>
    <div class="boot-screen__stages" aria-label="Boot stages">
        <span class="boot-stage boot-stage--done">1. BOOT CORE</span>
        <span class="boot-stage @(BootState.Value.IsReady || BootState.Value.HasInferenceInitError ? "boot-stage--done" : "boot-stage--active")">2. VERIFY INFERENCE</span>
        <span class="boot-stage @(BootState.Value.IsReady || BootState.Value.HasInferenceInitError ? "boot-stage--active" : "")">3. ENTER COMMAND DECK</span>
    </div>

    <p class="boot-screen__line">* 64K RAM SYSTEM  10240 BYTES FREE *</p>
    <p class="boot-screen__line">INITIALISING INFERENCE ENGINE…</p>

    <p class="boot-screen__gpu-status" data-testid="gpu-status" aria-live="polite">
        GPU: @BootState.Value.GpuLabel
    </p>

    <p class="boot-screen__byte-counter" data-testid="byte-counter" aria-live="polite">
        @if (BootState.Value.TotalBytes > 0)
        {
            <text>@FormatBytes(BootState.Value.BytesLoaded) / @FormatBytes(BootState.Value.TotalBytes) bytes loaded</text>
        }
        else
        {
            <text>0 / 0 bytes</text>
        }
    </p>

    @if (BootState.Value.HasInferenceInitError)
    {
        <p class="boot-screen__error" data-testid="inference-failed" aria-live="assertive">INFERENCE INIT FAILED.</p>
        <p class="boot-screen__byte-counter" data-testid="inference-failed-detail" aria-live="polite">
            @(BootState.Value.InferenceInitError ?? "Inference init failed.")
        </p>
        <p class="boot-screen__enter">
            <button class="c64-btn" @onclick="UnlockAndProceed" data-testid="btn-continue-degraded">
                [ ENTER DEGRADED MODE ]
            </button>
        </p>
    }
    else if (BootState.Value.IsReady)
    {
        <p class="boot-screen__ready" data-testid="ready-prompt" aria-live="assertive">READY.</p>
        <p class="boot-screen__enter">
            <button class="c64-btn" @onclick="UnlockAndProceed" data-testid="btn-enter">
                [ CONTINUE TO COMMAND DECK ]
            </button>
        </p>
    }

</div>

@code {
    private bool _initialised;
    private bool _useCloudFallback;

    private string InferenceInitErrorDisplay
        => string.IsNullOrWhiteSpace(BootState.Value.InferenceInitError)
            ? "Inference init failed."
            : BootState.Value.InferenceInitError!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        BootState.StateChanged += OnBootStateChanged;
        _useCloudFallback = Config.GetValue("Inference:UseCloudFallback", false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!firstRender || _initialised)
            return;

        _initialised = true;

        var isMock = InferenceService is MockInferenceService;

        var providerKind = isMock ? "MOCK" : _useCloudFallback ? "REMOTE" : "LOCAL";
        var activeModelId = Config["Inference:ModelId"] ?? "Phi-4-mini-instruct-q4f16_1-MLC";
        var activeModelLabel = activeModelId;

        if (providerKind == "LOCAL")
        {
            var localOptions = ModelBootstrap.ReadLocalModelOptions();
            activeModelLabel = localOptions.FirstOrDefault(o => o.Id == activeModelId)?.Label ?? activeModelId;
        }

        Dispatcher.Dispatch(new InferenceConfiguredAction(
            ProviderKind: providerKind,
            ModelId: activeModelId,
            ModelLabel: activeModelLabel));

        // 1. Probe GPU
        var gpuResult = await ProbeGpuAsync();

        Dispatcher.Dispatch(new GpuProbeCompletedAction(
            GpuAvailable:  gpuResult.Available,
            GpuLabel:      gpuResult.Label,
            IsMockProvider: isMock));

        // 2. Load model (or skip for mock)
        if (isMock)
        {
            Dispatcher.Dispatch(new BootReadyAction());
        }
        else
        {
            await InitialiseWebLlmAsync();
        }
    }

    private void OnBootStateChanged(object? sender, EventArgs e)
    {
        if (BootState.Value.IsReady || BootState.Value.HasInferenceInitError)
        {
            StateHasChanged();
        }
    }

    private async Task UnlockAndProceed()
    {
        if (BootState.Value.HasInferenceInitError)
        {
            Dispatcher.Dispatch(new ContinueDegradedModeAction());
        }

        try { await JS.InvokeVoidAsync("audioEngine.unlockAudio"); } catch { }
        Nav.NavigateTo("/");
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private async Task<(bool Available, string Label)> ProbeGpuAsync()
    {
        try
        {
            var result = await JS.InvokeAsync<GpuProbeResult>("gpuProbe.checkGpu");
            return (result.Available, result.Label);
        }
        catch
        {
            return (false, "CPU FALLBACK");
        }
    }

    private async Task InitialiseWebLlmAsync()
    {
        try
        {
            var modelId = Config["Inference:ModelId"] ?? "Phi-4-mini-instruct-q4f16_1-MLC";
            var cdnUrl = Config["Inference:WebLlmCdnUrl"];
            var inferenceTimeoutMs = Config.GetValue("Inference:InferenceTimeoutMs", 15_000);
            var useJsonResponseFormat = Config.GetValue("Inference:UseJsonResponseFormat", false);
            var enableDiagnostics = Config.GetValue("Inference:EnableDiagnostics", true);
            var shortCircuitOnBackpressure = Config.GetValue("Inference:ShortCircuitOnBackpressure", true);
            var backpressureThreshold = Config.GetValue("Inference:BackpressureThreshold", 4);

            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("inferenceWorkerBridge.init", dotNetRef, modelId, cdnUrl, new
            {
                inferenceTimeoutMs,
                useJsonResponseFormat,
                enableDiagnostics,
                shortCircuitOnBackpressure,
                backpressureThreshold,
            });
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[WebLLM init] {ex.Message}");
            Dispatcher.Dispatch(new InferenceInitFailedAction(ex.Message));
        }
    }

    [JSInvokable]
    public void OnModelProgress(long bytesLoaded, long totalBytes)
        => Dispatcher.Dispatch(new ModelLoadProgressAction(bytesLoaded, totalBytes));

    [JSInvokable]
    public void OnModelReady()
        => Dispatcher.Dispatch(new BootReadyAction());

    [JSInvokable]
    public void OnModelInitError(string error)
        => Dispatcher.Dispatch(new InferenceInitFailedAction(error));

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1_073_741_824 => $"{bytes / 1_073_741_824.0:F1} GB",
        >= 1_048_576     => $"{bytes / 1_048_576.0:F1} MB",
        >= 1_024         => $"{bytes / 1_024.0:F1} KB",
        _                => $"{bytes} B",
    };

    // ── JS interop result DTOs ────────────────────────────────────────────────

    private sealed record GpuProbeResult(bool Available, string Label);
}