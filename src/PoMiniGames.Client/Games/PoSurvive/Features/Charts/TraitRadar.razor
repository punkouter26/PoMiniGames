@namespace PoMiniGamesClient.Games.PoSurvive.Features.Charts
@using PoShared.Simulation.Models
@inherits ComponentBase

@* Personality as one shape instead of five stacked bars.

   Five parallel meters answer "how predatory is this agent" but not "what KIND
   of agent is this" — comparing two rosters meant reading ten numbers. A radar
   gives each agent a silhouette you can recognise at a glance, in the same
   vertical space the five bars used.

   Single series, so no legend and no categorical palette: the axis labels carry
   identity and one hue does all the work. The numbers stay reachable — each
   vertex has a native tooltip, and the roster still lists the values as text. *@

<figure class="sv-radar" data-testid="trait-radar">
    <svg viewBox="0 0 120 120" role="img"
         aria-label="Trait profile: @string.Join(", ", Traits.Select(t => $"{t.Name} {Math.Round(t.Value * 100)} percent"))">

        @* Reference rings at 33/66/100% — the radar equivalent of gridlines. *@
        @foreach (var ring in new[] { 0.34, 0.67, 1.0 })
        {
            <polygon class="sv-radar__ring"
                     points="@string.Join(' ', Traits.Select((_, i) => Vertex(i, ring)))" />
        }

        @foreach (var (_, i) in Traits.Select((t, i) => (t, i)))
        {
            <line class="sv-radar__spoke"
                  x1="60" y1="60"
                  x2="@Cx(i, 1.0)" y2="@Cy(i, 1.0)" />
        }

        <polygon class="sv-radar__area"
                 points="@string.Join(' ', Traits.Select((t, i) => Vertex(i, t.Value)))" />

        @foreach (var (trait, i) in Traits.Select((t, i) => (t, i)))
        {
            <circle class="sv-radar__dot" cx="@Cx(i, trait.Value)" cy="@Cy(i, trait.Value)" r="2.4">
                <title>@trait.Name @Math.Round(trait.Value * 100)%</title>
            </circle>
            <SvgText Class="sv-radar__label" X="@Cx(i, 1.34)" Y="@Cy(i, 1.34)">@trait.Short</SvgText>
        }
    </svg>
</figure>

@code {
    [Parameter, EditorRequired] public AgentDto Agent { get; set; } = default!;

    private sealed record Trait(string Name, string Short, float Value);

    private IReadOnlyList<Trait> Traits =>
    [
        new("Predatory",  "PRE", Agent.Predatory),
        new("Scavenger",  "SCV", Agent.Scavenger),
        new("Paranoid",   "PAR", Agent.Paranoid),
        new("Altruistic", "ALT", Agent.Altruistic),
        new("Methodical", "MTH", Agent.Methodical),
    ];

    // Pentagon starting at 12 o'clock so PRE is always at the top and two agents'
    // silhouettes are directly comparable.
    private double Angle(int i) => (-Math.PI / 2) + (2 * Math.PI * i / 5);

    private string Cx(int i, double r) => ChartGeometry.N(60 + (44 * Math.Clamp(r, 0, 1.4) * Math.Cos(Angle(i))));
    private string Cy(int i, double r) => ChartGeometry.N(60 + (44 * Math.Clamp(r, 0, 1.4) * Math.Sin(Angle(i))));

    private string Vertex(int i, double r) => $"{Cx(i, r)},{Cy(i, r)}";
}
