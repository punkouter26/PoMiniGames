@* Evolution Tree — SVG visualization of DNA lineage (LLM-Powered Agent Evolution) *@
@using PoSurvive.Shared.Models

<div class="evolution-tree" data-testid="evolution-tree">
    <div class="evolution-tree__header">
        <span class="evolution-tree__title">EVOLUTION TREE</span>
    </div>

    @if (_nodes is null || _nodes.Count == 0)
    {
        <div class="evolution-tree__empty">
            <span>No evolution data yet. Run simulations to build lineages.</span>
        </div>
    }
    else
    {
        <div class="evolution-tree__viz">
            <svg width="100%" height="@(_treeHeight)" data-testid="evolution-tree-svg">
                @foreach (var node in _renderedNodes)
                {
                    @foreach (var child in node.Children)
                    {
                        <line x1="@node.Cx" y1="@node.Cy"
                              x2="@child.Cx" y2="@child.Cy"
                              style="stroke:var(--c64-green);stroke-width:1.5;stroke-opacity:0.5" />
                    }

                    var radius = node.IsRoot ? 28 : 22;
                    var fillColor = node.WinRate >= 0.7f ? "var(--c64-green)"
                                  : node.WinRate >= 0.4f ? "var(--c64-yellow)"
                                  : "var(--c64-red)";

                    <circle cx="@node.Cx" cy="@node.Cy" r="@radius"
                            fill="@fillColor" stroke="var(--c64-border)" stroke-width="2"
                            data-testid="evolution-node" />

                    @* We render text elements via full SVG XML string to avoid Blazor <text> tag issues *@
                }
                @((MarkupString)BuildSvgTextElements())
            </svg>
        </div>
    }
</div>

@code {
    [Parameter] public EvolutionTreeDto? Tree { get; set; }

    private List<EvolutionTreeNodeDto>? _nodes;
    private List<RenderNode> _renderedNodes = [];
    private int _treeHeight = 600;

    private class RenderNode
    {
        public string DnaId { get; set; } = "";
        public string Label { get; set; } = "";
        public int Generation { get; set; }
        public float WinRate { get; set; }
        public float Cx { get; set; }
        public float Cy { get; set; }
        public bool IsRoot { get; set; }
        public List<RenderNode> Children { get; set; } = [];
    }

    protected override void OnParametersSet()
    {
        if (Tree is null)
        {
            _nodes = null;
            return;
        }

        _nodes = Tree.Nodes;
        BuildLayout();
    }

    private void BuildLayout()
    {
        if (_nodes is null || _nodes.Count == 0) return;

        _renderedNodes = [];
        var allNodes = _nodes; // local capture

        // Build parent-child map
        var childMap = new Dictionary<string, List<EvolutionTreeNodeDto>>();
        foreach (var node in allNodes)
        {
            childMap[node.DnaId] = [];
        }
        foreach (var node in allNodes)
        {
            foreach (var childId in node.ChildrenIds)
            {
                var child = allNodes.FirstOrDefault(n => n.DnaId == childId);
                if (child is not null && childMap.ContainsKey(node.DnaId))
                    childMap[node.DnaId].Add(child);
            }
        }

        // Find root nodes (generation 0)
        var roots = allNodes
            .Where(n => n.Generation == 0)
            .OrderBy(n => n.DnaId)
            .ToList();

        if (roots.Count == 0)
            roots = allNodes.OrderBy(n => n.Generation).Take(1).ToList();

        var maxGen = allNodes.Max(n => n.Generation);
        var genSpacing = 140;
        var nodeSpacing = 80;
        var marginY = 60;

        _treeHeight = marginY * 2 + (maxGen + 1) * genSpacing;

        void LayoutNode(EvolutionTreeNodeDto dto, float x, float y, bool isRoot)
        {
            childMap.TryGetValue(dto.DnaId, out var children);
            var childList = children ?? [];
            var childRenderNodes = new List<RenderNode>();

            if (childList.Count > 0)
            {
                var childCount = childList.Count;
                var startX = x - (childCount - 1) * nodeSpacing / 2f;
                var childY = y + genSpacing;

                for (var i = 0; i < childCount; i++)
                {
                    var childX = startX + i * nodeSpacing;
                    LayoutNode(childList[i], childX, childY, false);
                }
            }

            var renderNode = new RenderNode
            {
                DnaId = dto.DnaId,
                Label = dto.Label,
                Generation = dto.Generation,
                WinRate = dto.WinRate,
                Cx = x,
                Cy = y,
                IsRoot = isRoot,
                Children = childRenderNodes
            };
            _renderedNodes.Add(renderNode);

            // Add children to this node's children list after they've been laid out
            if (childList.Count > 0)
            {
                foreach (var childDto in childList)
                {
                    var existing = _renderedNodes.FirstOrDefault(n => n.DnaId == childDto.DnaId);
                    if (existing is not null)
                        renderNode.Children.Add(existing);
                }
            }
        }

        var rootCount = roots.Count;
        var startRootX = rootCount == 1 ? 400f : 400f - (rootCount - 1) * nodeSpacing * 1.5f / 2f;

        for (var i = 0; i < rootCount; i++)
        {
            var rx = rootCount == 1 ? 400f : startRootX + i * nodeSpacing * 1.5f;
            LayoutNode(roots[i], rx, marginY, true);
        }
    }

    private string BuildSvgTextElements()
    {
        var sb = new System.Text.StringBuilder();
        foreach (var node in _renderedNodes)
        {
            var radius = node.IsRoot ? 28 : 22;
            var fontSize = node.IsRoot ? 10 : 8;

            // Label above node
            sb.Append("<text x='").Append(node.Cx).Append("' y='").Append(node.Cy - radius - 6)
              .Append("' text-anchor='middle' fill='var(--c64-fg)' font-family='monospace' font-size='10'>")
              .Append(System.Net.WebUtility.HtmlEncode(node.Label))
              .Append("</text>");

            // Win rate inside node
            sb.Append("<text x='").Append(node.Cx).Append("' y='").Append(node.Cy + 4)
              .Append("' text-anchor='middle' fill='#000' font-family='monospace' font-size='")
              .Append(fontSize).Append("' font-weight='bold'>")
              .Append((node.WinRate * 100).ToString("F0")).Append("%")
              .Append("</text>");

            // Generation below node
            sb.Append("<text x='").Append(node.Cx).Append("' y='").Append(node.Cy + radius + 12)
              .Append("' text-anchor='middle' fill='var(--c64-fg-dim)' font-family='monospace' font-size='8'>G")
              .Append(node.Generation).Append("</text>");
        }
        return sb.ToString();
    }
}