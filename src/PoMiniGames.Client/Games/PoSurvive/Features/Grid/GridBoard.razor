@using PoMiniGamesClient.Games.PoSurvive.Store
@using PoShared.Simulation.Models

@* T053: GridBoard renders 10×10 CSS Grid, dispatches God-Click actions *@
@inherits SurviveComponentBase
<div class="grid-board sv-grid-board" data-testid="grid-board"
     role="grid" aria-label="Simulation grid">

    @for (var row = 0; row < 10; row++)
    {
        for (var col = 0; col < 10; col++)
        {
            var x = col;
            var y = row;

            var isRock   = Store.Simulation.Rocks.Any(r => r.X == x && r.Y == y);
            var food     = Store.Simulation.FoodNodes.FirstOrDefault(f => f.X == x && f.Y == y);
            var agent    = Store.Simulation.Agents.FirstOrDefault(a => a.X == x && a.Y == y);
            var selected = Store.Simulation.SelectedAgentId;

            <GridTile X="@x" Y="@y"
                      IsRock="@isRock"
                      HasFood="@(food is not null)"
                      Agent="@agent"
                      IsSelected="@(agent is not null && agent.Id == selected)"
                      OnAgentClicked="@((id) => HandleTileClick(id))"
                      OnEmptyClicked="@(() => HandleEmptyClick())" />
        }
    }

</div>

@code {
    private void HandleTileClick(string agentId)
        => Store.SelectAgent(agentId);

    private void HandleEmptyClick()
        => Store.ClearSelection();
}
