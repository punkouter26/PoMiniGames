@using PoMiniGamesClient.Games.PoSurvive.Store
@using PoMiniGames.Shared.Simulation.Models

@inherits SurviveComponentBase
@inject DecisionInsightService InsightService

<section class="decision-inspector app-reveal" data-testid="decision-inspector">
    <div class="decision-inspector__header">
        @* h2, not h3 (2026-08-08 audit #9): the only heading above this on the
           PoSurvive page is the top bar's <h1>, so an h3 skipped a level and axe
           flagged heading-order. The class carries the visual size, so nothing
           moves — this is purely the outline level. *@
        <h2 class="decision-inspector__title">Why this move?</h2>
        <div class="decision-inspector__header-actions">
            @if (CurrentAgent is not null)
            {
                <button class="sv-btn sv-btn--champion @(IsChampion ? "is-active" : string.Empty)"
                        @onclick="ToggleChampion"
                        title="@(IsChampion ? "Drop your champion" : "Root for this agent — track it all match")"
                        data-testid="btn-champion">
                    @(IsChampion ? "★ Champion" : "☆ Champion")
                </button>
            }
            @if (Store.Simulation.SelectedAgentId is not null)
            {
                <button class="sv-btn decision-inspector__clear-follow"
                        @onclick="ClearFollow"
                        data-testid="btn-clear-follow">
                    Clear follow
                </button>
            }
        </div>
    </div>

    @* Plain-language hero line — the "aha" up top, before any jargon. *@
    <p class="decision-inspector__plain" data-testid="decision-plain">@PlainSummary</p>

    @if (CurrentEntry is null)
    {
        <p class="decision-inspector__empty">Follow an agent (click it on the grid) to see why it moves.</p>
    }
    else
    {
        <div class="decision-inspector__meta">
            <span class="decision-inspector__chip">@($"T{CurrentEntry.TurnNumber}")</span>
            <span class="decision-inspector__chip @(CurrentEntry.Team == "Red" ? "decision-inspector__chip--red" : "decision-inspector__chip--blue")">@CurrentEntry.AgentId</span>
            <span class="decision-inspector__chip">@CurrentEntry.Action.ToUpperInvariant()</span>
            <span class="decision-inspector__chip @(CurrentSeverity == "warn" ? "decision-inspector__chip--warn" : "decision-inspector__chip--info")">@CurrentSeverity.ToUpperInvariant()</span>
            @if (CurrentAgent is not null)
            {
                <span class="decision-inspector__chip" title="How well this action fits the agent's personality and current pressure, scored 0-100 by the game's own heuristic (not by the model). The full ranking is under &quot;What else it considered&quot;.">FIT @CurrentActionFit</span>
            }
            @* Provenance, stated rather than implied. The panel used to narrate a rich model-style
               rationale over decisions the fallback table had made. *@
            @if (InsightService.IsFallbackDecision(CurrentEntry))
            {
                <span class="decision-inspector__chip decision-inspector__chip--warn"
                      data-testid="decision-source-fallback"
                      title="@ProvenanceText">FALLBACK</span>
            }
            else
            {
                <span class="decision-inspector__chip decision-inspector__chip--info"
                      data-testid="decision-source-model"
                      title="@ProvenanceText">@Store.Boot.ProviderKind</span>
            }
        </div>

        <p class="decision-inspector__summary" data-testid="decision-provenance">@ProvenanceText</p>

        <p class="decision-inspector__summary">
            @if (Store.Simulation.SelectedAgentId is not null)
            {
                <span>Following @CurrentEntry.AgentId. Event filter: @CurrentEventFilter.ToUpperInvariant().</span>
            }
            else
            {
                <span>Auto-tracking latest acting agent. Event filter: @CurrentEventFilter.ToUpperInvariant().</span>
            }
        </p>

        <blockquote class="decision-inspector__thought" title="@CurrentEntry.Thought">@CurrentEntry.Thought</blockquote>

        @if (CurrentAgent is not null)
        {
            <div class="decision-inspector__section-title" title="Decision Causality">What drove it</div>
            <div class="decision-inspector__causality-grid">
                @foreach (var factor in CausalityFactors)
                {
                    <article class="decision-inspector__cause-card @(factor.Polarity == "risk" ? "decision-inspector__cause-card--risk" : "decision-inspector__cause-card--drive")">
                        <div class="decision-inspector__cause-title">@factor.Title</div>
                        <div class="decision-inspector__cause-value">@factor.Value</div>
                        <div class="decision-inspector__cause-detail">@factor.Detail</div>
                    </article>
                }
            </div>

            <div class="decision-inspector__section-title" title="Counterfactual Move Fit">What else it considered</div>
            <div class="decision-inspector__alternatives" data-testid="decision-alternatives">
                @foreach (var option in ActionOptions)
                {
                    <div class="decision-inspector__option-row @(option.IsCurrent ? "decision-inspector__option-row--current" : string.Empty)">
                        <div class="decision-inspector__option-head">
                            <span class="decision-inspector__option-name">@option.ActionName.ToUpperInvariant()</span>
                            <span class="decision-inspector__option-score">@option.Score</span>
                        </div>
                        <MeterBar Value="@option.Score" AriaLabel="@($"{option.ActionName} fit")" />
                        <div class="decision-inspector__option-why">@option.Rationale</div>
                    </div>
                }
            </div>

            <div class="decision-inspector__motivation">
                <div class="decision-inspector__motivation-title" title="Motivation Profile">Personality</div>
                @foreach (var trait in InsightService.GetSortedTraits(CurrentAgent).Take(3))
                {
                    <MeterBar Label="@trait.Key" Value="@trait.Value" ValueText="@($"{trait.Value}%")" />
                }
            </div>

            @* How this agent got here. The causality cards above explain THIS
               turn; the vitals series explains the pressure that built up to it —
               a flee at 30% HP reads differently once you can see the slide. *@
            <div class="decision-inspector__section-title" title="Vitals over the match">How it got here</div>
            <VitalsChart AgentId="@CurrentAgent.Id" />

            @if (CurrentAgentHistory.Count > 1)
            {
                <div class="decision-inspector__section-title" title="Recent Decision Sequence">Recent moves</div>
                <div class="decision-inspector__history-list" data-testid="decision-history">
                    @foreach (var item in CurrentAgentHistory)
                    {
                        <div class="decision-inspector__history-item">
                            <span class="decision-inspector__history-turn">@($"T{item.TurnNumber}")</span>
                            <span class="decision-inspector__history-action">@item.Action.ToUpperInvariant()</span>
                            <span class="decision-inspector__history-thought" title="@item.Thought">@Shorten(item.Thought, 70)</span>
                        </div>
                    }
                </div>
            }

            <details class="decision-inspector__advanced">
                <summary>Advanced diagnostics</summary>
                <div class="decision-inspector__advanced-grid">
                    <div>HP: @CurrentAgent.Hp</div>
                    <div>Hunger: @Math.Round(CurrentAgent.Hunger, 2)</div>
                    <div>Kills: @CurrentAgent.KillCount</div>
                    <div>Food: @CurrentAgent.FoodConsumed</div>
                    <div>Survival turns: @CurrentAgent.SurvivalTurns</div>
                    <div>Position: (@CurrentAgent.X,@CurrentAgent.Y)</div>
                </div>
            </details>
        }
    }
</section>

@code {
    private string CurrentEventFilter => string.IsNullOrWhiteSpace(Store.Simulation.EventFilter)
        ? "all"
        : Store.Simulation.EventFilter;

    private string PlainSummary => InsightService.BuildPlainSummary(CurrentAgent, CurrentEntry);

    private string ProvenanceText
        => InsightService.DescribeProvenance(CurrentEntry, Store.Boot.ModelLabel);

    private bool IsChampion
        => CurrentAgent is not null && Store.Simulation.ChampionAgentId == CurrentAgent.Id;

    private void ToggleChampion()
        => Store.SelectChampion(IsChampion ? null : CurrentAgent?.Id);

    private ConsoleEntry? CurrentEntry
    {
        get
        {
            if (Store.Simulation.ConsoleLog.Count == 0)
                return null;

            if (Store.Simulation.SelectedAgentId is not null)
                return Store.Simulation.ConsoleLog.LastOrDefault(e => e.AgentId == Store.Simulation.SelectedAgentId)
                       ?? Store.Simulation.ConsoleLog.Last();

            return Store.Simulation.ConsoleLog.Last();
        }
    }

    private AgentDto? CurrentAgent
        => CurrentEntry is null
            ? null
            : Store.Simulation.Agents.FirstOrDefault(a => a.Id == CurrentEntry.AgentId);

    private IReadOnlyList<ConsoleEntry> CurrentAgentHistory
        => CurrentEntry is null
            ? []
            : Store.Simulation.ConsoleLog
                .Where(e => e.AgentId == CurrentEntry.AgentId)
                .TakeLast(5)
                .ToList();

    private int CurrentActionFit
        => InsightService.ComputeActionFit(CurrentAgent, CurrentEntry, CurrentAgentHistory);

    private IReadOnlyList<DecisionFactor> CausalityFactors
        => InsightService.BuildCausalityFactors(CurrentAgent, CurrentEntry, CurrentAgentHistory);

    private IReadOnlyList<ActionOption> ActionOptions
        => CurrentAgent is null || CurrentEntry is null
            ? []
            : InsightService.BuildActionOptions(CurrentAgent, CurrentEntry, CurrentAgentHistory);

    private string CurrentSeverity
        => CurrentEntry is null ? "info" : InsightService.GetSeverity(CurrentEntry);

    private static string Shorten(string text, int maxLen)
        => text.Length <= maxLen ? text : text[..(maxLen - 3)] + "...";

    private void ClearFollow()
        => Store.ClearSelection();
}
