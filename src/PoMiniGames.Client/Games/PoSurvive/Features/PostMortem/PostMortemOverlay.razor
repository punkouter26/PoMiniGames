@using PoMiniGamesClient.Games.PoSurvive.Store
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Models

@* PostMortemOverlay — the end-of-run screen, shown when the simulation ends. *@
@inherits SurviveComponentBase
@* 2026-07-16: this was a bespoke full-screen post-mortem with its own C64-styled
   overlay and a REVIEW / EXPORT / NEW SIMULATION button row — the one game that
   ended on something other than the shared modal, with no way back to the menu.
   It now renders the shared GameOverModal like every other game, so the styling
   and the single OK exit come from one place. PoSurvive still can't host
   GameShell (its own layout + SurviveStore — see the note atop PoSurvivePage),
   which is exactly why the modal is a standalone component.

   No GameKey: PoSurvive is a simulation with no score, so it has no leaderboard
   and the modal simply omits the top-3 section. *@
@if (Store.Simulation.ShowPostMortem)
{
    <div data-testid="postmortem-overlay">
        <GameOverModal Title="@TitleContent"
                       GameSummary="@SummaryContent"
                       Stats="@StatItems"
                       BackTo="/"
                       OnOk="@ResetSimulation" />
    </div>
}

@code {
    private RenderFragment TitleContent => @<span><span aria-hidden="true">🛡️</span> Survive</span>;

    // The chart rides inside the shared modal's summary fragment rather than
    // needing a change to GameOverModal — every other game keeps the modal it has.
    private RenderFragment SummaryContent => @<div>
        <div>@OutcomeLine</div>
        <div>@Store.Simulation.NarrativeText</div>
        <CasualtyTimeline />
    </div>;

    /// <summary>
    /// A Draw now has two causes, and they are not the same story. Mutual annihilation is
    /// "no survivors"; hitting <c>SimulationDefaults.MaxTurns</c> with agents still standing
    /// is a stand-off. The screen used to assert "no survivors" for both, which the survivor
    /// count in the stats row directly contradicted.
    /// </summary>
    private string OutcomeLine
    {
        get
        {
            if (Store.Simulation.Outcome != "Draw")
                return $"Victory: {Store.Simulation.WinningTeam?.ToUpperInvariant()} faction";

            var standing = Store.Simulation.Agents.Count(a => a.IsAlive);
            return standing == 0
                ? "⚠ Draw — no survivors"
                : $"⚠ Draw — turn limit reached with {standing} still standing";
        }
    }

    // The old overlay carried a full per-agent standings table (ID/TEAM/HP/KILLS/
    // FOOD/DAMAGE). That doesn't fit the shared modal, so it collapses to the
    // three figures that summarise a run; the per-agent detail is still on the
    // grid behind the modal.
    private List<StatItem> StatItems =>
    [
        new StatItem { Value = Store.Simulation.TurnNumber.ToString(), Label = "Turns" },
        new StatItem { Value = Store.Simulation.Agents.Sum(a => a.KillCount).ToString(), Label = "Kills" },
        // IsAlive, matching every other survivor count in the game (the stats bar, the
        // charts, the timeline). `Hp > 0` computed the same answer but said it differently.
        new StatItem { Value = Store.Simulation.Agents.Count(a => a.IsAlive).ToString(), Label = "Survivors" },
    ];

    // Clear the run before OK navigates home, so the store doesn't come back with
    // the post-mortem still showing.
    private void ResetSimulation() => Store.ResetSimulation();
}
