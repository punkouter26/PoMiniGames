@* Small reusable DNA trait bar shown inside AgentSidebar *@

<div class="dna-bar">
    <span class="dna-bar__label">@Label</span>
    <div class="dna-bar__track">
        <div class="dna-bar__fill" style="width:@(Value * 100f)%"></div>
    </div>
    <span class="dna-bar__pct">@((Value * 100f).ToString("F0"))%</span>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public float  Value { get; set; }
}
