@using PoMiniGamesClient.Games.PoSurvive.Features.Grid
@using PoMiniGamesClient.Games.PoSurvive.Features.Inspector
@using PoMiniGamesClient.Games.PoSurvive.Features.Sidebar
@using PoMiniGamesClient.Games.PoSurvive.Features.Console
@using PoMiniGamesClient.Games.PoSurvive.Features.PostMortem
@using PoMiniGamesClient.Games.PoSurvive.Services
@using PoMiniGamesClient.Games.PoSurvive.Store
@using PoShared.Simulation.Constants
@using PoShared.Simulation.Models
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inherits SurviveLayoutBase
@* No `@implements IDisposable` — SurviveLayoutBase already does, and re-declaring it here
   is what let an explicit interface implementation shadow the base's cleanup. *@
@inject SessionLogService       LogService
@inject SimulationLaunchService LaunchService
@inject IJSRuntime              JS
@inject NavigationManager       Nav
@inject IWebAssemblyHostEnvironment HostEnv
@inject PoMiniGamesClient.Games.PoSurvive.Services.LocalModelBootstrapService ModelBootstrap
@inject PoMiniGamesClient.Games.PoSurvive.Services.InferenceBootstrapper Bootstrapper
@inject AuthStateService        AuthState
@inject ToastService            ToastService

@* ── Platform header + game control strip ────────────────────────────────────
   PoSurvive wears the SAME top bar as every other game. The `gl-top-bar` markup
   below is the one from MainLayout / EmptyLayout: PoMiniGames brand on the left,
   FPS pill and game title in the centre, session controls on the right. Those
   `.gl-*` rules live in app-shell.css, which is deliberately NON-scoped and
   render-blocking precisely so a layout like this one can render the shared
   chrome — read the header comment in that file, it was written after an earlier
   hand-rolled copy of this header rendered completely unstyled.

   Before this, PoSurvive was the only game with no PoMiniGames branding: it had
   a bespoke `.sv-bar` carrying a "Survive" wordmark, so the platform identity and
   the universal "click the brand to get home" affordance were missing.

   The game's own transport (start/pause, speed, live stats, the Advanced drawer)
   drops to the slim `.sv-bar` strip below the header. That is two rows, not the
   three the board-first pass removed, and adding the header back costs the board
   no height at all: `.sv-shell` is a flex column and the stage is its flexible
   child, so the stage is simply "what is left" no matter how tall the chrome
   above it turns out to be. No `calc(100vh - <sum of chrome>)`, which is the
   construct that silently omitted the platform header last time.

   HARD CONSTRAINT — `.sv-bar` must NOT set `overflow: hidden`. The old `.toolbar`
   did, at a fixed 52px, which clipped the Advanced drawer out of sight entirely.
   The Advanced panel and the dev-switch panel are absolutely positioned and have
   to escape the bar's box. Use the shrink order in the stylesheet (stats degrade
   first) instead of clipping. *@
<div class="sv-shell">
<header class="gl-top-bar app-reveal">
    <div class="gl-top-bar-left">
        <a href="/" class="gl-brand" title="Back to PoMiniGames">
            <span class="gl-brand-icon">
                <svg width="22" height="22" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect x="3" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                    <rect x="23" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                    <rect x="3" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                    <rect x="23" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                </svg>
            </span>
            <span class="gl-brand-text">PoMiniGames</span>
        </a>
    </div>

    <div class="gl-top-bar-center">
        <FpsCounter />
        <div class="gl-top-bar-game">
            @* Same slot markup GameShell projects for every other game, rendered
               inline because PoSurvive can't host GameShell (its own layout +
               SurviveStore — see the note atop PoSurvivePage). *@
            @* Emoji + name, matching every other game's title ("🃏 Joker",
               "🏎️ Racer", …) and the shield this game's end-of-game modal uses. *@
            <div class="gps-header-slot">
                <span class="gps-game-title">🛡️ Survive</span>
            </div>

            @* ── Natural-language AI status pill ── *@
            @if (Store.Boot.IsDegradedMode)
            {
                <span class="sv-status sv-status--warn" data-testid="inference-status-degraded" title="@DegradedModeSummary">Offline AI</span>
            }
            else if (Store.Simulation.IsProviderDegraded)
            {
                @* Bootstrap said the provider was available and it may well have been; what
                   matters here is that it has stopped answering. Reported from live call
                   outcomes, which nothing used to look at after boot. *@
                <span class="sv-status sv-status--warn" data-testid="inference-status-fallback" title="@ProviderDegradedSummary">Fallback tactics</span>
            }
            else if (HasInferenceIssue)
            {
                <span class="sv-status sv-status--error" data-testid="inference-status" title="@InferenceIssueSummary">AI issue</span>
            }
            else
            {
                <span class="sv-status sv-status--ok" data-testid="inference-status-ok" title="@LiveInferenceSummary">AI online</span>
            }
        </div>
    </div>

    <div class="gl-auth">
        @* §10 dev-only "Switch user…" affordance. Renders only in Development +
           Test environments where the /api/auth/dev-bypass endpoint exists; lets a
           developer verify head-to-head flows from the same machine without
           spinning up an incognito tab. Hidden in Production. *@
        @if (ShowDevSwitch)
        {
            <details class="gl-overflow-menu gl-dev-switch">
                <summary class="gl-overflow-trigger" aria-label="Developer tools"><Icon Name="wrench" Size="14" /></summary>
                <div class="gl-overflow-panel">
                    <div class="gl-dev-switch__title">Switch user (dev only)</div>
                    <input class="gl-dev-switch__input" type="text"
                           placeholder="@(AuthState.User?.DisplayName ?? "new-name")"
                           @bind="_devUser"
                           @bind:event="oninput"
                           maxlength="32" />
                    <button class="gl-overflow-item" @onclick="SwitchDevUserAsync" disabled="@(string.IsNullOrWhiteSpace(_devUser) || _switching)">
                        @(_switching ? "Switching…" : "Switch identity")
                    </button>
                    @if (!string.IsNullOrEmpty(_switchError))
                    {
                        <div class="gl-dev-switch__error">@_switchError</div>
                    }
                    <div class="gl-dev-switch__hint">Replaces the current cookie; reloads match history.</div>
                </div>
            </details>
        }
        @if (AuthState.IsConfigured && !AuthState.IsLoading)
        {
            @if (AuthState.IsAuthenticated)
            {
                <span class="gl-auth-user" title="@AuthUserTitle">@AuthUserLabel</span>
            }
            <button class="gl-auth-button" @onclick="AuthState.IsAuthenticated ? SignOut : SignIn">
                @(AuthState.IsAuthenticated ? "Sign out" : "Sign in")
            </button>
            @if (!AuthState.IsAuthenticated)
            {
                <button class="gl-auth-button gl-auth-button--anon" @onclick="SignInAnon" title="Continue as anonymous">ANON</button>
            }
        }
    </div>
</header>

<div class="sv-bar app-reveal" data-testid="toolbar">
    @* ── North-Star control: one primary button that morphs with lifecycle ── *@
    @if (BootCanStartSimulation && !Store.Simulation.IsRunning && !Store.Simulation.IsPaused && Store.Simulation.Outcome is null && !Store.Simulation.ShowPostMortem)
    {
        <button class="sv-btn sv-btn--primary sv-btn--cta"
                id="start-sim-button"
                @onclick="StartSimulation"
                data-testid="btn-start">
            <Icon Name="play" Size="13" /> Start battle
        </button>
    }
    @if (Store.Simulation.IsRunning && !Store.Simulation.IsPaused)
    {
        <button class="sv-btn" @onclick="PauseSimulation" data-testid="btn-pause" title="Pause">
            <Icon Name="pause" Size="13" /> Pause
        </button>
    }
    @if (Store.Simulation.IsPaused)
    {
        <button class="sv-btn sv-btn--primary" @onclick="ResumeSimulation" data-testid="btn-resume" title="Resume">
            <Icon Name="play" Size="13" /> Resume
        </button>
    }
    @if (!Store.Simulation.IsRunning && !Store.Simulation.IsPaused && Store.Simulation.TurnNumber > 0)
    {
        <button class="sv-btn sv-btn--primary sv-btn--cta" @onclick="ResetSimulation" data-testid="btn-restart">
            <Icon Name="restart" Size="13" /> New battle
        </button>
    }

    @* ── AI model picker, primary ──────────────────────────────────────────
       Promoted out of the Advanced drawer (2026-07-30). Which intelligence is
       driving the agents is the single most consequential choice on this page —
       Azure deployment, in-browser model, or no model at all — and it sat two
       clicks deep behind a gear icon, next to the log-export button.

       The Azure group comes from the server's own allowlist via
       GET /api/infer/status, never from client config: a client-side list is how
       the picker once offered a single id the relay refused to serve. *@
    <div class="sv-model" data-testid="model-picker">
        <span class="sv-model__chip @InferenceIndicatorClass"
              data-testid="inference-indicator"
              title="Model ID: @Store.Boot.ModelId">
            @Store.Boot.ProviderKind
        </span>
        <select id="toolbar-model-select"
                class="sv-model__select"
                value="@ToolbarSelectedModelId"
                @onchange="OnToolbarModelChanged"
                disabled="@(ToolbarModelOptions.Count == 0 || _switchingModel)"
                data-testid="toolbar-model-select"
                aria-label="AI model"
                title="Which AI decides the agents' moves">
            @if (ToolbarModelOptions.Any(o => o.IsRemote))
            {
                <optgroup label="Azure (cloud)">
                    @foreach (var option in ToolbarModelOptions.Where(o => o.IsRemote))
                    {
                        <option value="@option.Id" title="@option.Description">@option.Label</option>
                    }
                </optgroup>
            }
            @if (ToolbarModelOptions.Any(o => !o.IsRemote && !o.IsScripted))
            {
                <optgroup label="In-browser (local)">
                    @foreach (var option in ToolbarModelOptions.Where(o => !o.IsRemote && !o.IsScripted))
                    {
                        <option value="@option.Id" title="@option.Description">@option.Label ↓</option>
                    }
                </optgroup>
            }
            @if (ToolbarModelOptions.Any(o => o.IsScripted))
            {
                <optgroup label="No model">
                    @foreach (var option in ToolbarModelOptions.Where(o => o.IsScripted))
                    {
                        <option value="@option.Id" title="@option.Description">@option.Label</option>
                    }
                </optgroup>
            }
        </select>
        @* One line of live feedback in the one place the choice was made: a WebLLM pick is a
           real download, and the picker used to give no sign it had started. *@
        @if (_switchingModel)
        {
            <span class="sv-model__note" data-testid="model-switch-note">switching…</span>
        }
        else if (ModelDownloadPercent is { } percent)
        {
            <span class="sv-model__note" data-testid="model-download-note">downloading @percent%</span>
        }
    </div>

    @* ── Speed presets, primary (raw ms lives in Advanced) ── *@
    <div class="sv-speed" role="group" aria-label="Playback speed">
        <button class="sv-chip @(Store.Simulation.SpeedMs <= 400 ? "is-active" : string.Empty)"
                @onclick="() => SetSpeedPreset(350)" data-testid="btn-speed-fast" title="Fast">Fast</button>
        <button class="sv-chip @(Store.Simulation.SpeedMs > 400 && Store.Simulation.SpeedMs < 1200 ? "is-active" : string.Empty)"
                @onclick="() => SetSpeedPreset(900)" data-testid="btn-speed-balanced" title="Balanced">Balanced</button>
        <button class="sv-chip @(Store.Simulation.SpeedMs >= 1200 ? "is-active" : string.Empty)"
                @onclick="() => SetSpeedPreset(1500)" data-testid="btn-speed-inspect" title="Slow — read every decision">Inspect</button>
    </div>

    @* The AI status pill moved up into the header's game slot, beside the game
       title — it is a statement about the session, not a transport control. *@

    @* The one flexible child: everything above sits left, everything below right.
       It carries the alignment rather than an auto-margin on the stats group,
       because the stats group is absent before the first turn. *@
    <span class="sv-bar__spacer" aria-hidden="true"></span>

    @* ── Live stats, absorbed from the deleted `statsbar` row ── *@
    @if (Store.Simulation.TurnNumber > 0 || Store.Simulation.IsRunning)
    {
        <div class="sv-bar__stats" data-testid="statsbar">
            <span class="statsbar__item statsbar__item--time" title="Elapsed wall-clock time since simulation start"><Icon Name="clock" Size="12" /> @ElapsedFormatted</span>
            <span class="statsbar__sep">·</span>
            <span class="statsbar__item" title="Current simulation turn">TURN <strong>@Store.Simulation.TurnNumber</strong></span>
            <span class="statsbar__sep">·</span>
            <span class="statsbar__item statsbar__item--red" title="Alive Red agents"><Icon Name="online" Size="10" /> @AliveRed</span>
            <span class="statsbar__item statsbar__item--blue" title="Alive Blue agents"><Icon Name="online" Size="10" /> @AliveBlue</span>
            @if (Store.Simulation.IsPaused)
            {
                <span class="statsbar__sep">·</span>
                <span class="statsbar__item statsbar__item--paused"><Icon Name="pause" Size="11" /> PAUSED</span>
            }
            @if (Store.Simulation.Outcome is not null)
            {
                <span class="statsbar__sep">·</span>
                <span class="statsbar__item statsbar__item--outcome">@Store.Simulation.Outcome.ToUpperInvariant()</span>
            }
        </div>
    }

    <div class="sv-bar__tools">
        @* ── Advanced drawer: raw speed, log export, contrast ──
           The model <select> moved to the bar itself; what stays here is the detail
           line about whichever provider is active. *@
        <details class="sv-advanced">
            <summary class="sv-advanced__summary" title="Speed, export, accessibility"><Icon Name="gear" Size="13" /> Advanced</summary>
            <div class="sv-advanced__panel">
                <span class="sv-advanced__provider @InferenceIndicatorClass"
                      title="Model ID: @Store.Boot.ModelId">
                    @Store.Boot.ProviderKind · @Store.Boot.ModelLabel
                </span>

                <label class="sv-advanced__label" for="speed-range">Turn speed</label>
                <div class="sv-advanced__row">
                    <input id="speed-range" type="range"
                           class="sv-advanced__slider"
                           min="@SimulationDefaults.HeartbeatMinMs"
                           max="@SimulationDefaults.HeartbeatMaxMs"
                           step="50"
                           value="@Store.Simulation.SpeedMs"
                           @oninput="OnSpeedChange"
                           data-testid="speed-slider"
                           aria-label="Simulation speed" />
                    <span class="sv-advanced__value">@Store.Simulation.SpeedMs ms</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(InferenceDetailText))
                {
                    <div class="sv-advanced__detail" data-testid="inference-detail">@InferenceDetailText</div>
                }

                <div class="sv-advanced__row sv-advanced__row--actions">
                    <button class="sv-btn sv-btn--sm"
                            @onclick="DownloadLog"
                            disabled="@(Store.Simulation.TurnNumber == 0)"
                            data-testid="btn-download">
                        Download log
                    </button>
                    <button class="sv-btn sv-btn--sm @(_highContrast ? "is-active" : string.Empty)"
                            @onclick="ToggleHighContrast"
                            data-testid="btn-high-contrast"
                            aria-pressed="@_highContrast.ToString().ToLowerInvariant()">
                        High contrast: @(_highContrast ? "On" : "Off")
                    </button>
                </div>
            </div>
        </details>

        @* Session controls (sign in / out, ANON, the dev identity switcher) moved
           into the header's `gl-auth` cluster, where every other game carries
           them. They are platform chrome, not game transport. *@
    </div>
</div>

@* ── Two-pane stage: board + one tabbed intel rail ────────────────────────────
   Was a 3-pane grid (`1fr 260px` / `1fr 180px`). The 180px bottom console pane
   is gone; the Tactical Log moved into the rail as a tab alongside the Decision
   Inspector and the Agent list, so the board reclaims that height as well as
   the 105px of deleted header chrome.

   The rail also fixes a dead end: the old mobile breakpoint defined
   `.simulation-layout--agents` / `--log` to reveal the sidebar and console one
   at a time, but the razor hard-coded `--grid` and nothing ever set the other
   two — below 760px the intel and log panes were unreachable. One tab mechanism
   now serves both breakpoints.

   The toast and the watchdog alert live INSIDE the stage. They used to be
   viewport-fixed at `top: calc(var(--bar-h) + 8px)` — a constant that is only
   correct while the command bar is exactly one row tall. Below 860px the bar
   wraps to two or three rows, so both overlays landed directly on top of the
   controls they were reporting about, covering the Start button. Anchored to the
   stage they are correct at every breakpoint without a magic number. *@
<div class="sv-stage @(_railCollapsed ? "sv-stage--rail-collapsed" : string.Empty)" data-testid="main-layout">

    @if (_downloadToastVisible)
    {
        <div class="app-toast app-toast--@_downloadToastKind" role="status" aria-live="polite" data-testid="download-toast">
            @_downloadToastMessage
        </div>
    }

    @if (StalledAtTurnZero)
    {
        <div class="runtime-alert" role="alert" data-testid="runtime-watchdog-alert">
            <span class="runtime-alert__title">INFERENCE WATCHDOG:</span>
            <span class="runtime-alert__text">No heartbeat progress for @StalledTurnThresholdSec seconds. Runtime may be degraded.</span>
            <button class="c64-btn runtime-alert__btn"
                    @onclick="RecoverFromInferenceStall"
                    data-testid="btn-recover-stall">
                [ RECOVER ]
            </button>
        </div>
    }

    <main class="sv-stage__board app-reveal">
        @Body
    </main>

    <aside class="sv-rail fx-glass app-reveal" data-testid="sv-rail">
        <div class="sv-rail__head">
            @* Champion tracker (#2), demoted from a full-width strip to a chip so it
               costs the board no height. Stays visible across all three tabs. *@
            @if (Champion is not null)
            {
                <div class="sv-champion @(Champion.IsAlive ? string.Empty : "sv-champion--fallen") @(Champion.Team == "Red" ? "sv-champion--red" : "sv-champion--blue")"
                     data-testid="champion-strip"
                     title="Your champion — @Champion.Id (@(Champion.IsAlive ? "alive" : "fallen"))">
                    <span class="sv-champion__star"><Icon Name="star" Size="11" /></span>
                    <span class="sv-champion__id">@Champion.Id</span>
                    <span class="sv-champion__stat" title="Health"><Icon Name="heart" Size="11" /> @Champion.Hp</span>
                    <span class="sv-champion__stat" title="Kills"><Icon Name="swords" Size="11" /> @Champion.KillCount</span>
                    <span class="sv-champion__stat" title="Turns survived"><Icon Name="hourglass" Size="11" /> @Champion.SurvivalTurns</span>
                    <button class="sv-champion__drop" @onclick="DropChampion" title="Drop champion" aria-label="Drop champion"><Icon Name="close" Size="10" /></button>
                </div>
            }
            else
            {
                <span class="sv-rail__hint">Click an agent to follow it</span>
            }

            <button class="sv-rail__collapse"
                    @onclick="ToggleRail"
                    data-testid="btn-rail-collapse"
                    title="@(_railCollapsed ? "Expand intel rail" : "Collapse intel rail")"
                    aria-expanded="@((!_railCollapsed).ToString().ToLowerInvariant())">
                @(_railCollapsed ? "«" : "»")
            </button>
        </div>

        <div class="sv-rail__tabs" role="tablist" aria-label="Intel">
            @foreach (var tab in AllTabs)
            {
                <button class="sv-rail__tab @(_tab == tab ? "is-active" : string.Empty)"
                        role="tab"
                        aria-selected="@((_tab == tab).ToString().ToLowerInvariant())"
                        data-testid="rail-tab-@(tab.ToString().ToLowerInvariant())"
                        @onclick="() => SelectTab(tab)">
                    @TabLabel(tab)
                </button>
            }
        </div>

        <div class="sv-rail__body" role="tabpanel" data-testid="rail-body">
            @if (_tab == RailTab.Why)
            {
                @if (Store.Simulation.IsRunning || Store.Simulation.Agents.Count > 0)
                {
                    <DecisionInspector />
                }
                else
                {
                    <p class="sv-rail__empty">No decisions yet. Start a battle to see why each agent moves.</p>
                }
            }
            else if (_tab == RailTab.Agents)
            {
                @if (Store.Simulation.IsRunning || Store.Simulation.Agents.Count > 0)
                {
                    @* Team strength over time. The roster below answers "who is
                       alive right now"; this answers "which way is the match
                       going", which no surface in the game used to show. *@
                    <TeamStrengthChart />
                    <AgentSidebar />
                }
                else
                {
                    <p class="sv-rail__empty">No agents yet.</p>
                }
            }
            else
            {
                @if (Store.Simulation.IsRunning || Store.Simulation.ConsoleLog.Count > 0)
                {
                    @* The log's filter chips (ATTACK / FORAGE / FLEE / IDLE) are
                       the same partition this chart draws, so the shape above the
                       list explains what the filters are for. *@
                    <ActionMixChart />
                    <TacticalLog />
                }
                else
                {
                    <p class="sv-rail__empty">No events yet.</p>
                }
            }
        </div>
    </aside>
</div>
</div>

<PostMortemOverlay />

@* An <ErrorBoundary> used to sit here wrapping (MarkupString)"" — it guarded no
   content and so could never catch anything. Removed rather than re-pointed: @Body
   already renders inside the grid pane above, and wrapping the layout's own chrome
   in a boundary would swallow errors this page wants to surface. *@

@code {
    private const int StalledTurnThresholdSec = 20;

    private string InferenceIndicatorClass => Store.Boot.ProviderKind switch
    {
        "LOCAL"  => "sv-advanced__provider--local",
        "REMOTE" => "sv-advanced__provider--remote",
        "MOCK"   => "sv-advanced__provider--mock",
        _         => string.Empty,
    };

    // ── Intel rail (2026-07-29) ───────────────────────────────────────────
    // The Decision Inspector, Agent list and Tactical Log used to occupy two
    // separate panes (a 260px sidebar and a 180px footer). They are now three
    // tabs of one rail, which is what lets the board own the rest of the stage.
    private enum RailTab { Why, Agents, Log }

    private static readonly RailTab[] AllTabs = [RailTab.Why, RailTab.Agents, RailTab.Log];

    private RailTab _tab = RailTab.Why;
    private bool _railCollapsed;

    private static string TabLabel(RailTab tab) => tab switch
    {
        RailTab.Why    => "Why",
        RailTab.Agents => "Agents",
        _              => "Log",
    };

    // Selecting a tab while collapsed expands the rail: the click is a request to
    // read that panel, not just to arm it.
    private void SelectTab(RailTab tab)
    {
        _tab = tab;
        _railCollapsed = false;
    }

    private void ToggleRail() => _railCollapsed = !_railCollapsed;

    // ── Compact toolbar model switcher ────────────────────────────────
    // Loads the same set of LOCAL (WebLLM) and REMOTE (Azure OpenAI / Foundry)
    // options as the Mission Control picker. Lets the player change model on the fly
    // without backing out to the idle screen.
    private List<PoMiniGamesClient.Games.PoSurvive.Services.ModelOption> ToolbarModelOptions { get; set; } = new();
    private bool _switchingModel;

    // Read-only: the <select> is bound one-way from BootState and OnToolbarModelChanged
    // dispatches the update. (This used to be a property with a no-op setter.)
    private string ToolbarSelectedModelId => Store.Boot.ModelId;

    // All of the provider-switching logic now lives in InferenceBootstrapper, which is also
    // what performs the initial bootstrap — so the drawer and the page-load path can no
    // longer disagree about what "switch to this model" means. The previous version flipped
    // the router and the chip for a LOCAL pick but never started the model download and never
    // called BootReady, so choosing an in-browser model silently left the game un-ready.
    private async Task OnToolbarModelChanged(ChangeEventArgs e)
    {
        var newId = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(newId) || newId == Store.Boot.ModelId) return;

        var selected = ToolbarModelOptions.FirstOrDefault(o => o.Id == newId);
        if (selected is null) return;

        _switchingModel = true;
        StateHasChanged();

        try
        {
            await Bootstrapper.SwitchToAsync(selected);
        }
        finally
        {
            _switchingModel = false;
        }
    }

    private bool StalledAtTurnZero
        => Store.Simulation.IsRunning
            && !Store.Simulation.IsMockProvider
            && Store.Simulation.TurnNumber == 0
            && Store.Simulation.StartedAt != default
            && (DateTimeOffset.UtcNow - Store.Simulation.StartedAt).TotalSeconds >= StalledTurnThresholdSec;

    private bool HasInferenceIssue
        => Store.Boot.HasInferenceInitError
            || StalledAtTurnZero
            || (Store.Boot.ProviderKind == "LOCAL"
                && Store.Boot.IsReady
                && Store.Boot.TotalBytes > 0
                && Store.Boot.BytesLoaded == 0);

    private bool BootCanStartSimulation => Store.Boot.IsReady || Store.Boot.IsDegradedMode;

    private string DegradedModeSummary
        => "Fallback tactics are active because real inference is unavailable.";

    // Live wording, from the last heartbeat's own counts — not from what bootstrap concluded.
    private string ProviderDegradedSummary
        => $"{Store.Boot.ModelLabel} has failed {Store.Simulation.ProviderConsecutiveFailures} calls in a row. "
         + "Agents are running on local fallback tactics until it answers again.";

    private string LiveInferenceSummary
        => Store.Simulation.ModelDecisionsThisTurn > 0
            ? $"{Store.Boot.ModelLabel} decided {Store.Simulation.ModelDecisionsThisTurn} of "
              + $"{Store.Simulation.ModelDecisionsThisTurn + Store.Simulation.FallbackDecisionsThisTurn} "
              + "agent moves last turn (the rest reuse their standing orders)."
            : "Live AI inference is running.";

    // Detail line shown inside the Advanced drawer (was a permanent toolbar chip).
    private string? InferenceDetailText
        => Store.Boot.IsDegradedMode ? DegradedModeSummary
        : HasInferenceIssue ? InferenceIssueSummary
        : null;

    // ── High-contrast toggle ──────────────────────────────────────────────
    // The high-contrast palette (high-contrast.css) keys off `body.high-contrast`.
    // No action was ever wired to it; this toggles the class directly via JS and
    // persists the choice so it survives navigation.
    private bool _highContrast;

    private async Task ToggleHighContrast()
    {
        var next = !_highContrast;
        try
        {
            // Flip only after the interop succeeds, so a failure can't leave the button
            // label claiming a state the page isn't in. The call used to target a function
            // that did not exist, and the unguarded JSException took the click handler down.
            await JS.InvokeVoidAsync("PoSurviveTheme.setHighContrast", next);
            _highContrast = next;
        }
        catch (JSException)
        {
            ToastService.Show("High contrast is unavailable in this browser.", ToastType.Error);
        }
    }

    private string InferenceIssueSummary
        => StalledAtTurnZero
            ? $"Turn watchdog triggered (>{StalledTurnThresholdSec}s at turn 0)."
            : Store.Boot.InferenceInitError is { Length: > 0 }
            ? SummarizeIssue(Store.Boot.InferenceInitError)
            : "Inference is unavailable.";

    private static string SummarizeIssue(string detail)
    {
        var clean = detail.Trim();
        if (clean.StartsWith("Inference error:", StringComparison.OrdinalIgnoreCase))
            clean = clean["Inference error:".Length..].Trim();

        const int max = 96;
        return clean.Length <= max ? clean : clean[..max] + "...";
    }

    private System.Threading.Timer? _clockTimer;

    // ── Auth chrome (mirrors MainLayout so the page <header> re-renders on
    //    sign-in / sign-out without the parent layout needing to drive it). ──
    private Action? _onAuthStateChanged;
    private string _devUser = string.Empty;
    private bool _switching;
    private string? _switchError;

    private bool ShowDevSwitch =>
        HostEnv.IsDevelopment() ||
        string.Equals(HostEnv.Environment, "Test", StringComparison.OrdinalIgnoreCase);

    // Identity pill in the header, mirroring MainLayout: prefer the display name,
    // fall back to the email, and surface the full email on hover so a truncated
    // name is still resolvable.
    private string AuthUserLabel
    {
        get
        {
            var user = AuthState.User;
            if (user is null) return string.Empty;
            return string.IsNullOrWhiteSpace(user.DisplayName) ? user.Email ?? string.Empty : user.DisplayName;
        }
    }

    private string AuthUserTitle
    {
        get
        {
            var user = AuthState.User;
            if (user is null) return string.Empty;
            return string.IsNullOrWhiteSpace(user.Email) ? AuthUserLabel : user.Email;
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // Seed the picker with the in-browser models (known without a round trip). The cloud
        // entry is added in OnAfterRenderAsync once the server has told us whether its relay
        // is up and which deployment serves this game — see InferenceBootstrapper.CloudStatus.
        ToolbarModelOptions = ModelBootstrap.ReadLocalModelOptions()
            .Select(l => new PoMiniGamesClient.Games.PoSurvive.Services.ModelOption(l.Id, l.Label, l.Description, IsRemote: false))
            .ToList();
        _clockTimer = new System.Threading.Timer(_ => InvokeAsync(async () =>
        {
            StateHasChanged();
            // Piggyback the ambient-intensity update on the clock tick rather than
            // subscribing to every store change — the bed drifts over seconds, so
            // 1 Hz is plenty and costs no extra wakeups.
            await SyncAmbientIntensityAsync();
        }), null, 1000, 1000);

        // Mirror MainLayout: subscribe to auth changes so the <header> chrome
        // (Sign in / Sign out buttons) re-renders without a full page reload.
        _onAuthStateChanged = () => InvokeAsync(StateHasChanged);
        AuthState.StateChanged += _onAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            // Inject PoSurvive's stylesheets only while this layout is mounted so its
            // global CSS resets don't leak into the rest of the PoMiniGames platform.
            await JS.InvokeVoidAsync("PoSurviveTheme.load");

            // `load` re-applies the persisted high-contrast preference to <body>; read it
            // back so the toggle's label starts in agreement with the page.
            try
            {
                _highContrast = await JS.InvokeAsync<bool>("PoSurviveTheme.isHighContrast");
            }
            catch (JSException)
            {
                _highContrast = false;
            }

            // §GFX/SOUND (2026-07-29). Generative ambient bed + audio-reactive
            // visuals. Both are best-effort: a browser without Web Audio, or a
            // muted player, simply gets nothing. Never let ambience break the game.
            try
            {
                await JS.InvokeVoidAsync("PoAmbientMusic.start", "posurvive", 0.12);
                await JS.InvokeVoidAsync("PoVisualRuntime.enableAudioReactive", true);
            }
            catch (JSException)
            {
                // Module not loaded (e.g. prerender or a stripped build) — ignore.
            }

            // Idempotent: the page's BootArenaAsync also calls this, and children render
            // before parents, so by now it has usually already run. We call it anyway
            // because the layout is also reachable on its own, and then refresh the picker
            // with whatever the server said about its relay.
            await Bootstrapper.EnsureStartedAsync();
            ToolbarModelOptions = Bootstrapper.AvailableModels();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Drive the ambient bed from the state of the battle: the fewer agents left
    /// alive, the tenser the pad. Called from the same 1s clock timer that already
    /// re-renders the elapsed time, so it costs no extra wakeups.
    /// </summary>
    private async Task SyncAmbientIntensityAsync()
    {
        var total = Store.Simulation.Agents.Count;
        if (total == 0) return;
        var alive = Store.Simulation.Agents.Count(a => a.IsAlive);
        // 0 casualties -> calm; everyone but one down -> maximum tension.
        var intensity = 1.0 - ((double)alive / total);
        if (Math.Abs(intensity - _lastIntensity) < 0.08) return;
        _lastIntensity = intensity;
        try
        {
            await JS.InvokeVoidAsync("PoAmbientMusic.setIntensity", intensity);
        }
        catch (JSException) { /* module absent — ignore */ }
    }

    private double _lastIntensity = -1;

    // ── Champion strip (#2) ───────────────────────────────────────────────
    private PoShared.Simulation.Models.AgentDto? Champion
        => Store.Simulation.ChampionAgentId is { } id
            ? Store.Simulation.Agents.FirstOrDefault(a => a.Id == id)
            : null;

    private void DropChampion() => Store.SelectChampion(null);

    private int AliveRed  => Store.Simulation.Agents.Count(a => a.IsAlive && a.Team == "Red");
    private int AliveBlue => Store.Simulation.Agents.Count(a => a.IsAlive && a.Team == "Blue");

    private string ElapsedFormatted
    {
        get
        {
            if (Store.Simulation.StartedAt == default) return "0:00";
            var elapsed = DateTimeOffset.UtcNow - Store.Simulation.StartedAt;
            return elapsed.TotalHours >= 1
                ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}"
                : $"{elapsed.Minutes}:{elapsed.Seconds:D2}";
        }
    }

    private async Task StartSimulation()
    {
        var config = await LaunchService.BuildConfigAsync();

        Store.StartSimulation(config);
    }

    private void OnSpeedChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var ms))
            Store.SetSpeed(ms);
    }

    private void SetSpeedPreset(int speedMs)
        => Store.SetSpeed(speedMs);

    private string _downloadToastMessage = string.Empty;
    private string _downloadToastKind = "info";
    private bool _downloadToastVisible;
    private CancellationTokenSource? _downloadToastCts;

    private async Task DownloadLog()
    {
        var result = await LogService.DownloadLogAsync();
        ShowDownloadToast(result.Message, result.Success ? "success" : "error");
    }

    private void ShowDownloadToast(string message, string kind)
    {
        _downloadToastMessage = message;
        _downloadToastKind = kind;
        _downloadToastVisible = true;

        _downloadToastCts?.Cancel();
        _downloadToastCts?.Dispose();
        _downloadToastCts = new CancellationTokenSource();

        _ = DismissToastAsync(_downloadToastCts.Token);
    }

    private async Task DismissToastAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(3200, ct);
            _downloadToastVisible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ResetSimulation()
        => Store.ResetSimulation();

    private void PauseSimulation()
        => Store.Pause();

    private void ResumeSimulation()
        => Store.Resume();

    private async Task RecoverFromInferenceStall()
    {
        Store.ResetSimulation();
        await Task.Yield();
        await StartSimulation();
    }

    // `override`, NOT an explicit `void IDisposable.Dispose()`. SurviveLayoutBase already
    // implements IDisposable to detach its Store.Changed handler; an explicit
    // implementation here re-mapped the interface, so Blazor's `((IDisposable)c).Dispose()`
    // landed on this method and base.Dispose() never ran. The subscription outlived every
    // visit — SurviveStore is app-lifetime in WASM, so navigating away and back left a
    // dead layout being re-rendered on every heartbeat, for as long as the tab lived.
    // PoSurvivePage and AgentSidebar already used `override`; this file was the outlier.
    public override void Dispose()
    {
        base.Dispose();
        _clockTimer?.Dispose();
        _downloadToastCts?.Cancel();
        _downloadToastCts?.Dispose();
        // Remove PoSurvive's stylesheets so the platform's styling is restored on exit.
        _ = JS.InvokeVoidAsync("PoSurviveTheme.unload");

        // Stop the ambient bed and the analyser pump. An orphaned oscillator keeps
        // the audio thread alive for the lifetime of the tab, so this is not
        // optional cleanup — it is the difference between leaving and leaking.
        _ = JS.InvokeVoidAsync("PoAmbientMusic.stop", 0.8);
        _ = JS.InvokeVoidAsync("PoVisualRuntime.enableAudioReactive", false);

        // Detach the auth-state subscription wired up in OnInitialized so this
        // layout doesn't leak event handlers on re-creation.
        if (_onAuthStateChanged is not null)
        {
            AuthState.StateChanged -= _onAuthStateChanged;
        }
    }

    // ── Auth chrome handlers (mirror MainLayout so the page <header> behaves
    //    identically to the home page when the player taps Sign in / Sign out /
    //    Continue as anonymous). ─────────────────────────────────────────────
    private async Task SignIn()    => await AuthState.SignInAsync();
    private async Task SignOut()   => await AuthState.SignOutAsync();
    private async Task SignInAnon() => await AuthState.DevBypassAsync("ANON");

    private async Task SwitchDevUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_devUser)) return;
        _switching = true;
        _switchError = null;
        try
        {
            await AuthState.DevBypassAsync(_devUser.Trim());
            ToastService.Show($"Signed in as {_devUser.Trim()}", ToastType.Success);
            _devUser = string.Empty;
        }
        catch (Exception ex)
        {
            _switchError = ex.Message;
        }
        finally
        {
            _switching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

}
