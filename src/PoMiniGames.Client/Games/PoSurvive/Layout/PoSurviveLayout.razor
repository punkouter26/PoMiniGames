@using PoMiniGamesClient.Games.PoSurvive.Features.Grid
@using PoMiniGamesClient.Games.PoSurvive.Features.Inspector
@using PoMiniGamesClient.Games.PoSurvive.Features.Sidebar
@using PoMiniGamesClient.Games.PoSurvive.Features.Console
@using PoMiniGamesClient.Games.PoSurvive.Features.PostMortem
@using PoMiniGamesClient.Games.PoSurvive.Features.Soundtrack
@using PoMiniGamesClient.Games.PoSurvive.Services
@using PoMiniGamesClient.Games.PoSurvive.Store
@using PoShared.Simulation.Constants
@using PoShared.Simulation.Models
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inherits Fluxor.Blazor.Web.Components.FluxorLayout
@implements IDisposable
@inject IState<SimulationState> SimState
@inject IState<BootState>       BootState
@inject IDispatcher             Dispatcher
@inject SessionLogService       LogService
@inject SimulationLaunchService LaunchService
@inject IJSRuntime              JS
@inject NavigationManager       Nav
@inject IWebAssemblyHostEnvironment HostEnv
@inject PoMiniGamesClient.Games.PoSurvive.Services.LocalModelBootstrapService ModelBootstrap
@inject PoMiniGamesClient.Games.PoSurvive.Services.InferenceRouter InferenceRouterOrNull
@inject PoShared.Simulation.Interfaces.IInferenceService InferenceService
@inject AuthStateService        AuthState
@inject ToastService            ToastService

@* Banner removed (player request: simplify UI). Degraded / mock state is already
   surfaced inline via the toolbar inference chip + title tooltip below, so the
   dedicated full-width banner was duplicate chrome. *@

@* Page header — same `gl-top-bar` chrome as the home page (`MainLayout.razor`).
   The game-specific command surface (model picker, speed, START / PAUSE / etc.)
   lives in the `<div class="toolbar">` sibling below so it stays accessible but
   outside the page `<header>` element. *@
<header class="gl-top-bar">
    <div class="gl-top-bar-left">
        <a href="/" class="gl-brand">
            <span class="gl-brand-icon">
                <svg width="22" height="22" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                    <rect x="23" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                    <rect x="3" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                    <rect x="23" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                </svg>
            </span>
            <span class="gl-brand-text">PoMiniGames</span>
        </a>
    </div>

    @* Game-header projection slot — empty on PoSurvive (it surfaces its own
       game-specific UI in the toolbar div below instead of via SectionOutlet). *@
    <div class="gl-top-bar-game"></div>

    <div class="gl-auth">
        @* §10 dev-only "Switch user…" affordance. Renders only in Development +
           Test environments where the /api/auth/dev-bypass endpoint exists;
           lets a developer verify head-to-head flows from the same machine
           without spinning up an incognito tab. Hidden in Production. *@
        @if (ShowDevSwitch)
        {
            <details class="gl-overflow-menu gl-dev-switch">
                <summary class="gl-overflow-trigger" aria-label="Developer tools">🔧</summary>
                <div class="gl-overflow-panel">
                    <div class="gl-dev-switch__title">Switch user (dev only)</div>
                    <input class="gl-dev-switch__input" type="text"
                           placeholder="@(AuthState.User?.DisplayName ?? "new-name")"
                           @bind="_devUser"
                           @bind:event="oninput"
                           maxlength="32" />
                    <button class="gl-overflow-item" @onclick="SwitchDevUserAsync" disabled="@(string.IsNullOrWhiteSpace(_devUser) || _switching)">
                        @(_switching ? "Switching…" : "Switch identity")
                    </button>
                    @if (!string.IsNullOrEmpty(_switchError))
                    {
                        <div class="gl-dev-switch__error">@_switchError</div>
                    }
                    <div class="gl-dev-switch__hint">Replaces the current cookie; reloads match history.</div>
                </div>
            </details>
        }
        @if (AuthState.IsConfigured && !AuthState.IsLoading)
        {
            <button class="gl-auth-button" @onclick="AuthState.IsAuthenticated ? SignOut : SignIn">
                @(AuthState.IsAuthenticated ? "Sign out" : "Sign in")
            </button>
            @if (!AuthState.IsAuthenticated)
            {
                <button class="gl-auth-button gl-auth-button--anon" @onclick="SignInAnon" title="Continue as anonymous">ANON</button>
            }
            @if (!AuthState.IsAuthenticated)
            {
                <details class="gl-overflow-menu">
                    <summary class="gl-overflow-trigger" aria-label="More">⋯</summary>
                    <div class="gl-overflow-panel">
                        <button class="gl-overflow-item" @onclick="SignInAnon">Continue as anonymous</button>
                    </div>
                </details>
            }
        }
    </div>
</header>

<div class="toolbar sv-toolbar app-reveal" data-testid="toolbar">
    <div class="toolbar__identity">
        <a class="toolbar__brand" href="/" aria-label="PoMiniGames home">PoMiniGames</a>
        <span class="toolbar__subtitle">Survive · AI battle simulator</span>
    </div>

    <div class="sv-toolbar__primary">
        @* ── North-Star control: one primary button that morphs with lifecycle ── *@
        @if (!IsBootRoute && BootCanStartSimulation && !SimState.Value.IsRunning && !SimState.Value.IsPaused && SimState.Value.Outcome is null && !SimState.Value.ShowPostMortem)
        {
            <button class="sv-btn sv-btn--primary sv-btn--cta"
                    id="start-sim-button"
                    @onclick="StartSimulation"
                    data-testid="btn-start">
                ▶ Start battle
            </button>
        }
        @if (SimState.Value.IsRunning && !SimState.Value.IsPaused)
        {
            <button class="sv-btn" @onclick="PauseSimulation" data-testid="btn-pause" title="Pause">
                ❚❚ Pause
            </button>
        }
        @if (SimState.Value.IsPaused)
        {
            <button class="sv-btn sv-btn--primary" @onclick="ResumeSimulation" data-testid="btn-resume" title="Resume">
                ▶ Resume
            </button>
        }
        @if (!SimState.Value.IsRunning && !SimState.Value.IsPaused && SimState.Value.TurnNumber > 0)
        {
            <button class="sv-btn sv-btn--primary sv-btn--cta" @onclick="ResetSimulation" data-testid="btn-restart">
                ↻ New battle
            </button>
        }

        @* ── Speed presets, primary (raw ms lives in Advanced) ── *@
        <div class="sv-speed" role="group" aria-label="Playback speed">
            <button class="sv-chip @(SimState.Value.SpeedMs <= 400 ? "is-active" : string.Empty)"
                    @onclick="() => SetSpeedPreset(350)" data-testid="btn-speed-fast" title="Fast">Fast</button>
            <button class="sv-chip @(SimState.Value.SpeedMs > 400 && SimState.Value.SpeedMs < 1200 ? "is-active" : string.Empty)"
                    @onclick="() => SetSpeedPreset(900)" data-testid="btn-speed-balanced" title="Balanced">Balanced</button>
            <button class="sv-chip @(SimState.Value.SpeedMs >= 1200 ? "is-active" : string.Empty)"
                    @onclick="() => SetSpeedPreset(1500)" data-testid="btn-speed-inspect" title="Slow — read every decision">Inspect</button>
        </div>

        @* ── Natural-language AI status pill ── *@
        @if (BootState.Value.IsDegradedMode)
        {
            <span class="sv-status sv-status--warn" data-testid="inference-status-degraded" title="@DegradedModeSummary">Offline AI</span>
        }
        else if (HasInferenceIssue)
        {
            <span class="sv-status sv-status--error" data-testid="inference-status" title="@InferenceIssueSummary">AI issue</span>
        }
        else
        {
            <span class="sv-status sv-status--ok" data-testid="inference-status-ok" title="Live AI inference is running.">AI online</span>
        }

        @* ── Advanced drawer: model, raw speed, log export, contrast ── *@
        <details class="sv-advanced">
            <summary class="sv-advanced__summary" title="Model, speed, export, accessibility">⚙ Advanced</summary>
            <div class="sv-advanced__panel">
                <span class="sv-advanced__provider @InferenceIndicatorClass"
                      data-testid="inference-indicator"
                      title="Model ID: @BootState.Value.ModelId">
                    @BootState.Value.ProviderKind · @BootState.Value.ModelLabel
                </span>

                <label class="sv-advanced__label" for="toolbar-model-select">AI model</label>
                <select id="toolbar-model-select"
                        class="sv-advanced__select"
                        value="@ToolbarSelectedModelId"
                        @onchange="OnToolbarModelChanged"
                        disabled="@(ToolbarModelOptions.Count == 0 || SimState.Value.IsRunning || _switchingModel)"
                        data-testid="toolbar-model-select"
                        title="Switch between local (in-browser) and remote (cloud) inference models">
                    @if (ToolbarModelOptions.Any(o => !o.IsRemote))
                    {
                        <optgroup label="In-browser (local)">
                            @foreach (var option in ToolbarModelOptions.Where(o => !o.IsRemote))
                            {
                                <option value="@option.Id">@option.Label</option>
                            }
                        </optgroup>
                    }
                    @if (ToolbarModelOptions.Any(o => o.IsRemote))
                    {
                        <optgroup label="Cloud (remote)">
                            @foreach (var option in ToolbarModelOptions.Where(o => o.IsRemote))
                            {
                                <option value="@option.Id">@option.Label</option>
                            }
                        </optgroup>
                    }
                </select>

                <label class="sv-advanced__label" for="speed-range">Turn speed</label>
                <div class="sv-advanced__row">
                    <input id="speed-range" type="range"
                           class="sv-advanced__slider"
                           min="@SimulationDefaults.HeartbeatMinMs"
                           max="@SimulationDefaults.HeartbeatMaxMs"
                           step="50"
                           value="@SimState.Value.SpeedMs"
                           @oninput="OnSpeedChange"
                           data-testid="speed-slider"
                           aria-label="Simulation speed" />
                    <span class="sv-advanced__value">@SimState.Value.SpeedMs ms</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(InferenceDetailText))
                {
                    <div class="sv-advanced__detail" data-testid="inference-detail">@InferenceDetailText</div>
                }

                <div class="sv-advanced__row sv-advanced__row--actions">
                    <button class="sv-btn sv-btn--sm"
                            @onclick="DownloadLog"
                            disabled="@(SimState.Value.TurnNumber == 0)"
                            data-testid="btn-download">
                        Download log
                    </button>
                    <button class="sv-btn sv-btn--sm @(_highContrast ? "is-active" : string.Empty)"
                            @onclick="ToggleHighContrast"
                            data-testid="btn-high-contrast"
                            aria-pressed="@_highContrast.ToString().ToLowerInvariant()">
                        High contrast: @(_highContrast ? "On" : "Off")
                    </button>
                </div>
            </div>
        </details>
    </div>
</div>

@* ── First-run "what am I watching?" intro (#5) ───────────────────────────
   Dismissible; shown once per browser (persisted in localStorage). Answers the
   biggest comprehension gap: this is a spectator sim of AI agents, not a game
   you steer. *@
@if (_showIntro && !_isDemoRoute)
{
    <div class="sv-intro" role="dialog" aria-labelledby="sv-intro-title" data-testid="posurvive-intro">
        <div class="sv-intro__card app-reveal">
            <h2 id="sv-intro-title" class="sv-intro__title">🛡️ Welcome to Survive</h2>
            <p class="sv-intro__lead">
                Two teams of <strong>AI agents</strong> — <span class="sv-intro__red">Red</span> vs
                <span class="sv-intro__blue">Blue</span> — fight to be the last standing on the grid.
                You don't steer them; you <strong>watch and inspect</strong> their choices.
            </p>
            <ul class="sv-intro__steps">
                <li><span class="sv-intro__num">1</span> Press <strong>Start battle</strong> and watch the grid.</li>
                <li><span class="sv-intro__num">2</span> Click any agent to see <strong>why</strong> it moved.</li>
                <li><span class="sv-intro__num">3</span> Tap <strong>☆ Champion</strong> to adopt one and follow its fate.</li>
            </ul>
            <button class="sv-btn sv-btn--primary sv-btn--cta" @onclick="DismissIntro" data-testid="btn-intro-dismiss">
                Got it — let's watch
            </button>
        </div>
    </div>
}

@if (_downloadToastVisible)
{
    <div class="app-toast app-toast--@_downloadToastKind" role="status" aria-live="polite" data-testid="download-toast">
        @_downloadToastMessage
    </div>
}

@if (StalledAtTurnZero)
{
    <div class="runtime-alert" role="alert" data-testid="runtime-watchdog-alert">
        <span class="runtime-alert__title">INFERENCE WATCHDOG:</span>
        <span class="runtime-alert__text">No heartbeat progress for @StalledTurnThresholdSec seconds. Runtime may be degraded.</span>
        <button class="c64-btn runtime-alert__btn"
                @onclick="RecoverFromInferenceStall"
                data-testid="btn-recover-stall">
            [ RECOVER ]
        </button>
    </div>
}

@if (SimState.Value.TurnNumber > 0 || SimState.Value.IsRunning)
{
    @* Stats bar simplified (player request): collapsed from 10 metrics to 4 most
       important so the row stops dominating the viewport. Outcome / Pause / AI
       state still surface via inline toolbar chips when active. *@
    <div class="statsbar" data-testid="statsbar">
        <span class="statsbar__item statsbar__item--time" title="Elapsed wall-clock time since simulation start">⏱ @ElapsedFormatted</span>
        <span class="statsbar__sep">·</span>
        <span class="statsbar__item" title="Current simulation turn">TURN <strong>@SimState.Value.TurnNumber</strong></span>
        <span class="statsbar__sep">·</span>
        <span class="statsbar__item statsbar__item--red" title="Alive Red agents">🔴 @AliveRed</span>
        <span class="statsbar__item statsbar__item--blue" title="Alive Blue agents">🔵 @AliveBlue</span>
        @if (SimState.Value.IsPaused)
        {
            <span class="statsbar__sep">·</span>
            <span class="statsbar__item statsbar__item--paused">⏸ PAUSED</span>
        }
        @if (SimState.Value.Outcome is not null)
        {
            <span class="statsbar__sep">·</span>
            <span class="statsbar__item statsbar__item--outcome">@SimState.Value.Outcome.ToUpperInvariant()</span>
        }
    </div>
}

@* ── Champion strip (#2): persistent tracker for the agent the user adopted ── *@
@if (Champion is not null)
{
    <div class="sv-champion @(Champion.IsAlive ? "" : "sv-champion--fallen") @(Champion.Team == "Red" ? "sv-champion--red" : "sv-champion--blue")"
         data-testid="champion-strip">
        <span class="sv-champion__star">★</span>
        <span class="sv-champion__label">Your champion</span>
        <span class="sv-champion__id">@Champion.Id</span>
        <span class="sv-champion__stat" title="Health">❤ @Champion.Hp</span>
        <span class="sv-champion__stat" title="Kills">⚔ @Champion.KillCount</span>
        <span class="sv-champion__stat" title="Turns survived">⏳ @Champion.SurvivalTurns</span>
        <span class="sv-champion__state">@(Champion.IsAlive ? "ALIVE" : "FALLEN")</span>
        <button class="sv-champion__drop" @onclick="DropChampion" title="Drop champion" aria-label="Drop champion">✕</button>
    </div>
}

<div class="simulation-layout simulation-layout--@_activePane" data-testid="main-layout">
    <main class="simulation-layout__grid app-reveal">
        <div class="pane-header">BATTLE GRID</div>
        <div class="pane-body pane-body--grid">
            @Body
        </div>
    </main>

    <aside class="simulation-layout__sidebar app-reveal">
        <div class="pane-header pane-header--sidebar">DECISION + AGENT INTEL</div>
        <div class="pane-body pane-body--sidebar">
            @if (SimState.Value.IsRunning || SimState.Value.Agents.Count > 0)
            {
                @* SoundtrackControl removed from the always-visible sidebar (player request).
                   Still reachable from its own route if needed; the right rail now stays
                   focused on the decision intel and agent list. *@
                <DecisionInspector />
                <AgentSidebar />
            }
        </div>
    </aside>

    <footer class="simulation-layout__console app-reveal">
        <div class="pane-header pane-header--console">TACTICAL LOG</div>
        <div class="pane-body pane-body--console">
            @if (SimState.Value.IsRunning || SimState.Value.ConsoleLog.Count > 0)
            {
                <TacticalLog />
            }
        </div>
    </footer>
</div>

<PostMortemOverlay />

<ErrorBoundary>
    <ChildContent>@((MarkupString)"")</ChildContent>
    <ErrorContent Context="ex">
        @if (IsDev)
        {
            <div class="dev-error-overlay" role="alert">
                <h3>UNHANDLED EXCEPTION (DEV MODE)</h3>
                <pre>@ex.ToString()</pre>
            </div>
        }
    </ErrorContent>
</ErrorBoundary>

@code {
    private const int StalledTurnThresholdSec = 20;
    private string _activePane = "grid";

    private string InferenceIndicatorClass => BootState.Value.ProviderKind switch
    {
        "LOCAL"  => "toolbar__inference--local",
        "REMOTE" => "toolbar__inference--remote",
        "MOCK"   => "toolbar__inference--mock",
        _         => string.Empty,
    };

    // ── Compact toolbar model switcher ────────────────────────────────
    // Loads the same set of LOCAL (WebLLM) and REMOTE (Azure OpenAI / Foundry)
    // options as the Mission Control picker. Lets the player change model on the fly
    // without backing out to the idle screen.
    private List<PoMiniGamesClient.Games.PoSurvive.Services.ModelOption> ToolbarModelOptions { get; set; } = new();
    private bool _switchingModel;
    private string ToolbarSelectedModelId
    {
        get => BootState.Value.ModelId;
        set { /* value is driven by BootState; OnToolbarModelChanged dispatches updates */ }
    }

    private async Task OnToolbarModelChanged(ChangeEventArgs e)
    {
        var newId = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(newId) || newId == BootState.Value.ModelId) return;

        var selected = ToolbarModelOptions.FirstOrDefault(o => o.Id == newId);
        if (selected is null) return;

        _switchingModel = true;
        StateHasChanged();

        try
        {
            var isMock       = InferenceService is PoMiniGamesClient.Games.PoSurvive.Services.MockInferenceService;
            var providerKind = ModelBootstrap.ResolveProviderKind(isMock, selected.IsRemote);

            if (!isMock && InferenceRouterOrNull is { } router)
            {
                if (selected.IsRemote) router.UseRemote(selected.Id);
                else                   router.UseLocal();
            }

            Dispatcher.Dispatch(new ResetInferenceBootstrapAction());
            Dispatcher.Dispatch(new InferenceConfiguredAction(
                ProviderKind: providerKind,
                ModelId:      selected.Id,
                ModelLabel:   selected.Label));

            // Mock + remote models are ready instantly (no in-browser model download).
            // LOCAL WebLLM models require the multi-MB download kicked off by the
            // Mission Control picker's LoadSelectedModelAsync; here we only flip the
            // router + provider chip and let the user open Mission Control to start
            // the download if they want a local run.
            if (isMock || selected.IsRemote)
            {
                Dispatcher.Dispatch(new BootReadyAction());
            }
        }
        finally
        {
            _switchingModel = false;
        }
    }

    private bool StalledAtTurnZero
        => SimState.Value.IsRunning
            && !SimState.Value.IsMockProvider
            && SimState.Value.TurnNumber == 0
            && SimState.Value.StartedAt != default
            && (DateTimeOffset.UtcNow - SimState.Value.StartedAt).TotalSeconds >= StalledTurnThresholdSec;

    private bool HasInferenceIssue
        => BootState.Value.HasInferenceInitError
            || StalledAtTurnZero
            || (BootState.Value.ProviderKind == "LOCAL"
                && BootState.Value.IsReady
                && BootState.Value.TotalBytes > 0
                && BootState.Value.BytesLoaded == 0);

    private bool IsBootRoute => Nav.Uri.Contains("/boot", StringComparison.OrdinalIgnoreCase);

    private bool BootCanStartSimulation => BootState.Value.IsReady || BootState.Value.IsDegradedMode;

    private string DegradedModeSummary
        => "Fallback tactics are active because real inference is unavailable.";

    // Detail line shown inside the Advanced drawer (was a permanent toolbar chip).
    private string? InferenceDetailText
        => BootState.Value.IsDegradedMode ? DegradedModeSummary
        : HasInferenceIssue ? InferenceIssueSummary
        : null;

    // ── High-contrast toggle ──────────────────────────────────────────────
    // The high-contrast palette (high-contrast.css) keys off `body.high-contrast`.
    // No action was ever wired to it; this toggles the class directly via JS and
    // persists the choice so it survives navigation.
    private bool _highContrast;

    private async Task ToggleHighContrast()
    {
        _highContrast = !_highContrast;
        await JS.InvokeVoidAsync("PoSurviveTheme.setHighContrast", _highContrast);
    }

    private string InferenceIssueSummary
        => StalledAtTurnZero
            ? $"Turn watchdog triggered (>{StalledTurnThresholdSec}s at turn 0)."
            : BootState.Value.InferenceInitError is { Length: > 0 }
            ? SummarizeIssue(BootState.Value.InferenceInitError)
            : "Inference is unavailable.";

    private static string SummarizeIssue(string detail)
    {
        var clean = detail.Trim();
        if (clean.StartsWith("Inference error:", StringComparison.OrdinalIgnoreCase))
            clean = clean["Inference error:".Length..].Trim();

        const int max = 96;
        return clean.Length <= max ? clean : clean[..max] + "...";
    }

    private bool IsDev => HostEnv.IsDevelopment();

    private System.Threading.Timer? _clockTimer;

    // ── Auth chrome (mirrors MainLayout so the page <header> re-renders on
    //    sign-in / sign-out without the parent layout needing to drive it). ──
    private Action? _onAuthStateChanged;
    private string _devUser = string.Empty;
    private bool _switching;
    private string? _switchError;

    private bool ShowDevSwitch =>
        HostEnv.IsDevelopment() ||
        string.Equals(HostEnv.Environment, "Test", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // Keep the toolbar's compact model switcher populated from the same
        // configuration source as Mission Control.
        ToolbarModelOptions = ModelBootstrap.ReadAllModelOptions();
        _clockTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);

        // Mirror MainLayout: subscribe to auth changes so the <header> chrome
        // (Sign in / Sign out buttons) re-renders without a full page reload.
        _onAuthStateChanged = () => InvokeAsync(StateHasChanged);
        AuthState.StateChanged += _onAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            // Inject PoSurvive's stylesheets only while this layout is mounted so its
            // global CSS resets don't leak into the rest of the PoMiniGames platform.
            await JS.InvokeVoidAsync("PoSurviveTheme.load");
        }
    }

    // ── First-run intro (#5) + champion strip (#2) ────────────────────────
    private bool _showIntro;
    private bool _isDemoRoute => Nav.Uri.Contains("demo=1", StringComparison.OrdinalIgnoreCase)
        || Nav.Uri.Contains("/posurvive/demo", StringComparison.OrdinalIgnoreCase);

    private PoShared.Simulation.Models.AgentDto? Champion
        => SimState.Value.ChampionAgentId is { } id
            ? SimState.Value.Agents.FirstOrDefault(a => a.Id == id)
            : null;

    private void DropChampion() => Dispatcher.Dispatch(new ChampionSelectedAction(null));

    private async Task DismissIntro()
    {
        _showIntro = false;
        await JS.InvokeVoidAsync("localStorage.setItem", "posurvive_intro_seen", "1");
    }

    private int AliveRed  => SimState.Value.Agents.Count(a => a.IsAlive && a.Team == "Red");
    private int AliveBlue => SimState.Value.Agents.Count(a => a.IsAlive && a.Team == "Blue");
    private int TotalKills => SimState.Value.Agents.Sum(a => a.KillCount);
    private int AvgHp => SimState.Value.Agents.Any(a => a.IsAlive)
        ? (int)SimState.Value.Agents.Where(a => a.IsAlive).Average(a => a.Hp)
        : 0;

    private string ElapsedFormatted
    {
        get
        {
            if (SimState.Value.StartedAt == default) return "0:00";
            var elapsed = DateTimeOffset.UtcNow - SimState.Value.StartedAt;
            return elapsed.TotalHours >= 1
                ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}"
                : $"{elapsed.Minutes}:{elapsed.Seconds:D2}";
        }
    }

    private int SecsPerTurn
    {
        get
        {
            if (SimState.Value.TurnNumber < 2 || SimState.Value.StartedAt == default) return 0;
            var elapsed = (DateTimeOffset.UtcNow - SimState.Value.StartedAt).TotalSeconds;
            return (int)(elapsed / SimState.Value.TurnNumber);
        }
    }

    private void SetActivePane(string pane)
    {
        _activePane = pane;
    }

    private async Task StartSimulation()
    {
        var config = await LaunchService.BuildConfigAsync();

        Dispatcher.Dispatch(new StartSimulationAction(config, BootState.Value.IsMockProvider || BootState.Value.IsDegradedMode));
    }

    private void OnSpeedChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var ms))
            Dispatcher.Dispatch(new SpeedChangedAction(ms));
    }

    private void SetSpeedPreset(int speedMs)
        => Dispatcher.Dispatch(new SpeedChangedAction(speedMs));

    private string _downloadToastMessage = string.Empty;
    private string _downloadToastKind = "info";
    private bool _downloadToastVisible;
    private CancellationTokenSource? _downloadToastCts;

    private async Task DownloadLog()
    {
        var result = await LogService.DownloadLogAsync();
        ShowDownloadToast(result.Message, result.Success ? "success" : "error");
    }

    private void ShowDownloadToast(string message, string kind)
    {
        _downloadToastMessage = message;
        _downloadToastKind = kind;
        _downloadToastVisible = true;

        _downloadToastCts?.Cancel();
        _downloadToastCts?.Dispose();
        _downloadToastCts = new CancellationTokenSource();

        _ = DismissToastAsync(_downloadToastCts.Token);
    }

    private async Task DismissToastAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(3200, ct);
            _downloadToastVisible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ResetSimulation()
        => Dispatcher.Dispatch(new ResetSimulationAction());

    private void PauseSimulation()
        => Dispatcher.Dispatch(new PauseSimulationAction());

    private void ResumeSimulation()
        => Dispatcher.Dispatch(new ResumeSimulationAction());

    private async Task RecoverFromInferenceStall()
    {
        Dispatcher.Dispatch(new ResetSimulationAction());
        await Task.Yield();
        await StartSimulation();
    }

    void IDisposable.Dispose()
    {
        _clockTimer?.Dispose();
        _downloadToastCts?.Cancel();
        _downloadToastCts?.Dispose();
        // Remove PoSurvive's stylesheets so the platform's styling is restored on exit.
        _ = JS.InvokeVoidAsync("PoSurviveTheme.unload");

        // Detach the auth-state subscription wired up in OnInitialized so this
        // layout doesn't leak event handlers on re-creation.
        if (_onAuthStateChanged is not null)
        {
            AuthState.StateChanged -= _onAuthStateChanged;
        }
    }

    // ── Auth chrome handlers (mirror MainLayout so the page <header> behaves
    //    identically to the home page when the player taps Sign in / Sign out /
    //    Continue as anonymous). ─────────────────────────────────────────────
    private async Task SignIn()    => await AuthState.SignInAsync();
    private async Task SignOut()   => await AuthState.SignOutAsync();
    private async Task SignInAnon() => await AuthState.DevBypassAsync("ANON");

    private async Task SwitchDevUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_devUser)) return;
        _switching = true;
        _switchError = null;
        try
        {
            await AuthState.DevBypassAsync(_devUser.Trim());
            ToastService.Show($"Signed in as {_devUser.Trim()}", ToastType.Success);
            _devUser = string.Empty;
        }
        catch (Exception ex)
        {
            _switchError = ex.Message;
        }
        finally
        {
            _switching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

}
