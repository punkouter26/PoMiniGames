@page "/posurvive"
@page "/posurvive/{Mode}"
@* PoSurvive intentionally uses its own `PoSurviveLayout` (C64 retro theme)
   instead of the standard `MainLayout` and renders without `GameShell`.
   The opt-out is deliberate — its CRT-styled shell and SurviveStore are part of
   the game's identity and pre-date the PoMiniGames shell contract. See AGENT.MD
   for the architectural decision log.

   It does NOT opt out of the shared end-of-game modal: PostMortemOverlay renders
   the same <GameOverModal> every other game ends on (2026-07-16). The former
   "Mission Control" idle screen is gone too — the arena starts on navigation. *@
@layout PoSurviveLayout
@using PoMiniGamesClient.Games.PoSurvive.Features.Grid
@using PoMiniGamesClient.Games.PoSurvive.Services
@using PoMiniGamesClient.Services
@using PoMiniGamesClient.Games.PoSurvive.Store
@inherits SurviveComponentBase
@implements IDisposable
@inject KioskCoordinator         Kiosk
@inject GameStatsService         GameStats
@inject PoMiniGamesClient.Games.PoSurvive.Services.SimulationLaunchService LaunchService
@inject PoMiniGamesClient.Games.PoSurvive.Services.InferenceBootstrapper Bootstrapper

<div data-testid="grid-container">
    @* 2026-07-16: the "Mission Control" idle screen was removed. It was an intro
       page between the home page and the game — a model picker, a 3-step
       checklist, and a [ FOCUS START ] button that didn't even start the sim, it
       just highlighted a [ START ] button in the command bar. The arena now
       launches on navigation (see OnAfterRender -> BootArenaAsync), falling back
       to degraded mode when no model is loaded so it never blocks on a download.
       Model switching lives on the command bar's Advanced drawer. *@
    <GridBoard />
</div>

@code {
    // The model picker / loader that used to live on this page went with the
    // Mission Control screen (2026-07-16). Inference is switched from the
    // command bar's picker in PoSurviveLayout.

    // ── Demo (kiosk auto-cycle, mirrors PoCoupleQuiz demo pattern) ─────
    // Lands on /posurvive?demo=1, bypasses Mission Control, runs a
    // deterministic two-team match in degraded/mock mode at fast speed,
    // and loops on post-mortem. The KioskCoordinator owns the 20-24s
    // rotation between demo pages; this loop keeps the simulation itself
    // playing continuously while the page is on screen.
    /// <summary>Route mode segment: "1player" | "demo" (?demo=1 is the legacy form).</summary>
    [Parameter] public string? Mode { get; set; }
    [SupplyParameterFromQuery(Name = "demo")] public int DemoQuery { get; set; } = 0;
    [SupplyParameterFromQuery(Name = "kiosk")] public int KioskNext { get; set; } = -1;
    private bool _isDemo;
    // Guards the one-shot launch on first render (demo reel or real play).
    private bool _booted;
    private bool _lastShowPostMortem;
    private System.Threading.Timer? _demoLoopTimer;
    private const int DemoHeartbeatMs = 250;        // 4 turns/sec — fast enough for a 10-15s match
    private const int DemoRestartDelayMs = 3_500;   // how long the post-mortem stays on screen
    private const int DemoPreLaunchDelayMs = 500;   // brief gap so the reset+launch pair is visible

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (DemoQuery == 1 || Mode is "demo")
        {
            _isDemo = true;
            // Register the demo with the KioskCoordinator so the on-screen
            // countdown / pause / skip / exit controls pick this game up.
            Kiosk.SetCurrent("posurvive-demo");
        }
    }


    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (_booted) return;
        // First render: kick off the simulation. Doing it here (vs OnInitialized)
        // gives the store a chance to subscribe state-change handlers before we
        // start dispatching.
        _booted = true;

        // Survive is a simulation — no outcome and no score — so a session count is
        // the only stat the profile can report for it truthfully. Demo is excluded:
        // the kiosk auto-cycles every demo game, and counting those would report
        // sessions the player never chose to start. The counter goes through
        // localStorage, so it belongs after first render like the boot above.
        if (!_isDemo)
        {
            GameStats.RecordPlay("posurvive");
        }

        if (_isDemo)
        {
            _lastShowPostMortem = Store.Simulation.ShowPostMortem;
            Store.Changed += OnSimStateChanged;
            _ = InvokeAsync(BootDemoAsync);
        }
        else
        {
            _ = InvokeAsync(BootArenaAsync);
        }
    }

    // Real play now auto-launches, replacing the Mission Control screen + the
    // command bar's [ START ]. If inference isn't ready we enter degraded mode
    // rather than gate the game behind a model download — the same escape hatch
    // Mission Control offered as "[ PLAY NOW — FALLBACK AI ]", just automatic.
    // The command bar's [ START ] still exists for relaunching after a reset.
    // How long to give a provider before starting anyway. The cloud relay resolves in one
    // round trip, so the common path never waits near this long; it exists for the
    // in-browser model, whose first load is a real download. A late-finishing download
    // upgrades the NEXT battle rather than stalling this one — the page still never blocks.
    private static readonly TimeSpan BootGrace = TimeSpan.FromSeconds(12);

    private async Task BootArenaAsync()
    {
        // Kick the bootstrap off and give it a bounded moment. Without this the page went
        // straight to ContinueDegradedMode() on every single visit, because nothing had ever
        // set Boot.IsReady — which is what made the entire LLM feature unreachable.
        await Bootstrapper.EnsureStartedAsync();
        await Bootstrapper.WaitForReadyAsync(BootGrace);

        if (!CanLaunchSimulation)
        {
            Store.ContinueDegradedMode();
            await Task.Yield();
        }

        var config = await LaunchService.BuildConfigAsync();
        Store.StartSimulation(
            config, Store.Boot.IsMockProvider || Store.Boot.IsDegradedMode);
    }

    private bool CanLaunchSimulation
        => Store.Boot.IsReady || Store.Boot.IsDegradedMode;

    // ── Demo drivers ───────────────────────────────────────────────────
    // BootDemoAsync runs once when the demo page first renders. It:
    //   1. forces the BootState to "ready" via the degraded-mode path
    //      (no model download, mock inference; matches what the live
    //      degraded-mode play would do),
    //   2. cranks the heartbeat to 250ms so a match resolves in ~10-15s,
    //   3. starts the simulation with a small deterministic config
    //      (TeamSize 2, generous food spawn).
    // The state-change subscription (OnSimStateChanged) handles the
    // post-mortem → reset → re-launch cycle.
    private async Task BootDemoAsync()
    {
        if (!_isDemo) return;

        // Force degraded mode so the layout renders the grid instead of
        // Mission Control. The store treats degraded as ready.
        Store.ContinueDegradedMode();

        // Crank speed — mock inference + tiny grid = much faster than the
        // default 900ms/turn. Keeps the demo snappy on the kiosk reel.
        Store.SetSpeed(DemoHeartbeatMs);

        await Task.Yield();

        var config = await LaunchService.BuildConfigAsync();
        Store.StartSimulation(config, isMockProvider: true);
    }

    // State-change handler: when the simulation finishes and the
    // post-mortem overlay appears, schedule a reset + re-launch after a
    // short pause so the kiosk viewer sees the narrative + outcome, then
    // a fresh match starts. We track the previous value of ShowPostMortem
    // so the timer only fires on the false→true edge transition (not on
    // every state change while the overlay is up).
    private void OnSimStateChanged()
    {
        if (!_isDemo) return;
        var showPostMortem = Store.Simulation.ShowPostMortem;
        if (showPostMortem && !_lastShowPostMortem)
        {
            _demoLoopTimer?.Dispose();
            _demoLoopTimer = new System.Threading.Timer(
                _ => InvokeAsync(DemoRestartAsync),
                null,
                DemoRestartDelayMs,
                System.Threading.Timeout.Infinite);
        }
        _lastShowPostMortem = showPostMortem;
    }

    private async Task DemoRestartAsync()
    {
        if (!_isDemo) return;
        _demoLoopTimer?.Dispose();
        _demoLoopTimer = null;

        // Reset clears SimState (turn → 0, IsRunning → false, post-mortem
        // hidden), then we re-launch a fresh match.
        Store.ResetSimulation();
        Store.SetSpeed(DemoHeartbeatMs);

        await Task.Delay(DemoPreLaunchDelayMs);
        if (!_isDemo) return;

        var config = await LaunchService.BuildConfigAsync();
        Store.StartSimulation(config, isMockProvider: true);
    }

    public override void Dispose()
    {
        base.Dispose();
        _demoLoopTimer?.Dispose();
        _demoLoopTimer = null;
        // Only the demo reel subscribes (for its post-mortem → relaunch loop).
        if (_isDemo && _booted)
        {
            Store.Changed -= OnSimStateChanged;
        }
    }

}

