@page "/posurvive"
@page "/posurvive/{Mode}"
@* PoSurvive intentionally uses its own `PoSurviveLayout` (C64 retro theme)
   instead of the standard `MainLayout` and renders without `GameShell`.
   The opt-out is deliberate — its CRT-styled shell and SurviveStore are part of
   the game's identity and pre-date the PoMiniGames shell contract. See AGENT.MD
   for the architectural decision log.

   It does NOT opt out of the shared end-of-game modal: PostMortemOverlay renders
   the same <GameOverModal> every other game ends on (2026-07-16). The former
   "Mission Control" idle screen is gone too — the arena starts on navigation. *@
@layout PoSurviveLayout
@using PoMiniGamesClient.Games.PoSurvive.Features.Grid
@using PoMiniGamesClient.Games.PoSurvive.Services
@using PoMiniGamesClient.Services
@using PoMiniGamesClient.Games.PoSurvive.Store
@inherits SurviveComponentBase
@implements IDisposable
@inject KioskCoordinator         Kiosk
@inject GameStatsService         GameStats
@inject PoMiniGamesClient.Games.PoSurvive.Services.SimulationLaunchService LaunchService
@inject PoMiniGamesClient.Games.PoSurvive.Services.InferenceBootstrapper Bootstrapper

<PageTitle>Survive · PoMiniGames</PageTitle>

<div data-testid="grid-container">
    @* 2026-07-16: the "Mission Control" idle screen was removed. It was an intro
       page between the home page and the game — a model picker, a 3-step
       checklist, and a [ FOCUS START ] button that didn't even start the sim, it
       just highlighted a [ START ] button in the command bar. The arena now
       launches on navigation (see OnAfterRender -> BootArenaAsync), falling back
       to degraded mode when no model is loaded so it never blocks on a download.
       Model switching lives on the command bar's Advanced drawer. *@
    <GridBoard />
</div>

@code {
    // The model picker / loader that used to live on this page went with the
    // Mission Control screen (2026-07-16). Inference is switched from the
    // command bar's picker in PoSurviveLayout.

    // ── Demo (kiosk auto-cycle, mirrors PoCoupleQuiz demo pattern) ─────
    // Lands on /posurvive?demo=1, runs a two-team match on the scripted
    // provider at fast speed, and loops on post-mortem. The KioskCoordinator
    // owns the 20-24s rotation between demo pages; this loop keeps the
    // simulation itself playing continuously while the page is on screen.
    //
    // Scripted is the DEFAULT here, not the only option (2026-07-30). Picking a
    // real model from the command bar's selector switches the demo to live
    // inference — see OnSimStateChanged / GoLiveAsync. The reel stays free and
    // fast until someone asks for the real thing.
    /// <summary>Route mode segment: "1player" | "demo" (?demo=1 is the legacy form).</summary>
    [Parameter] public string? Mode { get; set; }
    [SupplyParameterFromQuery(Name = "demo")] public int DemoQuery { get; set; } = 0;
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "kiosk")] public int KioskNext { get; set; } = -1;
    private bool _isDemo;
    // Guards the one-shot launch on first render (demo reel or real play).
    private bool _booted;
    private bool _lastShowPostMortem;
    private bool _liveDemo;
    private bool _relaunchScheduled;
    private System.Threading.Timer? _demoLoopTimer;
    private const int DemoHeartbeatMs = 250;        // 4 turns/sec — fast enough for a 10-15s match
    private const int DemoRestartDelayMs = 3_500;   // how long the post-mortem stays on screen
    private const int DemoPreLaunchDelayMs = 500;   // brief gap so the reset+launch pair is visible

    /// <summary>
    /// Turn interval once the demo is running on a real model. 250 ms is a scripted-only speed:
    /// a relay round trip measures 1.0-2.6 s at MaxInferredAgentsPerTurn=1, so a heartbeat that
    /// fast would spend the whole match on standing orders and show none of the model's work.
    /// </summary>
    private const int LiveDemoHeartbeatMs = 1_200;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (GameModes.Parse(Mode, ModeQuery, DemoQuery) == GameMode.Demo)
        {
            _isDemo = true;
            // Register the demo with the KioskCoordinator so the on-screen
            // countdown / pause / skip / exit controls pick this game up.
            Kiosk.SetCurrent("posurvive-demo");

            // Before ANY render, so it lands ahead of the layout's own
            // EnsureStartedAsync: probe the relay to populate the model picker, but never
            // start a WebLLM download on an attract screen.
            Bootstrapper.UseKioskProfile();
        }
    }


    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (_booted) return;
        // First render: kick off the simulation. Doing it here (vs OnInitialized)
        // gives the store a chance to subscribe state-change handlers before we
        // start dispatching.
        _booted = true;

        // Survive is a simulation — no outcome and no score — so a session count is
        // the only stat the profile can report for it truthfully. Demo is excluded:
        // the kiosk auto-cycles every demo game, and counting those would report
        // sessions the player never chose to start. The counter goes through
        // localStorage, so it belongs after first render like the boot above.
        if (!_isDemo)
        {
            GameStats.RecordPlay("posurvive");
        }

        // Both routes subscribe now: the demo needs the post-mortem → relaunch loop, and BOTH
        // need to notice a model picked from the command bar (the selector is on the bar in
        // every mode, so the restart-on-pick rule has to live in one place for both).
        _lastShowPostMortem = Store.Simulation.ShowPostMortem;
        Store.Changed += OnSimStateChanged;
        Store.ProviderPickedByUser += OnProviderPickedByUser;

        _ = InvokeAsync(_isDemo ? BootDemoAsync : BootArenaAsync);
    }

    // Real play now auto-launches, replacing the Mission Control screen + the
    // command bar's [ START ]. If inference isn't ready we enter degraded mode
    // rather than gate the game behind a model download — the same escape hatch
    // Mission Control offered as "[ PLAY NOW — FALLBACK AI ]", just automatic.
    // The command bar's [ START ] still exists for relaunching after a reset.
    // How long to give a provider before starting anyway. The cloud relay resolves in one
    // round trip, so the common path never waits near this long; it exists for the
    // in-browser model, whose first load is a real download. A late-finishing download
    // upgrades the NEXT battle rather than stalling this one — the page still never blocks.
    private static readonly TimeSpan BootGrace = TimeSpan.FromSeconds(12);

    private async Task BootArenaAsync()
    {
        // Kick the bootstrap off and give it a bounded moment. Without this the page went
        // straight to ContinueDegradedMode() on every single visit, because nothing had ever
        // set Boot.IsReady — which is what made the entire LLM feature unreachable.
        await Bootstrapper.EnsureStartedAsync();
        await Bootstrapper.WaitForReadyAsync(BootGrace);

        if (!CanLaunchSimulation)
        {
            Store.ContinueDegradedMode();
            await Task.Yield();
        }

        var config = await LaunchService.BuildConfigAsync();
        Store.StartSimulation(config);
    }

    private bool CanLaunchSimulation
        => Store.Boot.IsReady || Store.Boot.IsDegradedMode;

    // ── Demo drivers ───────────────────────────────────────────────────
    // BootDemoAsync runs once when the demo page first renders. It:
    //   1. runs the bootstrap under the kiosk profile — relay probed so the
    //      model selector is populated, scripted provider selected, no
    //      download started,
    //   2. cranks the heartbeat to 250ms so a match resolves in ~10-15s,
    //   3. starts the simulation on the stock config.
    // The state-change subscription (OnSimStateChanged) handles both the
    // post-mortem → reset → re-launch cycle and the switch to live inference
    // when the player picks a model.
    private async Task BootDemoAsync()
    {
        if (!_isDemo) return;

        // UseKioskProfile() ran in OnInitialized, so this settles on the scripted provider
        // (ready, no download) after one cheap status probe. ContinueDegradedMode() used to
        // stand in for this, which meant the reel always claimed the AI had FAILED — and
        // pinned it to the fallback table's "standing by" filler instead of the scripted
        // per-trait prose this mode is written around.
        await Bootstrapper.EnsureStartedAsync();

        // Crank speed — scripted inference + tiny grid = much faster than the
        // default 900ms/turn. Keeps the demo snappy on the kiosk reel.
        Store.SetSpeed(DemoHeartbeatMs);

        await Task.Yield();

        var config = await LaunchService.BuildConfigAsync();
        Store.StartSimulation(config);
    }

    // State-change handler, watching two edges:
    //
    //   ShowPostMortem false→true — schedule a reset + re-launch after a short pause so the
    //   kiosk viewer sees the narrative + outcome, then a fresh match starts. Suppressed once
    //   the demo is live: a real match costs quota and minutes, so it plays once.
    //
    //   ProviderKind scripted→LOCAL/REMOTE — the player picked a model from the command bar.
    //   Relaunch on it (GoLiveAsync). The reverse edge hands the reel back.
    //
    // We track the previous values so each fires on the transition only, not on every state
    // change while the condition holds.
    private void OnSimStateChanged()
    {
        if (!_isDemo) return;

        var isLiveProvider = Store.Boot.IsReady
            && !Store.Boot.IsMockProvider
            && !Store.Boot.IsDegradedMode
            && Store.Boot.ProviderKind is "LOCAL" or "REMOTE";

        if (isLiveProvider != _liveDemo && !_relaunchScheduled)
        {
            // Deferred, never inline: this handler runs inside Store.Emit(), and the relaunch
            // emits again. InvokeAsync also gets us onto the renderer's context.
            _relaunchScheduled = true;
            _ = InvokeAsync(() => SwitchDemoModeAsync(goLive: isLiveProvider));
        }

        var showPostMortem = Store.Simulation.ShowPostMortem;
        if (showPostMortem && !_lastShowPostMortem && !_liveDemo)
        {
            _demoLoopTimer?.Dispose();
            _demoLoopTimer = new System.Threading.Timer(
                _ => InvokeAsync(DemoRestartAsync),
                null,
                DemoRestartDelayMs,
                System.Threading.Timeout.Infinite);
        }

        _lastShowPostMortem = showPostMortem;
    }

    /// <summary>
    /// Moves the demo between its two modes and restarts the battle on the new provider.
    ///
    /// Live: one match, at a heartbeat a model can actually answer inside, with the kiosk
    /// rotation paused so the page isn't swapped out mid-thought. Reel: back to the fast
    /// scripted loop and the rotation resumes.
    /// </summary>
    private async Task SwitchDemoModeAsync(bool goLive)
    {
        try
        {
            if (!_isDemo) return;

            _liveDemo = goLive;
            _demoLoopTimer?.Dispose();
            _demoLoopTimer = null;

            if (goLive)
            {
                Kiosk.Pause();
            }
            else
            {
                Kiosk.Resume();
            }

            Store.ResetSimulation();
            Store.SetSpeed(goLive ? LiveDemoHeartbeatMs : DemoHeartbeatMs);

            await Task.Delay(DemoPreLaunchDelayMs);
            if (!_isDemo) return;

            var config = await LaunchService.BuildConfigAsync();
            Store.StartSimulation(config);
        }
        finally
        {
            _relaunchScheduled = false;
        }
    }

    /// <summary>
    /// The player picked a model from the command bar's selector. Both routes subscribe (the
    /// selector is on the bar in every mode), but only real play acts here.
    ///
    /// Demo already owns this transition: <see cref="OnSimStateChanged"/> watches the
    /// scripted↔live provider edge and routes it through SwitchDemoModeAsync, which also
    /// re-speeds the heartbeat and pauses the kiosk rotation. Relaunching here as well would
    /// double-start the match — hence the early return rather than a shared code path.
    ///
    /// Real play has no such edge watcher, so without this a mid-match pick swapped the
    /// router underneath a simulation that kept running on the old provider's turn budget.
    /// </summary>
    private void OnProviderPickedByUser()
    {
        if (_isDemo) return;

        // Deferred, never inline: this fires from inside the store's notify path, and the
        // relaunch below emits again. InvokeAsync also gets us onto the renderer's context.
        _ = InvokeAsync(RelaunchOnPickedProviderAsync);
    }

    // Reset before launch so the new provider starts from turn 0 rather than inheriting the
    // half-played board — the agents' memory is provider-specific and does not transfer.
    private async Task RelaunchOnPickedProviderAsync()
    {
        if (_isDemo) return;

        Store.ResetSimulation();
        await Task.Yield();

        if (!CanLaunchSimulation)
        {
            // A pick that cannot boot (download still running, relay unreachable) must not
            // leave the page on a dead reset screen — fall through to the fallback AI, the
            // same escape hatch BootArenaAsync uses.
            Store.ContinueDegradedMode();
            await Task.Yield();
        }

        var config = await LaunchService.BuildConfigAsync();
        Store.StartSimulation(config);
    }

    private async Task DemoRestartAsync()
    {
        if (!_isDemo || _liveDemo) return;
        _demoLoopTimer?.Dispose();
        _demoLoopTimer = null;

        // Reset clears SimState (turn → 0, IsRunning → false, post-mortem
        // hidden), then we re-launch a fresh match.
        Store.ResetSimulation();
        Store.SetSpeed(DemoHeartbeatMs);

        await Task.Delay(DemoPreLaunchDelayMs);
        if (!_isDemo || _liveDemo) return;

        var config = await LaunchService.BuildConfigAsync();
        Store.StartSimulation(config);
    }

    public override void Dispose()
    {
        base.Dispose();
        _demoLoopTimer?.Dispose();
        _demoLoopTimer = null;
        // Both handlers are subscribed unconditionally in OnAfterRender, so both must come
        // off unconditionally. The previous `_isDemo &&` guard leaked the whole page (and the
        // store's reference to it) on every real-play visit, because OnSimStateChanged's own
        // `if (!_isDemo) return` makes the handler a no-op but does NOT drop the subscription.
        if (_booted)
        {
            Store.Changed -= OnSimStateChanged;
            Store.ProviderPickedByUser -= OnProviderPickedByUser;
        }
    }

}

