@page "/povoxelstrike/multi"
@using PoMiniGames.Shared.Games
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Games.PoVoxelStrike.Services
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject ApiService Api
@inject ToastService ToastService
@inject PoVoxelStrikeMultiplayerClient Hub
@implements IAsyncDisposable

<PageTitle>Voxel Strike — Lobby · PoMiniGames</PageTitle>

<GameShell Title="@TitleContent" BackTo="/">
@if (!_introDone)
{
    <GameIntro CueScope="povoxelstrike"
               Title="@TitleContent"
               Objective="Survive the arena together. Carve the world apart and drop it on whatever chases you — debris crushes the lot of you, friend or foe."
               Controls="@HowToPlayContent"
               Mode="GameIntro.IntroMode.OnePlayer"
               OnStart="OnIntroStartAsync" />
}
else
{
    <LobbyPanel TPlayer="PoVoxelStrikeLobbyPlayer"
                State="@Hub.Lobby.State"
                LocalConnectionId="@Hub.LobbyConnectionId"
                ConnectionState="@Hub.Lobby.ConnectionState"
                Hint="Single shared room — first to arrive becomes host. Up to 6."
                MaxPlayersHint="6"
                StartLabel="Start the Run"
                OnReady="Hub.ToggleReadyAsync"
                OnStart="Hub.StartGameAsync"
                OnLeave="LeaveAsync">
        <PlayerLabel Context="p">
            <span class="lobby-pill lobby-pill--muted">P@(p.PlayerNumber)</span> @p.DisplayName
        </PlayerLabel>
    </LobbyPanel>
}
</GameShell>

@code {
    private bool _introDone;
    /// <summary>Set when navigating to the engine — that nav must KEEP the lobby seat.</summary>
    private bool _starting;

    private RenderFragment TitleContent => @<span><span aria-hidden="true">🧱</span> Voxel Strike · Multiplayer</span>;

    private RenderFragment HowToPlayContent => @<div>
        <p>You and your crew carve the world apart — debris crushes everyone.</p>
        <ul>
            <li>Mouse aims, <kbd>WASD</kbd> moves, <kbd>Shift</kbd> runs</li>
            <li>Hold <kbd>Click</kbd> to carve; <kbd>R</kbd> or right-click lobs a blast ball</li>
            <li>Pointer-lock lost (Esc, tab) pauses for everyone in the room</li>
        </ul>
    </div>;

    private async Task OnIntroStartAsync()
    {
        _introDone = true;
        StateHasChanged();
        if (!await Api.IsAvailableAsync())
        {
            ToastService.Show("Server unavailable. Try Single Player mode.", ToastType.Error);
            return;
        }
        Hub.Lobby.StateChanged += OnLobbyChanged;
        Hub.Lobby.ConnectionChanged += OnConnectionChanged;
        Hub.Lobby.EventReceived += OnLobbyEvent;
        Hub.Lobby.GameStarted += OnGameStarted;
        await Hub.ConnectLobbyAsync(AuthState.User?.DisplayName ?? "Player", !AuthState.IsAuthenticated);
        StateHasChanged();
    }

    private void OnLobbyChanged(LobbyState<PoVoxelStrikeLobbyPlayer> _) => InvokeAsync(StateHasChanged);
    private void OnConnectionChanged(Microsoft.AspNetCore.SignalR.Client.HubConnectionState _) => InvokeAsync(StateHasChanged);

    private void OnLobbyEvent(LobbyEvent ev) => ToastService.Show(ev.Message, ev.Kind switch
    {
        "left" => ToastType.Warning,
        "starting" => ToastType.Success,
        _ => ToastType.Info,
    });

    private void OnGameStarted(string gameCode)
    {
        // The host pressed Start — every peer navigates to the engine in multiplayer mode.
        _starting = true;
        Nav.NavigateTo($"/povoxelstrike/multi/{gameCode}");
    }

    private async Task LeaveAsync()
    {
        _starting = false;
        await Hub.LeaveLobbyAsync();
        Nav.NavigateTo("/povoxelstrike");
    }

    public async ValueTask DisposeAsync()
    {
        Hub.Lobby.StateChanged -= OnLobbyChanged;
        Hub.Lobby.ConnectionChanged -= OnConnectionChanged;
        Hub.Lobby.EventReceived -= OnLobbyEvent;
        Hub.Lobby.GameStarted -= OnGameStarted;
        // If we navigated to the engine, KEEP the lobby seat (the engine page leaves when the
        // run ends). Otherwise the wrapper's dispose closes the socket and the server's
        // disconnect handler runs Leave — exactly what we want.
        if (!_starting)
        {
            await Hub.LeaveLobbyAsync();
            await Hub.DisposeAsync();
        }
    }
}
