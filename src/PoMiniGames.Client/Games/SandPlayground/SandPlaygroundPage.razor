@page "/sandplayground"
@page "/sandplayground/{Mode}"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@inject PlayerNameService PlayerNameService

<PageTitle>SandPlayground</PageTitle>

@* Fullscreen: the sandbox sizes itself to the game area (see
   SandPlaygroundSandbox.razor.css) rather than sitting in a padded card, which is what
   lets the canvas take the screen on a phone without the component having to
   pin itself over the app top bar. *@
<GameShell Title=@TitleContent
           Player="@_playerName"
           BackTo="/"
           GameKey="sandplayground"
           RequiresWebGl="true"
           Fullscreen="true">

    @* Gated rather than overlaid: the WebGL context, the rAF loop and the
       AudioContext should not start behind the intro card. Starting on the
       intro's own click also means the first audio call follows a real user
       gesture, so nothing is created suspended. *@
    @if (!_introDismissed)
    {
        <GameIntro CueScope="sandplayground"
                   Title=@TitleContent
                   Objective="A GPU physics sandbox — dig, flood, build, then blow it apart."
                   Controls=@HowToPlayContent
                   Mode="@(IsDemo ? GameIntro.IntroMode.Demo : GameIntro.IntroMode.OnePlayer)"
                   OnStart="@(() => _introDismissed = true)" />
    }
    else
    {
        <SandPlaygroundSandbox IsDemo="IsDemo" />
    }
</GameShell>

@code {
    [Parameter] public string? Mode { get; set; }

    private string _playerName = "";
    private bool _introDismissed;

    private bool IsDemo => GameModes.Parse(Mode) == GameMode.Demo;

    private RenderFragment TitleContent => @<span><span aria-hidden="true">🏜️</span> SandPlayground</span>;

    private RenderFragment HowToPlayContent => @<div>
        @* 2026-09-11: word budget — the intro card is capped at 100 words. Each
           tool keeps one behavioural hook; the material-science derivation
           (critical spans, pore space, hydrostatics) lives in the simulation,
           not the welcome card. *@
        <p><strong>Pick a tool, then drag on the world:</strong></p>
        <ul>
            <li><strong>Dig Vacuum:</strong> extracts sand and water; concrete and bedrock are immune</li>
            <li><strong>Sand:</strong> stands in cuts, roofs tunnels, avalanches past a critical span</li>
            <li><strong>Concrete Bar:</strong> rigid — undermine it and it falls as one body</li>
            <li><strong>Water:</strong> levels itself, soaks into loose ground, weeps back out</li>
            <li><strong>TNT:</strong> slingshot a fused bomb — deep bursts seal cavities, surface ones vent</li>
            <li><strong>Water Balloon:</strong> slingshot an impact burst</li>
        </ul>
        <p><strong>Auto-drop</strong>, <strong>Pause</strong>/<strong>Step</strong> and <strong>Reset</strong> sit in the toolbar.</p>
    </div>;

    protected override void OnInitialized()
    {
        _playerName = PlayerNameService.GetPlayerName();
    }
}
