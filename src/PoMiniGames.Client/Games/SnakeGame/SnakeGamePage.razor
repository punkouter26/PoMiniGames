@page "/snakegame"
@page "/posnakegame"
@using PoMiniGamesClient.Components;
@using PoMiniGamesClient.Enums;
@using PoMiniGamesClient.Models;
@using PoMiniGamesClient.Games.SnakeGame;
@using PoMiniGamesClient.Services;
@inject NavigationManager Navigation;
@inject PlayerNameService PlayerNameService;
@inject IJSRuntime JSRuntime;

<GameShell 
    Title=@TitleContent 
    Player="@_playerName"
    BackTo="/"
    GameOver="@(_gameResult != GameResult.InProgress)"
    OnPlayAgain="ResetGame"
    ShowSettings="true"
    Stats="@_statItems"
    Status="@StatusContent"
    GameSummary="@GameSummaryContent"
    Controls="@ControlsContent">
    
    <div class="snake-game-wrapper" tabindex="0" @onkeydown="HandleKeyDown" @ref="_gameWrapper">
        <div class="snake-board" style="--cols: @SnakeBoard.Cols; --rows: @SnakeBoard.Rows;">
            @for (int r = 0; r < SnakeBoard.Rows; r++)
            {
                @for (int c = 0; c < SnakeBoard.Cols; c++)
                {
                    var row = r;
                    var col = c;
                    <div class="snake-cell @GetCellClass(row, col)"
                         @onclick="() => HandleCellClick(row, col)">
                    </div>
                }
            }
        </div>
        
        <div class="snake-score-display">
            <div class="snake-score-label">Score</div>
            <div class="snake-score-value">@_score</div>
        </div>
        
        <div class="snake-instructions">
            @if (!_gameStarted && _gameResult == GameResult.InProgress)
            {
                <button class="snake-start-btn" style="font-size:1.1rem;padding:0.5rem 1.4rem;margin-bottom:0.4rem;cursor:pointer;" @onclick="StartGame">▶ Start</button>
                <p>Press an arrow key / WASD, or use the buttons below</p>
            }
            else
            {
                <p>Arrow Keys / WASD or the buttons below</p>
            }
            <div class="snake-dpad" style="display:flex;flex-direction:column;align-items:center;gap:0.35rem;margin-top:0.4rem;">
                <button class="snake-dpad-btn" style="width:3rem;height:3rem;font-size:1.2rem;cursor:pointer;" @onclick="@(() => Steer(-1, 0))" aria-label="Up">▲</button>
                <div style="display:flex;gap:0.35rem;">
                    <button class="snake-dpad-btn" style="width:3rem;height:3rem;font-size:1.2rem;cursor:pointer;" @onclick="@(() => Steer(0, -1))" aria-label="Left">◀</button>
                    <button class="snake-dpad-btn" style="width:3rem;height:3rem;font-size:1.2rem;cursor:pointer;" @onclick="@(() => Steer(1, 0))" aria-label="Down">▼</button>
                    <button class="snake-dpad-btn" style="width:3rem;height:3rem;font-size:1.2rem;cursor:pointer;" @onclick="@(() => Steer(0, 1))" aria-label="Right">▶</button>
                </div>
            </div>
        </div>
    </div>
</GameShell>

@code {
    private SnakeBoard _board = new();
    private int _score => _board.Score;
    private string _playerName = "";
    private List<StatItem> _statItems = new();
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    private GameResult _gameResult = GameResult.InProgress;
    private Difficulty _difficulty = Difficulty.Medium;
    private System.Threading.Timer? _gameTimer;
    private bool _gameStarted;
    private ElementReference _gameWrapper;

    private RenderFragment TitleContent => @<span>🐍 Snake Game</span>;

    private RenderFragment StatusContent => @<span class="gps-status-badge turn">Score @_score</span>;
    private RenderFragment? GameSummaryContent => _gameResult != GameResult.InProgress
        ? @<span class="cf-result cf-result--loss">🐍 Game over — @_score</span>
        : null;

    private RenderFragment ControlsContent => @<div class="gps-controls">
        <button @onclick="StartGame" disabled="@_gameStarted">▶ Start</button>
        <button @onclick="PauseGame" disabled="@(!_gameStarted || _gameResult != GameResult.InProgress)">⏸ Pause</button>
        <button @onclick="ResetGame">🔄 Reset</button>
        <div class="gps-pills" role="radiogroup" aria-label="Select difficulty">
            <button type="button" class="@(_difficulty == Difficulty.Easy ? "active" : "")" @onclick="() => SetDifficulty(Difficulty.Easy)">Easy</button>
            <button type="button" class="@(_difficulty == Difficulty.Medium ? "active" : "")" @onclick="() => SetDifficulty(Difficulty.Medium)">Medium</button>
            <button type="button" class="@(_difficulty == Difficulty.Hard ? "active" : "")" @onclick="() => SetDifficulty(Difficulty.Hard)">Hard</button>
        </div>
    </div>;

    private void SetDifficulty(Difficulty d)
    {
        if (_difficulty == d) return;
        _difficulty = d;
        OnDifficultyChanged();
    }

    protected override void OnInitialized()
    {
        _playerName = PlayerNameService.GetPlayerName();
        _stats = _gameStats.GetStats("posnakegame", _playerName);
        UpdateStats();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('.snake-game-wrapper')?.focus()");
        }
    }

    private void OnDifficultyChanged()
    {
        if (_gameStarted)
            ResetGame();
    }

    private void StartGame()
    {
        if (_gameStarted) return;
        _gameStarted = true;
        _gameResult = GameResult.InProgress;
        var interval = _difficulty switch
        {
            Difficulty.Easy => 250,
            Difficulty.Medium => 150,
            Difficulty.Hard => 80,
            _ => 150
        };

        _gameTimer = new System.Threading.Timer(_ => InvokeAsync(Tick), null, interval, interval);
        
        // Save last played game (UX 10)
        _gameStats.SaveLastPlayedGame("posnakegame");
    }

    private void PauseGame()
    {
        _gameTimer?.Dispose();
        _gameTimer = null;
    }

    private void Tick()
    {
        if (_gameResult != GameResult.InProgress) return;

        var result = _board.Move();
        if (result == MoveResult.GameOver)
        {
            _gameResult = GameResult.Loss;
            _gameTimer?.Dispose();
            _gameTimer = null;
            _gameStarted = false;
            _ = _gameStats.RecordResult("posnakegame", _playerName, _difficulty, GameResult.Loss);
            UpdateStats();
        }
        InvokeAsync(StateHasChanged);
    }

    private void HandleCellClick(int row, int col)
    {
        // For touch/click controls - could add direction based on tap position
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (_gameResult != GameResult.InProgress) return;

        switch (e.Key.ToLower())
        {
            case "arrowup":
            case "w":
                Steer(-1, 0);
                break;
            case "arrowdown":
            case "s":
                Steer(1, 0);
                break;
            case "arrowleft":
            case "a":
                Steer(0, -1);
                break;
            case "arrowright":
            case "d":
                Steer(0, 1);
                break;
            case " ":
                if (!_gameStarted && _gameResult == GameResult.InProgress)
                    PauseGame();
                else
                    StartGame();
                break;
        }
    }

    // Shared steering entry point for keyboard and the on-screen D-pad buttons.
    // Starts the game on the first directional input.
    private void Steer(int dRow, int dCol)
    {
        if (_gameResult != GameResult.InProgress) return;
        _board.SetDirection(dRow, dCol);
        if (!_gameStarted) StartGame();
    }

    private void ResetGame()
    {
        _gameTimer?.Dispose();
        _gameTimer = null;
        _gameStarted = false;
        _board = new SnakeBoard();
        _gameResult = GameResult.InProgress;
        UpdateStats();
    }

    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, _difficulty);
        _statItems = GameStatsPanel.Build(bucket, includeDraws: false, ("Score", _score.ToString()));
    }

    private string GetCellClass(int row, int col)
    {
        var cell = _board.GetCell(row, col);
        return cell switch
        {
            SnakeCell.Snake => "snake-cell--snake",
            SnakeCell.Food => "snake-cell--food",
            _ => ""
        };
    }
}