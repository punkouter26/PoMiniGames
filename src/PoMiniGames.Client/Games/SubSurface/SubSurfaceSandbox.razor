@namespace PoMiniGamesClient.Games.SubSurface
@using PoMiniGamesClient.Models.SubSurface
@using PoMiniGamesClient.Services
@inject SubSurfaceInteropService Interop
@implements IAsyncDisposable

<div class="subsurface-sandbox-container">
    @* Top Docked Toolbar (Command Deck) *@
    <div class="subsurface-toolbar">
        @* Tool Select Bar *@
        <div class="toolbar-group" role="radiogroup" aria-label="Tool">
            <span class="toolbar-label">Tool:</span>
            <div class="tool-selectbar">
                @foreach (var (tool, label, hint) in ToolButtons)
                {
                    <button type="button"
                            class="tool-btn @(SelectedTool == tool ? "active" : null)"
                            title="@hint"
                            aria-pressed="@(SelectedTool == tool)"
                            @onclick="@(() => OnToolChanged(tool))">
                        @label
                    </button>
                }
            </div>
        </div>

        @* Brush Size Slider *@
        <div class="toolbar-group">
            <label class="toolbar-label" for="subsurface-brush">Brush:</label>
            <input type="range"
                   id="subsurface-brush"
                   min="1"
                   max="32"
                   step="1"
                   value="@BrushRadius"
                   @oninput="OnBrushRadiusInput" />
            <span class="toolbar-badge">@(BrushRadius)px</span>
        </div>

        @* Presets Dropdown *@
        <div class="toolbar-group">
            <label class="toolbar-label" for="subsurface-preset">Preset:</label>
            <select id="subsurface-preset" value="@SelectedPreset" @onchange="OnPresetChanged">
                @foreach (var preset in Presets)
                {
                    <option value="@preset">@preset</option>
                }
            </select>
        </div>

        @* Simulation Controls (Play/Pause, Step, Reset) *@
        <div class="toolbar-group">
            <button type="button" class="sim-btn @(IsPaused ? "sim-resume" : "sim-pause")" @onclick="TogglePause">
                @(IsPaused ? "▶ Resume" : "⏸ Pause")
            </button>
            <button type="button" class="sim-btn" disabled="@(!IsPaused)" @onclick="StepOnce">
                ⏭ Step
            </button>
            <button type="button" class="sim-btn sim-danger" @onclick="ResetScene">
                ↻ Reset
            </button>
            <button type="button" class="sim-btn @(AutoDrop ? "sim-danger" : null)" @onclick="ToggleAutoDrop">
                @(AutoDrop ? "💣 Stop Bombs" : "💣 Auto Demo")
            </button>
        </div>
    </div>

    @* Simulation Viewport *@
    <div class="subsurface-canvas-wrapper">
        <canvas @ref="_canvasRef"
                id="subsurface-canvas"
                width="800"
                height="600"
                class="subsurface-canvas">
        </canvas>

        @if (SelectedTool is SubSurfaceTool.TNTBomb or SubSurfaceTool.WaterBalloon)
        {
            <div class="slingshot-hint">
                🎯 <strong>Slingshot Mode:</strong> Click &amp; drag in the Sky (top half) to aim and release!
            </div>
        }
    </div>

    @* Bottom Telemetry HUD *@
    <div class="subsurface-hud">
        <div class="hud-badges">
            <span class="hud-badge hud-success">FPS: @_diagnostics.Fps</span>
            <span class="hud-badge hud-info">Sub-steps: @_diagnostics.SubSteps / frame</span>
            <span class="hud-badge hud-warning">Active Ordnance: @_diagnostics.ActiveProjectiles</span>
            <span class="hud-badge hud-info">Fluid: @_diagnostics.ActiveFluidCells.ToString("N0")</span>
            <span class="hud-badge hud-info">Sand: @_diagnostics.ActiveSandCells.ToString("N0")</span>
            @if (_diagnostics.AirborneGrains > 0)
            {
                <span class="hud-badge hud-warning">Ejecta: @_diagnostics.AirborneGrains.ToString("N0")</span>
            }
        </div>
        <div class="hud-caption">
            800×600 • 480,000 Cells • WebGL 2.0 Mohr-Coulomb &amp; Eulerian Solver
        </div>
    </div>
</div>
