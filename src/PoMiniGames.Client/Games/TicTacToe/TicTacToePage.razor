@page "/tictactoe"
@page "/tictactoe/{Mode}"
@implements IDisposable;
@using PoMiniGamesClient.Components;
@using PoMiniGamesClient.Enums;
@using PoMiniGamesClient.Models;
@using PoMiniGamesClient.Games.TicTacToe;
@using PoMiniGamesClient.Services;
@inject NavigationManager Navigation;
@inject PlayerNameService PlayerNameService;
@inject MatchHistoryService MatchHistory;
@inject KioskCoordinator Kiosk;
@inject UiFeedbackService Feedback;
@inject GameResultService GameResults;

@* Stats are the adaptive-ELO bucket, which 2-player never updates
   (HandleTwoPlayerMove records a local match instead) — so showing the
   grid there displayed stale 1P figures. Matches ConnectFive.
   2026-07-19 browser audit #7: the header was missing the ELO badge that
   Connect Five and Brawl both render — now passed through GameShell.Elo
   so the live rating shows next to the signed-in identity on 1P AI. *@
<PageTitle>Tic-Tac-Toe · PoMiniGames</PageTitle>

@* 2026-08-12 audit #1: same 5 s post-win pause as Connect Five — let the winning
   line flash on the board before the modal covers it. Razor block comments
   placed between attributes of an element are parsed as attribute names and
   crash the page at runtime (see 2026-08-10 audit). Comment lives OUTSIDE
   the tag. *@
<GameShell
    Title=@TitleContent
    Player="@_playerName"
    BackTo="@_backTo"
    GameOver="@_isGameOver"
    GameOverDelayMs="5000"
    GameKey="@(PlayMode == "ai" ? "tictactoe" : null)"
    Outcome="@OutcomeForCue"
    Stats="@(PlayMode == "ai" ? _statItems : null)"
    Elo="@(PlayMode == "ai" ? _rating.Elo : (int?)null)"
    Announcement="@Announcement"
    GameSummary="@GameSummaryContent">
    @if (!_introDone)
    {
        <GameIntro CueScope="tictactoe"
                   Title="@TitleContent"
                   Objective="@($"Line up {TicTacToeBoard.WinLength} in a row on the {TicTacToeBoard.Size}×{TicTacToeBoard.Size} grid before your opponent.")"
                   Controls="@HowToPlayContent"
                   Mode="@_introMode"
                   OnStart="DismissIntro" />
    }
    @* 2026-08-10: the §GFX-4 WebGL board layer was removed here, the same way and
       for the same reason it was removed from Connect Five. It drew the marks as
       scattered single red slashes straddling cell borders instead of X's in cells,
       while .ttt-board--gl faded the correct SVG marks out — so the board looked
       broken rather than merely plain. Nothing had to be built to replace it: the
       CSS/SVG board underneath was always the documented fallback and was always
       complete. The canvas was hiding it; removing the canvas makes it visible. *@
    <div class="ttt-board @(_isAiTurn ? "ttt-board--thinking" : "") @ResultClass" role="grid" aria-label="Tic-Tac-Toe game board">
        @* role="grid" requires role="row" between it and its gridcells (2026-08-08
           audit #2 — 234 axe violations across this board and Connect Five). The
           wrapper is `display: contents` so all 36 cells stay direct grid items of
           .ttt-board and the 6×6 template, the --ci stagger and the win-line
           geometry are all untouched. *@
        @for (int r = 0; r < TicTacToeBoard.Size; r++)
        {
            var rowIndex = r;
            <div class="ttt-row" role="row" aria-rowindex="@(rowIndex + 1)" @key="(_gameId, rowIndex)">
            @for (int c = 0; c < TicTacToeBoard.Size; c++)
            {
                var row = r;
                var col = c;
                var cellValue = _board.Get(r, c);
                var isDisabled = PlayMode == "demo"
                    ? true
                    : _gameResult != GameResult.InProgress || _isAiTurn || cellValue != CellValue.None;
                var isWinCell = _winCells.Any(wc => wc.Row == r && wc.Col == c);
                var isLast = _lastMove is { } lm && lm.Row == r && lm.Col == c;

                <div class="ttt-cell @(isDisabled ? "disabled" : "") @(isWinCell ? "win-cell" : "") @(isLast ? "last-move" : "")"
                     style="--ci:@(r * TicTacToeBoard.Size + c)"
                     @key="(_gameId, row, col)"
                     @onclick="() => HandleCellClick(row, col)"
                     role="gridcell"
                     aria-colindex="@(col + 1)"
                     aria-label="@GetCellAriaLabel(cellValue)"
                     tabindex="@(isDisabled ? -1 : 0)">
                    @if (cellValue == CellValue.X)
                    {
                        @Mark(isX: true, ghost: false)
                    }
                    else if (cellValue == CellValue.O)
                    {
                        @Mark(isX: false, ghost: false)
                    }
                    else if (!isDisabled)
                    {
                        @* §7 ghost preview of whoever moves next (X vs CPU; the active token in 2P). *@
                        @Mark(isX: PlayMode == "2p" ? _current2pToken == CellValue.X : true, ghost: true)
                    }
                </div>
            }
            </div>
        }
        @* §2 animated strike through the winning run — geometry computed from the
           shared --ttt-* grid tokens so it lines up at any cell size. *@
        @if (_winCells.Count >= 2)
        {
            <div class="ttt-winline" style="@WinLineStyle"></div>
        }
    </div>

    @* Self-drawing SVG mark. Coral X / cyan O; strokes reveal via stroke-dashoffset
       on placement (see TicTacToePage.razor.css). The ghost variant is pre-drawn
       and shown faintly on hover. *@
</GameShell>

@code {
    /// <summary>Route mode segment. Parsed by <see cref="GameModes.Parse"/>, which
    /// owns every accepted spelling and legacy form — see GameMode.cs.</summary>
    [Parameter] public string? Mode { get; set; }
    [SupplyParameterFromQuery(Name = "kiosk")] public int KioskNext { get; set; } = -1;
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "demo")] public int DemoQuery { get; set; }

    private GameMode RouteMode => GameModes.Parse(Mode, ModeQuery, DemoQuery);
    private bool IsDemo => RouteMode == GameMode.Demo;

    private TicTacToeBoard _board = new();
    private TicTacToeAI _ai = new();
    // Demo mode (CPU vs CPU) plays both sides at Medium. 1-player difficulty is
    // driven by the adaptive ELO (see _cpuElo), not this field.
    private readonly Difficulty _difficulty = Difficulty.Medium;
    private GameResult _gameResult = GameResult.InProgress;

    // Outcome for the end-of-game cue (GameOverModal picks the sound from this).
    // Only the vs-CPU mode reports one: in local 2-player "you" is ambiguous —
    // one of the two people at the keyboard just won — so it stays Unknown and
    // the modal sounds the neutral round-over instead of celebrating at someone.
    private GameOutcome OutcomeForCue => PlayMode != "ai" ? GameOutcome.Unknown : _gameResult switch
    {
        GameResult.Win => GameOutcome.Win,
        GameResult.Loss => GameOutcome.Loss,
        GameResult.Draw => GameOutcome.Draw,
        _ => GameOutcome.Unknown,
    };

    // Spoken by GameShell's shared live region (browser audit #6). The board is a
    // grid of labelled cells, so a screen reader can read the position — what it
    // could not tell was whose turn it is or that the game had ended. Demo drives
    // itself with nobody listening, so it announces nothing.
    private string? Announcement => PlayMode == "demo" ? null : _gameResult switch
    {
        GameResult.Win => "You win.",
        GameResult.Loss => PlayMode == "ai" ? "You lose." : "Circles win.",
        GameResult.Draw => "It's a draw.",
        _ when _isAiTurn => "Opponent is thinking.",
        _ => "Your turn.",
    };

    // Adaptive 1-player rating (same system as ConnectFive/PoBrawl). The CPU is
    // matched to _cpuElo — the player's rating at the start of the game — so the
    // opponent gets stronger as the player's ELO climbs and eases off after losses.
    private AdaptiveRating _rating = new();
    private int _cpuElo = AdaptiveRating.StartingElo;
    // ELO change from the just-finished game, shown on the game-over panel.
    private int? _lastEloDelta;
    private bool _isAiTurn;
    // "ai" (vs CPU) or "2p" (local pass-and-play); "demo" is driven by the route param.
    private string _playMode = "ai";
    private string PlayMode => IsDemo ? "demo" : _playMode;
    private CellValue _current2pToken = CellValue.X; // whose turn in 2-player mode
    private string _player2Name = "Player 2";
    private bool _matchRecorded;
    private string _playerName = "";
    // Player 1's display name resolves asynchronously; fall back to "Player 1" until it does.
    private string P1Name => string.IsNullOrWhiteSpace(_playerName) ? "Player 1" : _playerName;
    private List<(int Row, int Col)> _winCells = new();
    // §5 the most-recent placement (highlighted with a ring so the AI's last move
    // is trackable on a busy 6x6 board). Null until the first move of a game.
    private (int Row, int Col)? _lastMove;
    // Bumped on every ResetGame so each cell's @key changes, which recreates the
    // cell elements and replays the staggered board-entrance animation.
    private int _gameId;
    private List<StatItem> _statItems = new();
    private readonly GameStatsService _gameStats = new();
    private CancellationTokenSource? _demoCts;
    // BUG FIX (#1): _kioskTimer removed; KioskCoordinator owns the timer.

    private string _backTo => "/";
    private bool _isGameOver => _gameResult != GameResult.InProgress && PlayMode != "demo";

    // Intro/welcome gate — overlay blocks the board until dismissed (OK); demo
    // flashes it for 2s. Nothing auto-moves in human modes, so the overlay is
    // the only gate needed.
    // Audit #5: 2-player route used to inherit the 1P intro ("the CPU answers
    // with ⭕") even though there is no CPU. Branch on PlayMode so each
    // variant surfaces the controls that actually apply.
    private bool _introDone;
    private GameIntro.IntroMode _introMode => PlayMode switch
    {
        "demo" => GameIntro.IntroMode.Demo,
        "2p"   => GameIntro.IntroMode.TwoPlayer,
        _      => GameIntro.IntroMode.OnePlayer,
    };
    private void DismissIntro() => _introDone = true;

    // 2026-07-19 browser audit #8: the title used to leak the grid dimension
    // ("TicTacToe6") into the product name. Surface the classic "Tic-Tac-Toe"
    // and let the in-game intro / how-to-play carry the 6×6 / 4-in-a-row
    // details.
    private RenderFragment TitleContent => @<span><span aria-hidden="true">❌</span> Tic-Tac-Toe</span>;

    // Audit #5: mode-specific HowToPlay. 1P talks about the CPU and ELO, 2P
    // talks about two players taking turns, the demo is a CPU-vs-CPU exhibition.
    private RenderFragment HowToPlayContent => PlayMode switch
    {
        "demo" => @<div>
            <p>Watch two CPUs play 4-in-a-row on a @TicTacToeBoard.Size×@TicTacToeBoard.Size grid.</p>
            <ul>
                <li>No input — the board runs itself for the duration of the demo reel</li>
                <li>First to line up @TicTacToeBoard.WinLength in a row wins</li>
                <li>The demo loops on the post-game screen until the reel advances</li>
            </ul>
        </div>,
        "2p" => @<div>
            <p>Two players, one device — ❌ goes first, then ⭕.</p>
            <ul>
                <li>Tap an empty cell on your turn; the next player taps on theirs</li>
                <li>First to @TicTacToeBoard.WinLength in a row — horizontal, vertical or diagonal — wins</li>
                <li>No CPU and no rating: just take turns</li>
            </ul>
        </div>,
        _ => @<div>
            <p>Line up @TicTacToeBoard.WinLength in a row on the @TicTacToeBoard.Size×@TicTacToeBoard.Size board.</p>
            <ul>
                <li>Tap an empty cell to place your ❌ — the CPU answers with ⭕</li>
                <li>The CPU is matched to your ELO: win and it gets stronger, lose and it eases off</li>
                <li>Even the top CPU makes the occasional mistake — stay sharp</li>
            </ul>
        </div>,
    };

    // Board state → CSS modifier: "decided" spotlights the winning line (works for
    // a vs-AI win, a vs-AI loss, and either side of a 2P game); "draw" greys out.
    private string ResultClass => _gameResult switch
    {
        GameResult.Win or GameResult.Loss => "ttt-board--decided",
        GameResult.Draw => "ttt-board--draw",
        _ => ""
    };

    // Self-drawing SVG mark. isX → coral X (two strokes); else → cyan O. The ghost
    // variant is pre-drawn and faded in on hover to preview the next move.
    private RenderFragment Mark(bool isX, bool ghost) =>
        @<svg class="ttt-mark @(isX ? "ttt-mark--x" : "ttt-mark--o") @(ghost ? "ttt-mark--ghost" : "")"
              viewBox="0 0 100 100" aria-hidden="true">
            @if (isX)
            {
                <line x1="24" y1="24" x2="76" y2="76" />
                <line x1="76" y1="24" x2="24" y2="76" />
            }
            else
            {
                <circle cx="50" cy="50" r="28" />
            }
        </svg>;

    // Inline style for the win-strike overlay. Anchored at the first winning cell's
    // centre and rotated + scaled from its left edge. Every offset is expressed in
    // terms of the board's --ttt-cell / --ttt-gap / --ttt-pad tokens so the line
    // stays aligned with the grid at any responsive size (no JS measurement).
    private string? WinLineStyle
    {
        get
        {
            if (_winCells.Count < 2) return null;
            var cells = _winCells.OrderBy(c => c.Row).ThenBy(c => c.Col).ToList();
            var first = cells[0];
            var last = cells[^1];
            var span = cells.Count - 1;
            const string step = "(var(--ttt-cell) + var(--ttt-gap))";
            int dr = last.Row - first.Row, dc = last.Col - first.Col;

            string angle, length;
            if (dr == 0)      { angle = "0deg";   length = $"calc({span} * {step})"; }
            else if (dc == 0) { angle = "90deg";  length = $"calc({span} * {step})"; }
            else if (dc > 0)  { angle = "45deg";  length = $"calc({span} * {step} * 1.41421)"; }
            else              { angle = "135deg"; length = $"calc({span} * {step} * 1.41421)"; }

            var left = $"calc(var(--ttt-pad) + {first.Col} * {step} + var(--ttt-cell) / 2)";
            var top = $"calc(var(--ttt-pad) + {first.Row} * {step} + var(--ttt-cell) / 2)";
            var color = _board.Get(first.Row, first.Col) == CellValue.X ? "var(--ttt-x)" : "var(--ttt-o)";
            return $"left:{left}; top:{top}; width:{length}; --wl-angle:{angle}; --wl-color:{color};";
        }
    }
    
    // The legacy in-canvas Controls fragment was unreachable (the Settings
    // drawer was removed 2026-07-06) and is intentionally gone. The manual
    // difficulty picker is gone too — 1-player strength is always matched to
    // the player's adaptive ELO, exactly like ConnectFive.
    private RenderFragment? GameSummaryContent => _isGameOver
        ? @<div>
            @if (_gameResult == GameResult.Win)
            {
                <span class="cf-result cf-result--win">🎉 You win!</span>
            }
            else if (_gameResult == GameResult.Loss)
            {
                <span class="cf-result cf-result--loss">🤖 AI wins</span>
            }
            else if (_gameResult == GameResult.Draw)
            {
                <span class="cf-result cf-result--draw">🤝 Draw</span>
            }
            @if (_lastEloDelta is int d)
            {
                <div class="cf-elo-change">
                    <span class="cf-elo-now">ELO @_rating.Elo</span>
                    <span class="cf-elo-delta @(d > 0 ? "cf-elo-delta--up" : d < 0 ? "cf-elo-delta--down" : "cf-elo-delta--flat")">@(d >= 0 ? $"+{d}" : d.ToString())</span>
                    <span class="cf-elo-cpu">vs CPU @_cpuElo</span>
                </div>
            }
        </div>
        : null;
    
    protected override void OnInitialized()
    {
        _playerName = PlayerNameService.GetPlayerName();
        if (RouteMode == GameMode.TwoPlayer) _playMode = "2p";
        ResetGame();
        if (PlayMode == "demo") Kiosk.SetCurrent("tictactoe-demo");
    }

    private void OnPlayer2NameChange(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        _player2Name = string.IsNullOrWhiteSpace(name) ? "Player 2" : name.Trim();
    }

    private void ResetGame()
    {
        _demoCts?.Cancel();
        _board = new TicTacToeBoard();
        _gameResult = GameResult.InProgress;
        _winCells = new();
        _lastMove = null;
        _gameId++;
        _isAiTurn = false;
        _current2pToken = CellValue.X;
        _matchRecorded = false;
        _lastEloDelta = null;
        // Match the CPU to the player's rating as it stands right now — this is
        // what makes the difficulty evolve with the ELO.
        _rating = _gameStats.GetAdaptiveRating("tictactoe", _playerName);
        _cpuElo = _rating.Elo;
        UpdateStats();

        if (PlayMode == "demo")
        {
            _demoCts = new CancellationTokenSource();
            // Kick off the CPU-vs-CPU auto-play loop. This call was dropped in
            // the KioskCoordinator refactor, which left demo mode showing an
            // empty board — the kiosk timer moved out, but the per-game loop
            // must still start here.
            _ = RunDemoLoop(_demoCts.Token);
        }
        else
        {
            // Save last played game (UX 10)
            _gameStats.SaveLastPlayedGame("tictactoe");
        }
    }
    
    private async Task RunDemoLoop(CancellationToken ct)
    {
        await Task.Delay(700, ct);
        while (!ct.IsCancellationRequested && _gameResult == GameResult.InProgress)
        {
            // X (CPU1) move
            var (xr, xc) = _ai.GetMove(_board, CellValue.X, _difficulty);
            _board = _board.Place(xr, xc, CellValue.X);
            _lastMove = (xr, xc);
            var xWin = _board.CheckWin(CellValue.X);
            if (xWin.Won) { _gameResult = GameResult.Win; _winCells = xWin.Cells; }
            else if (_board.IsFull()) { _gameResult = GameResult.Draw; }
            await InvokeAsync(StateHasChanged);
            if (_gameResult != GameResult.InProgress) break;
            await Task.Delay(600, ct);
            
            // O (CPU2) move
            var (or2, oc2) = _ai.GetMove(_board, CellValue.O, _difficulty);
            _board = _board.Place(or2, oc2, CellValue.O);
            _lastMove = (or2, oc2);
            var oWin = _board.CheckWin(CellValue.O);
            if (oWin.Won) { _gameResult = GameResult.Loss; _winCells = oWin.Cells; }
            else if (_board.IsFull()) { _gameResult = GameResult.Draw; }
            await InvokeAsync(StateHasChanged);
            if (_gameResult != GameResult.InProgress) break;
            await Task.Delay(600, ct);
        }
        if (!ct.IsCancellationRequested && _gameResult != GameResult.InProgress)
        {
            await Task.Delay(2500, ct);
            if (!ct.IsCancellationRequested)
                await InvokeAsync(ResetGame);
        }
    }
    
    public void Dispose()
    {
        _demoCts?.Cancel();
        // BUG FIX (#1): _kioskTimer removed; KioskCoordinator owns it.
    }

    // Rebuild the ELO/CPU/W/L/D/Rate tiles from the adaptive rating so the stats
    // drawer and end-of-game panel reflect the result that was just recorded.
    private void UpdateStats()
    {
        _statItems = new()
        {
            new StatItem { Label = "ELO",  Value = _rating.Elo.ToString() },
            new StatItem { Label = "CPU",  Value = _cpuElo.ToString() },
            new StatItem { Label = "W",    Value = _rating.Wins.ToString() },
            new StatItem { Label = "L",    Value = _rating.Losses.ToString() },
            new StatItem { Label = "D",    Value = _rating.Draws.ToString() },
            new StatItem { Label = "Rate", Value = $"{_rating.WinRate * 100:F0}%" },
        };
    }

    // Apply the finished game's result to the adaptive rating, remember the ELO
    // delta for the game-over panel, and refresh the stat tiles.
    private void ApplyAdaptiveResult(GameResult result)
    {
        var before = _rating.Elo;
        _rating = _gameStats.RecordAdaptiveResult("tictactoe", _playerName, _cpuElo, result);
        _lastEloDelta = _rating.Elo - before;
        UpdateStats();
        // Single pipeline: GameResultService mirrors the rating into the stats
        // shape and PUTs it; failures land in the offline sync queue.
        _ = GameResults.SubmitAdaptiveStatsAsync("tictactoe", _playerName, _rating);
    }
    
    private void HandleCellClick(int row, int col)
    {
        if (PlayMode == "demo") return;
        if (_gameResult != GameResult.InProgress || _isAiTurn) return;
        // §4 tapping an occupied cell is a no-op — give a short error buzz so the
        // rejected input is felt, not silently ignored.
        if (_board.Get(row, col) != CellValue.None) { _ = Feedback.ErrorAsync(); return; }

        if (PlayMode == "2p") { HandleTwoPlayerMove(row, col); return; }

        var currentToken = CellValue.X;
        _board = _board.Place(row, col, currentToken);
        _lastMove = (row, col);
        _ = Feedback.DiscDropAsync();

        var winCheck = _board.CheckWin(currentToken);
        if (winCheck.Won)
        {
            _gameResult = GameResult.Win;
            _winCells = winCheck.Cells;
            _ = Feedback.PersonalBestAsync();
            ApplyAdaptiveResult(GameResult.Win);
            return;
        }

        if (_board.IsFull())
        {
            _gameResult = GameResult.Draw;
            _ = Feedback.CompleteAsync();
            ApplyAdaptiveResult(GameResult.Draw);
            return;
        }
        
        // AI turn
        _isAiTurn = true;
        StateHasChanged();
        
        _ = Task.Delay(200).ContinueWith(_prev =>
        {
            // CPU strength is matched to the player's rating at game start.
            var (ar, ac) = _ai.GetAdaptiveMove(_board, CellValue.O, _cpuElo);
            _board = _board.Place(ar, ac, CellValue.O);
            _lastMove = (ar, ac);
            _ = Feedback.DiscDropAsync();
            var aiWin = _board.CheckWin(CellValue.O);
            if (aiWin.Won)
            {
                _gameResult = GameResult.Loss;
                _winCells = aiWin.Cells;
                _isAiTurn = false;
                _ = Feedback.ErrorAsync();
                ApplyAdaptiveResult(GameResult.Loss);
            }
            else if (_board.IsFull())
            {
                _gameResult = GameResult.Draw;
                _isAiTurn = false;
                _ = Feedback.CompleteAsync();
                ApplyAdaptiveResult(GameResult.Draw);
            }
            else
            {
                _isAiTurn = false;
            }
            InvokeAsync(StateHasChanged);
        });
    }
    
    // Local pass-and-play: X = Player 1 (the local player), O = Player 2.
    private void HandleTwoPlayerMove(int row, int col)
    {
        var token = _current2pToken;
        _board = _board.Place(row, col, token);
        _lastMove = (row, col);
        _ = Feedback.DiscDropAsync();

        var winCheck = _board.CheckWin(token);
        if (winCheck.Won)
        {
            _winCells = winCheck.Cells;
            _gameResult = token == CellValue.X ? GameResult.Win : GameResult.Loss;
            _ = Feedback.PersonalBestAsync();
            RecordLocalMatch();
            return;
        }

        if (_board.IsFull())
        {
            _gameResult = GameResult.Draw;
            _ = Feedback.CompleteAsync();
            RecordLocalMatch();
            return;
        }

        _current2pToken = token == CellValue.X ? CellValue.O : CellValue.X;
    }

    // Record the 2-player outcome to the head-to-head history (owner's perspective:
    // Win = Player 1 won, Loss = Player 2 won). Local vs-AI stats are left untouched.
    private void RecordLocalMatch()
    {
        if (_matchRecorded) return;
        _matchRecorded = true;
        var outcome = _gameResult switch
        {
            GameResult.Win => MatchOutcome.Win,
            GameResult.Loss => MatchOutcome.Loss,
            _ => MatchOutcome.Draw
        };
        _ = MatchHistory.RecordAsync("tictactoe", MatchMode.Local2P, _player2Name, outcome);
    }

    private string GetCellAriaLabel(CellValue value) => value switch
    {
        CellValue.X => "X",
        CellValue.O => "O",
        _ => "Empty cell"
    };
}
