@page "/voxelshooter"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Enums
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@implements IAsyncDisposable
@inject PlayerNameService PlayerNameService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<GameShell Title=@TitleContent
           Player="@_playerName"
           BackTo="/single-player"
           GameOver="@_gameOver"
           OnPlayAgain="ResetGame"
           ShowSettings="true"
           IsOffline="@_isOffline"
           Stats="@_statItems"
           Controls="@ControlsContent">
    <div id="voxel-game-container" style="width:100%;height:540px;background:#050510;border-radius:8px;overflow:hidden;"></div>
</GameShell>

@code {
    // BUG FIX (#9): Removed unused `Demo` route parameter. The previous
    // page accepted /voxelshooter/{Demo:int} but the demo logic was never
    // implemented and the route is not linked from the UI. The single
    // route /voxelshooter is enough.

    private string _playerName = "";
    private bool _gameOver;
    private int _score;
    private bool _isOffline = false;
    private List<StatItem> _statItems = new();
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    private DotNetObjectReference<VoxelShooterPage>? _dotnetRef;
    private bool _engineInitialized;

    private RenderFragment TitleContent => @<span>🎯 Voxel Shooter</span>;

    private RenderFragment ControlsContent => @<div class="gps-controls">
        <button @onclick="ResetGame">🔄 Reset</button>
    </div>;

    protected override async Task OnInitializedAsync()
    {
        _playerName = PlayerNameService.GetPlayerName();
        _stats = _gameStats.GetStats("voxelshooter", _playerName);
        UpdateStats();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_engineInitialized)
        {
            _engineInitialized = true;
            _dotnetRef = DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("VoxelShooterGame.init", "voxel-game-container", _dotnetRef);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[VoxelShooter] JS init failed: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public async Task OnGameResult(bool win, int kills)
    {
        _score = kills;
        _gameOver = !win;
        _gameStats.SaveLastPlayedGame("voxelshooter");
        var result = win ? GameResult.Win : GameResult.Loss;
        await _gameStats.RecordResult("voxelshooter", _playerName, Difficulty.Medium, result);
        _stats = _gameStats.GetStats("voxelshooter", _playerName);
        UpdateStats();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetGame()
    {
        _gameOver = false;
        _score = 0;
        try
        {
            await JSRuntime.InvokeVoidAsync("VoxelShooterGame.destroy");
            _engineInitialized = false;
            StateHasChanged();
            await Task.Delay(50);
            _engineInitialized = true;
            await JSRuntime.InvokeVoidAsync("VoxelShooterGame.init", "voxel-game-container", _dotnetRef);
        }
        catch { /* ignore if JS not ready */ }
    }

    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, Difficulty.Medium);
        _statItems = new List<StatItem>
        {
            new() { Value = _score.ToString(), Label = "Score" },
            new() { Value = bucket.Wins.ToString(), Label = "W" },
            new() { Value = bucket.Losses.ToString(), Label = "L" },
            new() { Value = bucket.Draws.ToString(), Label = "D" },
            new() { Value = $"{bucket.WinRate * 100:F0}%", Label = "Rate" },
            new() { Value = bucket.EloRating.ToString(), Label = "ELO" }
        };
    }

    public async ValueTask DisposeAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("VoxelShooterGame.destroy"); } catch { }
        _dotnetRef?.Dispose();
    }
}