@page "/voxelshooter"
@page "/voxelshooter/{Demo:int}"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Enums
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@inject PlayerNameService PlayerNameService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<GameShell Title=@TitleContent 
           Player="@_playerName" 
           BackTo="/single-player" 
           GameOver="@_gameOver"
           OnPlayAgain="ResetGame"
           ShowSettings="true"
           IsOffline="@_isOffline"
           Stats="@_statItems"
           Controls="@ControlsContent">
    <div class="voxel-wrapper">
        @if (_isLoading)
        {
            <div class="voxel-loading">
                <div class="spinner"></div>
                <p>Loading 3D Engine...</p>
            </div>
        }
        else if (!_gameStarted)
        {
            <div class="voxel-menu">
                <h2>🎯 Voxel Shooter</h2>
                <p>Destroy enemies in a 3D voxel world!</p>
                <div class="voxel-controls-info">
                    <p>WASD - Move | Mouse - Aim | Click - Shoot</p>
                </div>
                <div class="voxel-features">
                    <span>🌟 3D Graphics</span>
                    <span>🎯 Target Practice</span>
                    <span>💥 Particle Effects</span>
                    <span>🏆 High Scores</span>
                </div>
                <button class="start-btn" @onclick="StartGame">▶ Start Game</button>
            </div>
        }
        else
        {
            <div class="voxel-game-area">
                <div class="voxel-hud">
                    <span>Score: @_score</span>
                    <span>Wave: @_wave</span>
                    <span>Health: @_health</span>
                </div>
                <div class="voxel-placeholder-3d">
                    <p>3D Game Area</p>
                    <p>WebGL Canvas Would Render Here</p>
                    <button @onclick="EndGame">End Game</button>
                </div>
            </div>
        }
    </div>
</GameShell>

@code {
    [Parameter] public int? Demo { get; set; }

    private string _playerName = "";
    private bool _isLoading = true;
    private bool _gameStarted;
    private bool _gameOver;
    private int _score;
    private int _wave = 1;
    private int _health = 100;
    private bool _isOffline = false;
    private List<StatItem> _statItems = new();
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();

    private RenderFragment TitleContent => @<span>🎯 Voxel Shooter</span>;

    private RenderFragment ControlsContent => @<div class="gps-controls">
        @if (!_gameStarted)
        {
            <button type="button" 
                    class="@(!_gameStarted ? "active" : "")"
                    @onclick="StartGame">
                @(_gameOver ? "Play Again" : "Start Game")
            </button>
        }
        else
        {
            <button @onclick="EndGame">
                🔄 End Game
            </button>
        }
        <button @onclick="ResetGame">
            🔄 Reset
        </button>
    </div>;

    protected override async Task OnInitializedAsync()
    {
        _playerName = PlayerNameService.GetPlayerName();
        _stats = _gameStats.GetStats("voxelshooter", _playerName);
        UpdateStats();
        
        await Task.Delay(1000); // Simulate loading
        _isLoading = false;
        
        if (Demo == 1)
            StartGame();
    }

    private void StartGame()
    {
        _gameStarted = true;
        _gameOver = false;
        _score = 0;
        _wave = 1;
        _health = 100;
    }

    private void EndGame()
    {
        _gameStarted = false;
        _gameOver = true;
        
        // Save last played game (UX 10)
        _gameStats.SaveLastPlayedGame("voxelshooter");
        
        // Record result for stats
        _ = _gameStats.RecordResult("voxelshooter", _playerName, Difficulty.Medium, GameResult.Loss);
        UpdateStats();
    }

    private void ResetGame()
    {
        _gameStarted = false;
        _gameOver = false;
        _score = 0;
        _wave = 1;
        _health = 100;
    }

    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, Difficulty.Medium);
        _statItems = new List<StatItem>
        {
            new() { Value = _score.ToString(), Label = "Score" },
            new() { Value = bucket.Wins.ToString(), Label = "W" },
            new() { Value = bucket.Losses.ToString(), Label = "L" },
            new() { Value = bucket.Draws.ToString(), Label = "D" },
            new() { Value = $"{bucket.WinRate * 100:F0}%", Label = "Rate" },
            new() { Value = bucket.EloRating.ToString(), Label = "ELO" }
        };
    }
}