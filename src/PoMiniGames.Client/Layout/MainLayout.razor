@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateService AuthState
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject KioskCoordinator Kiosk
@inject ScoreSyncService ScoreSync
@inject IWebAssemblyHostEnvironment HostEnvironment

<div class="gl-page">
    @if (AuthState.UsingMockData)
    {
        <div class="gl-mock-banner" role="status" aria-live="polite">USING MOCK DATA</div>
    }
    <header class="gl-top-bar">
        <div class="gl-top-bar-left">
            <a href="/" class="gl-brand">
                <span class="gl-brand-icon">
                    <svg width="22" height="22" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                        <rect x="23" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                        <rect x="3" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                        <rect x="23" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                    </svg>
                </span>
                <span class="gl-brand-text">PoMiniGames</span>
            </a>

            @if (_breadcrumbs.Count > 0)
            {
                <nav class="gl-breadcrumbs" aria-label="Breadcrumb">
                    @foreach (var crumb in _breadcrumbs)
                    {
                        if (crumb != _breadcrumbs.Last())
                        {
                            <a href="@crumb.Url" class="gl-breadcrumb-item">@crumb.Label</a>
                            <span class="gl-breadcrumb-sep">/</span>
                        }
                        else
                        {
                            <span class="gl-breadcrumb-item--current" aria-current="page">@crumb.Label</span>
                        }
                    }
                </nav>
            }
        </div>

        @* Consolidated game header: the active game (via GameShell) projects its
           status + settings into this single top bar, so game pages no longer
           render a separate second row. Empty on non-game pages. *@
        <div class="gl-top-bar-game">
            <SectionOutlet SectionName="game-header" />
        </div>

        <div class="gl-auth">
            @if (AuthState.IsConfigured && AuthState.User != null)
            {
                @* Show "Playing as Guest" for anonymous dev sessions; show email for real Microsoft accounts *@
                <span class="gl-auth-user" title="@(AuthState.User.Email ?? AuthState.User.DisplayName)">
                    @(IsAnonUser(AuthState.User.DisplayName) ? "Playing as Guest" : (AuthState.User.Email ?? AuthState.User.DisplayName))
                </span>
            }
            @* §10 dev-only "Switch user…" affordance. Renders only in Development +
               Test environments where the /api/auth/dev-bypass endpoint exists;
               lets a developer verify head-to-head flows from the same machine
               without spinning up an incognito tab. Hidden in Production. *@
            @if (ShowDevSwitch)
            {
                <details class="gl-overflow-menu gl-dev-switch">
                    <summary class="gl-overflow-trigger" aria-label="Developer tools">🔧</summary>
                    <div class="gl-overflow-panel">
                        <div class="gl-dev-switch__title">Switch user (dev only)</div>
                        <input class="gl-dev-switch__input" type="text"
                               placeholder="@(AuthState.User?.DisplayName ?? "new-name")"
                               @bind="_devUser"
                               @bind:event="oninput"
                               maxlength="32" />
                        <button class="gl-overflow-item" @onclick="SwitchDevUserAsync" disabled="@(string.IsNullOrWhiteSpace(_devUser) || _switching)">
                            @(_switching ? "Switching…" : "Switch identity")
                        </button>
                        @if (!string.IsNullOrEmpty(_switchError))
                        {
                            <div class="gl-dev-switch__error">@_switchError</div>
                        }
                        <div class="gl-dev-switch__hint">Replaces the current cookie; reloads match history.</div>
                    </div>
                </details>
            }
            @if (AuthState.IsConfigured && !AuthState.IsLoading)
            {
                <button class="gl-auth-button" @onclick="AuthState.IsAuthenticated ? SignOut : SignIn">
                    @(AuthState.IsAuthenticated ? "Sign out" : "Sign in")
                </button>
                @if (!AuthState.IsAuthenticated)
                {
                    <button class="gl-auth-button gl-auth-button--anon" @onclick="SignInAnon" title="Continue as anonymous">ANON</button>
                }
                @* §10 narrow-screen overflow: the ANON button is hidden on portrait phones
                   (< 480px) and surfaced via the ⋯ overflow menu instead of competing for
                   horizontal space with the Sign in / breadcrumb. *@
                @if (!AuthState.IsAuthenticated)
                {
                    <details class="gl-overflow-menu">
                        <summary class="gl-overflow-trigger" aria-label="More">⋯</summary>
                        <div class="gl-overflow-panel">
                            <button class="gl-overflow-item" @onclick="SignInAnon">Continue as anonymous</button>
                        </div>
                    </details>
                }
            }
        </div>
    </header>

    <main class="gl-content">
        @Body
    </main>

    @if (ToastService.Toasts.Count > 0)
    {
        <div class="toast-stack" role="log" aria-live="polite" aria-label="Notifications">
            @foreach (var toast in ToastService.Toasts)
            {
                <div class="toast toast--@toast.Type.ToString().ToLowerInvariant()" role="alert">
                    <span class="toast-msg">@toast.Message</span>
                    <button class="toast-close" @onclick="() => ToastService.Dismiss(toast.Id)" aria-label="Dismiss">×</button>
                </div>
            }
        </div>
    }

    <!-- Floating kiosk control bar (demo auto-cycle, 2026) -->
    <KioskControlBar />

    <!-- §9 Bottom-tab-bar for mobile portrait. Hidden on >= 641 px. -->
    <BottomTabBar />
</div>

@code {
    private List<Breadcrumb> _breadcrumbs = [];
    private string _currentUrl = "";
    private Action? _onAuthStateChanged;

    public record Breadcrumb(string Label, string Url);

    protected override void OnInitialized()
    {
        // Auth is initialized by <AuthGate> before MainLayout ever renders, so here we
        // only subscribe for live updates (e.g. sign-out) and wire breadcrumbs. The handler
        // is held in a field so Dispose can detach it — an inline lambda could never be
        // unsubscribed and would leak this component on every re-creation.
        _onAuthStateChanged = () => InvokeAsync(StateHasChanged);
        AuthState.StateChanged += _onAuthStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateBreadcrumbs();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateBreadcrumbs();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateBreadcrumbs()
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
        var segments = uri.Split('/', StringSplitOptions.RemoveEmptyEntries);

        _breadcrumbs = [];

        if (segments.Length == 0 || (segments.Length == 1 && segments[0] == ""))
        {
            // Home page - no breadcrumbs
            return;
        }

        // Always start with Home
        _breadcrumbs.Add(new Breadcrumb("Home", "/"));

        for (var i = 0; i < segments.Length; i++)
        {
            var rawSeg = segments[i];
            var seg = rawSeg.Split('?')[0]; // strip query string before matching
            var label = seg switch
            {
                "connectfive" => "Connect Five",
                "tictactoe" => "Tic Tac Toe",
                "voxelshooter" => "Voxel Shooter",
                "pofight" => "PoFight",
                "podropsquare" => "PoDropSquare",
                "pobabytouch" => "PoBabyTouch",
                "poraceragdoll" => "PoRaceRagdoll",
                "posnakegame" => "PoSnakeGame",
                "pohorserace" => "PoHorseRace",
                "porunner" => "PoRunner",
                "poracer" => "PoRacer",
                "pocouplequiz" => "PoCoupleQuiz",
                "pofunquiz" => "PoFunQuiz",
                "poface" => "PoFace",
                "diagpage" => "Diagnostics",
                "authcallbackpage" => "Auth",
                "profile" => "My Profile",
                "demo" => "Demo Mode",
                "1" => "Demo",
                // §10: unknown segments now fall back to a Title-Cased rendering
                // (e.g. "poclick" → "Poclick") instead of leaking raw URL text
                // into the breadcrumb nav. Trim long segments so the chrome
                // doesn't wrap on narrow phones.
                _ => TitleCaseSegment(seg)
            };
            _breadcrumbs.Add(new Breadcrumb(label, "/" + string.Join("/", segments[..(i + 1)])));
        }

        _currentUrl = NavigationManager.Uri;
    }

    /// <summary>
    /// Renders an unknown URL segment as a Title-Cased display label so the breadcrumb
    /// never leaks raw route text (e.g. <c>poclick</c> → <c>Poclick</c>).
    /// </summary>
    private static string TitleCaseSegment(string seg)
    {
        if (string.IsNullOrWhiteSpace(seg)) return seg;
        // Hyphenated: "my-route" → "My Route"
        var spaced = seg.Replace('-', ' ').Replace('_', ' ');
        var parts = spaced.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < parts.Length; i++)
        {
            var p = parts[i];
            if (p.Length > 0) parts[i] = char.ToUpperInvariant(p[0]) + p[1..];
        }
        return string.Join(' ', parts);
    }

    /// <summary>
    /// Returns true when the display name identifies a dev-bypass anonymous session.
    /// §10 hardening: previously relied on a tautological <c>StartsWith("ANON")</c> heuristic
    /// which misclassified any legitimate display name beginning with "ANON" as anonymous.
    /// We now pattern-match the canonical anonymous prefix <c>dev-anon-</c> and the
    /// auto-guest suffix <c>(auto)</c> that the auth pipeline emits, and reject every
    /// other display name as authenticated.
    /// </summary>
    private static bool IsAnonUser(string? displayName)
    {
        if (string.IsNullOrEmpty(displayName)) return false;
        if (displayName.StartsWith("dev-anon-", StringComparison.OrdinalIgnoreCase)) return true;
        if (displayName.StartsWith("ANON", StringComparison.OrdinalIgnoreCase)
            && displayName.Length > 4
            && (char.IsDigit(displayName[4]) || displayName[4] == '-'))
        {
            // Legacy: only the dev-bypass path produced "ANON463443" — never a real user.
            return true;
        }
        if (displayName.EndsWith(" (auto)", StringComparison.Ordinal)) return true;
        return false;
    }

    private async Task SignIn()
    {
        await AuthState.SignInAsync();
    }

    private async Task SignOut()
    {
        await AuthState.SignOutAsync();
    }

    private async Task SignInAnon()
    {
        await AuthState.DevBypassAsync("ANON");
    }

    // §10 dev-only "Switch user" panel. The button only renders when the host
    // is in Development or Test (where /api/auth/dev-bypass is registered); the
    // server-side endpoint already 404s outside loopback + non-Production so a
    // malicious probe of the UI never reaches a working handler.
    private bool ShowDevSwitch =>
        HostEnvironment.IsDevelopment() ||
        string.Equals(HostEnvironment.Environment, "Test", StringComparison.OrdinalIgnoreCase);

    private string _devUser = string.Empty;
    private bool _switching;
    private string? _switchError;

    private async Task SwitchDevUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_devUser)) return;
        _switching = true;
        _switchError = null;
        try
        {
            // Reuse the existing AuthStateService.DevBypassAsync, which calls
            // /api/auth/dev-bypass?user=<name> — the canonical "switch identity"
            // endpoint the server already wires up. No new server code needed.
            await AuthState.DevBypassAsync(_devUser.Trim());
            ToastService.Show($"Signed in as {_devUser.Trim()}", ToastType.Success);
            _devUser = string.Empty;
        }
        catch (Exception ex)
        {
            _switchError = ex.Message;
        }
        finally
        {
            _switching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        if (_onAuthStateChanged is not null)
        {
            AuthState.StateChanged -= _onAuthStateChanged;
        }
    }
}