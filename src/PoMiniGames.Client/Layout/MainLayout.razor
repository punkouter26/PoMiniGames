@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateService AuthState
@inject ToastService ToastService
@inject KioskCoordinator Kiosk
@inject ScoreSyncService ScoreSync
@inject UiFeedbackService Feedback
@inject SettingsService Settings

<div class="gl-page">
    @* §9 mock banner — desktop gets the full-width shimmer banner; mobile gets
       a tappable dot that expands to the same label. Keeps the safety guard
       visible without sacrificing ~36 px of chrome on portrait phones. *@
    @if (AuthState.UsingMockData)
    {
        <div class="gl-mock-banner" role="status" aria-live="polite">USING MOCK DATA</div>
        <details class="gl-mock-banner--dot" aria-label="Mock data active — tap for details">
            <summary aria-label="Mock data active"></summary>
            <span>USING MOCK DATA</span>
        </details>
    }
    <header class="gl-top-bar">
        <div class="gl-top-bar-left">
            <a href="/" class="gl-brand">
                <span class="gl-brand-icon">
                    <svg width="22" height="22" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                        <rect x="23" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                        <rect x="3" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                        <rect x="23" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                    </svg>
                </span>
                <span class="gl-brand-text">PoMiniGames</span>
            </a>
        </div>

        @* Consolidated game header: the active game (via GameShell) projects its
           status + settings into this single top bar, so game pages no longer
           render a separate second row. Empty on non-game pages. The game's
           status lives on the right of the middle rail (after the FPS counter)
           so the FPS pill sits closer to the visual centre, between the brand
           on the left and the session controls on the right. *@
        <div class="gl-top-bar-center">
            <FpsCounter />
            <div class="gl-top-bar-game">
                <SectionOutlet SectionName="game-header" />
            </div>
        </div>

        <div class="gl-auth">
            @* ⚙️ settings gear and 🔧 dev switch-user wrench removed per user
               request (2026-07-13). Master mute / FPS-badge toggles and the
               dev-only identity switcher are gone from the top bar entirely. *@
            @if (AuthState.IsConfigured && !AuthState.IsLoading)
            {
                <button class="gl-auth-button" @onclick="AuthState.IsAuthenticated ? SignOut : SignIn">
                    @(AuthState.IsAuthenticated ? "Sign out" : "Sign in")
                </button>
                @if (!AuthState.IsAuthenticated)
                {
                    <button class="gl-auth-button gl-auth-button--anon" @onclick="SignInAnon" title="Continue as anonymous">ANON</button>
                }
                @* §10 narrow-screen overflow: the ANON button is hidden on portrait phones
                   (< 480px) and surfaced via the ⋯ overflow menu instead of competing for
                   horizontal space with the Sign in button. *@
                @if (!AuthState.IsAuthenticated)
                {
                    <details class="gl-overflow-menu gl-overflow-menu--anon">
                        <summary class="gl-overflow-trigger" aria-label="More">⋯</summary>
                        <div class="gl-overflow-panel">
                            <button class="gl-overflow-item" @onclick="SignInAnon">Continue as anonymous</button>
                        </div>
                    </details>
                }
            }
        </div>
    </header>

    <main class="gl-content">
        @Body
    </main>

    @if (ToastService.Toasts.Count > 0)
    {
        <div class="toast-stack" role="log" aria-live="polite" aria-label="Notifications">
            @foreach (var toast in ToastService.Toasts)
            {
                <div class="toast toast--@toast.Type.ToString().ToLowerInvariant()" role="alert">
                    <span class="toast-msg">@toast.Message</span>
                    <button class="toast-close" @onclick="() => ToastService.Dismiss(toast.Id)" aria-label="Dismiss">×</button>
                </div>
            }
        </div>
    }

    <!-- Floating kiosk control bar removed per 2026-07-04 mobile-portrait cleanup.
         The KioskCoordinator still drives demo auto-rotation when started from the
         home page; only the floating control surface is gone. -->

    <!-- §9 Bottom-tab-bar REMOVED per user request (2026-07-05): the 3-icon
         Home/Scores/Me strip on mobile portrait was removed. The top bar's
         brand + Sign in/Sign out affordance is the only nav surface now. -->
</div>

@code {
    private Action? _onAuthStateChanged;

    protected override void OnInitialized()
    {
        // Auth is initialized by <AuthGate> before MainLayout ever renders, so here we
        // only subscribe for live updates (e.g. sign-out). The handler is held in a
        // field so Dispose can detach it — an inline lambda could never be
        // unsubscribed and would leak this component on every re-creation.
        _onAuthStateChanged = () => InvokeAsync(StateHasChanged);
        AuthState.StateChanged += _onAuthStateChanged;

        // §10 fire the mock-data buzz once on mount so the developer notices
        // the safety guard when they hit the home page in a mock-data env.
        if (AuthState.UsingMockData)
        {
            _ = Feedback.MockDataAsync();
        }

        Settings.Load();
    }

    private async Task SignIn()
    {
        await Feedback.TapAsync();
        var wasAuthenticated = AuthState.IsAuthenticated;
        // Interactive sign-in: real MSAL when Microsoft is configured, dev-login
        // stand-in otherwise. (The old SignInAsync() only errored in MSAL mode.)
        await AuthState.SignInMicrosoftAsync();

        // §10 Deferred-save payoff: if the player just signed in, replay any scores
        // they parked while playing as a guest so their board entries land now.
        if (!wasAuthenticated && AuthState.IsAuthenticated)
        {
            var synced = await ScoreSync.FlushAsync();
            if (synced > 0)
            {
                ToastService.Show(
                    synced == 1 ? "Your score was saved to the leaderboard." : $"{synced} scores saved to the leaderboard.",
                    ToastType.Success);
            }
        }
    }

    private async Task SignOut()
    {
        await Feedback.TapAsync();
        await AuthState.SignOutAsync();
    }

    private async Task SignInAnon()
    {
        await Feedback.TapAsync();
        await AuthState.DevBypassAsync("ANON");
    }

    public void Dispose()
    {
        if (_onAuthStateChanged is not null)
        {
            AuthState.StateChanged -= _onAuthStateChanged;
        }
    }
}