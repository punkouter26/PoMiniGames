@page "/diag"
@using PoMiniGamesClient.Services
@using System.Text.Json
@using Radzen.Blazor
@inject ApiService ApiService
@inject AuthStateService AuthState
@inject HttpClient Http
@inject IWebAssemblyHostEnvironment HostEnvironment

<div style="padding:2rem;max-width:860px;margin:0 auto;font-family:monospace;color:#cdd5e0">
    <h1 style="font-size:1.5rem;margin-bottom:0.25rem;color:#fff">🔧 /diag</h1>
    <p style="color:#64748b;margin-bottom:2rem;font-size:0.8rem">Diagnostic page</p>

    <section style="margin-bottom:1.5rem">
        <h2 style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;color:#94a3b8;border-bottom:1px solid #1e293b;padding-bottom:0.4rem;margin-bottom:0.75rem">API Status</h2>
        <div style="display:grid;gap:0.25rem;font-size:0.8rem">
            <div style="display:grid;grid-template-columns:260px 1fr;gap:1rem"><span style="color:#64748b">Backend</span><span style="color:#e2e8f0">@_apiStatus</span></div>
            <div style="display:grid;grid-template-columns:260px 1fr;gap:1rem"><span style="color:#64748b">Auth configured</span><span style="color:#e2e8f0">@AuthState.IsConfigured</span></div>
            <div style="display:grid;grid-template-columns:260px 1fr;gap:1rem"><span style="color:#64748b">Auth loading</span><span style="color:#e2e8f0">@AuthState.IsLoading</span></div>
        </div>
    </section>

    <section style="margin-bottom:1.5rem">
        <h2 style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;color:#94a3b8;border-bottom:1px solid #1e293b;padding-bottom:0.4rem;margin-bottom:0.75rem">Auth</h2>
        <div style="display:grid;gap:0.25rem;font-size:0.8rem">
            <div style="display:grid;grid-template-columns:260px 1fr;gap:1rem"><span style="color:#64748b">Authenticated</span><span style="color:#e2e8f0">@AuthState.IsAuthenticated</span></div>
            <div style="display:grid;grid-template-columns:260px 1fr;gap:1rem"><span style="color:#64748b">User ID</span><span style="color:#e2e8f0">@(AuthState.User?.UserId ?? "—")</span></div>
            <div style="display:grid;grid-template-columns:260px 1fr;gap:1rem"><span style="color:#64748b">Display name</span><span style="color:#e2e8f0">@(AuthState.User?.DisplayName ?? "—")</span></div>
            <div style="display:grid;grid-template-columns:260px 1fr;gap:1rem"><span style="color:#64748b">Email</span><span style="color:#e2e8f0">@Mask(AuthState.User?.Email)</span></div>
        </div>
    </section>

    <section style="margin-bottom:1.5rem">
        <h2 style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;color:#94a3b8;border-bottom:1px solid #1e293b;padding-bottom:0.4rem;margin-bottom:0.75rem">Backend /diag</h2>
        @if (_backendError != null)
        {
            <p style="color:#ef4444;margin:0">@_backendError</p>
        }
        else if (_backendDiagRaw == null)
        {
            <p style="color:#64748b;margin:0">@(_apiStatus == "offline" ? "API offline" : "Loading…")</p>
        }
        else
        {
            <pre style="margin:0;white-space:pre-wrap;word-break:break-all;font-size:0.75rem">@_backendDiagRaw</pre>
        }
    </section>

    <section style="margin-bottom:1.5rem">
        <h2 style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;color:#94a3b8;border-bottom:1px solid #1e293b;padding-bottom:0.4rem;margin-bottom:0.75rem">Diagnostic Top-Level Keys</h2>
        <RadzenDataGrid Data="@_diagRows" TItem="DiagRow" AllowPaging="false" AllowSorting="false" ColumnWidth="220px">
            <Columns>
                <RadzenDataGridColumn TItem="DiagRow" Property="Key" Title="Key" />
                <RadzenDataGridColumn TItem="DiagRow" Property="Summary" Title="Summary" />
            </Columns>
        </RadzenDataGrid>
    </section>
</div>

@code {
    private string _apiStatus = "checking";
    private string? _backendDiagRaw;
    private string? _backendError;
    private readonly List<DiagRow> _diagRows = [];

    protected override async Task OnInitializedAsync()
    {
        _apiStatus = await ApiService.IsAvailableAsync() ? "online" : "offline";

        if (_apiStatus == "online")
        {
            try
            {
                var response = await Http.GetAsync("/api/diag");
                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync();
                    try
                    {
                        var obj = JsonSerializer.Deserialize<JsonElement>(json);
                        _backendDiagRaw = JsonSerializer.Serialize(obj, new JsonSerializerOptions { WriteIndented = true });
                        BuildRows(obj);
                    }
                    catch
                    {
                        _backendDiagRaw = json;
                    }
                }
                else
                {
                    _backendError = $"HTTP {(int)response.StatusCode}";
                }
            }
            catch (Exception ex)
            {
                _backendError = HostEnvironment.IsDevelopment() ? ex.ToString() : ex.Message;
            }
        }
    }

    private void BuildRows(JsonElement root)
    {
        _diagRows.Clear();
        if (root.ValueKind != JsonValueKind.Object)
        {
            return;
        }

        foreach (var property in root.EnumerateObject())
        {
            var summary = property.Value.ValueKind switch
            {
                JsonValueKind.Object => "Object",
                JsonValueKind.Array => "Array",
                JsonValueKind.String => property.Value.GetString() ?? string.Empty,
                JsonValueKind.Number => property.Value.ToString(),
                JsonValueKind.True => "true",
                JsonValueKind.False => "false",
                JsonValueKind.Null => "null",
                _ => property.Value.ToString()
            };

            _diagRows.Add(new DiagRow(property.Name, summary));
        }
    }

    private static string Mask(string? value)
    {
        if (string.IsNullOrEmpty(value) || value.Length <= 8) return "***";
        return value[..4] + "****" + value[^4..];
    }

    private sealed record DiagRow(string Key, string Summary);
}