@page "/diag"
@using PoMiniGamesClient.Services
@using System.Text.Json
@inject ApiService ApiService
@inject AuthStateService AuthState
@inject HttpClient Http
@inject IWebAssemblyHostEnvironment HostEnvironment
@inject NavigationManager Navigation

<div class="diag">
    <h1 class="diag-h1">🔧 /diag</h1>
    <p class="diag-lead">Diagnostic page</p>

    <section class="diag-section">
        <h2 class="diag-h2">API Status</h2>
        <div class="diag-kv-list">
            <div class="diag-kv"><span class="diag-k">Backend</span><span class="diag-v">@_apiStatus</span></div>
            <div class="diag-kv"><span class="diag-k">Auth configured</span><span class="diag-v">@AuthState.IsConfigured</span></div>
            <div class="diag-kv"><span class="diag-k">Auth loading</span><span class="diag-v">@AuthState.IsLoading</span></div>
            <div class="diag-kv"><span class="diag-k">Correlation ID (this page)</span><span class="diag-v mono">@_diagCorrelationId</span></div>
            <div class="diag-kv"><span class="diag-k">Session ID</span><span class="diag-v mono">@(_sessionId ?? "—")</span></div>
        </div>
    </section>

    <section class="diag-section">
        <h2 class="diag-h2">Auth</h2>
        <div class="diag-kv-list">
            <div class="diag-kv"><span class="diag-k">Authenticated</span><span class="diag-v">@AuthState.IsAuthenticated</span></div>
            <div class="diag-kv"><span class="diag-k">User ID</span><span class="diag-v">@(AuthState.User?.UserId ?? "—")</span></div>
            <div class="diag-kv"><span class="diag-k">Display name</span><span class="diag-v">@(AuthState.User?.DisplayName ?? "—")</span></div>
            <div class="diag-kv"><span class="diag-k">Email</span><span class="diag-v">@Mask(AuthState.User?.Email)</span></div>
        </div>
    </section>

    <section class="diag-section">
        <h2 class="diag-h2">Active Mockables</h2>
        <p class="diag-muted">
            Every <code>IMockable</code> registered in the API DI container. Dev/Test environments only;
            the endpoint returns 404 in Production. A non-zero count in Production is a deployment bug.
        </p>
        @if (_mockables.Count == 0)
        {
            <p class="diag-muted">@(_apiStatus == "offline" ? "API offline" : "No mocks registered.")</p>
        }
        else
        {
            <ul class="diag-mock-list">
                @foreach (var m in _mockables)
                {
                    <li><code>@m</code></li>
                }
            </ul>
        }
    </section>

    <section class="diag-section">
        <h2 class="diag-h2">Integrations</h2>
        @if (_integrations.Count == 0)
        {
            <p class="diag-muted">@(_apiStatus == "offline" ? "API offline" : "No integrations reported.")</p>
        }
        else
        {
            <table class="diag-table">
                <thead><tr><th>Name</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var integ in _integrations)
                    {
                        <tr>
                            <td>@integ.Name</td>
                            <td>
                                <span class="diag-status diag-status--@integ.Status">@integ.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="diag-section">
        <h2 class="diag-h2">Recent Server Logs</h2>
        <p class="diag-muted">
            Last @_logEntries.Count log lines from the API (dev-only). Use the CorrelationId
            above to grep these for a specific request.
        </p>
        <div class="diag-log-controls">
            <label class="diag-corr-filter">
                <input type="checkbox" @bind="_filterByCorrelation" />
                Filter by correlation @_diagCorrelationId
            </label>
            <button class="diag-refresh" @onclick="RefreshAsync">Refresh</button>
        </div>
        @if (_logEntries.Count == 0)
        {
            <p class="diag-muted">@(_apiStatus == "offline" ? "API offline" : "No logs available.")</p>
        }
        else
        {
            <pre class="diag-pre diag-log">@string.Join("\n", _filteredLogs)</pre>
        }
    </section>

    <section class="diag-section">
        <h2 class="diag-h2">Backend /diag (raw)</h2>
        @if (_backendError != null)
        {
            <p class="diag-error">@_backendError</p>
        }
        else if (_backendDiagRaw == null)
        {
            <p class="diag-muted">@(_apiStatus == "offline" ? "API offline" : "Loading…")</p>
        }
        else
        {
            <pre class="diag-pre">@_backendDiagRaw</pre>
        }
    </section>
</div>

@code {
    private string _apiStatus = "checking";
    private string? _backendDiagRaw;
    private string? _backendError;
    private readonly List<DiagRow> _diagRows = [];
    private readonly List<string> _mockables = [];
    private readonly List<DiagIntegration> _integrations = [];
    private readonly List<string> _logEntries = [];
    private string _diagCorrelationId = "(pending)";
    private string? _sessionId;
    private bool _filterByCorrelation = true;

    // Property names whose string values are sensitive and must be masked in the
    // diagnostic table (the raw JSON in the previous section is shown only in
    // Development, and the API already returns masked values for these keys).
    private static readonly HashSet<string> SensitiveKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "keyVaultUri",
        "applicationInsights",
        "microsoftClientId",
        "microsoftApiClientId",
        "tableServiceConnection",
        "tableServiceEndpoint",
        "tableServiceAccount",
        "tableServiceTable",
        "clientSecret",
    };

    protected override async Task OnInitializedAsync()
    {
        _apiStatus = await ApiService.IsAvailableAsync() ? "online" : "offline";

        if (_apiStatus == "online")
        {
            // The server stamps every request with a TraceIdentifier; round-trip one
            // through /api/diag/correlation so the SPA can show the value the API
            // used, then use it to filter /api/logs/tail entries that were logged
            // for this page load.
            try
            {
                var corrResp = await Http.GetAsync("/api/diag/correlation");
                if (corrResp.IsSuccessStatusCode)
                {
                    var doc = JsonDocument.Parse(await corrResp.Content.ReadAsStringAsync()).RootElement;
                    _diagCorrelationId = doc.TryGetProperty("correlationId", out var c) ? (c.GetString() ?? "") : _diagCorrelationId;
                    _sessionId = doc.TryGetProperty("sessionId", out var s) ? s.GetString() : null;
                }
            }
            catch { /* offline — leave defaults */ }

            await RefreshAsync();
        }
    }

    private async Task RefreshAsync()
    {
        // Re-read the current /api/diag, /api/mockables, and /api/logs/tail in parallel
        // so the page renders incrementally as each completes.
        var diagTask = Http.GetAsync("/api/diag");
        var mockTask = Http.GetAsync("/api/mockables");
        var logsTask = Http.GetAsync("/api/logs/tail?count=50");
        await Task.WhenAll(diagTask, mockTask, logsTask);

        var diagResp = await diagTask;
        if (diagResp.IsSuccessStatusCode)
        {
            var json = await diagResp.Content.ReadAsStringAsync();
            try
            {
                var obj = JsonDocument.Parse(json).RootElement;
                _backendDiagRaw = HostEnvironment.IsDevelopment()
                    ? PrettyPrint(obj)
                    : "(see masked table below — raw payload hidden outside Development)";
                BuildRows(obj);
                BuildIntegrations(obj);
            }
            catch
            {
                _backendDiagRaw = HostEnvironment.IsDevelopment() ? json : "(hidden outside Development)";
            }
        }
        else
        {
            _backendError = $"HTTP {(int)diagResp.StatusCode}";
        }

        var mockResp = await mockTask;
        if (mockResp.IsSuccessStatusCode)
        {
            try
            {
                var arr = JsonDocument.Parse(await mockResp.Content.ReadAsStringAsync()).RootElement;
                _mockables.Clear();
                if (arr.ValueKind == JsonValueKind.Array)
                {
                    foreach (var entry in arr.EnumerateArray())
                    {
                        if (entry.TryGetProperty("mockId", out var id))
                        {
                            _mockables.Add(id.GetString() ?? "");
                        }
                    }
                }
            }
            catch { /* ignore — best-effort */ }
        }

        var logsResp = await logsTask;
        if (logsResp.IsSuccessStatusCode)
        {
            try
            {
                var obj = JsonDocument.Parse(await logsResp.Content.ReadAsStringAsync()).RootElement;
                if (obj.TryGetProperty("entries", out var entries))
                {
                    _logEntries.Clear();
                    foreach (var e in entries.EnumerateArray())
                    {
                        _logEntries.Add(e.GetString() ?? "");
                    }
                }
            }
            catch { /* best-effort */ }
        }

        StateHasChanged();
    }

    private IEnumerable<string> _filteredLogs =>
        _filterByCorrelation && !string.IsNullOrEmpty(_diagCorrelationId) && _diagCorrelationId != "(pending)"
            ? _logEntries.Where(l => l.Contains(_diagCorrelationId, StringComparison.OrdinalIgnoreCase))
            : _logEntries;

    private static string PrettyPrint(JsonElement element)
    {
        using var ms = new System.IO.MemoryStream();
        using var writer = new System.Text.Json.Utf8JsonWriter(ms, new System.Text.Json.JsonWriterOptions { Indented = true });
        element.WriteTo(writer);
        writer.Flush();
        return System.Text.Encoding.UTF8.GetString(ms.ToArray());
    }

    private void BuildRows(JsonElement root)
    {
        _diagRows.Clear();
        if (root.ValueKind != JsonValueKind.Object) return;

        foreach (var property in root.EnumerateObject())
        {
            string summary = property.Value.ValueKind switch
            {
                JsonValueKind.Object => "Object",
                JsonValueKind.Array => $"Array ({property.Value.GetArrayLength()})",
                JsonValueKind.String => MaskIfSensitive(property.Name, property.Value.GetString() ?? string.Empty),
                JsonValueKind.Number => property.Value.ToString(),
                JsonValueKind.True => "true",
                JsonValueKind.False => "false",
                JsonValueKind.Null => "null",
                _ => property.Value.ToString()
            };

            _diagRows.Add(new DiagRow(property.Name, summary));
        }
    }

    private void BuildIntegrations(JsonElement root)
    {
        _integrations.Clear();
        if (root.ValueKind != JsonValueKind.Object) return;
        if (!root.TryGetProperty("integrations", out var integ) || integ.ValueKind != JsonValueKind.Array) return;
        foreach (var entry in integ.EnumerateArray())
        {
            var name = entry.TryGetProperty("name", out var n) ? (n.GetString() ?? "") : "";
            var status = entry.TryGetProperty("status", out var s) ? (s.GetString() ?? "") : "";
            _integrations.Add(new DiagIntegration(name, status));
        }
    }

    private static string MaskIfSensitive(string key, string value)
    {
        if (SensitiveKeys.Contains(key))
        {
            return string.IsNullOrEmpty(value) || value.Length <= 8 ? "***" : value[..4] + "****" + value[^4..];
        }
        return value;
    }

    private static string Mask(string? value)
    {
        if (string.IsNullOrEmpty(value) || value.Length <= 8) return "***";
        return value[..4] + "****" + value[^4..];
    }

    private sealed record DiagRow(string Key, string Summary);
    private sealed record DiagIntegration(string Name, string Status);
}