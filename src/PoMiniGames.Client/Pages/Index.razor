@page "/"
@inject NavigationManager NavigationManager
@inject KioskCoordinator Kiosk
@inject IJSRuntime JS
@inject ActivityFeedService ActivityFeed
@inject UiFeedbackService Feedback
@inject OnlineStatusService OnlineStatus
@inject ToastService Toasts
@inject IWebAssemblyHostEnvironment Env
@inject DailyChallengeService Daily
@inject HubPrefsService HubPrefs
@inject GameStatsService GameStats
@inject PoMiniGamesClient.Games.PoMule.PoMuleSaveStore MuleSaves
@implements IAsyncDisposable

@* ─────────────────────────────────────────────────────────────────────────
   Home — one card per game, one chip per mode.

   This replaced four mode-keyed sections (Demo / 1P / 2P / Multiplayer), each
   of which listed the games that supported it. That shape had two costs:

     • Nine of ten games appeared two-to-four times on one screen, and each
       section carried its own duplicate 🏆 Leaderboard link to the same URL.
     • A game was only discoverable in a mode if someone remembered to add it
       to that section's list, so a game could be watch-only from here despite
       having a working single-player route.

   Pivoting to game-major fixes both: the card is the game, the chips are
   whatever modes it declares in GameCatalog, so a supported mode cannot go
   un-listed. See GameCatalog.All.
   ───────────────────────────────────────────────────────────────────────── *@

<PageTitle>PoMiniGames — pick a game</PageTitle>

<div class="home-container">
    <span class="home-mesh" aria-hidden="true"></span>
    @* GPU-accelerated ambient particle field. WebGL2-only; falls back to the
       CSS gradient on browsers without WebGL2 (Safari TP, etc.). *@
    <canvas @ref="_ambientCanvas" class="home-ambient" aria-hidden="true"></canvas>

    @* The page's heading is for the outline and for FocusOnNavigate only (visually
       hidden): the brand is already in the top bar, one row above, and the strapline
       under it said what fifteen game cards say by existing. *@
    <h1 class="home-title">PoMiniGames</h1>

    @* The hub bar: everything on this page that is not a game card, in one compact
       block above the grid (two rows on a phone, one on a wide screen). Today's game,
       the demo reel, the filters and the "Continue" shortcuts. Leaderboards, My Stats
       and Settings live in the top bar's account menu, on every route.

       Links carrying data-hub-nav are launched by js/app.js: an in-app navigation
       wrapped in a view transition that morphs the pressed card into the game's title.

       Keep markup comments between elements, never between attributes: a Razor
       comment inside an attribute list is parsed as an attribute NAME, and
       setAttribute then throws InvalidCharacterError and takes the page down. *@
    <div class="home-bar">
        <a class="home-today @(_doneToday ? "home-today--done" : null)"
           href="@_today.Url" data-hub-nav
           aria-label="@TodayLabel"
           @onclick="MarkDailyPlayed">
            <span class="home-today-kicker">Today</span>
            <span class="home-today-game" data-hero><span aria-hidden="true">@_today.Game.Icon</span> @_today.Game.Title</span>
            @if (_streak > 0 || _doneToday)
            {
                <span class="home-today-streak" title="Daily streak: days in a row you have played Today's game">
                    <span aria-hidden="true">@(_doneToday ? "✓" : "🔥")</span> @_streak
                </span>
            }
        </a>

        @* aria-pressed is a literal string, not a bare bool: Blazor renders a bool-valued
           attribute as an HTML boolean attribute, which is not a valid ARIA state. The
           visible text shortens on a narrow phone, so the full name is the aria-label. *@
        <button type="button"
                class="home-action home-action--demo @(Kiosk.IsActive ? "home-action--on" : null)"
                aria-pressed="@(Kiosk.IsActive ? "true" : "false")"
                aria-label="@(Kiosk.IsActive ? "Stop demos" : "Watch all demos")"
                title="@(Kiosk.IsActive ? "Stop watching all demos" : "Auto-play every demo in turn")"
                @onclick="ToggleWatchAll">
            <span class="home-action-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                    <path d="M8 21h8"/><path d="M12 17v4"/>
                    <polygon points="10 8 15 10.5 10 13 10 8" fill="currentColor" stroke="none"/>
                </svg>
            </span>
            <span class="home-action-label home-action-label--long" aria-hidden="true">@(Kiosk.IsActive ? "Stop demos" : "Watch all demos")</span>
            <span class="home-action-label home-action-label--short" aria-hidden="true">@(Kiosk.IsActive ? "Stop" : "Demos")</span>
        </button>

        <div class="home-filters" role="group" aria-label="Show games">
            @foreach (var f in Filters)
            {
                <button type="button" class="home-filter"
                        aria-pressed="@(_filter == f.Filter ? "true" : "false")"
                        title="@f.Hint"
                        @onclick="() => _filter = f.Filter">@f.Label</button>
            }
            <button type="button" class="home-filter home-filter--pins"
                    aria-pressed="@(_editPins ? "true" : "false")"
                    aria-label="@(_editPins ? "Done pinning" : "Pin favourites")"
                    title="@(_editPins ? "Done pinning" : "Pin favourite games to the top")"
                    @onclick="() => _editPins = !_editPins">@(_editPins ? "Done" : "★")</button>
        </div>

        @if (ContinueItems.Any())
        {
            <nav class="home-continue" aria-label="Continue playing">
                <span class="home-continue-kicker" aria-hidden="true">Continue</span>
                @foreach (var c in ContinueItems)
                {
                    <a class="home-continue-chip" href="@c.Url" data-hub-nav
                       title="@($"Continue: {c.Detail}")" aria-label="@($"Continue {c.Detail}")">
                        <span class="home-continue-icon" aria-hidden="true" data-hero>@c.Icon</span>
                        <span class="home-continue-label" aria-hidden="true">@c.Title</span>
                    </a>
                }
            </nav>
        }
    </div>

    <div class="home-grid">
        @foreach (var game in VisibleGames)
        {
            var pinned = HubPrefs.IsPinned(game.Key);
            var playable = IsPlayable(game.Primary);
            <article class="home-card @(pinned ? "home-card--pinned" : null)" aria-labelledby="@($"home-card-{game.Key.Value}")">
                @* The heading opens the game's main mode: one large target on every card,
                   however small a short phone makes the chips. Out of the tab order,
                   because the first chip is the same destination for a keyboard. *@
                @if (playable && !_editPins)
                {
                    <a class="home-card-head" href="@game.Primary.Url" data-hub-nav tabindex="-1"
                       title="@($"Play {game.Title} — {GameModes.ToDescription(game.Primary.Mode)}")">
                        <span class="home-card-icon" aria-hidden="true">@game.Icon</span>
                        <span class="home-card-title" id="@($"home-card-{game.Key.Value}")">@game.Title</span>
                        @if (pinned)
                        {
                            <span class="home-card-pin-mark" aria-hidden="true">★</span>
                        }
                    </a>
                }
                else
                {
                    <div class="home-card-head @(playable ? null : "home-card-head--offline")"
                         aria-disabled="@(playable ? null : "true")"
                         title="@(playable ? null : "Needs a connection — unavailable offline")">
                        <span class="home-card-icon" aria-hidden="true">@game.Icon</span>
                        <span class="home-card-title" id="@($"home-card-{game.Key.Value}")">@game.Title</span>
                        @if (pinned)
                        {
                            <span class="home-card-pin-mark" aria-hidden="true">★</span>
                        }
                    </div>
                }

                @* One chip per mode the catalogue declares, no exceptions, so no mode is
                   unreachable from here. While pinning, the chips make way for the pin. *@
                <div class="home-card-modes">
                    @if (_editPins)
                    {
                        <button type="button" class="home-pin"
                                aria-pressed="@(pinned ? "true" : "false")"
                                aria-label="@($"Pin {game.Title} to the top")"
                                @onclick="() => HubPrefs.TogglePin(game.Key)">@(pinned ? "★ Pinned" : "☆ Pin")</button>
                    }
                    else
                    {
                        @foreach (var m in game.Modes)
                        {
                            @ModeChip(game, m)
                        }
                    }
                </div>
            </article>
        }
    </div>

    @* Home page activity feed: surfaces the player's most recent matches
       so the page never feels empty even on a fresh install. Pulled from the
       existing /api/matches endpoint via ActivityFeedService — no new API. *@
    @if (_activity.Count > 0)
    {
        <section class="home-activity" aria-label="Your recent activity">
            <h2 class="home-activity__title">Your recent activity</h2>
            <ul class="home-activity__list">
                @foreach (var item in _activity)
                {
                    <li class="home-activity__item">
                        <span aria-hidden="true">@item.Icon</span>
                        <a href="@item.Url">@item.GameTitle</a>
                        <span>· @item.Message</span>
                        <span class="home-activity__time" title="@item.When.ToString("u")">@FormatRelative(item.When)</span>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private ElementReference _ambientCanvas;
    private IJSObjectReference? _ambientModule;
    private bool _ambientStarted;

    // Activity feed (recent matches).
    private IReadOnlyList<ActivityFeedService.FeedItem> _activity = Array.Empty<ActivityFeedService.FeedItem>();

    // ── Today ──
    private DailyPick _today = DailyChallengeService.PickFor(DateTime.UtcNow);
    private int _streak;
    private bool _doneToday;

    private string TodayLabel =>
        $"Today's game: {_today.Game.Title}{(_today.Seeded ? ", today's seeded run" : "")}. "
        + (_doneToday ? $"Played today, streak {_streak}." : _streak > 0 ? $"Daily streak {_streak}." : "Start a daily streak.");

    // ── Filters and pins ──
    private enum HubFilter { All, OnePlayer, TwoPlayer, Online }

    private static readonly (HubFilter Filter, string Label, string Hint)[] Filters =
    [
        (HubFilter.All, "All", "Every game"),
        (HubFilter.OnePlayer, "1P", "Games to play solo against the CPU"),
        (HubFilter.TwoPlayer, "2P", "Games for two players on one device"),
        (HubFilter.Online, "Online", "Games to play online"),
    ];

    // Not remembered between visits: a hub that opens with half its games missing reads as
    // broken. Pins are remembered (HubPrefsService).
    private HubFilter _filter = HubFilter.All;
    private bool _editPins;

    private bool Matches(CatalogGame game) => _filter switch
    {
        HubFilter.OnePlayer => game.Find(GameMode.OnePlayer) is not null,
        HubFilter.TwoPlayer => game.Find(GameMode.TwoPlayer) is not null,
        HubFilter.Online => game.Find(GameMode.Multiplayer) is not null,
        _ => true,
    };

    // Pinned games first; OrderBy is stable, so each group keeps the catalog's alphabetical order.
    private IEnumerable<CatalogGame> VisibleGames =>
        GameCatalog.AllSorted.Where(Matches).OrderBy(g => HubPrefs.IsPinned(g.Key) ? 0 : 1);

    // ── Continue ──
    private sealed record ContinueItem(string Icon, string Title, string Detail, string Url, CatalogMode Mode);

    private readonly List<ContinueItem> _continue = [];

    private IEnumerable<ContinueItem> ContinueItems => _continue.Where(c => IsPlayable(c.Mode));

    // Offline, a hub-backed or API-backed mode is not playable: with the service
    // worker installed the shell loads fine without a network, so leaving these
    // navigable would drop the player into a lobby that can never connect. Modes
    // that run locally stay fully playable.
    private bool IsPlayable(CatalogMode mode) => !mode.RequiresNetwork || OnlineStatus.IsOnline;

    // data-hub-nav: js/app.js launches the game in place, morphing the card into its title.
    private RenderFragment ModeChip(CatalogGame game, CatalogMode m) =>
        IsPlayable(m)
            ? @<a class="home-mode-chip home-mode-chip--@(m.Mode.ToString().ToLowerInvariant())"
                  href="@(m.ChipUrl ?? m.Url)" data-hub-nav
                  title="@($"{game.Title} — {GameModes.ToDescription(m.Mode)}")"
                  aria-label="@($"{game.Title}, {GameModes.ToDescription(m.Mode)}")">@GameModes.ToLabel(m.Mode)</a>
            : @<span class="home-mode-chip home-mode-chip--offline"
                     aria-disabled="true"
                     aria-label="@($"{game.Title}, {GameModes.ToDescription(m.Mode)} — unavailable offline")"
                     title="Needs a connection — unavailable offline">@GameModes.ToLabel(m.Mode)</span>;

    protected override void OnInitialized()
    {
        // Subscribe to kiosk state so the Demo button (Start ↔ Stop) updates
        // reactively when the coordinator starts/stops/pauses/advances.
        Kiosk.Changed += OnKioskStateChanged;
        // Connectivity drives which chips are navigable (see IsPlayable), so the grid
        // has to re-render the moment the browser goes offline or comes back.
        OnlineStatus.StateChanged += OnOnlineStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        _today = Daily.Today;
        ReadStreak();
        await LoadContinueAsync();

        // Pull the feed once on initial render. The ActivityFeedService is
        // best-effort — it never throws — so we can await it without a try
        // and still get a graceful empty feed if the API is offline.
        try
        {
            _activity = await ActivityFeed.GetRecentAsync(limit: 5);
        }
        catch
        {
            _activity = Array.Empty<ActivityFeedService.FeedItem>();
        }
    }

    private void ReadStreak()
    {
        _streak = Daily.CurrentStreak;
        _doneToday = Daily.DoneToday;
    }

    // Counted on launch: the Today card is the challenge, and the streak is for showing up.
    private void MarkDailyPlayed()
    {
        Daily.MarkPlayed();
        ReadStreak();
    }

    /// <summary>
    /// The "Continue" shortcuts: the last game mode opened, a PoMule match in progress, and (added
    /// after the first render, since it needs IndexedDB) a saved Ecosystem island.
    /// </summary>
    private async Task LoadContinueAsync()
    {
        var muleSaved = await MuleSaves.LoadAsync() is not null;
        var last = HubPrefs.LastPlayed
            ?? (GameStats.GetLastPlayedGame() is { } card ? HubPrefsService.Resolve(card.Url) : null);

        // The Mule and Ecosystem entries below are the better version of "last played" for
        // those two games, so a last-played pointing at either gives way to them.
        if (last is { } l && l.Game.Key != GameKeys.PoEcosystem && !(muleSaved && l.Game.Key == GameKeys.PoMule))
        {
            _continue.Add(new ContinueItem(l.Game.Icon, l.Game.Title,
                $"{l.Game.Title}, {GameModes.ToDescription(l.Mode.Mode)}", l.Mode.Url, l.Mode));
        }
        if (muleSaved && GameCatalog.All.First(g => g.Key == GameKeys.PoMule) is var mule
            && mule.Find(GameMode.OnePlayer) is { } muleSolo)
        {
            _continue.Add(new ContinueItem(mule.Icon, mule.Title, $"{mule.Title}, your match in progress", muleSolo.Url, muleSolo));
        }
    }

    private async Task AddEcoIslandAsync()
    {
        bool saved;
        try { saved = await JS.InvokeAsync<bool>("PoHub.hasEcoIsland"); }
        catch { return; /* app.js not loaded: no shortcut, nothing lost */ }
        if (!saved) return;
        var eco = GameCatalog.All.First(g => g.Key == GameKeys.PoEcosystem);
        if (eco.Find(GameMode.OnePlayer) is not { } solo) return;
        _continue.Add(new ContinueItem(eco.Icon, eco.Title, $"{eco.Title}, your island", solo.Url, solo));
        StateHasChanged();
    }

    private static string FormatRelative(DateTimeOffset when)
    {
        var diff = DateTimeOffset.UtcNow - when;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return when.ToString("MMM d");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Lazy WebGL bootstrap — only on first paint so we don't ship the
        // JS payload during SSR / prerender. Gate on the device-capability
        // probe so low-memory phones and prefers-reduced-motion users skip
        // the GPU wake entirely; the CSS gradient behind the canvas is the
        // fallback for everyone else.
        if (firstRender) await AddEcoIslandAsync();
        if (firstRender && !_ambientStarted)
        {
            _ambientStarted = true;
            // The --audio-* bands the card icons and the top bar's edge move to (fx.css).
            // Off by default in visualRuntime.js; on here and off in DisposeAsync so only
            // the catalog and the lobbies pay for the per-frame write.
            try { await JS.InvokeVoidAsync("PoVisualRuntime.enableAudioReactive", true); } catch { /* module not loaded */ }
            try
            {
                var canRender = await JS.InvokeAsync<bool>("probeWebGL2");
                if (!canRender)
                {
                    _ambientModule = null;
                    return;
                }
                _ambientModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/ambientParticles.js");
                await _ambientModule.InvokeVoidAsync("start", _ambientCanvas);
            }
            catch
            {
                // WebGL2 unavailable — the CSS gradient behind the canvas is the fallback.
                _ambientModule = null;
            }
        }
    }

    private void OnKioskStateChanged() => InvokeAsync(StateHasChanged);

    private void OnOnlineStateChanged() => InvokeAsync(StateHasChanged);

    // "Watch all demos": start (or stop) the auto-rotating kiosk over every demo game.
    private async Task ToggleWatchAll()
    {
        await Feedback.TapAsync();
        if (Kiosk.IsActive)
        {
            Kiosk.Stop();
            return;
        }
        await BeginKioskFromAsync(0);
    }

    /// <summary>
    /// Start the kiosk reel at the given demo index. The "Watch all demos"
    /// button always passes 0; the index parameter survives because the reel
    /// itself re-enters here when a game hands off to the next one.
    /// </summary>
    private async Task BeginKioskFromAsync(int index)
    {
        var demos = GameCatalog.Demo;
        if (demos.Count == 0) return;
        if (index < 0 || index >= demos.Count) index = 0;

        Kiosk.RegisterEntries(demos.Select(d => new Services.Play.DemoEntry(d.Key, d.Url, d.Title, d.Icon)));
        // Clear every active toast before entering the reel — the PWA "Update now"
        // prompt and any error toast are persistent (ShowAction never auto-expires) and
        // would otherwise follow the user into the loop and steal taps from the reel
        // controls. One-shot entry, not per-game.
        Toasts.DismissAll();
        var entry = demos[index];
        var sep = entry.Url.Contains('?') ? '&' : '?';
        // Display index `index` with advance pointer `index` so the first rotation
        // lands on `index + 1`. Starting at 1 instead of 0 used to skip the second
        // demo on every lap; the same logic has to work for non-zero starts.
        Kiosk.Start(index);
        NavigationManager.NavigateTo($"{entry.Url}{sep}kiosk={index}");
    }


    public async ValueTask DisposeAsync()
    {
        Kiosk.Changed -= OnKioskStateChanged;
        OnlineStatus.StateChanged -= OnOnlineStateChanged;
        try { await JS.InvokeVoidAsync("PoVisualRuntime.enableAudioReactive", false); } catch { /* page unloading */ }
        if (_ambientModule is not null)
        {
            try
            {
                await _ambientModule.InvokeVoidAsync("stop");
                await _ambientModule.DisposeAsync();
            }
            catch { /* module never loaded — fine */ }
            _ambientModule = null;
        }
    }
}
