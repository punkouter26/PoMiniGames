@page "/"
@inject NavigationManager NavigationManager
@inject GameStatsService GameStatsService
@inject ApiService ApiService
@inject KioskCoordinator Kiosk
@implements IAsyncDisposable

<div class="home-container">
    <span class="home-mesh" aria-hidden="true"></span>

    @if (_isLoading)
    {
        <div class="home-modes">
            <div class="skeleton skeleton--btn"></div>
            <div class="skeleton skeleton--btn"></div>
            <div class="skeleton skeleton--btn"></div>
            <div class="skeleton skeleton--btn"></div>
        </div>
    }
    else
    {
        <h1 class="home-title">
            <span class="home-title-icon">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                    <rect x="23" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                    <rect x="3" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                    <rect x="23" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                </svg>
            </span>
            PoMiniGames
        </h1>
        <p class="home-subtitle">Choose how you want to play</p>

        <div class="home-sections">
            <section class="home-section">
                <div class="home-mode-btn home-mode-btn--1p home-mode-btn--static">
                    <span class="home-mode-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </span>
                    <span class="home-mode-label">1 Player</span>
                </div>
                <div class="home-section-games">
                    @foreach (var g in GameCatalog.SinglePlayer)
                    {
                        <a class="home-game-chip" href="@g.Url"><span class="home-game-chip-icon">@g.Icon</span>@g.Title</a>
                    }
                </div>
            </section>

            <section class="home-section">
                <div class="home-mode-btn home-mode-btn--2p home-mode-btn--static">
                    <span class="home-mode-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </span>
                    <span class="home-mode-label">2 Player (local)</span>
                </div>
                <div class="home-section-games">
                    @foreach (var g in GameCatalog.LocalTwoPlayer)
                    {
                        <a class="home-game-chip" href="@g.Url"><span class="home-game-chip-icon">@g.Icon</span>@g.Title</a>
                    }
                </div>
            </section>

            <section class="home-section">
                <div class="home-mode-btn home-mode-btn--multi home-mode-btn--static">
                    <span class="home-mode-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M2 12h20"/>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                        </svg>
                    </span>
                    <span class="home-mode-label">Multi player (online)</span>
                </div>
                <div class="home-section-games">
                    @foreach (var g in GameCatalog.Multiplayer)
                    {
                        <a class="home-game-chip" href="@g.Url"><span class="home-game-chip-icon">@g.Icon</span>@g.Title</a>
                    }
                </div>
            </section>

            <section class="home-section">
                <button type="button" class="home-mode-btn home-mode-btn--demo @(Kiosk.IsActive ? "home-mode-btn--active" : null)"
                        aria-label="@(Kiosk.IsActive ? "Stop auto-cycling demos" : "Watch all demos (auto-cycle)")"
                        aria-pressed="@Kiosk.IsActive"
                        @onclick="OnDemoButtonClick">
                    <span class="home-mode-icon">
                        @if (Kiosk.IsActive)
                        {
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="6" y="5" width="4" height="14"/>
                                <rect x="14" y="5" width="4" height="14"/>
                            </svg>
                        }
                        else
                        {
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="5 3 19 12 5 21 5 3"/>
                            </svg>
                        }
                    </span>
                    <span class="home-mode-label">@(Kiosk.IsActive ? "Stop" : "Demo")</span>
                </button>
                <div class="home-section-games">
                    @foreach (var g in GameCatalog.Demo)
                    {
                        <a class="home-game-chip" href="@g.Url"><span class="home-game-chip-icon">@g.Icon</span>@g.Title</a>
                    }
                </div>
            </section>
        </div>

        <div class="home-stats-cta">
            <button type="button" class="home-mode-btn home-mode-btn--profile" aria-label="View my stats" @onclick='() => NavigationManager.NavigateTo("/profile")'>
                <span class="home-mode-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                        <path d="M17 11l2 2 4-4"/>
                    </svg>
                </span>
                <span class="home-mode-label">My Stats</span>
            </button>
        </div>

        <!-- High Scores Preview Carousel (UI 2) -->
        <section class="home-scores-preview">
            <h2 class="home-scores-title">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 6 9 6 9z"/>
                    <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5C17 4 18 9 18 9z"/>
                    <path d="M4 22h16"/>
                    <path d="M10 22V9h4v13"/>
                    <path d="M8 22V8"/>
                    <path d="M16 22V8"/>
                    <path d="M12 2v4m-2-2h4"/>
                </svg>
                Top Scores
            </h2>
            <div class="home-scores-carousel">
                @if (_topGames.Count == 0)
                {
                    <div class="home-scores-empty">
                        <svg class="home-scores-empty-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 6 9 6 9z"/>
                            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5C17 4 18 9 18 9z"/>
                            <path d="M4 22h16M10 22V9h4v13M8 22V8M16 22V8"/>
                        </svg>
                        <span>@(_topScoresError ? "Backend offline — play offline and scores will sync later." : "Play a game to appear here!")</span>
                        <button class="home-scores-empty-cta" @onclick='() => NavigationManager.NavigateTo("/")'>Pick a game →</button>
                    </div>
                }
                @foreach (var game in _topGames)
                {
                    <div class="home-score-card" @onclick="() => NavigationManager.NavigateTo(game.Url)">
                        <h3>@game.Title</h3>
                        <ol class="home-score-mini-list">
                            @foreach (var entry in game.Top3)
                            {
                                <li>@entry.Name: @entry.Score</li>
                            }
                        </ol>
                    </div>
                }
            </div>
        </section>

    }
</div>

@code {
    private bool _isLoading = true;
    private List<TopGamePreview> _topGames = [];
    private bool _topScoresError = false;
    private record TopGamePreview(string Title, string Url, List<ScoreEntry> Top3);
    private record ScoreEntry(string Name, string Score);

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to kiosk state so the Demo button (Start ↔ Stop) updates
        // reactively when the coordinator starts/stops/pauses/advances.
        Kiosk.Changed += OnKioskStateChanged;

        // BUG FIX (#8): Load top games in parallel instead of sequentially.
        // The previous foreach/await chain took ~30-150ms × 5 games when
        // the API was unreachable. Now all 5 leaderboard calls fire
        // concurrently and the total wall-time is dominated by the slowest.
        // Also surfaces a distinct "backend offline" state instead of the
        // confusing "Play a game to appear here!" empty message.
        await LoadTopGames();

        _isLoading = false;
    }

    private void OnKioskStateChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadTopGames()
    {
        var gameKeys = new[]
        {
            ("connectfive",    "Connect Five"),
            ("tictactoe",      "Tic Tac Toe"),
            ("pofight",        "PoFight"),
            ("poraceragdoll",  "PoRaceRagdoll"),
            ("pohorserace",    "PoHorseRace"),
        };

        // Fire all 5 leaderboard calls in parallel
        var tasks = gameKeys.Select(async kv =>
        {
            try
            {
                var lb = await ApiService.GetLeaderboardAsync(kv.Item1, 3);
                return (Key: kv.Item1, Title: kv.Item2, Leaderboard: lb);
            }
            catch
            {
                return (Key: kv.Item1, Title: kv.Item2, Leaderboard: (System.Collections.Generic.IEnumerable<PoMiniGamesClient.Models.PlayerStatsDto>?)null);
            }
        }).ToList();

        var results = await Task.WhenAll(tasks);
        _topGames = results
            .Where(r => r.Leaderboard != null && r.Leaderboard.Any())
            .Select(r => new TopGamePreview(
                r.Title,
                $"/{r.Key}",
                r.Leaderboard!.Select(e => new ScoreEntry(e.Name, $"{e.Stats.WinRate:P0}")).ToList()))
            .ToList();

        // If every call came back empty AND the API isn't reachable, mark the
        // error state so the empty UI can show "Backend offline" instead of
        // the misleading "Play a game to appear here!" prompt.
        if (_topGames.Count == 0)
        {
            try { _topScoresError = !await ApiService.IsAvailableAsync(); }
            catch { _topScoresError = true; }
        }
    }

    // Start the "Watch All Demos" auto-cycle directly from the home Demo tile: register
    // the demo roster with the coordinator, arm the advance timer, and jump to the first
    // demo. The coordinator then rotates game→game on its own (see KioskCoordinator).
    private void StartDemoKiosk()
    {
        var demos = GameCatalog.Demo;
        if (demos.Count == 0) return;

        Kiosk.RegisterEntries(demos.Select(d => new DemoEntry(d.Key, d.Url, d.Title, d.Icon)));

        var first = demos[0];
        var sep = first.Url.Contains('?') ? '&' : '?';
        Kiosk.Start(1); // advanceIndex 1 → after this demo the coordinator moves to demos[1]
        NavigationManager.NavigateTo($"{first.Url}{sep}kiosk=1");
    }

    // The Demo button is a toggle: it starts the auto-cycle when idle and
    // stops it (and returns home) when the cycle is already running. This
    // makes the kiosk mode cancelable from the home view — no need to
    // navigate into a running demo just to find the exit control.
    private void OnDemoButtonClick()
    {
        if (Kiosk.IsActive)
        {
            Kiosk.Stop();
        }
        else
        {
            StartDemoKiosk();
        }
    }

    public ValueTask DisposeAsync()
    {
        Kiosk.Changed -= OnKioskStateChanged;
        return ValueTask.CompletedTask;
    }
}