@page "/"
@inject NavigationManager NavigationManager
@inject KioskCoordinator Kiosk
@inject IJSRuntime JS
@inject ActivityFeedService ActivityFeed
@inject UiFeedbackService Feedback
@implements IAsyncDisposable

<div class="home-container">
    <span class="home-mesh" aria-hidden="true"></span>
    @* §4 GPU-accelerated ambient particle field. WebGL2-only; falls back to the
       CSS gradient on browsers without WebGL2 (Safari TP, etc.). *@
    <canvas @ref="_ambientCanvas" class="home-ambient" aria-hidden="true"></canvas>

    <h1 class="home-title">
        <span class="home-title-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                <rect x="23" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                <rect x="3" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                <rect x="23" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
            </svg>
        </span>
        PoMiniGames
    </h1>
    <p class="home-subtitle">Choose how you want to play</p>

    <div class="home-sections" id="home-modes">
            <section class="home-section @(_sectionOpen[0] ? "" : "home-section--collapsed")">
                <div class="home-mode-col">
                    <button type="button"
                            class="home-mode-btn home-mode-btn--demo @(Kiosk.IsActive ? "home-mode-btn--demo-on" : null)"
                            aria-pressed="@Kiosk.IsActive"
                            aria-label="@(Kiosk.IsActive ? "Stop demo auto-cycle" : "Watch all demos")"
                            title="@(Kiosk.IsActive ? "Stop watching all demos" : "Watch all demos")"
                            @onclick="ToggleWatchAll">
                        <span class="home-mode-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="3" width="20" height="14" rx="2"/>
                                <path d="M8 21h8"/>
                                <path d="M12 17v4"/>
                                <polygon points="10 8 15 10.5 10 13 10 8" fill="currentColor" stroke="none"/>
                            </svg>
                        </span>
                        <span class="home-mode-label">@(Kiosk.IsActive ? "Stop" : "Demo")</span>
                    </button>
                    <p class="home-mode-caption">@(Kiosk.IsActive ? "Auto-cycling demos…" : "Sit back and watch")</p>
                    @SectionToggle(0, GameCatalog.Demo.Count)
                </div>
                <div class="home-section-games">
                    @* The big Demo card on the left toggles "watch all demos" (the
                       auto-rotating kiosk over every demo chip). Individual chips below
                       play one game in demo mode continuously until the user navigates
                       home, mirroring the BottomTabBar's Demo toggle. *@
                    @foreach (var g in GameCatalog.Demo.OrderBy(x => x.Title, StringComparer.OrdinalIgnoreCase))
                    {
                        <a class="home-game-chip" href="@g.Url"><span class="home-game-chip-icon">@g.Icon</span>@g.Title</a>
                    }
                </div>
            </section>

            <section class="home-section @(_sectionOpen[1] ? "" : "home-section--collapsed")">
                <div class="home-mode-col">
                    <div class="home-mode-btn home-mode-btn--1p home-mode-btn--static">
                        <span class="home-mode-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                        </span>
                        <span class="home-mode-label">1 Player</span>
                    </div>
                    <a class="home-lb-btn" href="/leaderboards">
                        <span class="home-lb-icon" aria-hidden="true">🏆</span>Leaderboard
                    </a>
                    @SectionToggle(1, GameCatalog.SinglePlayer.Count)
                </div>
                <div class="home-section-games">
                    @foreach (var g in GameCatalog.SinglePlayer.OrderBy(x => x.Title, StringComparer.OrdinalIgnoreCase))
                    {
                        <a class="home-game-chip" href="@g.Url">
                            <span class="home-game-chip-icon">@g.Icon</span>@g.Title
                        </a>
                    }
                </div>
            </section>

            <section class="home-section @(_sectionOpen[2] ? "" : "home-section--collapsed")">
                <div class="home-mode-col">
                    <div class="home-mode-btn home-mode-btn--2p home-mode-btn--static">
                        <span class="home-mode-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </span>
                        <span class="home-mode-label">2 Player (local)</span>
                    </div>
                    <a class="home-lb-btn" href="/leaderboards">
                        <span class="home-lb-icon" aria-hidden="true">🏆</span>Leaderboard
                    </a>
                    @SectionToggle(2, GameCatalog.LocalTwoPlayer.Count)
                </div>
                <div class="home-section-games">
                    @foreach (var g in GameCatalog.LocalTwoPlayer.OrderBy(x => x.Title, StringComparer.OrdinalIgnoreCase))
                    {
                        <a class="home-game-chip" href="@g.Url"><span class="home-game-chip-icon">@g.Icon</span>@g.Title</a>
                    }
                </div>
            </section>

            <section class="home-section @(_sectionOpen[3] ? "" : "home-section--collapsed")">
                <div class="home-mode-col">
                    <div class="home-mode-btn home-mode-btn--multi home-mode-btn--static">
                        <span class="home-mode-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M2 12h20"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                        </span>
                        <span class="home-mode-label">Multi player (online)</span>
                    </div>
                    <a class="home-lb-btn" href="/leaderboards">
                        <span class="home-lb-icon" aria-hidden="true">🏆</span>Leaderboard
                    </a>
                    @SectionToggle(3, GameCatalog.Multiplayer.Count)
                </div>
                <div class="home-section-games">
                    @foreach (var g in GameCatalog.Multiplayer.OrderBy(x => x.Title, StringComparer.OrdinalIgnoreCase))
                    {
                        <a class="home-game-chip" href="@g.Url"><span class="home-game-chip-icon">@g.Icon</span>@g.Title</a>
                    }
                </div>
            </section>

        </div>

        <div class="home-stats-cta">
            <button type="button" class="home-mode-btn home-mode-btn--profile" aria-label="View my stats" @onclick="GoToStats">
                <span class="home-mode-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                        <path d="M17 11l2 2 4-4"/>
                    </svg>
                </span>
                <span class="home-mode-label">My Stats</span>
            </button>
        </div>

    @* §9 home page activity feed: surfaces the player's most recent matches
       so the page never feels empty even on a fresh install. Pulled from the
       existing /api/matches endpoint via ActivityFeedService — no new API. *@
    @if (_activity.Count > 0)
    {
        <section class="home-activity" aria-label="Your recent activity">
            <h2 class="home-activity__title">Your recent activity</h2>
            <ul class="home-activity__list">
                @foreach (var item in _activity)
                {
                    <li class="home-activity__item">
                        <span aria-hidden="true">@item.Icon</span>
                        <a href="@item.Url">@item.GameTitle</a>
                        <span>· @item.Message</span>
                        <span class="home-activity__time" title="@item.When.ToString("u")">@FormatRelative(item.When)</span>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private ElementReference _ambientCanvas;
    private IJSObjectReference? _ambientModule;
    private bool _ambientStarted;

    // §9: activity feed (recent matches).
    private IReadOnlyList<ActivityFeedService.FeedItem> _activity = Array.Empty<ActivityFeedService.FeedItem>();

    // Collapsible home sections — only takes visual effect on phones (see .home-section-toggle
    // / .home-section--collapsed CSS, both mobile-only). Desktop always shows every game, so
    // starting the sections "closed" trims the long mobile scroll without touching
    // the desktop layout. Order: Demo, 1 Player, 2 Player, Multiplayer.
    // §6 the 1-Player section (index 1) starts expanded — it's the primary flow,
    // so a portrait player lands on a visible game list instead of four collapsed
    // accordions requiring a tap to reveal anything.
    private readonly bool[] _sectionOpen = { false, true, false, false };
    private void ToggleSection(int i) => _sectionOpen[i] = !_sectionOpen[i];
    private RenderFragment SectionToggle(int i, int count) => @<button type="button"
        class="home-section-toggle" aria-expanded="@_sectionOpen[i]"
        @onclick="() => ToggleSection(i)">
        <span class="home-section-toggle-chev">@(_sectionOpen[i] ? "▾" : "▸")</span>@count games
    </button>;

    protected override void OnInitialized()
    {
        // Subscribe to kiosk state so the Demo button (Start ↔ Stop) updates
        // reactively when the coordinator starts/stops/pauses/advances.
        Kiosk.Changed += OnKioskStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // Pull the feed once on initial render. The ActivityFeedService is
        // best-effort — it never throws — so we can await it without a try
        // and still get a graceful empty feed if the API is offline.
        try
        {
            _activity = await ActivityFeed.GetRecentAsync(limit: 5);
        }
        catch
        {
            _activity = Array.Empty<ActivityFeedService.FeedItem>();
        }
    }

    private static string FormatRelative(DateTimeOffset when)
    {
        var diff = DateTimeOffset.UtcNow - when;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return when.ToString("MMM d");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // §2 Lazy WebGL bootstrap — only on first paint so we don't ship the
        // JS payload during SSR / prerender. Gate on the device-capability
        // probe so low-memory phones and prefers-reduced-motion users skip
        // the GPU wake entirely; the CSS gradient behind the canvas is the
        // fallback for everyone else.
        if (firstRender && !_ambientStarted)
        {
            _ambientStarted = true;
            try
            {
                var canRender = await JS.InvokeAsync<bool>("probeWebGL2");
                if (!canRender)
                {
                    _ambientModule = null;
                    return;
                }
                _ambientModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/ambientParticles.js");
                await _ambientModule.InvokeVoidAsync("start", _ambientCanvas);
            }
            catch
            {
                // WebGL2 unavailable — the CSS gradient behind the canvas is the fallback.
                _ambientModule = null;
            }
        }
    }

    private void OnKioskStateChanged() => InvokeAsync(StateHasChanged);

    // §10 fire a Web Audio tap before navigating to the stats page. The audio
    // unlock happens on this same user gesture — the first tap unlocks the
    // AudioContext (mobile autoplay rules) and plays; best-effort, never blocks.
    private async Task GoToStats()
    {
        await Feedback.TapAsync();
        NavigationManager.NavigateTo("/profile");
    }

    // "Play all": start (or stop) the auto-rotating kiosk over every demo game.
    // Mirrors BottomTabBar's toggle so both entry points share one coordinator.
    private async Task ToggleWatchAll()
    {
        await Feedback.TapAsync();
        if (Kiosk.IsActive)
        {
            Kiosk.Stop();
            return;
        }

        var demos = GameCatalog.Demo;
        if (demos.Count == 0) return;

        Kiosk.RegisterEntries(demos.Select(d => new Services.DemoEntry(d.Key, d.Url, d.Title, d.Icon)));
        var first = demos[0];
        var sep = first.Url.Contains('?') ? '&' : '?';
        // Display index 0 with advance pointer 0 so the first rotation lands on index 1
        // (TicTacToe). Starting at 1 skipped the second demo on every lap.
        Kiosk.Start(0);
        NavigationManager.NavigateTo($"{first.Url}{sep}kiosk=0");
    }

    public async ValueTask DisposeAsync()
    {
        Kiosk.Changed -= OnKioskStateChanged;
        if (_ambientModule is not null)
        {
            try
            {
                await _ambientModule.InvokeVoidAsync("stop");
                await _ambientModule.DisposeAsync();
            }
            catch { /* module never loaded — fine */ }
            _ambientModule = null;
        }
    }
}