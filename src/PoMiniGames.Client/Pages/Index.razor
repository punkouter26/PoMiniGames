@page "/"
@inject NavigationManager NavigationManager
@inject KioskCoordinator Kiosk
@inject IJSRuntime JS
@inject ActivityFeedService ActivityFeed
@inject UiFeedbackService Feedback
@inject OnlineStatusService OnlineStatus
@implements IAsyncDisposable

@* ─────────────────────────────────────────────────────────────────────────
   Home — one card per game, one chip per mode.

   This replaced four mode-keyed sections (Demo / 1P / 2P / Multiplayer), each
   of which listed the games that supported it. That shape had two costs:

     • Nine of ten games appeared two-to-four times on one screen, and each
       section carried its own duplicate 🏆 Leaderboard link to the same URL.
     • A game was only discoverable in a mode if someone remembered to add it
       to that section's list. PoSurvive and PoJoker were never added to any
       interactive section, so the two of them were watch-only from here
       despite both having working single-player routes.

   Pivoting to game-major fixes both: the card is the game, the chips are
   whatever modes it declares in GameCatalog, so a supported mode cannot go
   un-listed. See GameCatalog.All.
   ───────────────────────────────────────────────────────────────────────── *@

<PageTitle>PoMiniGames — pick a game</PageTitle>

<div class="home-container">
    <span class="home-mesh" aria-hidden="true"></span>
    @* §4 GPU-accelerated ambient particle field. WebGL2-only; falls back to the
       CSS gradient on browsers without WebGL2 (Safari TP, etc.). *@
    <canvas @ref="_ambientCanvas" class="home-ambient" aria-hidden="true"></canvas>

    <h1 class="home-title">
        <span class="home-title-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                <rect x="23" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                <rect x="3" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                <rect x="23" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
            </svg>
        </span>
        PoMiniGames
    </h1>
    <p class="home-subtitle">Pick a game, then pick how you want to play</p>

    @* One action row. Previously the Leaderboard link was rendered three times
       (once per non-demo section) pointing at the same page, and My Stats sat in
       a separate block below the grid. *@
    <div class="home-actions">
        @* aria-pressed below is a literal string, not a bare bool: Blazor renders
           a bool-valued attribute as an HTML boolean attribute, which emits
           aria-pressed="" when true and drops it entirely when false — neither is
           a valid ARIA state (2026-08-08 audit #4).

           Note this comment sits OUTSIDE the tag on purpose. A Razor comment
           block inside an attribute list is not treated as a comment at all —
           it is parsed as an attribute NAME, and the runtime then throws
           InvalidCharacterError from setAttribute, taking down the whole page
           render. Keep markup comments between elements, never between
           attributes. *@
        <button type="button"
                class="home-action home-action--demo @(Kiosk.IsActive ? "home-action--on" : null)"
                aria-pressed="@(Kiosk.IsActive ? "true" : "false")"
                title="@(Kiosk.IsActive ? "Stop watching all demos" : "Auto-play every demo in turn")"
                @onclick="ToggleWatchAll">
            <span class="home-action-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                    <path d="M8 21h8"/><path d="M12 17v4"/>
                    <polygon points="10 8 15 10.5 10 13 10 8" fill="currentColor" stroke="none"/>
                </svg>
            </span>
            @(Kiosk.IsActive ? "Stop demos" : "Watch all demos")
        </button>

        <a class="home-action" href="/leaderboards">
            <span class="home-action-icon" aria-hidden="true">🏆</span>Leaderboards
        </a>

        <button type="button" class="home-action" @onclick="GoToStats">
            <span class="home-action-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/><path d="M17 11l2 2 4-4"/>
                </svg>
            </span>My Stats
        </button>

        @* The ⚙️ Settings action (and the /settings page behind it) was removed on
           2026-08-11 by request. Theme, volume, haptics and motion now run on their
           defaults; the FPS badge is always on in the top bar. *@
    </div>

    <div class="home-grid">
        @foreach (var game in GameCatalog.AllSorted)
        {
            <article class="home-card" aria-labelledby="@($"home-card-{game.Key.Value}")">
                @* The whole card heading is the primary action — the richest
                   interactive mode (see CatalogGame.Primary), never Demo. The
                   chips below still address each mode individually. *@
                @if (IsPlayable(game.Primary))
                {
                    <a class="home-card-head" href="@game.Primary.Url" data-fx-tilt="9">
                        <span class="home-card-icon" aria-hidden="true">@game.Icon</span>
                        <span class="home-card-title" id="@($"home-card-{game.Key.Value}")">@game.Title</span>
                        @* Audit #10: optional subtitle clarifies variants whose
                           product name does not by itself describe the rules
                           (e.g. "Tic-Tac-Toe" is actually 4-in-a-row on 6×6). *@
                        @if (!string.IsNullOrWhiteSpace(game.Subtitle))
                        {
                            <span class="home-card-subtitle" aria-label="@game.Subtitle">@game.Subtitle</span>
                        }
                    </a>
                }
                else
                {
                    <span class="home-card-head home-card-head--offline" aria-disabled="true"
                          title="Needs a connection — unavailable offline">
                        <span class="home-card-icon" aria-hidden="true">@game.Icon</span>
                        <span class="home-card-title" id="@($"home-card-{game.Key.Value}")">@game.Title</span>
                        @if (!string.IsNullOrWhiteSpace(game.Subtitle))
                        {
                            <span class="home-card-subtitle" aria-label="@game.Subtitle">@game.Subtitle</span>
                        }
                    </span>
                }

                <div class="home-card-modes">
                    @* 2026-08-10 audit #3: a card whose only mode is the primary
                       link (Couple Quiz) used to render the same destination twice
                       — once as the card head, once as a chip — which read as a
                       broken second link rather than a deliberate empty chip
                       row. Suppress the chip when its URL matches the head's
                       URL; render a small "How to play" pill on cards that
                       would otherwise have zero chips so the row is never
                       visually orphaned. *@
                    @* 2026-08-10: CatalogGame.ChipPrimary opts a card out of that
                       suppression. Marble Race's only non-primary mode is Demo, so
                       hiding the 1P chip left the card advertising "Demo" alone and
                       players took it for a watch-only game. *@
                    @{
                        var visibleChips = game.Modes
                            .Where(m => game.ChipPrimary
                                        || !string.Equals(m.Url, game.Primary.Url, StringComparison.OrdinalIgnoreCase))
                            .ToList();
                    }
                    @foreach (var m in visibleChips)
                    {
                        @ModeChip(game, m)
                    }
                    @if (visibleChips.Count == 0)
                    {
                        @* 2026-08-10: Couple Quiz is the only game where every
                           mode matches the card head, so visibleChips is empty.
                           Render the primary action as a real chip rather than a
                           "How to play" info pill — the card head already says
                           "Couple Quiz", a generic "How to play" pill read as a
                           missing link. The chip carries the mode label so a
                           player landing on the card knows the game is online
                           multiplayer. Browser audit #2 (2026-08-10): prefer the
                           chip's ChipUrl so the chip destination is distinct
                           from the head's URL even on a single-mode card. *@
                        <a class="home-mode-chip home-mode-chip--@game.Primary.Mode.ToString().ToLowerInvariant()"
                           href="@(game.Primary.ChipUrl ?? game.Primary.Url)"
                           title="@($"{game.Title} — {GameModes.ToDescription(game.Primary.Mode)}")"
                           aria-label="@($"{game.Title}, {GameModes.ToDescription(game.Primary.Mode)}")">@GameModes.ToLabel(game.Primary.Mode)</a>
                    }
                </div>
            </article>
        }
    </div>

    @* §9 home page activity feed: surfaces the player's most recent matches
       so the page never feels empty even on a fresh install. Pulled from the
       existing /api/matches endpoint via ActivityFeedService — no new API. *@
    @if (_activity.Count > 0)
    {
        <section class="home-activity" aria-label="Your recent activity">
            <h2 class="home-activity__title">Your recent activity</h2>
            <ul class="home-activity__list">
                @foreach (var item in _activity)
                {
                    <li class="home-activity__item">
                        <span aria-hidden="true">@item.Icon</span>
                        <a href="@item.Url">@item.GameTitle</a>
                        <span>· @item.Message</span>
                        <span class="home-activity__time" title="@item.When.ToString("u")">@FormatRelative(item.When)</span>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private ElementReference _ambientCanvas;
    private IJSObjectReference? _ambientModule;
    private bool _ambientStarted;

    // §9: activity feed (recent matches).
    private IReadOnlyList<ActivityFeedService.FeedItem> _activity = Array.Empty<ActivityFeedService.FeedItem>();

    // Offline, a hub-backed or API-backed mode is not playable: with the service
    // worker installed the shell loads fine without a network, so leaving these
    // navigable would drop the player into a lobby that can never connect. Modes
    // that run locally stay fully playable.
    private bool IsPlayable(CatalogMode mode) => !mode.RequiresNetwork || OnlineStatus.IsOnline;

    // data-fx-tilt: fxTilt.js gives the chip a pointer-tracked 3D tilt. Only the
    // navigable variant gets it — tilting a disabled chip would advertise an
    // affordance that is not there.
    private RenderFragment ModeChip(CatalogGame game, CatalogMode m) =>
        IsPlayable(m)
            ? @<a class="home-mode-chip home-mode-chip--@(m.Mode.ToString().ToLowerInvariant())"
                  href="@(m.ChipUrl ?? m.Url)"
                  title="@($"{game.Title} — {GameModes.ToDescription(m.Mode)}")"
                  aria-label="@($"{game.Title}, {GameModes.ToDescription(m.Mode)}")">@GameModes.ToLabel(m.Mode)</a>
            : @<span class="home-mode-chip home-mode-chip--offline"
                     aria-disabled="true"
                     aria-label="@($"{game.Title}, {GameModes.ToDescription(m.Mode)} — unavailable offline")"
                     title="Needs a connection — unavailable offline">@GameModes.ToLabel(m.Mode)</span>;

    protected override void OnInitialized()
    {
        // Subscribe to kiosk state so the Demo button (Start ↔ Stop) updates
        // reactively when the coordinator starts/stops/pauses/advances.
        Kiosk.Changed += OnKioskStateChanged;
        // Connectivity drives which chips are navigable (see IsPlayable), so the grid
        // has to re-render the moment the browser goes offline or comes back.
        OnlineStatus.StateChanged += OnOnlineStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // Pull the feed once on initial render. The ActivityFeedService is
        // best-effort — it never throws — so we can await it without a try
        // and still get a graceful empty feed if the API is offline.
        try
        {
            _activity = await ActivityFeed.GetRecentAsync(limit: 5);
        }
        catch
        {
            _activity = Array.Empty<ActivityFeedService.FeedItem>();
        }
    }

    private static string FormatRelative(DateTimeOffset when)
    {
        var diff = DateTimeOffset.UtcNow - when;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return when.ToString("MMM d");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // §2 Lazy WebGL bootstrap — only on first paint so we don't ship the
        // JS payload during SSR / prerender. Gate on the device-capability
        // probe so low-memory phones and prefers-reduced-motion users skip
        // the GPU wake entirely; the CSS gradient behind the canvas is the
        // fallback for everyone else.
        if (firstRender && !_ambientStarted)
        {
            _ambientStarted = true;
            try
            {
                var canRender = await JS.InvokeAsync<bool>("probeWebGL2");
                if (!canRender)
                {
                    _ambientModule = null;
                    return;
                }
                _ambientModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/ambientParticles.js");
                await _ambientModule.InvokeVoidAsync("start", _ambientCanvas);
            }
            catch
            {
                // WebGL2 unavailable — the CSS gradient behind the canvas is the fallback.
                _ambientModule = null;
            }
        }
    }

    private void OnKioskStateChanged() => InvokeAsync(StateHasChanged);

    private void OnOnlineStateChanged() => InvokeAsync(StateHasChanged);

    // §10 fire a Web Audio tap before navigating to the stats page. The audio
    // unlock happens on this same user gesture — the first tap unlocks the
    // AudioContext (mobile autoplay rules) and plays; best-effort, never blocks.
    private async Task GoToStats()
    {
        await Feedback.TapAsync();
        NavigationManager.NavigateTo("/profile");
    }

    // "Watch all demos": start (or stop) the auto-rotating kiosk over every demo game.
    private async Task ToggleWatchAll()
    {
        await Feedback.TapAsync();
        if (Kiosk.IsActive)
        {
            Kiosk.Stop();
            return;
        }

        var demos = GameCatalog.Demo;
        if (demos.Count == 0) return;

        Kiosk.RegisterEntries(demos.Select(d => new Services.DemoEntry(d.Key, d.Url, d.Title, d.Icon)));
        var first = demos[0];
        var sep = first.Url.Contains('?') ? '&' : '?';
        // Display index 0 with advance pointer 0 so the first rotation lands on index 1
        // (TicTacToe). Starting at 1 skipped the second demo on every lap.
        Kiosk.Start(0);
        NavigationManager.NavigateTo($"{first.Url}{sep}kiosk=0");
    }

    public async ValueTask DisposeAsync()
    {
        Kiosk.Changed -= OnKioskStateChanged;
        OnlineStatus.StateChanged -= OnOnlineStateChanged;
        if (_ambientModule is not null)
        {
            try
            {
                await _ambientModule.InvokeVoidAsync("stop");
                await _ambientModule.DisposeAsync();
            }
            catch { /* module never loaded — fine */ }
            _ambientModule = null;
        }
    }
}
