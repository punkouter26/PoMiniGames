@page "/"
@inject NavigationManager NavigationManager
@inject GameStatsService GameStatsService
@inject ApiService ApiService
@implements IAsyncDisposable

<div class="home-container">
    <span class="home-mesh" aria-hidden="true"></span>

    @if (_isLoading)
    {
        <div class="home-modes" style="gap:1rem;z-index:1">
            <div class="skeleton skeleton--btn"></div>
            <div class="skeleton skeleton--btn"></div>
            <div class="skeleton skeleton--btn"></div>
            <div class="skeleton skeleton--btn"></div>
        </div>
    }
    else
    {
        <h1 class="home-title">
            <span class="home-title-icon">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                    <rect x="23" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                    <rect x="3" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                    <rect x="23" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                </svg>
            </span>
            PoMiniGames
        </h1>
        <p class="home-subtitle">Choose how you want to play</p>

        <div class="home-modes">
            <button type="button" class="home-mode-btn home-mode-btn--1p" aria-label="Play 1 player" autofocus @onclick='() => NavigationManager.NavigateTo("/single-player")'>
                <span class="home-mode-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </span>
                <span class="home-mode-label">1 Player</span>
            </button>

            <button type="button" class="home-mode-btn home-mode-btn--2p" aria-label="Play 2 players locally" @onclick='() => NavigationManager.NavigateTo("/single-player?mode=local-2p")'>
                <span class="home-mode-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </span>
                <span class="home-mode-label">2 Player (local)</span>
            </button>

            <button type="button" class="home-mode-btn home-mode-btn--multi" aria-label="Play online multiplayer" @onclick='() => NavigationManager.NavigateTo("/porunner?mode=multi")'>
                <span class="home-mode-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M2 12h20"/>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    </svg>
                </span>
                <span class="home-mode-label">Multi player (online)</span>
            </button>

            <button type="button" class="home-mode-btn home-mode-btn--demo" aria-label="Watch demo mode" @onclick='() => NavigationManager.NavigateTo("/single-player?mode=demo")'>
                <span class="home-mode-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="5 3 19 12 5 21 5 3"/>
                    </svg>
                </span>
                <span class="home-mode-label">Demo</span>
            </button>

            <button type="button" class="home-mode-btn home-mode-btn--profile" aria-label="View my stats profile" @onclick='() => NavigationManager.NavigateTo("/profile")'>
                <span class="home-mode-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                        <path d="M17 11l2 2 4-4"/>
                    </svg>
                </span>
                <span class="home-mode-label">My Stats</span>
            </button>
        </div>

        <!-- High Scores Preview Carousel (UI 2) -->
        <section class="home-scores-preview">
            <h2 class="home-scores-title">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:0.4rem">
                    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 6 9 6 9z"/>
                    <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5C17 4 18 9 18 9z"/>
                    <path d="M4 22h16"/>
                    <path d="M10 22V9h4v13"/>
                    <path d="M8 22V8"/>
                    <path d="M16 22V8"/>
                    <path d="M12 2v4m-2-2h4"/>
                </svg>
                Top Scores
            </h2>
            <div class="home-scores-carousel">
                @if (_topGames.Count == 0)
                {
                    <div class="home-scores-empty">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity:0.3">
                            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 6 9 6 9z"/>
                            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5C17 4 18 9 18 9z"/>
                            <path d="M4 22h16M10 22V9h4v13M8 22V8M16 22V8"/>
                        </svg>
                        <span>Play a game to appear here!</span>
                        <button class="home-scores-empty-cta" @onclick='() => NavigationManager.NavigateTo("/single-player")'>Pick a game →</button>
                    </div>
                }
                @foreach (var game in _topGames)
                {
                    <div class="home-score-card" @onclick="() => NavigationManager.NavigateTo(game.Url)">
                        <h3>@game.Title</h3>
                        <ol class="home-score-mini-list">
                            @foreach (var entry in game.Top3)
                            {
                                <li>@entry.Name: @entry.Score</li>
                            }
                        </ol>
                    </div>
                }
            </div>
        </section>

    }
</div>

@code {
    private bool _isLoading = true;
    private List<TopGamePreview> _topGames = [];
    private record TopGamePreview(string Title, string Url, List<ScoreEntry> Top3);
    private record ScoreEntry(string Name, string Score);

    protected override async Task OnInitializedAsync()
    {
        // Simulate Blazor WASM startup delay with skeleton
        await Task.Delay(100);
        
        // Load top games with scores
        await LoadTopGames();
        
        _isLoading = false;
    }

    private async Task LoadTopGames()
    {
        var gameKeys = new[] { "connectfive", "tictactoe", "pofight", "poraceragdoll", "pohorserace" };
        _topGames = [];
        
        foreach (var key in gameKeys)
        {
            var leaderboard = await ApiService.GetLeaderboardAsync(key, 3);
            if (leaderboard != null && leaderboard.Any())
            {
                var gameTitle = key switch
                {
                    "connectfive" => "Connect Five",
                    "tictactoe" => "Tic Tac Toe",
                    "pofight" => "PoFight",
                    "poraceragdoll" => "PoRaceRagdoll",
                    "pohorserace" => "PoHorseRace",
                    _ => key
                };
                
                _topGames.Add(new TopGamePreview(
                    gameTitle,
                    $"/{key}",
                    leaderboard.Select(e => new ScoreEntry(e.Name, $"{e.Stats.WinRate:P0}")).ToList()
                ));
            }
        }
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}