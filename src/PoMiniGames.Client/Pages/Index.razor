@page "/"
@using PoMiniGamesClient.Services
@inject NavigationManager NavigationManager

<div class="home-container">
    <span class="home-orb home-orb--1" aria-hidden="true"></span>
    <span class="home-orb home-orb--2" aria-hidden="true"></span>
    <span class="home-orb home-orb--3" aria-hidden="true"></span>
    <span class="home-orb home-orb--4" aria-hidden="true"></span>
    <span class="home-orb home-orb--5" aria-hidden="true"></span>

    <h1 class="home-title">
        <span class="home-title-icon">🎮</span>
        PoMiniGames
    </h1>
    <p class="home-subtitle">Choose how you want to play</p>

    <div class="home-modes">
        <button type="button" class="home-mode-btn home-mode-btn--1p" aria-label="Play 1 player" autofocus @onclick='() => NavigationManager.NavigateTo("/single-player")'>
            <span class="home-mode-icon">👤</span>
            <span class="home-mode-label">1 Player</span>
        </button>

        <button type="button" class="home-mode-btn home-mode-btn--2p" aria-label="Play 2 players locally" @onclick='() => NavigationManager.NavigateTo("/multi-player-select")'>
            <span class="home-mode-icon">👥</span>
            <span class="home-mode-label">2 Player (local)</span>
        </button>

        <button type="button" class="home-mode-btn home-mode-btn--multi" aria-label="Play online multiplayer" @onclick='() => NavigationManager.NavigateTo("/online-multiplayer")'>
            <span class="home-mode-icon">🌐</span>
            <span class="home-mode-label">Multi player (online)</span>
        </button>

        <button type="button" class="home-mode-btn home-mode-btn--demo" aria-label="Watch demo mode" @onclick='() => NavigationManager.NavigateTo("/single-player?mode=demo")'>
            <span class="home-mode-icon">🖥️</span>
            <span class="home-mode-label">Demo</span>
        </button>
    </div>
</div>