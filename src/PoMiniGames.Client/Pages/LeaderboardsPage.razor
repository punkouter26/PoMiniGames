@page "/leaderboards"
@inject ApiService ApiService
@inject NavigationManager NavigationManager
@inject BrowserViewport Viewport
@inject PlayerNameService PlayerNameService
@implements IAsyncDisposable

<PageTitle>Leaderboards · PoMiniGames</PageTitle>

<div class="lb-page">
    <header class="lb-head">
        <h1 class="lb-title">Leaderboards</h1>
        @if (!_loading && _boards.Count > 0)
        {
            // 2026-08-08 audit #11: previously read "9 ranked · 1 demo-only",
            // which read as a missing leaderboard rather than a missing game.
            // PoSurvive is demo-only by design (it has no 1P scored mode — see
            // UnifiedLeaderboardEndpoints), so it is one of the 10 catalog
            // games with no board. Browser audit #8 (2026-08-10): the "demo-only"
            // word still implied a leaderboard is missing because the game is
            // limited. The Survive page is fully playable — its 1P mode is
            // scored locally as a session count, not a competitive number, so
            // there is nothing to rank. New copy: "{ranked} with leaderboards ·
            // {remaining} no-leaderboard yet", and the title attribute points
            // at the Survive card so the curious visitor can find the page.
            var rankedCount = _boards.Count;
            var totalGames = GameCatalog.All.Count;
            var noBoardCount = totalGames - rankedCount;
            string label = totalGames > 0 && noBoardCount == 0
                ? $"{rankedCount} ranked games"
                : $"{rankedCount} with leaderboards · {noBoardCount} no-leaderboard yet";
            string title = noBoardCount == 0
                ? $"{rankedCount} games contribute scores to a global leaderboard."
                : $"{rankedCount} of {totalGames} games contribute scores to a global leaderboard. {noBoardCount} are still preview/session-counted — playable, not ranked.";
            <span class="lb-count" title="@title">@label</span>
        }
    </header>

    @* Filter tabs: instant category switching without endless scrolling.
       Narrow viewports swap these for the per-game picker below — with one
       board on screen at a time, a mode filter has nothing to filter. *@
    @if (!_loading && !_error && _boards.Count > 0 && !_isNarrow)
    {
        <div class="lb-chips" role="tablist" aria-label="Filter leaderboards">
            <button role="tab" class="lb-chip @(_activeFilter == "all" ? "lb-chip--on" : "")"
                    aria-selected="@(_activeFilter == "all")"
                    @onclick='() => _activeFilter = "all"'>
                All Modes <span class="lb-chip-n">@_boards.Count</span>
            </button>
            <button role="tab" class="lb-chip @(_activeFilter == "1p" ? "lb-chip--on" : "")"
                    aria-selected="@(_activeFilter == "1p")"
                    @onclick='() => _activeFilter = "1p"'>
                1-Player Solo
            </button>
            <button role="tab" class="lb-chip @(_activeFilter == "2p" ? "lb-chip--on" : "")"
                    aria-selected="@(_activeFilter == "2p")"
                    @onclick='() => _activeFilter = "2p"'>
                2-Player Local
            </button>
            <button role="tab" class="lb-chip @(_activeFilter == "online" ? "lb-chip--on" : "")"
                    aria-selected="@(_activeFilter == "online")"
                    @onclick='() => _activeFilter = "online"'>
                Multiplayer Online
            </button>
        </div>
    }

    @* Audit fix #8: hero call-to-action that gives first-time visitors an
       immediate next step instead of a wall of "no scores yet" placeholders.
       Hidden when the user already has a #1 ranked score on any board. *@
    @if (!_loading && !_error && _topGameKey is not null)
    {
        <a class="lb-hero" href="@PlayUrl(_topGameKey)">
            <span class="lb-hero-eyebrow">Your top game</span>
            <span class="lb-hero-title">@_topGameTitle</span>
            <span class="lb-hero-rank">#@_topRank · @_topValue</span>
        </a>
    }
    else if (!_loading && !_error && _boards.Count == 0)
    {
        @* 2026-09-04 UI sweep: migrated from inline `.lb-empty` markup to the
           shared <EmptyState> primitive. Visual treatment is identical (the
           primitive is the source of truth) and a future tweak to empty-state
           copy / icon lands in one place. *@
        <EmptyState Icon="🏆"
                    Title="No scores yet">
            Be the first on the board. Play any 1-player mode to claim a spot —
            your best score auto-submits when you finish.
            <Action>
                <button class="app-btn app-btn--primary"
                        type="button"
                        @onclick='() => NavigationManager.NavigateTo("/")'>
                    Pick a game
                </button>
            </Action>
        </EmptyState>
    }

    @if (_loading)
    {
        <div class="lb-skeletons">
            @for (var i = 0; i < 6; i++)
            {
                <div class="lb-skel"></div>
            }
        </div>
    }
    else if (_error)
    {
        @* 2026-09-04 UI sweep: shared <ErrorState> with a Retry callback. The
           retry button uses the universal `.app-btn--primary` so the call to
           action matches every other failure surface in the app. *@
        <ErrorState Icon="📡"
                    Title="Backend offline"
                    OnRetry="Load">
            Leaderboards can't load right now. Your scores are safe — they'll
            sync the next time the API is reachable.
        </ErrorState>
    }
    else
    {
        @* 2026-08-30 audit #2: a phone stacked all 11 boards — 1927px of page at
           375×844, over a screen of pure scrolling. Narrow viewports get a
           per-game picker (one chip row, one board) instead; the mode filter
           above is hidden with it, because a single visible board leaves it
           nothing to filter. *@
        @if (_isNarrow)
        {
            <div class="lb-chips" role="tablist" aria-label="Pick a game">
                @foreach (var b in FlatBoards)
                {
                    <button role="tab" class="lb-chip @(b.GameKey == _selectedGame ? "lb-chip--on" : "")"
                            aria-selected="@(b.GameKey == _selectedGame)"
                            @onclick='() => _selectedGame = b.GameKey'>
                        @b.Title
                    </button>
                }
            </div>
        }

        @* Group leaderboards by category and active tab filter (desktop), or
           render just the picked game's board (narrow) *@
        @foreach (var group in VisibleGroups())
        {
            // 2026-08-10 audit #7: previous `<h2>1 PLAYER</h2>` was a styled
            // heading with no useful screen-reader label. aria-label here
            // turns the heading text into a real landmark name; combined
            // with the <section aria-labelledby> wrapper, screen readers
            // announce the section's purpose before listing boards.
            <section class="lb-group" aria-labelledby="@($"lb-group-{group.Key}")">
                <h2 id="@($"lb-group-{group.Key}")" class="gps-phase-h"
                    aria-label="@($"{GroupAriaLabel(group.Title)} leaderboards")">
                    @group.Title
                </h2>
                <div class="lb-grid">
                    @foreach (var board in group.Boards)
                    {
                        <article class="lb-board" aria-label="@($"{board.Title} leaderboard, scored by {board.Unit}")">
                            <div class="lb-board-head">
                                <h3 class="lb-board-title">@board.Title</h3>
                                <span class="lb-unit">@board.Unit</span>
                            </div>

                            @{ var rows = VisibleRows(board, group.Key, BoardRowLimit()); }
                            @if (rows.Count == 0)
                            {
                                <p class="lb-board-empty">No scores yet — play @board.Title to claim #1.</p>
                            }
                            else
                            {
                                // 2026-08-10 audit #9: the data is tabular (rank +
                                // player + score) but was rendered as <ol> with
                                // spans — screen readers couldn't announce column
                                // relationships. The role="table" wrapper + role
                                // rows + scope=col headers gives the same DOM
                                // grid (the CSS keeps using `display:grid`) but
                                // semantic landmarks that assistive tech can
                                // navigate by column.
                                <div role="table"
                                     aria-label="@($"{board.Title} top {rows.Count}, scored by {board.Unit}")"
                                     class="lb-rows">
                                    <div role="row" class="lb-row lb-row--head">
                                        <span role="columnheader" class="lb-rank" aria-label="Rank">#</span>
                                        @* 2026-08-12 audit #2: the Joker board ranks best
                                           JOKES, not sessions — using "Player" as the
                                           column header was misleading because the visible
                                           text was a joke setup. The header is per-board
                                           so each game has a label that matches its row
                                           content. *@
                                        <span role="columnheader" class="lb-name">@NameLabelFor(board.GameKey)</span>
                                        <span role="columnheader" class="lb-value" aria-label="@board.Unit">@board.Unit</span>
                                    </div>
                                    @* §5: <Virtualize> keeps the DOM flat even when
                                       a board's Top-N grows past the section cap. *@
                                    <Virtualize Items="@rows" Context="e" ItemSize="36">
                                        <div role="row" class="lb-row @(e.Rank <= 3 && e.Name != PlaceholderName ? $"lb-row--top lb-row--{e.Rank}" : null)">
                                            <span role="cell" class="lb-rank" aria-label="@($"Rank {e.Rank}")">@e.Rank</span>
                                            @* title only when the row carries long-form text it
                                               had to clip (PoJoker jokes) — null everywhere else,
                                               and Blazor omits a null attribute entirely. *@
                                            <span role="cell" class="lb-name" title="@e.Detail">@DisplayName(e.Name)</span>
                                            <span role="cell" class="lb-value">@e.DisplayValue</span>
                                        </div>
                                    </Virtualize>
                                </div>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private bool _loading = true;
    private bool _error;
    private List<GameLeaderboardDto> _boards = [];
    private string _activeFilter = "all";

    // Audit fix #8: hero card highlights the user's best score.
    private string? _topGameKey;
    private string _topGameTitle = "";
    private int _topRank;
    private string _topValue = "";

    private record BoardGroup(string Key, string Title, IReadOnlyList<GameLeaderboardDto> Boards);
    private List<BoardGroup> _groupedBoards = new();

    // 2026-08-30 audit #2: narrow viewports render a per-game picker instead of
    // every group at once. _isNarrow starts false so the first (desktop-ish)
    // paint uses the grouped view, then OnAfterRenderAsync corrects it after the
    // live viewport read — same pattern the BoardRowLimit split used (NetRun10
    // audit #6).
    private bool _isNarrow;
    private string? _selectedGame;

    private IEnumerable<GameLeaderboardDto> FlatBoards =>
        _groupedBoards.SelectMany(g => g.Boards);

    /// <summary>Groups to render: the mode-filtered set on wide viewports, or a
    /// single pseudo-group holding only the picked game's board on narrow ones.</summary>
    private IEnumerable<BoardGroup> VisibleGroups()
    {
        if (!_isNarrow)
            return _groupedBoards.Where(g => _activeFilter == "all" || g.Key == _activeFilter);

        if (_selectedGame is null)
            return [];

        var owner = _groupedBoards.FirstOrDefault(g => g.Boards.Any(b => b.GameKey == _selectedGame));
        var board = owner?.Boards.FirstOrDefault(b => b.GameKey == _selectedGame);
        if (owner is null || board is null)
            return [];

        return [new BoardGroup(owner.Key, owner.Title, [board])];
    }

    // The server pads every unified board to the requested limit with dummy
    // "XXX" rows. By request we now KEEP them so every board fills out to its
    // row limit — real scores rank first, then "XXX" placeholders. The server
    // formats a padded row's DisplayValue per board unit ("—", "0%", "0"); the
    // product wants a literal "0" for every placeholder, so we override it here.
    private const string PlaceholderName = "XXX";

    // The Joker leaderboard keys its rows by an 8-hex-char session id when the
    // caller doesn't pass X-Session-Id — readable in storage but ugly on screen.
    // Render those rows as "Guest XXXX" so the board matches the signed-in
    // identity chip and stops looking like a debugger trace.
    private static readonly System.Text.RegularExpressions.Regex ShortHexName =
        new("^[0-9a-fA-F]{6,16}$", System.Text.RegularExpressions.RegexOptions.Compiled);

    // 2026-08-12 audit #2: column header must match what the row actually
    // represents. PoJoker ranks jokes, not sessions, so its row "Name" is
    // the joke setup — the visible header "Player" was misleading. Every
    // other board shows a person / session, so "Player" stays the default.
    private static string NameLabelFor(string gameKey) => gameKey switch
    {
        "pojoker"      => "Joke",
        "pobrawldemo"  => "Fighter",
        _              => "Player",
    };

    private static string DisplayName(string? raw)
    {
        var safe = raw ?? string.Empty;
        return ShortHexName.IsMatch(safe)
            ? $"Guest {safe[..Math.Min(4, safe.Length)].ToUpperInvariant()}"
            : safe;
    }

    private List<LeaderboardEntryDto> VisibleRows(GameLeaderboardDto board, string groupKey, int take)
        // §2026-07-18: filter out the server's XXX padding rows so the
        // leaderboards look like real populated boards rather than a
        // 3/5/10-deep graveyard of placeholder names. The server still pads
        // for callers that want a uniform rank list (e.g. GameOverModal),
        // but this view only shows real players.
        => board.Entries
            .Where(e => e.Name != PlaceholderName)
            .Take(take)
            .ToList();

    // 2026-08-10 audit #7: the visible heading is a stylised "1 PLAYER" /
    // "MULTIPLAYER" string. Screen readers announce exactly that, which
    // gives the section a meaningful landmark name — except it's shouting
    // abbreviations. GroupAriaLabel is the human-readable form ("Single
    // player games") used for aria-label, so the visible label and the
    // spoken label do not have to be the same string.
    private static string GroupAriaLabel(string title) => title switch
    {
        "1 Player" => "Single-player games",
        "2 Player" => "Two-player games on one device",
        "Multiplayer" => "Online multiplayer games",
        _ => title,
    };

    // Every board shows its top 3 so many games' boards fit on screen at once
    // (was top-3 mobile / top-10 desktop). Keeps each section compact.
    private int BoardRowLimit() => 3;

    protected override async Task OnInitializedAsync() => await Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // NetRun10 audit #6: pull the live viewport width so the
            // BoardRowLimit() branches between top-3 (mobile) and top-10 (desktop).
            await Viewport.RefreshAsync();
            // Audit #2 (2026-08-30): branch the layout between the grouped
            // desktop view and the per-game picker, and seed the picker with
            // the first board so it is never empty.
            _isNarrow = Viewport.IsNarrow;
            _selectedGame ??= FlatBoards.FirstOrDefault()?.GameKey;
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;

    private async Task Load()
    {
        _loading = true;
        _error = false;
        StateHasChanged();

        var boards = await ApiService.GetAllLeaderboardsAsync(limit: 10);
        if (boards is null)
        {
            _error = true;
        }
        else
        {
            _boards = boards.ToList();
            BuildGrouped();
            BuildHero();
        }

        _loading = false;
        StateHasChanged();
    }

    private void BuildGrouped()
    {
        // The leaderboard API returns a flat list; map each game key to a
        // category based on GameCatalog membership. Anything not in the
        // catalog lands in the "Other" bucket so the page never silently
        // drops a board.
        var spKeys = GameCatalog.SinglePlayer.Select(g => g.Key).ToHashSet();
        var lpKeys = GameCatalog.LocalTwoPlayer.Select(g => g.Key).ToHashSet();
        var mpKeys = GameCatalog.Multiplayer.Select(g => g.Key).ToHashSet();

        // 2026-08-11: the Brawl Demo board (fighter ELO from CPU-vs-CPU matches) is
        // an associative view of the Brawl game — its rows are characters, not the
        // player's own performance — so it isn't a 1P "achievement" board the way
        // the presidents ladder is. But it IS the Brawl game's sibling board, and
        // dropping it into 1P keeps the Brawl pair together on the page so a
        // visitor walking through the Brawl presidents ladder sees the demo ELO
        // board right next to it. Left in "Other" it would sit at the bottom of a
        // long page below the fold, which the <Virtualize> rows below would then
        // defer rendering until the visitor scrolled — defeating the "dedicated
        // top-3 board" framing the feature was built for.
        var brawlDemoKey = "pobrawldemo";

        // 2026-07-26 browser audit #6: storage keeps a single global board per game (no
        // 1P/2P/multiplayer partition), so a game listed in several catalogs rendered the
        // SAME rows in each column. Rather than a per-column filter (the original fix
        // deduped 2P-vs-1P only, leaving PoRacer and PoSports duplicated between the 1P and
        // Multiplayer columns), each board is assigned exactly one owning section, most
        // specific first. A section with nothing left is suppressed; the empty-state hint
        // below explains why.
        var claimed = new HashSet<GameKey>();
        List<GameLeaderboardDto> Claim(Func<GameLeaderboardDto, bool> belongs) =>
            _boards.Where(b => belongs(b) && claimed.Add(b.GameKey)).ToList();

        _groupedBoards = new List<BoardGroup>
        {
            new BoardGroup("1p",      "1 Player",       Claim(b => spKeys.Contains(b.GameKey) || string.Equals(b.GameKey, brawlDemoKey, StringComparison.OrdinalIgnoreCase))),
            new BoardGroup("2p",      "2 Player",       Claim(b => lpKeys.Contains(b.GameKey))),
            new BoardGroup("multi",   "Multiplayer",    Claim(b => mpKeys.Contains(b.GameKey))),
            new BoardGroup("other",   "Other",          Claim(_ => true)),
        }.Where(g => g.Boards.Count > 0).ToList();

        // Audit #2 (2026-08-30): seed the narrow-mode picker here, not in
        // OnAfterRenderAsync — the boards frequently land AFTER the first
        // viewport read, and a picker seeded against an empty group list stays
        // null forever, leaving narrow viewports with chips but no board.
        _selectedGame ??= _groupedBoards.SelectMany(g => g.Boards).FirstOrDefault()?.GameKey;
    }

    private void BuildHero()
    {
        // 2026-07-19 browser audit #5: previously the hero card picked the
        // GLOBAL rank-1 row across every board, so any previous E2E session
        // that left a high Joker score was attributed to whichever guest
        // happened to be signed in now. Filter to entries whose Name matches
        // the current PlayerName (case-insensitive, contains — the score
        // submit may use the display name, an email slug, or the bare id).
        var me = PlayerNameService.GetPlayerName();
        var meLower = me?.Trim().ToLowerInvariant() ?? string.Empty;

        var personalEntries = _boards
            .SelectMany(b => b.Entries.Select(e => (Board: b, Entry: e)))
            .Where(t => t.Entry.Name != PlaceholderName) // never hero the XXX padding
            .Where(t => NameMatches(t.Entry.Name, meLower))
            .OrderBy(t => t.Entry.Rank)
            .FirstOrDefault();

        if (personalEntries.Board is null)
        {
            _topGameKey = null;
            return;
        }
        _topGameKey = personalEntries.Board.GameKey;
        _topGameTitle = personalEntries.Board.Title;
        _topRank = personalEntries.Entry.Rank;
        _topValue = personalEntries.Entry.DisplayValue;
    }

    // Display-name comparison. Names on the leaderboard can be one of:
    //   • the player's DisplayName   ("Guest342812")
    //   • their email slug           ("guest342812@local.dev" → already shown verbatim)
    //   • their id slug              ("dev-guest342812")
    // The server writes whatever the submitter passed, so we accept any case-
    // insensitive substring overlap with the local PlayerName rather than
    // demanding an exact match.
    private static bool NameMatches(string leaderName, string localLower)
    {
        if (string.IsNullOrEmpty(localLower)) return false;
        var ln = leaderName?.Trim().ToLowerInvariant() ?? string.Empty;
        if (ln.Length == 0) return false;
        return ln == localLower
            || ln.StartsWith(localLower + "@", StringComparison.Ordinal)
            || ln.StartsWith(localLower + "-", StringComparison.Ordinal)
            || localLower.StartsWith(ln + "@", StringComparison.Ordinal)
            || localLower.StartsWith(ln + "-", StringComparison.Ordinal);
    }

    private string PlayUrl(string gameKey)
    {
        var match = GameCatalog.SinglePlayer.FirstOrDefault(g => string.Equals(g.Key, gameKey, StringComparison.OrdinalIgnoreCase))
            ?? GameCatalog.LocalTwoPlayer.FirstOrDefault(g => string.Equals(g.Key, gameKey, StringComparison.OrdinalIgnoreCase))
            ?? GameCatalog.Multiplayer.FirstOrDefault(g => string.Equals(g.Key, gameKey, StringComparison.OrdinalIgnoreCase));
        return match is not null ? match.Url : $"/{gameKey}";
    }
}
