@page "/poclick/highscores"
@page "/poclick/highscores/{SessionId}"
@using PoMiniGamesClient.Models
@inject PoClickHistoryService HistoryService
@inject PlayerNameService PlayerNameService
@inject NavigationManager Navigation

<div class="poclick-stats-container">
    <!-- Header -->
    <div class="cyber-card poclick-stats-header">
        <div class="poclick-stats-breadcrumb">
            <button class="cyber-btn cyber-btn-secondary poclick-breadcrumb-btn" @onclick="GoHome">← Back to Trainer</button>
            <span class="poclick-breadcrumb-sep">High Scores</span>
        </div>
        <div class="poclick-stats-header-row">
            <div>
                <h2 class="poclick-stats-title">🏆 Top Scores</h2>
                <p class="poclick-stats-subtitle">@_playerName · 100 BPM</p>
            </div>
            <a href="/poclick" class="cyber-btn cyber-btn-secondary poclick-retry-btn">↺ Play Again</a>
        </div>
    </div>

    <!-- Two duration boards side-by-side -->
    <div class="poclick-hs-grid">
        @foreach (var board in _boards)
        {
            <div class="cyber-card poclick-hs-board">
                <h3 class="poclick-section-heading poclick-section-heading--gold">@board.Label Top 10</h3>

                @if (board.Sessions.Count == 0)
                {
                    <div class="poclick-empty-state">
                        <p>No @board.Label scores yet.<br/>Be the first to top the charts!</p>
                    </div>
                }
                else
                {
                    <div class="poclick-table-wrap">
                        <table class="poclick-table">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Score</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (entry, idx) in board.Sessions.Select((s, i) => (s, i)))
                                {
                                    var rank = idx + 1;
                                    var isCurrent = !string.IsNullOrEmpty(SessionId) && entry.Id == SessionId;
                                    <tr class="poclick-table-row @(isCurrent ? "poclick-hs-current" : "")"
                                        @onclick="() => ViewSession(entry.Id)">
                                        <td>
                                            @if (rank == 1)
                                            {
                                                <span class="poclick-rank-medal poclick-rank-gold">🥇</span>
                                            }
                                            else if (rank == 2)
                                            {
                                                <span class="poclick-rank-medal poclick-rank-silver">🥈</span>
                                            }
                                            else if (rank == 3)
                                            {
                                                <span class="poclick-rank-medal poclick-rank-bronze">🥉</span>
                                            }
                                            else
                                            {
                                                <span class="poclick-rank-other">#@rank</span>
                                            }
                                        </td>
                                        <td>@($"{entry.Score:0.#}")@(isCurrent ? " ★" : "")</td>
                                        <td>@entry.CreatedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Footer -->
    <div class="poclick-stats-footer">
        @if (!string.IsNullOrEmpty(SessionId))
        {
            <button class="cyber-btn cyber-btn-secondary" @onclick="() => ViewSession(SessionId!)">📊 View This Run's Detailed Stats</button>
        }
        <button class="cyber-btn poclick-play-again-btn" @onclick="GoHome">Play Again</button>
    </div>
</div>

@code {
    [Parameter] public string? SessionId { get; set; }

    private string _playerName = "";
    private List<Board> _boards = new();

    private sealed record Board(string Label, List<PoClickSession> Sessions);

    protected override void OnInitialized()
    {
        _playerName = PlayerNameService.GetPlayerName();
        // Local single-player device: show every local score for each duration.
        // (Filtering by player name is fragile — the auth-provided name can resolve
        // after a game has already saved its session under an earlier value.)
        _boards = new List<Board>
        {
            new("10-Second", HistoryService.GetLeaderboardByDuration(10, limit: 10)),
            new("20-Second", HistoryService.GetLeaderboardByDuration(20, limit: 10)),
        };
    }

    private void ViewSession(string id) => Navigation.NavigateTo($"/poclick/stats/{id}");

    private void GoHome() => Navigation.NavigateTo("/poclick");
}
