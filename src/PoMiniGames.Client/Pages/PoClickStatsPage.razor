@page "/poclick/stats/{SessionId}"
@inject PoClickHistoryService HistoryService
@inject NavigationManager Navigation

<div class="poclick-stats-container">
    @if (_loading)
    {
        <div class="poclick-loading">
            <div class="poclick-spinner"></div>
            <p class="poclick-loading-text">Loading session...</p>
        </div>
    }
    else if (_session == null)
    {
        <div class="cyber-card poclick-stats-not-found">
            <h3>Session Not Found</h3>
            <p>The requested timing session could not be loaded.</p>
            <button class="cyber-btn" @onclick="GoHome">Back to Trainer</button>
        </div>
    }
    else
    {
        <!-- Session Header -->
        <div class="cyber-card poclick-stats-header">
            <div class="poclick-stats-breadcrumb">
                <button class="cyber-btn cyber-btn-secondary poclick-breadcrumb-btn" @onclick="GoHome">← Back to Trainer</button>
                <span class="poclick-breadcrumb-sep">Session Results</span>
            </div>
            <div class="poclick-stats-header-row">
                <div>
                    <h2 class="poclick-stats-title">Trainer Profile</h2>
                    <p class="poclick-stats-subtitle">
                        Completed: @_session.CreatedAt.ToLocalTime().ToString("f") | @_session.Bpm BPM
                    </p>
                </div>
                <div class="poclick-score-ring-wrap">
                    <!-- Score Ring Gauge -->
                    <div class="score-ring-container">
                        <svg class="score-ring-svg" viewBox="0 0 140 140">
                            <circle class="score-ring-bg" cx="70" cy="70" r="54" />
                            <circle class="score-ring-fill" cx="70" cy="70" r="54"
                                    stroke="@_ringColor"
                                    stroke-dasharray="339.3"
                                    style="--ring-end: @_ringOffsetStr;" />
                        </svg>
                        <div class="score-ring-text">
                            <div class="poclick-score-value" style="color: @_ringColor;">@($"{_session.Score:0.#}")</div>
                            <div class="poclick-score-unit">/ 100</div>
                        </div>
                    </div>
                    <a href="/poclick?bpm=@_session.Bpm" class="cyber-btn cyber-btn-secondary poclick-retry-btn">
                        ↺ Retry @_session.Bpm BPM
                    </a>
                </div>
            </div>
        </div>

        <!-- Stats Cards Grid -->
        <div class="poclick-stats-grid">
            <div class="poclick-stat-card poclick-stat-card--perfect">
                <div class="poclick-stat-label">Perfect Taps (±25ms)</div>
                <div class="poclick-stat-value poclick-stat-value--green">@_session.PerfectCount</div>
                <div class="poclick-stat-pct">@GetPercentage(_session.PerfectCount)% of beats</div>
                <div class="poclick-bar-track"><div class="poclick-bar-fill" style="width: @GetPercentage(_session.PerfectCount)%; background: var(--accent-green);"></div></div>
            </div>
            <div class="poclick-stat-card poclick-stat-card--good">
                <div class="poclick-stat-label">Good Taps (±60ms)</div>
                <div class="poclick-stat-value poclick-stat-value--yellow">@_session.GoodCount</div>
                <div class="poclick-stat-pct">@GetPercentage(_session.GoodCount)% of beats</div>
                <div class="poclick-bar-track"><div class="poclick-bar-fill" style="width: @GetPercentage(_session.GoodCount)%; background: var(--accent-yellow);"></div></div>
            </div>
            <div class="poclick-stat-card poclick-stat-card--okay">
                <div class="poclick-stat-label">Okay Taps (±120ms)</div>
                <div class="poclick-stat-value poclick-stat-value--orange">@_session.OkayCount</div>
                <div class="poclick-stat-pct">@GetPercentage(_session.OkayCount)% of beats</div>
                <div class="poclick-bar-track"><div class="poclick-bar-fill" style="width: @GetPercentage(_session.OkayCount)%; background: var(--accent-orange);"></div></div>
            </div>
            <div class="poclick-stat-card poclick-stat-card--miss">
                <div class="poclick-stat-label">Misses (>120ms)</div>
                <div class="poclick-stat-value poclick-stat-value--red">@_session.MissCount</div>
                <div class="poclick-stat-pct">@GetPercentage(_session.MissCount)% of beats</div>
                <div class="poclick-bar-track"><div class="poclick-bar-fill" style="width: @GetPercentage(_session.MissCount)%; background: var(--accent-red);"></div></div>
            </div>
        </div>

        <!-- Timing Quality Cards -->
        <div class="poclick-quality-row">
            <div class="cyber-card poclick-quality-card">
                <div class="poclick-stat-label">Average Timing Error</div>
                <div class="poclick-stat-value poclick-stat-value--cyan">
                    @($"{_session.GetAverageOffsetMs():0.0}") <span class="poclick-stat-unit">ms</span>
                </div>
                <p class="poclick-quality-desc">Average difference between your taps and the exact beat time. Lower is better.</p>
            </div>
            <div class="cyber-card poclick-quality-card">
                <div class="poclick-stat-label">Rhythm Stability (Std Dev)</div>
                <div class="poclick-stat-value poclick-stat-value--cyan">
                    @($"{_session.GetStandardDeviationMs():0.0}") <span class="poclick-stat-unit">ms</span>
                </div>
                <p class="poclick-quality-desc">Standard deviation of timing offsets. Measures tempo consistency. Under 30ms is professional.</p>
            </div>
            <div class="cyber-card poclick-quality-card">
                <div class="poclick-stat-label">Max Beat Streak</div>
                <div class="poclick-stat-value poclick-stat-value--cyan">
                    @_session.MaxStreak <span class="poclick-stat-unit">beats</span>
                </div>
                <p class="poclick-quality-desc">Longest continuous sequence of Perfect or Good taps without dropping the rhythm.</p>
            </div>
        </div>

        <!-- Pocket Rating & Rush/Drag -->
        <div class="cyber-card poclick-advanced-stats">
            <div class="poclick-advanced-row">
                <div class="poclick-pocket-wrap">
                    <div class="poclick-pocket-label">Pocket Rating</div>
                    <div class="poclick-pocket-badge @GetPocketCssClass()">@_session.GetPocketRating()</div>
                </div>
                <div class="poclick-rushdrag-wrap">
                    <div class="poclick-pocket-label">Rush / Drag</div>
                    <div class="poclick-rushdrag-bar">
                        <div class="poclick-rushdrag-early" style="--pct:@(_rushPct)%"></div>
                        <div class="poclick-rushdrag-late" style="--pct:@(_dragPct)%"></div>
                    </div>
                    <div class="poclick-rushdrag-labels">
                        <span class="poclick-rushdrag-early-label">Early @(_rushPct)%</span>
                        <span class="poclick-rushdrag-late-label">Late @(_dragPct)%</span>
                    </div>
                </div>
            </div>

            <div class="poclick-advanced-grid">
                <div class="poclick-adv-item">
                    <span class="poclick-adv-label">Consistency Score</span>
                    <span class="poclick-adv-value">@(_session.GetConsistencyScore().ToString("0.#"))</span>
                </div>
                <div class="poclick-adv-item">
                    <span class="poclick-adv-label">Zone %</span>
                    <span class="poclick-adv-value">@(_session.GetZonePercent().ToString("0.#"))%</span>
                </div>
                <div class="poclick-adv-item">
                    <span class="poclick-adv-label">Peak Deviation</span>
                    <span class="poclick-adv-value">@(_session.GetPeakDeviationMs().ToString("0.0")) ms</span>
                </div>
                <div class="poclick-adv-item">
                    <span class="poclick-adv-label">Ghost Taps</span>
                    <span class="poclick-adv-value">@_session.GetGhostTapCount()</span>
                </div>
                <div class="poclick-adv-item">
                    <span class="poclick-adv-label">Drift Trend</span>
                    <span class="poclick-adv-value">@(_session.GetDriftTrendSlope().ToString("0.00"))</span>
                </div>
                <div class="poclick-adv-item">
                    <span class="poclick-adv-label">Tempo Stability</span>
                    <span class="poclick-adv-value">@(_session.GetTempoStabilityCoefficient().ToString("0.00"))</span>
                </div>
                <div class="poclick-adv-item">
                    <span class="poclick-adv-label">Fatigue Delta</span>
                    <span class="poclick-adv-value">@(_session.GetFatigueDelta().ToString("0.0")) ms</span>
                </div>
            </div>
        </div>

        <!-- Beat-By-Beat Log -->
        <details class="poclick-log-details">
            <summary class="cyber-card poclick-log-summary">
                <span>Beat-By-Beat Log</span>
                <span class="poclick-log-hint">(click to expand)</span>
            </summary>
            <div class="cyber-card poclick-log-content">
                <div class="poclick-table-wrap">
                    <table class="poclick-table">
                        <thead>
                            <tr>
                                <th>Beat #</th>
                                <th>Target (s)</th>
                                <th>Your Tap (s)</th>
                                <th>Offset</th>
                                <th>Accuracy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attempt in _session.Attempts.Where(a => a.BeatIndex >= 0))
                            {
                                var offsetClass = attempt.Rating == "Miss" ? "poclick-offset-miss" : attempt.OffsetMs > 0 ? "poclick-offset-late" : "poclick-offset-early";
                                var offsetSign = attempt.OffsetMs > 0 ? "+" : "";
                                <tr class="poclick-table-row">
                                    <td>@attempt.BeatIndex</td>
                                    <td>@((attempt.TargetTimeMs / 1000.0).ToString("0.000"))s</td>
                                    <td>@((attempt.ActualTimeMs / 1000.0).ToString("0.000"))s</td>
                                    <td class="@offsetClass">
                                        @if (attempt.Rating == "Miss")
                                        {
                                            <span>Missed beat</span>
                                        }
                                        else
                                        {
                                            <span>@(offsetSign)@(attempt.OffsetMs.ToString("0.0")) ms</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="poclick-badge poclick-badge--@(attempt.Rating.ToLower())">@attempt.Rating</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>

        <!-- Footer buttons -->
        <div class="poclick-stats-footer">
            <button class="cyber-btn poclick-play-again-btn" @onclick="GoHome">Play Again</button>
        </div>
    }
</div>

@code {
    [Parameter] public string SessionId { get; set; } = string.Empty;

    private bool _loading = true;
    private PoClickSession? _session;

    private string _ringColor = "var(--accent-cyan)";
    private string _ringOffsetStr = "339.3";
    private double _rushPct;
    private double _dragPct;

    protected override void OnInitialized()
    {
        LoadSession();
    }

    private void LoadSession()
    {
        _loading = true;
        _session = HistoryService.GetSession(SessionId);

        if (_session != null)
        {
            double circ = 339.3;
            double ringOffset = circ * (1.0 - _session.Score / 100.0);
            _ringOffsetStr = ringOffset.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
            _ringColor = _session.Score >= 80 ? "var(--accent-cyan)"
                       : _session.Score >= 60 ? "var(--accent-green)"
                       : _session.Score >= 40 ? "var(--accent-yellow)"
                       : "var(--accent-red)";

            _rushPct = _session.GetRushPercent();
            _dragPct = _session.GetDragPercent();
        }

        _loading = false;
    }

    private double GetPercentage(int count)
    {
        if (_session == null || !_session.Attempts.Any()) return 0;
        return Math.Round((double)count / _session.Attempts.Count * 100.0, 1);
    }

    private string GetPocketCssClass()
    {
        return _session?.GetPocketRating() switch
        {
            "Elite" => "poclick-pocket--elite",
            "Pro" => "poclick-pocket--pro",
            "Solid" => "poclick-pocket--solid",
            "Drifting" => "poclick-pocket--drifting",
            _ => "poclick-pocket--unsteady"
        };
    }

    private void GoHome()
    {
        var bpm = _session?.Bpm ?? 100;
        Navigation.NavigateTo($"/poclick?bpm={bpm}");
    }
}