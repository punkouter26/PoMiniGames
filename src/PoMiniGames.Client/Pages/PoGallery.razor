@* PoGallery — dev-only demo surface for procedural Three.js models generated by
   the img2threejs skill. Renders one iframe per model pointing at the standalone
   viewer, with a reference-image thumbnail and a short description. The viewer
   pulls Three.js from a CDN via importmap so it does not contribute to the
   WASM bundle budget (CLAUDE.md: 25 MB _framework cap).

   Gating: the manifest endpoint /api/diag/gallery returns 404 outside Development
   unless FeatureFlags:EnableGallery=true is set. The page surfaces that as a
   visible "disabled in this environment" message rather than failing silently. *@

@page "/pogallery"
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@inject HttpClient Http
@inject IWebAssemblyHostEnvironment Env
@implements IDisposable

<PageTitle>PoGallery · PoMiniGames</PageTitle>

<div class="pg-page">
    <header class="pg-head">
        <h1 class="pg-title">PoGallery</h1>
        <p class="pg-sub">
            Procedural Three.js models reconstructed from reference images by the
            <a href="https://github.com/img2threejs/img2threejs" target="_blank" rel="noopener">img2threejs</a>
            pipeline. Demo surface — visible only in <code>Development</code> by default.
        </p>
        <p class="pg-env">
            Environment: <strong>@Env.Environment</strong>
            @if (_manifest is not null)
            {
                <span> · manifest generated at <time>@_manifest.GeneratedAt</time></span>
            }
        </p>
    </header>

    @* Upload panel: accept an image, POST it to /api/gallery/upload, and refresh the
       manifest. The server stores the file and returns a viewer URL with ?image=, which
       the viewer turns into a heightfield relief. *@
    <section class="pg-upload" aria-label="Upload an image to generate a 3D object">
        <div class="pg-upload-head">
            <h2 class="pg-upload-title">Generate a 3D object from an image</h2>
            <p class="pg-upload-sub">
                Upload a PNG/JPEG/WebP. The server stores it and the in-browser viewer builds a
                heightfield relief (luminance → height, color → tint). No ML — deterministic and instant.
            </p>
        </div>

        <div class="pg-upload-row">
            <InputFile class="pg-file"
                       accept="image/png,image/jpeg,image/webp"
                       OnChange="OnFileSelected"
                       aria-label="Choose an image file" />
            <button type="button"
                    class="pg-upload-btn"
                    disabled="@(_file is null || _uploading)"
                    @onclick="SubmitUpload">
                @if (_uploading)
                {
                    <span>Processing…</span>
                }
                else
                {
                    <span>Process to 3D</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_uploadError))
        {
            <p class="pg-error" role="alert">@_uploadError</p>
        }
    </section>

    @if (_loading)
    {
        <p class="pg-muted">Loading gallery…</p>
    }
    else if (_error is not null)
    {
        @* 404 from /api/diag/gallery means the feature is disabled. Surface that as
           a clear signal rather than as a generic error. *@
        @if (_error.Contains("404", StringComparison.Ordinal) ||
             _error.Contains("NotFound", StringComparison.Ordinal))
        {
            <div class="pg-disabled" role="status">
                <h2>Gallery disabled in this environment</h2>
                <p>
                    <code>/api/diag/gallery</code> returned 404. The endpoint is gated by
                    <code>FeatureFlags:EnableGallery</code>, which defaults to
                    <code>IHostEnvironment.IsDevelopment()</code>. To enable it explicitly,
                    set <code>FeatureFlags__EnableGallery=true</code> in environment config.
                </p>
            </div>
        }
        else
        {
            <p class="pg-error" role="alert">Could not load gallery: @_error</p>
        }
    }
    else if (_manifest is not null && _manifest.Models.Count == 0)
    {
        <p class="pg-muted">No models registered. Edit
            <code>Features/PoGallery/PoGalleryEndpoints.cs</code> to add one.</p>
    }
    else if (_manifest is not null)
    {
        @* Preset strip — curated reference images. Click POSTs the image through
           the same /api/gallery/upload path as the drag-and-drop upload, so the
           heightfield renders identically to a real user upload. *@
        @if (_manifest.Models.Any(m => m.Kind == "preset"))
        {
            <section class="pg-presets" aria-label="Preset reference images">
                <div class="pg-presets-head">
                    <h2>Test with a preset</h2>
                    <p>
                        Click any thumbnail to run it through the 2D→3D pipeline.
                        Same path as a real upload, no file picker needed.
                    </p>
                </div>
                <ul class="pg-preset-row" role="list">
                    @foreach (var preset in _manifest.Models.Where(m => m.Kind == "preset"))
                    {
                        <li>
                            <button type="button"
                                    class="pg-preset"
                                    disabled="@_uploading"
                                    @onclick="() => SubmitPresetAsync(preset)"
                                    title="Run @preset.Title through the 2D→3D pipeline">
                                <img class="pg-preset-thumb"
                                     src="@preset.ReferenceImage"
                                     alt="@preset.Title preview"
                                     loading="lazy" />
                                <span class="pg-preset-label">
                                    <span class="pg-preset-title">@preset.Title</span>
                                    <span class="pg-preset-sub">@preset.Id</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
            </section>
        }

        <ul class="pg-grid" role="list">
            @foreach (var model in _manifest.Models)
            {
                <li class="pg-card">
                    <div class="pg-preview">
                        <iframe class="pg-frame"
                                src="@model.ViewerUrl"
                                title="@model.Title preview"
                                loading="lazy"
                                referrerpolicy="no-referrer"
                                sandbox="allow-scripts allow-same-origin"></iframe>
                    </div>
                    <div class="pg-card-body">
                        <h3 class="pg-card-title">@model.Title</h3>
                        <p class="pg-card-desc">@model.Description</p>
                        <div class="pg-card-meta">
                            <a class="pg-card-ref" href="@model.ReferenceImage" target="_blank" rel="noopener">
                                Reference image
                            </a>
                            <a class="pg-card-src" href="@model.ModelUrl" target="_blank" rel="noopener">
                                Model source
                            </a>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</div>

@code {
    private GalleryManifest? _manifest;
    private string? _error;
    private bool _loading = true;
    private CancellationTokenSource? _cts;

    private IBrowserFile? _file;
    private bool _uploading;
    private string? _uploadError;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        try
        {
            // Trim-safe overload — the JsonTypeInfo comes from the source-generated
            // ApiJsonContext so this call survives PublishTrimmed + EnableTrimAnalyzer.
            // See ApiJsonContext.cs for the [JsonSerializable] registration.
            _manifest = await Http.GetFromJsonAsync(
                "api/diag/gallery", ApiJsonContext.Default.GalleryManifest, _cts.Token);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            // Surface as the "disabled" message below, not as a generic error.
            _error = "404 NotFound";
        }
        catch (OperationCanceledException) { /* component disposed */ }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        _file = e.File;   // InputFile exposes the selected IBrowserFile directly.
    }

    private async Task SubmitUpload()
    {
        if (_file is null || _uploading) return;

        var file = _file!;
        var ct = _cts?.Token ?? CancellationToken.None;
        _uploading = true;
        _uploadError = null;

        try
        {
            // Load the file into a stream-backed content and POST as multipart/form-data.
            // The client's AntiforgeryHandler attaches the X-CSRF-TOKEN header to every
            // /api/* POST automatically (see Services/AntiforgeryHandler.cs).
            await using var src = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var bytes = new byte[file.Size];
            var read = 0;
            while (read < bytes.Length)
            {
                var n = await src.ReadAsync(bytes.AsMemory(read, bytes.Length - read), ct);
                if (n == 0) break;
                read += n;
            }
            var contentType = string.IsNullOrEmpty(file.ContentType)
                ? GuessContentType(file.Name)
                : file.ContentType;
            await PostUploadAsync(bytes, contentType, file.Name, ct);
        }
        catch (Exception ex)
        {
            _uploadError = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    /// <summary>Submit a preset reference image through the upload pipeline.
    /// Fetches the bytes from the same origin via <see cref="HttpClient.GetAsync(string)"/>
    /// then re-POSTs them to <c>/api/gallery/upload</c>. The result appears as a new
    /// card in the gallery grid via the manifest refresh.</summary>
    private async Task SubmitPresetAsync(GalleryModel preset)
    {
        if (_uploading || _manifest is null) return;
        var ct = _cts?.Token ?? CancellationToken.None;
        _uploading = true;
        _uploadError = null;
        try
        {
            // Fetch the preset from the API origin. HttpClient is configured with the
            // IncludeCredentialsHandler in the client pipeline so auth cookies carry.
            var url = preset.ReferenceImage; // already an absolute path like "/games/pogallery/refs/foo.png"
            var bytes = await Http.GetByteArrayAsync(url, ct);
            var contentType = GuessContentType(url);
            var fileName = System.IO.Path.GetFileName(url);
            await PostUploadAsync(bytes, contentType, fileName, ct);
        }
        catch (Exception ex)
        {
            _uploadError = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    /// <summary>Single POST site for both file-picker and preset submissions.
    /// Builds the multipart payload, sends it, parses the response, and refreshes
    /// <see cref="_manifest"/> on success. Surfaces the server's <c>{ error }</c>
    /// body on failure so the page can show why a preset was rejected.</summary>
    private async Task PostUploadAsync(byte[] bytes, string contentType, string fileName, CancellationToken ct)
    {
        using var content = new MultipartFormDataContent();
        var fileContent = new ByteArrayContent(bytes);
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(contentType);
        content.Add(fileContent, "image", fileName);

        var response = await Http.PostAsync("api/gallery/upload", content, ct);
        var body = await response.Content.ReadAsStringAsync(ct);

        if (!response.IsSuccessStatusCode)
        {
            string? msg = null;
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(body);
                if (doc.RootElement.TryGetProperty("error", out var err)) msg = err.GetString();
            }
            catch { /* non-JSON body */ }
            throw new HttpRequestException(
                $"Upload failed ({(int)response.StatusCode}): {msg ?? response.ReasonPhrase}",
                null, response.StatusCode);
        }

        _manifest = System.Text.Json.JsonSerializer.Deserialize(
            body, ApiJsonContext.Default.GalleryManifest);
    }

    /// <summary>Best-effort MIME-type sniff from a filename. Used when the
    /// source doesn't provide a content type (e.g. when reading from a preset URL).
    /// Falls back to <c>application/octet-stream</c> on unknown extensions.</summary>
    private static string GuessContentType(string name)
    {
        var ext = System.IO.Path.GetExtension(name).ToLowerInvariant();
        return ext switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".webp" => "image/webp",
            _ => "application/octet-stream",
        };
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
