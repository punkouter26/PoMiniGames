@page "/profile"
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@inject PlayerNameService PlayerNameService
@inject GameStatsService GameStatsService
@inject ApiService ApiService
@inject MatchHistoryService MatchHistory
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="prf-page">
@if (_loading)
{
    <div class="profile-skel" aria-busy="true" aria-label="Loading profile">
        <div class="profile-skel__header">
            <div class="profile-skel__avatar"></div>
            <div class="profile-skel__lines">
                <div class="profile-skel__line profile-skel__line--w70"></div>
                <div class="profile-skel__line profile-skel__line--w40"></div>
                <div class="profile-skel__line profile-skel__line--w55"></div>
            </div>
        </div>
        <div class="profile-skel__row"></div>
        <div class="profile-skel__row"></div>
        <div class="profile-skel__row"></div>
    </div>
}
else
{

    <!-- ── Hero ── -->
    <div class="prf-hero">
        <div class="prf-avatar" aria-hidden="true">
            <span class="prf-avatar-text">@_initials</span>
        </div>
        <div class="prf-hero-body">
            <h1 class="prf-name">@_playerName</h1>
            <div class="prf-chips">
                <div class="prf-chip">
                    <span class="prf-chip-val">@_totalGames</span>
                    <span class="prf-chip-lbl">Games</span>
                </div>
                <div class="prf-chip">
                    <span class="prf-chip-val">@(_totalGames > 0 ? $"{_totalWins * 100 / _totalGames}%" : "—")</span>
                    <span class="prf-chip-lbl">Win Rate</span>
                </div>
                <div class="prf-chip">
                    <span class="prf-chip-val">@(_bestStreak > 0 ? _bestStreak.ToString() : "—")</span>
                    <span class="prf-chip-lbl">Best Streak</span>
                    @* NetRun10 audit #9: replace the em-dash with an inline
                       one-liner hint so users with no PoClick history know
                       exactly what unlocks the stat. *@
                    @if (_bestStreak == 0)
                    {
                        <span class="prf-chip-hint">Play PoClick to set your first streak</span>
                    }
                </div>
                <div class="prf-chip">
                    <span class="prf-chip-val">@(_topElo > 1000 ? _topElo.ToString() : "—")</span>
                    <span class="prf-chip-lbl">Top ELO</span>
                    @if (_topElo <= 1000)
                    {
                        <span class="prf-chip-hint">Win a 1P match to climb past 1000</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── 1-Player high scores (best available per game) ── -->
    <div class="prf-section">
        <h2 class="prf-section-title">High Scores · 1 Player</h2>
        <div class="prf-hs-grid">
            @foreach (var h in _highScores)
            {
                <div class="prf-hs-card @(h.HasValue ? "" : "prf-hs-card--empty")">
                    <span class="prf-hs-icon">@h.Icon</span>
                    <div class="prf-hs-body">
                        <div class="prf-hs-game">@h.Game</div>
                        <div class="prf-hs-value">@h.Value</div>
                        <div class="prf-hs-sub">@h.Sub</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ── Head-to-head record vs named opponents ── -->
    <div class="prf-section">
        <h2 class="prf-section-title">Head-to-Head · People You Played</h2>
        @if (_matchesLoading)
        {
            <p class="prf-h2h-note">Loading match history…</p>
        }
        else if (_localOpponents.Count == 0 && _onlineOpponents.Count == 0)
        {
            <p class="prf-h2h-note">No head-to-head matches recorded yet. Play an online multiplayer or local 2-player match and your record against each opponent shows up here.</p>
        }
        else
        {
            <div class="prf-h2h-cols">
                <div class="prf-h2h-col">
                    <h3 class="prf-h2h-mode">👥 2-Player (local)</h3>
                    @if (_localOpponents.Count == 0)
                    {
                        <p class="prf-h2h-note">No local 2-player matches yet.</p>
                    }
                    else
                    {
                        @RenderOpponentTable(_localOpponents)
                    }
                </div>
                <div class="prf-h2h-col">
                    <h3 class="prf-h2h-mode">🌐 Online Multiplayer</h3>
                    @if (_onlineOpponents.Count == 0)
                    {
                        <p class="prf-h2h-note">No online multiplayer matches yet.</p>
                    }
                    else
                    {
                        @RenderOpponentTable(_onlineOpponents)
                    }
                </div>
            </div>
        }
    </div>

    <!-- ── Charts row ── -->
    @* §8: empty-state for first-time players — no charts means no signal.
       A single CTA card replaces the entire charts row. *@
    @if (_totalGames == 0)
    {
        <div class="prf-chart-card prf-chart-card--empty">
            <h3 class="prf-chart-title">No games played yet</h3>
            <p class="prf-chart-empty-text">Win rates, charts, and head-to-head records unlock after your first match.</p>
            <a href="/" class="sp-btn-primary">Pick a game →</a>
        </div>
    }
    else
    {
        <div class="prf-charts">
            <div class="prf-chart-card">
                <h3 class="prf-chart-title">Win Rate by Game</h3>
                @((MarkupString)BuildRadarSvg())
            </div>
            <div class="prf-chart-card">
                <h3 class="prf-chart-title">Overall Record</h3>
                @((MarkupString)BuildDonutSvg())
                <div class="prf-donut-legend">
                    <span class="prf-legend-dot prf-legend-win"></span><span>Wins&nbsp;@_totalWins</span>
                    <span class="prf-legend-dot prf-legend-draw"></span><span>Draws&nbsp;@_totalDraws</span>
                    <span class="prf-legend-dot prf-legend-loss"></span><span>Losses&nbsp;@_totalLosses</span>
                </div>
            </div>
        </div>
    }

    <!-- ── Callouts ── -->
    @if (_bestEntry != null || _nemesisEntry != null)
    {
        <div class="prf-callouts">
            @if (_bestEntry != null)
            {
                <div class="prf-callout prf-callout--best">
                    <span class="prf-callout-icon">🏆</span>
                    <div>
                        <div class="prf-callout-lbl">Best Game</div>
                        <div class="prf-callout-val">@_bestEntry.Label</div>
                        <div class="prf-callout-sub">@(_bestEntry.WinRate.ToString("P0")) win rate · @_bestEntry.TotalGames played</div>
                    </div>
                </div>
            }
            @if (_nemesisEntry != null)
            {
                <div class="prf-callout prf-callout--nemesis">
                    <span class="prf-callout-icon">💀</span>
                    <div>
                        <div class="prf-callout-lbl">Nemesis Game</div>
                        <div class="prf-callout-val">@_nemesisEntry.Label</div>
                        <div class="prf-callout-sub">@(_nemesisEntry.WinRate.ToString("P0")) win rate · @_nemesisEntry.TotalGames played</div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ── Game Breakdown ── -->
    <div class="prf-section">
        <h2 class="prf-section-title">Game Breakdown</h2>
        <div class="prf-game-grid">
            @foreach (var g in _entries)
            {
                <div class="prf-game-card @(g.TotalGames == 0 ? "prf-game-card--unplayed" : "")">
                    <div class="prf-game-header">
                        <span class="prf-game-icon">@g.Icon</span>
                        <span class="prf-game-name">@g.Label</span>
                        @if (g.TotalGames > 0)
                        {
                            <span class="prf-game-wr">@g.WinRate.ToString("P0")</span>
                        }
                    </div>
                    @if (g.TotalGames > 0)
                    {
                        <div class="prf-bar" title="Win / Draw / Loss" style="--win-pct:@((int)g.WinPercent)%;--draw-pct:@((int)g.DrawPercent)%;--loss-pct:@((int)g.LossPercent)%">
                            <div class="prf-bar-win"></div>
                            <div class="prf-bar-draw"></div>
                            <div class="prf-bar-loss"></div>
                        </div>
                        <div class="prf-diffs">
                            @foreach (var d in g.Difficulties.Where(x => x.TotalGames > 0))
                            {
                                <div class="prf-diff-row">
                                    <span class="prf-diff-name prf-diff-@d.Name.ToLowerInvariant()">@d.Name</span>
                                    <span class="prf-diff-wld">@d.Wins W · @d.Losses L · @d.Draws D</span>
                                    @if (d.EloRating != 1000)
                                    {
                                        <span class="prf-diff-elo">ELO @d.EloRating</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (g.IsHighScoreOnly)
                    {
                        <p class="prf-game-note">Score-based — see leaderboard</p>
                    }
                    else if (g.IsOfflineOnly)
                    {
                        <p class="prf-game-note">Offline only · no stats tracked</p>
                    }
                    else
                    {
                        <p class="prf-game-unplayed">Not played yet</p>
                    }
                </div>
            }
        </div>
    </div>

}
</div>

@code {
    // ── Data model ──────────────────────────────────────────────
    private sealed class DiffEntry
    {
        public string Name { get; init; } = "";
        public int Wins { get; init; }
        public int Losses { get; init; }
        public int Draws { get; init; }
        public int EloRating { get; init; }
        public int TotalGames => Wins + Losses + Draws;
    }

    private sealed class GameEntry
    {
        public string Key { get; init; } = "";
        public string Label { get; init; } = "";
        public string Icon { get; init; } = "";
        public bool IsHighScoreOnly { get; init; }
        public bool IsOfflineOnly { get; init; }
        public int TotalWins { get; set; }
        public int TotalLosses { get; set; }
        public int TotalDraws { get; set; }
        public int TotalGames => TotalWins + TotalLosses + TotalDraws;
        public double WinRate => TotalGames > 0 ? (double)TotalWins / TotalGames : 0;
        public double WinPercent => TotalGames > 0 ? TotalWins * 100.0 / TotalGames : 0;
        public double DrawPercent => TotalGames > 0 ? TotalDraws * 100.0 / TotalGames : 0;
        public double LossPercent => TotalGames > 0 ? TotalLosses * 100.0 / TotalGames : 0;
        public List<DiffEntry> Difficulties { get; init; } = new();
    }

    // ── Game definitions (order determines radar axis order) ──
    private static readonly (string Key, string Label, string Icon, bool HsOnly, bool OfflineOnly)[] GameDefs =
    {
        ("tictactoe",    "TicTacToe6",    "✖",  false, false),
        ("connectfive",  "Connect Five",  "🔵", false, false),
        ("pomarblerace", "Marble Race",   "🔮", true,  false),
    };

    // ── State ────────────────────────────────────────────────────
    private bool _loading = true;
    private string _playerName = "Player";
    private string _initials   = "P";
    private int _totalGames, _totalWins, _totalLosses, _totalDraws;
    private int _bestStreak, _topElo = 1000;
    private GameEntry? _bestEntry, _nemesisEntry;
    private List<GameEntry> _entries = new();

    // ── High scores (best available per 1P game) ──────────────────
    private sealed record HighScoreEntry(string Game, string Icon, string Value, string Sub, bool HasValue);
    private List<HighScoreEntry> _highScores = new();

    private static readonly (string Key, string Title, string Icon, string Kind)[] HsDefs =
    {
        ("pomarblerace", "PoMarbleRace",  "🔮", "marble"),
        ("tictactoe",    "TicTacToe6",    "❌", "ai"),
        ("connectfive",  "Connect Five",  "🔴", "ai"),
    };

    // ── Head-to-head record vs named opponents ────────────────────
    private sealed class OpponentRecord
    {
        public string Name { get; init; } = "";
        public string Type { get; init; } = "guest";
        public int Wins, Losses, Draws;
        public int Total => Wins + Losses + Draws;
    }
    private bool _matchesLoading = true;
    private List<OpponentRecord> _localOpponents = new();
    private List<OpponentRecord> _onlineOpponents = new();

    // ── Lifecycle ────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        PlayerNameService.StateChanged += OnNameChanged;
        // §7 UX: _loading starts true (declared on the state field). The
        // skeleton renders on the first paint, and we let OnInitializedAsync
        // hydrate the stats + name. We deliberately do NOT call
        // PlayerNameService.GetPlayerName() or LoadStats() here — those would
        // resolve synchronously against cached localStorage and defeat the
        // skeleton. Instead, the async path runs after first render and
        // owns all data population so the placeholder is the first thing the
        // user sees, even on a 0-ms warm-cache render.
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStatsAsync();
        await LoadHighScoresAsync();
        await LoadMatchesAsync();
        // §7 UX: dismiss the skeleton once the slowest data source has resolved.
        // HighScore + MatchHistory fire in parallel; flipping _loading here means
        // the user sees a skeleton for the network round-trip (typically <300ms
        // on warm-cache) and never a stale identity flash if a previous user's
        // data was still resident in the component.
        _loading = false;
        StateHasChanged();
    }

    private async Task LoadStatsAsync()
    {
        _playerName = PlayerNameService.GetPlayerName();
        LoadStats();
        BuildLocalHighScores();
        await Task.CompletedTask;
    }

    public void Dispose() => PlayerNameService.StateChanged -= OnNameChanged;

    private void OnNameChanged()
    {
        _playerName = PlayerNameService.GetPlayerName();
        LoadStats();
        BuildLocalHighScores();
        // Re-show the skeleton so a "Switch user" mid-session (see top-bar dev
        // tool) never flashes the previous user's stats before the new ones
        // arrive.
        _loading = true;
        _ = LoadHighScoresAsync();
        _ = LoadMatchesAsync();
        InvokeAsync(StateHasChanged);
    }

    // ── High scores ──────────────────────────────────────────────
    // Build the synchronous parts (AI-game personal bests from local stats) first
    // so the section renders immediately; the API-backed numeric scores fill in
    // once LoadHighScoresAsync completes.
    private void BuildLocalHighScores()
    {
        var list = new List<HighScoreEntry>();
        foreach (var (key, title, icon, kind) in HsDefs)
        {
            if (kind == "ai")
            {
                // Connect Five uses the adaptive single-rating ELO.
                if (key == "connectfive")
                {
                    var ar = GameStatsService.GetAdaptiveRating(key, _playerName);
                    list.Add(ar.TotalGames > 0
                        ? new HighScoreEntry(title, icon, $"ELO {ar.Elo}", $"{ar.WinRate:P0} · {ar.Wins}W {ar.Losses}L", true)
                        : new HighScoreEntry(title, icon, "—", "Not played yet", false));
                    continue;
                }

                var s = GameStatsService.GetStats(key, _playerName);
                if (s.TotalGames > 0)
                {
                    var bestElo = Math.Max(s.Easy.EloRating, Math.Max(s.Medium.EloRating, s.Hard.EloRating));
                    list.Add(new HighScoreEntry(title, icon, $"ELO {bestElo}",
                        $"{s.WinRate:P0} · {s.TotalWins}W {s.TotalLosses}L", true));
                }
                else
                {
                    list.Add(new HighScoreEntry(title, icon, "—", "Not played yet", false));
                }
            }
            else
            {
                // Numeric-score games: placeholder until the API responds.
                list.Add(new HighScoreEntry(title, icon, "…", "Loading…", false));
            }
        }
        _highScores = list;
    }

    private async Task LoadHighScoresAsync()
    {
        var marble = await ApiService.GetMarbleRaceHighScoresAsync(1);

        HighScoreEntry MarbleEntry()
        {
            var top = marble is { Length: > 0 } ? marble[0] : null;
            return top is not null
                ? new HighScoreEntry("PoMarbleRace", "🔮", top.BestScore.ToString("N0"), $"by {top.PlayerInitials}", true)
                : new HighScoreEntry("PoMarbleRace", "🔮", "—", "No scores yet", false);
        }

        for (var i = 0; i < _highScores.Count; i++)
        {
            if (_highScores[i].Game == "PoMarbleRace") _highScores[i] = MarbleEntry();
        }
        StateHasChanged();
    }

    // ── Head-to-head ─────────────────────────────────────────────
    private async Task LoadMatchesAsync()
    {
        _matchesLoading = true;
        var matches = await MatchHistory.GetMyMatchesAsync();
        _localOpponents = Aggregate(matches.Where(m => m.Mode == "local-2p"));
        _onlineOpponents = Aggregate(matches.Where(m => m.Mode != "local-2p"));
        _matchesLoading = false;
        StateHasChanged();
    }

    private static List<OpponentRecord> Aggregate(IEnumerable<MatchRecordDto> matches)
    {
        return matches
            .GroupBy(m => m.OpponentName, StringComparer.OrdinalIgnoreCase)
            .Select(g => new OpponentRecord
            {
                Name = g.Key,
                Type = g.Any(x => x.OpponentType == "microsoft") ? "microsoft" : "guest",
                Wins = g.Count(x => x.Outcome == "win"),
                Losses = g.Count(x => x.Outcome == "loss"),
                Draws = g.Count(x => x.Outcome == "draw"),
            })
            .OrderByDescending(o => o.Total)
            .ToList();
    }

    private RenderFragment RenderOpponentTable(List<OpponentRecord> opponents) => __builder =>
    {
        @*
            §2: <Virtualize> wraps the opponent table body. A player's full head-to-head
            history is unbounded (each new opponent is a new row), so without virtualization
            a profile page with 200+ opponents scrolls janky and allocates a DOM node per
            opponent. The virtualizer recycles rows in a 48 px slot, keeping the DOM flat.
        *@
        <div class="prf-h2h-vwrap">
            <table class="prf-h2h-table">
                <thead>
                    <tr><th>Opponent</th><th>W</th><th>L</th><th>D</th><th>Record</th></tr>
                </thead>
                <tbody>
                    <Virtualize Items="opponents" Context="o" ItemSize="48">
                        <tr>
                            <td class="prf-h2h-name">
                                <span class="prf-h2h-badge prf-h2h-badge--@o.Type" title="@(o.Type == "microsoft" ? "Microsoft account" : "Guest")">@(o.Type == "microsoft" ? "MS" : "G")</span>
                                @o.Name
                            </td>
                            <td class="prf-h2h-w">@o.Wins</td>
                            <td class="prf-h2h-l">@o.Losses</td>
                            <td class="prf-h2h-d">@o.Draws</td>
                            <td>@o.Wins–@o.Losses–@o.Draws</td>
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        </div>
    };

    // ── Stats loading ────────────────────────────────────────────
    private void LoadStats()
    {
        _initials = BuildInitials(_playerName);
        _entries = new();
        _totalGames = _totalWins = _totalLosses = _totalDraws = 0;
        _bestStreak = 0;
        _topElo = 1000;

        foreach (var (key, label, icon, hsOnly, offlineOnly) in GameDefs)
        {
            // Connect Five 1-player now uses a single adaptive ELO rating (the CPU
            // is matched to the player's rating) instead of Easy/Medium/Hard buckets.
            if (key == "connectfive")
            {
                var ar = GameStatsService.GetAdaptiveRating(key, _playerName);
                var cfEntry = new GameEntry
                {
                    Key = key, Label = label, Icon = icon,
                    TotalWins = ar.Wins, TotalLosses = ar.Losses, TotalDraws = ar.Draws,
                    Difficulties =
                    [
                        new DiffEntry { Name = "Adaptive", Wins = ar.Wins, Losses = ar.Losses, Draws = ar.Draws, EloRating = ar.Elo }
                    ]
                };
                _entries.Add(cfEntry);
                _totalGames  += cfEntry.TotalGames;
                _totalWins   += cfEntry.TotalWins;
                _totalLosses += cfEntry.TotalLosses;
                _totalDraws  += cfEntry.TotalDraws;
                _topElo       = Math.Max(_topElo, ar.Elo);
                continue;
            }

            PlayerStats stats = hsOnly || offlineOnly
                ? new PlayerStats()
                : GameStatsService.GetStats(key, _playerName);

            var entry = new GameEntry
            {
                Key          = key,
                Label        = label,
                Icon         = icon,
                IsHighScoreOnly = hsOnly,
                IsOfflineOnly   = offlineOnly,
                TotalWins    = stats.TotalWins,
                TotalLosses  = stats.TotalLosses,
                TotalDraws   = stats.TotalDraws,
                Difficulties =
                [
                    new DiffEntry { Name = "Easy",   Wins = stats.Easy.Wins,   Losses = stats.Easy.Losses,   Draws = stats.Easy.Draws,   EloRating = stats.Easy.EloRating   },
                    new DiffEntry { Name = "Medium", Wins = stats.Medium.Wins, Losses = stats.Medium.Losses, Draws = stats.Medium.Draws, EloRating = stats.Medium.EloRating },
                    new DiffEntry { Name = "Hard",   Wins = stats.Hard.Wins,   Losses = stats.Hard.Losses,   Draws = stats.Hard.Draws,   EloRating = stats.Hard.EloRating   },
                ]
            };

            _entries.Add(entry);

            if (!hsOnly && !offlineOnly)
            {
                _totalGames   += entry.TotalGames;
                _totalWins    += entry.TotalWins;
                _totalLosses  += entry.TotalLosses;
                _totalDraws   += entry.TotalDraws;
                _bestStreak    = Math.Max(_bestStreak,
                                    Math.Max(stats.Easy.WinStreak,
                                        Math.Max(stats.Medium.WinStreak, stats.Hard.WinStreak)));
                _topElo        = Math.Max(_topElo,
                                    Math.Max(stats.Easy.EloRating,
                                        Math.Max(stats.Medium.EloRating, stats.Hard.EloRating)));
            }
        }

        var played = _entries.Where(e => e.TotalGames > 0).ToList();
        _bestEntry   = played.OrderByDescending(e => e.WinRate).ThenByDescending(e => e.TotalGames).FirstOrDefault();
        _nemesisEntry = played.Count > 1
            ? played.OrderBy(e => e.WinRate).ThenByDescending(e => e.TotalGames).First()
            : null;
        if (_bestEntry == _nemesisEntry) _nemesisEntry = null;
    }

    private static string BuildInitials(string name)
    {
        var parts = name.Split([' ', '-', '_'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : (name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant());
    }

    // ── Radar SVG ────────────────────────────────────────────────
    private string BuildRadarSvg()
    {
        const double cx = 150, cy = 150, maxR = 90;
        // One axis per game entry. This was hardcoded to 10 while GameDefs
        // defines only 4 games, so the label loop below indexed _entries[4..9]
        // and threw IndexOutOfRangeException, crashing the whole profile page.
        int n = _entries.Count;
        if (n == 0) return "<svg viewBox=\"0 0 300 300\" class=\"prf-radar\" aria-hidden=\"true\"></svg>";
        double step = 2 * Math.PI / n;
        const double startAngle = -Math.PI / 2;

        string Pt(double r, int i)
        {
            var a = startAngle + step * i;
            return $"{cx + r * Math.Cos(a):F1},{cy + r * Math.Sin(a):F1}";
        }

        string RingPoly(double frac) =>
            string.Join(" ", Enumerable.Range(0, n).Select(i => Pt(maxR * frac, i)));

        var dataPoly = string.Join(" ", _entries.Select((e, i) => Pt(maxR * e.WinRate, i)));

        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox=\"0 0 300 300\" class=\"prf-radar\" aria-hidden=\"true\">");

        // Background rings
        foreach (var frac in new[] { 0.25, 0.5, 0.75, 1.0 })
            sb.Append($"<polygon points=\"{RingPoly(frac)}\" fill=\"none\" stroke=\"rgba(255,255,255,0.06)\" stroke-width=\"1\"/>");

        // Axis lines
        for (int i = 0; i < n; i++)
        {
            var a = startAngle + step * i;
            sb.Append($"<line x1=\"{cx:F1}\" y1=\"{cy:F1}\" x2=\"{cx + maxR * Math.Cos(a):F1}\" y2=\"{cy + maxR * Math.Sin(a):F1}\" stroke=\"rgba(255,255,255,0.07)\" stroke-width=\"1\"/>");
        }

        // Data polygon
        sb.Append($"<polygon points=\"{dataPoly}\" fill=\"rgba(99,102,241,0.22)\" stroke=\"rgba(99,102,241,0.85)\" stroke-width=\"2\" stroke-linejoin=\"round\"/>");

        // Dots on played games
        foreach (var (e, i) in _entries.Select((e, i) => (e, i)))
        {
            if (e.TotalGames == 0) continue;
            var a = startAngle + step * i;
            var r = maxR * e.WinRate;
            sb.Append($"<circle cx=\"{cx + r * Math.Cos(a):F1}\" cy=\"{cy + r * Math.Sin(a):F1}\" r=\"3.5\" fill=\"#6366f1\"/>");
        }

        // Labels
        for (int i = 0; i < n; i++)
        {
            var a = startAngle + step * i;
            var lx = cx + (maxR + 22) * Math.Cos(a);
            var ly = cy + (maxR + 22) * Math.Sin(a);
            var anchor = lx < cx - 5 ? "end" : lx > cx + 5 ? "start" : "middle";
            var label = _entries[i].Label.Split(' ')[0]; // first word only
            sb.Append($"<text x=\"{lx:F1}\" y=\"{ly:F1}\" text-anchor=\"{anchor}\" dominant-baseline=\"middle\" fill=\"rgba(148,163,184,0.75)\" font-size=\"8.5\" font-family=\"system-ui,sans-serif\">{System.Web.HttpUtility.HtmlEncode(label)}</text>");
        }

        sb.Append("</svg>");
        return sb.ToString();
    }

    // ── Donut SVG ────────────────────────────────────────────────
    private string BuildDonutSvg()
    {
        const double r = 60, cx = 100, cy = 100;
        double circ = 2 * Math.PI * r;

        if (_totalGames == 0)
        {
            return $"<svg viewBox=\"0 0 200 200\" class=\"prf-donut\" aria-hidden=\"true\">" +
                   $"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" fill=\"none\" stroke=\"rgba(255,255,255,0.08)\" stroke-width=\"20\"/>" +
                   $"<text x=\"{cx}\" y=\"{cy - 8}\" text-anchor=\"middle\" dominant-baseline=\"middle\" fill=\"rgba(148,163,184,0.5)\" font-size=\"13\" font-family=\"system-ui,sans-serif\">No</text>" +
                   $"<text x=\"{cx}\" y=\"{cy + 10}\" text-anchor=\"middle\" dominant-baseline=\"middle\" fill=\"rgba(148,163,184,0.5)\" font-size=\"13\" font-family=\"system-ui,sans-serif\">games</text>" +
                   "</svg>";
        }

        double winLen   = _totalWins   / (double)_totalGames * circ;
        double drawLen  = _totalDraws  / (double)_totalGames * circ;
        double lossLen  = _totalLosses / (double)_totalGames * circ;

        string Seg(double len, double cumOffset, string color) =>
            $"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"20\" " +
            $"stroke-dasharray=\"{len:F2} {circ - len:F2}\" stroke-dashoffset=\"{circ - cumOffset:F2}\" " +
            $"transform=\"rotate(-90 {cx} {cy})\"/>";

        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox=\"0 0 200 200\" class=\"prf-donut\" aria-hidden=\"true\">");

        // Background ring
        sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" fill=\"none\" stroke=\"rgba(255,255,255,0.04)\" stroke-width=\"20\"/>");

        double cum = 0;
        if (winLen  > 0) { sb.Append(Seg(winLen,  cum, "#22c55e")); cum += winLen; }
        if (drawLen > 0) { sb.Append(Seg(drawLen, cum, "#f59e0b")); cum += drawLen; }
        if (lossLen > 0) { sb.Append(Seg(lossLen, cum, "#ef4444")); }

        // Centre label
        sb.Append($"<text x=\"{cx}\" y=\"{cy - 7}\" text-anchor=\"middle\" fill=\"#f1f5f9\" font-size=\"18\" font-weight=\"700\" font-family=\"system-ui,sans-serif\">{_totalGames}</text>");
        sb.Append($"<text x=\"{cx}\" y=\"{cy + 12}\" text-anchor=\"middle\" fill=\"rgba(148,163,184,0.7)\" font-size=\"10\" font-family=\"system-ui,sans-serif\">GAMES</text>");

        sb.Append("</svg>");
        return sb.ToString();
    }
}
