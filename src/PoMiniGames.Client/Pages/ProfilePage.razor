@page "/profile"
@using Microsoft.AspNetCore.Components
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@inject PlayerNameService PlayerNameService
@inject GameStatsService GameStatsService
@inject ApiService ApiService
@inject MatchHistoryService MatchHistory
@inject NavigationManager NavigationManager
@inject AuthStateService AuthState
@inject ToastService Toasts
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>My Stats · PoMiniGames</PageTitle>

<div class="prf-page">
@if (_loading)
{
    @* role="status" is required, not decorative: `aria-label` is prohibited on a
       plain <div> with no role (axe: aria-prohibited-attr), so the label was
       being dropped and the loading state announced as nothing at all. "status"
       is the right role for a transient progress message and gives the label
       somewhere to live. 2026-09-11 UI audit. *@
    <div class="profile-skel" role="status" aria-busy="true" aria-label="Loading profile">
        <div class="profile-skel__header">
            <div class="profile-skel__avatar"></div>
            <div class="profile-skel__lines">
                <div class="profile-skel__line profile-skel__line--w70"></div>
                <div class="profile-skel__line profile-skel__line--w40"></div>
                <div class="profile-skel__line profile-skel__line--w55"></div>
            </div>
        </div>
        <div class="profile-skel__row"></div>
        <div class="profile-skel__row"></div>
        <div class="profile-skel__row"></div>
    </div>
}
else
{
    @* 2026-09-11 UI sweep: a brand-new profile rendered the hero, six "Not played
       yet" high-score cards, a head-to-head section, AND the Game Breakdown's
       ~11 placeholder cards — 2728px on a 390×844 phone (3+ screens of
       placeholders repeating one fact). When nothing has been played anywhere
       (no W/L matches, no saved server rows, no opponents, not still loading),
       the High Scores / Head-to-Head / Breakdown sections step aside and the
       page is hero + one empty-state CTA — a single portrait screen. *@
    var nothingPlayed = _totalGames == 0
        && !_matchesLoading
        && _highScores.All(h => !h.HasValue)
        && _localOpponents.Count == 0
        && _onlineOpponents.Count == 0;

    <!-- ── Hero ── -->
    <div class="prf-hero">
        <div class="prf-avatar" aria-hidden="true">
            @* Option #5: avatar text + provider badge. The initials ("G1"
               from "Guest598152-133895", "JD" from "Jane Doe") read as a
               debug fragment because they carry no context. The badge in
               the avatar's bottom-right ("Guest" or "MS") makes it
               instantly clear what kind of identity this is. *@
            <span class="prf-avatar-text" title="@($"Initials of {_playerName}")">@_initials</span>
            <span class="prf-avatar-badge prf-avatar-badge--@(_accountKind.ToString().ToLowerInvariant())"
                  title="@(_accountKind == AccountKind.Guest ? "Guest profile — sign in with Microsoft to make it permanent." : "Microsoft account")">
                @(_accountKind == AccountKind.Guest ? "Guest" : "MS")
            </span>
        </div>
        <div class="prf-hero-body">
            <h1 class="prf-name">My Stats</h1>
            <p class="prf-handle" aria-label="Display name" title="@_playerName">
                @* The DisplayHandle() trim that used to wrap this was removed on
                   2026-09-11. It existed to cut the 18-character auto-generated
                   handle ("Guest598152-133895") down to "Guest5…" so it would not
                   run past the avatar on a 375px portrait. Guest handles are now
                   minted as "Guest-219244" (12 chars — see SignInGuestAsync,
                   which stopped double-suffixing), and that fits the hero body
                   with room to spare. Showing the name beats showing six
                   characters and an ellipsis. *@
                @_playerName
            </p>
            <div class="prf-chips">
                <div class="prf-chip">
                    @* Browser audit #6 (2026-08-10): the "Games" counter only
                       counted FINISHED, PERSISTED matches (CpuWins/Losses/Draws
                       from the server). A guest playing Tic-Tac-Toe against the
                       CPU right now saw "0 Games" — misleading. The headline
                       number keeps meaning "matches that count toward W/L",
                       relabelled to "Saved Matches" so the distinction is
                       explicit, and an inline ("+ N sessions") pill surfaces
                       the unsynced play count from GameStatsService so the
                       player knows their playtime is being captured. *@
                    <span class="prf-chip-val">@_totalGames</span>
                    <span class="prf-chip-lbl">Saved Matches</span>
                    @if (_unsyncedSessions > 0)
                    {
                        @* 2026-08-12 audit #10: the previous copy implied these
                           session counts would "roll into Saved Matches on the
                           next sync", but for a guest user (who has no
                           authenticated session) they won't sync anywhere —
                           they only flush on sign-in. Surface that distinction
                           in the tooltip so a guest doesn't wait for a sync
                           that will never arrive.
                           We detect guest by the display-name prefix the
                           dev-login build stamps on every bypassed session —
                           see DevLoginIntake.BuildProfile. *@
                        var isGuest = AuthState.User?.DisplayName?.StartsWith("Guest", StringComparison.Ordinal) ?? true;
                        <span class="prf-chip-hint" title="@(isGuest
                                ? "Guest plays are kept locally on this device. Sign in to save them to your leaderboard."
                                : "This-session plays counted locally — they'll roll into Saved Matches on the next sync.")">
                            + @_unsyncedSessions session@(_unsyncedSessions == 1 ? "" : "s") this visit
                        </span>
                    }
                </div>
                <div class="prf-chip">
                    <span class="prf-chip-val">@(_totalGames > 0 ? $"{_totalWins * 100 / _totalGames}%" : "— not played —")</span>
                    <span class="prf-chip-lbl">Win Rate</span>
                </div>
                <div class="prf-chip">
                    <span class="prf-chip-val">@(_bestStreak > 0 ? _bestStreak.ToString() : "— not played —")</span>
                    <span class="prf-chip-lbl">Best Streak</span>
                    @* 2026-07-26 browser audit #8: replace the em-dash with an
                       inline one-liner hint so first-time users know exactly
                       what unlocks the stat. Generic copy — Connect Five +
                       Brawl are the two streak-tracking 1P games but the hint
                       should never go stale if a third one ships. *@
                    @if (_bestStreak == 0)
                    {
                        <span class="prf-chip-hint">Win 2+ in a row on a 1P CPU game to set your first streak</span>
                    }
                </div>
                <div class="prf-chip">
                    <span class="prf-chip-val">@(_topElo > 1200 ? _topElo.ToString() : "— not played —")</span>
                    <span class="prf-chip-lbl">Top ELO</span>
                    @* 2026-07-26 browser audit #8: AdaptiveRating.StartingElo
                       is 1200 (GameModels.cs), so the "past 1000" copy was
                       misleading — your first win only nudges you past the
                       threshold by a few ELO points. *@
                    @if (_topElo <= 1200)
                    {
                        <span class="prf-chip-hint">Win a 1P match to climb past the 1200 starting rating</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── 1-Player high scores (best available per game) ── -->
    @if (!nothingPlayed)
    {
    <div class="prf-section">
        @* 2026-08-12 audit #3: surface a highscore-fetch failure explicitly
           so the player knows the "Not played yet" placeholders aren't the
           truth — one or more of the server endpoints failed and the saved
           row lookup never ran. *@
        @if (_highScoreLoadFailed)
        {
            @* 2026-09-04 UI sweep: migrated to <ErrorState> with a Retry callback.
               The `OnRetry` delegate runs the same `LoadHighScoresAsync` private
               that the inline retry button used; the visual treatment comes
               from app.css and is consistent with the leaderboards and health
               failure surfaces. *@
            <ErrorState Icon="⚠️"
                        Title="Couldn't load saved high scores"
                        OnRetry="() => LoadHighScoresAsync()">
                The leaderboard endpoints didn't respond. Your local stats above
                are still accurate — only the cross-device saved scores are
                affected.
            </ErrorState>
        }
        <h2 class="prf-section-title">High Scores · 1 Player</h2>
        <div class="prf-hs-grid">
            @foreach (var h in _highScores)
            {
                <div class="prf-hs-card @(h.HasValue ? "" : "prf-hs-card--empty")">
                    <span class="prf-hs-icon">@h.Icon</span>
                    <div class="prf-hs-body">
                        <div class="prf-hs-game">@h.Game</div>
                        <div class="prf-hs-value">@h.Value</div>
                        <div class="prf-hs-sub">@h.Sub</div>
                    </div>
                </div>
            }
        </div>
    </div>
    }

    <!-- ── Head-to-head record vs named opponents ── -->
    @if (!nothingPlayed)
    {
    <div class="prf-section">
        @* 2026-08-12 audit #8: the badge legend was rendered above the empty
           state — when there are no opponents the legend is the only visible
           content in the section, reading as a placeholder rather than as an
           explanation. Only show it when there IS something to explain. *@
        @if (_localOpponents.Count > 0 || _onlineOpponents.Count > 0 || _matchesLoading)
        {
            <div class="prf-section-head">
                <h2 class="prf-section-title">Head-to-Head · People You Played</h2>
                @* Browser audit #9 (2026-08-10): the G / MS chips next to each
                   opponent name had no legend, and the title= tooltip was a
                   hover-only affordance — on touch devices a player never saw
                   the meaning of either badge. Inline legend right under the
                   heading, visible to all users, screen readers included. *@
                <span class="prf-h2h-legend" aria-label="Badge legend">
                    <span class="prf-h2h-badge prf-h2h-badge--guest" aria-hidden="true">G</span>
                    <span class="prf-h2h-legend-lbl">Guest</span>
                    <span class="prf-h2h-badge prf-h2h-badge--microsoft" aria-hidden="true">MS</span>
                    <span class="prf-h2h-legend-lbl">Microsoft</span>
                </span>
            </div>
        }
        else
        {
            <h2 class="prf-section-title">Head-to-Head · People You Played</h2>
        }
        @if (_matchesLoading)
        {
            <p class="prf-h2h-note">Loading match history…</p>
        }
        else if (_localOpponents.Count == 0 && _onlineOpponents.Count == 0)
        {
            <p class="prf-h2h-note">No head-to-head matches recorded yet. Play an online multiplayer or local 2-player match and your record against each opponent shows up here.</p>
        }
        else
        {
            <div class="prf-h2h-cols">
                <div class="prf-h2h-col">
                    <h3 class="prf-h2h-mode">👥 2-Player (local)</h3>
                    @if (_localOpponents.Count == 0)
                    {
                        <p class="prf-h2h-note">No local 2-player matches yet.</p>
                    }
                    else
                    {
                        @RenderOpponentTable(_localOpponents)
                    }
                </div>
                <div class="prf-h2h-col">
                    <h3 class="prf-h2h-mode">🌐 Online Multiplayer</h3>
                    @if (_onlineOpponents.Count == 0)
                    {
                        <p class="prf-h2h-note">No online multiplayer matches yet.</p>
                    }
                    else
                    {
                        @RenderOpponentTable(_onlineOpponents)
                    }
                </div>
            </div>
        }
    </div>
    }

    <!-- ── Charts row ── -->
    @* §8: empty-state for first-time players — no charts means no signal.
       A single CTA card replaces the entire charts row. *@
    @if (_totalGames == 0)
    {
        @* 2026-09-04 UI sweep: migrated from inline `.prf-chart-card--empty`
           markup to the shared <EmptyState> primitive. The styling comes from
           app.css; the home-CTA link below picks up the universal
           `.app-btn--primary` class so it matches every other CTA in the app. *@
        <EmptyState Icon="📊"
                    Title="No games played yet">
            <ChildContent>
                Win rates, charts, and head-to-head records unlock after your first
                match.
            </ChildContent>
            <Action>
                <a href="/" class="app-btn app-btn--primary">Pick a game</a>
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="prf-charts">
            <div class="prf-chart-card">
                <h3 class="prf-chart-title">Win Rate by Game</h3>
                @((MarkupString)BuildRadarSvg())
            </div>
            <div class="prf-chart-card">
                <h3 class="prf-chart-title">Overall Record</h3>
                @((MarkupString)BuildDonutSvg())
                <div class="prf-donut-legend">
                    <span class="prf-legend-dot prf-legend-win"></span><span>Wins&nbsp;@_totalWins</span>
                    <span class="prf-legend-dot prf-legend-draw"></span><span>Draws&nbsp;@_totalDraws</span>
                    <span class="prf-legend-dot prf-legend-loss"></span><span>Losses&nbsp;@_totalLosses</span>
                </div>
            </div>
        </div>
    }

    <!-- ── Callouts ── -->
    @if (_bestEntry != null || _nemesisEntry != null)
    {
        <div class="prf-callouts">
            @if (_bestEntry != null)
            {
                <div class="prf-callout prf-callout--best">
                    <span class="prf-callout-icon">🏆</span>
                    <div>
                        <div class="prf-callout-lbl">Best Game</div>
                        <div class="prf-callout-val">@_bestEntry.Label</div>
                        <div class="prf-callout-sub">@(_bestEntry.WinRate.ToString("P0")) win rate · @_bestEntry.TotalGames played</div>
                    </div>
                </div>
            }
            @if (_nemesisEntry != null)
            {
                <div class="prf-callout prf-callout--nemesis">
                    <span class="prf-callout-icon">💀</span>
                    <div>
                        <div class="prf-callout-lbl">Nemesis Game</div>
                        <div class="prf-callout-val">@_nemesisEntry.Label</div>
                        <div class="prf-callout-sub">@(_nemesisEntry.WinRate.ToString("P0")) win rate · @_nemesisEntry.TotalGames played</div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ── Game Breakdown ── -->
    @* 2026-09-11 UI sweep: this section rendered ALL games as full cards, so a
       first-time player scrolled ~11 "Not played yet" placeholders (two-thirds
       of the page's 2728px). Now only games with real activity keep their full
       card; unplayed games collapse into one compact chip strip below them, and
       when nothing is played at all the section steps aside entirely (the empty
       state above already says it). *@
    @if (!nothingPlayed && _entries.Any(g => !IsUnplayed(g)))
    {
    <div class="prf-section">
        <h2 class="prf-section-title">Game Breakdown</h2>
        <div class="prf-game-grid">
            @foreach (var g in _entries.Where(g => !IsUnplayed(g)))
            {
                @* "Unplayed" means no activity of the kind this game actually tracks:
                   matches for W/L games, sessions for play-count games. Keying purely
                   on TotalGames dimmed Joker/Survive cards that had real sessions,
                   and dimmed Marble Race whose activity lives on the server board. *@
                <div class="prf-game-card @(IsUnplayed(g) ? "prf-game-card--unplayed" : "")">
                    <div class="prf-game-header">
                        <span class="prf-game-icon">@g.Icon</span>
                        <span class="prf-game-name">@g.Label</span>
                        @if (g.TotalGames > 0)
                        {
                            <span class="prf-game-wr">@g.WinRate.ToString("P0")</span>
                        }
                    </div>
                    @if (g.TotalGames > 0)
                    {
                        <div class="prf-bar" title="Win / Draw / Loss" style="--win-pct:@((int)g.WinPercent)%;--draw-pct:@((int)g.DrawPercent)%;--loss-pct:@((int)g.LossPercent)%">
                            <div class="prf-bar-win"></div>
                            <div class="prf-bar-draw"></div>
                            <div class="prf-bar-loss"></div>
                        </div>
                        <div class="prf-diffs">
                            @foreach (var d in g.Difficulties.Where(x => x.TotalGames > 0))
                            {
                                <div class="prf-diff-row">
                                    <span class="prf-diff-name prf-diff-@d.Name.ToLowerInvariant()">@d.Name</span>
                                    <span class="prf-diff-wld">@d.Wins W · @d.Losses L · @d.Draws D</span>
                                    @if (d.EloRating != 1000)
                                    {
                                        <span class="prf-diff-elo">ELO @d.EloRating</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (g.Kind == RatingKind.HighScoreOnly)
                    {
                        @* 2026-08-12 audit #5: "see leaderboard" was misleading
                           even when the user HAD a row on the global leaderboard.
                           Now a link to /leaderboards so they can see themselves
                           ranked, not just a bare text hint that sends them hunting. *@
                        <p class="prf-game-note">
                            Score-based — <a class="prf-game-link" href="/leaderboards">see leaderboard</a>
                        </p>
                    }
                    else if (g.Kind == RatingKind.PlayCountOnly)
                    {
                        @* 2026-08-12 audit #5: a session count is the only stat
                           Joker / Survive can report. The "8 sessions" line was
                           ambiguous to a first-time visitor who had never clicked
                           Play — they assumed the counter was broken or belonged
                           to someone else. Add an inline caption that says these
                           are demo plays the visitor can launch from the catalog,
                           and a primary CTA so they don't have to navigate away
                           to find them. *@
                        @if (g.PlayCount > 0)
                        {
                            <p class="prf-game-plays">
                                <span class="prf-game-plays-val">@g.PlayCount</span>
                                <span class="prf-game-plays-lbl">@(g.PlayCount == 1 ? "session" : "sessions")</span>
                            </p>
                            <p class="prf-game-hint">Auto-counted while you watched demos</p>
                            <a class="prf-game-link" href="@DemoUrl(g.Key)">Watch again →</a>
                        }
                        else
                        {
                            <p class="prf-game-unplayed">Not played yet</p>
                            <a class="prf-game-link" href="@DemoUrl(g.Key)">Try the demo →</a>
                        }
                    }
                    else
                    {
                        <p class="prf-game-unplayed">Not played yet</p>
                    }
                </div>
            }
        </div>
        @if (_entries.Any(IsUnplayed))
        {
            @* Unplayed games as one compact strip — every chip is a tappable
               demo entry for the play-count games (Joker/Survive), matching the
               old per-card "Try the demo →" affordance they replaced. *@
            <div class="prf-unplayed">
                <span class="prf-unplayed-label">Not played yet:</span>
                @foreach (var g in _entries.Where(IsUnplayed))
                {
                    @if (g.Kind == RatingKind.PlayCountOnly)
                    {
                        <a class="prf-unplayed-chip prf-unplayed-chip--link" href="@DemoUrl(g.Key)" title="Try the demo">@g.Icon @g.Label</a>
                    }
                    else if (g.Kind == RatingKind.HighScoreOnly)
                    {
                        <a class="prf-unplayed-chip prf-unplayed-chip--link" href="/leaderboards" title="See leaderboard">@g.Icon @g.Label</a>
                    }
                    else
                    {
                        <span class="prf-unplayed-chip">@g.Icon @g.Label</span>
                    }
                }
            </div>
        }
    </div>
    }

    @* The Preferences section (a link out to /settings) went with that page on
       2026-08-11 — see the note in SettingsService. This page is about the
       player's match record and now only carries that. *@

    @* ── Your data ──────────────────────────────────────────────────────────
       Self-service export + erase. Gated on the same `nothingPlayed` flag as the
       sections above, and for a stronger reason than layout: a profile with no
       stored rows has literally nothing to download or delete, so the controls
       would be two buttons that do nothing but look alarming. The moment there
       IS data, the controls appear alongside it. *@
    @if (!nothingPlayed)
    {
        <AccountDataCard AccountKind="_accountKind" OnDataErased="LoadStatsAsync" />
    }
}
</div>

@code {
    // Only the markup-bearing member lives here. Everything else moved to
    // ProfilePage.razor.cs on 2026-09-11 — see that file for why.
    //
    // This one cannot move: a RenderFragment written as inline Razor markup is
    // compiled by the Razor generator, not by csc, so it has to stay in the .razor.

    private RenderFragment RenderOpponentTable(List<OpponentRecord> opponents) => __builder =>
    {
        @*
            §2: <Virtualize> wraps the opponent table body. A player's full head-to-head
            history is unbounded (each new opponent is a new row), so without virtualization
            a profile page with 200+ opponents scrolls janky and allocates a DOM node per
            opponent. The virtualizer recycles rows in a 48 px slot, keeping the DOM flat.
        *@
        <div class="prf-h2h-vwrap">
            <table class="prf-h2h-table">
                <thead>
                    <tr><th>Opponent</th><th>W</th><th>L</th><th>D</th><th>Record</th></tr>
                </thead>
                <tbody>
                    <Virtualize Items="opponents" Context="o" ItemSize="48">
                        <tr>
                            <td class="prf-h2h-name">
                                <span class="prf-h2h-badge prf-h2h-badge--@o.Type" title="@(o.Type == "microsoft" ? "Microsoft account" : "Guest")">@(o.Type == "microsoft" ? "MS" : "G")</span>
                                @o.Name
                            </td>
                            <td class="prf-h2h-w">@o.Wins</td>
                            <td class="prf-h2h-l">@o.Losses</td>
                            <td class="prf-h2h-d">@o.Draws</td>
                            <td>@o.Wins–@o.Losses–@o.Draws</td>
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        </div>
    };
}
