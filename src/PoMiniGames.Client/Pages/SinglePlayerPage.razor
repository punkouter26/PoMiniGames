@page "/single-player"
@using System
@using PoMiniGamesClient.Services
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ApiService ApiService
@inject AuthStateService AuthState
@inject HttpClient Http
@inject KioskCoordinator Kiosk

<div class="sp-page">
    @if (_apiOnline == false)
    {
        <div class="sp-offline-banner" role="alert">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:0.3rem">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            Offline mode — scores won't sync until the server is reachable
        </div>
    }

    <div class="sp-card">
        <div class="sp-header">
            <button class="sp-back" @onclick='() => NavigationManager.NavigateTo("/")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:0.2rem">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Home
            </button>
            <h1 class="sp-title">@_title</h1>
        </div>

        <div class="sp-auth-banner-actions" style="margin-bottom:1rem">
            <button class="@(_mode == "play" ? "sp-btn-primary" : "sp-btn-secondary")" @onclick='() => SetMode("play")'>
                Play games
            </button>
            <button class="@(_mode == "local-2p" ? "sp-btn-primary" : "sp-btn-secondary")" @onclick='() => SetMode("local-2p")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:0.2rem">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                Local 2P
            </button>
            <button class="@(_mode == "demo" ? "sp-btn-primary" : "sp-btn-secondary")" @onclick='() => SetMode("demo")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:0.2rem">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
                Watch demos
            </button>
        </div>

        <p class="sp-subtitle">@_subtitle</p>
        @if (_mode == "demo")
        {
            <div style="text-align:center;margin-bottom:1rem">
                <button class="sp-btn-primary" @onclick="StartKiosk" style="gap:0.4rem;display:inline-flex;align-items:center">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    Watch All Demos (auto-cycle)
                </button>
            </div>
        }

        <div class="sp-search-wrap @(string.IsNullOrEmpty(_searchQuery) ? "" : "has-text")">
            <span class="sp-search-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
            </span>
            <input class="sp-search" type="search" placeholder="Search games…"
                   value="@_searchQuery"
                   @oninput="OnSearchInput"
                   aria-label="Search games" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button class="sp-search-clear" @onclick="ClearSearch" aria-label="Clear search">✕</button>
            }
        </div>

        @if (!string.IsNullOrEmpty(_searchQuery))
        {
            <div class="sp-search-result-count">@_filteredGames.Length of @_allGames.Length games match</div>
        }

        <div class="sp-game-grid">
            @if (_isLoading)
            {
                @for (int i = 0; i < 6; i++)
                {
                    <div class="sp-game-card" style="padding:0">
                        <div class="skeleton skeleton--card" style="border-radius:0.75rem;height:200px"></div>
                    </div>
                }
            }
            else if (_filteredGames.Length > 0)
            {
                foreach (var game in _filteredGames)
                {
                    <button type="button" class="sp-game-card"
                            aria-label="@game.AriaLabel"
                            style="--accent:@game.Accent;--accent-glow:@game.AccentGlow"
                            @onmouseenter="(e) => OnCardEnter(e)"
                            @onmousemove="(e) => OnCardMove(e)"
                            @onmouseleave="(e) => OnCardLeave(e)"
                            @onclick="() => NavigationManager.NavigateTo(game.To)">
                        <div class="sp-game-card-preview" aria-hidden="true">
                            <div class="sp-game-icon">@game.Icon</div>
                        </div>
                        <div class="sp-game-card-body">
                            <h2>@game.Title</h2>
                            <p>@game.Description</p>
                            @if (game.Modes.Length > 0)
                            {
                                <div class="sp-game-modes" aria-label="Available modes">
                                    @foreach (var m in game.Modes)
                                    {
                                        <span class="sp-mode-pill sp-mode-pill--@m.ToLowerInvariant()">@m</span>
                                    }
                                </div>
                            }
                        </div>
                    </button>
                }
            }
            else
            {
                <div class="sp-empty-state">
                    <svg class="sp-empty-svg" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="30" stroke="var(--color-border)" stroke-width="4"/>
                        <line x1="72" y1="72" x2="95" y2="95" stroke="var(--color-border)" stroke-width="6" stroke-linecap="round"/>
                        <circle cx="50" cy="50" r="12" stroke="var(--color-border)" stroke-width="3"/>
                    </svg>
                    <p class="sp-empty-text">No games match "@_searchQuery"</p>
                    <div class="sp-empty-actions">
                        <button class="sp-btn-secondary" @onclick="ClearSearch">Clear search</button>
                    </div>
                </div>
            }
        </div>

        @if (_mode == "play")
        {
            <HomeHighScores />
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "mode")]
    public string? QueryMode { get; set; }

    [SupplyParameterFromQuery(Name = "kiosk")]
    public int KioskIndex { get; set; } = -1;

    private string _mode = "play";
    private string _title = "Pick a Single-Player Game";
    private string _subtitle = "Choose any game below and jump in.";
    private string _searchQuery = "";
    private bool? _apiOnline;
    private bool _isLoading = true;
    private CancellationTokenSource? _debounceCts;
    private GameCardData[] _filteredGames = [];
    private GameCardData[] _allGames = [];

    private record GameCardData(string Key, string To, string Title, string Description, string AriaLabel, string Accent, string AccentGlow, string[] Modes, string Icon);

    private static readonly GameCardData[] SinglePlayerGames =
    [
        new("poclick", "/poclick", "PoClick", "Drummer timing trainer. Tap SPACEBAR to the metronome beat.",
            "Play PoClick single player", "#06b6d4", "rgba(6,182,212,0.28)", ["1P","Demo"], "🥁"),
        new("connectfive", "/connectfive", "Connect Five", "Drop pieces on a 9x9 board. Get 5 in a row to win.",
            "Play Connect Five single player", "#f44336", "rgba(244,67,54,0.28)", ["1P","2P","Demo"], "🔴🟡"),
        new("tictactoe", "/tictactoe", "Tic Tac Toe", "Classic game on a 6x6 board. Get 4 in a row to win.",
            "Play Tic Tac Toe single player", "#ef4444", "rgba(239,68,68,0.28)", ["1P","2P","Demo"], "❌⭕"),
        new("voxelshooter", "/voxelshooter", "Voxel Shooter", "Blast voxel enemies and survive the full round.",
            "Play Voxel Shooter single player", "#00D9FF", "rgba(0,217,255,0.28)", ["1P"], "🎯"),
        new("pofight", "/pofight", "PoFight", "Arcade fighter with PvCPU and CPU demo options.",
            "Play PoFight single player", "#f97316", "rgba(249,115,22,0.28)", ["1P","Demo"], "⚔️"),
        new("podropsquare", "/podropsquare", "PoDropSquare", "Stack falling blocks and clear lines to score.",
            "Play PoDropSquare single player", "#a78bfa", "rgba(167,139,250,0.28)", ["1P"], "⬜"),
        new("pobabytouch", "/pobabytouch", "PoBabyTouch", "Tap matching shapes before they disappear.",
            "Play PoBabyTouch single player", "#ec4899", "rgba(236,72,153,0.28)", ["1P"], "👶"),
        new("poraceragdoll", "/poraceragdoll", "PoRaceRagdoll", "Bet on ragdoll racers and watch the chaos unfold.",
            "Play PoRaceRagdoll single player", "#22c55e", "rgba(34,197,94,0.28)", ["1P","Demo"], "🚗"),
        new("posnakegame", "/posnakegame", "PoSnakeGame", "Battle royale snake — outlast all opponents.",
            "Play PoSnakeGame single player", "#4ade80", "rgba(74,222,128,0.28)", ["1P"], "🐍"),
        new("pohorserace", "/pohorserace", "PoHorseRace", "Carnival arcade horse race — swipe to roll, score to win!",
            "Play PoHorseRace single player", "#f59e0b", "rgba(245,158,11,0.28)", ["1P","Demo"], "🏇"),
        new("porunner", "/porunner?mode=1p", "PoRunner", "Type T-Y-G-H to sprint past opponents! Race to the finish.",
            "Play PoRunner single player", "#fcd34d", "rgba(252,211,77,0.28)", ["1P","2P","Demo","Multi"], "⚡"),
        new("poracer", "/poracer", "PoRacer", "Top-down arcade racing. 8 cars, 3 laps, drift to win!",
            "Play PoRacer single player", "#4ec3ff", "rgba(78,195,255,0.28)", ["1P","Multi"], "🏎️"),
        new("pomarblerace", "/pomarblerace", "PoMarbleRace", "Pick a marble, then watch it race 3D down a neon ramp. Top-3 finish scores!",
            "Play PoMarbleRace single player", "#a855f7", "rgba(168,85,247,0.28)", ["1P","Demo"], "🔮"),
    ];

    private static readonly GameCardData[] DemoGames =
    [
        new("poclick-demo", "/poclick/1", "PoClick Demo", "Watch the metronome trainer in action.",
            "Watch PoClick demo", "#06b6d4", "rgba(6,182,212,0.28)", [], "🥁"),
        new("tictactoe-demo", "/tictactoe/1", "Tic Tac Toe Demo", "Watch CPU vs CPU battle it out.",
            "Watch Tic Tac Toe demo", "#ef4444", "rgba(239,68,68,0.28)", [], "❌⭕"),
        new("connectfive-demo", "/connectfive/1", "Connect Five Demo", "Watch the CPU auto-play on a 9x9 board.",
            "Watch Connect Five demo", "#f44336", "rgba(244,67,54,0.28)", [], "🔴🟡"),
        new("pofight-demo", "/pofight/1", "PoFight Demo", "Arcade fighter in CPU vs CPU kiosk mode.",
            "Watch PoFight demo", "#f97316", "rgba(249,115,22,0.28)", [], "⚔️"),
        new("poraceragdoll-demo", "/poraceragdoll?demo=1", "PoRaceRagdoll", "Enjoy the chaos and place a bet on the racers.",
            "Watch PoRaceRagdoll demo", "#22c55e", "rgba(34,197,94,0.28)", [], "🚗"),
        new("pohorserace-demo", "/pohorserace?demo=1", "PoHorseRace Demo", "Watch all 8 lanes auto-race in arcade demo mode.",
            "Watch PoHorseRace demo", "#f59e0b", "rgba(245,158,11,0.28)", [], "🏇"),
        new("porunner-demo", "/porunner/demo", "PoRunner Demo", "Watch 8 CPU bots race to the finish line.",
            "Watch PoRunner demo", "#fcd34d", "rgba(252,211,77,0.28)", [], "⚡"),
        new("poracer-demo", "/poracer/demo", "PoRacer Demo", "Watch 8 CPU racers battle it out to the finish!",
            "Watch PoRacer demo", "#4ec3ff", "rgba(78,195,255,0.28)", [], "🏎️"),
        new("pomarblerace-demo", "/pomarblerace?demo=1", "PoMarbleRace Demo", "Watch 8 marbles tumble down a procedural neon ramp.",
            "Watch PoMarbleRace demo", "#a855f7", "rgba(168,85,247,0.28)", [], "🔮"),
    ];

    protected override async Task OnInitializedAsync()
    {
        _mode = QueryMode == "demo" ? "demo" : QueryMode == "local-2p" ? "local-2p" : "play";
        UpdateState();

        // BUG FIX (#1, #4, #5): Kiosk flow is now driven by the singleton
        // KioskCoordinator. We register the demo entries once and let the
        // coordinator own the 20s advance timer. The coordinator's
        // LocationChanged handler disposes the timer if the user
        // navigates manually, which fixes the timer-leak bug.
        Kiosk.RegisterEntries(DemoGames.Select(g => new DemoEntry(
            Key: g.Key,
            Path: g.To,
            DisplayName: g.Title,
            Icon: g.Icon)));

        // Kiosk auto-rotation: when kiosk index is present, immediately
        // navigate to that demo game and let the coordinator start ticking.
        if (_mode == "demo" && KioskIndex >= 0)
        {
            var game = DemoGames[KioskIndex % DemoGames.Length];
            var nextIndex = (KioskIndex + 1) % DemoGames.Length;
            var sep = game.To.Contains('?') ? '&' : '?';
            Kiosk.Start(nextIndex);
            NavigationManager.NavigateTo($"{game.To}{sep}kiosk={nextIndex}");
            return;
        }

        _ = Task.Run(async () =>
        {
            _apiOnline = await ApiService.IsAvailableAsync();
            await InvokeAsync(StateHasChanged);
        });

        // Show skeleton briefly
        await Task.Delay(200);
        _isLoading = false;
    }

    protected override void OnParametersSet()
    {
        UpdateState();
    }

    private void UpdateState()
    {
        var games = _mode switch
        {
            "demo" => DemoGames,
            "local-2p" => SinglePlayerGames.Where(g => g.Modes.Contains("2P")).ToArray(),
            _ => SinglePlayerGames
        };

        _allGames = games;

        _title = _mode switch
        {
            "demo" => "Pick a Demo Game",
            "local-2p" => "Local 2-Player Games",
            _ => "Pick a Single-Player Game"
        };

        _subtitle = _mode switch
        {
            "demo" => "Watch CPU-driven matches with no sign-in required.",
            "local-2p" => "All games below support pass-and-play on this device.",
            _ => "Choose any game below and jump in."
        };

        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _filteredGames = string.IsNullOrWhiteSpace(_searchQuery)
            ? _allGames
            : _allGames.Where(g =>
                g.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                g.Description.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
              .ToArray();
    }

    private void SetMode(string mode)
    {
        _mode = mode;
        UpdateState();
        NavigationManager.NavigateTo(mode == "play"
            ? "/single-player"
            : $"/single-player?mode={mode}");
    }

    // Debounced search (Suggestion #7)
    private void OnSearchInput(ChangeEventArgs e)
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(150, token);
                _searchQuery = e.Value?.ToString() ?? "";
                await InvokeAsync(() =>
                {
                    ApplyFilter();
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException) { }
        });
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        ApplyFilter();
        StateHasChanged();
    }

    // 3D tilt effect handlers (Suggestion #3)
    private void OnCardEnter(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // handled by CSS perspective approach
    }

    private void OnCardMove(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // Could be used for JS-interop pixel-perfect tilt
    }

    private void OnCardLeave(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // Card returns to natural position via CSS transition
    }

    private void StartKiosk()
    {
        Kiosk.Start(0);
        NavigationManager.NavigateTo("/single-player?mode=demo&kiosk=0");
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}