<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- §1.7 Trimming Safeguards. Spec forbids AOT but mandates these static
         analyzers so that any future trim/AOT enable cannot regress silently.
         The codebase currently uses reflection-based JSON (HttpClient.GetFromJsonAsync<T>)
         and JS interop without source-generated JsonTypeInfo. These patterns are
         documented as known-acceptable for a non-published/AOT build; the IL warnings
         are suppressed with explicit codes so the analyzer still runs on the rest of
         the surface and the noise doesn't hide NEW regressions. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <NoWarn>$(NoWarn);IL2026;IL2091;IL2110;IL2111</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <WasmEnableWebcilProtectedResources>false</WasmEnableWebcilProtectedResources>
    <StaticWebAssetsFingerprintingEnabled>false</StaticWebAssetsFingerprintingEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoShared\PoShared.csproj" />
  </ItemGroup>

</Project>
