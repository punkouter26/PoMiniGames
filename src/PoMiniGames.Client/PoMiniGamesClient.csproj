<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props.
         §1.7 Trimming Safeguards. All HttpClient JSON call sites now go through
         ApiJsonContext (source-generated). IL2026/IL2091 in user code are fixed.
         IL2110/IL2111 are suppressed for Blazor framework code only: LayoutView.Layout
         and Router.NotFoundPage setters in App_razor.g.cs use reflection-based
         parameter dispatch that the Blazor source generator does not yet emit as
         trim-safe; these cannot be fixed in user code.
         NOTE: PoShared carries NO such suppression — it is genuinely trim-clean.

         RISK / TODO (scope this later): this NoWarn is project-wide, so it also
         silences any *genuine* IL2110/IL2111 trim warning in our OWN code, not just
         the framework false-positives above. It exists solely for the generated
         App_razor.g.cs LayoutView.Layout / Router.NotFoundPage setter dispatch. It is
         kept blanket because those warnings originate in generated code with no stable
         member handle to target via a scoped [UnconditionalSuppressMessage] or
         per-file suppression; narrowing it safely would require a targeted attribute on
         the exact framework-generated members, which we cannot reference here without
         risking a broken build. Prefer safety: leave it until those members can be
         suppressed narrowly. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <NoWarn>$(NoWarn);IL2110;IL2111</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <WasmEnableWebcilProtectedResources>false</WasmEnableWebcilProtectedResources>
    <StaticWebAssetsFingerprintingEnabled>false</StaticWebAssetsFingerprintingEnabled>
    <!-- PWA offline support. Generates service-worker-assets.js (the asset list +
         integrity hashes the published worker precaches) and swaps the no-op
         wwwroot/service-worker.js for service-worker.published.js on publish only.
         Offline behaviour therefore CANNOT be observed under `dotnet run` — verify
         against published output. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js"
                   PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve reflectively-instantiated layout constructors from the trimmer
         (see TrimmerRoots.xml — fixes CtorNotLocated for MainLayout in Release). -->
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Fluxor.Blazor.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoShared\PoShared.csproj" />
    <!-- PoSurvive: simulation domain/application logic runs in the browser -->
    <ProjectReference Include="..\PoMiniGames.Application\PoMiniGames.Application.csproj" />
  </ItemGroup>

</Project>
