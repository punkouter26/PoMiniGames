<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props.
         §1.7 Trimming Safeguards. The analyzer runs (EnableTrimAnalyzer) but the
         four IL codes below are suppressed because the client uses reflection-based
         JSON (HttpClient.GetFromJsonAsync<T>) across all 18 games — 134× IL2026 plus
         20× IL2091/IL2110/IL2111 as of this writing. Eliminating them requires a
         source-generated JsonSerializerContext threaded through every call site; that
         migration is tracked as follow-up (regression-prone to do blind). The build is
         non-AOT / non-trimmed-publish, so these are analyzer-only, not runtime, risks.
         NOTE: PoShared carries NO such suppression — it is genuinely trim-clean. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <NoWarn>$(NoWarn);IL2026;IL2091;IL2110;IL2111</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <WasmEnableWebcilProtectedResources>false</WasmEnableWebcilProtectedResources>
    <StaticWebAssetsFingerprintingEnabled>false</StaticWebAssetsFingerprintingEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Fluxor.Blazor.Web" />
    <!-- PoJoker demo game: Radzen DataGrid powers the leaderboard view. -->
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoShared\PoShared.csproj" />
    <!-- PoSurvive: simulation domain/application logic runs in the browser -->
    <ProjectReference Include="..\PoMiniGames.Application\PoMiniGames.Application.csproj" />
  </ItemGroup>

</Project>
