<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>pomini-games-secret-id</UserSecretsId>
    <SpaRoot>..\..\PoMiniGames.Client</SpaRoot>
    <StaticWebAssetsFingerprintingEnabled>false</StaticWebAssetsFingerprintingEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <!-- API -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Logging / Telemetry -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Exceptions" />
  </ItemGroup>

  <!-- React client build removed - now using Blazor WASM -->
  <ItemGroup>
    <ProjectReference Include="..\..\PoShared\PoShared.csproj" />
    <ProjectReference Include="..\..\PoMiniGames.Application\PoMiniGames.Application.csproj" />
    <ProjectReference Include="..\..\PoMiniGames.Infrastructure\PoMiniGames.Infrastructure.csproj" />
    <ProjectReference Include="..\..\PoMiniGames.Client\PoMiniGamesClient.csproj" />
  </ItemGroup>

</Project>
