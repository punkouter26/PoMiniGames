{
  // ─── Keys needed for local development ────────────────────────────────────
  // Secrets are NOT stored here. Two options for local dev:
  //   A) Set KeyVault.Uri below → app pulls all secrets from Azure Key Vault
  //      (requires: az login, or DefaultAzureCredential via VS/VS Code account)
  //   B) Leave KeyVault.Uri blank and fill individual values below for offline dev.

  "KeyVault": {
    // Option A: point at the PoShared Key Vault and all secrets are auto-loaded
    "Uri": "" // e.g. "https://kv-poshared.vault.azure.net/"
  },

  "Sqlite": {
    "DataDirectory": "data",
    "DatabaseFileName": "pominigames.db"
  },

  "PoMiniGames": {
    "ApplicationInsights": {
      // Option B: paste connection string here for local telemetry (optional in dev)
      "ConnectionString": ""
    },
    "MicrosoftAuth": {
      "Authority": "https://login.microsoftonline.com/common/v2.0",
      // Option B: paste your Azure AD App Registration client ID
      "ClientId": "",
      "ApiClientId": "",
      "Scope": "api://<your-api-client-id>/access_as_user",
      "RedirectPath": "/auth/callback",
      "Enabled": false // set true to enable Microsoft sign-in locally
    },
    "Storage": {
      "TableService": {
        // Option B: Azurite local connection string for integration tests / local dev
        "ConnectionString": "UseDevelopmentStorage=true",
        "Endpoint": "http://127.0.0.1:10002/devstoreaccount1",
        "AccountName": "devstoreaccount1",
        "TableName": "pominigames"
      }
    },
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:5000",
        "https://localhost:5001",
        "http://localhost:5173",
        "http://localhost:5174"
      ]
    }
  },

  "FeatureFlags": {
    "EnableSwagger": true,
    "EnableDiagnostics": true,
    "UseRealAiInDevelopmentOnly": true,
    "UseMockAiInAutomatedTests": true
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "System": "Warning"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
